      "text": "Ha !"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Déchaînement élémentaire (1)",
      "text": "Ta sentence a été prononcée !"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Déchaînement élémentaire (2)",
      "text": "Que les flammes dévorent tout !"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Déchaînement élémentaire (3)",
      "text": "Accepte ton jugement !"
    },
    {
      "id": "200010",
      "type": 2,
      "title": "Déchaînement élémentaire (1)",
      "text": "Flammes purgatrices !"
    },
    {
      "id": "200011",
      "type": 2,
      "title": "Déchaînement élémentaire (2)",
      "text": "Que les flammes anéantissent tout !"
    },
    {
      "id": "200012",
      "type": 2,
      "title": "Déchaînement élémentaire (3)",
      "text": "Que l'aube arrive !"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Ouverture de coffre (1)",
      "text": "Hmph, j'imagine que c'est mieux que rien."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Ouverture de coffre (2)",
      "text": "Je suppose que cela fera l'affaire."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Ouverture de coffre (3)",
      "text": "Il nous en faudra davantage."
    },
    {
      "id": "410001",
