  "outfits": [
    {
      "id": 206200,
      "name": "Chasseuse de machines",
      "description": "Tenue d'Aloy. Parfaitement adaptée à la vie dans la nature.",
      "isDefault": true,
      "characterName": "Aloy",
      "characterId": 10000062,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aloy_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Première rencontre...",
      "text": "Je suis Aloy. Même si je ne connais pas ce monde, mon arc et mes flèches sont prêtes. Si ton équipe a besoin d'assistance, tu peux compter sur moi."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Bavardage - Départ",
      "text": "#Ne reste pas plant{F#ée}{M#é} là, hâtons-nous."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Bavardage - Aide",
      "text": "Nous ne pouvons pas nous arrêter maintenant, il y a encore des gens qui ont besoin de notre aide."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Quand il pleut...",
      "text": "La pluie. Elle élimine la saleté."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Après la pluie...",
      "text": "La pluie s'est arrêtée, nous ferions mieux de nous sécher."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Quand il neige...",
      "text": "Le monde semble plus calme quand il neige."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Quand le vent souffle...",
      "text": "Le vent se lève, cette bouffée d'air frais est agréable."
    },
    {
      "id": "1205",
      "type": 1,
      "title": "Le vent souffle fort...",
      "text": "Le vent est violent, il souffle à vif sur mon visage."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Au réveil...",
      "text": "Bonjour. Le monde est plein de vigueur, tout comme moi."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "À l'heure du déjeuner...",
      "text": "La journée est à moitié terminée, nous avons encore beaucoup à faire."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Le soir...",
      "text": "Le soleil se couche. Nous verrons bientôt les étoiles."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "La nuit...",
      "text": "Bonsoir. Nous devrions nous reposer, à moins que tu ne veuilles continuer d'avancer à la lumière des étoiles."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "À propos d'Aloy...",
      "text": "J'ai grandi telle une paria, ce fut une période très difficile. Mais ici, même si je suis étrangère, tout le monde est si amical envers moi, bien plus que la tribu dans laquelle je suis née. C'est... agréable."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "À propos de nous - Actions",
      "text": "Toutes mes actions sont au service de la vie, pas de la mort. C'est la raison pour laquelle je me bats à tes côtés."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "À propos de nous - Serment",
      "text": "Un serment me semble un peu trop formel. Mais si tu veux le mien, sache que je fais le serment d'avancer à tes côtés."
    },
    {
      "id": "2004",
      "type": 1,
      "title": "À propos de nous - Aller de l'avant",
      "text": "Je ferai tout ce qui est nécessaire pour aller de l'avant avec toi, et ce, jusqu'au bout. Je n'hésiterai pas. Je n'échouerai pas."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Quelque chose à partager ?",
      "text": "Si je devais partager quelque chose, ce serait mon arc. Au service de ceux qui en ont besoin."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Détails intéressants...",
      "text": "Le passé de ces terres est plein de mystères, tout comme le monde d'où je viens. Si le temps me le permet, je les découvrirai tous."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Connaître Aloy (1)",
      "text": "Je ne suis pas très douée pour parler de moi-même. La mission est ce qui est important."
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Connaître Aloy (2)",
      "text": "Je n'ai pas de parents. C'est un homme appelé Rost qui m'a élevée. C'était un homme strict, mais il était généreux et avait bon cœur. Il m'a beaucoup appris... Il me manque."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Connaître Aloy (3)",
      "text": "J'ai par le passé consacré beaucoup de temps à la recherche de ma mère biologique, sans la trouver. Au lieu de cela, j'ai trouvé des messages anciens laissés par la femme... depuis laquelle je fus clonée. J'ai eu l'impression qu'elle me connaissait, qu'elle savait comment m'encourager."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Connaître Aloy (4)",
      "text": "En grandissant, je n'avais pas d'amis. Bien que j'ai eu l'occasion de rencontrer quelques personnes durant mon périple, j'ai quitté ce monde avant que nous ne puissions devenir proches. C'est pourquoi je suis heureuse de pouvoir passer du temps avec toi et d'être devenue ton amie."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Connaître Aloy (5)",
      "text": "#Je n'accorde pas facilement ma confiance, mais je sais qu'avec toi, c'est différent. Tu es mon am{F#ie}{M#i}. Il m'est rare d'estimer quelqu'un à ce point."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Les loisirs d'Aloy...",
      "text": "Je ne suis pas certaine d'avoir des loisirs, à part peut-être la lecture des choses du passé. Donc heu, l'histoire, j'imagine ?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Les problèmes d'Aloy...",
      "text": "Outre le monde d'où je viens, un autre monde doit être sauvé. Pas le temps de se reposer."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Plats préférés...",
      "text": "Je ne suis pas difficile. Tant que je ne voyage pas le ventre vide, tout me va."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Plats détestés...",
      "text": "J'ai un jour mangé un ragoût oseram si épais qu'on aurait pu s'en servir pour paver une route. Dégoûtant."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Anniversaire...",
      "text": "Je n'ai jamais vraiment porté attention aux anniversaires. Dans le monde où je suis née, c'était une occasion de célébrer la mère et non la personne concernée. Mais ne nous préoccupons pas de cela. Je te souhaite un joyeux anniversaire."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Affinité faible",
      "text": "Très bien, nous avançons bien. Mais nous ne pouvons pas nous arrêter ici."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Affinité moyenne",
      "text": "Grandir, devenir plus fort. C'est une bonne chose."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Affinité élevée",
      "text": "Peu importe sa qualité de chasseur, il est toujours possible de s'améliorer. N'arrête jamais, continue d'apprendre."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Affinité max",
      "text": "Lorsque nous avons commencé à voyager ensemble, tu étais pour moi quelqu'un d'inconnu dans un monde qui l'était tout autant. Après tout ce que nous avons traversé, je peux te dire avec certitude que mon arc t'accompagnera pour toujours."
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Compétence élémentaire (1)",
      "text": "Ça va dégager."
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Compétence élémentaire (2)",
      "text": "J'ai quelque chose pour toi."
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Compétence élémentaire (3)",
      "text": "Tu as vu ça ?"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Déchaînement élémentaire (1)",
      "text": "T'es coincé maintenant !"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Déchaînement élémentaire (2)",
      "text": "C'est nouveau, ça."
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Déchaînement élémentaire (3)",
      "text": "La chasse est ouverte !"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "Utilisation de planeur (1)",
      "text": "C'est amusant."
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Ouverture de coffre (1)",
      "text": "Ces choses semblent pouvoir être utiles."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Ouverture de coffre (2)",
      "text": "Ceux-ci sont comestibles... Ceux-là sont utiles..."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Ouverture de coffre (3)",
      "text": "Qui a mis toutes ces choses ici ?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "PV faibles (1)",
      "text": "Celui-là est récalcitrant..."
    },
    {
      "id": "410002",
      "type": 2,
      "title": "PV faibles (2)",
      "text": "Allez, il faut que je trouve son point faible..."
    },
    {
      "id": "410003",
      "type": 2,
      "title": "PV faibles (3)",
      "text": "Je ne suis pas dans mon élément..."
    },
    {
      "id": "400001",
      "type": 2,
      "title": "Compagnon avec PV faibles (1)",
      "text": "Prudence !"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "Compagnon avec PV faibles (2)",
      "text": "Fais attention à toi !"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "K.O. (1)",
      "text": "J'ai échoué..."
    },
    {
      "id": "500002",
      "type": 2,
      "title": "K.O. (2)",
      "text": "Je suis désolée..."
    },
    {
      "id": "500003",
      "type": 2,
      "title": "K.O. (3)",
      "text": "Je ne peux plus me relever... C'est terminé..."
    },
    {
      "id": "900001",
      "type": 2,
      "title": "Attaque légère subie (1)",
      "text": "Argh..."
    },
    {
      "id": "900002",
      "type": 2,
      "title": "Attaque légère subie (2)",
      "text": "Ce n'est rien..."
    },
    {
      "id": "910001",
      "type": 2,
      "title": "Attaque puissante subie (1)",
      "text": "Ah !"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "Attaque puissante subie (2)",
      "text": "J'aurais dû savoir que ce ne serait pas facile..."
    },
    {
      "id": "600001",
      "type": 2,
      "title": "Ajout dans l'équipe (1)",
      "text": "Où allons-nous cette fois ?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "Ajout dans l'équipe (2)",
      "text": "Je suis Aloy, prête pour la chasse."
    },
    {
      "id": "600003",
      "type": 2,
      "title": "Ajout dans l'équipe (3)",
      "text": "Besoin d'aide ? Je suis là."
    }
  ]
}