      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Première rencontre...",
      "text": "Ton odeur... J'aime bien. En chasse !"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Bavardage - Odeurs",
      "text": "Oh, ça sent le lapin..."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Bavardage - Faim",
      "text": "J'ai faim, allons chasser."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Bavardage - Vents",
      "text": "Je monte la garde. Appelle-moi si tu pars."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Quand le tonnerre gronde - Avertissement",
      "text": "Si tu as peur, cache-toi."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Quand le tonnerre gronde - Guide",
      "text": "Évite les arbres et suis-moi !"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Quand le vent souffle...",
      "text": "Le vent... J'aime le vent."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Le vent souffle fort...",
      "text": "Le vent... Ce vent pique les poils."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Au réveil...",
      "text": "Le soleil est là. Partons en chasse."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "À l'heure du déjeuner...",
      "text": "Un bon gros morceau de viande ! Youpi !"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Le soir...",
      "text": "Dors, je vais regarder la lune."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "La nuit...",
      "text": "Dors, je monte la garde."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "À propos de toi...",
      "text": "Je suis un loup. Je n'ai pas de parents humains."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "À propos de nous - Amitié",
      "text": "#Tu es... {M#mon ami}{F#mon amie}. Chassons ensemble."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "À propos de nous - Arme",
      "text": "J'ai des griffes de métal et des crocs de tonnerre. Je protège."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "À propos de l'œil divin...",
      "text": "L'œil divin aide. Razor combat avec des crocs d'éclair ! Je protège mon lupical !"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Quelque chose à partager ?",
      "text": "J'aime les étoiles, la nuit. Il y en a... plein. Dans le ciel, sur le lac, dans la ville..."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Détails intéressants...",
      "text": "Les loups de mon lupical sont ma famille."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "À propos de Lisa...",
      "text": "Lisa peut peindre le ciel en noir. Elle est forte. Elle fait peur."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "À propos de Barbara...",
      "text": "Barbara est gentille. Très gentille."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "À propos de Diluc...",
      "text": "Diluc, tout rouge et noir. Chaud et froid."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "À propos de Venti...",
      "text": "Je ne comprends pas les poèmes... Mais mon lupical aime bien."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "À propos de Bennett...",
      "text": "Bennett parle beaucoup, mais il n'y pas beaucoup à manger à ses côtés."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "À propos de Klee...",
      "text": "Klee, c'est une amie ! Amie, mais... Plein de problèmes."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "À propos de Varka - Inconnu",
      "text": "Varka ? Je ne connais pas..."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "À propos de Varka - Souvenirs",
      "text": "Oh, Varka, c'est un nom. Un homme. Très grand. « Razor », mon nom, c'est lui qui l'a trouvé... Il me manque."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Connaître Razor (1)",
      "text": "Ton odeur... L'odeur de la bonté. Tu manges de la viande ?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Connaître Razor (2)",
      "text": "Tu as la puissance, comme le loup. La chasse sera bonne."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Connaître Razor (3)",
      "text": "Le lupical c'est la maison du loup. Non, sa famille. Mon lupical vit dans les bois, et je suis leur lupical."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Connaître Razor (4)",
      "text": "Mon lupical c'est tout pour moi. Mais j'ai deux jambes, pas comme lui. Des fois ça me rend triste."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Connaître Razor (5)",
      "text": "#Courir et chasser à tes côtés me rend heureux. Je ne suis ni loup, ni enfant. Je suis moi, Razor. Tu es mon {M#ami}{F#amie}, mon lupical."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Les loisirs de Razor...",
      "text": "J'aime mon lupical. J'aime les bois. J'aime mes amis. J'aime courir."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Les problèmes de Razor...",
      "text": "Parler, c'est... dur, fatigant. Mais il faut parler."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Plats préférés...",
      "text": "J'aime la viande. J'aime les pommes de terre."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Plats détestés...",
      "text": "Les légumes, c'est mauvais. Les animaux mangent les légumes, et je mange les animaux."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Cadeau reçu (1)",
      "text": "Ça sent bon, c'est délicieux. J'aime."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Cadeau reçu (2)",
      "text": "Manger donne des forces, je suis content."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Cadeau reçu (3)",
      "text": "Si je mange, pas bon. Si je ne mange pas, pas bon non plus. C'est triste."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Anniversaire...",
      "text": "#C'est ton jour, le jour de ta naissance. Tant de lunes ont passé... Je veux que tu sois {M#heureux}{F#heureuse} aujourd'hui. On va manger de la viande ?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Affinité faible",
      "text": "Les bras... Plus gros ?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Affinité moyenne",
      "text": "Griffes aiguisées, crocs aiguisés. Il faut toujours être fort !"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Affinité élevée",
      "text": "Courir... Chasser... Non, pas assez ! Je dois devenir plus fort !"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Affinité max",
      "text": "Crocs. Griffes. Pattes. Plus forts, tous. Pour te protéger."
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Compétence élémentaire (1)",
      "text": "Dégagez !"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Compétence élémentaire (2)",
      "text": "Ah !"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Compétence élémentaire (3)",
      "text": "Aïe !"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "Compétence élémentaire (4)",
      "text": "N'approchez pas !"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Déchaînement élémentaire (1)",
      "text": "Raaah !"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Déchaînement élémentaire (2)",
      "text": "Blitz !"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Déchaînement élémentaire (3)",
      "text": "Raaah !"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "Déchaînement élémentaire (4)",
      "text": "Aah !"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Ouverture de coffre (1)",
      "text": "Ces choses... utiles ?"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Ouverture de coffre (2)",
      "text": "Coffre vide... Bien pour ranger choses !"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Ouverture de coffre (3)",
      "text": "Odeur de trésor... Étrange."
    },
    {
      "id": "410001",
      "type": 2,
      "title": "PV faibles (1)",
      "text": "Aïe !"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "PV faibles (2)",
      "text": "Aouuuuh !"
    },
    {
      "id": "410003",
