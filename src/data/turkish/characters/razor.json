  "outfits": [
    {
      "id": 202000,
      "name": "Yaban Koşusu",
      "description": "Razor'ın giysisi. Doğada hızlı hareket etmeye uygun, kaba saba bir kıyafet.",
      "isDefault": true,
      "characterName": "Razor",
      "characterId": 10000020,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Merhaba",
      "text": "Sen... *koklar* Güzel kokuyorsun! Hadi avlanalım."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Sohbet: Koku",
      "text": "*koklar* Tavşan kokusu alıyorum."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Sohbet: Açlık",
      "text": "Açım ben. Hadi avlanalım."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Sohbet: Rüzgar Nöbeti",
      "text": "Ben nöbet tutarım. Ayrılırken ara beni."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Yıldırım Düştüğünde: Uyarı",
      "text": "Yıldırımdan korkuyorsan hemen saklan."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Yıldırım Düştüğünde: Rehber",
      "text": "Ağaçlardan uzak dur. Beni takip et."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Rüzgar Estiğinde",
      "text": "Rüzgar... Rüzgarı severim."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Rüzgar Şiddetlendiğinde",
      "text": "Rüzgar... fena esiyor."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Günaydın",
      "text": "Güneş doğdu. Avlanma zamanı."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "İyi Günler",
      "text": "Koca bir öğle yemeği yedim. Bolca et vardı. Mutluyum."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "İyi Akşamlar",
      "text": "Gidip uyu. Ben ayı izleyeceğim."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "İyi Geceler",
      "text": "Sen uyu. Ben nöbet tutarım."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Razor Hakkında",
      "text": "Benim ailem insan değil. Kurdum ben."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Hakkımızda: Dostlar",
      "text": "Sen benim dostumsun. Birlikte avlanabiliriz!"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Hakkımızda: Silahlar",
      "text": "Demirden pençelerim ve yıldırımdan dişlerim var. Ben seni korurum."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Önsezi Hakkında",
      "text": "Önsezi, şimşek gibi dişleri olan Razor'a... Savaşması için yardım ediyor! Lupical'ı koru!"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Paylaşılacak Bir Bilgi",
      "text": "Gece vakti yıldızları seviyorum. Ne kadar çok yıldız var. Gökyüzünde ve gölde. Bir de şehirde."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "İlginç Şeyler",
      "text": "Kurtlar benim Lupical'ım. Ailem onlar."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Lisa Hakkında",
      "text": "Lisa'nın şimşeği tüm gökyüzünü karartır. Güçlü ve korkutucu biridir."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Barbara Hakkında",
      "text": "Parlak Barbara iyi bir çocuktur. Epey iyi bir çocuktur."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Diluc Hakkında",
      "text": "Diluc kızıl ve siyahtır. Sıcak ve soğuktur."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Venti Hakkında",
      "text": "Razor şiir bilmez ama... Lupical şiir sever."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Bennett Hakkında",
      "text": "Bennett... Çok konuşur. Onunla yemek yersen, asla doymazsın."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Klee Hakkında",
      "text": "Klee dosttur! Dosttur ama... İnsanı uğraştırır."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Varka Hakkında: Yabancı",
      "text": "Varka mı? Razor onu tanımıyor..."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "Varka Hakkında: Hafıza",
      "text": "Ah, Varka... Bir isim bu. Büyük adam. Koca çelik pençe, Razor'ın adını ona Varka verdi. Ah... Onu görmek istiyorum."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Razor Hakkında Daha Fazlası: I",
      "text": "*koklar* Hımm... Hoş kokuyorsun. Et sever misin?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Razor Hakkında Daha Fazlası: II",
      "text": "Güçlüsün. Bir kurt kadar. Seninle avlanmak isterim. Çok şey yakalarız."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Razor Hakkında Daha Fazlası: III",
      "text": "Lupical'ın manası kurt yuvası demek. Hayır, Lupical kurt ailesi demek. Benim Lupical'ım ormanda yaşar. Benim, onların Lupical'ı olduğumu söylerler."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Razor Hakkında Daha Fazlası: IV",
      "text": "Lupical'ım benim tek ailem. Onlar gibi dört ayağım yok. Çünkü gerçek bir kurt değilim ben. Bu durum beni bazen üzüyor."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Razor Hakkında Daha Fazlası: V",
      "text": "Seninle koşarken ve avlanırken mutluyum. Seninleyken kurt değilim, çocuk değilim, sadece kendimim. Razor'ım. Çünkü sen dostumsun. Lupical'ımsın. Umarım sen de mutlusundur."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Razor'ın Hobileri",
      "text": "Lupical'ı severim. Ormanı severim. Dostumu severim. Koşmayı severim!"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Razor'ın Sorunları",
      "text": "Konuşmak beni yoruyor. Konuşmak... zor. Ama... Çaba göstermeliyim."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "En Sevdiği Yemek",
      "text": "Et severim ve... patates severim."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "En Sevmediği Yemek",
      "text": "Yeşillikler kötü. Yeşil şeyleri hayvanlar yer. Ben de hayvanları yerim!"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Hediye Alma: I",
      "text": "Kokusu güzel, tadı da güzel. Hoşuma gitti."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Hediye Alma: II",
      "text": "Bunu yemek bana enerji veriyor, beni mutlu ediyor."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Hediye Alma: III",
      "text": "Bunu yemek kötü. Yememek de kötü. Biraz üzüldüm."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Doğum Günü",
      "text": "Bugün senin günün. Uzun süre önce bu günde doğdun. Seni bugün mutlu etmek istiyorum. Birlikte et yiyelim mi?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Yükseltme Hakkında: Giriş",
      "text": "Daha büyük... kollar!"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Yükseltme Hakkında: Gelişme",
      "text": "Hırr! Pençelerini keskinleştir. Dişlerini de keskinleştir. Daha da güçlen!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Yükseltme Hakkında: Zirve",
      "text": "Koş... Avlan... Yoo, hayır! Daha da güçlenmeliyim!"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Yükseltme Hakkında: Sonuç",
      "text": "Dişler. Pençeler. Bacaklar. Seni korumak için hepsi daha büyük ve daha güçlü olmalı!"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Element Becerisi: I",
      "text": "Geri dön!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Element Becerisi: II",
      "text": "Ah!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Element Becerisi: III",
      "text": "Selam!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "Element Becerisi: IV",
      "text": "Geri dur!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Element Patlaması: I",
      "text": "Rooaarrr!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Element Patlaması: II",
      "text": "*ulur*"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Element Patlaması: III",
      "text": "*kükrer*"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "Element Patlaması: IV",
      "text": "Roarr!"
    },
    {
      "id": "300001",
