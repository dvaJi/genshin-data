  "outfits": [
    {
      "id": 203500,
      "name": "Serin Yaz Rüyası",
      "description": "Qiqi'nin giysisi. Üzerindeki tılsımların huzur verdiği bir otacı kıyafeti.",
      "isDefault": true,
      "characterName": "Qiqi",
      "characterId": 10000035,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Qiqi_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Merhaba",
      "text": "Adım Qiqi. Ben bir zombiyim ve... Ne diyeceğimi unuttum."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Sohbet: Kendi Kendine Konuşma",
      "text": "Baksana, ne oldu biliyor musun? Şey... Ben de bilmiyorum. Unuttum bile."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Sohbet: Ateş Korkusu",
      "text": "Daha serin bir yere gidelim."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Sohbet: Eğitim",
      "text": "Bir, iki, üç, dört. İki, iki, üç, dört..."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Yağmur Yağdığında",
      "text": "Yine şemsiyemi unutmuşum."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Kar Yağdığında",
      "text": "Kardan adam yapmak istiyorum. Yardım eder misin?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Güneş Açtığında",
      "text": "Bugün dışarı çıkmamalıydım."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Rüzgar Estiğinde",
      "text": "Rüzgar buz gibi esiyor. Hoşuma gitti."
    },
    {
      "id": "1205",
      "type": 1,
      "title": "Rüzgar Şiddetlendiğinde",
      "text": "Elimi tut lütfen. Yoksa rüzgara kapılıp giderim."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Günaydın",
      "text": "Sabah olduğunda ajandama bakmam gerekir. Sabah yapmam gereken işler orada yazıyor da."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "İyi Günler",
      "text": "Şimdi aklıma geldi... Doktor Baizhu'ya ilaçları hazırlamasında yardım etmeyi unuttum."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "İyi Akşamlar",
      "text": "İyi akşamlar. Günün nasıl geçti? Benimki... Sanırım fena değildi. Gerçi tam hatırlayamıyorum ama."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "İyi Geceler",
      "text": "Senin uyku vaktin geldi. Ben de esneme hareketleri yapacağım. Bana bakma lütfen."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Qiqi Hakkında",
      "text": "Bir şey mi sormuştun? Kusura bakma unuttum."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Hakkımızda: Hafıza",
      "text": "Hafızam pek iyi değildir ama bildiğim kadarıyla bu çok da değil."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Hakkımızda: Hafıza Eğitimi",
      "text": "Geçtiğimiz günlerde hafıza eğitimine başladım. Yani merak etme. Senin kim olduğunu unutmayacağım."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Önsezi Hakkında",
      "text": "Önsezim, zamanı tersine çeviremiyor ama en azından sevdiklerimi korumam için bana güç veriyor."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Paylaşılacak Bir Bilgi",
      "text": "Bir ceset olabilirim ama Doktor Baizhu'dan çok daha dincim."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "İlginç Şeyler",
      "text": "Bazen eczanenin yakınında serçeler görüyorum. Bir grup tatlı serçe."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Baizhu Hakkında",
      "text": "Doktor Baizhu'nun yüzü bir türlü aklıma gelmiyor ama çok da önemli değil."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Hu Tao Hakkında",
      "text": "Sıcakkanlı, sahte gülüşlü ve ölü... Hu Tao'dan nefret ediyorum."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Xiao Hakkında: İsim",
      "text": "Bana daha çok tarihi bir yadigar gibi geldi."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Xiao Hakkında: Hafıza",
      "text": "Onunla daha önce tanışmış mıydım?"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Xinyan Hakkında",
      "text": "Kim?"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Yaoyao Hakkında",
      "text": "Tatlı biri. Tıpkı ufak bir serçe gibi."
    },
    {
      "id": "4007",
      "type": 1,
      "title": "Küçük Ming Hakkında",
      "text": "Bazı gecelerde, sanki benimle birlikte esneme hareketleri yapan başka biri varmış gibi hissediyorum. Belki de hayal gücüm çok geniştir."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Prune Hakkında",
      "text": "Dışarıdan sert görünüyor... Ama elleri güzel ve yumuşacık. Onu sevdim."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Qiqi Hakkında Daha Fazlası: I",
      "text": "Neler oluyor?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Qiqi Hakkında Daha Fazlası: II",
      "text": "Normal bir insan kadar esnek kalabilmem için düzenli olarak esneme hareketleri yapıyorum ama ne zaman ara versem, vücudum hemen kaskatı kesiliyor."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Qiqi Hakkında Daha Fazlası: III",
      "text": "Bazı insanlar benden yararlanmak istiyor, bazıları da benden korkuyor ama sen... Sen hiç onlar gibi değilsin."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Qiqi Hakkında Daha Fazlası: IV",
      "text": "Tanıştığımızdan beri içimde bir his var. Böyle içimi kemiren cinsten değil ama... Güzel bir his. Kalbimin derinliklerinden gelen bir his. Sana teşekkür ediyorum. Artık mutluyum ama maalesef yalnızca şu anki seni tanıyorum. Olur da seni unutursam... Hayır. Kendime seni hatırlamam için emir veriyorum."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Qiqi Hakkında Daha Fazlası: V",
      "text": "Geçmişte, ne için yaşadığımı bilmeden sadece hayatta kalmaya çalışıyordum ama şimdi bu hayattaki amacımı biliyorum sanırım. Seninle birlikte yaşamak istiyorum. Hayatımızın sonuna kadar, ölüm bizi ayırana dek birlikte kalabilir miyiz? Evet mi hayır mı? Evet mi? Gerçekten bunu istiyor musun? Vay canına, harika. Söz veriyorum, seni her zaman koruyacağım."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Qiqi'nin Hobileri",
      "text": "Bir hayvan sahiplenmek istiyorum. Minik, tatlı bir serçe olabilir."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Qiqi'nin Sorunları",
      "text": "Niye bilmiyorum ama sıcak havaya katlanamıyorum."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "En Sevdiği Yemek",
      "text": "Hindistan cevizi sütünü severim ama tadını bilmiyorum."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "En Sevmediği Yemek",
      "text": "Kusura bakma, bu konuda hiçbir fikrim yok."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Hediye Alma: I",
      "text": "Soğuk. Sevdim ama tadı yok..."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Hediye Alma: II",
      "text": "Hımm..."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Hediye Alma: III",
      "text": "Dilim yandı..."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Doğum Günü",
      "text": "Nice senelere. Bu torbada bitkisel ilaçlar var, sana getirdim. Doğum gününü hatırlamam seni şaşırttı, değil mi? Söylediğinde bir yere not almıştım. Bir şeye her gün bakınca eninde sonunda kafanda yer ediyor ve bir daha unutmuyorsun."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Yükseltme Hakkında: Giriş",
      "text": "Artık daha güçlüyüm. Ama... Bu ne anlama geliyor? Anlatır mısın lütfen? Sağ ol."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Yükseltme Hakkında: Gelişme",
      "text": "Ah, şimdi anladım. Ne kadar güçlenirsem, gücümü kontrol etmem de o kadar zorlaşıyor demek."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Yükseltme Hakkında: Zirve",
      "text": "Eskiden daha güçlü olma düşüncesi bana anlamsız geliyordu ama artık gayet iyi anlıyorum. Keşke azıcık daha güçlü olabilseydim."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Yükseltme Hakkında: Sonuç",
      "text": "Bunların hepsi senin sayende oldu. Ne kadar teşekkür etsem az. Bana bir söz vermeni istiyorum. Bu andan itibaren seni korumama izin ver. Kabul ediyor musun? Evet mi, hayır mı?"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Element Becerisi: I",
      "text": "Hayat döngüsü."
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Element Becerisi: II",
      "text": "Hayat devam ediyor."
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Element Becerisi: III",
      "text": "Git."
    },
    {
      "id": "100004",
      "type": 2,
      "title": "Element Becerisi: IV",
      "text": "Yüksel."
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Element Patlaması: I",
      "text": "Emir verildi. Emir alındı."
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Element Patlaması: II",
      "text": "Kutsal isim: Uğur Getiren"
    },
    {
      "id": "200003",
