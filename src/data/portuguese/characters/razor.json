  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Olá...",
      "text": "Você cheira... Bem! Vamos caçar."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Bate-papo - Aroma",
      "text": "... Cheiro de coelho..."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Bate-papo - Fome",
      "text": "Estou com fome. Vamos caçar."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Bate-papo - Contemplando o Vento",
      "text": "Eu vigio. Você sai, você me avisa."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Quando está trovejando - Aviso",
      "text": "Se você tem medo de trovões, se esconda agora."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Quando está trovejando - Guia",
      "text": "Evite as árvores. Siga-me."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Quando está ventando...",
      "text": "Vento... Eu gosto."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "A Ventania Está Chegando...",
      "text": "Muito vento... Isso machuca."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Bom dia...",
      "text": "Agora está fazendo sol, chegou a hora de caçar!"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Boa tarde...",
      "text": "Tive um grande almoço. Muita carne. Hmm, estou feliz."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Saudações...",
      "text": "Vá dormir. Vou assistir a lua."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Boa noite...",
      "text": "Você dorme. Eu vigio. Amanhã caçaremos."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Sobre Razor...",
      "text": "Eu não tenho uma família humana. Eu sou um lobo."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Sobre Nós - Amigos",
      "text": "#Você é {F#a minha amiga}{M#o meu amigo}. Podemos caçar. Juntos."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Sobre Nós - Armas",
      "text": "Eu tenho garras de ferro e dentes de trovão. Eu te protejo."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Sobre a Visão...",
      "text": "A Visão ajuda Razor... Lutar com presas relâmpago para proteger o Lupical!"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Algo para Compartilhar...?",
      "text": "Eu gosto das estrelas à noite. Tantas estrelas. No céu, no lago. E na cidade."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Coisas Interessantes...",
      "text": "Os lobos são o meu Lupical. Minha família."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Sobre Lisa...",
      "text": "Os raios da Lisa tornam o céu negro. Ela é forte. Ela é assustadora."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Sobre Barbara...",
      "text": "A Barbara é uma boa menina. Muito boa menina."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Sobre Diluc...",
      "text": "O Diluc é vermelho e preto. Quente e frio."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Sobre Venti...",
      "text": "Razor não entende poemas, mas... Lupical gosta deles..."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Sobre Bennett...",
      "text": "Bennett... Fala muito. Comer com ele, nunca cheio."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Sobre Klee...",
      "text": "Klee, amiga! Amiga, mas... Problemática."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Sobre Varka - Estranho",
      "text": "Varka? Razor não sabe..."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "Sobre Varka - Memórias",
      "text": "Oh, Varka é... Um nome. Aquele homem grande. Garra de aço grande, nome de Razor - Varka deu a ele. Oh... Quero vê-lo."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Mais sobre Razor (I)",
      "text": "Você cheira bem. Você gosta de carne?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Mais sobre Razor (II)",
      "text": "Você forte. Como um lobo. Eu gostar de caçar com você. Caçamos muito."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Mais sobre Razor (III)",
      "text": "Lupical significa lar de lobo - não, Lupical significa família de lobo. Meu Lupical vive na floresta. Eles dizem que eu sou o Lupical deles."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Mais sobre Razor (IV)",
      "text": "Meu Lupical é minha única família.\\nMas, não tenho quatro pernas, não como eles. Não sou um lobo real. Às vezes eu fico triste por causa disso."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Mais sobre Razor (V)",
      "text": "#Foi muito divertido correr com você, caçar com você. Não faz diferença de ser lobo ou humano, o mais importante é estar com você!\\nVocê é {F#a minha amiga}{M#o meu amigo}, é Lupical! Espero que fique feliz também."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Passatempos de Razor...",
      "text": "Gostar de Lupical, gostar de floresta, gostar de amigos, gostar de correr!"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Preocupações de Razor",
      "text": "Falar me deixa cansado. Falar difícil. Mas tenho que tentar."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Comida Favorita...",
      "text": "Eu gosto de carne e batatas."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Comida que Odeia...",
      "text": "Vegetais são ruins. Animais comem vegetais. Então eu como animais."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Recebendo Presentes — I",
      "text": "Cheira bem, e o gosto é bom, gostei."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Recebendo Presentes — II",
      "text": "Comer esse prato me deu energia e me deixou feliz."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Recebendo Presentes — III",
      "text": "Comer, não é bom. Não comer, também não é bom. Que triste."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Aniversário...",
      "text": "Hoje é o seu dia. Você nasceu neste dia, há muitas luas atrás. Hoje eu quero fazer você feliz. Podemos comer carne juntos?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Sentimentos sobre a Ascensão - Introdução",
      "text": "Braços... Maiores...?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Sentimentos sobre a Ascensão - Desenvolvimento",
      "text": "Grrr! Afiar garras. Afiar dentes. Ficar forte!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Sentimentos sobre a Ascensão - Auge",
      "text": "Correr... Caçar... Não. Não! Preciso... Ficar forte!"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Sentimentos sobre a Ascensão - Conclusão",
      "text": "Dentes, Garras, Pernas. Tudo maior. Tudo mais forte! Para te proteger!"
    },
