  "outfits": [
    {
      "id": 206200,
      "name": "Caçadora de Máquinas",
      "description": "Vestuário de Aloy. Perfeito para caçar na natureza.",
      "isDefault": true,
      "characterName": "Aloy",
      "characterId": 10000062,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aloy_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Olá...",
      "text": "Sou Aloy. Não conheço este mundo, mas minhas flechas estão afiadas e meu arco está pronto. Se sua equipe precisar de ajuda, farei o que puder."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Bate-papo - Em movimento",
      "text": "#Vamos, chega de ficar parad{F#a}{M#o}, temos que andar."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Bate-papo - Ajuda",
      "text": "Não devemos parar agora. Ainda tem pessoas que precisam da nossa ajuda."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Quando está chovendo...",
      "text": "Chuva. Uma forma de limpar a sujeira."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Depois da Chuva...",
      "text": "A chuva parou, precisamos nos secar."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Quando Está Nevando...",
      "text": "Quando está nevando, parece que o mundo inteiro fica mais calmo."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Quando está ventando...",
      "text": "O vento está soprando novamente. É bom respirar esse ar."
    },
    {
      "id": "1205",
      "type": 1,
      "title": "A Ventania Está Chegando...",
      "text": "A ventania está chegando, meu rosto dói quando o vento sopra."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Bom dia...",
      "text": "Bom dia! O mundo está repleto de energia, assim como eu."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Boa tarde...",
      "text": "Já se passou metade do dia e ainda tenho muita coisa para fazer."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Saudações...",
      "text": "O sol já se pôs. Fazia muito tempo que eu não via estrelas no céu."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Boa noite...",
      "text": "Boa noite, está na hora de descansar. A menos que você queira continuar a agir sob a luz das estrelas."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Sobre a Aloy...",
      "text": "Eu cresci como uma pária, e não foi muito divertido. Embora eu seja uma estranha aqui, as pessoas são mais amigáveis do que a tribo que deveria me criar. É... Agradável."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Sobre Nós - Execução",
      "text": "Todas as minhas ações são para salvar vidas, não para trazer a morte. É por isso que luto lado a lado com você."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Sobre Nós - Promessa",
      "text": "Uma promessa parece ser mais como uma formalidade. Mas se você quiser a minha, você a tem."
    },
    {
      "id": "2004",
      "type": 1,
      "title": "Sobre Nós - Avanço",
      "text": "Vou tentar o meu melhor para seguir em frente com você até o fim. Não vou hesitar, nem vou falhar."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Algo para Compartilhar...",
      "text": "Se há algo para compartilhar, deve ser meu arco e flecha. Eu só uso para ajudar os outros."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Coisas Interessantes...",
      "text": "Como o mundo do meu lado, o passado deste mundo está cheio de segredos. Se eu tiver tempo suficiente, irei descobrir todos os seus segredos."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Mais sobre Aloy: I",
      "text": "Não gosto tanto de conversar. Para mim, a missão é mais importante."
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Mais sobre Aloy: II",
      "text": "Não tenho pais. Fui criada por um homem chamado Roster. Ele era um pouco duro, mas tinha um bom coração e era generoso. Ele me ensinou muitas coisas, hum... Eu sinto muito falta dele."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Mais sobre Aloy: III",
      "text": "Passei toda minha vida procurando minha mãe e nunca a encontrei, não mesmo. Mas encontrei mensagens antigas da mulher de quem eu fui... Clonada. Parecia que era como se ela me conhecesse. E como me inspirar."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Mais sobre Aloy: IV",
      "text": "Quando cresci, eu não tinha amigos. Mais tarde, em minhas viagens, eu fiz alguns. Mas deixei esse mundo antes que pudéssemos ficar mais íntimos. É por isso que estou feliz por ter passado algum tempo com você."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Mais sobre Aloy: V",
      "text": "A confiança não é fácil para mim, mas sei que posso confiar em você. Você é um verdadeiro amigo, e não digo isso direto."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Passatempos de Aloy...",
      "text": "Não tenho certeza se tenho um passatempo, acho que ler coisas antigas conta como um. Bem, história, então?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Preocupações de Aloy...",
      "text": "Um mundo precisava ser salvo. E agora outro. Nunca há tempo suficiente para descansar."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Comida Favorita...",
      "text": "Eu não sou exigente. Qualquer coisa é melhor do que viajar com o estômago vazio."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Comida que Odeia...",
      "text": "Tivemos uma vez um ensopado de Oseram que era tão espesso que se podia pavimentar uma estrada com ele. Urrgg..."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Aniversário...",
      "text": "Nunca dê muita importância a aniversários. De onde eu venho, é hora de celebrar sua mãe, não a si mesmo. Mesmo assim, desejo a você, uuuh, um dia feliz."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Sentimentos sobre a Ascensão - Introdução",
      "text": "Bem, parece que estamos fazendo progresso, mas não podemos parar agora."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Sentimentos sobre a Ascensão - Desenvolvimento",
      "text": "Estou ficando melhor, e mais forte. Isso é bom."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Sentimentos sobre a Ascensão - Auge",
      "text": "#Não importa quão {F#boa caçadora}{M#bom caçador} você seja, sempre pode melhorar. Nunca descanse, e nunca pare de aprender."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Sentimentos sobre a Ascensão - Conclusão",
      "text": "#Quando nós começamos, você era só mais {F#uma estranha}{M#um estranho} em um mundo que eu não entendia. Mas após tudo que passamos junt{F#as}{M#os}, posso dizer com certeza: meu coração é seu, hoje e sempre."
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Habilidade Elemental - I",
      "text": "Isso daqui vai explodir!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Habilidade Elemental - II",
      "text": "Tenho algo aqui para você!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Habilidade Elemental - III",
      "text": "Já viu um desses daqui?"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Supremo - I",
      "text": "Aprisionado!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Supremo - II",
      "text": "Um truque novo."
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Supremo - III",
      "text": "Essa caça é minha!"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "Abrindo o Planador - I",
      "text": "Haha, essa coisa é divertida!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Abrir Baú do Tesouro - I",
      "text": "Essas coisas parecem ter vindo em uma boa hora."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Abrir Baú do Tesouro - II",
      "text": "Esses são comestíveis... esses dão para usar..."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Abrir Baú do Tesouro - III",
      "text": "Quem será que deixou essas coisas..."
    },
    {
      "id": "410001",
      "type": 2,
      "title": "Vida Baixa - I",
      "text": "Que presa irritante..."
    },
    {
      "id": "410002",
      "type": 2,
      "title": "Vida Baixa - II",
      "text": "Onde está seu ponto fraco..."
    },
    {
      "id": "410003",
      "type": 2,
      "title": "Vida Baixa - III",
      "text": "Está fora da minha alçada..."
    },
    {
      "id": "400001",
      "type": 2,
      "title": "Aliado com Vida baixa - I",
      "text": "Cuidado!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "Aliado com Vida baixa - II",
      "text": "Não se precipite!"
    },
    {
      "id": "500001",
