  "outfits": [
    {
      "id": 201501,
      "name": "帆影游風",
      "description": "凱亞在舞臺上飾演「短刀大盜」時的裝扮，以「吸睛」為設計原則的華麗服裝。不過衣服穿起來並不麻煩，最花時間打理的是飾品與短刀。",
      "isDefault": false,
      "characterName": "凱亞",
