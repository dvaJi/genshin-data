    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#西風騎士團，凱亞。請讓我與{F#妳}{M#你}同行吧。比起團裡的差事，還是做{F#妳}{M#你}的護衛要有趣得多。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·無所事事",
      "text": "#沒想到{F#妳}{M#你}也知道忙裡偷閒。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·騎士團",
      "text": "騎士團的戰友們已經忙得不可開交了吧，哼哼。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·懶散",
      "text": "逗留夠久了吧，再不活動活動筋骨，要長出蘑菇來了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "這雨天裡，冰凍的力量會更強吧，有趣。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候·逸聞",
      "text": "#呼…趁著這雪天，跟{F#妳}{M#你}講一個鬼故事吧。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候·寒冷",
      "text": "#怎麼，{F#妳}{M#你}怕冷？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "真是和平啊，可是又能持續多久呢？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "享受這一天吧。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "喲，要不要一起去酒館坐坐。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#{F#妳}{M#你}該不會怕黑吧？哦？那我…可找到新素材了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "這就要走了嗎。那就下回見了，別讓我等太久啊。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於凱亞自己…",
      "text": "#{F#妳}{M#你}最近有沒有被深淵教團找麻煩？有什麼心煩的可以跟我聊聊。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·僱傭關係",
      "text": "需要我的時候就派我上場吧，別談那些雇傭關係了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·實力",
      "text": "哦？既然這麼在意我們之間的雇傭關係，就多使喚我一點吧，老大？哼哼，可別被我的真正實力嚇到哦。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#不明白「神之眼」的原理？嗯…我想想，給{F#妳}{M#你}打個比方吧。引導視線的器官是眼睛，而引導元素力的器官是「神之眼」。這樣就很簡單了吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#{F#妳}{M#你}喜歡酒嗎？蒲公英酒的口感就很特別。什麼？還沒到喝酒的年紀？呵呵，那試一試蒙德的蘋果釀吧，我知道一家還算不錯的店。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}見過龍脊雪山的貓頭鷹嗎？和牠對視的時候，牠好像看穿了{F#妳}{M#你}，而{F#妳}{M#你}卻完全參不透牠…很迷人的傢伙，不是嗎？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於琴…",
      "text": "#哦？代理團長大人，{F#妳}{M#你}可要多多支持她。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於麗莎…",
      "text": "#麗莎啊…{F#妳}{M#你}千萬記得要準時還書哦？上次因為這事惹她生了氣，直到現在我左手的尺骨還是麻麻的。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於安柏…",
      "text": "偵察騎士是個機靈又正義的好騎士。可千萬別在她面前做壞事喔。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "迪盧克？小時候的他挺可愛的。可如今卻活在自己的世界裡…總之是個無趣的傢伙。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於可莉…",
      "text": "#可莉，看來還是沒有掌握躲避代理團長檢查的技巧啊，明明我已經點撥過她…哈哈，我說著玩玩的，{F#妳}{M#你}可別去揭發我哦。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "#阿貝多啊，沉穩優雅的小帥哥，而且才華橫溢，是很討人喜歡的類型。怎麼，{F#妳}{M#你}也心動了？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於迪奧娜…",
      "text": "#{F#妳}{M#你}也嚐過了迪奧娜調的酒？還沒到喝酒的年紀哪。哈哈，哎呀，可惜，真是可惜，這種快樂無法跟{F#妳}{M#你}共用。呵呵，只能期待{F#妳}{M#你}早點長大囉。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "說來可惜，現在的西風騎士團裡，根本沒人繼承大團長的行事作風。唉…我個人倒還挺欣賞那種的。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於菲謝爾…",
      "text": "#什麼？{F#妳}{M#你}說菲謝爾遮起一隻眼睛的神秘樣子，的確很符合「斷罪皇女」的形象？哈哈哈，按照這個規律，我至少也得是個末代皇族後裔，對吧？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於諾艾爾…",
      "text": "我受代理團長大人所託，暗中照顧這位後輩。不過她很懂事，不需要我操太多心。真是令人欣慰。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於蘿莎莉亞…",
      "text": "#啊哈哈，{F#妳}{M#你}想知道蘿莎莉亞修女的秘密嗎？這個不能說。不過我對她印象還不錯，比某人好多了。她能夠誠實地面對自己。爛事就是爛事，提不起幹勁就是提不起幹勁。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於砂糖…",
      "text": "#別看砂糖文靜又內向，據說，她在實驗室裡，收藏了很多特別的東西哦，很刺激，又很…露骨的那種。嗯？{F#妳}{M#你}問我？…我像是會偷看女孩子房間的人嗎？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於柯萊…",
      "text": "#嗯，柯萊？真是個懷念的名字，{F#妳}{M#你}真是找對人了！我來告訴{F#妳}{M#你}過去發生的事情吧，乾脆從頭說起——保證原汁原味！"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於米卡…",
      "text": "剛開始接觸那時，我看米卡容易緊張，就跟他開了一點無關緊要的小玩笑。誰知道他更緊張了，連笑都笑得很僵硬…最後還特地寫信道歉。欸，這種單純老實的性格，難道是施密特家族的遺傳？"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於塔利雅…",
      "text": "他平常是不是經常會喝教堂裡的葡萄酒？酒量真不一般。那次我在豪飲比賽裡輸給了他，這成為了我們結識的契機。風神熱愛美酒，風神的代行人也在孜孜不倦地傳播美酒的魅力。這就是自由之城的浪漫吧！"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "關於洛恩…",
      "text": "洛恩那小子，已經有一段時間沒來找我幫忙偽造簽名了啊…難道他已經學會手法了？以他的聰明程度倒也不奇怪…之後我用大團長的筆跡寫一封信給他吧，看看他究竟學懂了幾成。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解凱亞·其一",
      "text": "騎兵隊長的頭銜可沒什麼了不起的。說起來，蒙德城的騎兵都被大團長帶走了。呵呵。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解凱亞·其二",
      "text": "其實西風騎士團一共有十位隊長。但不是所有人都有隊長級的實力。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解凱亞·其三",
      "text": "我的眼睛？我的眼睛沒事。想把身體的某些部分遮起來是很平常的事吧？衣服和褲子也是一個道理。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解凱亞·其四",
      "text": "#坎瑞亞？哦，{F#妳}{M#你}知道的真多。坎瑞亞的榮耀早已不在，剩下的如今都已淪為罪人，又何必再提起他們。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解凱亞·其五",
      "text": "#原來我們已經相遇這麼久了。跟{F#妳}{M#你}一起旅行，大概是我這輩子遇上的最有趣的事了，今後可別讓我失望哦。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "凱亞的愛好…",
      "text": "品酒也是一種藝術，蒙德的酒是風神的恩賜，懂得好好品味才不會浪費了這份幸運。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "凱亞的煩惱…",
      "text": "孤獨？怎麼會，現在不就有人在我身邊嘮叨嗎。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "蒙德特釀的起泡白葡萄酒，兌上三份蒲公英酒，苦味會被完美中和，這種酒名叫「午後之死」。美味。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "居然有人直接把葡萄汁拿來喝，明明只需少許時日就能變成佳釀的…嘖，真是不懂浪漫。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#喔！這味道好棒，看不出來，{F#妳}{M#你}真有兩下子啊。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "配上美酒，會變得更美味吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "放心，我只是吃得慢了一點，我會好好吃完的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#值得慶賀的日子，祝{F#妳}{M#你}今天能得到真正的快樂。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#嚯，{F#妳}{M#你}也有兩下子嘛。"
    },
    {
