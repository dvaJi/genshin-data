  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#這就是{F#妳}{M#你}的冒險團嗎？真好啊…又熱鬧，又有人情味。啊，我是「班尼冒險團」的團長班尼特！能把我列入你們的合作夥伴嗎？拜託了！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·寶藏",
      "text": "不如在周圍找找看吧，說不定有寶藏呢！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·冒險",
      "text": "好久沒有和別人一起冒險了！我們走吧！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·調侃",
      "text": "俗話說「等在原地是不會有好事發生的」，當然以我的運氣來說，往哪裡走都一樣啦…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "我冒險的時候，大多都是這種天氣。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#啊！別和我站得太近，這樣雷就不會劈到{F#妳}{M#你}了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "今天的天氣真不錯…啊，糟了，說完這種話多半就要下雨了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "小心點，別被吹過來的石頭砸到腦袋了！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安！我們今天去哪冒險啊？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#我帶了三明治，要吃嗎？分{F#妳}{M#你}一半…唔唔！咳，咳…不好意思，噎到了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "要不要陪我去和老爹們聊聊天啊？老冒險家的故事可有意思了！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#要走了嗎？能和{F#妳}{M#你}一起冒險太開心了，下次記得再叫上我啊！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於班尼特自己·冒險團",
      "text": "我就是「班尼冒險團」的團長，振興蒙德冒險家協會的希望之星…沒見過其他團員？那個…最近他們都請假了，哈哈。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於班尼特自己·壞運氣",
      "text": "沒有傳說中那麼誇張啦，不過就是走路經常會掉進獵人打獵用的坑裡，或者被突然倒下的樹幹砸到腦袋，都很平常嘛，對吧？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·搭檔",
      "text": "哈哈，不行的，「班尼冒險團」早就滿員了…合適的人選有那麼多，沒必要找我這個倒楣蛋吧？"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·分工",
      "text": "#以後我負責引走怪物和觸發陷阱，{F#妳}{M#你}就負責帶走寶藏。啊，這樣不行嗎？哎呀，沒事沒事！不用擔心我會受傷啦，這是我最擅長的！而且為了{F#妳}{M#你}的話，我願意！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·險境",
      "text": "#我終於明白{F#妳}{M#你}為什麼找我搭檔了，{F#妳}{M#你}和我很像，一定也很喜歡置身於險境的那種快感吧！冒險就是因為有危險才讓人欲罷不能啊。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "沒想到我這麼倒楣的人也可以獲得神的認可，既然神都沒有放棄我，我又怎麼能放棄我自己呢？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#有機會要和我一起去俯瞰蒙德的夜景嗎？蒙德城燈火通明，果酒湖反射著月光，特別漂亮…{F#妳}{M#你}問我在哪裡看到的？哈哈，有一次不小心被龍捲風捲到了特別高的地方…什麼？不想去啊，哦，好吧…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "其實我很喜歡高麗菜，看起來很普通，卻是一般人家必不可少的食物。它能生長在很多地方，也能和很多食材搭配，還從不搶味道。其實普通一點，也挺好的嘛。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "她很擅長唱歌跳舞！我冒險不順的時候就會去看她的演出，跟著觀眾一起喊喊口號加加油，心情就變好了，真的很神奇！這就是她為什麼這麼受歡迎的原因吧…啊，我這個當團長的，要是也這麼受歡迎就好了。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於可莉…",
      "text": "那個孩子啊…很可愛，但我必須和她保持距離。只要我陪她玩，她的那些炸彈就會突然爆炸…我倒楣一點無所謂，但要是炸傷了可莉就麻煩了，估計整個騎士團都會跟我沒完吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於菲謝爾…",
      "text": "她是異世界來的「斷罪皇女」，可厲害了！我不止一次和她說想要去她的家鄉冒險，但每次說到這裡她就吞吞吐吐的…嗯，一定是擔心我的安危吧，看來她的家鄉真的是很兇險的地方。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於琴…",
      "text": "我本來想向琴團長要一些對蒙德的冒險家協會的支援，但其實我不太知道要怎麼和她說…冒險家協會沒有騎士團那麼多規矩，我和老爹們成天也嘻嘻哈哈的，但用這種態度和琴團長說話，肯定不行吧…我是不是要學一下騎士團敬禮的方式？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "他是我非常崇拜的人，名副其實的大團長！能領導整個西風騎士團，那該有多厲害啊。不過後來我想了想，冒險團規模太大好像也不行，團裡太忙了的話，老爹們就沒人照顧了。哈哈，還是現在好啊。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於雷澤…",
      "text": "#{F#妳}{M#你}說奔狼領的那個小哥哥啊，他雖然看上去凶巴巴的，也不願意說話…但是是個有趣的人哦！他和我都特別喜歡吃肉，我給他做肉吃，他教我狼怎麼說話，哈哈，{F#妳}{M#你}下次要不要一起來？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於安柏…",
      "text": "哦哦，想起來了，那個女孩子，總橫衝直撞的…她和我一樣，經常去野外冒險！只不過…只要路邊架著鍋，就總會飄來濃濃的黑煙，還有什麼東西燒糊了的味道…唔，難道她的運氣也很差？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於諾艾爾…",
      "text": "#{F#妳}{M#你}說她啊，其實我注意她很久了。她很有天分，又特別努力，但在騎士團只能當女僕，一直沒成為正式的騎士，{F#妳}{M#你}不覺得太可惜了嗎？唉，要是她肯來冒險家協會，估計早就是個了不起的冒險家了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解班尼特·其一",
      "text": "#什麼，想要瞭解我？哈哈，我只是個普普通通的倒楣冒險家，和{F#妳}{M#你}的各種傳奇經歷相比，簡直不值一提啊。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解班尼特·其二",
      "text": "「老爹們」…這是我對蒙德的老冒險家們的叫法，聽說我是他們在非常險惡的絕境中撿到的孤兒。很奇妙對吧？明明我的運氣這麼差，居然能被人撿到還活到了現在，簡直是奇跡啊。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解班尼特·其三",
      "text": "#{F#妳}{M#你}看出來了啊…呵呵，沒錯，「班尼冒險團」很久之前就只有我一個人了。因為我很倒楣，無論是多麼簡單安全的冒險都會變得險象環生，沒人願意跟著這樣的團長…{F#妳}{M#你}也會這麼想嗎？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解班尼特·其四",
      "text": "#我的壞運氣是與生俱來的，長這麼大也差不多習慣了。其實換種想法，「倒楣」其實也是件好事，因為說不定哪天我的壞運氣就會害死我，我才會想趁著還活著的時候，去更多的地方冒險，認識更多的人——不然，可能我就沒機會認識{F#妳}{M#你}了，哈哈！"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解班尼特·其五",
      "text": "#不知不覺，我們已經搭檔很長時間了。其實我有一個夢想，等到蒙德城的冒險家協會發展成七國裡最壯大的協會，我就要去周遊提瓦特大陸！「班尼冒險團」會變成最偉大的冒險團，而我們，就是最偉大的兩位冒險家！…{F#妳}{M#你}問你什麼時候加入的？哎呀，這種細節不用在意嘛。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "班尼特的愛好…",
      "text": "我什麼都喜歡，但最喜歡的還是冒險！總有一天我會找到這世界上最珍貴的寶藏，到時候老爹們就都能過上好日子，蒙德的冒險家協會也會熱鬧起來吧！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "班尼特的煩惱…",
      "text": "硬要說的話…特別倒楣的日子心情會不太好，比如冒險又什麼都沒找到，或者老爹的身體犯老毛病了之類的，但這些都算不上煩惱，睡一覺就全忘光了。新的一天當然要有新的開始！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#肉！肉是最能讓人精力充沛的食物！野菇雞肉串，烤肉排，還有甜甜花釀雞都是我的拿手菜。和我一起冒險，是不會讓{F#妳}{M#你}餓肚子的。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "雖然說冒險家不能挑食，但其實我不是很能吃辣，比如絕雲椒椒什麼的…吃了之後就喘不上氣，感覺呼吸都是辣的，而且之後肯定會拉肚子…這種惡魔一樣的果子究竟是怎麼長出來的。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "太幸福了！哈哈…哎呀！會不會把這陣子的好運全部用完了…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#無論做什麼都很好吃，真不愧是{F#妳}{M#你}啊！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "完了…肚子已經開始疼了…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！祝{F#妳}{M#你}新的一年也能有最好的運氣！放心吧放心吧，倒楣是不會傳染的，因為只要有我在，它們就不會找上{F#妳}{M#你}了。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "所有力量都提升了！除了運氣，哈哈。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#這樣距離{F#妳}{M#你}就又近了一步，我會繼續努力的！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#得到了這麼強的力量，我要怎麼報答{F#妳}{M#你}呢？對了，我知道一個藏著無價寶藏的秘境，一起去冒險吧？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#託{F#妳}{M#你}的福，現在的我應該有能力保護其他人了，這下子大家都會對我慢慢改觀吧——那個倒楣得要命，總是遍體鱗傷的班尼特，終於變成一個可靠的冒險家了！…嘿嘿，但願吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "哈——"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "燒起來吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "上天去吧！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "喝啊！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "炸飛你們！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "都閃開！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "我來保護大家！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "該總攻擊了！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "有大家在身邊，傷口就不會痛！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "冒險、冒險！"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "好，出發！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "是貨真價實的寶藏！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "我居然也有這麼好運的一天！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "根本就是奇蹟！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "糟糕…最近繃帶在漲價啊！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "別擔心…我堅持得住。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "絕地反擊？這個我熟，讓我來吧。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "別逞強，交給我！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "有本事衝我來！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "我真是個不稱職的團長…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "不出意料的…壞運氣…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "沒能突破…厄運的封鎖…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "只是意外。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "痛死了。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "又沒躲開…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "真、真的在叫我嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "決不拖後腿！…盡量。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "太棒了！"
    }
  ]
}