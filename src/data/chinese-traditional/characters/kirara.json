  "outfits": [
    {
      "id": 206101,
      "name": "倩影遊俠",
      "description": "綺良良的裝扮款式。童話中行俠仗義的貓貓劍客，傳遞願望的狡黠少女，向您致意。",
      "isDefault": false,
      "characterName": "綺良良",
      "characterId": 10000061,
      "source": [],
      "filename_card": "UI_AvatarIcon_MomokaCostumeErrantry_Card",
      "filename_icon": "UI_AvatarIcon_MomokaCostumeErrantry",
      "filename_iconCircle": "UI_AvatarIcon_MomokaCostumeErrantry_Circle",
      "filename_splash": "UI_Costume_MomokaCostumeErrantry",
      "filename_sideIcon": "UI_AvatarIcon_Side_MomokaCostumeErrantry"
    },
    {
      "id": 206100,
      "name": "百花戲",
      "description": "綺良良的裝扮款式。「用舒適的方式把美麗的花朵穿在身上」，著名設計師千織小姐依上述原則為綺良良製作了這套衣裝。",
      "isDefault": true,
      "characterName": "綺良良",
      "characterId": 10000061,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Momoka_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，我叫綺良良，稻妻「狛荷屋」的快遞員。{F#妳}{M#你}放心，沒有什麼快遞是我送不到的！什麼？我的尾巴？哦，因為我是隻妖怪嘛！被稱作「貓又」的妖怪。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·包裹",
      "text": "唔…包裹裡裝了什麼呢？好好奇…不行不行，不能看客戶的東西。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·訂單",
      "text": "讓我看看訂單…走吧走吧，下一個目的地還很遠呢。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·工作",
      "text": "哇！這裡的景色真不錯。嘿嘿，我算是選對工作了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "#唔…！毛都濕掉了，{F#妳}{M#你}也要一個箱子躲一躲嗎？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "喵嗷！呼…嚇…嚇得我都不會說人話了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "好冷，尾巴要凍成冰棒了…還是待在屋裡取暖比較舒服，只要離火盆遠一點，毛就不會被燒焦了吧？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "陽光真好啊，要是再有一棵樹的話…唔，想想都有睡意了…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "嗚啊！小包裹要被吹走了！"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "沙粒擠到肉球裡了…好奇怪的觸感…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安！看{F#妳}{M#你}還沒醒，我就先去弄了點吃的。哎呀放心，不是小松鼠、小團雀什麼的。雖然那些也滿好吃…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "啊——等我再睡一下…尾巴…尾巴都抬不起來了…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好，我已經準備好出發了。欸？{F#妳}{M#你}說該去睡覺了？可是我現在正是最清醒的時候呀，趕路很快的，視野又清楚，路上人又少。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#晚安，祝{F#妳}{M#你}有個好夢！不過…沒有尾巴煩{F#妳}{M#你}的話，{F#妳}{M#你}應該天天做的都是美夢吧？"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於綺良良自己·肉球",
      "text": "我的鞋子？哦，那就是我的腳啦。雖然我也能用妖力變出人類的腳，但果然還是要有肉球和爪子，走起路來才安心嘛！呃…不行！不能摸！會很癢的！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於綺良良自己·名字",
      "text": "我的名字是奶奶幫我取的。在我還沒長出兩條尾巴的時候，奶奶就經常搔搔我的下巴、摸摸我頭然後誇我眼睛亮晶晶的，很好看。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·旅行",
      "text": "#{F#妳}{M#你}會到處旅行，而我則是到處送貨。{F#妳}{M#你}不覺得這很像嗎？都是從一個地方跑到另一個地方。不過，我花的是公司的錢，{F#妳}{M#你}花的是自己的…欸？沒…沒有！我沒有在得意！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·相遇",
      "text": "送快遞的工作讓我認識了各式各樣的人。有人成為了「狛荷屋」的回頭客，有人跟我變成了朋友，真好啊。每個包裹都有終點，但彼此的故事卻可以一直延續下去。人與妖怪結下情誼，也不是什麼難事嘛。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我到現在都記得自己第一次用妖力變成人類的感覺。那時候我真的很激動，滿腦子想著「終於能親自去人類社會看看了」！等回過神來，它就已經出現在了我的腰間。唔…難道這位神明也和我一樣，想要去各種各樣的地方嗎？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·捕獵",
      "text": "#人類打造的武器的確不錯，但我有時候還是想憑自己的本事。當{F#妳}{M#你}看到一隻小團雀的時候，難道不會想悄悄接近牠的身後，趴低身子等待時機…然後「唰」地一下撲上去嗎？這種捕獵的成就感，可是比送完一份快遞還要開心的呀！"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·箱子",
      "text": "聽奶奶說，這就是我小時候最喜歡鑽的那個箱子。說來也有趣，那時只覺得這「狛荷屋」的箱子又大又暖和，如今居然在這裡幹活了，身邊全是數不清的箱子。哈哈，命運還真是奇妙呢。不過…最近覺得有點擠…啊！不是的！我沒有胖！我才不會變成大黃那樣子呢！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·樹屋",
      "text": "#告訴{F#妳}{M#你}哦！須彌有好多房子都是蓋在樹上的！我的天，那每天曬太陽曬得多舒服？甚至不用專門下來覓食了！欸？{F#妳}{M#你}說{F#妳}{M#你}知道？好吧…那{F#妳}{M#你}知不知道這些房子是怎麼蓋的？我上次送貨用爪子爬上去都累得半死，那麼高的樹…當年的須彌人又沒有爪子…建材和家具又要怎麼運？唔…想不通。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞·大房子",
      "text": "這份工作能讓我見到好多好多大房子！比奶奶家大多了！都是什麼什麼宮、什麼什麼殿…房間多到數不完。這麼大的房子，住起來不會空蕩蕩的嗎？我的話…只要早上有吃飯的地方、中午有曬太陽的地方、晚上再有個小箱子就滿足了。哦！是不是有的人就喜歡睡在「大箱子」裡？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於八重神子…",
      "text": "#神子大人是稻妻遠近聞名的大妖怪。我這樣新生的妖怪，難免心生敬畏。但沒想到，這位狐妖大人非常和藹可親，不僅主動來見我，還教會了我很多有用的知識。比如人類社會的禮儀、與人交往的方法、還有油豆腐的炸法什麼的…咦？{F#妳}{M#你}說最後那個不知道也沒關係？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "送到天守閣的快遞都包裝得特別精美，裡面三層外面三層。該說不愧是獻給那位將軍大人的嗎…不過，裡面裝的到底是什麼呢？有時還會散發出香香的味道…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於鹿野院平藏…",
      "text": "我跟那位偵探在很久很久以前打過交道。他知道我是「貓又」之後，找過我幫忙打聽離家出走的貓貓們去了哪裡。我剛開始還滿樂意的，但後來聽到貓貓說什麼「就是想到外面走走嘛」、「回去後好無聊啊」什麼的，有些心軟，就謊稱沒見過牠們。可是那位偵探，好像看得出我在說謊。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "我一直想找那位天狗大人聊聊天。但她是天領奉行的大將，一直都是充滿威嚴的模樣，到現在我都只敢趴在遠遠的地方看她。我…我就是好奇她的翅膀啦。平時會覺得不方便嗎？還有那些掉下來的羽毛怎麼辦？唔…要是拿來墊在箱子裡的話，睡起來一定很舒服吧？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "他明明是隻鬼，卻和人類混得那麼熟，還有自己的幫派！唔，好厲害啊。我是不是也該向他請教請教呢？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於林尼…",
      "text": "我在楓丹見過一位魔術師，他能把各種東西變不見，還能把各種東西變出來！他用的一定也是妖力吧？一定是這樣吧？這麼說…他也是隻妖怪？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於千織…",
      "text": "千織姐對我很好，以前經常碰見她外出研究布料的做法和配色。雖然她一直很擔心我會抓壞那些衣料，但它們那麼漂亮，我根本捨不得啦！她現在在楓丹開了家店，有時也會叫我去送貨。嘿嘿，我身上這套衣服就是她幫我改良的。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解綺良良·其一",
      "text": "在我還是一隻小貓的時候，奶奶和我講過很多很多故事。什麼稻妻的妖怪啦、城裡的慶典啦、其他國家的美食啦什麼的…我就這麼在奶奶腿上趴著，聽著聽著就睡著了。到現在，我都不知道哪些是真的故事，哪些是我的夢。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解綺良良·其二",
      "text": "我喜歡這份工作，很適合我。而且，那位狐妖大人說過，要是不工作的話，是沒法在人類社會待下去的。這可不行！我會送好每一份快遞，我…我才不要回那個荒郊野嶺做什麼大妖怪呢！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解綺良良·其三",
      "text": "大概是因為我看起來比較好欺負吧，我送貨時，遇到過好多想來搶劫的盜賊。但他們無一例外，全被我給打跑了！不過我沒有用全力。畢竟…要是打傷了人算到公司頭上的話，我可是會被開除的呀！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解綺良良·其四",
      "text": "每到一個新城市，我總喜歡爬到高高的地方，俯瞰那裡的景色。有時街道吹起微風，花瓣們就像一隻隻晶蝶一樣，從這頭飄到那頭；有時太陽落下，城市裡就會亮起燈火，從高處看去，就像正午樹蔭下活潑的小光點。要不是趕著送貨，我可以趴上一整天。哎，真想帶老家的奶奶來看看這些。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解綺良良·其五",
      "text": "享受生活是很重要的！我的話，會在長途旅行的最後幾天，或是剛剛完成工作的那個晚上，找個最熱鬧的餐館美餐一頓，再選個最舒服的屋頂趴著吹風，直到睏了再香香甜甜地睡去…世上這麼多值得細細品味的快樂，不好好享受可就虧大了！所以，我總是把每條魚都啃得乾乾淨淨，也很好理解吧！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "綺良良的愛好…",
      "text": "我喜歡到各個地方送貨。只要收貨地址是我沒去過的地方，我就會激動得睡不著覺，恨不得馬上出發。小時候身邊都是森林灌木，看都看膩了。但外面我沒見過的東西數都數不清。每個地方都充滿了新鮮感！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "綺良良的煩惱…",
      "text": "儘管人類的生活豐富多樣，但規矩也太多了。「不能在房檐上睡覺」、「不能抓景觀池裡的魚」、「不能隨便磨爪子」…但只要我變成原本的模樣，就不會有人來管我這些事。壞處就是「貓又」的身分有點顯眼，還不方便進餐館點好吃的。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "還是隻貓的時候，我最喜歡奶奶做的飯，一次能悶頭吃下一大碗！現在的話…嗯，果然還是刺身拼盤吧！又嫩又鮮的魚肉直接端到面前，都不用我自己挑刺和去鱗了！不過每次啃魚頭的時候，店家總會用奇怪的眼神看著我。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#有次我在海邊抓魚，沒注意身後，被一隻螃蟹夾住了尾巴，痛死我了！當時還以為要斷掉了呢。{F#妳}{M#你}說螃蟹這東西，肉又少，殼又厚，用爪子都打不開，有什麼好吃的？哦對了，燙的東西我也受不了。當我聽說有道菜叫「奶油蟹蟹」的時候，簡直不敢相信！這聽起來就又燙又硬的菜，到底要怎麼吃啊？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#哇…是從沒嚐過的味道，太好吃了吧！{F#妳}{M#你}…{F#妳}{M#你}不會是司掌料理的大妖怪吧？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "唔~！好吃！還有嗎還有嗎？我想帶一點路上吃！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "想起了以前在野外流浪的日子…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！不管是人還是妖怪，來到這個世界都是一件值得慶祝的事！如果{F#妳}{M#你}願意的話，等等帶{F#妳}{M#你}去我小時候生活的地方看看。雖然不是什麼熱鬧有趣的地方，但總讓我覺得很安心。我還可以把最喜歡的箱子讓給{F#妳}{M#你}，躺在裡面很舒服的！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哦！好像妖力提升了！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "咦？是不是尾巴也變長了一點？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "身體變得更輕了！感覺能一口氣送十份快遞！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#哇，我現在的妖力，說不定連那個狐妖大人也…啊哈哈…還是算了，我也不想去比較什麼。只要能守護好每一份客戶的快遞，我就滿足了。當然…還有一直陪伴著我的{F#妳}{M#你}。對了，要不要來摸摸我的尾巴？我真的覺得它們變長了欸！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "嘿咻！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "搔你哦！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "借過！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "快遞到囉。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "記得給好評。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "請您簽收，喵。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "哇，好多沒見過的東西！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "是誰掉的包裹嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這箱子能鑽嗎？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "得保護好包裹…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "找找其他路…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "喵…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "快躲到箱子裡！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "#讓我來幫{F#妳}{M#你}一把！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "快遞…送不到了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "想縮回…箱子裡…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "要被…開除了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "痛！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "我的尾巴！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "包裹要緊！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "有什麼快遞要送嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "感謝選擇「狛荷屋」！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "公費出遊？我去我去！"
    }
  ]
}