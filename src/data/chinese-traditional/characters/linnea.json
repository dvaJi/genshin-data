  "outfits": [
    {
      "id": 213000,
      "name": "孤羽成讖",
      "description": "莉奈婭的裝扮款式。特別訂製的冒險服，兼有美觀與實用之能，還為露米（和其他未來可能到來的朋友）準備了專屬的隨身小屋。唯一的問題是這間小屋的對外窗只有一個，到底誰能住在窗邊，是一個值得莉奈婭和她的朋友們仔細討論的問題。",
      "isDefault": true,
      "characterName": "莉奈婭",
      "characterId": 10000130,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Linnea_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好！我叫莉奈婭，是冒險家協會的顧問，這個小傢伙是露米，是我的夥伴。關於野外冒險{F#妳}{M#你}有什麼想知道的，儘管問我好了！對了對了，如果{F#妳}{M#你}在冒險時遇見了什麼不可思議的生物，別忘了告訴我哦！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·露米",
      "text": "#露米很可愛對吧？不過要是{F#妳}{M#你}身上有亮晶晶的東西，要小心別被它吞掉囉！不然很有可能找不回來，哈哈…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·「斯佩蘭扎」",
      "text": "#要說那夏鎮最值得去的地方…當然是「斯佩蘭扎」了。{F#妳}{M#你}就當是我偏心好了，去吃吃看吧，卡嘉的手藝不會讓{F#妳}{M#你}失望的。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·圖鑑",
      "text": "#{F#妳}{M#你}想看看圖鑑？當然可以，這可是我的得意之作，就連裡面的插圖也都是我自己畫的呢。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨過天晴…",
      "text": "濕潤的泥土氣息…世界重新醒來了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "好冷哦…要堆雪人嗎？露米也來幫忙吧！啊！不用錘子。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "起風的時候…",
      "text": "不知道蒲公英的種子會飛向何方…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "「睡吧，睡吧，黃金的夢鄉在召喚流浪的沙子，在這裡不必將那苦澀的鹽水掬飲，在這裡不會再有明日的愁腸…」"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安！草葉上的晨露還在，很清新，{F#妳}{M#你}也要聞一聞嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "差不多該吃點東西補充能量了，今天還很長呢，還能做很多事！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#{F#妳}{M#你}要是還不睏，我們就這樣一起看會星星，好嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#今天也走了好多路，該休息了，祝{F#妳}{M#你}做個好夢，晚安…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於莉奈婭自己·追逐和等待",
      "text": "這個世界上有許多美麗又奇特的生命，要瞭解牠們的秘密，就像和一個害羞的朋友玩捉迷藏，但好在無論是追逐還是等待，都是我擅長的。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於莉奈婭自己·童年",
      "text": "雖然沒能和「家人」一起生活，但我知道，他們都以自己的方式愛著我…我是被截然不同的愛澆灌長大的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·見聞",
      "text": "#哇，{F#妳}{M#你}的腦袋裡到底是裝了多少奇妙的見聞啊！和{F#妳}{M#你}聊天真讓我受益匪淺…要不然乾脆讓我推薦{F#妳}{M#你}當冒險家協會的顧問吧？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·分享",
      "text": "#{F#妳}{M#你}已經知曉了我的故事，而{F#妳}{M#你}的世界，我才剛剛窺見一角。如果可以的話，今後我也想聽{F#妳}{M#你}分享那些我不曾參與的冒險，作為交換…我會為{F#妳}{M#你}在黃金獵犬號上留一個位置的！"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「月之輪」…",
      "text": "#悄悄告訴{F#妳}{M#你}，其實我不靠它也能使用力量…不過露米很喜歡它，可能因為它也是亮晶晶的，所以就留下當作裝飾啦。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "據說挪德卡萊曾經存在廣闊的原始森林，松珀香就是那些參天巨木所流下的樹脂，人們浪漫地將其解讀為巨木之淚。而在數百年的時光中，森林消失了，淚水卻沒有乾涸。不過，只要拾起這些散落的「碎片」，我就能在腦海中還原出過去世界的模樣，這種像是回望古老遺珍一樣的樂趣，正是我無法停止冒險的理由啊。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "嘿嘿…美露莘真是太可愛了！嘿嘿…如果能在海沫村住一段時間就好了…可惜不管我怎麼拜託，她們就是不願意答應，到底為什麼呢？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於愛諾…",
      "text": "#我們曾經是海螺幫的夥伴呢。愛諾小時候真的可愛極了，後來她喜歡上了機械…唔，長大一點的愛諾還是很可愛，但她的愛好就沒那麼可愛了…{F#妳}{M#你}別誤會，不管她喜歡什麼我都支持她！只是…只是我真的很不擅長應付會動的機械…也許是因為「換生靈」的天性吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於伊涅芙…",
      "text": "聽說她做的蛋捲甜甜的，特別好吃，可惜我一靠近她就本能地想要逃跑，所以到現在還沒有品嚐過…而且她好像有什麼事想要問我的樣子，唉，不然下次去拜訪的時候讓愛諾把我綁在座位上聽她說好了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於菈烏瑪…",
      "text": "她的角冠真漂亮…我曾經很禮貌很禮貌地問過她，可不可以讓我摸一摸她的角冠，她很禮貌很禮貌地拒絕了我。看起來，霜月之子在這方面比美露莘還要嚴格…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於菲林斯…",
      "text": "我想，即使是在妖精之中，菲林斯先生也是最博學的那一類。雖然和他對話的機會不多，但每次交流都讓我收穫頗豐。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於奈芙爾…",
      "text": "在挪德卡萊活動，或多或少都會和「秘聞館」打交道，奈芙爾小姐辦事俐落，再沒有比她更可靠的合作夥伴了。不過，比起情報，我對她家的貓更有興趣，阿舍魯啊阿舍魯，你一定不是一隻普通的小貓咪吧…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於葉洛亞…",
      "text": "他年紀輕輕就當上了執燈人的分隊長，一定有什麼過人之處吧？不過我們第一次見面的場景有點混亂，可能給他留下了不好的印象，不知道他還會不會願意讓我為阿咚撰寫圖鑑條目…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於桑多涅…",
      "text": "#{F#妳}{M#你}知道嗎？冒險家協會的凱瑟琳其實是愚人眾執行官「木偶」的造物。通常來說，我是很不擅長應付這類會動的機械造物的，但面對凱瑟琳時卻沒有任何牴觸的情緒，真奇妙，不知道她使用了怎樣的技術。也幸虧如此，我才不用麻煩薩林或者其他人來幫忙接取協會的委託。如果有機會見到她，我真想向她道謝！"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於沃雅妮莎…",
      "text": "歌劇院裡的人們為她瘋狂，卻不知道自己聽到的不過是海浪的餘響。或許她也有自己的理由…但我能感覺到，在那副歌喉深處，潛藏著一旦釋放就能讓所有人理智斷線、萬劫不復的魅力呢！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解莉奈婭·其一",
      "text": "不是圖鑑或是冒險相關的問題，而是關於我自己嗎？這倒是個新鮮的視點，如果我是我自己的觀察者，會得出怎樣的結論呢…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解莉奈婭·其二",
      "text": "雖然已經不是海螺幫的一員了，不過有空的時候我還是會回去看看大家，「斯佩蘭扎」對我來說就是家一樣的地方。或許正是因為有了這樣一個棲身之所，我才能鼓起勇氣去探索並記錄這個世界，是他們無私的愛讓一度迷茫的我意識到自己並不是被世界所拒絕的…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解莉奈婭·其三",
      "text": "我也有過這樣的擔心，離開凍原，露米會不會適應不了？特別是去納塔之前，我害怕得都快睡不好覺了。萬一露米像雪人一樣，氣溫升起來了，它就一點點融化…嗚哇，現在想起來還是會覺得害怕！還好後來據我觀察，環境的溫度對露米沒什麼影響，哪怕差點掉進岩漿裡，它也還是笑嘻嘻地，真是了不起的霜精啊，露米。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解莉奈婭·其四",
      "text": "「去吧，妖精的孩子。到村落與城鎮中去吧，和人類朋友手牽著手。妖精的世界載滿妳不懂的憂愁…」我的父母試圖將我從那條既定命運的河流中撈起，把我放在人類的搖籃裡，希望人類對命運的遲鈍能成為保護我的繭，讓我免受那些過早到來的悲傷侵蝕。我也曾有過不解，但現在我知道了，這是一種出自悲傷的愛…傷痕或許不會消失，但結痂後就不會再流血了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解莉奈婭·其五",
      "text": "就像姐姐說的，也許未來我終究還是逃不開「讖鳥」一族的宿命，但在那之前，我想盡情享受探索解明未知世界的快樂，乘著黃金獵犬號走遍提瓦特大陸的每一個角落，將我的圖鑑填得滿滿的…而等到「那一天」來臨，或許我就能真正理解那份孤獨和痛苦，並心無芥蒂地擁抱我親愛的姐姐了吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "莉奈婭的愛好…",
      "text": "在觀察生物的時候我會想像自己也是其中的一員，過著和現在完全不一樣的生活…啊，譬如美露莘！如果我是美露莘的話，一定就能理解她們眼中所見的「色彩」了。這種東西，不是自己看到的話，完全無法想像嘛…"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "莉奈婭的煩惱…",
      "text": "對了，辛苦收集到的礦石標本總會莫名其妙地不見幾個…等等，該不會是被露米給吞掉了吧？露米，快張嘴啊，說：「啊——」"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我喜歡甜甜的食物——帶著露水的漿果、新鮮蜂蜜做的糖雕、剛出爐的蛋糕…如果在野外冒險時也能隨時吃到這些就好了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "只要不是對身體有害…我沒有什麼特別討厭的食物，要是明明可以吃卻因為口味的偏好而浪費掉，那也太奢侈了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "這個真的好吃！是怎麼做的，能教教我嗎？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#好吃！下次換我來，也讓{F#妳}{M#你}嚐嚐我的手藝。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "唔…至少對身體沒什麼害處。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂…雖然不是什麼貴重的禮物，但這塊我私藏已久的化石，請{F#妳}{M#你}收下。{F#妳}{M#你}看，這裡有著早已滅絕的鳥類留下的骨骼和羽印，雖然牠們再也無法飛翔，但那振翅的瞬間卻被拓印了下來…即使生命終會消逝，我們存在過的證明總會以某種方式延續。願{F#妳}{M#你}的生命也如古樹般堅韌，每一圈年輪，都刻錄下美好的故事。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感官變得更敏銳了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "對世間萬物的理解又更深了一層。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "感受得到力量的流動…就像掌握了洋流的規律，航行也會變得更順暢。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "知識正在轉化為直覺…我信任這個世界就像信任一朵雛菊。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "去吧，露米！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "打個招呼吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "可別小看了！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "嚐嚐這個！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "不可以挑食喔！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "要小心囉！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "青春之地的饋贈。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "如結晶般閃耀吧。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "皆大歡喜！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "怎麼樣？有什麼好東西嗎？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "亮晶晶的…露米，這個不能吃喔！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#看起來不錯，{F#妳}{M#你}運氣真好！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "還撐得住…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不應該是這樣的…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "要小心了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我來幫你！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "包紮就交給我吧！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "是我選錯了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "是噩夢嗎…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "這不是…屬於我的未來…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "哎呀…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "唔…！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不算什麼！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "好痛…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "露米！我們出發囉！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "今天要去哪裡探險？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "叫我嗎？我準備好啦！"
    }
  ]
}