  "outfits": [
    {
      "id": 208400,
      "name": "幻戲貓",
      "description": "林尼的裝扮款式。貓只在牠完全信任的人面前伸懶腰，其餘的時候，牠會藏起自己的爪子對人微笑。就像魔術師先生的甜言蜜語一樣，親密卻有所保留。",
      "isDefault": true,
      "characterName": "林尼",
      "characterId": 10000084,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Liney_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#是我喲，全提瓦特最棒的大魔術師——林尼。驚喜嗎？意外嗎？想知道我是怎麼出現在{F#妳}{M#你}面前的嗎？嗯——{F#妳}{M#你}那雙像黃寶石一般晶瑩剔透的眼睛，讓我很中意哦！讓我再為{F#妳}{M#你}表演一次吧。看好了哦，這回，千萬不要眨眼。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·分心",
      "text": "大魔術師就在面前，還有心思東張西望嗎？這樣就要錯過最精彩的一幕囉！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·妹妹",
      "text": "我親愛的妹妹——琳妮特此刻在做什麼呢？一定想我想得不得了吧！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·眼見為實",
      "text": "我希望觀眾們都相信「眼見為實」的道理，那我就能變出數不盡的戲法。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "哎呀，這種天氣，看來今晚沒辦法看到星星了。除非…我試著把星星變出來？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "真幸運，天晴了，該不會天上有誰在變魔術吧？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#哈啾…呼…我聽過一種說法，說打噴嚏是有人在想自己。琳妮特嗎？哦——還是{F#妳}{M#你}呢？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "呼，好險。要是帽子被風吹跑的話，裡面的道具就會嘩啦啦砸在我腦袋上了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "這風也太大了，我的紙牌都——等等，欸，別迷路啊！你的主人在這邊！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#…唔，再讓我睡一會…嗯？是{F#妳}{M#你}呀——嗯，我說怎麼今天的陽光那麼好，原來是{F#妳}{M#你}來了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#下午我需要檢查一下魔術用品，構思新的魔術創意。{F#妳}{M#你}要一起來嗎？來嘛，別推託啦！{F#妳}{M#你}可以試著餵餵我的動物助手們，我想{F#妳}{M#你}們一定合得來。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好。今晚有大魔術師的演出，{F#妳}{M#你}一定沒忘吧？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#晚安。要是睡不著的話，我有些催眠小道具可以用…啊，還是算了吧。睡吧，願美夢陪{F#妳}{M#你}到天亮。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於林尼自己·嘴甜",
      "text": "#對了，有件事情，我必須強調一下。我並不是對所有人都這樣說話的哦，主要還是因為對象是{F#妳}{M#你}。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於林尼自己·搭檔",
      "text": "#啊——琳妮特不在，我要進入待機模式了。雖然一個人也能處理好身邊的事，但還是會有些不習慣。{F#妳}{M#你}能理解的吧？畢竟{F#妳}{M#你}也…我是說，畢竟派蒙總陪著{F#妳}{M#你}。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·隱瞞",
      "text": "哇，好尖銳的話題…這麼說吧，甜美的漿果通常出沒於荊棘叢生之地，不然就會被饞嘴的狐狸一口吃完…這都是為了保護自己呀！好吧，我承認我確實不介意偶爾對別人撒點小謊，但我們之間最多只能算是有所隱瞞吧？不是嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·原則",
      "text": "#魔術師通常不會透露魔術的核心秘密…但如果{F#妳}{M#你}願意叫我「林尼老師」，成為我的學生，那麼「原則」就產生了變化。也不知道{F#妳}{M#你}的領悟力和耐心到底能有幾分呢？真讓人期待。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#魔術師佩戴著神之眼上臺，難免會遭到質疑，所以我習慣了提前摘下它。既然{F#妳}{M#你}有興趣，不然下次我表演的時候，就由{F#妳}{M#你}幫我保管它吧？要看緊一點哦，可千萬別讓它又偷偷滑到我手上了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "魔術不僅是一種表演形式，也是一種思維方式。世界上有很多看似平平無奇的東西，其中大有玄機。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "貓咪的耳朵能表達情緒。向後翻折表示恐懼或者警戒；向前豎起，偶爾朝外多半表明心情愉快；快速晃動則是在警覺地判斷四周情況…多觀察就有經驗了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於「父親」·家",
      "text": "「父親」給了我們一個家，教導我們成長，告訴我們每個人應該努力的方向。我能做的也很簡單——保持忠誠之心，以及…守護我們的家。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於「父親」·王",
      "text": "在這座只有孩子們構成的王國裡，「父親」是我們的王。我知道國王遲早會選繼承者，也知道那會是我…但同時，我對那樣的情況感到恐懼…請不要告訴任何人，尤其是妹妹和菲米尼。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於琳妮特·模式",
      "text": "#{F#妳}{M#你}覺得妹妹她話很少？知道了，那是運作模式不對。下次，先對她說「啟動，聊天模式」，運氣好的話，她會和{F#妳}{M#你}說上很長一段話。{F#妳}{M#你}問運氣不好要怎麼辦？別擔心呀，就算被她瞪幾眼，{F#妳}{M#你}也看到了和平時不一樣的琳妮特！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於琳妮特·雙子",
      "text": "#我和妹妹從小到大都在一起，艱難的時光只要有彼此就能度過，開心的時候也會和對方共享。家人就是我們最寶貴的歸宿。我們都能理解{F#妳}{M#你}與家人分別的痛苦…如果發現了任何線索，一定會告訴{F#妳}{M#你}的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於菲米尼…",
      "text": "#我這位天真的弟弟，至今還相信童話故事。真讓人有些羨慕。哦，這不是他自己告訴我的，是有次我不小心看到了他鎖在秘密抽屜裡的東西…真的是不小心哦！所以還請{F#妳}{M#你}不要告訴他，不然他一定會生我氣的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "那維萊特先生很少公開露面，似乎刻意和人們保持著距離。一開始我還以為是我的錯覺，但觀察最最敏銳的琳妮特也有同感，那看來確實是這樣了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "水神芙寧娜大人的行事作風不可捉摸，說得更露骨些，她平時說話也像是一種表演。楓丹人對精彩的舞臺演出情有獨鍾，因此崇敬她的人也有不少。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於千織…",
      "text": "#恭維話在她那裡是行不通的，只有真正懂得欣賞的人，才能讓她另眼相待。{F#妳}{M#你}問她怎麼看我？這問題可讓我有些傷心哦，我可是既懂欣賞，又對大家真心相待的人呀。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "#沒想到她在不認識我的情況下願意出手相助。要是沒有{F#妳}{M#你}們的話，我和琳妮特絕對無法脫身…總之，非常感謝{F#妳}{M#你}們。就請讓我等待一個陽光燦爛的日子，邀請大家去咖啡廳·露澤吃最美味的茶點吧。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "自從那次見面之後，夏洛蒂小姐多次邀請我接受專訪，呃…好像快有個二十次了吧。她對新聞有種與生俱來的敏銳，個性還異常執著。但說老實話，我可不想成為她筆下「爆炸性新聞」的主角，只好一次又一次用不同的理由婉拒了。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "作為決鬥代理人，克洛琳德小姐頗有名望。但我最近在報紙上看到，她似乎麻煩纏身…媒體非常喜歡挖掘她的故事，至於她本人…應該相當厭惡這種行為吧。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "#{F#妳}{M#你}聞過她設計的香水嗎？我還滿喜歡的，原本想買一瓶試試…但琳妮特的尾巴似乎有不同的意見。那我也只好算囉。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解林尼·其一",
      "text": "#看來我們彼此都對對方很感興趣呢，我的榮幸！哈哈，放心吧，只要看到{F#妳}{M#你}那令人著迷的眼睛，我就捨不得對{F#妳}{M#你}撒謊。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解林尼·其二",
      "text": "魔術表演當然沒辦法保證永遠不出現紕漏。對我而言，演出的重點也不是百分之百避免穿幫，而是時時刻刻保持鎮定，隨機應變。就算露出了小破綻，只要能讓觀眾相信那也是表演的一環，依舊能成為一場精彩難忘的演出。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解林尼·其三",
      "text": "沒有父母遮風擋雨，從小流落街頭的孤兒，總要經歷比常人更多的磨難。但正因為那些事情，才造就了如今的我和琳妮特。現在，我們都過得不錯…「家人」、觀眾…我的帽子裡裝著很多很多人的期待呢！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解林尼·其四",
      "text": "#哈哈，到現在還沒辦法完全相信我說的話嗎？看來{F#妳}{M#你}警覺心很強，這是好事，我就不用擔心{F#妳}{M#你}被別人騙了。另外嘛，{F#妳}{M#你}可要負起責任來，盯著我，謹慎挑選眨眼時機…不然的話，趁{F#妳}{M#你}不注意，我就去撒彌天大謊囉！到時候{F#妳}{M#你}也脫不開干係。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解林尼·其五",
      "text": "#「真實」的我，並沒有我所表現出的那麼外向、健談。更多時候，我是為了跟大家拉近關係，才使用了語言上的「魔術」…{F#妳}{M#你}會同情原本的我嗎？還是會覺得這種戲法…很愚蠢呢。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "林尼的愛好…",
      "text": "嘿，看這裡——可愛的小白兔，喜歡嗎？好奇牠是什麼時候來到這裡的嗎？那就對了！觀眾臉上驚喜的表情，正是每一位魔術師的最愛。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "林尼的煩惱·掩飾",
      "text": "#怎麼辦呢？我最大的煩惱就是——{F#妳}{M#你}在我這樣的大魔術師面前，還能想到煩心的事情。"
    },
    {
      "id": "6011",
      "type": 1,
      "title": "林尼的煩惱·鴿子",
      "text": "過去，我總是放養我的鴿子，牠們也總會飛回我的身邊。後來有一次，回家的鴿子少了幾隻，等我們循著痕跡找到的時候，牠們已經變成了鴿子派。至今我也不知道，我要怎樣同時帶給牠們「自由」和「安全」。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#看到這個魚缸了嗎？來，{F#妳}{M#你}可以把手伸進去感受一下，是不是真的只有水。確認好了嗎？那就開始囉！看這塊布，現在蓋上去了…嘿呀，魚變出來囉！怎麼樣？這精彩的表演，能換一道{F#妳}{M#你}親手製作的魚肉料理嗎？"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "出於表演需要，我和琳妮特得保持身形相似，我們會盡量不吃油炸食品。我倒是無所謂，妹妹就比較辛苦了——街頭的炸魚實在很香嘛！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#能吃到{F#妳}{M#你}親手製作的美味，真是榮幸之至。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}的廚藝不錯嘛，很好吃哦！多謝款待。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#想看魔術嗎？來吧，看我把布蓋在上面，{F#妳}{M#你}跟著我一起唸——三、二、一！食物消失了！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#這裡有一根羽毛，請伸出手來確認一下，它的確是一根普通的羽毛。好了嗎？啪嚓——其實是禮花哦，生日快樂！看到了嗎？禮花裡飄下的一片彩紙，被我抓住了。在我點燃它的同時，{F#妳}{M#你}就可以許願了，順帶想像一下{F#妳}{M#你}的生日禮物。三、二、一——嗯，很~好~我已經明白{F#妳}{M#你}的想法了。來吧，把手伸進我的帽子裡——如何？這份禮物是{F#妳}{M#你}想要的嗎？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#哎呀，我還以為{F#妳}{M#你}想讓我用這些素材變魔術呢。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#要是什麼變化都沒有，會不會讓{F#妳}{M#你}更加吃驚？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#{F#妳}{M#你}願意信任我，沒有比這個更令我開心的事情了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#為我付出這麼多，是想要偷走我的心嗎？那就讓我恭喜{F#妳}{M#你}、祝賀{F#妳}{M#你}吧！我親愛的學徒，或者說夥伴——{F#妳}{M#你}已經做到了。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "一點小把戲。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "看看這個吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "驚喜連連。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "壓軸表演！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "好戲開演！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "#響起{F#妳}{M#你}的掌聲！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "用這個道具，把它們全部變走…開玩笑的啦。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "裝進魔術口袋裡吧。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這也算是一種寶箱魔術嗎？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "這是要我表演詐死魔術嗎？"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不錯的戲法…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不會有事的。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "可別忘了還有我啊！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "節奏已經亂了哦？"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "琳妮特…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我的表演，不會失敗…！"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "幕布…快點拉上…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "沒事。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "冷靜…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "噢！「旅行魔術團」。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "樂意效勞。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#能被{F#妳}{M#你}邀請是我的榮幸。"
    }
  ]
}