  "skills": [
    {
      "_id": 10481,
      "id": "seal_of_approval",
      "name": "火漆製印",
      "description": "<span style=\"color:#FFD780FF\">普通攻擊</span><br/>連續發射火球，造成最多三段的<span style=\"color:#FF9999FF\">火元素傷害</span>。<br/>普通攻擊命中敵人時，會賦予煙緋一枚丹火印。初始最多持有三枚丹火印，每次觸發都會重置已有的丹火印持續時間。<br/>每枚丹火印都會降低煙緋的體力消耗，並會在煙緋退場時消失。<br/><br/><span style=\"color:#FFD780FF\">重擊</span><br/>消耗體力，短暫詠唱後，消耗所有的丹火印，在前方造成<span style=\"color:#FF9999FF\">火元素範圍傷害</span>。<br/>根據被消耗的丹火印數量，強化這次重擊的範圍與傷害。<br/><br/><span style=\"color:#FFD780FF\">下落攻擊</span><br/>凝聚火元素的力量，從空中下墜衝擊地面，攻擊下落路徑上的敵人，並在落地時造成<span style=\"color:#FF9999FF\">火元素範圍傷害</span>。",
