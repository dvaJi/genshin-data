  "outfits": [
    {
      "id": 204800,
      "name": "金科赤律",
      "description": "煙緋的裝扮款式。律法諮詢師煙緋出外勤時的裝束。",
      "isDefault": true,
      "characterName": "煙緋",
      "characterId": 10000048,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Feiyan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我叫煙緋，是璃月港最頂尖的律法專家，沒有之一！商業糾紛、民事調解、刑事訴訟，樣樣精通，一出手就搞得定！我的聯繫方式…要幫{F#妳}{M#你}記在哪裡好呢？唔…記在紙上容易丟，記在手上容易糊掉…哦！有了，就寫在{F#妳}{M#你}旁邊這個小傢伙的衣服上吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·律法",
      "text": "#律法既是約束，也是工具，請{F#妳}{M#你}千萬記住哦！記不住的話，我就多唸兩遍給{F#妳}{M#你}。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·工作",
      "text": "法理與人情有時衝突，有時相容。權衡二者，真是種學問呢。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·閱讀",
      "text": "唔唔，居然還有這種案件…天下之大，無奇不有啊。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "又下雨了！岩王爺行行好趕快出晴吧，一整牆法典可不能受潮。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "這…這是什麼倒楣天氣，有、有點冷哦…哈啾…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "趁著天氣好，背背律條。嗯？《璃月商典》第二十七章第六條第三款是什麼來著…我怎麼會忘記？不應當不應當…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上有個債務糾紛的案件要出外勤，中午前要給上週來諮詢的客戶答覆…好！工作工作！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#哈…有點睏呢…不如來場辯論，幫我提神醒腦！辯題的話，「北國銀行的開設對璃月經濟利大於弊還是弊大於利」。嗯，就這個，{F#妳}{M#你}先來挑正方反方吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#夜市？唔…本想留在家裡整理筆記，不過{F#妳}{M#你}想逛的話，我們就一起去吧。哦，我跟{F#妳}{M#你}說，有的店家因為要保證每天商品都是新鮮的，又不想白白虧損今天賣剩下的貨物，經常會在晚上推出促銷。\\n討價還價的事就交給我來吧，找零…就當作我的服務費啦。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#想要快速入睡？那我來跟{F#妳}{M#你}講解璃月律法的演變史吧，我的那些朋友就沒有能撐過二十分鐘的。唔，還想要更快的話，那就背法典吧，背法典！明天記得告訴我{F#妳}{M#你}聽到了第幾條。咳咳…我開始了哦？"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於煙緋自己·氣場",
      "text": "#讀卷宗時我的氣場很強？唔…原來{F#妳}{M#你}會這樣想。但那也只是我的工作狀態吧。就是說，在我的身上有一個隱形的按鈕，「噗」地撥過來，是平常模式；「咻」地撥過去，是工作模式。{F#妳}{M#你}身上難道就沒有這種開關嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於煙緋自己·弱項",
      "text": "我最怕遇到的就是民事糾紛啦，什麼婚姻破裂、撫養權訴訟…這類糾紛很難用理性或者邏輯去拆解。雖然說對當事人的態度要溫和有耐心，但有的當事人自己都已經沒辦法交流了…唉。雖然我標榜自己「樣樣精通」，但如果可以由我做主的話，我還是希望大家都能夠和和氣氣生活，少出現些這種案子啦。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·定價",
      "text": "#想請我做{F#妳}{M#你}的顧問？可以啊，解讀律法每條六千摩拉，隨行諮詢每個時辰十八萬摩拉，商業案件單件七十一萬摩拉起，後續具體報價和抽成視情況而定。怎麼樣，很實惠吧？"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·關係",
      "text": "#{F#妳}{M#你}四處遊歷，要是怕遇到麻煩處理起來棘手，最好的辦法就是跟知法懂法之人同行。而我煙緋擅長的，也不止璃月本國的律法。呃，雖然，楓丹那邊的還挺複雜…但靠我這個聰明的腦袋，要熟記也不是什麼難事！總…總之！我是絕對值得依靠的！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」應強烈的願望而生。作為一個有理想的人，我當然能得到它了。因為——我希望所有人都能老老實實，遵紀守法！但如果敢有亂來的傢伙，哼哼，那就統統給我接受律法的制裁去！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·秤",
      "text": "#這桿秤是老爹交給我的寶貝，能衡量出事物的「價值」。通常我會用摩拉當砝碼，不過，它只能稱量事物最初的價格。舉例來說，千年前，璃月遍地都是琉璃百合，這種花在當時並不值錢。後來它數量驟減，售價也水漲船高，這桿秤顯示的「價值」卻沒有更新，還是和之前一樣的「便宜」。\\n所以，在大部分情況下，這桿秤也不能作為我工作的幫助啦…怎麼了？{F#妳}{M#你}有什麼想要稱量的東西嗎？比如…稱量一下{F#妳}{M#你}身邊的那個小傢伙，怎麼樣？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什麼想要分享·法治",
      "text": "我自創的招式「食炎之罰」改編自古籍《璃月會典例律總輯要》中記載的「食岩之罰」。岩王爺是契約之神，契約也可視作約束，說明什麼呢？哼哼，說明璃月港自古就是契約之城。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "《璃月風物誌》寫到某種水生馬尾，稱它「獨坐荻花洲岸，色如霞，可入藥。」將其研磨成粉摻入墨汁之中，能使字跡不怕水浸。嗯…可惜啊，我去過荻花洲不下百次，常見的紫色馬尾一摘就是幾籮筐，卻始終找不到書裡記載的那種。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於七七…",
      "text": "聽說那個採藥姑娘為自己編寫了一整套行為準則。看她身材嬌小，辦事卻有條有理，實乃成大事之風範。\\n後生可畏、後生可畏呀。就連我也要說一聲佩服。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於甘雨…",
      "text": "甘雨前輩溫柔又貼心，可惜是個大忙人，大好的時光除了午睡，都在案卷堆裡埋頭苦幹。我雖然也有工作時間，但也是快快樂樂的。我選擇的工作，那可比她輕鬆多了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於行秋…",
      "text": "飛雲商會是我的老主顧了。他家行事一向慎重周全，與我的商談通常由大當家親自出面。不過，上一次卻碰巧見到了他家小少爺行秋。這位少爺年紀輕輕，沒想到居然跟得上我思考的速度。伶牙俐齒還分寸得當，嗯，真不簡單。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於胡桃…",
      "text": "常聽人說「往生堂」堂主行事奇特，大概是沾了喪葬業的怪毛病。這算什麼話？「往生堂」從事的可是正經行業，是構成商業的基本單位。而且工作就是工作，豈有高低貴賤、吉凶險惡之分？\\n不過，那位堂主倒是沒怎麼來光顧過我的生意，唔…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於鍾離…",
      "text": "#鍾離先生學識淵博，堪稱行走的書庫。{F#妳}{M#你}知道嗎？我一眼就看出他深藏不露。這樣的人大多不怕麻煩，就算遇上什麼事也不會請我幫忙，依我看，他絕不是潛在客戶。\\n但不知為何，他身上總有些不可思議的熟悉感，我說不上來。問過老爹，他也支支吾吾說什麼他也不明白，真是奇怪…總感覺，老爹有什麼事不想告訴我。哼，沒關係，大不了我自己找機會弄明白…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於凝光…",
      "text": "#{F#妳}{M#你}知道「天權星」凝光小姐吧？她主管律法，也經常修正法典，每次增補刪改的內容都多得要命。就在上次，全新的法典裡又增加了三條律法、修改了一百二十一條律法注釋，還新附了一堆典型判例，這次我又不知道要背到什麼時候了…\\n哼，不過她終歸是商界出身，論律法，我可不會輸給她，等我背完了這些，我一定要更加「努力」地工作…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於刻晴…",
      "text": "好在「玉衡星」不涉足專業律法領域。否則，依刻晴小姐的態度和效率，我大概要失去不少工作。哦…不，好像也不至於。畢竟刻晴小姐為人剛正，容易得罪人，由我來當助手輔佐的話…哦不不，也不對，為什麼我堂堂律法專家要當人助手？有事的話，應該是她來找我諮詢才對。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於優菈…",
      "text": "優菈曾經救過我一次，我們也從此有了書信往來。她牢記騎士團的各項條文，卻從不墨守成規。還總能找到巧妙的邏輯，靈活處理問題。大概因為我也是這樣的人，所以和她相處會特別輕鬆吧。不過，她那種灑脫的態度，我可就學不會啦。畢竟，我和她的職業可是完全不同呢。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於夜蘭…",
      "text": "夜蘭是總務司的雇員，幫我搞定過做假帳的麻煩事，我還請她吃了飯呢。不過…和她交談的時候，總覺得自己的心思會被輕易看穿…嗯，以後千萬不要站在她的對立面就好。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於久岐忍…",
      "text": "阿忍？我記得她，那個來璃月留學專修律法的稻妻人嘛。為了完成課業實習，她專門約我討論過案件，每次結束後又是鞠躬又是謝謝的，搞得我都有點不好意思了…當時就覺得，她將來一定會成為出色的律法專家。算起來，稻妻鎖國的時間正好是她畢業前後，不知道她回去後一切還順利嗎…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解煙緋·其一",
      "text": "#是客人嗎？幸會幸會，這是我的名片，今天我可能不方便出外勤，有糾紛的話麻煩把雙方都帶過來，還有諮詢費的收費標準我給{F#妳}{M#你}看一下，稍等一下…\\n欸？只是隨便聊聊天？嗯…那就不收錢了。居然會找關係普通的律法專家「隨便聊聊天」，真是個特別的人。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解煙緋·其二",
      "text": "頭上的鹿角？噢，這個啊，因為我的老爹是仙人，我有半仙之血嘛。不過，我是在璃月安定後出生的，沒跟帝君簽訂契約，自然不用履行任何仙家職責，可以盡情過自己想要的生活。我還挺滿意的，嘿嘿。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解煙緋·其三",
      "text": "那種維繫一生的嚴肅契約…我只和老爹訂過。唔…就是那種「要快樂生活」什麼的，他就是那種人啦。不過嘛，我還是挺為老爹的這份通透自豪的。要是他想跟我訂那種「要吃苦中苦，要做人上人」之類的契約，我肯定逃都要逃走了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解煙緋·其四",
      "text": "#有的時候，我處理的商業糾紛會以不太好看的形式收場。對方常常拿出數倍額度的賠償，或者付出更多的代價…但這都是這些人違背「契約」後應得的苦果。有人會傳流言說我很可怕、有人對我避之不及。雖然我沒有跟誰解釋過，但我最初的目的是為了璃月港的大環境著想！\\n{F#妳}{M#你}看，糾紛的起點是違背契約，但看到亂來的後果，他們還敢背信棄義嗎？讓大家意識到「契約」的重要性，也是我工作中的重要一環呢。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解煙緋·其五",
      "text": "#我常常覺得自己活得夠瀟灑輕鬆了。{F#妳}{M#你}看，我事業有成、衣食自由。走南闖北不成問題，論嘴上功夫也沒幾個人說得過我。但「快樂生活」這種東西嘛，也沒有哪條律法、哪條規範能夠定義。\\n就我個人來說，遇見有趣的人、有趣的事，心裡清楚該往何處邁出下一步，這樣就已經獲得快樂了。所以，{F#妳}{M#你}也是我的快樂源泉。\\n但話又說回來了！無論怎麼生活，最重要的還是要守法懂法。畢竟離開了律法，這個世界肯定馬上就會毀滅掉了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "煙緋的愛好…",
      "text": "#我的愛好是讀書和估價。讀書能長知識，估價則長眼力。所以什麼書都讀、什麼價都估。{F#妳}{M#你}要是不信，隨便找個東西給我，只要是市面有售的商品，我都能估個八九不離十哦。就說這塊石頭好了，錯不了，六百摩拉。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "煙緋的煩惱…",
      "text": "#和記廳的朋友們常約我一起釣魚，說是切磋釣技，但其實大家心裡多少都有些炫耀的成分。我有一百種方法贏過所有人，但他們長期關照我的生意，屢戰屢勝未免太不給面子。所以，每次我都靠著精妙的演技假裝墊底…等等，{F#妳}{M#你}那是什麼表情，在懷疑我嗎？！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#喔！說到這種話題，我就要好好向{F#妳}{M#你}推薦我的心頭摯愛了——豆腐，絕對是豆腐！豆腐本是清淡的食材，口感鮮嫩，溫潤滋補，搭配各色湯頭都能完美融入。最重要的是一年四季均有供應，隨時可以吃到！不求至尊，只求完美，豆腐菜就是我要的那種滋味。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不喜歡冷盤，可能是因為我很少吃冷盤吧。以前如果很晚回到家，老爹也會為我留盞燈，聽見我的動靜，還會問我肚子餓不餓。用他的話說，「菜嘛，總是熱的好。」"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#滋味不錯，看來{F#妳}{M#你}也挺懂「豆腐律法」的嘛。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "璃月俗話說「民以食為天」，還真是沒說錯啊。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "…有了！我把它熱一熱再吃吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂，這個匣子送{F#妳}{M#你}。裡面是我為{F#妳}{M#你}準備的各國律法資料，{F#妳}{M#你}不是要去四處旅行了嗎，提前瞭解一下別國的律法肯定有用。\\n不過也別學得太好哦，不然…我就沒機會幫{F#妳}{M#你}的忙了。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "「不期修古，不法常可」，這句話是我必須牢記的教誨。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "唯有遵循應守之「律」，人才能獲得解開一切問題的「法」。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "學習律法是為了跟別人有理有據地談話，習武防身則是為了應付無理無據的場合。欸，等等…我這能算習武嗎…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我現在應該算「文武雙全」了吧！多虧有{F#妳}{M#你}一路陪我走到修行之路的終點。報酬嘛…全天候專屬私人顧問？還不錯吧。喂…不准和我討價還價！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "嘣嘣——"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "焚燒吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "速速退下！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "律火，引！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "食炎之罰！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "丹書鐵契！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "這算是，「偶然所得」嗎？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "品相卓越！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嗯，讓我來估個價。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "得修正錯誤！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "你犯規…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "什麼，有紕漏？"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "喂——還是交給我吧！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "判斷是…「緊急避險」！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "判斷…失誤了嗎…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "律法…還有漏洞…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我不能…接受…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "麻煩了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "#這次就算{F#妳}{M#你}預約過了。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "出外勤要另外收費。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "放馬過來。"
    }
  ]
}