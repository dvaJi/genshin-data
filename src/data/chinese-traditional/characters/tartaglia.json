  "outfits": [
    {
      "id": 203300,
      "name": "榮光之刃",
      "description": "達達利亞的裝扮款式。標識著愚人眾第十一執行官「公子」身分的榮耀衣裝。",
      "isDefault": true,
      "characterName": "達達利亞",
      "characterId": 10000033,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Tartaglia_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是愚人眾執行官第十一席，「公子」達達利亞。而{F#妳}{M#你}——哈，也是能招致紛爭之人，實在愉快。我們應該會很合得來吧？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·閒散",
      "text": "在這乾站著，也不會有對手找上門的。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·比試",
      "text": "嗯——附近就沒有什麼值得一戰的強敵嗎？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·愚人眾",
      "text": "不知道其他執行官在忙些什麼呢？嗯，算了，無非又是那些莫名其妙的「宏大計畫」吧。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "閒聊·雪國故土",
      "text": "在我老家的雪原裡這麼閒站著的話，早該被凍僵了。哈哈哈。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨過天晴…",
      "text": "雨點打在水面上的聲音，會把魚兒嚇跑。相比之下，雨後是釣魚的好時機。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候·異國",
      "text": "哈哈哈，不知老家那邊，是否也在下雪？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候·至冬國",
      "text": "多好的雪！天地都和月光一樣乾淨，在這樣的舞臺上潑灑的鮮血才格外炙烈。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "啊！風中傳來了紛爭的氣息。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了·異國",
      "text": "真是暢快的風！"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "颳大風了·至冬國",
      "text": "感覺身體和頭腦，都被穿過身體的風洗淨了。真舒暢。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "喲，夥伴！今天精神不錯啊。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#{F#妳}{M#你}看起來狀態還不錯嘛，要不陪我切磋一下？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "哈——吃得真爽。活動活動，消化一下好了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "真是愉快的一天。明天再見，夥伴！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於達達利亞自己…",
      "text": "身為戰士，要時刻把挑戰之心繫於刀尖之上。但無論勝敗，都是無可替代的珍貴經歷。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·同僚",
      "text": "#與{F#妳}{M#你}同行的事情，在別的執行官當中，已經傳開了吧。哼，真想看看那幫人臉上的表情，哈哈哈。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·兵器",
      "text": "弓，其實是我最不擅長的武器。正因如此，我才要征服它。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·生存",
      "text": "#連神之眼也沒有的{F#妳}{M#你}，竟有這樣的力量，真是令人期待啊…在{F#妳}{M#你}抵達自己的極限之前，與我放下一切、決一死戰之前，絕對不要倒下啊，夥伴！我絕不允許{F#妳}{M#你}倒下。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·邀請",
      "text": "#夥伴，要不要加入愚人眾？嗯，當我沒說。以{F#妳}{M#你}現在的身分，和{F#妳}{M#你}在一起，連光明正大和其他執行官廝殺的理由也有了。這樣的機會，實在無法放棄啊，哈。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "只要能讓我變強，「神之眼」也好，「邪眼」也好，師承深淵的罪人也好，都無所謂…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "在無盡的雪原裡，生命隨時都會被碎骨一般的純白天地吞噬，連足跡也無法留下。為此，我們每日都在與看不見的敵人戰鬥。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#我曾經在世界的深淵與無名的巨大魔獸對視。總有一天，我會堂堂正正地，將那強大得令我骨髓凍結的怪物斬殺。屆時，就拜託{F#妳}{M#你}當我的見證者了，夥伴！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於絲柯克…",
      "text": "有多少年沒見到師父了呢。哼，下次和她比試的時候，希望至少能逼她用上雙手來對付我。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於鍾離·掂量",
      "text": "那傢伙城府很深，不知真正的實力又如何呢…哼，真令人期待。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於鍾離·挑戰",
      "text": "#鍾離先生，最近可好啊？嗯…還不錯？看來他倒是挺適應作為「凡人」的生活嘛。可惡…竟然把我騙得團團轉，只有痛痛快快地交戰一場才能平息這份不甘！\\n{F#妳}{M#你}說…我打不過他？哈哈哈…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於「女皇」…",
      "text": "#女皇大人其實很溫柔。但正是因為太溫柔了，所以才不得不變得冷酷。正是因為夢想和平，才要向整個世界宣戰。也正是因為她與世界為敵，我才有機會與{F#妳}{M#你}相識。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "法爾伽嗎？哼，光是想到，有朝一日能和西風騎士團的頂點、傳說中的「北風騎士」交手，就興奮得顫抖。活在這個世界上，真是美妙。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於「丑角」…",
      "text": "他是愚人眾最初的執行官，也是今日執行官們的領袖，只會在大場面出現。至於他的功績…坦白說，我不關心。我效忠的對象是女皇大人。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「隊長」…",
      "text": "我曾見過他在戰場上的模樣，實在是過於強悍了。或許我的席位太靠後了吧，讓他沒有留意到我。但就算今天被他忽視，明天，我也會讓他看到我的實力。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於「博士」…",
      "text": "聽說他把不同年齡段的自己切片做成了義體，負責不同的任務。沒辦法，我的同僚都是些不太正常的人。反過來想想，要是某一天，我遇見了自己的義體…哈，肯定得和對方決出真正能活下去的那一個。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於「少女」…",
      "text": "#愚人眾執行官的席位是按照實力劃分的，我不明白那個女孩為什麼是「第三席」。有機會的話，我是想和排在我之前的執行官都比試一遍啦，但總有種不太想和她交手的感覺…不管怎麼說，{F#妳}{M#你}也小心一點。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於「僕人」…",
      "text": "我不討厭有自己打算的人。畢竟我加入愚人眾，也是為了獲得更多爭鬥的機會。但這個人，我不喜歡。如果背叛能夠獲得收益，她會毫不留情地向女皇大人揮劍。她的眼裡只有瘋狂。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於「公雞」…",
      "text": "我不懂什麼人情世故。但我知道，他是真心想要幫助我的。他看我的眼神，就像看待家人一樣。哦，說到這個，冬妮婭和托克回信給我的時候，時常提到他送去家裡的餡餅和禮物。在我暫別冬都期間，他確實按照約定，照顧好了我的家人們。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於「木偶」…",
      "text": "好像是個埋頭研究的人？我想想，那些機械是不是都跟她有關啊。總之，僅有幾次的見面中，她一副想殺了我的眼神。可我完全不記得做過什麼惹她生氣的事。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於「富人」…",
      "text": "哦，那個滿腦子「宏大計畫」的野心家。他的那些理論，我半句都聽不進去啊。總之，只要儲備資金夠用就好啦。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於「女士」…",
      "text": "#我和她合不來，{F#妳}{M#你}是知道的。如今也不必評價她本人了吧。對於執行官而言，死期並不掌握在自己手上…不過，放心，我是無論如何，都會拼盡全力活下去的。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於「散兵」…",
      "text": "#他帶著「神之心」與我們失去了聯絡，後來才有了追回那顆心的行動。我倒是不介意去四處走走，說不定還能在哪裡和{F#妳}{M#你}偶遇？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解達達利亞·其一",
      "text": "記住了，夥伴，我是終有一天要征服世界的人！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解達達利亞·其二",
      "text": "無論決鬥的對手是神，還是深淵的魔獸，只要有形，就有得勝的可能。但執行官當中，有的人熱衷於權術、陰謀那些…「看不見的手段」。我跟那些無聊的傢伙合不來。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解達達利亞·其三",
      "text": "這裡的天空和故鄉的天空是連成一片的。抬頭看見雪一樣的月光，就能想到，老家的人們也能看見同一個月亮。不知道弟弟妹妹…哈，他們有沒有變成出色的戰士呢？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解達達利亞·其四",
      "text": "夥伴，不要忘記：廝殺的時候，絕不能用什麼「燃燒起來了」之類的蠢話來驅策自己。畢竟，燃盡之後，除了灰燼，什麼也不會剩下。無論如何，都要活下去。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解達達利亞·其五",
      "text": "#時間過得真快。總有一天，我要讓{F#妳}{M#你}親眼看見我征服世界的樣子、我把神的王座踩在腳下的樣子。哈哈，在那之前，{F#妳}{M#你}可絕對不要倒下啊，夥伴！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "達達利亞的愛好…",
      "text": "冰釣和決鬥的道理是相通的，關鍵是耐心與決斷。這麼說來，同樣的道理好像也能應用在人生中的所有事情上？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "達達利亞的煩惱…",
      "text": "#嗯？煩惱的事情…哼，與{F#妳}{M#你}同行，總是有值得挑戰的強敵，根本沒空思考這種瑣碎無趣的小事。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "這個世界上，充滿了美妙的料理和酣暢淋漓的戰鬥。活著真是美妙！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#食物和武器是一樣的。真正的戰士不會挑剔兵器，也不會挑剔食物。{F#妳}{M#你}也不要挑食啊。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#只要吃到好吃的，心情就會十分舒暢。我該如何回報{F#妳}{M#你}呢？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}的廚藝似乎長進了不少。難道{F#妳}{M#你}也在不斷變強嗎？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "真是出乎意料的口感，好…我就再試一次吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "喲，夥伴，生日快樂！有什麼想痛打一頓的人嗎？有的話，就儘管說出來吧！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "喔！好像變強了一些。找誰試試好了…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "「戰士的力量就像一個圓。圓越大，能挑戰的人就越多。」欸，這句話是誰說的來著…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#真不錯！夥伴，多虧了{F#妳}{M#你}，我離「征服世界」的目標又近了一步。就連女皇大人，也不曾料想過我這樣的成長吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#夥伴，{F#妳}{M#你}也要好好鍛煉自己才行！不然的話，等我到達了世界的頂點，又有誰能與我殊死廝殺呢？哈哈哈。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "要上了！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "哈！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "勢如狂瀾！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "來吧！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "接下來——"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "呼——"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "一箭止水！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "逃得掉嗎！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "破綻，稍縱即逝！"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆發·其四",
      "text": "忍著點，這可是很痛的。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "兵貴神速。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "呵，感覺不錯。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "好！再去尋找更多的寶藏吧！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "相當不錯！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "真讓人摩拳擦掌！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "哈！有點意思。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不賴嘛！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "生死邊緣而已，我很擅長處理。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你們，最近是不是缺乏鍛煉啊？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "閃開！這裡讓我來！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "怎能這樣…得而復失…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "失手了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "還挺…有兩下子…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "嘁！大意了。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "哈，強敵何在？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "睜大眼睛看著吧！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "真讓我好等！"
    }
  ]
}