  "passives": [
    {
      "id": "rite_of_springs_procession",
      "name": "儀典·春之行列",
      "description": "薇斯納施放特殊元素戰技<color=#FFD780FF><b>翔風劍</b></color>或元素爆發<color=#FFD780FF><b>致禮·獻予女皇陛下</b></color>後，還會獲得一層<span style=\"color:#FFD780FF\">「整肅」</span>，持續20秒，至多疊加6層，每層獨立計算持續時間。<br/>擁有<span style=\"color:#FFD780FF\">整肅</span>時，薇斯納召喚的<color=#FFD780FF><b>靈劍</b></color>將會造成原本100%+整肅層數x10%的傷害。施放元素戰技<span style=\"color:#FFD780FF\">操典·制勝有道</span>或退場時，清除薇斯納擁有的<span style=\"color:#FFD780FF\">整肅</span>。",
      "level": 1
    },
    {
      "id": "truth_prevails",
      "name": "理典·冬之凱風",
      "description": "<span style=\"color:#FFD780FF\">輝映·星擴散</span>：依據隊伍中角色的元素類型，薇斯納將獲得對應效果。目前隊伍中：<br/>·每有一位元素類型為<span style=\"color:#99FFFFFF\">冰元素</span>或<span style=\"color:#80FFD7FF\">風元素</span>的角色：薇斯納的攻擊力提升6%。<br/>·每有一位不為上述元素類型的角色：薇斯納的元素精通提升25點。",
      "level": 4
    },
    {
      "id": "stellar_jubilee_splendid_prelude",
      "name": "星耀祝禮·散華序飾",
      "description": "隊伍中的角色觸發冰元素擴散反應時，將轉為觸發星擴散反應，且基於薇斯納的攻擊力，提升隊伍中角色造成的星擴散反應的基礎傷害：每100點攻擊力都將提升0.7%星擴散反應的基礎傷害，至多依此方式提升14%傷害。<br/>隊伍中的角色在附近觸發星擴散反應後的8秒內，薇斯納將會進入<span style=\"color:#FFD780FF\">輝映·星擴散</span>狀態。",
      "level": 0
    },
    {
      "id": "the_grand_circuit",
      "name": "寶魄巡行",
      "description": "不處於戰鬥狀態下時，薇斯納可以透過長按衝刺或跳躍進入<span style=\"color:#FFD780FF\">「巡遊」</span>狀態。<br/><br/><span style=\"color:#FFD780FF\">巡遊</span><br/>持續消耗體力，維持懸浮狀態。進行衝刺或點按跳躍抬升高度時，將額外消耗體力。包括長按跳躍進入<span style=\"color:#FFD780FF\">巡遊</span>狀態在內，每次<span style=\"color:#FFD780FF\">巡遊</span>至多抬升三次高度。<br/><br/>此外，在至冬地區（挪德卡萊除外），不處於戰鬥狀態下時，隊伍中的目前場上角色位於空中時，切換薇斯納登場時，薇斯納將直接進入<span style=\"color:#FFD780FF\">巡遊</span>狀態，並恢復50點體力。該效果每10秒至多觸發一次，且該效果在秘境、征討領域、深境螺旋中無效。",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1431,
      "id": "winters_farewell_feast",
      "name": "送冬的華宴",
      "description": "<color=#FFD780FF><b>巡風列裝</b></color>模式下，薇斯納至多可以施放四次最高境界的<color=#FFD780FF><b>翔風劍</b></color>，而非三次，且每次進入<span style=\"color:#FFD780FF\">巡風列裝</span>模式後，首次施放最高境界的<span style=\"color:#FFD780FF\">翔風劍</span>不消耗<color=#FFD780FF><b>「劍氣」</b></color>。<br/>此外，薇斯納在<span style=\"color:#FFD780FF\">巡風列裝</span>模式下造成的星擴散反應傷害提升20%。",
      "level": 1
    },
    {
      "_id": 1432,
      "id": "kolo_of_springs_arrival",
      "name": "迎春的輪舞",
      "description": "突破天賦<color=#FFD780FF><b>「儀典·春之行列」</b></color>獲得強化：薇斯納進入<color=#FFD780FF><b>巡風列裝</b></color>模式時，會獲得最大層數的<span style=\"color:#FFD780FF\">整肅</span>。擁有最大層數的<span style=\"color:#FFD780FF\">整肅</span>時，薇斯納的攻擊力提升40%。<br/>上述效果需要解鎖突破天賦「儀典·春之行列」。",
      "level": 2
    },
    {
      "_id": 1433,
      "id": "winters_last_offering",
      "name": "燔燎的獻禮",
      "description": "元素戰技<color=#FFD780FF><b>操典·制勝有道</b></color>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 3
    },
    {
      "_id": 1434,
      "id": "glory_to_our_forebears",
      "name": "先代的榮膺",
      "description": "突破天賦<color=#FFD780FF><b>「理典·冬之凱風」</b></color>獲得強化：攻擊力提升與元素精通提升的效果改為原本的三倍。",
      "level": 4
    },
    {
      "_id": 1435,
      "id": "the_nobleborns_charge",
      "name": "貴種的職守",
      "description": "元素爆發<color=#FFD780FF><b>致禮·獻予女皇陛下</b></color>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 5
    },
    {
      "_id": 1436,
      "id": "unwavering_ardor",
      "name": "不移的赤忱",
      "description": "施放最高境界<color=#FFD780FF><b>翔風劍</b></color>後的5秒內，薇斯納可以點按普通攻擊或元素戰技，施放風仙一族秘傳的<span style=\"color:#FFD780FF\">翔風劍·變移</span>：造成薇斯納150%攻擊力的<span style=\"color:#80FFD7FF\">風元素傷害</span>，並召喚出<color=#FFD780FF><b>靈劍</b></color>，額外造成薇斯納200%攻擊力的<span style=\"color:#80FFD7FF\">風元素傷害</span>。若薇斯納處於<color=#FFD780FF><b>巡風列裝</b></color>模式，還會額外喚出風翎協同攻擊敵人。<br/>此外，薇斯納造成的星擴散反應傷害<b><span style=\"color:#FFD780FF\">擢升</span></b>20%。",
      "level": 6
    }
