  "outfits": [
    {
      "id": 214300,
      "name": "春結冬契",
      "description": "薇斯納的裝扮款式。由薇斯納親自在冬契軍制服的基礎款式上稍作修改後製成，但好看歸好看，昂貴也是真昂貴，所以薇斯納的冬契軍整體換裝申請到現在都還沒有通過。",
      "isDefault": true,
      "characterName": "薇斯納",
      "characterId": 10000143,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Vesna_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好啊，親愛的朋友。冬契軍司令薇斯納，向{F#妳}{M#你}致意。禮炮和儀隊都已經就位了，隨時可以為{F#妳}{M#你}奏響。當然，如果{F#妳}{M#你}不習慣張揚，我也準備了更私人的歡迎儀式，快快跟上~"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·效勞",
      "text": "#冬契軍只聽命於女皇陛下，當然不能隨隨便便就為{F#妳}{M#你}效勞了。但，風仙薇斯納可以哦，親愛的朋友。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·快樂",
      "text": "這身儀裝好看吧？陛下親賜的，多看幾眼也無妨。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·高效",
      "text": "案牘工作？早就做完啦，花不了多久。接下來都算巡視時間，走~"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "妖精當然也會著涼，淋濕了要趕快搧乾，我指翅膀。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "白茫茫的雪地裡，任何一點偽裝的瑕疵都會變得極為致命。走路當心點哦，親愛的朋友。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "我知道我知道，陽光下我的翅膀最是閃亮。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "不錯，是風仙喜歡的天氣。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "隨口一問…我們什麼時候回至冬？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#新的一天！向{F#妳}{M#你}問候，至冬堡！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "走吧，去老庭院餐廳！當然依舊是我請客囉。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "科洛列夫茨基劇團有新的演出。除了沃雅妮莎首席的高音、奧黛塔小姐的舞步…還有一些「新的朋友」。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "嘶嘶…這就要睡了嗎？要出去散步嗎？有極光欸！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於薇斯納自己·「魔法武器」",
      "text": "#看到我身邊飛來飛去的「小傢伙」了嗎？是我造的「魔法武器」，每一把都是用元素力和我自己的意識糅合出來的，多多少少帶了點我的脾氣哦。所以它們有可能會纏著{F#妳}{M#你}邀玩，請不要介意。當然，可以的話也請不要拒絕啦，呵呵！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於薇斯納自己·司令官",
      "text": "司令官的「架子」…噗。這種東西是替鎮不住場子的人準備的，我不需要~這點我們是一樣的哦。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·求證",
      "text": "#我懂我懂，{F#妳}{M#你}一定有許多關於我的傳聞想求證。沒關係，我們有的是時間。不過作為交換，關於{F#妳}{M#你}的一切，我也會一點一點地「求證」清楚哦。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·同行",
      "text": "#我不習慣「陪誰走一段路」這種說法。聽起來是很浪漫，可是仔細一想…「陪」這個字，把一個人放在了主角的位置，另一個人則成了陪襯。\\n但腳是自己邁的啊，沿途的經歷和收穫，也從來都是自己的。所以啊，我不會說「陪{F#妳}{M#你}」，而是很高興「與{F#妳}{M#你}同行」。這種感覺就像走著走著，一轉頭卻發現…哈哈好巧哦，居然剛好順路！"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「星之楔」…",
      "text": "「星之楔」的樣式非常漂亮，很有收藏價值。說到這個，「月之輪」也很不錯，我一直滿心動的。至於「神之眼」…暫不考慮呢。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "我手上這個「老夥計」？漂亮吧！是家族傳下來的哦，它的年紀比我大得多得多了，說是殿堂級的古董也不為過。它有時被我當成魔法杖，有時是教杖，有時是指揮棒…哎呀，比起將它鎖進銀行的保險櫃裡吃灰塵，我讓它在這把年紀還能發揮餘熱，先祖們想必誇我還來不及呢。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#霜仙花美麗又頑強，在嚴寒的地方都能存活下來。花紋也很特別，我喜歡半瞇著眼，晃著腦袋看它，眼裡的景象就會像萬花筒一樣，非常夢幻。但{F#妳}{M#你}最好等沒人在旁時再試。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於「女皇」陛下·忠誠",
      "text": "我抓過太多自以為是、想要跟陛下唱反調的傢伙了。他們嘴裡的宏圖霸業，全是不堪一擊的花拳繡腿。既沒有舉事的謀略，也沒有成事的能力。跟那些所謂的野心家相比…不，我收回這些話。他們不配跟陛下相提並論。\\n簡而言之，效忠陛下，既是風仙一族的職責，更是我薇斯納個人的選擇哦。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於「女皇」陛下·慈愛",
      "text": "「慈愛」這個詞在陛下口中總是帶著冰刺的。她說那是天理強加給神明的詛咒，不是真正的愛。可是我偏偏不這麼想哦。討伐魔獸歸來，陛下會在手諭末尾加上一句「好好休息」。生之執政的能力被回收後，她也照顧到了我明明藏得很好的失落，把沒被回收的部分送回到我這裡…\\n但這些以陛下的身分，她本可以不必做的。這麼說可能有些僭越——我始終認為，一個神明到底有沒有「愛」，應該由子民說了算！所以我說的也算？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於達妮卡·小時候",
      "text": "我們親愛的達妮卡小姐，別看她現在嚴肅又深沉，小時候，她可是跟我一起策劃過「掀開老師面罩」這種事的搗蛋鬼哦——我們還成功爬到了老師肩膀上呢！雖然最後沒得逞，反被罰在冰湖上站了很久軍姿…哦不，這點糗事不是重點！重點是，這個鬼點子明明是她先提出來的，要說貪玩，她一點都不輸我。現在好了，整天對我擺出一副大人看小孩般無言的表情。拜託哦，我才是姐姐。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於達妮卡・吵架",
      "text": "據可靠線報稱，有嫌疑人藉著舉辦「吵架大賽」這種莫名其妙的活動為噱頭，趁人群起鬨之際完成不法交易…我必須管管了。\\n所以，我已經替達妮卡報名了，她很擅長「冷面拆臺、專戳弱點」，誰吵得過她啊？一定能幫我拖延很多時間吧。\\n加油啊，達妮卡！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於「隊長」…",
      "text": "印象裡他的背影總是那麼寬厚又可靠，像一座沉穩的大山。我從未想過有一天大山也會倒下，至少…沒想過會這麼快…什麼「真正的戰場不存在告別的機會」，那也用不著親身向我證明吧…連最後的機會…都沒有留給我。\\n太壞了，我的老師。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於「丑角」…",
      "text": "這個世界上，有些人腳步輕盈，他們大多期盼著走向明天。而他，始終走得很沉重。我時常覺得他和老師很相似，大概是因為他們都把難以想像的悲傷藏在面具底下，把沉痛的過去全都背在身上了吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「公雞」…",
      "text": "市長先生在皇都評議會上侃侃發言，游刃有餘的樣子，顯得他非常偉岸。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於「富人」…",
      "text": "#冬契軍司令的薪水不算低，可是要用來隨心所欲購買收藏品和請客吃飯還是會有些吃緊…哦哦，我不是那個意思，聽我說完嘛。從懂事起，家族的「閒錢」就經由北國銀行打理，託潘塔羅涅先生的福，收益滾動到現在已經非常可觀了。所以我完全沒有什麼負擔啦，{F#妳}{M#你}不用客氣，下次還是讓我來請客！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於「木偶」…",
      "text": "桑多涅的舉止完全符合淑女的標準，言語卻又帶有極強的「攻擊性」，同時邏輯經得起推敲，無可挑剔…太有趣了，嘻嘻，我要好好學一學。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於米提亞…",
      "text": "米提亞是我固定的遊戲玩伴，他總能想辦法從軍械宮溜出來，我們三個每次都玩得很盡興！哪來的三個？我、米提亞，還有他那條聰明的圍巾。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於沃雅妮莎…",
      "text": "沃雅妮莎小姐的每一首歌都很好聽，我非常享受在現場聽歌的感覺。跟臺下的大多數觀眾一樣，我也會隨著她的歌聲時而歡笑時而流淚。有時候演唱結束後，大家還會自發留在現場大合唱。巧的是，我手上正好有一根指揮棒呢。更巧的是，有好幾次我都發現了悄悄混入人群的沃雅妮莎小姐，她換下演出服戴上了帽子，在為大家和聲呢。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於奧黛塔…",
      "text": "其實每一次奧黛塔小姐來參與朝會，我都會忍不住多瞄她幾眼。畢竟，她除了是愚人眾的一員，另有個「特殊」的身分，讓人很難不在意…我指的當然是科洛列夫茨基劇團的首席芭蕾舞者啊，不然呢？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於阿羅夏…",
      "text": "我明白的，哪隻小狗能拒絕在「呼嘯」的狂風裡，去追逐一隻漂亮的蝴蝶呢？嗚…我把達妮卡的早餐偷出來給圖加林吃吧，再請阿羅夏幫我美言幾句，拜託牠不要一見面就追著我跑啦…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解薇斯納·其一",
      "text": "嘻嘻，想透過什麼方式瞭解我？不會真的只是聊天吧？那多無聊…不玩點「真假話大冒險」之類的遊戲嗎？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解薇斯納·其二",
      "text": "冬契軍是直屬於女皇陛下的親衛部隊。職責嘛，不僅僅是討伐魔獸、參與戰事這類軍務哦。舉凡一切關乎女皇陛下權威與榮譽之事，冬契軍皆須無條件聽候陛下差遣，為陛下掃清前路上的一切障礙。\\n不過，在對抗天理的偉業塵埃落定前，陛下難免分身乏術。所以其他諸如開幕剪綵、參加晚宴這種好事…咳咳，這類瑣事，我非常樂意效勞。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解薇斯納·其三",
      "text": "我的收藏品有許多，珠寶啦、古籍啦、油畫啦…任何能讓我開心的物品都值得被我收藏。而且我必須第一時間拿下，一秒鐘都不想等！不是有那樣一句話嗎——「湯匙在午餐時才珍貴。」錯過了那一瞬間的心動，往後再得到，味道也就淡了大半啦。所以當下想要，當下就要得到。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解薇斯納·其四",
      "text": "#莫諾馬赫皇帝犧牲後，至冬曾經經歷過一段動盪時期，我的先祖在那時便堅定站在女皇陛下這邊，我們的榮耀從未曾折翼——那麼，站在他們肩膀上的我，究竟有沒有青出於藍的實力呢？哼哼，我已經把{F#妳}{M#你}心中的疑問說出來了。是啊，有沒有呢？現在輪到{F#妳}{M#你}把我心中的答案說出來了，請~"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解薇斯納·其五",
      "text": "對抗死之執政的前夕，我提取了許多人的「生之印」，大家對於美好回憶的定義各不相同：有人珍視的，是與家人圍坐在壁爐邊，有一搭沒一搭地閒聊。有人念念不忘的，是獨自坐在火車窗邊，看極光在夜空裡靜靜流淌。還有人，只是拉著雪橇去冰釣，便覺得滿足…\\n那些回憶，就像一個個五彩斑斕的泡泡，附帶著滾燙又鮮活的「生命力」，讓人想要不自覺地感嘆——啊，活著真好！\\n可是所謂天上的存在，卻能輕而易舉地將這些泡泡碾碎，連一句解釋都吝於給予。憑什麼啊？\\n從那一刻起，對我而言，對抗天理，便不再僅僅是為了輔助陛下。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "薇斯納的愛好…",
      "text": "很小的時候，家中就為我安排了繪畫、舞蹈和聲樂老師，稍微長大一些了，我就開始練習擊劍和馬術等等…近期嘛，我迷上了聽歌劇、看演出，還有一點小小的收藏…總之我的生活裡沒有「無聊」兩個字。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "薇斯納的煩惱…",
      "text": "#別聽達妮卡胡說，我的開車技術真的不差——那叫人車合一。等我的開車禁令解除後，就載{F#妳}{M#你}去兜風吧！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#天氣這麼冷，沒有什麼比圍在一起喝點燉湯更讓人愜意的了！這樣好了，我來組局，{F#妳}{M#你}跟派蒙隨便拿點食材來就好啦~"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "嘿嘿！煩人的蔬菜統統挑到達妮卡的盤子裡嚕！嗚——又被夾回來了…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "那麼，我不客氣啦，把美味統統收藏進肚子裡。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "嗯嗯…烹飪的巧思嗎…嗯嗯…我再吃一口。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "我吃飽啦謝謝！這些我打包給達妮卡吃~"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#當當當當，時間到！{F#妳}{M#你}知道我昨天憋得有多辛苦嗎？提前說出那句祝福可是會被暴風雪吞沒的！現在終於可以說了——生日快樂！親愛的朋友。願{F#妳}{M#你}像白樺樹一樣強壯，永遠不被風雪打敗。\\n好啦，按照習俗，接下來我要輕輕捏幾下壽星的耳朵囉——"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "新兵訓練第一課：風雪壓不彎的脊背，才有資格護衛在陛下左右。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "新兵訓練第二課：握劍的手不許抖。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "新兵訓練第三課：敵人面前不許哭。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#而我親愛的朋友，{F#妳}{M#你}教給了我另一課：留一絲柔軟，去擁抱風雪後，值得拔劍守護的人。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "列隊。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "敬禮。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "舉劍。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "讓一讓~"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "還沒結束哦。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "向您致意。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "#陪{F#妳}{M#你}們玩玩吧！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "瞄準——逃不掉囉！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "獻予女皇陛下——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "齁齁，新藏品入庫！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#{F#妳}{M#你}一件，我一件，陛下一件，我一件，分完了！達妮卡沒有，哈哈。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這裡這裡，看這裡！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "司令官當然要留守在戰場上。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "放心，我能躲開哦。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "咳…暫時的劣勢…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "撤退，由冬契軍接管。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "別逞強，親愛的朋友。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
