  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我明白了，外派工作的「契約」已經擬好了，請過目，即日起就可以為{F#妳}{M#你}…欸！名字沒有簽嗎？請讓我看一下。唔…名字是甘，甘雨…呼，補上了。話，話說回來，工作具體而言是哪些呢？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·鬆弛",
      "text": "安逸的氛圍…喜歡。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·聆聽",
      "text": "趴在草地上，能聽見大地的心跳。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·焦慮",
      "text": "工作…工作還沒有做完…真的可以提前休息嗎？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候·擔憂",
      "text": "飛雲商會種植的霓裳花需要充足的雨露，唔…和記交通的夥計們卻不喜歡雨後泥濘的山路…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雨的時候·聽雨",
      "text": "在庭院裡聽雨的感覺很好，但是，太奢侈了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雨過天晴…",
      "text": "嗯？天晴了嗎？是什麼時候…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "嗯，空氣很適宜。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起風的時候…",
      "text": "啊，琉璃百合的味道，真好啊…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安…唔？是哪裡沒有梳理好嗎，請不要盯著我的…盯著我的頭飾看。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "啊…需要午覺。如果沒有什麼特別的事情…我就先行告退了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#萬家燈火就在眼前，人們的生活究竟是什麼樣的呢…欸？{F#妳}{M#你}想邀我去夜市？啊…不，不好意思，我就不去了吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#願帝君保佑{F#妳}{M#你}，願{F#妳}{M#你}的每個夢都踏實而香甜。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於甘雨自己…",
      "text": "我的工作，就是遵循與帝君的「契約」，為璃月的多數生命，謀求最大的福祉。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·工作",
      "text": "今天的工作已經提前完成了。加…加班？我理解了，我會好好完成的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·請求",
      "text": "我想瞭解更多有關人類的故事…尤其，想知道你對他們的看法和評價。因為，那個，你跟提瓦特大陸上的普通人不太一樣吧。而我也…請務必，和我交流。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·評價",
      "text": "#嗯…我，我一直想知道{F#妳}{M#你}對我工作的評價。是…普通寶箱的等級還是華麗寶箱的等級。沒，沒關係的。我的心理…能承受得住。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「一千種權力伴隨著一千種責任。」那位擁有著博覽古今的視野，卻被迫放棄了自己生活的帝君，才是整個璃月最辛苦的人吧。相比起來，只擁有著普通「神之眼」，只需要去行使普通責任的我，已經輕鬆得多了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "「萬商雲來、千船繼至、百貨迭出、諸海曆覽。」人們用這樣的話來稱讚璃月。但成就這樣的壯景，依靠的也是細小到每一個人的努力。我是懷著要對得起這份繁榮的心情工作的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·名字",
      "text": "生活在璃月的每一隻小狗，我都為它們取了名字。不過，有的狗狗如果用別的名字叫它也會有反應。真是了不起呢。如果有誰突然叫我「苦雪」什麼的，我一定回應不過來。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞·清心",
      "text": "#清心的花瓣，很好吃…應該說特別好吃。就是因為太好吃了，所以我才不敢在玉京臺種它。生怕哪天一個不小心就會忍不住…嗯？{F#妳}{M#你}說…特別苦？可是…這不就是它的味道嗎？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於摩拉克斯·信任",
      "text": "我對帝君有著絕對的信任。當年，正是有帝君率領，我們才能擊退魔物、降伏海獸，保住了這一方平安。帝君守護眾人的身姿，千年以來的情誼，我不會忘記。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於摩拉克斯·追隨",
      "text": "帝君的決斷，總是能夠為璃月的多數生命帶來福祉。我很敬佩這一點，也很想像他一樣…但有時，越想著要去追趕帝君的腳步，就越容易緊張得出錯…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於凝光…",
      "text": "歷任「天權」都會對璃月的古老律法進行釋義和補充。在這之中，當代「天權」凝光的處理效率是無人能及的。只不過，她那追求效率和效益的作風常常遭人指摘。挑刺，總是比包容簡單得多吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於刻晴·隔閡",
      "text": "我無法認同她對帝君的態度。但是…但是…「甘雨，這才是璃月現今需要的人。」帝君反而這樣說。我還是太愚鈍了，要理解帝君話語中的意思，還得更努力地接觸更多事務才行吧。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於刻晴·改觀",
      "text": "最近她主動與我討論起修復碧水商路的方案，還問我，是帝君的話會怎麼做。我們商量出來的舉措固然不比帝君，不過…看到她反復推演著沙盤的樣子，隱約能夠理解她的心情了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於行秋…",
      "text": "飛雲商會那位青衣少年，並不像他的父親和兄長那般操心織物的經營。是因為對他來說，有更重要的事情值得去做吧。當然…這也只是我的猜測…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於香菱…",
      "text": "香菱很有名！但…我不太敢去「萬民堂」那一帶…不敢就是…不敢啦。好，好吧，也不是秘密。那邊的飯菜香味飄得滿街都是。一旦被勾住了，點上了菜，就算是素菜也…很難控制住食欲吧。這樣的話，這樣的話…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於北斗…",
      "text": "近來，玉京臺之上對南十字船隊的怨言不斷。可是在我看來，北斗船長對璃月所做的貢獻，遠非沉溺於偽造流言之徒所能想像…啊，抱歉，失言了…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於瑤瑤…",
      "text": "瑤瑤啊…我是受總務司那邊的熟人託付，在城內好生照顧她，別讓她再往船上跑…你問我總務司的業務範圍？唔…不，不知道呢。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於魈…",
      "text": "他一直與人保持距離，應該說是性格使然吧…我能夠理解他，但是我無法「接近」他。畢竟…與他履行同一份「契約」的同伴，都已經不在了啊…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於煙緋…",
      "text": "煙緋呀…她還是個懵懂的小女孩時，就和我說過，要遵守契約，過上快樂的生活。如今她亭亭玉立，成了璃月的名人。\\n律法諮詢師的工作很繁雜，但她總是一副無憂無慮的模樣，這讓我十分安心。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於申鶴…",
      "text": "我和她並不能算是熟悉。只是聽留雲真君提過幾句，聽說她個性較兇，要是壓抑不住心性，容易對周圍造成嚴重破壞。嗯…會不會是因為平日裡太閒了呢？我…我該推薦一些工作給她嗎？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於夜蘭…",
      "text": "雖說夜蘭小姐每年有將近七成時間缺勤，但凝光會給她這樣的特權，想必事出有因。當然，這不該是由我打聽的事項，具體內容就不清楚了。不過，有天我回月海亭的路上，看到她和許多人有說有笑地吃著早點、喝著茶。我的內心深處…竟然有些羡慕。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於閒雲…",
      "text": "留雲真君…啊，我是說，閒雲小姐，她不久前約我一同逛街，卻在每個攤位前都停下腳步，一定要把每件商品細細看過一遍才離開。等我們記起要吃飯時，已經夕陽西下了。這讓我想起了從前在山中修行的日子，光陰也如同現在一樣，轉瞬即逝…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解甘雨·其一",
      "text": "#臨時的工作嗎？啊，不用和我具體說。將{F#妳}{M#你}的要求寫下來，放在這邊就好。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解甘雨·其二",
      "text": "「想要瞭解更多甘雨的事情」…這，這是什麼工作要求啊。我，我還從來沒有處理過這樣的…去年年底述職報告的背誦可以嗎？啊，不行啊。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解甘雨·其三",
      "text": "#我思考過了…既然是「工作」，處理「工作」就沒有害羞的必要。如果{F#妳}{M#你}想要瞭解我的話，這個頭上的…髮飾。其實是我的角。我的身上，有著仙獸「麒麟」的血脈。唔…理解了的話，請簽下這份保密協議，不要對別人講…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解甘雨·其四",
      "text": "雖然身為仙獸的混血後裔，但同時也有著人類的血脈。這麼多年來，我也不知道自己算不算融入了璃月港的人類生活…可能，我只是像鑽進地裡的草史萊姆一樣，把自己埋在數據和報表中間來逃避吧。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解甘雨·其五",
      "text": "#謝謝{F#妳}{M#你}一直陪我說話。遇見{F#妳}{M#你}之後，好像說了十幾年都沒有說過的那麼多話…如果保持這樣的鍛煉，有朝一日也能從事秘書以外的職業了吧。用上幾百年時間來熟練，應該就不會犯什麼要緊的錯了吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "甘雨的愛好…",
      "text": "愛好嗎，愛好的話…工作吧。嗯？工作不能算？但是，為什麼呢？難道愛好不是指自己想要去做，做了就會感到開心的事情嗎。那麼愛好是工作，又有什麼問題呢？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "甘雨的煩惱…",
      "text": "為何人們總是拚命證明…自己的存在比其他人更有價值呢？存在本身，就是足夠美好的事情了吧？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "「飲必甘露，食必嘉禾。」這是我的守則。所以，請把那盤「仙跳牆」，從我的視線範圍裡拿開…"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我們一族是嚴格的素食主義者，肉類料理就請容我謝絕了。嗯，沒錯，即使是葷油混在蔬菜丸子裡也不行…不可以。不可以喲。我能夠聞出來的。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "道地的美味佳餚…啊！我是不是已經吃多了？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#我在飲食方面還挺挑剔的，讓{F#妳}{M#你}費心了…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#我明白{F#妳}{M#你}的好意，但油葷…還是算了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。這麼久以來受{F#妳}{M#你}的關照，但卻沒有準備禮物，這點實在…藏在手後面的？欸，{F#妳}{M#你}看到了啊…是，失敗了的清心花涼糕…抱著必須做到完美的決心，結果卻…欸，好，好吃？真…真的嗎。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "力量？…真是久違了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "如果…可以用和平的方式解決。不，沒什麼…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "這就是新的生活之道吧…我明白了，我不會抱怨的。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我曾經看到古書上說，「麟鬥則日無光」。其實沒有那麼誇張。但是，如果需要戰鬥，如果需要為{F#妳}{M#你}而戰，我會獻出自己的全部力量。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "禁止接觸。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "閒人勿擾。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "霜寒化生。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "風雪的縮影。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "如琉璃般飄落。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "這項工作，該劃掉了。"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆發·其四",
      "text": "為了岩王帝君！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "下一項工作是…"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "我會跟上的…"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "衝刺結束·其一",
      "text": "運動，是必要的…"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "有所收穫，就是一件好事。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "瑰麗的珍寶，令人欣喜。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "留下寶箱的人，也遵循著某種「契約」嗎？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "…是我久疏戰場。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "欸？好像弄砸了？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "需要…補充能量。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "請您退後！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "呃…「不可貿然進攻」！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "帝君…對不起…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "「契約」…尚未完成…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我得…再撐一會…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "疏忽了…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "沒有關係…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "工作時間到了嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "請向我下達指令。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#謹遵{F#妳}{M#你}我「契約」。"
    }
  ]
}