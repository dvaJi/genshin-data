  "outfits": [
    {
      "id": 205500,
      "name": "百狩之義鎧",
      "description": "五郎的裝扮款式。為使神射將軍五郎御弓靈便而打造的輕鎧，肩頭與肘部護有甲片，便於控弦。",
      "isDefault": true,
      "characterName": "五郎",
      "characterId": 10000055,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Gorou_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#海祇島反抗軍大將，五郎，前來助陣！早就聽說過{F#妳}{M#你}的威名了，我將與{F#妳}{M#你}齊驅並進，一同攻奪勝利！哈哈，怎麼樣，我剛剛這句話的氣勢，還不錯吧？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·軍略",
      "text": "枕戈坐甲，才能應對變數。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·訓練",
      "text": "難得沒有戰事，來場體能訓練吧！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·體格",
      "text": "魁梧的體格是力量的象徵，對鼓舞士氣也很有幫助。我得再加把勁啊！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "尾巴濕了…找堆篝火烤一烤吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "有敵情嗎！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "好冷…這種天氣不適合露天活動啊…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "曬太陽雖好，士氣卻不能鬆懈啊。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "順風進攻，我方占優。逆風作戰，也不必畏懼！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "晨練時間到了，要和我一起去登山嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午飯就吃鮮魚燉蘿蔔和白米飯吧。這種搭配在反抗軍中很流行，推薦{F#妳}{M#你}也試一試。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上也不能怠懈，要讓眼睛充分適應黑暗。畢竟，黑燈瞎火的地方，也有可能變成戰場。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#累了嗎？那就安心休息吧。待在這裡放哨的任務就交給我了！保證{F#妳}{M#你}回來的時候，一切都跟現在一模一樣。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於五郎自己·大哥",
      "text": "#「五郎大哥」？{F#妳}{M#你}是從哪裡聽到的啊！唉…實不相瞞。平時，我和將士們的交流都很密切，有什麼好東西也都大家一起分享。他們敬重我，私底下就大哥大哥地叫了起來。可實際上，他們的年紀都比我大啊…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於五郎自己·建議",
      "text": "大概因為我總是打勝仗吧，總感覺將士們把我想像成了特別厲害的人，哪怕是小事也會來問我的建議。他們的眼神讓我沒法拒絕，但我的計策也有限…只能講些大道理，或是憑直覺給出答案了。唉，會不會對不起他們呢…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·傾訴",
      "text": "#有什麼煩惱，千萬不要埋在心裡，來和我說說吧。雖然我不是什麼事情都在行，但我一定會盡力為{F#妳}{M#你}出謀劃策的。就算…就算答案不夠可靠，至少我也是{F#妳}{M#你}忠實的聽眾。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·同食同寢",
      "text": "一起訓練，一起吃飯，一起休息…方便隨時交流，還能增進我們之間的默契。到了關鍵時刻，一個眼神就能傳遞重要的訊息…欸？這樣不合適嗎？唔…我和其他兄弟都是這樣熟悉起來的啊。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」為我的戰鬥提供了許多幫助，讓我能在戰場上承擔更多責任，為戰友們開闢道路。但我也明白，個人的力量再強，都沒法左右戰爭的勝負。大家齊心協力才是關鍵。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·輕裝上陣",
      "text": "輕裝上陣正是我的風格。我擅長靈活遊走，尋找戰機。我的箭矢會優先對準敵方最強的將士，挫傷對方的銳氣。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什麼想要分享·常勝將軍",
      "text": "#將士們給我取了個綽號，叫「常勝的尖耳將軍」，還有些奇怪的傳聞，說是「摸到五郎大哥的耳朵，就能獲得常勝將軍的好運」。唔…摸是絕對不行的！他們笑得再開心也不行！欸？{F#妳}{M#你}也想摸？喂，喂…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "聽說璃月有著高聳入雲的群山，真想親眼去看看，再盡情攀登一番。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於北斗…",
      "text": "北斗船長重視情義、身手不凡，令人尊敬。她曾說不願把同伴捲入紛爭，我們也理解這一點。因此，只有到了必要的時候，才會請她來幫忙。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於楓原萬葉…",
      "text": "我見過形形色色的浮浪人，萬葉絕對是他們之中最特殊的一位。他就像一縷風，不會在任何地方停留，但總能給身邊人帶來些什麼。和他並肩戰鬥期間，我就從他身上學會了幾分「灑脫」。總之，我和萬葉相當合拍！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於珊瑚宮心海·職責",
      "text": "珊瑚宮大人作為海祇島最高領袖，負責掌控大局，制定計畫。我負責將細節落實，把控前線的形勢。反抗軍上下一心，只求勝利。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於珊瑚宮心海·態度",
      "text": "我對珊瑚宮大人抱有崇高的敬意。珊瑚宮大人神機妙算，沒有她的謀略和統籌，反抗軍不可能取得如今的戰果。只不過，私底下她似乎更偏好安靜的生活。沒有軍事要務的話，我不會主動打攪她。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "雷電將軍…不論理由如何，我無法認同她以前的做法。現在，海祇島與幕府簽訂了和平條約，但我絕不會放鬆警惕。假如衝突再次爆發，我必定會重返前線。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "我對幕府軍沒有好感，但九條裟羅，也許是幕府軍裡最正直的一位將領了。我們之間進行過數次較量，各有勝負。我曾不成熟地想過，要是這樣的人能夠重視民眾的願望，不受幕府掌控就好了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於八重神子…",
      "text": "#那個女人…我們可以不聊她嗎？我來幫{F#妳}{M#你}幹活，什麼雜活都沒有問題…嗚…就當是為了我的身心健康著想，我們還是換個話題吧？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "社奉行從屬於幕府，但立場更傾向於民眾。在這種兩面為難的處境下，「白鷺公主」還能站穩腳跟，應該是特別冷靜，又能把握做事分寸的人吧。這一點值得我學習。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於早柚…",
      "text": "#我軍情報顯示，那位忍者精通潛入之法，也許她的忍術能夠在珊瑚宮大人的某些奇策中發揮作用…不過，情報裡又說很難掌握她的行蹤，看來不好招募啊…欸？{F#妳}{M#你}說她是社奉行的人？…呃，那還是算了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於鹿野院平藏…",
      "text": "#{F#妳}{M#你}說那個鬼鬼祟祟，遊手好閒的偵探先生？畢竟是來自幕府的傢伙，沒辦法完全信任，我會繼續盯緊他的。說起來，他倒是有那麼點探案的功夫。至於這是不是什麼陰謀詭計…嗯，就得用時間來證明了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解五郎·其一",
      "text": "#畢竟我大多時間都在戰場上，我的故事，可能不算很有趣…但如果{F#妳}{M#你}想聽的話，我就慢慢和{F#妳}{M#你}說，想到什麼說什麼。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解五郎·其二",
      "text": "我沒有令人敬畏的智謀，只有一雙手和一條命。也許我的手足夠有力，命足夠硬吧，這麼多年來，經歷了不知多少場惡戰，都成功活了下來。有人說，只要跟著我，不管遇上多絕望的戰局，都能平安無事。就這樣，不知不覺，我得到了大家的認可，成為了將領。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解五郎·其三",
      "text": "最初，我們的敵人是流寇、海賊和魔物，但後來，雷電將軍頒佈了「眼狩令」。氣焰囂張的幕府軍來到了我們的面前，被我們迎頭痛擊。哈哈，大概他們也沒想到，會遭受如此激烈的抵抗吧。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解五郎·其四",
      "text": "#珊瑚宮大人曾經說過，我有個致命的弱點，戰鬥的時候太過忘我，只顧著深入敵陣。她說勇猛是好事，但對於統率一軍的將領而言，這樣並不稱職。我…努力在改進這一點！{F#妳}{M#你}…能夠在我身邊，監督我嗎？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解五郎·其五",
      "text": "#我需要抗爭到底的對象，並非特定的團體或陣營，而是一種「惡意」。這種「惡意」曾踐踏大家的願望，破壞大家平靜的生活，肆意傷害大家…徹底消除它們後，我就能安心放下武器了。等那時候，我就換上便服，和{F#妳}{M#你}在海祇島上隨意地散步吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "五郎的愛好…",
      "text": "我喜歡登山，越險峻的山越好。登山能錘煉我的肉體和精神，讓我變得更強壯。還有，和同伴一起登山。在揮灑汗水後共同欣賞山間的美景，也是人生一大樂趣。不過，我不敢…不想攀爬稻妻的最高峰…"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "五郎的煩惱…",
      "text": "輕裝上陣也有不方便的時候，比如，一旦遇上火攻，我的尾巴就要格外小心。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我喜歡蛋糕和三彩糰子！嗯…大概是因為我很少吃到這類精緻的點心吧。軍營裡的飯菜強調簡便快捷，通常也不會用到太多調味料，至於糖，就更是珍貴物資了。甜味…我無法拒絕！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "大部分食物我都不忌口，可洋蔥是個例外。有一次，後勤兵往飯菜裡加了洋蔥末，讓我在飯桌上痛哭流涕…啊，那次實在太丟人了！弄得後勤兵也很過意不去。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "這種甜味，完全無法抵抗！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "喔！心中氣勢大增！有什麼需要我幫忙的嗎！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "比想像中的還要辛辣…嗚，我…我有些力不從心了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天是{F#妳}{M#你}的生日，是意義重大的一天，請允許我來為{F#妳}{M#你}慶祝吧。我們在海邊生一堆篝火，抓來最新鮮的魚和螃蟹，我想給{F#妳}{M#你}親手做一頓大將級別的「士氣晚餐」！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "強大的力量，是為了保護同伴。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "要保護同伴，不能只是被動防守，必須積極進攻。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "攻奪勝利的要領，是牢記戰鬥的意義，遵循正確的戰法，拿出銳不可當的氣勢。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#有了銳不可當的氣勢，與戰友們緊密配合，方可無往不勝。謝謝{F#妳}{M#你}的指點！這是屬於{F#妳}{M#你}我二人共同的勝利。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "進軍！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "強攻！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "結陣！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "隨我出征！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "勢如破竹！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "兵貴先聲！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "今日運勢不錯！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "和同伴們一起分享收穫吧！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這個寶箱…埋伏了我？"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "隨我來。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我還能戰鬥！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "大意了！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "沒到認輸的時候！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "按甲休兵！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "不要亂了陣腳！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "兵敗了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "海祇島的…大家…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "全軍…撤退…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "不痛不癢！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "再來！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "整裝待發！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "準備進軍！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "行兵列陣！"
    }
  ]
}