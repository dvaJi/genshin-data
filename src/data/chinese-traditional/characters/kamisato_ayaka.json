  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "稻妻神里流太刀術皆傳——神里綾華，參上！\\n請多指教哦。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·安定",
      "text": "像這樣悠閒安穩的時光，如果再多一點就好了…我真貪心啊。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·劍",
      "text": "劍，就和茶一樣，細細品味才能理解其中風雅。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·出神",
      "text": "#這就是旅行者平日裡的生活嗎，呵，感覺又多瞭解了{F#妳}{M#你}一些。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "閒聊·名刀",
      "text": "刀劍抱業，名工懷寶。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "請隨我一同避雨吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "大御所大人…是在訴說什麼嗎？"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "下雪的時候…",
      "text": "「雪霽銀妝素，桔高映瓊枝。」嗯…美景當前，只差一壺茶與之相襯呢。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "風和日麗，要去哪邊走走嗎？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "閉上眼睛，向著風吹來的方向…怎麼樣，很舒服吧？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安，旅行者。能像這樣在清晨見{F#妳}{M#你}一面，我會忍不住覺得…接下來將是順利的一天。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午安。茶飯之後，難免略有睏倦。是否有興致下盤棋提神呢？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好。夜風舒暢，會是一個良宵呢。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "「若知是夢何須醒，不比真如一相會。」"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於綾華自己·社奉行",
      "text": "「稻妻幕府社奉行神里家」，位於稻妻名門中的筆頭之格位。作為三奉行之一，掌管祭祀活動與人文藝術。自從雙親過世之後，族內的大小事務，便由兄長和我承擔了。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於綾華自己·地位",
      "text": "很多人因為我是「白鷺公主」，是社奉行神里家的大小姐而敬重我。他們所敬重的，只是我所身處的地位，與綾華我是怎樣的人並無關係…\\n所以我想，能真正走近我的，或許只有…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於綾華自己·願望",
      "text": "#如今的我，依舊想成為值得大家信任的人。不過，鼓舞我的原因，已不再是肩上的責任或他人的期待。而是因為，{F#妳}{M#你}也是這樣的人啊。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·茶室",
      "text": "#如{F#妳}{M#你}有空，我們移步木漏茶室如何？在這樣恬靜的日子，略加交流茶藝心得，想來是頗具雅趣的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·節日",
      "text": "#如果有機會的話，我想試著和{F#妳}{M#你}共度異國的節日。需要遵循的當地風俗、禮儀規則，還有伴手禮的推薦，可以麻煩{F#妳}{M#你}…一一指導我嗎？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」，即是胸懷大志之人所獲的印綬。如果問我有什麼志向的話…這個還是保密吧，只是一個微不足道的夢想罷了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "試問，常說「禪茶一味」，又說「劍禪一如」，那麼劍和茶，又是什麼關係呢？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}在城中，見過枯萎的櫻花樹嗎？這種「枯」之美，讓我想到春天盛開之景。不過別人似乎並不這麼想，不再開花的櫻樹會被移走…就算一次也好，真想看到它再次開放。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於托馬…",
      "text": "托馬是我很重要的朋友，他的開朗和陽光總是感染著我。某種意義上來說，他就像是我的另一個兄長一樣，已經成為了「神里家」的一員。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "為「天領奉行」工作的九條裟羅…她總是一臉嚴肅。我和她曾經起過幾次爭端，不過她本質是忠義之士，這點無可否認。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於鹿野院平藏…",
      "text": "鹿野院先生？他和九條小姐一樣，是「天領奉行」的人。他…也是一個很有原則的人。對於這些「原則」的堅持，甚至比九條小姐更執著。只不過，什麼事應該被算在這些「原則」之內，我想，或許只有鹿野院先生自己知道吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於早柚…",
      "text": "#早柚這孩子，最近有沒有給{F#妳}{M#你}添什麼麻煩呢？如果看見她偷懶，可以直接告訴我。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於雷電將軍·猜測",
      "text": "對大御所大人的看法嗎？這並不該由我等下屬隨意議論。但…將軍大人她，在追求「永恆」之路上，可能也很孤獨吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於雷電將軍·立場",
      "text": "#見證了「無想的一刀」並且活了下來，該說是堪稱偉業的經歷了吧。雖然對我來說，她是真正的神明，一念之間可以更改稻妻的命運，但如果是和{F#妳}{M#你}起了衝突的話…我一定會站在{F#妳}{M#你}這一邊的。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於八重神子…",
      "text": "#我和八重宮司大人的合作向來很愉快。{F#妳}{M#你}看，操辦節慶慶典非常勞神費力，營收多半也不好看。但是八重宮司大人操辦的產業，真的既風雅又有收成。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於神里綾人…",
      "text": "#作為神里家的家主，兄長平日需要出面諸多場合。我雖盡力分擔兄長肩上所負擔的責任，卻也無法緩和他常年積壓在身的疲倦。唉，就當是為了妹妹著想，希望{F#妳}{M#你}能勸言，讓兄長多多注意身體啊。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於宵宮…",
      "text": "操辦節慶慶典是社奉行和巫女眾的責任，那位煙火專家也的確能讓氣氛熱烈起來，彼此合作多了，因而漸漸熟絡。\\n嗯？治安和消防問題嗎？我們也會一併納入預先規劃的。因為這些原因而看不到煙花，才會讓人們心中留下缺憾吧。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解綾華·其一",
      "text": "#{F#妳}{M#你}的請求，對我來說很特別呢。既然把{F#妳}{M#你}當做朋友，我也應坦誠以待。不過，事關神里家的秘密，還希望{F#妳}{M#你}能守口如瓶。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解綾華·其二",
      "text": "曾經，神里家因為沒能保護好國寶級別的刀工，遭受了不小的衝擊。受愚人眾陰謀算計，我們折損了諸多臣下，受到許多責罰。父親甚至因之早衰，神里家在幕府中的地位也一落千丈…好在兄長繼任後力挽狂瀾。不過，家門雖已復興，社奉行一系也上下齊心，但大事要事方面，仍靠兄長定奪。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解綾華·其三",
      "text": "將軍所傳的鍛刀之術，也因星象、用途、礦質、爐火環境、人之性格、元素變化的不同，而有所區分。即是刀工之間所說的「雷電五傳」。能鍛造名刀的刀工，也被算作是本領通神的神事相關人員，歸屬統籌文化、藝術、祭祀的社奉行一派管理。因此，出現了刀工背叛的事情，自然就是神里家的督辦不力了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解綾華·其四",
      "text": "對我來說，母親是意義非凡的存在。端莊、優雅，無論遇到怎樣的局面都會露出沉靜的笑容，以從容不迫的態度，操持著神里家大大小小的事務，說母親是完美的化身也不為過。但自從她離世的那一刻起，我就深切地意識到，我已經不是那個可以躲在母親身後的小綾華了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解綾華·其五",
      "text": "#接下來要說的話，可能不太符合「稻妻幕府社奉行神里家」的身分。不過，就我的判斷，{F#妳}{M#你}應該能容許我小小的任性吧？\\n…稍微有點累了…可以讓我靠一下{F#妳}{M#你}的肩膀嗎？一下就好。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "綾華的愛好…",
      "text": "#風雅之物我都很喜歡：雅樂詩詞、棋藝與舞蹈。{F#妳}{M#你}也感興趣嗎？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "綾華的煩惱·憂慮",
      "text": "煩惱嗎？啊，是啊。只要生活在這個世界上，就難免遇到種種不如意的事情。但如果是因為自己的事情，就讓周遭的人擔心的話…果然，我還是不能說…"
    },
    {
      "id": "6006",
      "type": 1,
      "title": "綾華的煩惱·心意",
      "text": "#「坦率」，真的是一件很難的事情。我必須不斷告誡自己是神里家的大小姐，在無數雙眼睛，無數人的期盼之下擺出完美無缺的姿態。這樣的我，是否也該追求自己的願望呢，是否也該…讓{F#妳}{M#你}理解我的心意呢…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#我對異國料理很有興趣，雖然很少有嘗試的機會。嗯…如果是要侷限 在稻妻料理內的話…應該是「茶泡飯」吧。不過，不能給一般客人看見，我也是偷偷告訴{F#妳}{M#你}的。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "雖然不是不能吃，但我對動物脂肪或內臟大概會有點…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "嗯…我真是太幸福了…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#謝謝{F#妳}{M#你}讓我有機會嘗試這道菜，我會把它的味道記在心裡的。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "啊…稍微有點油膩了呢。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#請隨我來！只要走一小段路，不會耽擱{F#妳}{M#你}太長時間的哦。\\n打聽到{F#妳}{M#你}的生日之後，我就提前了一段時間開始籌備。比起名貴的禮物，我妄自猜測…或許這樣的禮物會更合我們的情誼。此次，就請讓我以扇舞為禮吧。\\n那麼，失禮了。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#非常感謝。與{F#妳}{M#你}切磋使我受益良多，相信在劍術上也能更進一步。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#多虧{F#妳}{M#你}的點撥。有{F#妳}{M#你}相助，我對自己的能力也理解得更透徹了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "感覺更加游刃有餘了。處理社奉行事務之餘，甚至有空嘗試一些新的事情。要來試試最近學做的點心嗎？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#「嘗有所思，斯世如磐；孰料浮世事，留駐難。」\\n…抱歉，明明是值得高興的時候，我卻想起了那麼悲傷的詩歌。和{F#妳}{M#你}相處的時間過於暢懷，竟然讓我害怕再次失去。真是…失態了呀。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "起舞吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "失禮了。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "雪紛飛。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "…拿下了！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "櫻吹雪。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "神里流…霜滅！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "尋珍覓奇…也算得一種雅趣。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "呵呵…今日運勢不錯。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "我會珍惜這一份幸運。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不容小覷呢。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "久違的對手…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "該決斷了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不可大意。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "閣下務必小心。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "失態了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我還有…未竟之事…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "讓家族…蒙羞了…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "無禮的傢伙…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "怎麼會…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "神里綾華，參上。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "煩請賜教。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "呵呵，請多關照。"
    }
  ]
}