  "outfits": [
    {
      "id": 206500,
      "name": "荒瀧鬼副手",
      "description": "久岐忍的裝扮款式。標誌性的鬼面鎧象徵著荒瀧派中最為威嚴的那位「鬼副手」。",
      "isDefault": true,
      "characterName": "久岐忍",
      "characterId": 10000065,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shinobu_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，我是荒瀧派的二把手久岐忍。我們承包多種業務，貨運物流、安保維持、房屋補漏、表演駐唱等等。需要我們請隨時聯繫，這是我的名片，還請收下。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·麻煩事",
      "text": "有麻煩事要處理的話，直接告訴我就好，我來擺平。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·證書",
      "text": "執業證書考試都有固定評判標準，肯學肯練就能考過，沒什麼難的。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·荒瀧派",
      "text": "要是荒瀧派犯了事，我會揪他們去認錯的。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "不用打傘了，腿腳快點就行。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "當心點。這種天氣，應該沒人會想引雷上身吧？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "快點把事情辦完就撤吧，別浪費時間。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "嗯，天氣真好，但總有種不祥的預感…希望是我多慮了吧。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "唔…這風還算不錯。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早啊，看{F#妳}{M#你}的樣子是準備去鍛煉了？沒想到{F#妳}{M#你}還挺勤快的。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#想吃什麼？最近存了不少錢，午飯我請{F#妳}{M#你}。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "有些委託，在夜晚才好辦。我不放心交給他們，都是我親自上。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "該休息的時候就去休息吧，不用管我。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於久岐忍自己·二把手",
      "text": "招攬業務、維繫成員安定是我的職責，除此之外還有——去奉行所撈人、歸還零食和玩具、抓捕接了活卻在暗處偷懶的成員…不過，這些額外工作屬於荒瀧派特色，其他任何組織的二把手，理論上都不需要做這些。當然，也做不到像我這樣。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於久岐忍自己·退路",
      "text": "#{F#妳}{M#你}說幫派解散？首先，那種事應該不會發生。其次，就算發生了，我有什麼好擔心的呢？餓肚子的人不可能是我。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·筆記",
      "text": "#要是{F#妳}{M#你}心血來潮想考什麼證，不如直接找我吧，我把筆記借{F#妳}{M#你}。備註和要點很詳細，不愁{F#妳}{M#你}學不會。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·善後",
      "text": "#不管{F#妳}{M#你}是不是荒瀧派的人，我都不會把{F#妳}{M#你}當外人。{F#妳}{M#你}就往前走吧，幕後的工作交給我。放心，這方面我是專業的，多複雜的事都能辦妥。嗯？擔心我的安危？呵，這方面{F#妳}{M#你}也放心吧，這些年的摸爬滾打，不是白經歷的。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "和證書一樣，這是對我能力的肯定和證明。但不同的是，我至今不知道它的考核標準。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·面鎧",
      "text": "戴上面鎧是不想被熟人認出來。尤其和荒瀧派一起出任務時，要是熟人看見了，指指點點，那群傢伙肯定會趁機起哄。嘖，光是想想，就很煩。不能再有下次了…咳，沒什麼。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·派中法度",
      "text": "#我制定了荒瀧派的「派中法度」，他們就應該謹遵法度行事。嗯？{F#妳}{M#你}問他們為什麼願意聽話？因為我比他們更有說服力。我的語言和拳頭，姑且還算是有點分量。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#神社中流傳著一種說法，將鳴草織成一個圈纏在身上，就能祛災祈福，{F#妳}{M#你}信嗎？我倒覺得，鳴草，還是麻痹效果更實用。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "解除鎖國後，雷電將軍陸續頒佈了不少法令支持各行各業的發展。我在鎖國期間考的證書全都派上了用場，荒瀧派也不那麼拮据了。禍福相依，沒想到到頭來還得感謝她。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "#九條小姐啊，她是我的朋友。嗯？我認識她讓{F#妳}{M#你}覺得很意外嗎？噢，{F#妳}{M#你}可能誤會了，我加入荒瀧派之前就跟她有交情。我們之間的切磋，還難分勝負呢。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於八重神子…",
      "text": "就連堂堂鳴神大社的宮司大人，都要靠副業來解悶，可見當巫女是有多無聊。我是絕對不會回去當巫女的。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "#老大有很多不算愉快的過去，卻還能保持快樂陽光，挺難得的。他對我們很不錯，他的純粹也感染著荒瀧派的大家。當然，這不能成為他橫衝直撞影響別人的藉口。如果他找{F#妳}{M#你}麻煩，儘管告訴我。我會好好收拾他，讓他後悔對{F#妳}{M#你}無禮。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於煙緋…",
      "text": "那時候跟家裡鬧翻了，只想著有多遠逃多遠，就跑去璃月學律法了。多虧如此，有幸認識了煙緋師姐。在律法諮詢這塊，她簡直就是活字典。我？執業證書倒是有的，不過這個職業的約束也不少，並不是最適合我的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於鹿野院平藏…",
      "text": "他和普通天領奉行同心不一樣，從未見他做什麼巡邏、抓捕的活。他偶爾會找我買線索，作為交換，我希望他能在我去奉行所撈人時幫我美言幾句，他也爽快答應了。這筆交易還算值，畢竟讓弟兄們收集點市井見聞是很簡單的事。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解久岐忍·其一",
      "text": "我做過很多不同的工作，相關的執業證書也有不少。管理方面，帶過小型團隊，負責人員統籌和資源調配…呃，抱歉，面試多了就說習慣了，別介意。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解久岐忍·其二",
      "text": "我家是巫女世家，但我不適合當巫女。剛逃出來的那時，我覺得要多累積，以免沒有傍身之技。什麼廚師、裁縫、格鬥、律法諮詢、出版編輯…我都學了。沒想到真正進了社會才發現，學的已經完全夠用了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解久岐忍·其三",
      "text": "#{F#妳}{M#你}說我社交場合很厲害？呵，畢竟在外流浪了那麼久，總得學會察言觀色。更何況在多數時候，理虧的那一方都是我們。我不討厭擺出那些表情，但可以的話，我還是選擇不笑的好。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解久岐忍·其四",
      "text": "剛進荒瀧派的時候，老大要我教小弟們怎麼打架。所以我上來第一件事，就變成了把他們挨個揍趴下。沒想到，一個個鼻青眼腫的，卻睜大眼睛，張嘴就叫我「忍姐」，還要我好好帶領他們。哼，那時候我就知道這是一群笨蛋。但沒關係，笨蛋不會拖我後腿，我會解決一切問題。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解久岐忍·其五",
      "text": "留在荒瀧派是我自己的選擇。收拾爛攤子難免令人火大，但他們也給了我無可替代的真誠。最好的東西都先留給我、從不潑我冷水、在我宣布決定後鬧哄哄地鼓掌吹口哨…我知道外面對荒瀧派的評價不太好，他們自己也不在乎，但我還是想努努力，改變別人對我們的印象。因為，對待「家人」，自己可以偶爾抱怨，但就是不想讓其他人說他們的不好。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "久岐忍的愛好…",
      "text": "平時混幫派時，閒著也是閒著，經常不小心讀完一本書，不小心就把證照考了。不也挺好嗎？家裡問起來，我也沒虛度時光，出去談工作，也算得上有資本。在這個凡事講究實力的社會裡，我這種有證書的混子，到哪裡都能吃得飽飯。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "久岐忍的煩惱…",
      "text": "以前不想被抓回去當巫女，就決心只靠自己站穩腳跟。至少目前看來，我幹得還不錯。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "就算剛吃過拉麵或者餃子之類很管飽的食物，最後還是想以一小碗米飯結束。米飯好吃，沒什麼其他原因，有問題嗎？"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "廚師證到手後，我就更加堅定那個從璃月聽來的說法：沒有難吃的食物，只有不合格的廚師。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "真不簡單。咳…我就再多吃一口。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}做的？嗯…這種水準去考個廚師證應該綽綽有餘。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#我直說吧，{F#妳}{M#你}是不是放錯調味料了？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂，來，這個鳴草特製飛鏢送給{F#妳}{M#你}。小心點，嗯，對，要像這樣拿…投擲前記得計算弧度。呵呵，看{F#妳}{M#你}喜歡我就放心了。哦，別把它當玩具，還是有一定危險性的。想多訓練一下的話，我來教{F#妳}{M#你}。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "基本功不過關，就什麼都不用談了。這就是初級證書的意義。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#中級證書到手，已經可以處理大多數麻煩了。有什麼麻煩的事需要我幫{F#妳}{M#你}解決？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "高級證書絕不是輕易就能得到的，天賦和實戰的累積缺一不可。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#證書只能用來評判技能的專業程度，無法對付出或情感的投入進行量化。{F#妳}{M#你}我的交情也不能只用一句感謝來表達，還是用我最擅長的行動來說明一切吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "鳴草結環！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "解厄！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "好好站穩了。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "給我…安分點！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "祈雷…祓除！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "別來礙事。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "嗯，積少成多。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "這票也穩了。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#{F#妳}{M#你}的了。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "給、我、站、住…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "算是惹怒我了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哼，該我了吧…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我來善後。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "行了交給我，別硬撐。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "這次…是給人添麻煩了啊…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "#荒瀧派就拜託{F#妳}{M#你}了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "這是對我的…侮辱…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "再來。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "等著！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "找打是吧！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "看我眼色行動。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "這次是什麼麻煩？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "希望不是爛攤子。"
    }
  ]
}