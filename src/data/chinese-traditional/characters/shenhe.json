  "outfits": [
    {
      "id": 206301,
      "name": "冷花幽露",
      "description": "申鶴收到的海燈節賀禮。由其師留雲借風真君請人縫製的優雅禮服，雙臂上紅繩依舊，但申鶴心中的苦寒之意已淡。",
      "isDefault": false,
      "characterName": "申鶴",
      "characterId": 10000063,
      "source": [],
      "filename_card": "UI_AvatarIcon_ShenheCostumeDai_Card",
      "filename_icon": "UI_AvatarIcon_ShenheCostumeDai",
      "filename_iconCircle": "UI_AvatarIcon_ShenheCostumeDai_Circle",
      "filename_splash": "UI_Costume_ShenheCostumeDai",
      "filename_sideIcon": "UI_AvatarIcon_Side_ShenheCostumeDai"
    },
    {
      "id": 206300,
      "name": "縛絕紅塵",
      "description": "申鶴的裝扮款式。伴隨申鶴常年修行的優雅衣裝，纏繞身軀的紅繩既是束縛也是庇護。",
      "isDefault": true,
      "characterName": "申鶴",
      "characterId": 10000063,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shenhe_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我名申鶴，命格孤煞，易傷身邊人，仙人叮囑要以此紅繩鎖魂，控制殺心。若{F#妳}{M#你}不畏懼與我同行…很好，就請伸出手來吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·歸宿",
      "text": "人間的歸宿是一種奢望，我早已習慣跟山川與鳥獸作伴了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·要訣",
      "text": "迴向正道，保身護命…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·刀槍無眼",
      "text": "刀槍無眼，紅繩的力量也有極限，所以我才不喜歡人多的地方。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "按照凡人的做法，這種時候，是否應該…撐傘？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "天氣變好，我也很開心。只希望沒有人來打擾…如果有，就讓他們消失好了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的時候…",
      "text": "把魔物凍在原地，雷劈下來就能瞬間解決它們，還不會讓衣服沾上塵土。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "嗯…師父最喜歡慶雲頂上的罡風。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安。晨露很甜，要分一點給{F#妳}{M#你}嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "若是午後睏乏，不妨試試打坐養神，很有效果。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#不知道{F#妳}{M#你}是喜歡人間的燈火，還是山林的月光？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#放心休息吧，我睡眠很淺，有什麼動靜，我會替{F#妳}{M#你}查看的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於申鶴自己·本能",
      "text": "磨礪自身、修煉方術，都是本能使然，想要保全自己而已。我沒有兼濟蒼生的胸懷，懲奸除惡只是順手，不必感謝我。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於申鶴自己·異類",
      "text": "受我恩惠的人叫我仙人；被我懲罰的人喊我魔女，呵…不管是仙是魔，終究都是跟凡人不同的異類罷了…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·待人接物",
      "text": "#我很少下山，不懂得多少待人接物的道理。發生衝突的時候，我一律按自己的方式處理。但，如果{F#妳}{M#你}覺得不妥，都請告訴我，即使不理解，我也會聽{F#妳}{M#你}的。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·紅繩",
      "text": "#師父賜我紅繩用以壓制心性，但這些日子{F#妳}{M#你}我同修，我才真正領悟到要訣，力量收放也更自在…{F#妳}{M#你}才是真正能鎖住我的紅繩。若{F#妳}{M#你}懂得這份心情，就請留在我身旁。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "原來這顆閃耀的石頭叫做「神之眼」？呵…有緣既得，無緣便失。日後倘若緣分消散，它也會熄滅吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "邪祟易驅，心魔難除。若自身無法放下執念，仙法與術式都無從挽回。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#為什麼說「初雪多浪漫」？那處山巔日日下雪，何日才算是初雪？我不理解，請{F#妳}{M#你}告訴我。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於凝光…",
      "text": "人們所謂的財富，對我而言沒什麼用。但到了凝光小姐手裡，卻能解決連刀槍都無法處理的難題。她能掌握人間規則、洞察人心…師父說，這些連仙人都無法做到。我很佩服她。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於北斗…",
      "text": "#與她相處不用講究禮節，交談時也不用揣測深意，讓我輕鬆了不少。只是…她身邊總是有人，聽說船上還有諸多船員…我需要跟{F#妳}{M#你}一起，才能應對人多的場合。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於雲堇…",
      "text": "#雲堇唱的…叫做「璃月戲」吧？我很喜歡這種形式。不必親見其面，就能瞭解他人的事蹟。如果將來她把{F#妳}{M#你}唱進戲裡，那一定會是非常精彩的故事，我很期待。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於甘雨…",
      "text": "我從師父那裡聽過許多有關她的事…她原先在我心中的形象，和實際差距還是挺大的。放心，我不會說出去。說起來，璃月港的工作竟這般繁忙…看來融入人間，也要付出一些代價。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於重雲…",
      "text": "真沒想到我在這世上…還有「親緣」。他若是有什麼修行上的困惑，我願幫忙解答。不過，得請他上山來。他們一家太過熱情，我不知道該如何回絕才符合禮數…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於行秋…",
      "text": "#我曾見到他湊在{F#妳}{M#你}耳旁不知說些什麼。若他敢威脅{F#妳}{M#你}，我一定會將他…嗯？只是朋友間的玩鬧話？當真如此嗎…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於鍾離…",
      "text": "那位先生自稱是凡人，卻與身為仙人的師父很熟絡。師父曾說，如果碰見他在仙府前的石凳上飲酒，莫要打擾，讓他靜靜獨坐一會。我照做了。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於白朮…",
      "text": "他的藥草品質很好，為人也隨和周到。相比起來，脖子上的小蛇倒是口無遮攔…放心，我沒有動手。我還不至於和一條蛇置氣。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於胡桃…",
      "text": "她在附近山林遊蕩時，經常會唱奇怪的歌。久而久之，我把她的歌斷斷續續聽了個遍。聽習慣了也還是覺得奇怪，但，我並不討厭。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於魈…",
      "text": "印象中他一直不苟言笑。近來見他，雖說沉默依舊，但…像是比從前輕鬆了不少。興許是結識了哪位良人吧。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於閒雲…",
      "text": "上回，師父帶漱玉來萬民堂吃飯，漱玉言談間已有了幾分師父的神形…我也是在師父的呵護下如此成長，不知道我的舉止，是否也帶著些師父的樣子呢…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解申鶴·其一",
      "text": "請不必在意人們對我的稱呼，我不是仙人，也沒什麼神通。生於驅魔世家的旁系；長在遠離璃月港的山間，只能算是個仙家弟子，僅此而已。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解申鶴·其二",
      "text": "遇到惡意滋事的人，人們似乎都會選擇上前說教，我不太明白。明明可以直接將這些攔路礙事、心存歹念的惡人斬草除根，為什麼要這般麻煩？"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解申鶴·其三",
      "text": "我師從多位仙家，靜心修煉。隨著修為提升，他們不再傳授我新的術式，而是改教我怎樣收斂殺性。別緊張…像平地鑿出深坑，樹木連根拔起之類的事，只在遠離人煙的山林中發生過，從未波及過無辜性命。況且，現在我也已經能控制自我了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解申鶴·其四",
      "text": "父親想用我的血肉換回母親的生命。自從被他丟在山洞，我一度期盼過他會回來救我。一天、兩天、三天…我拚盡全力與魔物廝殺，直到倒下都沒能等到他。我不知道，究竟是我命格孤煞才遭人遺棄，還是命途坎坷使得我萌生出這股煞氣？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解申鶴·其五",
      "text": "#有一回，我瞞著師父偷偷下山回到村裡，卻發現原本的村莊荒棄了，父親早已去世。我突然明白，自己與血親的緣分徹底斷絕了。在乎的往事永無後話。自那日起，我一度捨棄人間種種…直到遇見{F#妳}{M#你}。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "申鶴的愛好…",
      "text": "打坐的要點在於「靜」，需要摒棄雜念，用身體感受周遭氣息，它能讓我迅速回歸自我。聽師父說，修為達到足夠境界後，打坐的姿勢就不用再拘泥，仙人哪怕站立著都能打坐…我還遠遠不夠。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "申鶴的煩惱…",
      "text": "害怕失去重要之人、想要拯救重要之人…這種心情會將整顆心緊緊揪住，以前從未體會過。這是困擾，但…也是寄託。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "下山期間嚐了不少菜，但都不太記得味道了。唯獨從前在家吃的那碗麵，永遠忘不了…不該記住才對，不該記住才對…"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "藥草嚼得久了，只剩苦味與澀味…修行多年，我早已習慣這些清規戒律了。仙人們？「仙人不會被人間俗物阻礙修為，所以可以敞開吃各式菜餚。」…這是師父的原話。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "這般滋味…真的是我能夠享受的嗎？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}做的飯菜，確實美味。無法割捨。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "也好。這樣的味道，我早就熟悉了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#我聽說生辰是個值得銘記的日子，人們會向壽星送上禮品以示慶賀。身外之物，我不太瞭解。銀河夜色，是我在山林中見過最美麗的事物。我將湖面凍成明鏡，讓浮雲和星斗映照在眼前，跟{F#妳}{M#你}共賀生辰…希望{F#妳}{M#你}喜歡。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我能操控的力量…越發強大了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "師父若知道了，怕是會讓我多繫幾根紅繩吧…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#這段日子，我閉關修煉的時長有所削減，修為卻不知不覺地增進…嗯，也許只有跟{F#妳}{M#你}一起才能做到。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "「心無雜念，方可超然」，這是我從前所想。經歷種種才明白，唯有心存牽掛，才能喚醒守護的欲望，讓力量…變得有意義。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "聽令！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "顯！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "魂出！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "煉氣化神！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "意生冰身！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "付君真形！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "天真敕奏！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "寒冰變神！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "依律奉行！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "這就是凡間的寶物吧。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "與仙人法寶有何區別？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這些東西…該用到何處？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "休要怪我…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我不甘心…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "必須…誅除！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不必勉強。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我來了結。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "難逃…宿命…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "死喪既定…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "劫煞為災…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "不成氣候。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "休想！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "別後悔！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "團隊作戰…是什麼意思？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "明白，站在這裡就行了是吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "…聽君敕令。"
    }
  ]
}