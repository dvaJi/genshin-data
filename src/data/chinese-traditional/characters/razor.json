  "outfits": [
    {
      "id": 202000,
      "name": "奔行原野",
      "description": "雷澤的裝扮款式。便於野外奔行的簡約裝束。",
      "isDefault": true,
      "characterName": "雷澤",
      "characterId": 10000020,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}的氣味…好聞。一起狩獵吧！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·氣味",
      "text": "唔，兔子的味道…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·餓",
      "text": "走嗎，肚子餓了。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·把風",
      "text": "我去望風，走了叫我。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "打雷的時候·提醒",
      "text": "怕就快點躲起來。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "打雷的時候·帶路",
      "text": "避開樹，跟我來！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "起風的時候…",
      "text": "風…唔…舒服。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "颳大風了…",
      "text": "風…嗯…紮紮的，有點疼。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "太陽出來了。狩獵一起去？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "大塊吃肉，開心！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#{F#妳}{M#你}去睡覺吧，我看月亮。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}睡覺，我看守。明天一起狩獵。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於雷澤自己…",
      "text": "我是狼。人的爸爸、媽媽，沒有。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·朋友",
      "text": "#{F#妳}{M#你}是朋友。我和{F#妳}{M#你}一起狩獵。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·武器",
      "text": "#我有鐵的爪子和雷的牙。我保護{F#妳}{M#你}。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」，師父幫忙。雷的牙打架，保護「盧皮卡」。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "晚上，星星很好看。天空，湖裡，都有很多很多星星。\\n晚上，城市裡，也有很多星星。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "我的「盧皮卡」的狼。牠們是家人。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於麗莎…",
      "text": "師父的雷，天空會變黑。很可怕，很強。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "芭芭拉，亮晶晶的女孩子。很善良。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "迪盧克，紅紅的、黑黑的。又冷又熱。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於溫迪…",
      "text": "詩歌…唔，不明白。雖然不明白，「盧皮卡」喜歡。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於班尼特…",
      "text": "班尼特，話很多，和他一起，吃不飽。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於可莉…",
      "text": "可莉，朋友！朋友，但是，頭疼。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於法爾伽·陌生",
      "text": "法爾伽？不認識…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於法爾伽·回憶",
      "text": "哦…法爾伽，是名字。那個男人，高大。雷澤名字，鐵的爪子，他給的。唔…想見他。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解雷澤·其一",
      "text": "#{F#妳}{M#你}的氣味，善良的味道。喜歡吃肉？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解雷澤·其二",
      "text": "#{F#妳}{M#你}很強。和狼一樣強。喜歡和{F#妳}{M#你}狩獵。收穫很多。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解雷澤·其三",
      "text": "盧皮卡是「狼的家」。不對，是「狼的家人」。我的盧皮卡在樹林裡。牠們保護我，說我是盧皮卡。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解雷澤·其四",
      "text": "我只有盧皮卡。\\n但是，就算是盧皮卡，我沒有四隻腳，不是真的狼。有時候心裡難過。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解雷澤·其五",
      "text": "#和{F#妳}{M#你}一起奔跑開心，和{F#妳}{M#你}一起狩獵開心。和{F#妳}{M#你}一起，我是狼，我是人，都沒關係。\\n{F#妳}{M#你}是朋友，{F#妳}{M#你}是我的「盧皮卡」。我想要{F#妳}{M#你}也開心。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "雷澤的愛好…",
      "text": "喜歡盧皮卡。喜歡樹林。喜歡朋友。喜歡奔跑。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "雷澤的煩惱…",
      "text": "說話很累，很難。但是，不說話不行。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "喜歡肉。喜歡馬鈴薯。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "蔬菜不好。我吃的肉才吃菜。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "氣味很香，味道一樣好。喜歡。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "吃了有力氣，很開心。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "吃，不好。不吃，不好。有些難過。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天是{F#妳}{M#你}的…{F#妳}{M#你}是在很多很多個月以前的，今天出生的。想和{F#妳}{M#你}一起開心。今天一起吃肉。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "手臂，更粗了…？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "磨爪子，磨牙，要更強！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "跑，狩獵。不夠，不行！我要…更強。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#牙齒，爪子，腿。更強，更有力氣…保護{F#妳}{M#你}！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "走開！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "啊！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "嗷！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "別過來！"
    },
    {
