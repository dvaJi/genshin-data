  "outfits": [
    {
      "id": 202701,
      "name": "紗中幽蘭",
      "description": "凝光的禮服裝扮。紺藍長裙勾勒出麗人優雅的曲線，腳踝上的蝶翼又為她平添了幾分輕盈。",
      "isDefault": false,
      "characterName": "凝光",
      "characterId": 10000027,
