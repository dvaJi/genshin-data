      "filename_splash": "UI_Costume_NingguangCostumeFloral",
      "filename_sideIcon": "UI_AvatarIcon_Side_NingguangCostumeFloral"
    },
    {
      "id": 202700,
      "name": "璣玉瓊金",
      "description": "凝光的裝扮款式。繡工精巧、盡顯雍容氣度的飄逸裙裝。",
      "isDefault": true,
      "characterName": "凝光",
