      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Ningguang_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是七星之「天權」，凝光。要做個交易嗎？{F#妳}{M#你}來做我的貼身侍衛，而我，會教導{F#妳}{M#你}在璃月出人頭地的技巧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·古玩",
      "text": "就算古玩價值連城，給人的快樂也只有剛擁有的一瞬。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·商戰",
      "text": "在商戰中，完美的獵手不會留下任何痕跡。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·投資",
      "text": "找筆新的投資吧。無論如何，摩拉都不會嫌多。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "哦？下雨了啊。替我打傘吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#不過是尋常雪景。我帶{F#妳}{M#你}見見，真正的「碎雪」。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "#風平浪靜？呵，不要相信{F#妳}{M#你}的眼睛，眼睛會說謊。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "這樣的大風天，會成為捕魚人的災難。也會成為…呵，沒什麼。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早，按事情的輕重緩急向我稟報吧。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#「琉璃亭」和「新月軒」，{F#妳}{M#你}更常去哪一家？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#茶館已經客滿了？那就來「群玉閣」坐坐吧。只要…{F#妳}{M#你}付得起價錢。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#嗯，去休息吧。要是發生了重要的事情，我會派人通知{F#妳}{M#你}的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於凝光自己·觀點",
      "text": "無論是價格談判還是商戰博弈，聲勢和籌碼都是次要的。想要取得勝利，就需要先去瞭解對手的底牌。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於凝光自己·印象",
      "text": "#覺得我給{F#妳}{M#你}的印象變了？呵…那時我需要借助{F#妳}{M#你}的力量，當然要讓{F#妳}{M#你}覺得我親切熱情。但現在我已將{F#妳}{M#你}當作重要的「契約」夥伴，夥伴之間，就不用這些虛情假意了。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·傳言",
      "text": "#關於我的傳言，最近聽了不少吧。我究竟是怎樣的人？用{F#妳}{M#你}自己的雙眼分辨吧…當然，{F#妳}{M#你}的看法，也會成為傳言的一部分。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·觀察",
      "text": "#跟了我那麼久，{F#妳}{M#你}學會「觀察」了嗎。那麼，試著來「觀察」我吧，直到成為我的心腹為止。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·群玉閣",
      "text": "上前來，和我並肩站著。看到「群玉閣」了嗎。它起初只有房間大小，如今卻能遮蔽璃月上空。等到它的規模有朝一日籠罩七國，那時候，也這樣和我並肩而立吧。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "能用摩拉解決的事情，就無需使用「神之眼」。至於用摩拉也解決不了的事情…至今我只遇到過一件。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·莊家",
      "text": "賭徒永遠會把希望寄託在下一顆骰子上…但最後賺錢的，當然是從來不碰骰子的莊家。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什麼想要分享·目標",
      "text": "帝君的離去，無論對璃月還是七星來說，都是不小的考驗。我也很久沒有像最近這樣輾轉反側了。\\n不過，我不會放棄我的目標。總有一日，我會讓群玉閣投下的影子籠罩七國——"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "璃月古代辭賦中不乏對於「琉璃百合」的溢美，但它現今卻近乎滅絕，只在「玉京臺」還有保留。名聲在外卻又不可多得，因此更加價格不菲。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於北斗·罰金",
      "text": "那位…船長。明明也受到不少人推崇，卻總是帶頭漠視規則。她繳納的罰金，都夠買一艘嶄新的遠洋船了吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於北斗·態度",
      "text": "#或許{F#妳}{M#你}沒有遇到過這種糟糕的交流體驗。將好話壞話說盡了，對方卻依然自行其是。罷了，盡可能不要讓我見到那位北斗船長。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於鍾離…",
      "text": "鍾離…「往生堂」口中的這位先生，精通許多旁人不知的事物。但在掌握他的弱點之前，再優秀的棋子，也還不能為我所用。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於行秋…",
      "text": "飛雲商會的二公子，那種性格的人看不慣我，是很自然的，而我也不會去為難他。「道不同不相為謀」，說的就是這個道理。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於香菱…",
      "text": "「萬民堂」的小丫頭…總是把對我的猜疑寫在臉上。呵，要是讓她知道了，這些年來我對「萬民堂」的資助…她會露出怎樣的表情來呢？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於甘雨…",
      "text": "即使是甘雨，也不可過度依賴。璃月俗語說「百密終有一疏」。重要事情當前，只有自己親手處理，親眼查證，才可放心。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於瑤瑤…",
      "text": "#是在談論甘雨正幫忙照看著的小姑娘嗎。呵，不用緊張，此事我並無聲張的打算。就當那個船長，總能做一兩件聰明事吧。對了，這瑤瑤，近來光顧著吃海產了，{F#妳}{M#你}得想辦法勸勸甘雨，叫她為瑤瑤多補充些瓜果蔬菜才對。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於刻晴…",
      "text": "「玉衡星」…她最近的變化可真不小。璃月究竟更需要曾經的她，還是更需要現在的她呢？可能要多花一些時間，才能判斷吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於琴…",
      "text": "蒙德城的代理團長，想必是一位嚴謹而又細膩的女性吧。且不說她恰如其分的用詞，連每張信紙的邊緣都折疊得一絲不苟。越是這些容易被人忽視的細節，越能透過它窺見一個人真正的素質。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於煙緋…",
      "text": "煙緋？呵，某種意義上，她是個貼心的對手呢。若不是她「靈巧」地解釋律法，為諮詢者們提供各種「奇妙」的建議，要讓我獨自找到律法的缺口，逐步完善法典，恐怕要多花數月的時間。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於申鶴…",
      "text": "#申鶴小姐近來可好？有勞{F#妳}{M#你}多多關照她了。你們幫忙重建群玉閣的事，我一直記在心裡，也很是感激。啊，客套話就不多說了，我備了好茶，閒時多來坐坐吧。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於雲堇…",
      "text": "#雲堇啊…怎麼樣，{F#妳}{M#你}聽得慣她的戲嗎？起初可能是有些難懂，試著耐下性子多品味一下吧。我投資她的戲班不為別的，只是覺得，這般典雅的藝術，值得被一直傳承下去。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於夜蘭…",
      "text": "#她是個很有意思的人，對我而言，也是絕對可信之人。八面玲瓏，才能無可挑剔。呵呵，既然同為聰明人，希望{F#妳}{M#你}們能相處愉快。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於閒雲…",
      "text": "#再過些時日，我打算約閒雲女士去茶室小坐。我恰巧收集了一些機巧玩物，想聽聽她的高見，也想趁此機會，聽她講講仙人在璃月港生活的趣事。至於為我遞這份邀請函的人選…{F#妳}{M#你}可有意？"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於白馬仙人…",
      "text": "沒想到，如今的璃月港裡竟然又添了一位新仙人。好在這位白馬仙人喜愛雲遊，不常在璃月港居住，不然真要應了夜蘭那句打趣的話了…她說什麼？呵呵，她說：「都說仙人最喜歡清淨，我看璃月的仙人，還是最喜歡璃月啊…」"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解凝光·其一",
      "text": "#既然是{F#妳}{M#你}，就不用恪守那些繁文縟節了，可以隨意一些。不過，希望{F#妳}{M#你}能珍惜我的時間，言簡意賅地說明。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解凝光·其二",
      "text": "#我向來以為，孩子們最為天真純粹，他們提供的情報也最有價值。那麼，{F#妳}{M#你}又如何呢？{F#妳}{M#你}向我提供的東西，會是些什麼呢。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解凝光·其三",
      "text": "#最近我在思考一個問題。如果能把{F#妳}{M#你}留在璃月，假以時日…或許能撬動這座城市的…呵，只是設想而已。這筆投資值不值，我還得再考慮考慮。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解凝光·其四",
      "text": "#{F#妳}{M#你}可以學我的做法，靠摩拉來為自己獲取一些便利。但{F#妳}{M#你}要記住，摩拉維持的關係只能依仗一時。呵，這也是我從不用摩拉來試探{F#妳}{M#你}的理由。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解凝光·其五",
      "text": "#真是一筆不錯的投資。雖然沒有收益多少摩拉，但與{F#妳}{M#你}度過的這些時光，已是很不錯的回報。呵，看來我又贏了——我，賭對了人。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "凝光的愛好…",
      "text": "#想來試試棋戲「璃月千年」嗎？正好也讓我看看，{F#妳}{M#你}作為一名棋手的素質，究竟如何呢。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "凝光的煩惱…",
      "text": "#煩惱…喔？「璃月七星」的煩惱告訴了{F#妳}{M#你}…{F#妳}{M#你}的肩膀，能夠承受得住嗎？而且，如果{F#妳}{M#你}一不小心說出去了的話…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "用老雞和豬骨小火久煮熬製高湯，淋在只取菜心的鮮嫩白菜上。我對飲食追求不深。平日裡吃點這樣的東西，也就夠了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#我見過有人每次宴會必點「黃金蟹」這種看上去顯得大富大貴的食物，但我對此始終不敢恭維。如果{F#妳}{M#你}想用這樣的料理宴請我，還不如直接給我摩拉。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#不錯。{F#妳}{M#你}總能出乎我的意料。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "有時，沒有把握關鍵要素，就等於徒勞無功…能明白嗎？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "心意我領了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#{M#這是選用上等的霓裳花織出的錦緞。這份是留給你的，這一份…等你找到自己的妹妹之後，拿去做件她喜歡的衣服吧。祝你們，生日快樂。}{F#這是選用上等的霓裳花織出的錦緞。拿去做件自己喜歡的衣服，過個開心點的生日吧。}"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "「武鬥」缺乏風度，只能作為下策中的下策。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "將時間和摩拉作為籌碼，等價交換到「力量」嗎…有趣。我認可它的價值。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#{F#妳}{M#你}是懷著怎樣的心情堅持的呢？噓…不要說出來。讓我多花一點時間來看透{F#妳}{M#你}。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我並不輕易肯定別人，但現在看來，我這讚揚是留不住了。呵…{F#妳}{M#你}做得很出色。要是我的手下能多一點像{F#妳}{M#你}這樣的人…不，或許，有{F#妳}{M#你}一個就夠了。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "雕蟲小技。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "別白費功夫。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "哼，勸你放棄。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "你的性命，我收下了。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "向我臣服吧。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "永別了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "好一雙慧眼。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "顆粒歸倉。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "財富，多多益善。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "竟然敢傷我。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我記下了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哼。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "如今的局面，你沒有幾成勝算。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "既然如此，就幫你一把。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "這世上之人，皆為棋子…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "勝負已分…真是無可奈何。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "這就是，「天權」的終焉？…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "無禮。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "等著吧。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "血債血還。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "知道了。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "抓緊時間吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "不要讓我失望。"
    }
  ]
}