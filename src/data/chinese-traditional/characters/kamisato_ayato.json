  "outfits": [
    {
      "id": 206600,
      "name": "綾羅錦繡",
      "description": "神里綾人的裝扮款式。著物本身由珍奇布料製成，布料上的紋飾褶褶若高山之泉，散發出同他本人一般的沉穩莊重氣質。",
      "isDefault": true,
      "characterName": "神里綾人",
      "characterId": 10000066,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Ayato_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "此前聽綾華屢次提起閣下，不料公務繁忙，直至今日才有機會相見。神里家家主，神里綾人，今後請多指教了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·大少爺",
      "text": "好像忘記帶什麼東西了…算了，等想起來的時候再差人送來好了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·收網",
      "text": "暗線已經佈置妥當，嗯，差不多該收網了…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·惡趣味",
      "text": "一想起家臣們一臉焦急卻又不敢開口阻攔的樣子，就忍不住覺得有趣。呵，出來走走是不錯。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "暫且先避下雨吧，不必著急，很快就會有人來送傘了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "綾華自小害怕打雷，直到家母告訴她雷聲是大御所大人的傾訴。從那時起，每逢打雷她都會神色專注，彷彿這樣就能聽懂大御所大人的言語。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "如今的雪景，與多年前的那場雪…並無二致。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "能悠閒曬太陽的時間可不多。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起風的時候…",
      "text": "有些「突發情況」，看似細小如微風，卻會影響到最終結果…呵呵。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "颳大風了…",
      "text": "大多數人會因為大風迷眼而止步不前，只有少部分人能夠藉勢而為。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早上好。清晨適宜練劍，放鬆身心。我一般不會讓人安排公務。如何？要過上幾招嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午飯如果有偏好的菜色，提前和家僕說就好。{F#妳}{M#你}是我的貴客，他們也應對{F#妳}{M#你}盡心盡力。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "既然在這個時間點找我，不如留下來吃晚飯吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#到洗漱的時間了是吧，你先下去吧，我還不睏…呃，是{F#妳}{M#你}？我最後再整理一下今日的公務便好，{F#妳}{M#你}也早點休息。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於神里綾人自己·代價",
      "text": "萬事皆有代價。既然尋求常人無法企及之事，那就必然付出世人無法想像的代價。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於神里綾人自己·手段",
      "text": "我並不是拘泥於手段的人，無論採取怎樣的方式，只要能夠取得合適的結果就好。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·趣事",
      "text": "#呵，我聽說了{F#妳}{M#你}們在天領奉行那邊發生的趣事。能讓九條老頭氣得掉頭髮的人，真不多見。只可惜沒有親眼見證這一幕啊…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·信任",
      "text": "#信任他人不是一件容易的事，特別是對於位居高位的人來說。一旦錯付了，付出生命的代價也不算少見。不過，{F#妳}{M#你}已經給了我信任，那我自然也不該辜負。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "既然有「神之眼」這麼方便的道具，自然是要好好利用了。能在我的手中像這樣煥發光輝，它也是高興的吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "將落花投於暖爐之上，在爐火的炙烤下，花會短暫地恢復生機，最後一刻的紅豔更是壓火光一籌…倒也沒有枉費短暫的一生。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "說起寵物的話，嗯，我比較喜歡狗。貓自我主義的特徵是不錯，但只有狗會乖乖聽從主人的命令。忠誠而又坦率，呵，真是惹人喜愛啊。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "#我相信綾華的能力，但我也希望她能夠保持一顆純粹的心。權力鬥爭她不必參與，人世陰暗她也不必直面，這些理應由作為兄長的我來一一掃清…不小心說太多了，就當是{F#妳}{M#你}我之間的秘密吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於托馬…",
      "text": "托馬對神里家的忠心毋庸置疑。很久以前我曾試探過他，如果不想往後被捲入無盡紛爭的話，最好早日離開。他卻還是留了下來，一直跟隨著神里家，讓我也省心不少…現在，我完全信得過的人很少，托馬算是一個。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於早柚…",
      "text": "#她平時看起來是懶散了點，但在適當的時機，卻總能給予重要幫助。{F#妳}{M#你}應該再清楚不過了吧？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於宵宮…",
      "text": "那位…為人爽朗的煙花店店主嗎？嗯…她和神里家往來還算密切。她和綾華年齡相仿，也很投緣。綾華大概也不會因為她的快人快語而困擾。畢竟綾華那孩子在小時候，就能堅定地守住本心。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "為了追求「永恆」，將軍大人以及整個稻妻，都付出了不小的代價。傷口需要時間來癒合，作為政局的調和者，我必然會盡到我的責任。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於八重神子…",
      "text": "#宮司大人於神里家有恩，可是她卻一直不太看得慣我，呵，恐怕{F#妳}{M#你}沒少聽她「那小子」、「那小子」地稱呼我吧。\\n由於業務交集，我們偶有碰面，雖說大家各懷心思，但工作起來也稱得上融洽。我並不討厭這種感覺。嗯，與聰明人一起辦事，效率就是會高得多。況且就算她再討厭我，也不得不承認如果沒有我，就沒人能實現得了她那些「奇思妙想」了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "九條老頭打得一手好算盤，磨礪出了一柄利劍。哼，只可惜，他沒有算到，自己做不起這位執劍人。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於楓原萬葉…",
      "text": "楓原家曾是神里家的下屬，神里家的先祖當年未能保護他們周全，到我這裡，仍有義務照拂他。雖說無法助他重振家業，但幫他逃脫天領奉行的追捕這種事還是做得到的。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "那傢伙實在是個有趣的人。讓溫順的鬼兜蟲相互爭鬥，哈哈，有趣。嗯，雖然那次點撥實則是不經意之舉，但沒想到的是，他竟會直接與我稱兄道弟，而且時至今日都還沒發現我這位「綾人兄」的身分。呵呵，這樣也好，我並不討厭…單純的人。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於凝光…",
      "text": "#璃月七星中的那位「天權」大人，嗯，她的手段我也略有耳聞。說來，我還收藏有一套限量版的「璃月千年」，{F#妳}{M#你}感興趣嗎？我差人拿出來，我們下一盤如何？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解神里綾人·其一",
      "text": "#我的事情嗎？有時候知道得太多不一定是好事，{F#妳}{M#你}應該也聽說過類似的諺語吧。下次有機會再聊吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解神里綾人·其二",
      "text": "#品味…奇特？看來{F#妳}{M#你}對我有什麼誤解，我得澄清一下才是。多數時候，我只是喜歡看人臉上為難的表情罷了。難道這很奇怪嗎？{F#妳}{M#你}應該也沒少逗{F#妳}{M#你}旁邊的小傢伙吧？"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解神里綾人·其三",
      "text": "#三奉行之間，表面看起來風平浪靜，實際上卻暗潮湧動。哼，和那些老傢伙們周旋，並不是什麼愉快的事，不值得細說。{F#妳}{M#你}只需知道…昔日是為了神里家的穩定，今日是為了稻妻的大局，我從未行有愧於神里家家主之名之事。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解神里綾人·其四",
      "text": "#終末番嗎？和{F#妳}{M#你}說說倒也無妨。那是直屬於神里家家主的一支秘密部隊，家父去世後，便由我接手了。我不能直接出面解決的事情，有了終末番就方便不少。裡面的成員大多是孤兒，從小就被組織收養，這樣才能最大程度保證忠誠，也能讓人放心。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解神里綾人·其五",
      "text": "#除了終末番以外的底牌？呵，自然是有的，狡兔有三窟，更何況人呢？只是我的秘密已經說得差不多了，該來聽聽{F#妳}{M#你}的故事了吧。喔對了，在提瓦特大陸上旅行的部分就不用了，說些更久之前的吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "神里綾人的愛好…",
      "text": "#愛好…小時候倒是略有一二，不過如今公務占據了大多數時間，不提也罷…嗯？{F#妳}{M#你}說有人把公務當成愛好？呵，這可真是…嗯…獨特。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "神里綾人的煩惱…",
      "text": "煩惱嗎？如果一件事讓我煩惱，那就得盡快處理好。如果一個人讓我煩惱，呵…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物·個人喜好",
      "text": "#新奇的事物能為枯燥的日常生活帶來新鮮感。最近花見坂那邊新出的什錦奶茶就很不錯，{F#妳}{M#你}也該試試。不過…日常飯菜上我沒有什麼偏好。每日用餐有專門的下屬制定計畫。對方端來什麼，我就吃什麼。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物·新的嘗試",
      "text": "#差不多可以告訴我{F#妳}{M#你}的口味了吧？嗯？原來是這樣。嗯，我記下來了。下次被問起的時候，我也回答這個吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "…啊，鹽和糖弄錯了。鹹的水饅頭…嗯，也行，給托馬吃吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "挺新奇的滋味。呵呵，很符合我的要求…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#原來如此。{F#妳}{M#你}對這道菜的理解是這樣的…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#給{F#妳}{M#你}個建議，下次把這道菜加進火鍋遊戲裡吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！讓{F#妳}{M#你}體驗一日社奉行，如何？\\n喔，公務我提前處理完了，{F#妳}{M#你}只需要享受權力帶來的樂趣就好。有我陪在{F#妳}{M#你}身邊，料想家臣們也不敢說什麼。呵，放心吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "能力提高了？呵，那可真是好事。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "力量這種東西，果然只有掌握在自己手中，才能安心。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "呵，有些人恐怕要寢食難安了吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#坐上家主之位以後，我少有鬆懈的時刻。有{F#妳}{M#你}在旁的這段日子，卻有點奇妙。嗯…就好像在曬太陽一樣吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "蒼流水影。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "劍影。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "秋水三尺。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "呵…安息吧。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "神里流…水囿！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#對{F#妳}{M#你}有用便好。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#原來{F#妳}{M#你}需要這些嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嗯…品質還行。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "真是有趣…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "那麼，我也認真起來吧。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不知鹿死誰手呢？"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "暫且後退。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "冒進是大忌。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "百密終是有一疏嗎…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "花無百日紅…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "世事無常…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "不過如此。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不自量力…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "喔？是邀請我去散步嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "那麼公務，就先放一邊吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "呵…餘興節目。"
    }
  ]
}