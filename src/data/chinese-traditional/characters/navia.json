  "outfits": [
    {
      "id": 209100,
      "name": "黃絲絨沙龍",
      "description": "娜維婭的裝扮款式。完美契合楓丹淑女形象的優雅裙裝，被一位喜歡冒險、喜歡大笑的非傳統淑女穿出了不一樣的風格。",
      "isDefault": true,
      "characterName": "娜維婭",
      "characterId": 10000091,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Navia_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#大名鼎鼎的刺玫會現任會長、領導者、總指揮、負責人、老闆娜維婭，很高興認識{F#妳}{M#你}！看{F#妳}{M#你}才貌出眾、氣度不凡，有種我們的緣分會像我的名號一樣長的預感。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·旅行",
      "text": "好想去旅遊呀——去哪裡都沒關係啦！重點是想跟朋友們一起玩，嘿嘿！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·經驗之談",
      "text": "多年的幫派經驗告訴我，身邊有一把不順手的武器會比沒有更危險。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·會標",
      "text": "#刺玫會的標誌是母親設計的，我非常喜歡。{F#妳}{M#你}看，輪廓像顆心臟一樣。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "啊…又是雨天…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "哎呀！剛才看到閃電就該捂住耳朵的！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "是不是應該摘掉帽子，讓雪花落在臉上？感覺一定很清爽。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "#就是現在！立刻、馬上，抬頭！{F#妳}{M#你}看天上，是不是烈日炎炎、炎陽炙人！知道這代表什麼嗎？\\n代表我們現在應該立刻、馬上去買最大號的超級冰冰涼甜筒，然後比賽誰可以在它融化前全部吃完！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "雨過天晴…",
      "text": "太好了，雨停了！"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "颳大風了…",
      "text": "帽子和裙襬…好難取捨！"
    },
    {
      "id": "1207",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "戴上墨鏡就不會有沙子跑進眼睛了！但天黑時會看不清楚路…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安！想好今天要做什麼了嗎？沒想好的話，要不要跟我來？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#聽說最近出了一種新口味的千層麵，{F#妳}{M#你}有沒有興趣？感覺一定不會好吃，但我還是想去試試看！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚間新聞播報：「今天的刺玫會會長也和她的好搭檔度過了完美的一天。」真棒！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "快，速速清空大腦，睡個好覺！明天見。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於娜維婭自己·樂觀",
      "text": "盲目樂觀是不行的，幸福的生活要靠自己的雙手去爭取！所以…來，握住我的雙手，左右搖晃幾下——怎麼樣，是不是很開心？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於娜維婭自己·運氣",
      "text": "瞭解我經歷的人可能會覺得我運氣不好吧？但我不這麼認為。\\n能夠得到這麼多的愛，是我一生最幸運的事情了吧…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·搭檔",
      "text": "#他們有人叫我老闆，有人叫我大小姐，我都無所謂啦。最開心的還是{F#妳}{M#你}稱呼我為「搭檔」的時候，所以請多叫幾次，滿足我的虛榮心吧！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·保密",
      "text": "#有人說秘密一旦說出口就不是秘密了，但可以和朋友分享的秘密不是更加珍貴嗎？\\n什麼啊…我不是在威脅{F#妳}{M#你}啦！雖然身為刺玫會的會長，我當然知道很多讓人保守秘密的訣竅，但我是不會用在{F#妳}{M#你}身上的，安心吧。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#給{F#妳}{M#你}看，這就是我的神之眼！亮晶晶的，很配我衣服的顏色吧？\\n不過還是{F#妳}{M#你}比較厲害，不需要神之眼就能夠使用很多種元素，應該不是靠練習就可以做到的吧？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·狗狗",
      "text": "#在所有的品種裡，我最喜歡深栗獵犬。{F#妳}{M#你}看牠們眼睛上方的花紋，是不是很像眉毛？所以牠們總是一副憨厚又認真的樣子。\\n不過這件事還請幫我保密，千萬不要告訴別的狗狗！"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·可靠的刺玫會",
      "text": "#假如{F#妳}{M#你}在灰河待過一段時間，應該會發現楓丹還是有不少其他幫派的。他們的目的不一，並非都像刺玫會那樣友善，{F#妳}{M#你}要多加留心。如果有必要可以向酒保泰托先生求助，若是對方不願意坐下來談的話…嗯，那就只好請我們可靠的白手套先生出馬囉！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#久雨蓮的顏色真好看啊…而且當{F#妳}{M#你}看到它們紛紛綻放的時候，就代表漫長的雨季終於過去了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "她平常話不多，表情也不多，但還是看得出來喜怒哀樂的。之前老爹的事卡在我們之間，唔…出現了一些隔閡…就算是那段日子，我也不愛她小心翼翼的樣子…還是現在這樣比較好。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "比起跑新聞時的熱情和速度，夏洛蒂的拍照技術更讓我驚訝。她之前隨手幫我拍過一張半身照，光影效果好像精心繪製的油畫一樣。既能寫出意想不到的報導，又能拍出最吸引目光的畫片，她大概天生就是要做記者的吧…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於千織…",
      "text": "這位為楓丹時尚帶來異國風情的服裝設計師，私底下其實幫過刺玫會不少忙。她說我的奇思妙想為她提供了好多創作靈感，以我對她的瞭解來看應該不是客套話，但當我請她做一個十公尺高的禮帽時，她卻嚴詞拒絕了。唉…要是可以擺在店門前，應該是個很顯眼的宣傳手段啊！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "小時候有幸觀看過一次芙寧娜大人參與義演的歌劇，票超級難買！雖然扮演的是別的角色，但她看起來反而比平常站在高處演講時更自然一點…現在回想起來，竟然不是錯覺。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "那維萊特先生啊…既複雜又簡單。怎麼說呢…就像海裡的礁石凹凸不平，但假如理解了其中的規律，也不是完全沒辦法預測。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "想和他談個事情是很費力的。克洛琳德說只要基於既定的合約就可以放心與他合作，但千萬不要相信他說的每一句話。怪不得老爹以前從不插手水下的事，保險起見，還是維持原樣好了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「僕人」…",
      "text": "她是一位威嚴卻又慈愛的領導者，有「一家之主」的風範。不過能夠成為愚人眾的執行官，她一定也有手段凶狠的一面。\\n所以放心吧，我會永遠記得她幫助過白淞鎮的恩情，但在其他方面也會小心的。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於林尼和琳妮特…",
      "text": "我知道大魔術師說話總會有些浮誇啦…但可以看得出來林尼是真心對待身邊親友的。有時候他表現出的責任感，要比他的年紀大多了…\\n哦對了，他之前還免費變過魔術給白淞鎮的小朋友們看呢！有機會的話，下次也請他和琳妮特小姐一起來吃馬卡龍，琳妮特小姐經常憑空變出茶杯來喝茶，那應該不會討厭甜點吧？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於愛可菲…",
      "text": "我的好朋友愛可菲呀，她總算是結束閉關了。聽說，她在開發超越「德波大蛋糕」的新品，一直悶在自己的專屬廚房裡。再這樣下去，眼睛都要懼光了吧？不如，我們約上她，找個時間出門野餐吧？陽傘和墨鏡隨她選。和愛可菲出行，普普通通的郊遊都會變成一場美食之旅哦。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解娜維婭·其一",
      "text": "刺玫會的工作嘛…雜七雜八的什麼都有，不過核心目的都是幫助大家解決各種麻煩。這裡的「麻煩」只用來指問題本身，不是代表我覺得這些事情麻煩——相反地，能夠幫到大家會讓我覺得神清氣爽！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解娜維婭·其二",
      "text": "人還是要有一些浪漫情懷才可以。春天的花、夏天的海，還有朋友的笑容…都不該是被忽略的景色。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解娜維婭·其三",
      "text": "#有時我會找個人跡罕至的野外擺一些東西作為目標，然後練習打靶。\\n很解壓！{F#妳}{M#你}想試試看嗎？讓我一步步教{F#妳}{M#你}。雖然{F#妳}{M#你}是我的第一個學生，但我覺得我會成為一名好老師的。老爹還有布萊卡利奶奶教我的東西我都還沒忘記哦！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解娜維婭·其四",
      "text": "我不會變成和老爹一樣的人。有刺玫會裡的老幹部覺得我和老爹越來越像了，但我認為那只是很小的一部分，要歸因於有些問題只能用固定的幾種辦法來解決。刺玫會已經不是當年的樣子了，會長也不會相同。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解娜維婭·其五",
      "text": "#我覺得我也不會變成和母親一樣的人。雖然很多人都說我個性和她很像，我也大概可以想像她當年做出很多選擇的理由，但是…\\n哎，突然很想去坐一次克萊門汀線…就是現在，可以陪我嗎？也沒什麼特別的目的，就當作是我邀請{F#妳}{M#你}去城裡閒逛吧？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "娜維婭的愛好…",
      "text": "我從小就喜歡烘焙。看著一堆零散的食材按照比例融合在一起，就會在烘烤的過程中一點點膨脹、定型，變成香噴噴的樣子，是不是很神奇？\\n對了，有機會一起來烤薑餅吧？比比看誰可以用餅乾搭出最高、最漂亮的小屋！"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "娜維婭的煩惱…",
      "text": "呃…烤完蛋糕以後散落的麵粉好難收拾，還有黏在容器裡的蛋清和鮮奶油…我、我去叫幫手來！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我喜歡能夠帶來驚喜的食物，但請不要懷疑我的味覺，我只是欣賞其中包含的創意——雖然這也不會改變很多料理難吃的事實就是了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不喜歡存放了很久的剩菜，感覺辜負了新鮮食材的一生…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#驚人的廚藝！跟{F#妳}{M#你}出門的話，我才是應該帶著食材和廚具的那個！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "味道真不錯，再讓我加點擺盤藝術就更完美了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "不要氣餒，世界需要這種創新精神。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#{F#妳}{M#你}相信許願嗎？向泉水中丟一枚摩拉，然後等待好運降臨在頭上。我想…只要摩拉丟得夠多，總有一個願望會實現吧？\\n所以與其寄希望於這樣的隨機事件，我決定直接用一袋摩拉為{F#妳}{M#你}實現今天的願望。只要是我娜維婭力所能及的，一定都幫{F#妳}{M#你}辦到！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "這種感覺…好像檸檬起司蛋糕！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "鮮奶油在舌尖融化，壓力也跟著消散了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#{F#妳}{M#你}知道有一種子彈形狀的巧克力糖嗎？它的甜度能夠瞬間讓{F#妳}{M#你}全身充滿力量，就像我現在的感受一樣！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#最後再來一壺美味的奶茶，屬於{F#妳}{M#你}我的休息時光就可以開始了。不過{F#妳}{M#你}為我做了這麼多，用一頓茶點作為感謝還是不太夠…以後{F#妳}{M#你}在楓丹要是有什麼需要幫忙的，就來找刺玫會吧！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "小心囉！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "正面偷襲！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "你好呀！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "試著躲躲看？"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "猜猜我還有幾顆子彈？"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "是…傘彈槍？"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "開火！雖然是岩元素啦…"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "玫瑰禮花！刺玫會特別訂製版。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "持續打擊！嗯嗯，就是這樣。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "喔！好運連連！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "快，快收好！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "尋寶大成功！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "再…再撐一下！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "…要盡到責任！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "注意力集中。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "交給會長吧！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "增援到了！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "就當作…回家了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "是我的錯嗎…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "就連我也…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "怎麼了？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "哪來的？！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "啊…不算什麼！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "說走就走。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "刺玫會出馬！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "今天我帶路！"
    }
  ]
}