  "outfits": [
    {
      "id": 202200,
      "name": "青風結詩",
      "description": "溫迪的裝扮款式。自由隨性的吟遊詩人裝束。",
      "isDefault": true,
      "characterName": "溫迪",
      "characterId": 10000022,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Venti_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#哈…睡得好香呀。欸，{F#妳}{M#你}好呀，旅行者，我們又見面了。嗯？不記得我了？嘿嘿，那就讓我再次加入{F#妳}{M#你}的旅程吧。{F#妳}{M#你}的詩篇，值得被我這個世上最好的吟遊詩人傳唱！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·彈琴",
      "text": "嗯…想接著聽下去的話，送我一個蘋果吧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·蘋果酒",
      "text": "嗯…好想坐在大樹上，手邊有喝不完的蘋果酒。哎。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·詩篇",
      "text": "動身吧，旅行者。佚失的詩篇，還在等著我們呢。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "來踩小水坑吧！看看誰濺出來的水花更大！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "欸~這就天晴了？我還想多玩一會呢。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "等雪積起來…我們來打雪仗吧！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "難得呀，要不要去飛一飛？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早，準備開始新的冒險了嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#咕…肚子餓了，又不敢再去晨曦酒莊蹭飯…啊，是{F#妳}{M#你}呀！欸嘿，要出門嗎？帶我一個吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#我還不睏哦。要我陪{F#妳}{M#你}走走嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "欸？要休息了嗎？嘿嘿，晚安。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於溫迪自己…",
      "text": "練習？哼哼，我當然不需要啦，在這提瓦特就沒有我不會唱的歌。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·新歌",
      "text": "#我想把{F#妳}{M#你}寫進新歌裡！欸，怎麼露出這種表情呀，擔心付不起稿費嗎？哈哈，摩拉就不要了，不如…跟我再講講{F#妳}{M#你}的故事吧！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·勇者",
      "text": "#唔…嗯！嘿嘿，等到勇者救出了{F#王子}{M#公主}，我會第一時間讓全大陸傳唱這首歌謠。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·使徒",
      "text": "夜風涼爽，是適合成為神的使徒的天氣！那麼事不宜遲，快來向我獻上供奉吧？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·請求",
      "text": "#欸，要風神我更加努力一點？那{F#妳}{M#你}是不是也要展示點誠意呢。比如虔誠、熱愛，或者說…"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#欸？好奇我的「神之眼」？喔…喏，給{F#妳}{M#你}。喜歡的話…要我給{F#妳}{M#你}做一個一樣的嗎？嘿嘿嘿。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "Olah！嘿嘿，這是丘丘人打招呼用的話哦。問我學這個幹嘛？哎呀，為了創作，知識面當然越廣越好啊。唔，好像，我還沒嘗試過用丘丘語寫歌呢…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#旅行者，{F#妳}{M#你}見過塞西莉亞花嗎？那是一種只在安靜的山崖頂上默默綻放的白色野花。在我心裡，它就是全提瓦特最美的花。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於琴…",
      "text": "#騎士團代理團長大人…{F#妳}{M#你}覺得她是個怎樣的人？嘿嘿，跟我想的一樣。認真，勇敢，也不乏溫柔。和我一個朋友有點像呢…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "#去跟迪盧克老爺處好關係吧？你想，他家可是有好~多~珍藏的酒啊！嘿嘿嘿，嘿嘿嘿嘿…咦，無論如何不准喝酒嗎？那…就去聞一聞吧，聞一聞！只是聞的話，{F#妳}{M#你}也可以喔。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "#唱歌很好聽的牧師女孩，{F#妳}{M#你}認識嗎、{F#妳}{M#你}認識嗎？…唔，偶像？…啊，握手會？…嗯，專場live？…這樣啊，音樂還真是深奧啊。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於雷澤…",
      "text": "那個奔狼領的白髮少年，哦哦，是嗎，是被狼養大的啊…怪不得呢，他身上的氣息，令人懷念…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於莫娜…",
      "text": "#啊，那位占星術士嗎？這麼說吧，占卜和我的詩歌一樣，都是讓人窮到酒錢都湊不齊的沒用技術呢！欸？{F#妳}{M#你}說占星至少是一項文化傳統，所以不是沒用的？嗚，真失禮啊，那詩歌也一樣有用啊！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於迪奧娜…",
      "text": "#遠近聞名的貓尾酒館特調酒。可是…嗚，會，打，打噴嚏。要不，{F#妳}{M#你}幫我討一杯酒來吧。我肯定會好好感激{F#妳}{M#你}的，一言為定。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "黑土與白堊、宇宙與地層，無垢之土創生原初之人…特徵實在太明顯了，難以忽視呀。這麼危險的古老技術，萬一在城裡失控——嗨，算了，就讓蒙德人自己解決蒙德的問題吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於摩拉克斯…",
      "text": "#{F#妳}{M#你}見過那位老爺子了？他近來還好嗎？欸，變成名叫「鍾離」的普通人了？對他那個死腦筋而言，這應該是不小的改變啊。啊，陪我去見見他吧，帶上這瓶埋在風起地的陳年好酒當作慰問品。啊對了，他現在還強不強，實力還剩幾成啊？我這樣過去，應該不會被打飛吧？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於優菈…",
      "text": "#優菈對酒的品味可是很不錯的。無論夏天、冬天都要喝冰的這一點，在現在的蒙德人裡也算難得啦。感覺能和她成為不錯的酒友。嗯？{F#妳}{M#你}說我編排的勞倫斯家的歌…早已經傳到了她的耳朵裡？哈，那有什麼關係嘛？說不定，我們還能一起唱呢。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於巴爾…",
      "text": "#聽說，{F#妳}{M#你}把那位不可一世的雷電將軍也擊敗了？啊…想當年她作為影武者的時候，就在追求極致的武技了。如今，也一定會借用各種各樣的理由叫{F#妳}{M#你}做陪練吧。嗯嗯，偷偷告訴{F#妳}{M#你}她的弱點吧，耳朵湊過來——是「甜點心」哦！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於布耶爾…",
      "text": "#{F#妳}{M#你}說草神啊，說到草神，就會先想到她那關於「夢境」的權能吧？與我所作的那些詩歌一樣，她所創造的夢境也一樣充滿了浪漫與想像，我們可是很合得來呢。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "#吟遊詩人所擅長的大多是彈奏與演唱，但一位戲劇表演者所需要具備的能力，還遠遠不只這些…下次風花節把芙寧娜請過來一起表演怎麼樣？嗯？{F#妳}{M#你}想讓我聊聊她拯救楓丹的事？有這樣藝術才華的人就算拯救了整個世界，也毫不奇怪吧？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於赫布里穆…",
      "text": "需要一個又一個的人類成為柴薪去對抗漆黑的威脅，這個世界還真是不講情面。但在瑪薇卡的帶領下，他們創造了堪比魔神的成就…嘿嘿，從「她」開始，納塔人似乎一直就是這樣呢。對了，我聽說瑪薇卡很喜歡喝酒對吧？要不然…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於塔利雅…",
      "text": "#旅者，{F#妳}{M#你}想要聆聽風的聲音，尋求風的指引嗎？那麼…去找這位助祭肯定沒錯。哈哈，開個玩笑。{F#妳}{M#你}隨時可以找我一邊喝酒一邊聊天喔！至於我平常拜託塔利雅傳遞消息的原因…{F#妳}{M#你}已經猜到了吧？他熱衷於追逐喧囂的風，卻從來不會失去自己的方向。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於杜林…",
      "text": "又有一位魔女小姐的孩子在蒙德落腳了，真熱鬧啊。這位小朋友看起來很想跟我的一位大朋友一起玩，於是我便做了一些微不足道的引見工作。讓人驚喜的是，大朋友比小朋友還激動，高興得上躥下跳，拍著肚皮轉圈跳舞呢。哎呀，被大朋友聽見了？快快，我們到樹後面躲一躲。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解溫迪·其一",
      "text": "#來得正好，旅行者。我想聽聽，{F#妳}{M#你}的願望是什麼？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解溫迪·其二",
      "text": "#跟{F#妳}{M#你}一起旅行真是件有趣的事，要說美中不足就是{F#妳}{M#你}身邊的那隻小不點了吧。那麼能吃，{F#妳}{M#你}們的伙食費很了不得吧？哈哈。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解溫迪·其三",
      "text": "火之神是個橫行霸道的戰鬥狂，岩之神是個不懂人心的死腦筋。問我怎麼會知道這些？欸嘿，敘事詩裡都寫得一清二楚嘛，他們的故事。那個年代的故事。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解溫迪·其四",
      "text": "天空島啊。連我也不一定飛得到那裡呢。而且在那裡，沒有甜的水，也長不出什麼好吃的果子。就更不會有好酒囉？嘿嘿，所以請我去我都不想去哦。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解溫迪·其五",
      "text": "#我的願望？嗯。以前，我想著要遊歷整個世界。現在也一樣，不過嘛，加上了一個限定條件，那就是跟{F#妳}{M#你}一起。有{F#妳}{M#你}在，才是完整的。記敘者果然要和冒險者在一起才行嘛，嘿嘿！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "溫迪的愛好…",
      "text": "我喜歡酒！還有風！唔，如果能有用風釀的酒就好了。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "溫迪的煩惱…",
      "text": "#其實，只要有貓在附近，我就忍不住會打噴嚏…啊-啊-哈啾！唔…哎呀…就連想一想也不行麼…欸，{F#妳}{M#你}知不知道該怎麼治好這個毛病呀？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#{F#妳}{M#你}也來一個蘋果嗎，剛摘的。啊嗚，啊…又脆又甜，蘋果才是神的饋贈吧！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#欸，{F#妳}{M#你}在做什麼好吃的嗎？欸？熱乳酪餅！這個…這個不行，熱熱的黏糊糊的，唔…對我來說，太膩了…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "啊，好滿足！明天也會有吧？後天也會有吧？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "呼，好飽，連餐後水果都要吃不下了…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "竟然是連我都應付不來的食物。唔…這下可難辦了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "我以前聽朋友說生日是要吃蛋糕的…喏，蘋果蛋糕，給，勺子。烤出來的時候有點塌了，所以看上去像是蘋果派。欸嘿，甜點還真是複雜呀。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "欸！剛剛發生了什麼事！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "辛苦啦。想要來點音樂放鬆一下嗎？隨想曲，還是小夜曲？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "來，坐這邊。我寫了一首新詩哦，就叫它「旅行者之風」吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#唔…明明這些風景早就看過很多遍了，有{F#妳}{M#你}在身邊，卻像是呈現出了不同的樣子。{F#妳}{M#你}該不會…還藏著一大堆奇奇怪怪的能力吧？…唔，那倒也不錯。說明，我看人的眼光很準呀，欸嘿。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "喲嗬——"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "在這喲。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "留意腳下。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "一起來玩吧。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "別想逃開喔~"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "起風囉~"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "飛，比跑快吧？"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "呀嘿~"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "咳咳，請聽一首，「寶箱之歌」！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "嘿嘿，要不要感謝「風神的眷顧」呀？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "收穫不少，可以拿去換幾瓶好酒啦。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "等等，這可不好玩！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "哎呀，別盯著我打呀。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "好過分哪。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "交給我吧。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "還不能放棄哦。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "稍微睡一下吧…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "啊呀，弦斷了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "撲通。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "哎呀…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "好粗魯哦。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "調音完成。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#讓{F#妳}{M#你}久等了哦？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "是要做熱身運動嗎。"
    }
  ]
}