  "outfits": [
    {
      "id": 210800,
      "name": "銀鐺琳琅",
      "description": "藍硯的裝扮款式。沉玉谷的藍氏有佩銀的傳統，藍硯身上的每一樣銀飾都是家人的禮物。當她邁動雙腳行走在山間，滿身銀飾叮鈴作響，如同春燕歡歌。",
      "isDefault": true,
      "characterName": "藍硯",
      "characterId": 10000108,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Lanyan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，我是沉玉谷手工藝工會的藍硯。是想做點擺飾、籃子還是花瓶、家具之類的呢？呃…備用的藤枝藤條不多了，得先去山裡採一趟…{F#妳}{M#你}也想幫忙？嘻嘻，{F#妳}{M#你}人真好，我多送{F#妳}{M#你}一頂藤編遮陽帽可好？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·每日計畫",
      "text": "今天的計畫？嗯…聽隨當下的心意而動。明天也是，每天都是，嘻嘻。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·傳家寶",
      "text": "好的藤器經篾薄如綢，緯條細若絲，經久不壞…說它能跟銀器一樣當傳家寶一點都不誇張。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·燕子",
      "text": "天暖燕子麼搭窩窩，升雷扯閃麼我家躲。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "趕不及躲雨了，那——安心淋雨吧，還省了跑步的力氣。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#嗚哇！借、借{F#妳}{M#你}手握一會！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "看，陽光掃到的地方都鍍上了一層金欸。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "聽見了嗎？我頭上的銀飾叮鈴…叮鈴…風很溫柔呢！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "叮叮叮叮叮——風有點生氣了啊。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "喝點水嗎？嚐嚐我瓶子裡的吧。泡薄荷葉子果然是明智的選擇呢。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "被鳥叫聲吵醒了？哈哈，我去跟牠們商量商量，但不一定奏效哦——牠們有時也不聽我的話。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#採了些很新鮮的花，我這就帶回去給媽媽做好吃的…{F#妳}{M#你}也來嘛，我家裡人見到{F#妳}{M#你}肯定高興！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "夜市裡有碳烤小昆蟲！想一起去嚐嚐嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#我好睏…先睡了先睡了，就不陪{F#妳}{M#你}熬夜了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於藍硯自己·幸福感",
      "text": "幸福感就是…每一口都細嚼慢嚥直到吃完碗裡最後一粒米、躺在草地上聽著耳邊的呼呼風聲睡午覺、不被打擾地看完整整十冊的志怪連載小說！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於藍硯自己·奇門世家",
      "text": "那位萬象風角靈官在藍氏的族譜中確有記載，可我家這一脈早已從宗家分枝散葉了。奇門術法紛繁複雜，我也只是學了個皮毛而已，有很多難題我還要向前輩們請教呢…但唯獨扎藤人的手藝就連爺爺都要向我看齊，哈哈…這能算一種「獨當一面」嗎？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·握手？",
      "text": "#坐好。朋友。握手~\\n啊不不不，我是讓小動物們看我，不是叫{F#妳}{M#你}坐下啦！快請起來…這句話的意思是：「大家看過來哦，今天有一位新朋友跟我們一起玩！」有點難懂嗎？唔…「坐好」可以是「先別動」或者「聽我說」，也可以是「停下來」…規律嗎？哎呀總之{F#妳}{M#你}多來山裡跟我們玩，自然就懂啦。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·握手！",
      "text": "#來呀，握個手，抱一個吧。\\n嗯…？來握手呀？哈哈，這回真的是我想要跟{F#妳}{M#你}握手的意思啦！好朋友之間不是這樣相互鼓勵的嗎？對不起哦，怪我沒有事先說清楚。但也沒關係，我會多去找{F#妳}{M#你}玩——這樣自然{F#妳}{M#你}也懂我，我也懂{F#妳}{M#你}啦。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#感謝神之眼的幫助，我居然能毫不費力地將環刃拋起又穩穩接住…啊，環刃非常鋒利，小朋友切勿模仿！但如果是{F#妳}{M#你}…要上手試試嗎？身要定，臂要穩，手要疾，{F#妳}{M#你}的話一定能做到！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#想吃野蕈真的不能馬虎，許多有毒的蕈子根本吃不得。另一些，則必須在處理的時候加工到位，用油炒熟！如果一頓吃不完，第二頓也要再次炒熟、炒透，很多人就是在第二次中招的！如果吃兩口後看到家裡的雞來找{F#妳}{M#你}借火，或者院子裡的狗喊{F#妳}{M#你}去收衣服了，那麼不要猶豫，趕快叫牠們帶{F#妳}{M#你}去看醫生吧。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "有一回我坐在樹上編小擺飾，伸個懶腰的工夫，剛編的藤製松果就被小松鼠全偷走了！還好後來我用雙倍數量的真松果跟牠們換回來了…東西被拿走是小事，但破壞小松鼠一天的好心情就不好了！忙活了一天採松果，回家發現是假的！唔…說不定還會被別的小松鼠嘲笑呢…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於香菱…",
      "text": "都說第一印象很重要，在萬民堂吃過璃月港的第一頓飯後，我就後悔了——後悔怎麼沒有早點來璃月港，這樣說不定能早點認識香菱！她聽說我老家山裡有許多罕見食材後，忙不迭就開始計劃來沉玉谷的行程了，到時我一定得讓她滿載而歸。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於胡桃…",
      "text": "胡堂主給人感覺總是嘻嘻哈哈的，哪怕在危急的困境中她都沒有忘記說玩笑話來安撫我…我跟她認識的時間不長，她一直都這樣樂觀積極嗎？嗯…不管怎樣，至少從今天開始，祝願她笑的時候是真的很開心，而不是為了不讓身邊的人擔心。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於刻晴…",
      "text": "玉衡大人什麼時候能閒下來呢？海燈節期間看她東奔西跑忙個不停，也沒能找到機會請她吃頓飯，好好感謝她的招待…我還想拜託她幫我梳一對跟她一樣的貓貓耳朵呢…會不會很僭越？但直覺告訴我她不會介意…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於行秋…",
      "text": "#我曾在山林裡偶遇過行秋少爺幾回，他身邊沒有飛雲商會的夥計跟著，看起來不像在辦公事…在那以後他時不時會給我送幾本最新出版的志怪小說，請我幫他保守秘密。完了…我是不是不小心說出來了…這下請{F#妳}{M#你}幫我們倆都保守住秘密啊！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於重雲…",
      "text": "#有一次我跟著爺爺上門占卦，正巧碰到他從事主家中沮喪離開…我本以為屋裡頭的情況不容樂觀，就連他也無計可施了。可我進屋後並沒有感受到任何不妙的氣息，爺爺這邊得出的也是吉卦…興許是他費了大工夫，累到沒力氣說話了——{F#妳}{M#你}說他很可能什麼都沒做？那我就更不懂了…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於嘉明…",
      "text": "我跟嘉明從小就認識，還記得他小時候是家喻戶曉的淘氣大魔王，現在完全看不出來。哈哈，也許這就是成長吧？我也跟小時候不太一樣呢。但有一點他始終沒變——就是走到哪總會帶點好吃的在身上，每次回來都不會忘記給家鄉朋友帶些外地的點心。當然，更不會忘記打包一堆家鄉小吃帶走…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於七七…",
      "text": "#七七姑娘喜歡小團雀對嗎？想用藤皮編一隻送給她…{F#妳}{M#你}知道她喜歡什麼顏色嗎？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解藍硯·其一",
      "text": "#先別說話！稍等一下…馬上…編完這個把手就好…呼…搞定！嘻嘻別見怪，我腦筋比較簡單一次只能做一件事，但現在可以專心跟{F#妳}{M#你}聊天啦。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解藍硯·其二",
      "text": "#要來山裡面玩嗎？可以和柔柔羊玩躲避頭槌，或者讓朱喙鵜鶘扮演大嘴巴強盜，在限定時間內從牠嘴裡解救可憐的玉玉心羽鱸…想玩風行迷蹤？{F#妳}{M#你}當獵手？哼哼，很自信嘛。好吧，要是{F#妳}{M#你}急得打轉，我會搖響銀鈴給{F#妳}{M#你}提示的。摸到我的髮尖就算{F#妳}{M#你}贏，我也是很自信的哦。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解藍硯·其三",
      "text": "我頭上的銀飾是「銀翎翦玉玄鳥」，是家中祖傳的寶貝。銀簪、銀項圈、胸兜墜是爸爸媽媽給我的慶生禮物…哦，銀手鐲是有一年海燈節爺爺送的，銀耳墜好像是逐月節的禮物…還有慶祝我學會用風之翼送的、慶祝我拿到神之眼送的、慶祝我吃了滿滿三大碗米飯送的…\\n呵呵，在我們家族的傳統裡，銀器有避邪解毒、護佑平安的作用，所以家人們總會想著法子給我添置…\\n一套行頭下來的確很沉呢…是沉甸甸又令人安心的愛哦。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解藍硯·其四",
      "text": "小時候家裡放的藤人常常讓我發怵，該怎麼描述好呢…黑黑灰灰的枯草隨便一扎，是小孩子看了就會做噩夢的程度！當時我覺得爺爺一定是中邪了，才把我送去跟宗家的姐姐學害人的法術呢！於是半夜壯著膽子，把能找到的藤人統統燒掉了。好在吸收了病氣的藤人本來就是要被焚毀的，算是沒捅大婁子…\\n從那時我就開始思考，如果把藤人做得可愛一些，是不是就不容易被人誤解成歪門邪術了呢？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解藍硯·其五",
      "text": "#藤編不難的，我真沒騙{F#妳}{M#你}！再怎麼複雜精妙的工藝，也離不開最簡單的一行一豎、一經一緯，只要稍微有點耐心都能編出東西來！比起手藝，更難的是「細心」，再難一些是要有「恆心」——但在我看來這些都不是最關鍵的。要我說最最重要的，是「開心」。要是做起來不開心，什麼事情都做不好的，我講的不只是藤編…總之，要開心呀！我也是，{F#妳}{M#你}也是！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "藍硯的愛好…",
      "text": "之前我特別想要求證溺鬼的傳說，就用棍子伸進鬧水鬼的湖裡…結果棍子真的被抓住了！水下面全是水草！要是下去游泳不被纏住才怪了…\\n我還聽說日落後不要吃日落果，半夜時分不能對著鏡子削蘋果…這裡頭到底有什麼依據呢？唔…"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "藍硯的煩惱…",
      "text": "剪毛刺可真累人啊，既費眼睛又費手…把我十個指頭都扎了個遍…嗚…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "新鮮的花不僅好看好聞，做成糕餅還很好吃！清新不甜膩，再泡上一壺花茶…唔…走吧，一起去採花？不用找花籃啦，去到山裡我現編一個。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "「糖也只在開心的時候吃才甜」——沒心情的話吃什麼都覺得差點意思…嘻嘻，好在這種情況很少發生。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "好吃欸！稍等，我去把珍藏的純銀餐具拿出來，這才配得上這道菜嘛！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "哦，謝謝。這裡有沾醬哦，沾著吃更美味。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#{F#妳}{M#你}嚐過了？肚子疼嗎？眼前有小人在打轉嗎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#按照家裡的傳統，生日嘛，總得收點銀器傍傍身的。喏，這兩個小藤人送{F#妳}{M#你}，頭上有銀燕的是我，{M#拿著小銀劍的是你}{F#戴著花的是妳}。嘻嘻，像不像？\\n藤草我提前熏製過，掛在背包上可以幫{F#妳}{M#你}驅蚊除蟲。小銀飾樣式也是我自己設計的，從銀匠師傅手裡拿回來後又仔細打磨了邊角，絕對不會刮手。\\n那麼，祝{F#妳}{M#你}生辰快樂，願福氣運氣常伴{F#妳}{M#你}左右！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#等等，我才編了兩個結{F#妳}{M#你}怎麼就…是{F#妳}{M#你}太快了還是我太慢了呢…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "銀器要時常擦拭才能煥發光亮，人果然也要不斷磨練才能「身輕如燕」呀。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "握手~握手~握手~還記得嗎？意思是表示開心、表示感謝，表示一切好的事情、好的心情。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#「燕銜泥，莫與齊」…別小瞧我喲，我的實力一路增長，如今要保護{F#妳}{M#你}也算綽綽有餘了吧。哎呀，我知道這有不少{F#妳}{M#你}的功勞在裡頭…很感謝{F#妳}{M#你}！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "翻飛。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "穿織。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "躍風。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "搬疾運厄。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "玄燕傳喜。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "漫卷翩翩。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "可以分我一些嗎？沾沾喜氣。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#好消息！{F#妳}{M#你}快看裡面有什麼？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "別急，我來數數…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "給我點時間…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "有人幫忙嗎？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "難辦了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不能硬撐了，快撤下來！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "換我來吧，他們抓不住我。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "唯獨現在…不能倒下…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "銀鈴…不響了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "飛不起來…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "別。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不對頭！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "脾氣真差！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "去哪都行，不去也行。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "趕街子去囉。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "來啦來啦。"
    }
  ]
}