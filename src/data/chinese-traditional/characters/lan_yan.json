  "passives": [
    {
      "id": "four_sealing_divination_charms",
      "name": "四戈封刀靈卜",
      "description": "元素戰技<span style=\"color:#FFD780FF\">鳳縷隨翦舞</span>的突進命中目標時，如果接觸了<span style=\"color:#80C0FFFF\">水元素</span>/<span style=\"color:#FF9999FF\">火元素</span>/<span style=\"color:#99FFFFFF\">冰元素</span>/<span style=\"color:#FFACFFFF\">雷元素</span>，則會使鳳縷護盾發生元素轉化，轉化後的護盾對於對應元素傷害有250%的吸收效果。<br/>此外，如果這次元素戰技<span style=\"color:#FFD780FF\">鳳縷隨翦舞</span>使鳳縷護盾發生了元素轉化，藍硯向敵人投擲的翦月環將附加原本50%對應元素傷害，該傷害視為元素戰技傷害。",
      "level": 1
    },
    {
      "id": "skyfeather_evilsubduing_charm",
      "name": "蒼翎鎮邪敕符",
      "description": "元素戰技<span style=\"color:#FFD780FF\">鳳縷隨翦舞</span>與元素爆發<span style=\"color:#FFD780FF\">鶤弦踏月出</span>造成的傷害值提升，提升值分別相當於藍硯元素精通的309%和774%。",
      "level": 4
    },
    {
      "id": "thought_and_intent_like_silken_scent",
      "name": "「心隨芳兮意猶綿」",
      "description": "藍硯在隊伍中時，隊伍中自己的角色接近晶蝶等部分生物時，不會驚動牠們。<br/>有效對象可參考圖鑑中「生物誌／野生動物」的「其他」分類。",
      "level": 0
    }
  ],
