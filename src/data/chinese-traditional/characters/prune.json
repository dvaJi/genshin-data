  "outfits": [
    {
      "id": 213200,
      "name": "魔女獵裝",
      "description": "布倫妮的裝扮款式。精心挑選的深沉配色足以彰顯超越年齡的成熟氣質，金屬的綴飾則表達著她對待「魔女」時「冷酷」的內心和手段——至少她本人是這麼認為的。",
      "isDefault": true,
      "characterName": "布倫妮",
      "characterId": 10000132,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Prune_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，布倫妮，魔女獵人。我的敵人是那種以戲耍未成年人為樂、利用他人的幻想朋友編造陷阱、審美浮誇又喜歡佩戴鏤空大帽子的邪惡魔女——或者更準確地說，是巫婆！隨時歡迎{F#妳}{M#你}提供相關情報。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·宣戰",
      "text": "艾莉絲——別躲了！我遲早會找到妳的，給我等著！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·清醒",
      "text": "總愛用玩味的語氣說世界「有趣」的傢伙，往往是喜歡製造混亂的超級大反派。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·冷知識",
      "text": "#{F#妳}{M#你}知道嗎？吞嚥的時候，是沒辦法同時呼吸的。不信{F#妳}{M#你}試試看。哼哼。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "人生的旅途不可能都是晴天，劇本也總會有被淚水打濕的幾頁。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "發抖是人體對突然的巨響產生的正常生理反應，和害怕完全是兩碼事。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "我不冷，不用穿外套。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "陽光是免費的，但又有多少人能夠自在地曬太陽呢？"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "白天熱情如火，晚上冷酷無情…這就是沙漠。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "意志力正在和床談判…不能輸…不能輸…起床！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "專注當下的同時，眼睛也要往前看。所以吃午餐時就該想想晚餐吃什麼。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "這個時間的蒙德城還滿熱鬧的。在挪德卡萊的時候，爸媽總叮囑我晚上出門很危險，所以我經常窩在房間裡看書。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "明天…也要一起冒險吧？不一起也沒關係，隨便。那…晚安。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於布倫妮自己·身分",
      "text": "#每一次我報出「魔女獵人」的身分，總有不明真相的人把我當成正在經歷叛逆期，並且喜歡說怪話的小孩。等等…{F#妳}{M#你}那是什麼眼神？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於布倫妮自己·讀書",
      "text": "大人們都滿沒耐心的。問他們問題，得到的永遠是「小孩子不需要知道那麼多」或者「等你長大就明白了」…呿，無所謂。我自己也能找答案。書本就不會騙人，它們會老老實實地把知識展示出來，讓你自己去判斷和思考。這樣得來的答案，才是真正屬於自己的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·時機",
      "text": "#算起來，我剛從那夏鎮啟程不久，{F#妳}{M#你}就到達挪德卡萊了，真是不巧。不過，也很好。{F#妳}{M#你}當時參與了這麼驚天動地的事件，周圍也都是一些名號響叮噹的同伴，我哪裡擠得進去…咳，我的意思是，我本來就不愛湊熱鬧，現在跟{F#妳}{M#你}認識的時機剛剛好。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·立場",
      "text": "#雖然我沒專門提過，但其實…能有妳在身邊，我真的很高興。妳從來不會把我當成可以敷衍的小孩，總是認真地聽我說話，解答我的問題…\\n我當然知道{F#妳}{M#你}是魔女們的朋友…反正我才沒有「敵人的朋友是敵人」這種老土的觀念。交朋友只需要用真心，跟立場和身分無關，{F#妳}{M#你}、{F#妳}{M#你}覺得呢？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#在我認可的強者名單裡，無一例外都佩戴著這種勳章。現在我也有一枚，所以，哼哼。不過我沒想到的是，{F#妳}{M#你}明明沒有「神之眼」卻還能隨手驅動元素力…所以{F#妳}{M#你}是強者中的強者，例外中的例外。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "「旗艦」有種特調，喝之前要先轉動轉盤，充滿了博弈的刺激感。味道？咳，不知道。每次我剛踮起腳把摩拉拍在吧檯上，那個酒保就會面無表情地指著門口說：「這不是小孩該來的地方，想吃熱狗就去『斯佩蘭扎』吧…」\\n可惡，這是赤裸裸的年齡歧視！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#話說回來，遺瓏堡碼頭有個大升降機…是埠嗎？哦對、對的。不得不提須彌雨林裡有種可愛的小東西了，當地小孩叫它們那那羅。欸…我當然知道叫蘭那羅啊！那什麼…至冬的話…{F#妳}{M#你}去過了嗎？哈咳！小時候我還在那拍過不少畫片，有機會我帶帶{F#妳}{M#你}吧。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於艾莉絲·巫婆",
      "text": "#我無意挑撥{F#妳}{M#你}們的關係，但基於「資訊透明」原則，我有義務向{F#妳}{M#你}揭露她的惡劣事蹟。這個邪惡魔女，總拿一些連史萊姆都能解開的謎題來挑釁我，又纏著要跟我辯論兒童組的題目，還都輸給了我！氣急敗壞的她露出巫婆的真面目，公然放話把德斯卡戴抓走了，要我來蒙德找線索！聽聽！這是人話嗎？這不亞於她跟{F#妳}{M#你}打七聖召喚，完敗後還要把派蒙抓走！換作是{F#妳}{M#你}，{F#妳}{M#你}也會成為一名魔女獵人的。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於艾莉絲·心理戰",
      "text": "一開始我也在想為什麼偏偏是蒙德？而不是把我拐騙到更危險的地方去？後來我明白了，這是一種心理戰。越是危險的境地，獵人的感官會愈加靈敏。但在蒙德…哼，這裡的空氣裡飄蕩著懶散的酒精味和不切實際的詩歌。她想用這種所謂的「自由」氛圍來腐蝕我的意志，讓我變成一個只會一邊喝下午茶，一邊幫貓梳毛的廢人！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於艾莉絲·絕不原諒",
      "text": "#跟德斯卡戴重逢後，我知道這個事件背後藏著一些善意的謊言…但一碼歸一碼，動機的「善」，絕不能掩蓋手段的「惡」！本質上，她就是在享受整個耍我的過程——{F#妳}{M#你}沒看見嗎？每次我氣急敗壞，她笑得有多開心！那發自肺腑的笑正是她惡趣味的證明。總之，我不會原諒她，絕不。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於可莉…",
      "text": "我承認一開始接近她只是為了套情報。畢竟她是艾莉絲的女兒，肯定知道很多魔女的秘密吧？沒想到可莉根本沒有防備，總是邀請我一起玩。有一次她神秘兮兮地說要送我禮物，看著她亮晶晶的雙眼…我突然就…就有點…\\n算了算了，我不是被收買了。只是覺得偶爾陪她玩玩也不耽誤我的計畫。對，就是這樣。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於早柚…",
      "text": "在這個年紀，「能睡則睡」是最聰明的選擇。畢竟…看看那些被工作和焦慮填滿的大人吧，哪怕是一個不用依靠酒精或煉金藥劑的安穩覺，都已經是奢侈品了。趁現在還能毫無負擔地閉上眼，就讓她睡吧。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於瑤瑤…",
      "text": "瑤瑤的手很巧，有好幾次我的髮帶鬆了都是她幫我綁好的，我自己一定綁不出這麼完美的結，所以睡覺都沒捨得拆——沒想到醒來還是亂了！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於七七…",
      "text": "我買了很多糰子牛奶送她，小魔女的茶會上她說過愛喝嘛。好、好幾個人的份？因為買一送一啊，我也想帶一些稻妻特產回蒙德喝。呃…主要是給可莉喝，對，給可莉，我喝茶。不加糖的。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於派蒙…",
      "text": "#悄悄問{F#妳}{M#你}哦，派蒙在須彌教令院的學籍是怎麼申請的？入學考試難不難？{F#妳}{M#你}覺得她會願意跟我分享學習資料嗎…什麼？{F#妳}{M#你}說派蒙還有名師一對一輔導？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "#這個事情我只跟{F#妳}{M#你}說，{F#妳}{M#你}要答應我別告訴其他人哦。我懷疑阿貝多先生…根本不是人！世界上真的會有這麼完美的人類嗎？唔…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於凱亞…",
      "text": "聽完我的計畫後，他建議我把德斯卡戴升級為重裝騎兵單位，並當場為我簽發了一張《特種騎獸駕駛資格證》…但這張證在我手裡還沒拿熱，就被琴團長以違章發放為由強制收回了，理由居然是——「兒童駕駛屬於危險駕駛」…哼。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於莫娜…",
      "text": "我曾經把她錯認成魔女B了，給她製造了一些麻煩…都怪艾莉絲！她說魔女B的名字裡有「梅姬斯圖斯」幾個字，哪知道她故意沒說最關鍵的「崔斯」兩個字啊！而且莫娜的尖頂大帽子，完全符合「魔女」的刻板印象…還好，她已經接受我的道歉了。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於麗莎…",
      "text": "又是一位尖頂大帽子女士，這位更是有著「薔薇魔女」的稱號。而答案越是顯眼，就越要謹慎了…每次她用慵懶的語調，笑眯眯地叫我小布倫妮的時候，我的獵人直覺都在瘋狂警告——不管她是不是真正的魔女，都不好惹。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於菲謝爾…",
      "text": "她絕不是那種沉溺於幻想的人，恰恰相反，我認為她是蒙德城裡極少數的清醒者。那些華麗的辭藻不過是用來對抗這個殘酷世界的武器。我能不能聽懂她的話？當然不能。但這不影響我對她的高度肯定。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於愛諾…",
      "text": "我在叮鈴哐啷蛋捲工坊跟她學習了三天，從最基礎的打螺絲開始。我在天才機械師的專業指導下，改造了從艾莉絲那裡贏來的錘子和鈴鐺，洗去原本的低齡童話感，賦予了它們重金屬工業風的全新外觀，視覺威懾力整整提升了百分之三十！"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於多莉…",
      "text": "我跟她的運貨商隊繞了好幾個國家才來到蒙德。其實她還有專門的乘客護送服務，耗時更短座位也更舒服，可是收費只能用無法無天來形容。哼，商人！\\n奇怪的是，按照利益至上的原則，遇到襲擊時那些價值連城的貨物才該是主要保護對象，但領隊大叔喊的是：「保護小孩！這是老闆下的死命令，少一根頭髮全隊扣錢！」沒道理啊？我只付了一點點運費…除非，她的算盤裡，還有比摩拉更重要的東西。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解布倫妮·其一",
      "text": "#是不是想問家住哪、爸爸媽媽是誰、怎麼能自己出遠門、想不想家…這一路上，已經有數不清的大人問過一樣的問題了。沒關係，我可以再複述一遍——{F#妳}{M#你}想知道的不是這些？等等，給我一分鐘！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解布倫妮·其二",
      "text": "德斯卡戴是我的幻想朋友，大概在我四五歲的時候吧？爸媽都忙著做生意，沒空陪我。有一天，我在想像一隻會說話、很聰明、能陪我討論問題的狗，然後…牠就出現了。雖然只有我看得見，但牠一直都在，比任何人都可靠。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解布倫妮·其三",
      "text": "「幻想」並不等同於「虛假」。對我來說，德斯卡戴的存在具有絕對的真實性。我們之間早就屏棄了語言這種低效的溝通方式。牠只用一個眼神，或者一聲深沉的鼻息，就能精準地指出我邏輯推演中的漏洞。這種靈魂共振級的交流，是需要極高默契門檻的。只要有牠在我身邊就夠了，就算沒有其他朋友也沒什麼大不了的。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解布倫妮·其四",
      "text": "…好吧，小魔女會的確改變了我，原來被人需要、被人關心是這種感覺。在挪德卡萊的時候，我總覺得自己是個旁觀者，但在小魔女會，我是不可或缺的一員。這種感覺很好，非常好。我必須要守護這個組織，不讓任何人破壞它。你滿意了吧？我都說到這份上了，別告訴別人啊…尤其是可莉她們！"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解布倫妮·其五",
      "text": "#等小魔女會發展壯大後，我們要改寫魔女世界的規則。不許隨便開幻想朋友的玩笑、不許用「考驗」的名義整人、不許對小孩子玩心機。總之要建立一個正義、善良、友愛的新秩序！艾莉絲她們這代魔女太隨心所欲了，是時候讓年輕一代接手了。嗯？笑吧笑吧，等小魔女會成為提瓦特最強組織的時候，{F#妳}{M#你}得給我道歉。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "布倫妮的愛好…",
      "text": "這本《素論派元素力使用手冊》雖然過期了八十年，但基礎理論還算扎實。我在上面做了大量批註，修正了一些過時的觀點，還加入了自己的戰術推演。呵呵，艾莉絲絕對想不到，隨手給我的東西最後會變成刺向自己的刀！"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "布倫妮的煩惱…",
      "text": "這撮頭髮又翹起來了！每天早上都要跟它鬥智鬥勇，我怎麼壓它怎麼翹，簡直像是在挑釁我…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "烤肉味的糖雕、酸味的煙燻魚排、豆腐味的薯餅…越是想像不出來的味道，越是讓人在意。這很正常吧？有些東西聽起來是不太對勁，但吃過一次，就會明白它們為什麼會被記住。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "「斯佩蘭扎」的熱狗。無關口味，純粹是尊嚴問題。無可否認它的確滿香的…但我還是恨它！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#我一直覺得《料理圖鑑》上都是經過美化後的圖片，沒想到{F#妳}{M#你}真的能做出一模一樣的菜！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "嗯…雖然比上不足但比下綽綽有餘。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#快說，{F#妳}{M#你}是不是被魔女詛咒了？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！不必太驚訝，「生日日期」這種情報很好收集，難不倒我。但最關鍵的「生日願望」我還沒有打聽到…\\n說出來就不靈了？我不同意。這會讓那些想幫{F#妳}{M#你}實現願望的人…譬如我，無從下手啊！直接一點吧——{F#妳}{M#你}想要什麼？別小看我，我存了不少零用錢，而且{F#妳}{M#你}不是也經常誇我懂得很多嗎？說不定我真的能幫上忙呢！\\n但…{F#妳}{M#你}應該不會許那種「在蒙德城中心零貸款買房」之類的超綱願望吧？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "嗯，元素反應更穩定了。看來，不只是理論成立。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "書上沒寫到這一步…不過，我記下來了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "原來保持清醒不一定要把幻想排除在外，我會同時抓住它們。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我還是不太相信那些虛假的童話，也不怎麼相信這個世界。但我會相信{F#妳}{M#你}，也請{F#妳}{M#你}相信我吧。哪怕{F#妳}{M#你}覺得我還是個小孩，那也是小孩裡的大小孩，可靠的厲害的大小孩。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "命中。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "別動！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "逃？"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "吃錘！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "我來！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "哪裡逃！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "制裁開始。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "鈴聲為引。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "錘印確認。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "寶箱這種東西，果然對任何年齡都很有吸引力。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "哼哼，區區尋寶遊戲。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "喂喂！噓…這裡也有！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "反擊才剛剛開始！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "有本事等我歇好再戰！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我說過，不會認輸。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我能幫上忙的！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "只是戰術性撤退，不丟人。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "德斯卡戴快跑…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我一定會回來的…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "到底…為什麼…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "不痛。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "繼續。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "痛！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "停——"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "魔女獵人，就位。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "先聲明，我不玩扮家家酒哦。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "搞定，出發吧。"
    }
  ]
}