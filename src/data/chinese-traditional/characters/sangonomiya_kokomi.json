  "outfits": [
    {
      "id": 205400,
      "name": "珊骨粼波",
      "description": "珊瑚宮心海的裝扮款式。以海祇島所產靈寶點綴的尊貴衣裝。",
      "isDefault": true,
      "characterName": "珊瑚宮心海",
      "characterId": 10000054,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Kokomi_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是珊瑚宮心海，海祇島的「現人神巫女」。此次與{F#妳}{M#你}一起出行，就當做是放鬆一下…咳，就當做是對外考察吧。不用擔心，臨行前我留下了不少錦囊，將海祇島近期的發展計畫安排完畢了。稍微離開一會兒，也沒有關係。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·閱讀",
      "text": "八重堂出版的許多作品，深入淺出地闡明了兵法原理，我很喜歡。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·游魚",
      "text": "每個生靈的意志都值得尊重，就像海中的游魚，也有自己的方向。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·準備",
      "text": "未雨綢繆，才能臨危不亂。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨中行軍，可以隱蔽聲息，但對體能卻是很大的考驗…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "雪…真漂亮呀。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "天色真好，一起走走吧？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "嗯…這麼大的風，正適合用火攻之計。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安。我剛剛讀到一段有趣的兵法，要一起研究一下嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "下午的作戰方案要進行一些修正，這樣可以保證更高的效率。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#嗯？這麼快就到晚上了？跟{F#妳}{M#你}在一起，時間總是會過得格外快。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "好好休息，養精蓄銳。晚安。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於珊瑚宮心海自己·錦囊",
      "text": "戰場局勢千變萬化，一念之差就可能葬送全局。所以在開戰前，我會將所有情況納入考量，寫成錦囊交給將士們去執行。不過目前來看，他們對錦囊有些過於依賴了。我還是希望他們多讀些兵書，靠自己的力量辨析戰場的局勢，這樣才能更好地抓住戰機。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於珊瑚宮心海自己·放鬆",
      "text": "真希望這次作戰快點結束。八重堂出版的新印《沉秋拾劍錄》已經可以買到了，好想待在房間裡一口氣看完…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·見聞",
      "text": "#母親曾教導過我，只有眼界開闊，才能成為合格的領袖。不過以前的我常年往返於珊瑚宮與軍隊之間，不曾親自出來冒險，難免會有許多不懂的地方。嗯，這些就請{F#妳}{M#你}多擔待啦。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·困惑",
      "text": "#都說人心難測，但作為現人神巫女，我必須努力去理解每個人的想法才行。就從{F#妳}{M#你}開始吧，旅行者，讓我猜猜…{F#妳}{M#你}現在在想些什麼呢？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "在我眼中，「神之眼」便是願望的象徵。我們之所以成立反抗軍，反對眼狩令，就是因為願望是非常寶貴的東西，不該被輕易放棄，更不該被強行剝奪。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·刊物",
      "text": "#八重堂出版的刊物中，我尤其喜歡這本《提瓦特戰爭藝術》。{F#妳}{M#你}看，上面記錄了許多經典戰役，以及兵法名家對此的解析。其中有幾篇我特別欣賞，讓我來唸給{F#妳}{M#你}聽…"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什麼想要分享·潛水",
      "text": "#水下的世界雖不如陸地上明亮，但每次待在那裡時，心都會慢慢沉靜下來。魚群在遠處游動、水母在身旁起舞，讓人不知不覺就會放下所有煩惱。有機會的話，我帶{F#妳}{M#你}去看看吧？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "我很喜歡海祇珊瑚真珠，它為海祇島帶來了許多財富，是大海給予我們的饋贈。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於五郎…",
      "text": "#五郎是不可多得的優秀將領。他真誠、堅毅、果敢…能夠與部下同食同寢，也能夠提出許多出人意料的作戰方案。但他也有一個小小的缺點，就是在戰鬥中容易亢奮上頭。如果{F#妳}{M#你}和他一起行動的話，一定要在關鍵時候拉住他。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "不得不承認，九條裟羅是一個難纏的對手。雖然她很少使用計策與謀略，但她在正面戰場做得很好。幕府軍對她非常信服，在她的帶領下團結一致、悍不畏死，曾經幾度給反抗軍帶來了巨大的威脅。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於八重神子…",
      "text": "八重宮司的許多事蹟，我也有聽說過。平心而論，我認為她是一位非常優秀的巫女，至少在「巫女」的本職上，她做到了無可挑剔的程度。聽說她還負責八重堂輕小說出版事宜，真是個難以捉摸的人…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "眼狩令結束之後，海祇島也回歸了正常的生活。時至今日，我已經不想去評判將軍的對錯，我更在意的是海祇島的未來。我希望將軍能夠信守承諾，我們與幕府相安無事。但若是有一天，將軍再次無視民眾的願望，那我們也絕不會坐視不管。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於北斗…",
      "text": "當時與北斗一同伏擊幕府軍的時候，我也曾提出過「擔心幕府軍事先察覺」的擔憂。不過北斗對我說，她的船隊令行禁止，能夠悄無聲息地發動奇襲，事實證明果然如此。如今我們海祇島的船隊在訓練時遇到了瓶頸，我倒真想請她來指導一番…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於楓原萬葉…",
      "text": "萬葉曾在反抗軍待過一段時間。印象裡，他跟五郎的關係很好，兩個人經常並肩作戰。萬葉性格灑脫，不喜歡被約束，但身處軍隊的時候，他又會嚴格遵守各項紀律。在我看來，他不僅劍術高超，性格也非常成熟。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於鹿野院平藏…",
      "text": "#剛開始的時候，我非常詫異有人公開穿著天領奉行的制服來海祇島。如果他是天領奉行的武士，就不該這麼魯莽；如果他是天領奉行的間諜，又不該這麼招搖。不過接觸過一段時間之後，我發現這位自稱是「偵探」的鹿野院先生，對海祇島的軍事佈防、政務商貿都不感興趣，倒像是來旅遊的。所以我只是加派了一些人手盯著他，並沒有趕他離開。如果{F#妳}{M#你}見到他的話，倒是可以跟他聊上幾句。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於夢見月瑞希…",
      "text": "瑞希小姐的能力與才藝有目共睹。我曾想請她出任顧問，協力我一同發展海祇島的各式文化專案。但幾次交談過後，我便明白瑞希小姐的目光放眼在整個稻妻。我期待能夠早日見證她的成就，如有任何需要，海祇島也隨時歡迎她的到來。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解珊瑚宮心海·其一",
      "text": "越是情況緊迫，越要穩住心態。如果連我也陷入不安的話，其他人要怎麼辦呢？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解珊瑚宮心海·其二",
      "text": "據說我們的祖先曾經生活在海底的淵下宮，是魔神奧羅巴斯將他們帶到了地面上。我常常會猜想，海底的宮殿會不會很黑呢？每次想到這裡，我就會備加珍惜眼前的光亮。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解珊瑚宮心海·其三",
      "text": "#劍魚二番隊的士兵們，在{F#妳}{M#你}離開後也推選出了臨時隊長，但大家還是希望{F#妳}{M#你}能回去。我也只能跟他們說，{F#妳}{M#你}有一個重要的任務要獨自完成，暫時沒辦法回來。有機會的話，{F#妳}{M#你}可以去看看他們，他們想必會很歡迎{F#妳}{M#你}的。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解珊瑚宮心海·其四",
      "text": "其實很早以前，我並不想成為現人神巫女，只想每天讀讀兵書，做一個幕僚。這樣就可以把自己隱藏在幕後，身上的擔子也會減輕不少。不過最後還是事與願違，畢竟血脈這種東西，是沒辦法違抗的…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解珊瑚宮心海·其五",
      "text": "#成為現人神巫女之後，我也慢慢習慣了這樣的生活。起碼當我看到不合理的事情時，我有力量去改變它。更重要的是，我因此和{F#妳}{M#你}相遇了不是嗎？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "珊瑚宮心海的愛好…",
      "text": "#喜歡的事情？我想要找一個安靜的地方讀兵書，讀一天都不會有人來打擾的那種。如果{F#妳}{M#你}想跟我一起研究兵法的話，我也是很歡迎的。不過…{F#妳}{M#你}得睡地板。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "珊瑚宮心海的煩惱…",
      "text": "我其實，並不擅長與人交流。雖然也可以端起「現人神巫女」的架子來應付，但對我來說，這是一件很消耗能量的事情。一旦能量用盡，我也會露出消極的一面。那種形象肯定不能被外人看到啦，民眾需要的是一個完美的海祇島領袖，而不是一個喜歡宅在家裡的小女生。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "鳥蛋壽司，是我很喜歡的一道料理。它材料常見、做法簡單，很適合在軍中普及。雖然在戰事激烈的時候，吃上一頓鳥蛋壽司也是一種奢侈，但絕大部分時間裡，這種樸素的料理能給士兵們帶來許多滿足。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#嗯…非要說的話，我不太喜歡跟魚有關的料理。不過這個還請{F#妳}{M#你}幫我保密啦，漁業在海祇島的占比很重，如果讓民眾知道我不喜歡魚料理的話，他們說不定會有一些奇怪的擔心。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "嗯，真好吃！能量似乎也…不、沒什麼…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "分幾口慢慢吃的話，幸福感也會持續得更久吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#嗯，{F#妳}{M#你}給我出了一個難題呢。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！今天有什麼安排了嗎？沒有的話，我們一起在海祇島慶祝吧。早晨我帶{F#妳}{M#你}去看日出，白天一起去潛水，晚上的時候在珊瑚宮散步。如果下雨的話，我們就找個地方讀兵書，然後一起去嘗試做蛋糕。總之今天{F#妳}{M#你}不用多想，交給我這個「軍師」來安排就好啦。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我雖然並不崇尚武力，但能夠變強是一件好事。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "力量在不斷地湧出…想必下次作戰，我們可以配合得更好。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "滄海月明，潮起潮落。力量更進一步，心境也會有所不同。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#曾經，我也時常會陷入自我懷疑之中。像我這樣的人，真的可以勝任現人神巫女的職位嗎？不過現在，我已經很少再去想這些了。與{F#妳}{M#你}在一起的時候，任何困難都可以迎刃而解。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "幫幫忙！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "別擔心。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "休養生息。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "滄海之約。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "翻湧吧！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "深海的加護！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "我們走吧。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "風景真好。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "補給可是頭等要事。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "要好好規劃一下如何使用。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嗯，這就是冒險的樂趣…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "好累…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "需要變更戰術。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "謹慎為上。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "援軍已至！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "請到後方休息。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "計策…出問題了嗎？"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "失誤了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "不會再犯同樣的錯誤。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "失策！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "真難纏…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "這次的作戰…讓我想想。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "別緊張，我們一定會贏。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "萬事俱備，出發吧。"
    }
  ]
}