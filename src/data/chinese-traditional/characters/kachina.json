  "outfits": [
    {
      "id": 210000,
      "name": "橙峰螺岩",
      "description": "卡齊娜的裝扮款式。戴上堅固的手套、穿上耐磨的靴子，「烏沙博蒂」的卡齊娜已經做好面對挑戰的準備。",
      "isDefault": true,
      "characterName": "卡齊娜",
      "characterId": 10000100,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Kachina_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好啊，我是「回聲之子」的卡齊娜。喜歡吃顆粒果，想要變強，不擅長打架。啊…不是說這些的時候？那、那…請問{F#妳}{M#你}接下來想去哪裡走走？我滿熟悉這一帶的，就讓我來帶路吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·整理癖",
      "text": "啊…我剛剛發現有塊磚塊沒有堆整齊，怎麼辦？現在感覺心裡有隻小龍在不停地抓啊抓。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·行不行",
      "text": "我可以、我不行、我可以、我…唔唔，沒事的，我可以的，一定沒問題的…對吧？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·收藏品",
      "text": "無聊的話，要不要一起來看看我包包裡的收藏？看上什麼拿走也沒關係哦。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨水會讓泥土變得鬆軟，所以雨天挖礦一定要比平時更加更加小心哦。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "呀——啊…我、我不是害怕，只是被嚇了一跳而已。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#我們一起去雪地上打滾吧，嘿嘿。{F#妳}{M#你}放心，我不會像阿尤一樣，鑽到雪裡又突然冒出來嚇{F#妳}{M#你}的。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "快看這塊寶石！在太陽的照射下，裡面好像藏著彩虹。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "這下面會不會藏著金光閃閃的礦石？要不要挖挖看？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早啊，我已經整理好背包了，我們隨時可以出發。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#我不睏，但如果{F#妳}{M#你}想午睡一下的話，我可以幫{F#妳}{M#你}把風。雖然我有許多不擅長的事情，但…我的耳朵還算靈敏，遠處的風吹草動我都能夠感覺到。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#瑪拉妮邀請我晚上去山洞試膽，我我我…好緊張，怎麼辦？我不想拒絕朋友，就…就閉上眼睛答應了…不、不管發生什麼事情，我都應該和她一起面對。欸？{F#妳}{M#你}也會一起來嗎？太、太好了！嗚…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#今天怎麼又把事情給搞砸了，嗚嗚嗚…怎麼辦，明明不想哭的，但眼淚完全停不下來了，嗚嗚…噫——剛、剛剛我們不是互相說了晚安，要去睡覺了嗎？但謝謝{F#妳}{M#你}安慰我…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於卡齊娜自己·沖天轉轉",
      "text": "這個名字是我和阿尤一起取的。我先想好了前半部分，又根據阿尤的動作定下了後半。我常常會乘著它和阿尤比賽跑步，我們各有輸贏哦。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於卡齊娜自己·死亡",
      "text": "#能在「巡夜者戰爭」中死去，對納塔戰士們來說是一種榮光，身為其中一員的我也不該例外…但當時我一邊這樣告訴自己，一邊在心裡害怕得要命…{F#妳}{M#你}們冒著巨大的危險從夜神之國把我帶回來，我真的非常感激！嗚嗚，謝謝{F#妳}{M#你}們每個人…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·傳說",
      "text": "#納塔流傳著很多英雄傳說，其中我最喜歡的就是陶奧魯大人的事蹟，居然能以血肉之軀把深淵給封入地下，實在太厲害了！對了對了，{F#妳}{M#你}走過了那麼多國家，一定也知道很多傳說故事吧？我真的很好奇…有空的時候可以和我講講嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·小禮物",
      "text": "#來挑一個{F#妳}{M#你}喜歡的吧！作為我們是好朋友的證明。我能收集到的最好看、最閃亮的礦石全都在這裡了，如果{F#妳}{M#你}願意選一顆收下的話，我會很開心的！"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "在我第一次看到這枚亮晶晶神之眼的時候，我還以為自己眼花了，這比我看過的任何一塊石頭都還要閃亮。雖然我現在與那些傳說中的英雄相比還差得很遠，但如果有一天我的故事也能激勵別人——哪怕只有一個人也好——那也會成為我最大的幸福…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "阿尤是我很重要的夥伴，別看牠現在模樣乖巧，牠再小一點的時候，表達喜歡的方式是衝過來用頭撞人。牠力氣很大，有時候我都會被牠撞到摔倒，不過這也沒辦法嘛——畢竟嵴鋒龍是一種很親人的龍。欸，不要撞我啦，阿尤，好好好，我不講了啦。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "澄晶實的果實形狀就像寶石一樣，如果它也能像寶石一樣長時間存放就好了…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於瑪拉妮…",
      "text": "#瑪拉妮是我的第一個好朋友。遇到她之前，我都不知道這個世界上有這麼好的人，還有這麼多好玩的事情。看，這是我們合影的畫片。她說是要在合影時一起往上跳…{F#妳}{M#你}說我動作看起來有點僵硬？嘿嘿…被{F#妳}{M#你}發現了…當時鏡頭外有很多人在看著我們，讓我有點緊張…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於基尼奇…",
      "text": "#基尼奇哥哥還是瑪拉妮介紹給我認識的呦。不瞞{F#妳}{M#你}說，一開始我有點害怕他，因為他的眼神看起來…稍微有一點凶。我後來才知道他私底下教訓過欺負我的壞蛋，但在我送他回禮的時候，他又不肯收下，說是已經得到足額的報酬了…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於恰斯卡…",
      "text": "她是納塔有名的「調停人」，據說任何爭鬥都能被她輕鬆擺平。她會這麼做，恐怕是像我一樣很討厭人與人之間起什麼衝突吧…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於伊安珊…",
      "text": "之前為了變強，我拜託伊安珊帶我訓練。她安排了各式各樣高強度的鍛煉方式，我常常需要咬緊牙關才能堅持下去。好在她幫我安排的訓練量非常精準，每次結束後都有留下讓我走回家的體力…我還是很感謝她的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於茜特菈莉…",
      "text": "#瑪拉妮和我說了，{F#妳}{M#你}們能救出我還要多虧了她的發明。「靈覺髓石」會壞掉，我也有不可推託的責任…後來我鼓起勇氣去找她道歉了，並且讓她在我收藏的石頭裡挑幾塊，她撓著頭說：「這…我不挑一個是不是很麻煩啊？拿個差不多的我們就不相欠了是吧？」最後只拿走了最不起眼的一塊黑曜石，就揮了揮手叫我走了。{F#妳}{M#你}覺得我要不要再幫她找點什麼？她喜歡什麼{F#妳}{M#你}知道嗎？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於希諾寧…",
      "text": "在我獲得古名後，帕加爾叔叔帶我去找希諾寧姐姐，請她幫我打造沖天轉轉，她的手藝簡直出神入化。\\n後來我們不僅交流了寶石收藏與保存的經驗，還欣賞了彼此的珍品。她的收藏品狀態非常好，一定照顧得十分細膩，但她自己的生活…似乎要更加隨性？有一次我找她找很久都沒有找到，最後發現她在一棵大樹上曬著太陽睡著了…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於火神大人…",
      "text": "我做夢都想不到，居然有一天能被火神大人親口認可為「納塔的英雄」。火神大人是每一位納塔戰士的偶像，我…我得到了偶像的…嗚…我一想起來就太感動了，嗚嗚嗚…對不起，對不起對不起，不該在這時候哭的…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於伊法…",
      "text": "伊法哥哥是個很厲害的龍醫生！凡是給他看過病的小龍，回來後都作息規律、不亂吃亂跑，幾乎沒再生過病了。所以每當大家發現有龍身體不舒服，第一反應都是請他飛過來看一看。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解卡齊娜·其一",
      "text": "「烏沙博蒂」是我的古名，它的意思是堅強。唉…可是很多時候我都想不通為什麼這個古名會給我——我那麼弱小，不管是在家裡還是在部族裡存在感都不算高…有那麼多優秀的人在身邊，我真的有擁有它的資格嗎？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解卡齊娜·其二",
      "text": "要說我家人的話…我在家中排行第二。我知道爸爸把期許主要寄託在姐姐身上，而媽媽現在又要照顧年幼的妹妹。我們的生活有些辛苦，所以我需要管好自己，早點長大…至少讓爸爸媽媽少操點心。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解卡齊娜·其三",
      "text": "帕加爾叔叔待我很好，部族裡其他人議論我的時候，他總會幫我說話。其實…他那樣做，我心裡反而過意不去，我只有靠自己的實力贏得大家認可才可以啊…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解卡齊娜·其四",
      "text": "#我一直知道，流淚並不能解決任何問題。傳說故事裡，我從來沒聽過有英雄會在大家面前哭。我很想忍住眼淚，但我總是失敗…欸？{F#妳}{M#你}說沒關係？流淚是一種很重要的發洩方式？{F#妳}{M#你}…{F#妳}{M#你}真的這樣想嗎？嗚嗚嗚…謝謝{F#妳}{M#你}，嗚…我怎麼又哭了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解卡齊娜·其五",
      "text": "我之前一直覺得自己很弱小，被人忽視也是理所當然…但聽到大靈女士那番話之後，我不再那樣想了。「烏沙博蒂」是我的古名，我…已經決定要變成更好的「自己」。這個世界上一定有我才能做到的事，我會…繼續努力。希望這塊黑曜石有朝一日也能容納我的事蹟，成為一顆…更加璀璨的寶石。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "卡齊娜的愛好…",
      "text": "#這塊是我第一次挖出來的寶石，翠綠翠綠的，很好看吧？最初它們是一對，另外一塊我送給瑪拉妮了。{F#妳}{M#你}看，這個花紋像流水一樣。對了，還有這塊，別看現在是黑色的，放在太陽下面就會有五彩斑斕的感覺…嘿嘿，這些全都是我一塊一塊收集起來的。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "卡齊娜的煩惱…",
      "text": "之前瑪拉妮送了我一頂很大的帽子，太酷了，還能完美地遮住太陽，我真的好喜歡。但戴著戴著，就變成一頂氈帽了…後來我只能換成現在這頂不會黏毛的帽子。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "粒果片片是我的最愛，要是能堆得整齊一點，那就更加完美了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "欸？分量這麼大嗎？但、但我吃不完的話，不就浪費了廚師的勞動成果嗎？唔唔…沒關係…我一定可以吃完的！小口小口慢慢吃…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "哇——真的是送給我的嗎？太好吃了！我要慢慢吃，讓美味停留得更久一點。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#又香又好吃，擺盤也很精緻。如果有「廚藝戰爭」的話，{F#妳}{M#你}一定會贏吧！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#謝謝{F#妳}{M#你}願意為我花時間！我、我一定會吃完的，請再多給我一點時間。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！這個送給{F#妳}{M#你}，是虹閃石雕成的鼠兔。虹閃石的觸感溫潤，但在地下很不起眼，一不留神就會錯過…不過帶在身邊越久，它的光澤就會越來越漂亮的。這是我最喜歡的寶石之一，希望{F#妳}{M#你}也喜歡。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我的耳朵在抖嗎？不是緊張…而是開心。對不起，它們現在激動得不得了，我控制不住。我…我捂住它們吧…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#{F#妳}{M#你}真的非常重視我…嗚…呃、我沒有想哭的，就是太感動了…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "「王庭焚棄，火卻未曾殄熄。明晨將要再度燃起，比昨日更為輝熠。」——這是陶奧魯大人說過的話中，我最喜歡的一句。我、我必須要努力才行…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#{F#妳}{M#你}帶我一起見識了種種新奇的事物，讓我成長了很多，我不知道該怎麼回報{F#妳}{M#你}才好…但這次我想自己找到答案，接下來就讓我來當英雄吧，保護{F#妳}{M#你}的英雄！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "旋轉！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "嘿——喲！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "來了！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "開轉囉！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "衝地波！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "沖天轉轉，出發！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "清退！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "礦石採集。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "切勿靠近。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "哇哇，有亮晶晶的石頭！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#{F#妳}{M#你}也喜歡收集石頭嗎？我懂我懂，這些石頭太好看了。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "需要幫忙整理嗎？我很拿手！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "沒事，小傷罷了。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我要…振作起來。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我、我一定可以的！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不要忘了還有我啊！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我在！交給我吧！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "對不起，是我逞強了。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "不能愧對…「烏沙博蒂」…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "嗚…又搞砸了嗎…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "擦傷而已。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "唔…不要緊。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "嗚哇？我可以參加嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "太好了！一起動身吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#又能向{F#妳}{M#你}學習戰鬥技巧了。"
    }
  ]
}