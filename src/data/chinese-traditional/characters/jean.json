  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#「蒲公英騎士」，琴，申請入隊。從今往後，我的榮譽與忠誠將與{F#妳}{M#你}同在！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·行動",
      "text": "行動起來吧，我們不該在這裡停留。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·騎士團",
      "text": "騎士團的大家…有沒有認真工作呢？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·目標",
      "text": "走吧，前往下一個目標！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "下雨也無法阻擋我的腳步。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "這樣的天氣，正適合行動。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "下雪了，要注意戰靴的保養啊。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "舒適的天氣。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "傳說，那天也颳著罕見的大風…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "「一日之計在於晨」，今天也請加油。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "好，現在開始處理任務吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "看樣子，差不多已經對咖啡免疫了。如果有什麼替代品的話…問問麗莎好了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#今日的修煉就到此為止，做得很棒，辛苦{F#妳}{M#你}了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於琴自己…",
      "text": "今天為了保護民眾，把五座遺蹟守衛斬成了碎片。唉，我還需要繼續磨練自己…這麼珍貴的文化遺產，下次應該嘗試空手制伏…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·信條",
      "text": "#我會全力幫助{F#妳}{M#你}，當然，如果{F#妳}{M#你}的方向偏離了正義，我也會毫不猶豫地指出。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·誓言",
      "text": "#我以此劍起誓，必將勝利獻給{F#妳}{M#你}。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·任務",
      "text": "任務可是不會自動完成的，但適當放鬆一下也好。今天就破例午休幾分鐘吧。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「永護蒙德」是古恩希爾德家族的家訓。每當驅動「神之眼」，我都會想起母親、還有蒙德民眾的期盼。為蒙德而戰，為自由而戰——我，在所不辭。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#我謹代表西風騎士團，向{F#妳}{M#你}為蒙德所做的一切致以謝意。還請{F#妳}{M#你}勞逸結合，量力而…怎麼了，{F#妳}{M#你}突然笑了起來，我說了什麼奇怪的話嗎？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "「蒲公英，蒲公英，跟風一起，到遠方去吧。」…它乘上風，說不定連天空島都能飛到呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "芭芭拉非常努力，只不過有時過於勉強自己…嗯？問我為什麼瞭解得這麼清楚？因為西風教會也歸屬騎士團管轄。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於麗莎…",
      "text": "麗莎，有她在的話，我會安心很多。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於安柏…",
      "text": "安柏這段時間確實有所成長。希望有朝一日，她的事蹟也會被吟遊詩人傳頌。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於凱亞…",
      "text": "#是嗎…凱亞也向{F#妳}{M#你}提出建言了啊。他是一名優秀的西風騎士，這點毋庸置疑。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於可莉…",
      "text": "雖說玩樂是孩子的天性，但可莉中意的玩具卻都是些危險品。讓人難以放心。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "「天才」這種名詞，或許正是為了阿貝多這樣的人準備的吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "#法爾伽大團長，他是西風騎士團的當代傳奇。等到他凱旋歸來的那一天，就請{F#妳}{M#你}親自和他交談吧。相信{F#妳}{M#你}也能從中受益。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於諾艾爾…",
      "text": "諾艾爾，嗯…那個努力想要成為西風騎士的少女。她的內心仍有軟弱之處，現在這個階段，也許還不適合讓她接觸外界的兇險。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於蘿莎莉亞…",
      "text": "蘿莎莉亞修女總是把「麻煩」掛在嘴邊，實際卻十分稱職。上次我和她說「如果覺得麻煩也可以找我幫忙」，她卻回答「這樣更麻煩」。嗯…我果然還有很多欠缺啊。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於迪盧克·愧歉",
      "text": "迪盧克前輩對騎士團的指摘事出有因，即使心中愧疚也無法改變既定的結果…我只想通過我的努力，讓他對騎士團有所改觀…嗯，這是我的責任。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於迪盧克·敬重",
      "text": "迪盧克…是一位非常可敬的前輩。雖然我們選擇的道路不同，但這份共通的守護蒙德的心意，我能感受得到。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於砂糖…",
      "text": "作為煉金術士，砂糖也算天賦異稟。況且她的身邊還有阿貝多指點，未來應該不用擔心。只是…不，沒什麼，沉浸在自己的世界裡，也不算壞事吧。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於優菈…",
      "text": "優菈？咳…請不要對她的身世耿耿於懷，西風騎士會公正地評價每個人。優菈明辨是非、才華出眾，偶爾發表危險言論也只是她的性格使然。哪怕她總是說要挑戰我，我也不介意。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於米卡…",
      "text": "大團長選中米卡作為遠征隊的主要前偵，不僅是出於任務需要，更是看中了他踏實勤懇的品質。從我個人角度而言，我也很榮幸能與這樣的同伴共事。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解琴·其一",
      "text": "我肩負著西風騎士團的信任，還有蒙德民眾的期待。為此，我不能鬆懈。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解琴·其二",
      "text": "溫妮莎的「蒲公英騎士」之名傳承至今，曾經有無數偉大的騎士獲授這一榮譽。我不能辱沒這個名字。因此，絕不能鬆懈。要成為守護眾人的堅盾與利劍。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解琴·其三",
      "text": "無論是傳奇故事還是史書，都只記載了偉大騎士的功績。難道，他們一次也不曾迷失過嗎…？\\n風啊，請指引我前進的道路。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解琴·其四",
      "text": "全身心投入工作的時候，煩惱和時間會一併被忘卻。「妳是最適合做這種事情的人選。」…那個時候，大團長法爾伽就是這樣對我說的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解琴·其五",
      "text": "#與{F#妳}{M#你}同行時，前進的道路變得無比清晰。就好像，終於有人能依靠，這究竟是…\\n不，一定是我還不夠努力。絕對不能鬆懈，不能辜負西風騎士團和蒙德…但是，謝謝{F#妳}{M#你}。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "琴的愛好…",
      "text": "#或許可以和{F#妳}{M#你}聊聊書上那些英雄傳記。嗯，{F#妳}{M#你}聽說過「坎瑞亞英雄王」的故事嗎？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "琴的煩惱…",
      "text": "假如有什麼神奇的藥劑，喝了就不需要睡覺…嗯，要不明天問問麗莎吧？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "貓尾酒館的披薩…很久沒吃過了。如果能外送到辦公室就好了呢。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "優秀的騎士不能挑食。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#不僅味道好，還兼顧了健康。讓{F#妳}{M#你}費心了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#嗯，精神振奮不少。謝謝{F#妳}{M#你}。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#呼…總之，辛苦{F#妳}{M#你}了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天是值得慶祝的日子。要說為何的話，因為這是受風護佑的{F#妳}{M#你}，誕生的日子啊。既然是生日，那就好好休息一下吧。\\n咳咳…祝{F#妳}{M#你}生日快樂…\\n啊，請原諒我的冒昧。不知這份禮物，是否能令{F#妳}{M#你}滿意呢？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "好，一鼓作氣前往下一個目標。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "只要風不停歇，我就不會停下腳步。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "就算暫時獲得了平靜，也不能掉以輕心。身為代理團長，我必須未雨綢繆。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我做得還不夠好。自從與{F#妳}{M#你}相遇，一直承蒙{F#妳}{M#你}的關照。這份感激…\\n風啊，請容許我的私心。並非作為代理團長，只是作為「琴」，在此起誓——我的劍將與{F#妳}{M#你}同在。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "一決勝負！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "…哈！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "…散！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "風，回應我吧"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "以劍為誓！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "風之神，請指引我們"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "驚喜的收穫。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "嗯，真是幸運的一天。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "希望大家都能獲得寶藏。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我，沒事…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "還有同伴…需要保護…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "還不能放棄…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你受傷了…請暫時退後吧！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "讓我來吧。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "蒙德…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "個人的力量是有極限的…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我…還不夠稱職…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "這點傷而已！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "隨時可以出發。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "已做好萬全準備。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "聽憑風引。"
    }
  ]
}