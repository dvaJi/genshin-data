  "outfits": [
    {
      "id": 210200,
      "name": "飛魚、熱浪和月亮貝",
      "description": "瑪拉妮的裝扮款式。瑪拉妮本想將所有魚兒的樣子做成飾品掛在身上，但這個方案因為過於新銳被服裝店婉拒。現在的設計雖已大大簡化，不過依然十分有個性，便於委託人在人群中辨識出這位熱情的嚮導。",
      "isDefault": true,
      "characterName": "瑪拉妮",
      "characterId": 10000102,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Mualani_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#旅行者，歡迎{F#妳}{M#你}參加本次旅行，我是「流泉之眾」的嚮導瑪拉妮，有什麼需求請隨時伸長手臂向我示意哦！現在請收好武器，保管好隨身物品，在身前抱緊派蒙，最最重要的是放下煩惱，踏上我為{F#妳}{M#你}準備的鯊鯊衝浪板，站穩啦——美妙之旅要開始囉！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·出來玩",
      "text": "#「出來玩」最重要的就是「出來」，只要{F#妳}{M#你}來了，剩下的全都交給我來安排吧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·逐浪",
      "text": "#{F#妳}{M#你}有試過追著海浪奔跑嗎？想試嗎？要試嗎？就現在就現在！我陪{F#妳}{M#你}找片海。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·團結",
      "text": "一個人挑戰有很多不可能，但一群人就能挑戰很多不可能！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "喲吼！濕滑的地面好適合滑進場哦！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "哇哦！劈哪了劈哪了？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "呃…做完正事就趕緊回去泡溫泉吧…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "想原地躺下曬太陽，曬完一面再翻個面。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "風越大，浪越大，正是挑戰高難度動作的好時候！"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "在沙子上衝浪一定很刺激吧！「流泉之眾」的瑪拉妮，來挑戰囉！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "好消息，今天沒有睡過頭！獎勵我自己吃頓超豪華早餐吧。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "啊，果然還是起太早了嗎…不行不行，眼前在閃摩拉，中午要補個眠…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#需要送餐服務嗎？保證讓{F#妳}{M#你}吃進嘴的時候還是燙的，相信我衝浪板的速度。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "糟糕…在篝火晚會上跳舞跳太興奮了，今晚鐵定睡不著了…嗚…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於瑪拉妮自己·鎮店之寶",
      "text": "店裡上架的商品從種類、品質到功能和顏色，全都是我精心挑選過的。但要說我心目中的鎮店之寶，就不得不提這件「豚豚泳裝」了。水性不好的朋友一定要考慮它，它可以瞬間充氣變成固定在身上的救生豚豚球，這樣游泳就安全多了！\\n就算不游泳的時候也可以穿哦，我喜歡穿去參加派對，非常吸睛！就像這樣彈來彈去…彈來彈去…\\n順帶一提，配色也是好運款！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於瑪拉妮自己·舞蹈",
      "text": "#「流泉之眾」是最好的度假勝地，這裡的草木山川似乎能和大家產生共鳴，成為我們的朋友！\\n湧動的波浪、搖曳的海草、飄擺的樹葉…它們全都是我崇拜的舞蹈老師。跟著它們的節奏和律動，搖一搖，扭一扭，轉個圈，甩起來！怎麼樣？不要愣在那啊，{F#妳}{M#你}也一起來試試看嘛！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·招呼",
      "text": "#看看衝浪板吧！有各種材質和花紋，顏色也很多哦！{F#妳}{M#你}的幸運色是什麼？沒有嗎？那我幫{F#妳}{M#你}挑一塊好了。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·互相託付",
      "text": "#一起去過夜神之國，也並肩遙望過神秘島的光芒，我們早就是可以互相託付生命的夥伴了。如果哪天{F#妳}{M#你}在旅途中突然找不到方向，一定要告訴我！我可是超級厲害的嚮導，就算用衝浪板撞也會幫{F#妳}{M#你}撞出一條路來！"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "有段時間我把「神之眼」掛在豚豚球身上，海水一般的湛藍色怎麼看都很配。但後來和朋友玩排球的時候我完全忘了這回事，豚豚球掉在沙灘上，發出非常清脆的一聲「吭噹」，呼…竟然沒摔碎，這一定是好運的預兆！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#{F#妳}{M#你}害怕小狗嗎？不怕的話就請和我們家的小狗交朋友吧！牠很喜歡跟人玩，不管見到誰都要跑上去打招呼，盼望被人摸。哦對了，我們經常一起去玩水，牠已經學會衝浪了，不愧是我的好狗狗，青出於我勝於我！\\n有機會介紹你們兩個認識，牠那尾巴啊，一定會甩成螺旋槳。{F#妳}{M#你}要當心不要被甩到了，還滿痛的，哈哈。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#在「流泉之眾」鰭游龍跟我們一樣喜歡溫泉。很多時候，牠們還會跟我們泡在同一個池子裡。如果不確定面前的小傢伙脾氣是好是壞，最好先保持距離。\\n{F#妳}{M#你}問我怎麼判斷鰭游龍的脾氣？哈哈，我的方法很簡單——慢慢地靠過去，一點點試探。不咬人的話代表脾氣滿好的…要是被咬了…就當是親密接觸囉？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於瑪薇卡…",
      "text": "#火神大人是納塔最備受敬仰的頭號人物，我很崇拜她，不僅因為她是火神大人，更因為…她衝浪的樣子真的很帥！\\n我邀請她參加過水上競速…嗯？{F#妳}{M#你}好奇我們的輸贏？那{F#妳}{M#你}先和我比一場吧，{F#妳}{M#你}贏了我我就告訴{F#妳}{M#你}！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於卡齊娜…",
      "text": "卡齊娜說話會考慮很多，個性又很溫和善良。明明很出色，卻因為不爭辯而被周圍的人看輕。唉…我從不懷疑她的實力，唯一擔心的是她不夠有自信，容易聽信那些抨擊她的話…所以除了鼓勵她，我還要把她的優點告訴其他人，相信總有一天大家會做出改變的！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於基尼奇…",
      "text": "阿喬一天講的話比基尼奇一年的話還多，在這種情況下，基尼奇居然不受一點干擾，總能做出自己的判斷，這還滿不容易的。回想起來，好像只有在聊運勢話題的時候，他們才會出奇一致地呈現出一副漠不關心的態度…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於恰斯卡…",
      "text": "我小時候就跟恰斯卡見過面，我們還因為爭奪玩具之類的原因打過幾次架…在得知她成為「調停人」之後我還滿意外的。聽說有的人是慢慢長大的，有的人就蛻變得很快——我的成長期…是不是還沒到啊？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於茜特菈莉…",
      "text": "#茜特菈莉奶奶絕對是「煙謎主」最最資深的祭司，不是小前輩不是中前輩，是一等一的大前輩！她替我預測過的事情都超靈驗的。很久之前她說我在生意上的幸運色是粉色和藍色，果不其然，現在店裡銷量最高的就是粉色和藍色搭配的豚豚球。\\n最近我去纏著她——哦不，探望她，她還提到有一個外來者能夠為我帶來吉兆…等等，欸——{F#妳}{M#你}不就是外來者嘛！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於伊安珊…",
      "text": "伊安珊不僅是「沃陸之邦」的驕傲，更是納塔的驕傲。她參加過好多回「歸火聖夜巡禮」，至今都保持著全勝戰績！我還報了她的訓練班，培訓費早就交了，只是…只是一直在忙沒空去訓練…\\n好吧，我承認…有次看到卡齊娜接受完訓練的樣子，我心裡就浮現一個聲音：「唉呀我擅長的都是一些水上活動，在陸地上活動太久是會擱淺的…」嗯，我要尊重內心的建議。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於希諾寧…",
      "text": "#連火神大人都認可的工匠實力毋庸置疑，就算古名變得稀碎，她也絕對能夠修得天衣無縫吧？啊！我剛剛是不是說了很不吉利的話？這麼重要的東西怎麼能弄碎！呸呸呸，剛剛我什麼都沒說，{F#妳}{M#你}也什麼都沒聽到，好嗎？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於伊法…",
      "text": "伊法這個人很上道的！無論叫他出來玩什麼他都樂呵呵的，而且做什麼都又快又俐落。要不是因為他已經做了醫生這一行，我倒是滿希望他能來當水上運動教練的。部族差異？小意思啦，根本不成問題！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於夢見月瑞希…",
      "text": "#{F#妳}{M#你}的人脈還滿廣的嘛！瑞希是我們「流泉之眾」的朋友，雖然模樣看起來很文靜，但她有很多話可以聊的。無論什麼話題她都能輕鬆接住，然後和人一直聊下去…嘿嘿，有時候和她聊著聊著都會忘記時間…\\n哦對了！她在我們這裡的分店最近要開張了，有空的話也來替她的店捧捧場吧？我為她帶了紫色的豚豚球作為開業禮物，希望她喜歡！"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於瓦雷莎…",
      "text": "瓦雷莎…哦！瓦雷莎！那個力氣超大，但卻不擅長比賽的好妹妹？之前伊安珊還帶她來我們這裡特訓游泳！她休息的時候喜歡躺在沙灘上看漫畫織卷，我也跟著蹭了幾本！她能數出很多古代勇士的名號，包括我們「流泉之眾」的戰士，有的連我都記不太清了！真厲害啊！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解瑪拉妮·其一",
      "text": "#{F#妳}{M#你}有空嗎？來我家邊坐邊聊？邊泡溫泉邊聊也不錯！還是說{F#妳}{M#你}有想去的地方？我都可以。機會難得，留影機我都帶了，動作我也可以先做示範。放心，今天我們一定能夠拍出有趣的合影！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解瑪拉妮·其二",
      "text": "嚮導是一門很依賴經驗的工作，好在先祖們為我們留下大大小小的寶貴習俗，讓我們可以少走彎路。不過放心，我不會一股腦就只照老規矩啦，我遵守的都是我已經試過，也行之有效的習慣。\\n有哪些行不通的？嗯…就譬如說有次我想去探索一個新地點，眼前明明有橋，地圖卻說需要划船渡河到對岸。我又是測水流，又是檢查橋上有沒有機關和隱患的…最後終於發現先祖沒推薦走橋是因為——那時候根本沒有這個橋嘛！\\n啊…嚮導果然很依賴經驗啊…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解瑪拉妮·其三",
      "text": "我很喜歡接待外地來的遊客。每次結束導覽後，他們都會感謝我介紹了納塔的風土人情，而我也會感謝他們。謝謝他們一路上跟我分享見聞、聊自己的家鄉，還有我聽都沒聽過的奇聞軼事…對我來說，這同樣是一場不可多得的心靈之旅。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解瑪拉妮·其四",
      "text": "#雖然我會盡量用大家都能接受的方式交朋友，但…呵呵…有時候也會有人委婉地告訴我，我太熱情了反而不好招架…所以現在我在剛認識新朋友時都會收斂一點，熟了再熱起來…\\n哦，如果{F#妳}{M#你}跟我相處過程中有任何不愉快的地方，請不要猶豫，也不要有心理顧慮，直接告訴我！不想當面說，寫個匿名紙條也可以哦！我一定會改正的！"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解瑪拉妮·其五",
      "text": "面對困境，每個人都有巨大潛能，參加過「歸火聖夜巡禮」後我無比認同這一點！但我依然覺得「兩個人」總比「一個人」有更多選擇，「三個人」又比「兩個人」更有贏面…所有人團結一心，一定能夠創造不可思議的奇蹟！\\n就拿「巡夜者戰爭」來說吧，不僅是現在的我們，還有世代以來保衛納塔的英傑們，以及此後繼續為之奮鬥的後輩們，所有的努力累積起來才會有越來越好的納塔。我想，這就是「沃摩延」的意義吧…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "瑪拉妮的愛好…",
      "text": "游泳、跳水、滑水、衝浪、水上拖曳傘、沙灘排球、划船、潛水、水上排球還有水下憋氣…唉呀，我喜歡的運動用豚豚球的手都數不過來。玩累了我就躺在水上休息，有好幾次都睡著了，舒服是舒服，但代價就是醒來後不知道漂到哪裡去了，被部族裡的長輩訓了好久…"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "瑪拉妮的煩惱…",
      "text": "不開心的時候我會告訴自己：「唉呦，沒關係的，運勢不太好而已，這只是糟糕的一天，不是糟糕的一生。」心情就能慢慢調整過來。要是還是沒用，我就會乘著遊隙靈道在高速的彎道上痛快地放聲呼喊，幾次來回下來煩惱就被甩在身後了，根本追不上我。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "那種盤子一端上來沒有一點蔬菜，也沒有禽肉和獸肉的純海鮮大餐。吃上一口就像栽進海裡一樣，化作一條小魚游來游去…唔…太滿足了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#我還滿後悔小時候偷偷把牛奶倒進溫泉裡的，不然我應該還能夠再長高一點…沒關係，我答應過阿伽婭阿姨再也不會那樣做了！現在我會好好喝牛奶的，長高還來得及！{F#妳}{M#你}也是哦，我們都要引以為戒哦！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "怎麼會這麼好吃！美味程度讓人想要踩著衝浪板翻轉三圈…不落地那種！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "還有嗎還有嗎？這個放在派對上絕對會被一掃而空。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "要不要試試看用溫泉泡一下？那樣口感更好哦！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！禮物請等一下再拆吧。我特意選了這家人氣最旺的餐廳…朋友的祝福{F#妳}{M#你}一定收到不少了，但如果說能請旅途的有緣人一起幫{F#妳}{M#你}慶祝，{F#妳}{M#你}想要體驗一下嗎？\\n嘿嘿，請坐請坐，請接受大家給{F#妳}{M#你}的祝福吧。咳咳——打擾一下，大家請看向我！今天是我朋友的生日，就是這位實力超群、品格高尚，擊退過最凶猛的巨獸，也治癒過最纖細的靈魂的大英雄！可以請在場的大家送給{M#他}{F#她}最美好的祝福嗎？來，這邊的朋友跟我念：「祝{F#妳}{M#你}——尋寶好運氣！」好，那邊的朋友——「戰鬥不費力！」很好，最後大家一起——「生日快樂，健康幸福！」"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哦喲，正是我想要的！那就不客氣啦。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "手勁在咻咻咻往上升，想來一場精彩激烈的沙灘排球友誼賽嗎？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "運勢來了…我有手感！現在完全可以征服上次打翻我的巨浪了，事不宜遲，現在就去挑戰。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#為了旅客的安全，通常我會阻止他們去危險的地方。但我知道{F#妳}{M#你}有不得已的情況，也免不了主動踏入危險境地，所以為了{F#妳}{M#你}的安全，請讓我一路陪著{F#妳}{M#你}肩並肩克服這些險境吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "起乘！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "甩尾。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "加速囉！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "喲呼！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "超棒！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "浪來囉！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "巨浪——嘩啦嘩啦。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "飛瀾鯊鯊！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "看我看我！祝你好運！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "快跑。"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "#需要借{F#妳}{M#你}我的衝浪板嗎？"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "我就說今天是幸運日吧！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "好東西總是壓箱底。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "唉呀掉地上了，快撿起來。希望不要影響財運…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我還要保護我的旅客。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "今天的運勢不太好…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我會贏…我會贏！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你不是一個人在戰鬥！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "過分，換我來揍他！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "嚮導怎麼能掉隊…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "「我們不會孤軍奮戰」…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "終點是…回家…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "好了好了。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "別太過分！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "我的衝浪板——"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "哇，這個組合，贏定了！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#{F#妳}{M#你}好{F#妳}{M#你}好，全體隊友都好嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "嗚呼！衝衝衝。"
    }
  ]
}