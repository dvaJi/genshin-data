  "passives": [
    {
      "id": "featherfall_judgment",
      "name": "落羽的裁擇",
      "description": "在<span style=\"color:#FFD780FF\">聖儀·煟煌隨狼行</span>的啟途誓使狀態下時，賽諾將間歇性處於「末途真眼」狀態下。在該狀態期間施放<span style=\"color:#FFD780FF\">秘儀·律淵渡魂</span>時，將觸發「裁定」效果，使此次秘儀·律淵渡魂造成的傷害提升35%，並向前方發射3道渡荒之雷，造成等同於賽諾攻擊力100%的<span style=\"color:#FFACFFFF\">雷元素傷害</span>。<br/>渡荒之雷造成的傷害視為元素戰技傷害。",
      "level": 1
    },
    {
      "id": "authority_over_the_nine_bows",
      "name": "九弓的執命",
      "description": "基於賽諾的元素精通，提高自身以下攻擊造成的傷害值：<br/>·啟途誓使狀態下的普通攻擊：元素精通的150%。<br/>·突破天賦「落羽的裁擇」的渡荒之雷：元素精通的250%。",
      "level": 4
    },
