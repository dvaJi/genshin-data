  "outfits": [
    {
      "id": 207100,
      "name": "衡斷之心",
      "description": "賽諾的裝扮款式。體現大風紀官威嚴與公正原則的裝束，由於頭部的飾物是應賽諾本人要求特別訂製的，做工複雜，需要定期維護。",
      "isDefault": true,
      "characterName": "賽諾",
      "characterId": 10000071,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Cyno_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面·過往",
      "text": "#我是賽諾，曾經的「大風紀官」。如今我正在以自己的力量審判罪惡，若{F#妳}{M#你}同樣心繫規則與正義，我可以助你一臂之力。"
    },
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面·如今",
      "text": "#我是賽諾，教令院的「大風紀官」。維護規則、審判罪惡是我的職責，今後的旅途中，我會保護好{F#妳}{M#你}的安全。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·秤重",
      "text": "善與惡，最終都會被秤量。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·牌運",
      "text": "運勢會左右某一場對決的勝負，但不會一直影響下去。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·疑惑",
      "text": "偶爾我也想緩解一下氣氛，但我其實分不太清什麼笑話能夠引人發笑。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "又下雨了…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "在一些傳說中，雷電是神明對人間降下的審判。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "我很喜歡下雪後的世界，安靜卻並非一片死寂。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "陽光終會照進每一個角落。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "好大的風…小心。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "熟悉的風景…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "打起精神，該出發了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "需要我準備午飯嗎？事先說好，我可不保證好吃。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#還記得我跟{F#妳}{M#你}說過的話嗎？夜晚總是伴隨著危險，無論做什麼都不要放鬆警惕。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。一些罪犯在附近活動，我去處理。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於賽諾自己·冷笑話",
      "text": "#有一個旅人在沙漠中口渴無比，於是祈禱自己遇到一隻水史萊姆，沒想到一隻餓著肚子的水史萊姆也在祈禱自己遇見落單的旅人…嗯？{F#妳}{M#你}那是什麼表情，不好笑嗎？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於賽諾自己·散步",
      "text": "我偶爾會去夜晚的沙漠散步，寒冷而乾澀的風讓人頭腦清醒。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·決鬥",
      "text": "#要打一局「七聖召喚」嗎？給{F#妳}{M#你}看看我的新牌組。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·此刻",
      "text": "過去無法更改、未來無法預料，所以我很珍惜眼前的時光。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "憑依在我身上的非人之物也好、將視線投射於我的魔神也罷，我受神明青睞，但我無意為此而改變自己的道義。我只盡我應盡之責、做我應做之事。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·求知欲",
      "text": "「欲望氾濫就會引發災害」，這似乎已經是一種共識。然而提及「求知欲」的時候，人們卻往往只願意談論它的正面作用…在我看來，求知欲也是欲望的一種，必須加以控制。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·敬畏心",
      "text": "在執行任務時，我的任何一個判斷都可能會改變他人的命運。所以我必須要求自己時刻對「風紀官」這個職位保持敬畏——就像我敬畏知識與力量一樣。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "我喜歡生長在沙漠中的那些灌木。沙漠象徵著歸寂，一切文明都會被風沙掩埋。但就在這片荒涼的土地上，卻能見到生命不斷萌發的跡象，有時連我也會被它們的堅韌震撼。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於提納里·知識",
      "text": "提納里和我見過的其他學者不同。他對知識同樣有著很深的執著，卻始終不會逾越那道紅線。有些學者會將自己視為「實驗室中的神明」，但提納里不會，他一直平等地尊重每一種生命。聽說他拒絕了教令院的聘請，我也站在他這一邊。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於提納里·笑話",
      "text": "提納里曾勸我不要在餐桌上講笑話，說是根本笑不出來。我不以為然，連講了三個壓箱底的笑話，並逐一解釋了笑點…然後我的飯菜涼了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於柯萊…",
      "text": "我曾經幫她封印了體內的魔神殘骸，但封印的過程給她帶來了很大的痛苦。那種程度的痛苦可能比死亡更讓人害怕，她能夠堅持下來，很了不起。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於艾爾海森…",
      "text": "我不太喜歡過於聰明的人，他們總是自認為能掌控一切，從而經常在危險的邊緣遊走。不過艾爾海森還算穩定，在絕大部分場合，他確實有掌控局面、化險為夷的能力。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於卡維…",
      "text": "提納里和柯萊沒有親口說出來，但他們之間的眼神交流已經說明了一切。卡維分享的親身經歷比我準備的笑話有趣多了。我的看法？我覺得他們會為這種事情發笑，反倒是滿好笑的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於納西妲…",
      "text": "評價神明…這在我看來是略微有些僭越的事情。不過在同行的那段時間裡，我也親眼見證了她的智慧、勇氣與決心。相較於那些只靠臆想就對她指指點點的賢者，我應該更有資格下這個結論：她是一位優秀而值得尊敬的神明。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於妮露…",
      "text": "我能從她身上感到對舞蹈的熱情與執念，這股執念非常堅定，不會輕易改變。希望以後，她也可以用自己熱愛的舞蹈為他人帶去快樂。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於琺露珊…",
      "text": "我曾仔細翻閱過記載琺露珊前輩失蹤的案卷，那時候我懷疑她進行了某種危險的研究…不過與她見面之後，我就徹底打消了這個念頭。雖然相處起來有些困難，不過她就像一位喜歡碎碎唸的長輩，心裡會為他人著想，不會做什麼脫序的事情。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於麗莎…",
      "text": "麗莎和我曾向同一位賢者求學，我自然知道她的事。身為大風紀官，我也見過許多過分追求知識而引發的悲劇，所以能理解她的選擇。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於賽索斯…",
      "text": "賽索斯很有責任感，他作為戰士的能力我絕對認可，也欽佩他的勇氣，他還幫了我很多。有他在，教令院與緘默之殿的合作一定會更順利。\\n不過我覺得他身上還有一個缺點——就是牌打得太少了。每次見面我都會邀請他打幾局，但他總有事在身——要吃飯了、有事要辦、要去見朋友…全是藉口！他在須彌城最熟的朋友不就我們幾個嗎？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解賽諾·其一",
      "text": "#{F#妳}{M#你}問關於我的事？也是，畢竟在很多人眼中我是一個無法忽視的「麻煩」…不用擔心，只要{F#妳}{M#你}不做什麼危險的事情，我就不會找{F#妳}{M#你}的麻煩。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解賽諾·其二",
      "text": "以此身為容器，可以令非人之物的力量顯現。這既得益於先天的體質，也是一種後天的交易。沒什麼可避諱的，我以風紀官的身分秤量世間的罪惡，自然也要把我自己的靈魂放到審判之秤上一同秤量。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解賽諾·其三",
      "text": "#比起「為什麼做」，我更看重「做了什麼」。因為這個世界上有成千上萬種理由，有時{F#妳}{M#你}聽到那些理由，會覺得做了錯事的人情有可原，甚至覺得旁人對他們太過苛責。劣勢方總是容易引起別人的同情，但審判者卻要摒棄這種情緒。情有可原，但罪無可赦。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解賽諾·其四",
      "text": "在幽暗的無知之海上，偶爾會泛起微光，吸引著不明真相的人靠近。常有人視其為燈塔，卻看不到漆黑的海水中隱藏的巨大危險。將久居在黑暗中的人帶離光明的指引，本身是一件殘酷的事情，但我不得不這麼做——直到未來有一天，我們能夠戰勝海水中潛藏的敵人為止。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解賽諾·其五",
      "text": "#我判斷有價值的資訊，已經如數分享了，{F#妳}{M#你}還在期待聽我說什麼？哈…{F#妳}{M#你}的好奇心真是不簡單，那就由{F#妳}{M#你}提問吧。習慣了審問別人之後，這種被人詢問的感覺…也算新奇。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "賽諾的愛好…",
      "text": "閒暇的時候，我會和其他人打幾局「七聖召喚」。這種建立在規則之上，卻又充滿靈活變通的遊戲，在我看來更像是一種藝術。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "賽諾的煩惱…",
      "text": "前段時間，我看到了一本來自稻妻的輕小說。小說以「七聖召喚」為主題，裡面的主角被逼入絕境的時候，忽然從卡組中抽到了一張原本不存在的卡。我深受震撼，同時也陷入困惑：透過對卡組進行特殊操作，創造出讓人摸不著頭腦的奇蹟，這究竟是打破了規則，還是也算規則的一部分？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "大米與肉類、乾果混合，加酪乳進行烤製，不同的香味會混合到一起。敲開焦脆的外殼，香味就會隨著蒸騰的熱氣一同冒出來。製作起來也不會花太長時間，是我很喜歡的菜餚。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "在沙漠中行走的時候，帶的乾糧通常堅硬無味，習慣之後就沒有什麼討厭的東西了。非要說的話，跟蟲子有關的食物還是有些難以接受…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#味道很好，勞{F#妳}{M#你}費心了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "我收下了，多謝。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "給我的嗎？是不是搞錯了？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#嗯…先祝{F#妳}{M#你}生日快樂。雖然沒有太多慶祝的經驗，不過想到是{F#妳}{M#你}的生日，我還是提前做了一些準備。首先是一套我研究了幾天後得到的卡組組合，風格和{F#妳}{M#你}比較契合。另外我調整了這段時間的安排，{F#妳}{M#你}有什麼想去的地方嗎？我可以陪{F#妳}{M#你}一起去。雖然生日只有一天，但放鬆還是需要盡興，行程安排在三天內即可。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我能感受到新的力量，這是變強的證明。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "審判罪惡，維護規則。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#不錯的提升，多謝{F#妳}{M#你}了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "力量已達頂峰，然而僅靠這一身武力，仍舊有許多做不到的事情。人情與規則許多時候相互衝突，如何更好地兼顧，我會在今後的旅途中尋找答案。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "束手就擒吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "徒勞的掙扎。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "你無處可逃！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "裁決已至。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "該定罪了。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "償還罪業！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "以此身…肅正萬象！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "判決，如期降臨。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "秤量，你的罪孽。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "應得之物。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "貴在恆心。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "財富累積，成為文明的基石。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "威脅程度…比預想中要高。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "差不多也該習慣了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "咳…再來！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "去休整，別逞強！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我來替你。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "輪到我了嗎…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "覆滅…新生…終而復始。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "審判，失敗了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "無用的掙扎。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "真難對付。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "有兩下子。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "我會盡我所能。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "行動開始。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "這次的目標是誰？"
    }
  ]
}