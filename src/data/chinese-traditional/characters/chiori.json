  "outfits": [
    {
      "id": 209400,
      "name": "拈來山吹虹",
      "description": "千織的裝扮款式。由千織本人親自設計裁製的優雅裙裝，製作精良，具備鮮明的稻妻特色。千織曾身著此套衣裝登上時裝評論雜誌扉頁，以其獨特美學成為席捲楓丹時尚領域的領軍人物。",
      "isDefault": true,
      "characterName": "千織",
      "characterId": 10000094,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Chiori_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#我叫千織，「千織屋」的老闆。有服裝訂製類需求的話，歡迎找我。其他需求，就看{F#妳}{M#你}有沒有足夠用來交換的東西了，有去有回才叫「生意」嘛。另外，「千織屋」內嚴禁抽菸喝酒、尋釁鬧事。「顧客即是神明」那一套在我這裡不管用，就算來的真是神明，不守規矩被丟出去的時候，也一樣是屁股著地。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·評價",
      "text": "我來決定自己該怎麼走、要成為誰。沒人能對我指手畫腳。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·裁縫刀",
      "text": "誰說裁衣服一定要用剪刀？那些死板的規矩由它去吧，我喜歡自己用著順手的刀具。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·模特兒",
      "text": "#真要站著不動的話，乾脆來當我的模特兒吧。替{F#妳}{M#你}設計一款好看的衣服。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "比起下雨，我更討厭地上泥水，濺到衣服上就很難洗掉。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "…想起了家鄉往日的風景。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "清高卻令人嚮往…落到手上的一瞬，這份美麗又隨之消散…雪花這東西，和「時尚」還真像…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "真難想像這種地方要怎麼推行時尚。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早，別指望我會幫{F#妳}{M#你}變出早飯來。{F#妳}{M#你}如果去咖啡廳的話就幫我帶一杯咖啡來吧，不加牛奶，不加糖。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#已經這個時間了？肚子完全不餓啊…我不打算停下手頭的工作。午飯{F#妳}{M#你}自己吃就好。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "外面好吵。全楓丹廷的人都出來逛街了嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "我要去好好泡個澡放鬆一下。不多聊了，明天見。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於自己·直接",
      "text": "很多人明裡暗裡表達過我的性格不夠好、說話不夠委婉，容易傷人。對我來說，那種誰都看得出來的寒暄、客套和恭維才是在浪費彼此的時間吧？要是挑明事實就會受傷，那人也太脆弱了。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於自己·理念",
      "text": "最初構想品牌理念的時候，我想到了很多過去的經歷，也由此整理出了不少關鍵字。取捨是一件難事，尤其是你發現每一枚寶石都折射著自己的一種想法…而你只能挑選最能代表妳的那一枚。\\n「永不認輸」——那才是我，才是我的品牌。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·試衣",
      "text": "#聽我的，這件適合{F#妳}{M#你}。什麼？之前沒見過這樣的款式？呵，那是{F#妳}{M#你}之前遇到的設計師沒品味。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·交換",
      "text": "#事到如今再說這話有點晚了，但我向來是想說什麼就說什麼，{F#妳}{M#你}恐怕也習慣了。我不打算改變自己直來直往的作風，{F#妳}{M#你}也儘管在我面前表露最真實的自己吧，無須掩藏。我保證不會對{F#妳}{M#你}有所指摘。不信？{F#妳}{M#你}認識我那麼久，我有說到但做不到的時候嗎？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "因為我的出身，楓丹人稱呼我為「鳴雷的裁錦師」——愛怎麼稱呼就怎麼稱呼吧。我對故鄉沒什麼依戀的感情，畢竟就連我的「神之眼」，都是在我決定離開稻妻時獲得的。\\n但我也不討厭那個曬不乾布料的地方，對我來說，只是沒必要回去而已。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "為了治我小時候好動的性格，父母送我去學過很多東西，「劍道」就是其中之一。但學了一陣子後，我突然覺得雙手用刀很稱我意，也很厲害，結果卻被劍道老師制止了。我問他為什麼——他只說這不是主流刀法，有些「不倫不類」。自那之後，我就再沒去上過他的課。現在想想，當初堅持自己喜歡的用法真是太好了。或許，我天生就是兩隻手都閒不下來吧。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "「袖」是我的第一件作品，那時只想縫一個跟自己差不多模樣的女孩，作為模特兒和幫手。嗯？陪伴？我沒這種需要。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "她曾經很認真地「拜託」我設計各種奇奇怪怪的東西，比如為船舵的每個把手都設計一個不同的頭冠。那時我忍不住翻了個白眼，說我最多把她的帽子設計成一艘船。\\n那些說我想法超前的人恐怕是沒跟娜維婭聊過天。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於林尼…",
      "text": "我做不出一頂能隱藏秘密的禮帽，但他透過魔術就可以。有時我很好奇他的帽子裡裝了那麼多的秘密，戴起來會是什麼感覺？對我來說，還是想到什麼就說出來會比較輕鬆。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於琳妮特…",
      "text": "這位助手小姐不太說話，但她很信任我。我似乎很討貓喜歡啊…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "有次夏洛蒂來店裡想採訪我，我說：「別了，又沒什麼新鮮事。」結果她一出門，就有個醉漢來店裡鬧事，被她記錄下了全程…真是見鬼了。只有聽說過記者追新聞，現在還有新聞會追記者？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於夏沃蕾…",
      "text": "和夏沃蕾的合作與談話都很省力。這導致每次跟她告別，重新面對顧客的時候，我都有種不適應的感覺。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "艾梅莉埃的香水很受歡迎。出於商業合作，我會請她將試做中的香水樣品送到「千織屋」，讓愛洛芙悄悄噴在顧客們使用的試衣間，然後我再將顧客們的意見告訴她。但這麼長時間下來，沒有一位顧客說我試衣間裡的味道奇怪，反倒是紛紛來問我店裡的香水哪裡有賣。出於好奇，每次她發售香水成品的時候，我也會買一瓶來聞聞。不得不說，那種每次都能品出新鮮感的香味，實為天才之作。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "一些朋友和合作者有跟我聊過他，我很佩服他的手腕，但我也沒打算改變自己的做事方式。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於綺良良…",
      "text": "從前在稻妻，我到野外找設計靈感的時候，總有隻綠眼睛的貓喜歡跟在我身邊。那傢伙好像對我手上布料的顏色和花紋很感興趣，心情好了還會蹭蹭我的小腿。\\n後來，我一眼就認出了這個綠眼睛、背後還長著兩條尾巴的女孩。她看那些新奇東西的眼神，這麼多年從來沒變過。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "如果不是兒時貪玩，我恐怕也不會有機會認識這位神里家的大小姐。有次我翻進了神里家的院子，她的手鞠恰好滾到牆邊。她見到我時既驚訝又興奮，我陪她玩了好一會，又聊了很久的天…但最後我還是被人發現了，於是這短暫的友情就以我被人提了出去而告終。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解千織·其一",
      "text": "我自認為脾氣沒有人們說的那麼差，我只是不喜歡在破事上浪費時間而已。但不知是什麼原因，那些「破事」總是纏著我不放。久而久之，就落得了個不好的名聲，我才想叫冤枉呢。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解千織·其二",
      "text": "我從小就不喜歡被管教，有段時間特別討厭「規矩」這東西，一定要和它作對。託這倔脾氣的福，我吃了不少苦頭。但後來我漸漸明白，「規矩」不全是壞事——我真正討厭的是那種不能按自己想法做出決定的感覺。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解千織·其三",
      "text": "小時候最期待的，就是家鄉夏日的祭典。每到那時，人們就會穿上最好看的衣服上街…\\n腰帶上五顏六色的水球、怎麼樣都撈不起來的金魚、還有甜到膩人的蘋果糖和長野原家的煙花…那時玩得很開心，但回到家後卻總覺得少了什麼。現在才知道那時的我，是不想只做「觀眾」…\\n就像提到煙花人們就想到「長野原」一樣，我希望有一天，人們想穿去祭典的都是「千織屋」的衣服。\\n哈…光是這麼想想，就感覺心中充滿激情。嗯，我要回店裡去做衣服了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解千織·其四",
      "text": "雖然工作起來很投入，但我也喜歡享受當下的時光。閒下來的時候我會一個人帶上些吃的，找個風景好的地方靜靜睡個午覺，晚上再聽些喜歡的音樂，美美睡去…有時候則是叫上朋友們吃頓飯，大家在一起談天說地，開個不醉不歸的派對…想怎麼做全看當時的心情。正如「時尚」只存在於「當下」一樣，我也喜歡活在當下。怎麼樣？不如今晚我們就出去狠狠放鬆一下？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解千織·其五",
      "text": "我喜歡稻妻的點心、喜歡清淡的食物…我喜歡家鄉布料的觸感、喜歡每天結束後泡個澡…但我也喜歡楓丹溫柔的海水、喜歡海裡美不勝收的景色…\\n我常常會想自己是否並沒有擺脫「過去」對我造成的影響，是否今天的一切都是命中註定…\\n但那又如何呢？我就是我，活在此刻。就算過去的一切塑造了如今的我，未來的路，也依舊由我自己選擇，誰都無法改變這點。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "千織的愛好…",
      "text": "我在工作中追尋夢想，在愛好中探索自由。如果我每天做的事不是自己熱愛的，那還有什麼意義？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "千織的煩惱…",
      "text": "我偶爾會煩惱追求理想的進度比預期更緩慢，這樣下去不知我的品牌什麼時候才能風靡世界。但我絕不會向現實妥協，煩惱又有什麼幫助呢？還不如省下這個時間，多做幾件衣服。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我忘不了小時候吃過的那些稻妻點心，但比起品嚐時的喜悅，我更享受製作的過程。要不是布料的色彩與變化更豐富一些，恐怕這世上就要多一個點心師傅了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#就拿羊雜哈吉斯舉例，我吃不慣味道濃厚的菜——就像是好好地走在路上，冷不防被岩飄浮靈打了一臉一樣…我這麼形容{F#妳}{M#你}能理解吧？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#嗯，這味道我很喜歡，下次再帶一點給我。放心，我也會給{F#妳}{M#你}回禮的。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "不錯的手藝，適合工作累了之後，坐在店裡慢慢品嚐。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "這味道我不喜歡，下次換個清淡點的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。我懶得猜了，想要什麼禮物就直說。嗯？太直接了？好吧，那就叫上娜維婭和綺良良她們，再約幾個{F#妳}{M#你}的朋友，晚上來「千織屋」開派對。我參考參考他們會送{F#妳}{M#你}什麼，然後當場做一個適合{F#妳}{M#你}的首飾送給{F#妳}{M#你}，保證{F#妳}{M#你}喜歡。我有這個自信。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "…不行，還是太普通。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "…還不錯，但少了點引人駐足的亮點。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "…好，我抓到我想要的了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我的手是不會抖的，這是我的專業…但我得承認，此時此刻我的心跳聲實在有些吵了。感謝{F#妳}{M#你}一路幫助我完成我的作品，它對我有著無比重要的意義。今後的路，我會更有把握。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "袖。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "下一位？"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "幫個忙。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "風尚，由我裁定。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "脆如綢錦。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "千紅零落。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "這工藝還行，我做過比這更好的。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#原來{F#妳}{M#你}喜歡這種？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嗯…我參考參考。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "衣服都破了…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "鬧夠了沒有…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "得給你點教訓…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "喂，別逞強。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我可不做壽衣。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "裁剪不當…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我不認輸…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我的品牌…還沒有…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "就這點？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "沒品味的傢伙…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "你惹錯人了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "歡迎光臨「千織屋」。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "需要訂製服務嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "出門找找靈感吧。"
    }
  ]
}