  "passives": [
    {
      "id": "tailormade",
      "name": "量體裁衣",
      "description": "施放<span style=\"color:#FFD780FF\">羽袖一觸</span>的上挑攻擊後的短暫時間內，依據不同的後續操作，產生不同的效果：點按元素戰技將觸發「織錦」；點按普通攻擊則觸發「裁錦」。<br/><br/><span style=\"color:#FFD780FF\">織錦</span><br/>·切換角色，使隊伍中下一名自己的角色登場。<br/>·為隊伍中所有自己的角色施加「當意即妙」：隊伍中自己的目前場上角色的普通攻擊、重擊和下落攻擊命中附近的敵人時，袖將進行協同攻擊，在敵人的位置造成相當於羽袖一觸的上挑攻擊傷害100%的<span style=\"color:#FFE699FF\">岩元素範圍傷害</span>，依此方式造成的傷害視為元素戰技傷害。<br/>·「當意即妙」持續8秒，每2秒至多觸發一次袖的協同攻擊，一次「當意即妙」持續期間，至多觸發2次協同攻擊。<br/><br/><span style=\"color:#FFD780FF\">裁錦</span><br/>·千織獲得<span style=\"color:#FFE699FF\">岩元素附魔</span>，持續5秒。<br/><br/>千織在場上時，如果施放羽袖一觸的上挑攻擊後的短暫時間內沒有再次點按元素戰技或點按普通攻擊，將觸發後續效果「裁錦」。",
      "level": 1
    },
    {
      "id": "the_finishing_touch",
      "name": "錦上添花",
      "description": "隊伍中附近的角色創造<span style=\"color:#FFE699FF\">岩元素創造物</span>時，千織獲得20%<span style=\"color:#FFE699FF\">岩元素傷害加成</span>，持續20秒。",
      "level": 4
    },
    {
      "id": "brocaded_collars_beauteous_silhouette",
      "name": "衣香襟影",
      "description": "隊伍中任意自己的角色裝備了預設衣裝以外的衣裝，或初始之翼以外的風之翼時，隊伍中自己的角色獲得迅行效果：移動速度提升10%。<br/>該效果在秘境、征討領域、深境螺旋中無效，迅行效果無法疊加。",
      "level": 0
    }
  ],
