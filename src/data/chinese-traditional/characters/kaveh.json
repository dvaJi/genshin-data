  "outfits": [
    {
      "id": 208100,
      "name": "浴火的金羽",
      "description": "卡維的裝扮款式。寶商街知名裁縫仿照鳥兒展翼時的美麗姿態製成了這套衣衫，只賣給懂得欣賞的人。",
      "isDefault": true,
      "characterName": "卡維",
      "characterId": 10000081,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Kaveh_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#能像這樣見面是件好事，眼光相近的人才能共同開啟一段愉快的對話。\\n初次見面，{F#妳}{M#你}好，我是建築設計師卡維，有什麼事需要我幫忙的話，請先詳細說明{F#妳}{M#你}的需求。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·美學",
      "text": "懂得欣賞美是一種好的品德。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·解悶",
      "text": "人不能老是悶在家裡，多出去走走吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·完善",
      "text": "上次的方案還能改善一下，趁沒到截止日再改改好了…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "欸？怎麼下雨了？糟糕，沒帶傘…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#{F#妳}{M#你}看到了嗎？剛才那道閃電的形狀好特別！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "嘶…背後有點漏風的感覺…胸口也有…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "天氣很好…",
      "text": "曬久了太陽就想睡覺，跟熬夜工作的感覺差不多，都是頭暈。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "不是第一次來了，可是每次都這麼熱…唉，有沒有陰涼的地方…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#睡得好嗎？希望{F#妳}{M#你}今天順利，別遇到那種一大早就能惹{F#妳}{M#你}生氣的人。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "正午陽光好烈，我曬在外面的材料怎麼樣了…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今晚能看到許多星星呢，不覺得是個好兆頭嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "放空大腦忘掉所有煩心事，晚安。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於卡維自己·專業",
      "text": "談到專業領域，我算是個驕傲的人。學者面對自己的專長大多這樣，不如說，這是我們的根基。假如連這份驕傲都失去了，我就不可能再向自己和別人提出什麼要求。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於卡維自己·藝術",
      "text": "藝術性不是也不該是我工作的第一追求，品質和安全性才是。但我從未放棄它，它是將我區別於他人的根本。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·欣賞",
      "text": "#{F#妳}{M#你}應該見過卡薩扎萊宮吧？那是我最得意的作品。我為它付出了很多，多到別人難以理解…哈哈，{F#妳}{M#你}們不是我，又不從事這個行業，無法理解也正常。唔…不過偶爾還是希望別人能理解一下。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·理想",
      "text": "看透一個人的理想才能真正觸摸到他，我一直這麼想。但理想、美夢這種東西…接觸自己的或他人的都是在冒險，會開啟某些可能。不是每個人都有能力面對那些。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "可以的話，我不想把這句話說出口…擁有願望有時是一件令人痛苦的事。幸好，我不討厭我的「神之眼」。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#知道自己為什麼而進行創造的人值得尊重。{F#妳}{M#你}應該也這麼覺得吧？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "外行經常認為妙論派建築設計師的專業領域就是土塊、木材什麼的，這種觀點膚淺到沒必要與之辯論。假如把各種材料拼在一起就叫造房子，那就是在否定這門學科的意義。建築設計是人文的一環，也是藝術，藝術無法脫離人單獨存在。使用者的感受，觀看者的心境…我會考慮這些。啊對，怎麼更好地融合藝術表達與人文需求也很重要。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "小吉祥草王是一位非常賢明的神，充滿智慧，更擁有常人無法匹敵的美德。她能理解包容他人，在須彌這樣的學術之國裡，她的沉穩讓我欽佩。\\n偶爾我會想，神明難道就毫無煩惱嗎？智慧時常伴隨困惑而生，那什麼才算得上真正的幸福？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於艾爾海森·脾氣",
      "text": "#誰都不可能從人群中找出第二個像他一樣令人無語的傢伙！這話就算他本人來了我也敢說。\\n{F#妳}{M#你}也知道他很聰明，都說聰明人容易脾氣差，這話算是對了一半吧，可他不一樣…他完全清楚怎麼表現得更符合大眾定義的友好，只是不想。\\n假如{F#妳}{M#你}覺得他脾氣很好，或者覺得他死板板的像臺機器，那表示{F#妳}{M#你}們還不夠熟。他就是太有個性，普通人理解不了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於艾爾海森·複雜",
      "text": "艾爾海森幫了我一些忙，如果我們的關係還像學生時代那麼好，我肯定會三天兩頭感謝他。現在嘛…說不出口，也不想就這麼承認。\\n該說是有好有壞嗎？很多事就像命運的惡作劇…不是重來幾次就能看清的。當然，能認識這樣一個人也算難得，他要是能收起性格中比較惡劣的部分就更好了。好吧不可能。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於提納里…",
      "text": "#提納里啊，{F#妳}{M#你}見到他就會明白的，他是非常好的人，善良又淵博，而且從不將知識當成炫耀的資本。他是真心喜歡他的工作。\\n建造卡薩扎萊宮那段時間我向他請教過挑選園藝花卉的辦法，他回信給我，後來還幫我處理了一些別的問題。噢對，賽諾也是我透過他認識的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於多莉…",
      "text": "#多莉是卡薩扎萊宮的主人…{F#妳}{M#你}說什麼？廢話，卡薩扎萊宮當然不是我的…別說了別說了！\\n她很精明，懂得如何控制別人為自己辦事。我…呃…我因為一些原因欠她錢，那件事很複雜…反、反正，還是希望她手下留情，別總是為錢的問題折磨我。她明明可以成為更善良的好人的啊，怎麼會這樣呢？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於賽諾…",
      "text": "#賽諾看似冷酷無情，其實很熱心。記得當初提納里說要介紹他最好的朋友給我，我一回頭就看見一個氣勢驚人的風紀官走進門…真沒想到，本來以為那種類型的風紀官不會跟學者走得太近。\\n不過賽諾的冷笑話我受不了，冬天聽到那些會寒毛直豎。他約{F#妳}{M#你}一起去提納里家吃飯的話，{F#妳}{M#你}最好多穿件外套。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於柯萊…",
      "text": "我和柯萊見過不少次了，她一直跟在提納里身邊，既是助手也是學生。柯萊做事很認真，又有耐心，比同齡人還可靠。\\n嗯…不過能看出來，她有不少心事。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於妮露…",
      "text": "妮露身為舞蹈家的實力毋容置疑，祖拜爾劇場能招到這樣一位演員未免太走運了點。\\n聽說她個性也很好，跳舞時一直在笑，對每個觀眾都會說鼓勵的話。等有時間，我也會去看她的演出。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於琺露珊…",
      "text": "#琺露珊前輩心直口快，聽說教令院有些學生怕她，可以理解，不過她從來沒有什麼壞心眼，就是一心專注在自己感興趣的學問上。有人覺得知論派都難相處，這個嘛…哈哈。\\n她應該也請{F#妳}{M#你}當她的學生了吧？的確，琺露珊前輩有時像個瘋狂的推銷員…學問倒都是真的，這點不會錯。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解卡維·其一",
      "text": "#聽說我在須彌小有名氣？哈哈哈，都是大家隨口說的，我自己覺得還好。在這裡生活久了誰都有可能出名，保持低調才難。\\n但願{F#妳}{M#你}不是透過破產醜聞認識我的，哼。如果{F#妳}{M#你}想聽，我也可以跟{F#妳}{M#你}講講我的優點。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解卡維·其二",
      "text": "#{F#妳}{M#你}應該不會去教令院當學生吧？從務實的角度出發，我建議{F#妳}{M#你}就算要去也別選設計，設計很有意思，累也是真的累。剛畢業那陣子我在前輩手底下打工，每天做牛做馬，被人使喚來使喚去，堅持了好久，差點把自己累死。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解卡維·其三",
      "text": "#人的審美很難統一，但美是一種相對具體的概念，我認為美學之中存在基礎標準。審美本身也不是不能提升，就是費時，需要大量累積。{F#妳}{M#你}需要這方面參考的話，可以來找我。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解卡維·其四",
      "text": "有人說我經常惹麻煩，這算什麼話？只要一個人還在前進，難免會跟其他人事物發生摩擦，不能因為怕麻煩就對很多事視而不見。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解卡維·其五",
      "text": "#休息時我會去喝酒，酒能沖淡煩惱。嗯？噢，是啊，只是為了打發時間。\\n呃…咳！別這麼看著我…好吧好吧我承認我就是有很多煩惱！沒做完的工作，解決不了的困難，人和人的隔閡…難道{F#妳}{M#你}不會考慮這些嗎？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "卡維的愛好…",
      "text": "#音樂、建築、雕塑、繪畫藝術，都是值得花時間欣賞的東西。\\n不敢說我都會，但有了興趣，以後說不定能全部精通的吧。{F#妳}{M#你}看，至少我會彈琴。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "卡維的煩惱…",
      "text": "煩惱啊…唔，最直覺的煩惱還是經濟問題。\\n我不是賺不到錢，而是留不住錢。生活中有太多可能用到錢的場合了，一不小心就…不過別擔心，我比以前好多了，會提高警戒避免陷入困境。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "酒、熱湯、有鮮奶油和乳酪的菜餚，這些我都喜歡。還有新鮮水果也不錯。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "太辣太燙的東西很難入口，我不行，至少也要等放涼了才能吃。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "真不錯！能教教我怎麼做嗎？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "拿來下酒不錯哦。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "…嗯？唔…呃…呃…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天是{F#妳}{M#你}的生日嗎？恭喜{F#妳}{M#你}，生日是很重要的日子，也是一年之中最容易想起家人的日子。希望{F#妳}{M#你}能在這天有好心情。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感覺不錯，謝謝。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "嗯？還能再來一次嗎？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "視野變得更開闊了…我想把這份感覺延續下去。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "擁有的力量越多，能做到的事就更多。哪怕完成這些事需要代價，哪怕理想從來都建立在痛苦之上，我也…不想後退。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "掃描！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "來吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "清除障礙！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "看好了！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "工程開始。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "萬眾矚目！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "新發現！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "撿到好東西了，很開心吧？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "該說是意外之喜還是超乎想像…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "真是麻煩！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "沒有下一次了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "唔…走開！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "這裡交給我！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "到後面去。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "還有…沒完成的事…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "為什麼…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "不許…踐踏我的理想…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "嗚！別這樣…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "咳！沒什麼的。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "需要幫忙？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "放著我來好了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "是甲方嗎？還是…哦！不是啊。"
    }
  ]
}