  "outfits": [
    {
      "id": 204501,
      "name": "致教會自由人",
      "description": "蘿莎莉亞的裝扮款式。這套衣服似乎是教會為她專門定製的禮物。",
      "isDefault": false,
      "characterName": "蘿莎莉亞",
      "characterId": 10000045,
      "source": [],
      "filename_card": "UI_AvatarIcon_RosariaCostumeWic_Card",
      "filename_icon": "UI_AvatarIcon_RosariaCostumeWic",
      "filename_iconCircle": "UI_AvatarIcon_RosariaCostumeWic_Circle",
      "filename_splash": "UI_Costume_RosariaCostumeWic",
      "filename_sideIcon": "UI_AvatarIcon_Side_RosariaCostumeWic"
    },
    {
      "id": 204500,
      "name": "處刑棘刺",
      "description": "蘿莎莉亞的裝扮款式。經蘿莎莉亞大幅改造的西風教會修女制服。",
      "isDefault": true,
      "characterName": "蘿莎莉亞",
      "characterId": 10000045,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Rosaria_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#這位信徒，如果遇到難以解決的麻煩，可以來找我，如果只想祈禱，還請找其他修女。\\n…嗯？{F#妳}{M#你}不是信徒嗎？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·無聊",
      "text": "還不走嗎？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·加班",
      "text": "什麼都可以商量，除了加班。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·蒙德生活",
      "text": "好好完成工作，好好度過每一天。蒙德的生活不就是如此嗎？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "唉，影響效率。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "嘖，麻煩。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "雪天趕路，最好小心一些。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "是風神巴斯巴托的庇佑嗎？等等，好像是巴托巴斯…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安，哈…晨禱已經開始了嗎？也太早了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午後的陽光對睡眠有好處。{F#妳}{M#你}也試試吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好。晚間禱告的話，我不參加。嗯？不為什麼。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "去休息吧，不用操心，剩下的事我會處理。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於蘿莎莉亞自己·修女",
      "text": "#我？只是個無趣的人而已。如{F#妳}{M#你}所見，不愛教會也不愛工作。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於蘿莎莉亞自己·麻煩",
      "text": "#那些值班修女一個比一個麻煩，不是抓人去禱告，就是叫人去唱詩班。{F#妳}{M#你}不要告訴她們我在這裡。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·信仰",
      "text": "神或許能庇護所有人，可是他不會這樣做。否則，人的苦難就成了笑話。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·禱告",
      "text": "祈禱吧。不是為了神或其他任何人，而是為了自己。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·戰鬥",
      "text": "不要勉強，有困難可以叫我。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」可以是實力的證明，也可以是倖存的勳章…誰知道呢？真正的好東西總是具有兩面性。我不會定義「神之眼」。我和它只是互相見證的關係罷了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#要說什麼是值得高興的好事…呵，只是假設而已。如果有一天{F#妳}{M#你}遇到無法解決的難題，也別認為那就是人生的終點。說不定，會有人替{F#妳}{M#你}解決困境呢"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "花草不屬於我感興趣的範疇。不過，蒲公英是個例外，它能釀出相當美味的蒲公英酒。休息時間來一杯，比睡懶覺還舒服。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "一看就知道了吧？那位富豪老爺可不是個簡單的人物。低調、自信…還有一點危險的氣息。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於凱亞…",
      "text": "#人往往要到酒醉以後才會露出真面目。油嘴滑舌算是凱亞的保護色吧，呵，一目了然的偽裝。{F#妳}{M#你}該看看他喝醉的樣子。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於溫迪…",
      "text": "這個吟遊詩人身上有種非常特殊的氣息…我還不能確定真相，但他與別的市民似乎很不一樣。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "芭芭拉總是纏著我，叫我參加禮拜和唱詩班。難道維多利亞向她下了監督我工作的命令？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於琴…",
      "text": "不僅完成本職工作，還會替他人收尾。值得欽佩的女人。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "他就像一副掛在古舊房屋裡的油畫…厚重、神秘，無法被一眼看透。我不討厭有故事的人。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於麗莎…",
      "text": "我不喜歡上班偷懶的人，不過也很能理解她準時下班的心情。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於可莉…",
      "text": "唉，除了麻煩就是麻煩，雖然是可愛的麻煩。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "雖說是出於好意，但法爾伽囉嗦起來像個老頭一樣，相當在意身邊的人呢。唉，那傢伙。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於父親…",
      "text": "父親？好遙遠的詞彙啊。對我而言可以說沒有，也可以說有不止一個。怎麼？很驚訝嗎？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於塔利雅…",
      "text": "主動請客是個好習慣，除此之外，他在酒桌上也很有分寸，知道什麼該問，什麼不該問。摸清彼此底牌後，我不必過多防備他，和聰明人打交道總是輕鬆的。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解蘿莎莉亞·其一",
      "text": "跳過寒暄吧。我來這裡是為了完成工作，你解決不了的問題可以移交給我。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解蘿莎莉亞·其二",
      "text": "不信神的修女並不稀奇，就像世上也有不喜歡吃豬肉的獵人、討厭魚肉的漁民。做某一件事不代表愛它，不愛一件事也不意味著必須遠離。工作就是這樣的東西。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解蘿莎莉亞·其三",
      "text": "來一杯嗎？這是今年的蒲公英酒，味道很不錯。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解蘿莎莉亞·其四",
      "text": "#蒙德是一頭既古老又年輕的白色野獸，古老到需要人去保護，也年輕到無法獨立生存。只有這樣的地方才會需要我這樣的人。我像其他修女照顧市民那樣照顧著蒙德，讓它在自由的道路上平穩前進。{F#妳}{M#你}問我為什麼它是白色的？…因為像我這樣的人，是黑色的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解蘿莎莉亞·其五",
      "text": "#我偶爾能感覺到過去每一年的自己都存在著、圍繞著我…對我有所寄託。{F#妳}{M#你}一定也有相同的感覺，所以，哪怕如今{F#妳}{M#你}已走上截然不同的道路，也不要否認從前的自己。從前的每一個{F#妳}{M#你}，都是{F#妳}{M#你}腳下的基石。不要害怕過去，不要畏懼與它抗衡。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "蘿莎莉亞的愛好…",
      "text": "小酌怡情，有些煩心事只能靠酒精解決。話雖如此，我是不會醉的。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "蘿莎莉亞的煩惱…",
      "text": "唉…真不想參加下個月的合唱活動，可是維多利亞親自點名了…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "試過紅酒燉獸肉嗎？酒精和大塊的動物肉出現在一個盤子裡，相當有品味。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "這個…這個薯餅的沾醬居然是果醬？完全不合理！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "看來這方面，我們品味相投。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "至少能填飽肚子。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#{F#妳}{M#你}對這種食物很感興趣嗎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天是{F#妳}{M#你}生日，有什麼想處理的人或事嗎？我可以幫個小忙，別告訴其他人就行。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "嗯，感覺不錯。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "需要幫忙嗎？我現在有空。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "也好。能力越強，效率越高。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#哪怕是擅長戰鬥與殺戮的我，也從未擁有過如此強大的力量，謝謝{F#妳}{M#你}的祝福。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "嘿呀！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "審判！"
    },
    {
      "id": "100003",
