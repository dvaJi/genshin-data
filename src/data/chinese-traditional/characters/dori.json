  "outfits": [
    {
      "id": 206800,
      "name": "我愛摩拉",
      "description": "多莉的裝扮款式。這套恨不得嵌滿寶石和貴金屬的衣服大聲宣告著主人對財富的欲望。據說這還只是商人多莉的常服，難道她還有比這更昂貴的衣服嗎？！",
      "isDefault": true,
      "characterName": "多莉",
      "characterId": 10000068,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Dori_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#哎呀呀，這不是大名鼎鼎的旅行者嗎？我是旅行商人多莉·桑歌瑪哈巴依。我這裡的商品全部限時九折優惠，就當作是給{F#妳}{M#你}的見面禮。趕快來挑選吧，我幫{F#妳}{M#你}打包~"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·摩拉",
      "text": "我愛摩拉，摩拉愛我，啦啦啦。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·雙贏",
      "text": "先把商品漲價百分之三十，然後再打八折賣出，不僅我賺得多了，顧客也會覺得划算，這就是雙贏。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·財迷",
      "text": "只要摩拉夠，跟教令院作對也沒什麼大不了的。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "需要傘嗎？我這裡有一把特製雨傘，收集雨水的同時能夠淨化水質，把雨水變成飲用水儲存在小罐子裡，可以說是旅行必備品！只需要五十萬摩拉喔。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "這種天氣，恐怕商隊也不太好前進了。又要少賺好多摩拉…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#噠啦，看我的全自動雪球機！想要嗎想要嗎？租金打九點五折給{F#妳}{M#你}喔！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "摩拉在陽光下閃閃發光，真好看！嘿嘿。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "不會吧不會吧，不會真的有人選在大風天穿越沙漠吧。我當然有辦法救這種蠢蘑菇，但費用…至少要翻三倍才行！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安，昨晚的夢裡全是圓滾滾的可愛摩拉，今天一定會是盆滿缽滿的一天。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#想午睡嗎？我可以給{F#妳}{M#你}一個軟綿綿、蓬鬆鬆，完美貼合{F#妳}{M#你}背部曲線的靠墊。當然實際上到底有多舒服就看摩拉有多少了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "在夜色中趕路很有挑戰性喔，不過這可難不倒常年在外行商的我！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}要睡覺了嗎？嘿嘿，我就大發慈悲讓{F#妳}{M#你}試試我的摩拉歌謠催眠法吧！一萬摩拉入口袋，兩萬摩拉入口袋，三萬摩拉入口袋，四、嘿四萬…嘿嘿，摩拉，嘿嘿…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於多莉自己·吆喝",
      "text": "萬能的多莉商店，應有盡有，童叟無欺。只要摩拉夠，只有想不到，沒有買不到。需要任何東西，或者遇到任何困難，都可以來找我喔！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於多莉自己·妙論派",
      "text": "#通常我會躲著教令院的人，他們的各種規矩簡直讓人沒辦法做生意。不過呢，告訴{F#妳}{M#你}也沒關係。妙論派有些人還算是頭腦靈活，和我私下簽了條約。我有摩拉，他們有技術和手藝，順便還能讓我的行商更加通暢。嘿嘿，大商人多莉，從不做虧本生意。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·推銷",
      "text": "#{F#妳}{M#你}要在須彌旅行嗎？須彌的沙漠很危險喔，就讓大善人多莉來幫{F#妳}{M#你}吧！鏘鏘，沙漠旅行大禮包，只需要五百萬摩拉！現在購買還會免費附送雨林旅行大禮包！機不可失，時不再來喔。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·摩拉分配",
      "text": "#我的摩拉是我的，{F#妳}{M#你}的摩拉還是我的，嘿嘿。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·實價",
      "text": "#好吧好吧，和{F#妳}{M#你}實話實說也行啦。沙漠和雨林的旅行大禮包，拆開來賣的話，分別都值二百五十萬摩拉。但買一送一聽起來比較划算嘛，{F#妳}{M#你}不覺得嗎？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#哎呀哎呀，我的神之眼亮晶晶的，很漂亮吧？既然看到了這麼漂亮的東西，{F#妳}{M#你}是不是應該付摩拉呢？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#以前也有些蠢蘑菇試圖欠帳不還，嘿嘿，也不看看我是誰。不如，{F#妳}{M#你}來猜猜看他們的下場如何吧？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·共同語言",
      "text": "如果盜寶鼬能開口說話的話，我們肯定很有共同語言。牠們多有眼光呀！全提瓦特最惹人喜愛的，當然是閃亮亮金燦燦的摩拉。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞·馱獸樂園",
      "text": "#想見見馱獸嗎？沒問題！{F#妳}{M#你}想見多少我就有多少。只不過這個門票錢嘛，欸嘿嘿…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於賽諾…",
      "text": "我和他算是有點私交。畢竟能為他拿到「七聖召喚」所有周邊產品的人，全須彌只有我一個。很罕見吧！教令院裡居然有他這種特行獨立，眼光不錯，又從不議價的人。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於提納里…",
      "text": "他熱愛學術就和我熱愛摩拉一樣。聽說他經常會做一些神奇的小東西，只可惜會用什麼公務繁忙作為理由，拒絕和我合作批量生產，要不然…可以賺上一大筆摩拉呢！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於艾爾海森…",
      "text": "他以前試探過我的手下。所以說，教令院的傢伙真是又呆板又不誠懇。我又何必冒這個風險呢？懂了嗎？小跟班。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於卡維…",
      "text": "他是跟我有合作的妙論派的人之一，和某些教令院的死腦筋不一樣，是個會為理想奮鬥的人，我很欣賞他。我悄悄借了他一大——筆摩拉，讓他造出了我的艾爾卡薩扎萊宮。可以說沒有善良的多莉的資助，就沒有今天的卡維。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於迪希雅…",
      "text": "有時候我會僱用她幫忙保護商隊。畢竟她實力不錯，開價也不高，可以說是投資報酬率極佳之選。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於岩王帝君…",
      "text": "岩王帝君離去之前，我每天起來第一件事就是默唸：財神在上，保佑多莉日進斗金。現在嘛，求神不如求己。多莉在此，保佑自己日進斗金！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "#在須彌，小吉祥草王的信徒非常少。{F#妳}{M#你}問我嗎？啊，如果她願意給我摩拉的話，我就是她永恆的信徒。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於妮露…",
      "text": "#她的舞跳得不錯，但只留在須彌，還是不能發揮出她最大的價值…我是說，有點屈才。{F#妳}{M#你}說{F#妳}{M#你}說，如果能把她帶出去，在提瓦特舉辦巡迴演出的話，一共能賺多少摩拉呢？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於艾莉絲…",
      "text": "#艾莉絲女士有源源不斷的新奇東西，是我的最佳供應商，沒有之一。欸欸，這種商業機密都告訴{F#妳}{M#你}了，{F#妳}{M#你}是不是應該交點學費，表示表示呢？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於綺良良…",
      "text": "#在我跨國收購物資的時候，她替我送過好幾次貨。服務又好，收費還便宜。哦，對了，她很喜歡各種漂亮的小飾品，我這裡剛好進了一些須彌特色的純手工製品，可精緻了。怎麼樣，要不要買來送給她呀？我幫{F#妳}{M#你}打折。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於瓦雷莎…",
      "text": "#哎呀，我知道{F#妳}{M#你}說的是誰了，單純可愛的水果領主…她家的作物啊，品質頂呱呱！人也非常好說話，我面無表情托腮思考，都會讓她緊張，懷疑自己的貨品品質欠佳，主動提出降點價…嘿嘿，這樣的性格，做生意可是要吃虧的！我希望她只對我展現出來，以免便宜了別家！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解多莉·其一",
      "text": "#想聽故事？那就…給我一百萬摩拉。嗯…看在我們交情的份上，打個九點九折給{F#妳}{M#你}好了，九十九萬摩拉。怎麼樣？很划算吧！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解多莉·其二",
      "text": "#嘿嘿，{F#妳}{M#你}可真有眼光。那我開始講了！\\n這是一個商人的故事。很久很久以前，她在行商途中迷失了方向。這時候她遇到一隻霧怪，霧怪要一口吞掉她。她連忙說，霧怪先生不要著急呀，我這裡有個故事。您聽聽看，如果有趣的話，就請您不要吃掉我…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解多莉·其三",
      "text": "霧怪答應了。於是商人開始講自己的故事，當年她的生意還不像如今這麼熱絡，在她一籌莫展之時，正巧，她從庫房裡翻出了一個不知從哪裡來的魔燈。她恍惚間擦亮了魔燈。一團紅霧從裡面彌漫了出來，她自稱是「人美心善的大魔王」，見著這位商人就想起了自己乖巧可愛的女兒，所以她說，可以實現商人一個願望。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解多莉·其四",
      "text": "還有什麼比摩拉更吸引商人的呢，於是商人許願：希望接下來的日子，能賺到數也數不清的摩拉。「人美心善的大魔王」同意了，她成為了商人的供應商，為商人提供了源源不斷的奇妙商品。商人也因此賺得盆滿缽滿…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解多莉·其五",
      "text": "#霧怪聽完這些覺得很神奇，明明自己和紅霧大魔王也算同類，自己怎麼沒辦法變出什麼東西。商人呀，就誇了霧怪天賦異稟，說不定在同一個魔燈裡待上一段時間，就能擁有大魔王的能力了。霧怪欣然同意，進入了商人的魔燈…\\n咳咳，{F#妳}{M#你}問我這個故事是不是真的？這要另外算錢囉，再給我九十九萬摩拉，我就告訴{F#妳}{M#你}！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "多莉的愛好…",
      "text": "我的愛好可多了，第一是賺摩拉，第二是數摩拉，第三是看摩拉，這世界上沒有比摩拉更令人開心的東西了！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "多莉的煩惱…",
      "text": "總有些人，拿著才三成利的生意就來打擾我，唉，我也是很忙的。沒有百分百的利潤，我連聽完的興趣都沒有。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#我聽說璃月有一種叫做摩拉肉的食物，名字裡有摩拉，一定非常好吃。什、什麼…{F#妳}{M#你}會做？咳咳，{F#妳}{M#你}當我的小跟班也有一段時間了，應該從我這裡學到了不少吧。作為交換，{F#妳}{M#你}要做摩拉肉給我吃！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "椰炭餅那種黑漆漆的東西，一點也不符合我的品味，我是絕對不會吃的！就算反過來給我摩拉，我…呃，我、我再考慮考慮。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#好吃好吃，啊不如{F#妳}{M#你}跟著我一起行商，兼職私人廚師吧。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "哇，我的小跟班做飯能力還可以呀。能讓我點餐嗎？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#居然讓我吃這種東西，嘿嘿，{F#妳}{M#你}要賠償我精神損失費！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天我可以滿足{F#妳}{M#你}一個心願！畢竟我是無所不能的多莉。說吧說吧，想要什麼？不過呢，先和{F#妳}{M#你}說好，「一輩子都用不完的摩拉」這種願望可不行喔。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#{F#妳}{M#你}這是在投資我嗎？{F#妳}{M#你}可真有眼光。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "多多益善，多多益善。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "喔！我好像有了一個奇妙錢袋，能掏出源源不斷的力量。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#恭喜{F#妳}{M#你}成為神通廣大的桑歌瑪哈巴依老爺的尊貴會員！以後{F#妳}{M#你}的訂單一律八折，這種待遇{F#妳}{M#你}可是第一個喔。啊，好好珍惜吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "看我的！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "留下摩拉來！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "嘿喲！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "魔燈顯靈！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "大顯身手時間！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "一手交錢，一手交貨。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "哇，分我一半！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "先讓我看看。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "我來我來！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "休想搶走我一分摩拉！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "啊救命啊，搶劫啦！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "一定要保護好摩拉。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "救命之恩，記得給錢！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "呆頭菇，命和摩拉一樣重要。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "摩拉…還沒賺夠呢…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "又是…這樣…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "摩拉也沒有用嗎…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "小問題。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "輕輕碰到而已。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "真是欺人太甚！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "列入黑名單！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "走吧走吧，賺筆大的！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "摩拉不等人，快跟上。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "是什麼大生意？"
    }
  ]
}