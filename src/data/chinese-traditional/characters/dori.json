  "passives": [
    {
      "id": "an_eye_for_gold",
      "name": "批沙瀝金",
      "description": "與<span style=\"color:#FFD780FF\">燈中幽精</span>相連的角色在觸發感電、月感電、超導、星超導、超載、原激化、超激化、超綻放、雷元素擴散或雷元素結晶反應後，<span style=\"color:#FFD780FF\">鎮靈之燈·煩惱解決炮</span>的冷卻時間縮短1秒。<br/>該效果每3秒至多觸發一次。",
      "level": 1
    },
    {
      "id": "compound_interest",
      "name": "利上加利",
      "description": "<span style=\"color:#FFD780FF\">鎮靈之燈·煩惱解決炮</span>的斷除煩惱炮或售後服務彈命中敵人時，根據多莉的元素充能效率，每100%為多莉恢復5點元素能量。<br/>每次施放鎮靈之燈·煩惱解決炮只能依此方式恢復一次元素能量，並至多恢復15點元素能量。",
      "level": 4
    },
