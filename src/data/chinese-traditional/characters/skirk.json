  "passives": [
    {
      "id": "reason_beyond_reason",
      "name": "理外之理",
      "description": "隊伍中附近的角色對敵人觸發凍結、超導、星超導、冰元素擴散、星擴散或冰元素結晶反應時，將在敵人附近創造一枚虛境裂隙。該效果每2.5秒至多觸發一次，場上至多存在3枚絲柯克自己創造的虛境裂隙。<br/><br/>絲柯克可以透過以下方式，汲取附近一定範圍內的虛境裂隙：<br/>·在<b><span style=\"color:#FFD780FF\">七相一閃</span></b>模式下進行的重擊命中敵人時。<br/>·施放七相一閃模式下的特殊元素爆發<span style=\"color:#FFD780FF\">極惡技·盡</span>時。<br/>·長按施放元素戰技<span style=\"color:#FFD780FF\">極惡技·閃</span>進行快速移動時。<br/><br/>每汲取一枚虛境裂隙，絲柯克將獲得8點<b><span style=\"color:#FFD780FF\">蛇之狡謀</span></b>。",
      "level": 1
    },
    {
      "id": "return_to_oblivion",
      "name": "萬流歸寂",
      "description": "隊伍中附近的元素類型為<span style=\"color:#80C0FFFF\">水元素</span>的角色的<span style=\"color:#80C0FFFF\">水元素</span>攻擊命中敵人時，或是隊伍中附近的元素類型為<span style=\"color:#99FFFFFF\">冰元素</span>的其他角色的<span style=\"color:#99FFFFFF\">冰元素</span>攻擊命中敵人時，絲柯克將獲得一層持續20秒的死河渡斷效果，至多疊加3層，每層獨立計算持續時間。<br/>每名角色至多依此方式使絲柯克獲得1層死河渡斷效果。<br/>每層死河渡斷效果會使絲柯克在<b><span style=\"color:#FFD780FF\">七相一閃</span></b>模式下時進行的普通攻擊造成原本110%/120%/170%的傷害，且施放的元素爆發<span style=\"color:#FFD780FF\">極惡技·滅</span>造成原本105%/115%/160%的傷害。",
      "level": 4
    },
    {
      "id": "mutual_weapons_mentorship",
      "name": "諸武相授",
      "description": "隊伍中所有角色的元素類型均為<span style=\"color:#80C0FFFF\">水元素</span>或<span style=\"color:#99FFFFFF\">冰元素</span>，並且至少有一名水元素角色、一名冰元素角色時，隊伍中自己的角色的<span style=\"color:#FFD780FF\">元素戰技</span>等級提高1級。",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1141,
      "id": "far_to_fall",
      "name": "湮遠",
      "description": "突破天賦<b><span style=\"color:#FFD780FF\">理外之理</span></b>的效果獲得強化：每汲取一枚虛境裂隙，就將召喚一枚晶刃攻擊附近的敵人，造成相當於絲柯克攻擊力500%的<span style=\"color:#99FFFFFF\">冰元素傷害</span>，該傷害視為重擊傷害。<br/>需要解鎖突破天賦「理外之理」。",
      "level": 1
    },
    {
      "_id": 1142,
      "id": "into_the_abyss",
      "name": "墜淵",
      "description": "施放元素戰技<span style=\"color:#FFD780FF\">極惡技·閃</span>後，絲柯克將額外獲得10點<b><span style=\"color:#FFD780FF\">蛇之狡謀</span></b>。<br/>施放元素爆發<span style=\"color:#FFD780FF\">極惡技·滅</span>時，提升本次元素爆發傷害的效果，至多額外計入10點蛇之狡謀。<br/>此外，絲柯克施放<b><span style=\"color:#FFD780FF\">七相一閃</span></b>模式下的特殊元素爆發<span style=\"color:#FFD780FF\">極惡技·盡</span>後的12.5秒內，攻擊力提升70%，該效果會在絲柯克退出七相一閃模式時解除。",
      "level": 2
    },
    {
      "_id": 1143,
      "id": "serendipitous_sin",
      "name": "罪緣",
      "description": "元素爆發<b><span style=\"color:#FFD780FF\">極惡技·滅</span></b>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 3
    },
    {
      "_id": 1144,
      "id": "fractured_flow",
      "name": "流斷",
      "description": "突破天賦<b><span style=\"color:#FFD780FF\">萬流歸寂</span></b>的效果獲得強化：每層死河渡斷效果還會使絲柯克的攻擊力提升10%/20%/40%。<br/>需要解鎖突破天賦「萬流歸寂」。",
      "level": 4
    },
    {
      "_id": 1145,
      "id": "end_of_wishes",
      "name": "結願",
      "description": "元素戰技<b><span style=\"color:#FFD780FF\">極惡技·閃</span></b>的技能等級提高3級。<br/>至多提升至15級",
      "level": 5
    },
    {
      "_id": 1146,
      "id": "to_the_source",
      "name": "至源",
      "description": "絲柯克每透過突破天賦<b><span style=\"color:#FFD780FF\">理外之理</span></b>的效果汲取一枚虛境裂隙，就會獲得一層極惡技·斬效果，絲柯克可以消耗該效果進行協同攻擊，並降低在<b><span style=\"color:#FFD780FF\">七相一閃</span></b>模式下受到的傷害，該效果持續15秒，至多疊加3層，每層獨立計算持續時間。<br/>需要解鎖突破天賦「理外之理」。<br/><br/><span style=\"color:#FFD780FF\">極惡技·斬</span><br/>·施放元素爆發<span style=\"color:#FFD780FF\">極惡技·滅</span>時，將消耗所有的<span style=\"color:#FFD780FF\">極惡技·斬</span>層數進行協同攻擊，每層<span style=\"color:#FFD780FF\">極惡技·斬</span>會造成相當於絲柯克攻擊力750%的<span style=\"color:#99FFFFFF\">冰元素傷害</span>，該傷害視為元素爆發傷害。<br/>·絲柯克在七相一閃模式下進行的普通攻擊，第三段攻擊或第五段攻擊命中敵人時，將消耗一層<span style=\"color:#FFD780FF\">極惡技·斬</span>，進行3次協同攻擊，每次協同攻擊造成相當於絲柯克攻擊力180%的<span style=\"color:#99FFFFFF\">冰元素傷害</span>，該傷害視為普通攻擊傷害。<br/>·絲柯克在七相一閃模式下受到傷害時，將消耗一層<span style=\"color:#FFD780FF\">極惡技·斬</span>，使本次受到的傷害降低80%，並對附近的敵人進行3次攻擊，每次攻擊造成相當於絲柯克攻擊力180%的<span style=\"color:#99FFFFFF\">冰元素傷害</span>，該傷害視為重擊傷害。",
      "level": 6
    }
  ],
