    },
    {
      "id": 202100,
      "name": "「滿分的偵察騎士」",
      "description": "安柏的裝扮款式。具備高機動性的偵察騎士服裝。",
      "isDefault": true,
      "characterName": "安柏",
      "characterId": 10000021,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Ambor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "偵察騎士安柏，前來報到！今後有什麼需要幫忙的，儘管說好啦！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·興趣",
      "text": "好想跑一會步呀。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·掛念",
      "text": "要是被琴發現我們在偷懶，她會不高興的。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·新發現",
      "text": "那邊好像有什麼奇怪的東西耶…不去看嗎、不去看看嗎？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候·擔憂",
      "text": "下雨了…蝴蝶結會淋濕的…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雨的時候·提醒",
      "text": "下雨了啊…視野會有影響，要小心哦。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雨過天晴…",
      "text": "唔哇~天氣真好。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "嗯…要是風大點就好了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起風的時候·愜意",
      "text": "真是舒服呀…"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "起風的時候·放鬆",
      "text": "我喜歡這種天氣，嗯…真輕鬆！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安喲！要不要一起晨跑？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#可以跟{F#妳}{M#你}一起吃午飯嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "天黑了，要我點個火把嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "沒錯，休息也很重要！那就說好了哦，明天見！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於安柏自己…",
      "text": "蒙德城的飛行冠軍，就是我啦！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·比賽",
      "text": "#就算是{F#妳}{M#你}，比賽我也不會放水！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·飛行",
      "text": "#教{F#妳}{M#你}飛…與{F#妳}{M#你}一起飛行的時候，我自己好像也能飛得更快…欸，{F#妳}{M#你}在笑什麼啊？來比賽吧！現在就比！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」，是神對我的認可吧。嗯，我要成為最優秀的偵察騎士才行！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "走嘛~去大教堂的鐘樓上看看，風景超棒的！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "看，那裡有鴿子！嗯…想跟牠們一起飛呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於琴·幫忙",
      "text": "大團長出征之後，大大小小的事務都壓在了琴的身上。如果我也能多幫到她一點就好了…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於琴·關懷",
      "text": "琴可能還在工作？…走，一起請她喝杯咖啡吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於麗莎·聽故事",
      "text": "#等{F#妳}{M#你}有空，我們一起去找麗莎吧！她上次和我講了一個龍脊雪山寶藏的故事，只講到一半。唔，我還想知道後續！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於麗莎·欽佩",
      "text": "麗莎好像除了睡覺的時間都在看書！真厲害啊，我就坐不住那麼長時間。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於凱亞·憂慮",
      "text": "#…有種不安的感覺！剛才是凱亞陪著{F#妳}{M#你}吧？他沒給{F#妳}{M#你}添麻煩吧？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於凱亞·禍首",
      "text": "花圃裡的蒲公英看上去蔫蔫的，哼…一定又是凱亞搞的鬼！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於班尼特…",
      "text": "#嗯？班尼特…好像在哪裡聽過…哦！{F#妳}{M#你}說的是冒險家協會那個熱血的男孩子啊！嗯，我有時會在秘境附近見到他，好像對尋寶很有熱情呢。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於可莉…",
      "text": "可莉呀，偶爾會有點調皮，但騎士團的大家都很喜歡她！唔…為了不讓她又被琴抓去關禁閉，還是看緊她一點吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "阿貝多，大多數時候都待在自己的工坊裡，搞一些很厲害的東西。但是，見到他的時候，會有種猜不透他在想些什麼的感覺。嗯，猜不透呢…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於諾艾爾…",
      "text": "#{F#妳}{M#你}問諾艾爾嗎？她的韌性可是很強的。作為前輩，{F#妳}{M#你}也要多照顧她一點哦。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於優菈…",
      "text": "#優菈是我的好夥伴！只要習慣了優菈開的玩笑，{F#妳}{M#你}就會發現，其實她是很好相處的。只不過，優菈因為自己的姓氏，經常被很多人誤解，怎麼樣才能讓大家理解她呢…"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於柯萊…",
      "text": "柯萊寫信給我說，她的「魔鱗病」已經徹底康復…我太為她高興了！真想下一秒就飛到她身邊，緊緊地抱住她。她還說很想念蒙德的大家，想等哪一天獨當一面之後，親口來彙報自己的成長…啊，要是能趕上下一次羽球節就好了，我都快等不及了！"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於米卡…",
      "text": "哦，米卡是優菈那邊的老隊員了，最初可能是看我和優菈關係比較好吧，總是長官長官地叫我。在我跟他分享自己的偵察心得之後，他又改叫我前輩了…弄得我滿不好意思的。明明我們的職責不一樣，他在繪製地圖上的專業性，是我怎麼都比不上的。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解安柏·其一",
      "text": "狩獵我也很擅長哦！怎麼樣，想不想看看我的身手？還是…要來個狩獵比賽？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解安柏·其二",
      "text": "#和{F#妳}{M#你}分享我的飛行冠軍經驗吧！最重要的，就是要有勇氣！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解安柏·其三",
      "text": "#其實我不擅長解謎，羽球節裡看到猜謎的攤位都要繞著走…{F#妳}{M#你}呢？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解安柏·其四",
      "text": "#我因為爺爺才加入騎士團，因為琴留在了團裡。現在，是{F#妳}{M#你}陪我見到了蒙德以外的天空。我真的很開心。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解安柏·其五",
      "text": "#我還想去更遠的世界。我想去看天空的盡頭！{F#妳}{M#你}也會繼續陪著我的，對吧、對吧？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "安柏的愛好…",
      "text": "兔兔伯爵，今天也是乾乾淨淨的一天！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "安柏的煩惱…",
      "text": "#唔…{F#妳}{M#你}知道，怎樣才能做出好吃的月亮派嗎？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#琴泡的咖啡真的好香！有機會{F#妳}{M#你}要嚐嚐哦。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "只要不是冰鉤鉤果汁…唔…我都應付得來！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#哇，這個太好吃了。{F#妳}{M#你}真厲害！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "要是我也有這樣的手藝就好了…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#我不太習慣這種味道，抱歉啦！不是{F#妳}{M#你}的問題！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#嘿嘿嘿，生日快樂！來，這個給{F#妳}{M#你}，是我親手縫的「兔兔伯爵·特別定製版」…放心放心，是特別定製版哦，不會爆炸的！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哇！像乘著風一樣輕快~"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "現在的速度，沒有人能追得上了吧！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "蒙德的天空好像變小了…還是因為我的視野變大了？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我現在…比起最初跟{F#妳}{M#你}認識的時候，又進步了不少吧。嘿嘿，非常感謝！讓我請{F#妳}{M#你}吃蜜醬胡蘿蔔煎肉吧，跟我來跟我來！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "靠你囉。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "兔兔伯爵，出擊！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
