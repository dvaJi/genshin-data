  "outfits": [
    {
      "id": 212000,
      "name": "夜想曲",
      "description": "菲林斯的裝扮款式。黑色制服與腰間垂下的銀鍊裝點了這位紳士的風度，菲林斯提起幽藍的燈火，守望挪德卡萊冰冷的海水與列島，夜復一夜。",
      "isDefault": true,
      "characterName": "菲林斯",
      "characterId": 10000120,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Flins_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "克里洛·楚德米洛維奇·菲林斯，向您問好。報上全名是對待貴客應有的禮節，至於選擇用哪個名字稱呼我…以前有許多人習慣用「楚德米洛維奇」，方便起見，還是叫我「菲林斯」吧，這是我的氏名。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·耐心",
      "text": "讓我們對人類的複雜性和豐富性保有一點耐心，少數人的荒唐卑劣不值得我們激憤。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·狂獵",
      "text": "如果誰想窺視深淵，就盡情在挪德卡萊的夜霧中遊蕩吧。狂獵的行軍自會前來將他捲入黑暗。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·幽靈",
      "text": "為什麼要恐懼幽靈呢？他們只是一群會說話的影子，一刻不停地嘮叨自己的身前事。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "#{F#妳}{M#你}在擔憂嗎？普通的雨無法澆滅我的燈火，放心。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "聽，世界最初的交響樂。沒有一種器樂能重現雷鳴的激烈與宏大。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "每一場雪都是來自至冬的呼喚，那是我血脈的歸處。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "「風已醒來，落葉飛旋…」"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "空中飛舞著黃色的雪。啊，這就是傳說中的沙漠。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安。太陽又照亮了挪德卡萊，和過去幾百年間的每天一樣。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午安，我沒有午睡的習慣，如果{F#妳}{M#你}需要的話，請自便。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "我更喜歡在晚上活動，燈就是用來照亮黑暗的，不是嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#午夜才是我的時間，正巧{F#妳}{M#你}也沒有休息，那麼趁著月亮還掛在天上，讓我們來講點古老的故事權當消遣。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於菲林斯自己·美德",
      "text": "慎重、謙遜以及忠誠，我認同執燈人所倡導的三大美德。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於菲林斯自己·執燈士",
      "text": "不論人還是妖精，只要活著就需要某種身分，這是將我們固定在世界上的重要理由。執燈人立誓在怪物肆虐的寒夜守護他人的光明。恰巧我屬於夜晚，夜行的怪物總是需要懼我三分，這個身分對我來說再適合不過了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·同行",
      "text": "能和您這樣出色的人同行一段是我的榮幸。夜快深了，需要我為您掌燈嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·妖精與人類",
      "text": "不知不覺，我們前進了相當長的一段距離。這讓我想起了從前的那個時代，妖精與人類曾經自由共行於至冬。我們的種族之間有許多相似之處，我曾猜測或許是因為血脈上本源相近，現在，我會說那些良善的念頭背後總能尋找到相似的靈魂。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「月之輪」…",
      "text": "不，妖精不需要月之輪，妖精有妖精自己的方式。但它的造型不錯，配這件黑色的大衣正好，還能替我的力量做個掩護…對於這些能夠幫助我融入故土的幌子，我自是來者不拒的。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "您試過詢問挪德卡萊的居民們在這裡停留的原因嗎？我試過，他們會選擇此地，大多不是因為這裡宜居，也不是因為他們對這片土地上的生活有什麼美好的期待。這裡僅僅是旅人在風雪中作片刻喘息的庇護所，人很難對臨時庇護所產生歸屬感，過客們休息夠了總要離開。\\n您的下一站是至冬吧？那裡的雪原很美，祝您旅途順利。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "您是說在稻妻的地下存在著失落的國度，那裡存在著過去的人留下的「常世之靈」嗎？滿有趣的，有機會的話，我倒是很樂意去看看。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於菈烏瑪…",
      "text": "亥珀波瑞亞，黃金的失樂園，看見她相貌的時候我便想到了。高貴古老的血脈與她華麗的角冠同等沉重，而她還是背負起一切向前走了，這份堅韌與勇敢值得尊重。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於葉洛亞…",
      "text": "「執燈人」成員的去留全憑自願，許多人來了又走，只有最執著的那些才會堅持，葉洛亞就是如此。比起「機敏」、「狡黠」這類受一般人追捧的特質，我認為「執著」更值得珍惜。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於愛諾…",
      "text": "不得不承認，我不擅長應付機械，在這方面，我和愛諾小姐的能力差異比年齡差距還要大。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "我肯定不可能與法爾伽先生比劍，要知道世界上可是沒有比北風更冰冷的劍鋒了。金屬的利器怎麼配跟自然的怒號相提並論？應該說，若有朝一日能與這位老派的正統騎士過招，將是對我莫大的提拔。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於奈芙爾…",
      "text": "奈芙爾小姐的直覺敏銳得像一把刀，沒有人會希望這把刀落在自己頭上。好在我沒有打聽別人身世的愛好，希望她也是同樣。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於雅珂達…",
      "text": "#{F#妳}{M#你}總能在意想不到的地方見到雅珂達小姐，譬如蛋捲工坊廢棄的雜物堆旁，又譬如那夏鎮某位大戶人家的露臺上。她正在飛快地學習著事關生存的哲學，而挪德卡萊這片土地是她無聲的老師。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「女皇」…",
      "text": "挪德卡萊是至冬領土的一部分，不過我們沒有說「女皇在上」這種話的習慣。「我們」指的是誰？自然是「執燈人」…不然呢？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解菲林斯·其一",
      "text": "您想要瞭解我這個普通執燈士的什麼呢？我的名字您已經知曉，我的駐所您儘管觀光，難道您期待從我口中聽到什麼波瀾壯闊的人生經歷嗎？那種事情不存在。作為一個執燈士，我的生平乏善可陳，只是提著燈在挪德卡萊的每日每夜戒備狂獵而已。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解菲林斯·其二",
      "text": "如您所見，狂獵是氾濫於整個挪德卡萊的災害，有武力的人或許可以依靠手中的武器自保，但存在著這樣一種狂獵——您無法透過驅散所有伴隨狂獵而生的魔物逃脫，魔物會出於某些難以名狀的原因源源不斷地出現。我見識過幾次這樣的棘手情況。\\n儘管我深知您身手不凡，但狂獵的複雜與麻煩程度不可小覷，一旦遭遇狂獵，請務必通知附近的執燈人，或者直接找我。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解菲林斯·其三",
      "text": "沒想到像您這樣久經風霜的人士心中，仍保持著年輕冒險家那般熾熱的好奇。\\n唉…讓我想想，菲林斯這個人物的身上還有什麼具備故事性的部分值得拿出來供您翻閱。\\n哦…我的燈和部隊配發的制式燈不同，它已經陪伴了我很久。時光在它身上落下的重量足以嚇退大多數蠕動的幽影。有鬼魂臨終前說，比起那些不入流的同伴，它才更像恐怖本身。\\n這些能讓您滿意嗎？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解菲林斯·其四",
      "text": "幾乎每個在挪德卡萊逗留的人都有自己複雜的過去，人類無論何時都是這樣，靈魂深處燃燒著蓬勃的欲望。每個夜晚，人類囈語中黑色的憂慮像霧氣一樣流淌，地脈裡的回憶湧動向不同的方向。現在的挪德卡萊是混亂的地方，過去的它並沒有這麼糟。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解菲林斯·其五",
      "text": "#請允許我不再使用尊稱，能將我與往事串聯起來的人，這世上已經沒有幾位了。話雖如此，我不希望{F#妳}{M#你}待我有所特殊，畢竟扮演人類仍將是我長期保留的小小愛好。\\n讓我們把風霜、石堆、苔蘚和海水的腥味留在這裡吧。我整理了一些錢幣，採買物資的日子到了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "菲林斯的愛好…",
      "text": "#{F#妳}{M#你}對古錢幣以及舊寶石感興趣嗎？它們本身就價值不菲，在此之外，歲月在它們形體上刻下的痕跡更為美麗，就像陳年美酒一樣優雅。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "菲林斯的煩惱…",
      "text": "皮拉米達城的同僚時不時寫信來對我的生活投以關切，那是一位善良的老先生。但我現在的住宿環境非常舒適，不需要改進，也不需要送貓或者狗來。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#見過水在火焰中沸騰的樣子嗎？啊，太可惜了。\\n至冬有一種叫做「火水」的酒，點燃它，{F#妳}{M#你}就能看到火焰在水上燃燒。而且口感不錯，能讓{F#妳}{M#你}從靈魂深處暖和起來。有機會一定邀請{F#妳}{M#你}試一試。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#鑑於我們的關係日漸熟絡，可否原諒我在此提出一個小小異議？{F#妳}{M#你}應當知曉我的某些微妙情況…那些常人樂享的食物，對我而言並無多大趣味。啊，請別誤會，我仍然非常享受與{F#妳}{M#你}同座時的用餐時光。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "我一向不懷疑您的才能。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "當然，當然，它們的味道相當好。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "為我們之間的良好關係考慮，請別詢問我的感想。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#為了慶祝人來到世上，愛他的人為他舉辦生日宴會、獻上歌聲與祝福；為了哀悼人的離去，思念他的人為他舉辦葬禮、點亮幽燈。無論生死，總有人會為{F#妳}{M#你}的存在動容。趁靈魂鮮活，去融入人群，享受屬於{F#妳}{M#你}的歡樂吧…難不成{F#妳}{M#你}還在等我扮演那根被吹滅的蠟燭？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "您這是在表達勉勵嗎？對此我表示衷心感激。順帶一提，希望您的勉勵可以繼續下去。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "近來您似乎很熱衷於為我訓練，希望我的進步速度能夠達到您的預期。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "當一位戰士想要進步，除了磨練武藝，還要思考戰術。按照我以往的作戰經驗來看，能夠大範圍殺傷敵人的武器和戰略更受青睞，這也是我選擇長柄武器的理由。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#儘管我們不曾就此話題深入探討，但我想智慧如{F#妳}{M#你}一定與我有著類似的觀點：武藝是一門關於嚇阻的藝術，而不是爭奪的手段…否則，事情就變得太簡單了。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "看。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "閉眼。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "安靜。"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "怕黑嗎？"
    },
    {
      "id": "200005",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "入夜了。"
    },
    {
      "id": "200006",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "墜滅。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其四",
      "text": "夜客致訪。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其五",
      "text": "謹防，榻下爪眼。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其六",
      "text": "睡吧，無夢地安眠。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "這些珍寶或許會對您的旅途有所裨益。請，它們屬於您了。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "看起來我是與世隔絕太久了，介意告訴我四處擺放寶箱的風尚是何時流行起來的嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "也算是不錯的收藏。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "生死一線了啊。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "久違的窘迫感。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "呵，該擔憂的是你。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "請勿憂心。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "由我接手吧。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "我們墓裡見。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "熄滅吧…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我必如雪崩再來。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "…注意距離。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "您熱情過頭了。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "何必呢？"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "聽憑差遣。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "與同伴並肩作戰是一種享受。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "需要我來引路嗎？"
    }
  ]
}