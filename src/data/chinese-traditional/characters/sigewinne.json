  "outfits": [
    {
      "id": 209500,
      "name": "大海的甜色",
      "description": "希格雯的裝扮款式。明亮的色彩代表了護士長希格雯本人，明亮的她為黯淡的海底生活帶來了一線陽光。",
      "isDefault": true,
      "characterName": "希格雯",
      "characterId": 10000095,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sigewinne_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "怎麼了啊？別緊張，我是梅洛彼得堡的護士長希格雯，讓我看看…這裡痛嗎？這裡呢？哦哦…不是來看病的？那太好了，呼…這麼可愛，要好好愛護身體，不要弄壞自己了哦。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·貼紙",
      "text": "#沒有哦，我沒有在{F#妳}{M#你}背後貼貼紙。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·關心",
      "text": "唉呀！哪裡磕到、撞到了嗎？不舒服要隨時叫我喲。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·保養",
      "text": "保養身體很重要，同樣不能忽視的是保養好自己的內心。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "啊…不知道那維萊特先生此刻在想些什麼呢…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "十分新奇，是只有在水面之上才能聽到的聲響。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "買了一雙新的防寒手套。看，美露莘的小圓手回來了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "叮咚，來自「海露花」的小提示：曬太陽前先塗好防曬霜可以保護皮膚呦。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "請記得補充水分哦。還好那維萊特先生有愛喝水的好習慣。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安，睡得好嗎？洗臉的時候建議用溫水，這樣對皮膚的刺激最小。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "唉呀，午飯時間快到了，我要暫時離開一下下。噓…請替我保守秘密哦。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "幾點了啊？在水下待久了，下意識要看看鐘錶才能夠區分白天黑夜了…不哦，我不覺得壓抑，與其說習慣了…不如說我喜歡黑漆漆的地方。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#感覺入睡很困難？照理說…{F#妳}{M#你}的身體沒有異樣。唔…明白了。來聊聊心事吧，一起試著找出阻礙{F#妳}{M#你}休息的病源。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於希格雯自己·雙手",
      "text": "我很喜歡人類的雙手，不管是剪繃帶還是拿針管都很靈活，麻醉槍拿起來也非常順手。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於希格雯自己·「海露花」",
      "text": "「海露花」是我在《花容美譚》撰稿用的筆名，這個名字其實是大家票選出來的。當時我跟幾位美露莘朋友擬了三個選項，貼在公告板上請大家投票。事實證明在人類的審美中，比起「堅盾重甲蟹」和「泡泡雄海馬」，「海露花」更能跟美容保養的主題掛鉤哦。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·招呼",
      "text": "#嗨嗨~嗯？似曾相識的動作？呵呵，看來{F#妳}{M#你}已經見過一些美露莘朋友了。沒錯哦，身體微微前傾，迅速地擺擺手…這樣打招呼表示友好，{F#妳}{M#你}好{F#妳}{M#你}好呀。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·信任",
      "text": "#我記得哦，{F#妳}{M#你}不喜歡苦味所以把藥劑藏起來沒有喝。其實後來我請{F#妳}{M#你}吃的那盒糖果裡，除了糖果還有我摻進去的藥丸，經過重新調製後苦味應該不明顯…{F#妳}{M#你}說{F#妳}{M#你}那時就吃出來了？哈…謝謝{F#妳}{M#你}願意這樣信任我。那麼，以後我也會繼續為{F#妳}{M#你}的健康著想，也請{F#妳}{M#你}繼續乖乖配合了。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "神之眼能夠讓我更輕鬆地打倒阻礙，搶回不少寶貴的治療時間。會有什麼阻礙？根據經驗…有些是不懷好意想要阻撓治療的人，有的是不肯配合的患者本人…不過除了個別極端情況外，我更傾向於藉助神之眼的力量製造輕盈多彩的泡泡，安撫身心之餘又可以點綴氣氛，在泡泡的環繞下我和美露莘朋友們拍出過不少好看的畫片呦。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "人類在生病時會變得尤其脆弱。平常叫囂著去拳力鬥技場比試的高高大大的人被告知需要打針時，也會露出像膨膨獸一樣的表情。我準備了很多糖果和貼紙來安慰這類愛哭的病人，每次都十分奏效，他們臉上很快就陰雨轉晴了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#喜歡游泳嗎？梅洛彼得堡外面的水域同樣是黑漆漆、亂糟糟的，我猜{F#妳}{M#你}也喜歡吧？啊，眉間的肌肉收縮了，代表{F#妳}{M#你}有點為難…明白了，那我們去塞洛海原潛水吧！好久沒去看悠悠海獺玩耍了，我可以看一整天，但請注意不要傷害牠們，也不要搶牠們手上的小貝殼哦。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於那維萊特·敬愛",
      "text": "#那維萊特先生將美露莘們帶來楓丹廷，為我們安排適合的工作。我們跟他一起嘗試融入楓丹，發掘人類的美好。對我而言，我非常敬愛他，也很喜愛人類。嗯？{F#妳}{M#你}問那維萊特先生和人類同時掉進水裡先救誰？很簡單，他一定會跟我一起合力救人類上岸哦。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於那維萊特·眷屬",
      "text": "美露莘是那維萊特先生的眷屬，但不代表他會給予我們超出律法和公正的偏愛。當初我乖乖接受了那維萊特先生的審判，我認同他的判決。還記得出發去梅洛彼得堡那天下了好大好大的雨，但我一點都不覺得雨點冰冷，反而非常溫潤，就像那維萊特先生的目光一樣…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "公爵是我見過最能忍受疼痛的人，那時他還沒這麼高大和強壯，每次來醫務室縫合傷口時都拒絕打麻醉針，說著要保持清醒之類的話，真是個很了不起的小大人呢。現在嘛…當然是個了不起的大大人囉。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "#克洛琳德小姐講話時不會有太多面部表情，很難從她的面部神態讀懂她的心情…{F#妳}{M#你}說她用了我送的唇膏？真的嗎？呵呵，她能喜歡那真的太好了，那個顏色果然很適合她對吧！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "楓丹美容協會定期會舉辦交流會，我很珍惜跟大家聊天的機會。大部分人聽到我的稱讚後都會低著頭紅著臉說哪有哪有，只有娜維婭小姐每次都會高興大方地接受誇獎，然後握著我的手邀請我一起合影留念。她就像株光芒四射的黃玫瑰，不管白天黑夜晴天陰天都那麼的耀眼。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "我喜歡看夏洛蒂小姐拍的畫片，可以仔細觀察到大家在不同情況下的面部肌肉，緊繃的、鬆弛的、上揚的、垮下來的…嘿嘿，非常值得回味。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於林尼…",
      "text": "我很抱歉對林尼先生打出了那槍麻醉針…在當時那種緊急的情況下，那的確是讓他受到最少傷害的辦法…慶幸的是，後來他瞭解到我沒有惡意後，也放心地讓我治療了菲米尼先生。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於琳妮特…",
      "text": "#琳妮特小姐兼具了人類和貓貓的雙重可愛！我稍微觀察了一下，她在喝茶和吃蛋糕時耳朵會微微向前，呵呵，真想摸摸她的頭…{F#妳}{M#你}也一樣？下次我們一起去徵求她的同意吧？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於菲米尼…",
      "text": "他身體恢復後主動找我道了謝，是個很有禮貌的孩子呦。講話輕聲細語的…看得出來平常大概不太擅長主動跟別人打交道，但我可以感受到他的內心世界一定非常豐富而細膩，因為他仔細地翻看了美露莘們畫的畫，看得極其入神。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於千織…",
      "text": "美露莘的身體跟人類不同，很難買到適合的衣服。就算是我，試穿人類的童裝時也會煩惱尾巴應該怎麼擺放…不過好在千織小姐推出了針對美露莘的訂製服務，現在所有美露莘朋友都有機會穿上喜歡的漂亮衣服了。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "艾梅莉埃小姐設計的香水經常登上各種美容雜誌的推薦榜單。我已經計劃好下次休假要提早結束在沫芒宮的拜訪，抽出時間在楓丹廷好好逛逛，多買一些艾梅莉埃小姐的香水回去送給可愛的女孩子們，嘻嘻。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於愛可菲…",
      "text": "愛可菲小姐在梅洛彼得堡待的時間不長，但她給了我很大的鼓勵喔！我做的每一杯飲品，她都認認真真，不急不慢地喝完了，而且還非常仔細地向我描述了她感受到的味道…雖然她的專業用詞我聽不太懂，但她的面部表情僵硬得十分可愛喔！有機會的話，我還想再寄幾箱健康奶昔給她！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解希格雯·其一",
      "text": "在我的醫務室沒有什麼「負罪的人在他應在的路上」，只有「生病的人在他應躺的床上」。不管是誰，把身體養好了才能繼續坐牢贖罪不是嗎？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解希格雯·其二",
      "text": "很多病痛都是累積而來的，平常愛護身體至關重要，可惜很少人懂得這個道理。明明累得眼睛都快睜不開了，還要咬著牙在生產區工作…我只好悄悄他們加菜，如果還是不肯乖乖休息，使用麻醉槍之類的強硬治療手段也是沒有辦法的事。唉…特許券是賺不完的，還是不要勉強自己為妙哦。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解希格雯·其三",
      "text": "#工作不忙的時候我會邀請奧蒂涅和梅莘她們來醫務室喝茶，我們有時會聊最近的案件，有時聊美容雜誌上推薦的保養品，我們通常是會一起畫畫，把覺得可愛的東西畫下來做成貼紙，再找機會送給可愛的人…啊，請稍等一下，我這裡有一張要送給{F#妳}{M#你}。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解希格雯·其四",
      "text": "在很久以前的楓丹，人類跟美露莘的關係並不像今天這樣融洽。有些人聽說美露莘是從厄里那斯的血肉中誕生的，對我們又恨又怕…有的人出於對那維萊特先生的不信任，連帶不相信美露莘…還有人也許並沒有想太多，光是看我們跟人類長得不一樣，就會下意識疏遠…那個時候想跟人類做朋友真的是很困難的事情呢…所以我很珍惜那位明知我是美露莘，還願意牽起我的小圓手的人類女孩…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解希格雯·其五",
      "text": "我的老師告誡過我說：「醫生最大的責任是治好自己能治好的病」。我明白醫生不是神明，再了不起的醫生也會有攻克不了的疾病。但沒關係，美露莘的生命很長，只要我不斷鑽研醫術，我治得好的病就會越來越多，病痛的苦難就會越來越少。我會以老師為榜樣，用盡我所掌握的醫術去救自己能觸及的人…只要結局是好的，只要沒有傷害別人，我願意採取任何手段，並承受過程中產生的風險。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "希格雯的愛好…",
      "text": "在我讀過的所有書裡，我最喜歡《笑的意義》，裡面提到的知識不僅有趣，還可以在日常中輔助我診斷病情。例如有些人從拳力鬥技場出來時，嘴上雖然掛著笑容但臉上其他肌肉都非常扭曲，這種笑通常是為了掩飾自己挨完揍的傷痛——遇到這種情況就請悄悄地叫他來我這裡包紮吧。不過記得要「悄悄地」，否則他的強顏歡笑就失去「笑的意義」了，嘻嘻。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "希格雯的煩惱…",
      "text": "奇怪，儲藏間的空間越來越不夠用了，機關零件快放不下了。我明明還滿會收納東西的啊？嗯嗯…看來該找個時間跟公爵商量一下擴大儲藏間了呢…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "好的食材有很多，各有各的營養價值，我想了一個把食材全部混在一起的好辦法，要喝喝看我特製的營養奶昔嗎？"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "喝茶雖好，但過量的話對健康是弊大於利的。唉…這個道理我跟公爵說過很多遍了…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "吃得出來用了很多新鮮的食材…嗯，說不定可以將這些絞碎加進營養奶昔裡…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#要是韋爾賽先生能夠有{F#妳}{M#你}這位助手幫忙，美味料理的比例一定會大大提升。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#這是給我的「加菜」嗎？很感謝哦，{F#妳}{M#你}願意跟我一起分享嗎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！根據我的觀察，{F#妳}{M#你}平常需要進出不同場合，所以我專門為{F#妳}{M#你}調製了一套兼顧便捷性和實用性的保養組合。來來，請躺下，閉上眼睛，我來示範一次怎麼用吧。先幫{F#妳}{M#你}濕敷一下臉蛋，平常要是趕時間，稍微把臉打濕就可以了哦…然後擠上適量的潔面膏，順著肌肉輕輕打圈按摩再沖洗乾淨…最後一步，塗上加了汐藻成分的保濕霜…好囉，容光煥發，請可愛的人盡情享受屬於{F#妳}{M#你}的節日吧！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "今天也請繼續對自己的可愛負責哦。別擔心，我也會幫忙的。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#沒看錯哦，滿足的時候美露莘的尾巴會一搖一擺，真的很謝謝{F#妳}{M#你}送我這些。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "哇…握麻醉槍的手更穩了，想試試看單手開槍的準度…我們出門找些目標怎麼樣？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "也許美露莘和人類看到的世界不太一樣，但我始終相信我們對情誼的感知是相通的，情誼是可以跨越種族的。請握住我的掌心，感受得到嗎？我真心的溫度。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "別動喲。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "我看看。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "冷靜。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "吹泡泡。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "晃悠悠。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "飄忽忽。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "謹誓！精研醫理。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "別緊張哦，放鬆。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "醫囑：即刻注射。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "不要摔跤喲。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "請盡量控制住笑肌喲。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "如果有機關零件的話，能夠讓給我嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "可愛的人值得最好的寶物。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我能夠治療自己！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "還有止痛藥。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "沒關係的…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "看來得強制治療了…"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "救援到了！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "還有病人在等我…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "好冷…好痛…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "治不好了…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "不。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "生氣了！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "你不可愛！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "我來負責監測健康吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "麻醉劑…嗯，夠了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "打擾了喲。"
    }
  ]
}