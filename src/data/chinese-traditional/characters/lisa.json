    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#嗨，小可愛，{F#妳}{M#你}是新來的助理嗎？啊？魔導師大人？那是很久以前的事啦，現在的我不過是一介圖書管理員而已。放心吧，姐姐會照顧好{F#妳}{M#你}的。那麼…"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·下午茶",
      "text": "明明是該喝下午茶的時間。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·任務",
      "text": "任務是做不完的，還不如陪姐姐…聊會天。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·不宜出門",
      "text": "今天不宜出門…欸，我昨天也是這麼說的？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "這種天氣，泡一杯茶，坐著看雨多好。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#在雷雨天訓練事半功倍哦~呵呵，騙{F#妳}{M#你}的。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "起風的時候…",
      "text": "天氣真好，能躺下來補個覺就更好了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "啊…早安，琴。嗯？不好意思，我看錯了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午休時間到了…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#{F#妳}{M#你}還不睡嗎？我已經睏了呢…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}努力的樣子，姐姐全都見到了哦。嗯…讓我想想，給{F#妳}{M#你}什麼獎勵吧…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於麗莎自己…",
      "text": "這可不是偷懶呀。誰不想用最省力的方法達到目的呢？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·關係",
      "text": "#{F#妳}{M#你}想把我當作{F#妳}{M#你}的老師、前輩，還是朋友？都可以哦。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·本領",
      "text": "#哎呀，再不拿出點真本事出來，就對不起{F#妳}{M#你}的努力了吧。嗯哼，也好也好。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·儀式",
      "text": "#再等一下，「將悔罪的記號吻在弟子的前額」…好了，那麼儀式就完成了~今後{F#妳}{M#你}就是我麗莎的首席弟子了喲。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#「神之眼」啊…那可是導引元素力所必要的裝置呢。唯獨在{F#妳}{M#你}身上卻是例外。唔…究竟是什麼原理呢，啊，有了，{F#妳}{M#你}…有空陪姐姐做個實驗嗎？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "圖書館樓上的煉金工坊，可以隨意使用哦？不過進去之前記得敲門，如果撞見什麼不該見到的東西那就麻煩了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "嘟嘟蓮是有著解毒功效的藥草。有了它，就不用再擔心魔藥的副作用了…哼哼。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於琴…",
      "text": "琴是個稱職的好團長。看到她認真工作的樣子，就連我也忍不住想要多幫她一把。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於安柏…",
      "text": "小安柏剛進騎士團的樣子我還記得呢，一轉眼都那麼能幹了。啊，再過幾年，又會變成什麼樣呢？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "#芭芭拉的歌，{F#妳}{M#你}有聽過嗎？哼哼，聽說她的旋律裡有種治癒的魔力在流動喔。和我的魔藥相比，不知道哪邊更合{F#妳}{M#你}的胃口呢？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "哦，想聽迪盧克的故事？哈哈，那我知道一個更好的聊天對象。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於雷澤…",
      "text": "小狼狼，來來，過來這邊。今天就臨時來一場實戰練習吧，對手我已經給你找好了喲。欸？怎麼跑了，真是的…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於可莉…",
      "text": "#上次小可莉想借用我的工坊做實驗，被我拒絕了，她可是生了我一天的氣呢。嗯？{F#妳}{M#你}問第二天？第二天，她當然又高高興興地出門去玩了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於莫娜…",
      "text": "莫娜？似乎是一位很優秀的魔導師小姐呢。但我並不是她們「魔女會」的成員哦。古樹考察，組織茶會，一聽就是麻煩的事情吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "#姐姐我覺得，阿貝多是很優秀的煉金術士。跟他只需要用三言兩語，就能得到不錯的結論。而且臉也長得好看。和小可愛{F#妳}{M#你}很像喔，嗯。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於菲謝爾…",
      "text": "菲謝爾…哦，那個總是來圖書館借幻想小說的女孩子。每次還書都會提前三天，對書籍也十分愛護，是個好孩子呢。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於諾艾爾…",
      "text": "拜託諾艾爾清掃書架的時候，總感覺這孩子，越是疲憊就越開心，嗯…到底是怎麼回事呢？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於砂糖…",
      "text": "沒事就不要去打擾小砂糖哦，會嚇到她的。呵呵，她擅長和各種各樣的生物打交道，卻唯獨，不怎麼善於和人類相處呢。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於賽諾…",
      "text": "離開須彌之後，除了和恩師保持禮節性的通信，我和教令院已經沒有什麼往來了。幸好，不是每位被寄予了重望的弟子，都像我一樣怠惰…聽說那位師弟賽諾就相當活躍呢。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於柯萊…",
      "text": "小柯萊每次寫信都會使用新詞，嘗試與之前不同的表述方式。呵呵，也難怪她進步得那麼快。除了自己的努力之外，她那位善良而又熱忱的師父，一定也給予了很多幫助吧。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於米卡…",
      "text": "#真羡慕霍夫曼先生有這樣一位擅長照顧人的弟弟。不僅幫著打點生活起居，連喝醉後的護理也無微不至。啊，我也好想什麼都不用操心，懶洋洋地度過每一天啊…嗯？{F#妳}{M#你}說我現在也差不多？哼，小可愛…膽子變大了嘛。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於布倫妮…",
      "text": "小布倫妮啊…總喜歡借一些晦澀難懂的書，只要我稍微靠近一些，或者對她笑一下，她就會像一條琉璃花鱂，突然就掙扎起來。呵呵，可愛極了。真慶幸我不是她要找的「魔女」，不然，要是被這麼認真的小獵人「盯上」了，姐姐我都不知道該怎麼辦了呢~"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解麗莎·其一",
      "text": "那麼，今天想學習哪種元素力的知識呢？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解麗莎·其二",
      "text": "我的過去？嗯？想要更多地瞭解我一些嗎？…可今天我恰巧有點累了。不過這份心意，姐姐我還是很高興的。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解麗莎·其三",
      "text": "#我教雷澤掌握元素力量的時候，完全沒想到那個孩子的悟性有那麼好。仔細想想的話，{F#妳}{M#你}也相當能幹啊，小可愛。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解麗莎·其四",
      "text": "#什麼？想學習須彌教令院的魔法？可對現在的{F#妳}{M#你}來說，負擔會有些重…啊？至少想學會入門的知識？那先看完這本《緒論》吧，也就800多頁而已。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解麗莎·其五",
      "text": "#總有一天，這「眼」中的力量會毀滅一切的吧…到了那時，如果有{F#妳}{M#你}在的話…啊，沒什麼。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "麗莎的愛好…",
      "text": "#小可愛，{F#妳}{M#你}想要來挑一瓶神奇的藥水嗎？喝下去之前完全不知道會有什麼效果，呼呼。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "麗莎的煩惱…",
      "text": "二樓的審訊大廳已經閒置兩年了，明明給我用作元素工坊的話，就不至於那麼荒廢…赫塔小姐真是死腦筋。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我喜歡蔬菜湯哦。只要把所有的蔬菜全都丟進一口大鍋子裡，再用長柄的勺子攪一攪…欸，問我好不好吃？哼哼，來，啊——"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我有南瓜恐懼症，每年的秋收節對我來說都太煎熬了。啊，要不要乾脆把南瓜這個物種，徹底抹除呢？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "真貼心呢，小可愛。姐姐我很滿意喔。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#呵呵，{F#妳}{M#你}很擅長做這些呢。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "哎呀…這可真是…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#來，拿著，護身符，就作為生日禮物送給{F#妳}{M#你}了。雖然製作起來花了我不少時間…不許弄丟哦。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "該不會想讓我加班吧…那可不好哦。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "鍛煉的機會，應該多留給新人，不是嗎？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "…要是我恢復全盛狀態的話，說不定會發生什麼不得了的大事喲。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#明明已經用各種方法勸過{F#妳}{M#你}了…真有{F#妳}{M#你}的，小可愛。到這份上還裝作無動於衷的話，恐怕連丘丘人都看得出來我在撒謊了。那就讓{F#妳}{M#你}見識一下，「薔薇魔女」的真實吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "哼哼。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "該電一電了。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "別逃喲。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "…Blitz！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "這是…懲罰哦！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "…呵呵~"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "酥酥麻麻的喲。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "快點投降吧。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "可別上癮喔。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "努力，獲得回報了喲。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "我也有興致了…"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "小可愛會喜歡嗎？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "有你的嘛。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "有點生疏了呀…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哎呀，手套要破了呢。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "逞強可不好。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "要姐姐幫忙嗎？"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "出門好累…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "看來我大意了呢…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "果然不該出門的…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "疼…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不要那麼粗暴。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "#讓姐姐幫幫{F#妳}{M#你}吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#我會看著{F#妳}{M#你}的。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "要出門了嗎？"
    }
  ]
