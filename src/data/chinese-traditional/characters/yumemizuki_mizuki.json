  "outfits": [
    {
      "id": 210900,
      "name": "晞吹捲夢",
      "description": "夢見月瑞希的裝扮款式。深宵冷霧濃，曉時枕貘醒春風，攬衣倦理夢。斜拔紫釵撥紫袖，動搖晞吹露月容。",
      "isDefault": true,
      "characterName": "夢見月瑞希",
      "characterId": 10000109,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Mizuki_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "您好，我是夢見月瑞希，一名「心理診療師」。如果您有什麼煩心事，儘管來找我傾訴。無論是多麼深沉的「噩夢」，我都會將它從您的心裡驅除，絕不會留下一絲陰霾。不相信嗎？那如果不耽誤您的時間…現在要來我的診療室看看嗎？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·心理診療",
      "text": "#昨晚的夢境…味道很美妙，感謝{F#妳}{M#你}與我分享。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·股東事務",
      "text": "上個季度的財務報表還沒看完…有點頭痛啊…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·鬱結",
      "text": "如果心裡鬱悶的話，就先放下手頭的事，出去呼吸一下新鮮空氣吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "陰翳的天氣，容易勾起人心深處的負面情緒…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "莫非…將軍大人今天的心情不好？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "陽光太過耀眼，倒也不是完完全全的好事，照得我有點暈眩…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "雨過天晴…",
      "text": "天上的烏雲散去了，是時候收拾心頭的陰霾了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "嗯，風力剛好，神清氣爽，心情也好。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "我已經把窗戶打開，讓房間通通風了。日出時分的清新空氣、逐漸明亮的天色，還有微涼的早風，都會讓人心情明朗…早安。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#在中午時分，可以略微午睡一會補充精神…但別睡太久，會頭暈的。需要我稍後叫醒{F#妳}{M#你}嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "快到夜晚了，希望大家都能按時入睡，別熬夜玩遊戲、看小說或者跳舞了…如果熬一個大夜，在凌晨才睡覺的話，睡眠的意義就大打折扣了…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}要睡了嗎？正好，請把這杯牛奶喝了吧。我在裡面加了一些草藥，能讓{F#妳}{M#你}睡得更好。晚安，{F#妳}{M#你}一定會做個好夢。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於夢見月瑞希自己·溫泉的差別",
      "text": "#納塔的溫泉池開在了廣闊的臨海位置。一邊享受涼快又清新的海風，一邊和夥伴們玩耍的體驗十分有趣。\\n但想在稻妻推廣的話，大家只會說：「和相熟的鄰居一起泡澡倒是不錯，但要和不認識的陌生人在溫泉池裡見面，感覺會很不好意思啊…」\\n{F#妳}{M#你}看，就連溫泉也有水土不服的說法。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於夢見月瑞希自己·「秋沙錢湯」",
      "text": "#{F#妳}{M#你}聽說過稻妻的室內溫泉「秋沙錢湯」嗎？其實我投資它的時候正在設計一套全新的心理療癒計畫，在計畫裡，我想先利用加入了各種草藥和香精的溫泉讓客人放鬆身體，進而放鬆心神，然後我再為客人進一步診療。\\n但是…「秋沙錢湯」的溫泉泡起來太舒服，客人泡著泡著就容易直接睡著。醒來之後，還一個勁地誇我診療手段高超。\\n我根本沒有做任何診療啊…客人感覺那麼好，只是單純因為好好睡了一覺而已…\\n明明是好好睡一覺就能解決的問題，為什麼會拖成那麼嚴重的疾病呢？\\n唉…大家就別勉強自己了，該睡覺的時候，還是要好好睡覺啊…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·旅程",
      "text": "我也算是一位旅者，造訪過提瓦特七國中的五國。即便如今定居稻妻，我也得時常去往納塔處理生意上的事務，所以我們是同路人，可以多多結伴同行。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·美夢",
      "text": "#食夢貘一族有項規定——未經允許，絕對不能吞食他人的美夢，那是人們珍貴的寶物，稍有損失便會催生失落的情緒。\\n但{F#妳}{M#你}是個特例，{F#妳}{M#你}的美夢就像是富饒的寶庫。幾百年來，我還從沒見過像{F#妳}{M#你}一樣明亮的人…"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我聽人說，「神之眼」是被神明注視之人的證明。在神明的視線下，才會有如此神蹟出現。但我也聽那些未曾被神明注視的人說…他們也期待著擁有「神之眼」。\\n渴求著不可求之物的人，就算在夢中獲得了期冀的寶物，在夢醒時分，反而會更加悵然失懷吧。\\n希望他們…不要為了追尋夢中的虛影，而把現實當作急於擺脫的噩夢。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "小安和小徹是我的夥伴，也是我的一部分——她們由我的妖力化形而成，分別代表著我的「智」和「靈」，是我心中理性和感性的顯化。她們偶爾會協助我診療，在不得不戰鬥時，也非常下得了手呢。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#在「流泉之眾」遇襲的前一天，我正從納塔趕回稻妻，事後才從瑪拉妮的來信中聽說{F#妳}{M#你}是改變局面的關鍵人物。這麼一想，結合神子的描述，我曾在稻妻和納塔兩次錯失與{F#妳}{M#你}見面的機會。好在如今，我總算與{F#妳}{M#你}這位傳說中的旅者相識了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於八重神子·舊事",
      "text": "幾百年前，我們曾是鄰居。神子那傢伙…以前可沒這麼沉迷於各種樂子。有時我還滿懷念的——她剛剛學會化為人形，天真單純的那段時光…那個時候她每天都要過來找我，要我嚐嚐她今天的夢是什麼味道。\\n我記得…有櫻花、紙張、墨水、三彩糰子，還有油豆腐。每次她都要抓著我化成人形，跑到城裡尋找和夢境滋味對應的東西。要是被人發現了，我們就會咻地一下變成原來的模樣，掉頭就跑，我常常還跟不上她。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於八重神子·現狀",
      "text": "現在，她已經是「八重宮司」大人了，不知道她如今的夢境還留有多少原來的氣味。\\n當然，我沒有再嚐過她的夢境，擅自吞食他人的夢是我們一族的絕對禁忌。就算宮司大人來找我，請我再嚐嚐她夢境的味道，我…恐怕也會拒絕吧。如今的我們，已經是彼此的競爭對手了。這次我必須跟上她。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "三川花祭後我鼓起勇氣邀請將軍大人共浴，那時她的一縷側髮飄進了溫泉水裡。我很想伸手幫她挽起來，卻又擔心這樣的肢體接觸會顯得冒昧。一想到神子會面不改色地這麼做，我就不由沮喪…我的修行，還需精進。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於珊瑚宮心海…",
      "text": "海祇島的那位現人神巫女舉止端莊，與她交談總是讓我心情舒暢。今後，若是要在海祇島拓展「秋沙錢湯」或其他店鋪的業務，我還想與她多多合作…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於宵宮…",
      "text": "#{F#妳}{M#你}是說那位「夏祭的女王」嗎？嗯，我對她的印象很深。\\n每隔一段時間我都會做一次診療統計，看看稻妻哪裡的居民最容易心力憔悴，哪裡的居民心情還算開朗，哪裡的居民又經常做噩夢…\\n而宵宮小姐家附近的人們幾乎沒有來診療過，我想應該是宵宮小姐幫助了他們吧？有這樣一位開朗活潑的鄰居作伴，想不開心都難啊。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "綾華小姐…在我離開稻妻前，她還只是個小女孩，那時她就在練習花道和劍道了。我有一次曾經被她的兄長暗中請去，為她消解憂鬱。\\n她的夢境裡…盡是老舊的木材味，混合著濕重的雨水氣息，就像是一座搖搖欲墜的木亭，孤零零地佇立在暴雨裡。我盡力為她診療，總算讓她得以平和入睡。\\n不知道綾華小姐心裡的那座木亭，如今是否已經找到了支撐，能夠安然待在暴雨裡了呢…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "在之前，九條將軍會定期請我去為天領奉行的人員做診療，其他人的心境有時候會有一些動搖，但在九條將軍的夢裡，我一直都只聞見了冷冷的金屬味，既沒有雨，也沒有太陽，就像是滿滿堆放著「玉鋼」的庫房一樣。\\n我對九條將軍這樣心智剛強的人非常敬重。\\n一個人到底要吃多少苦，要怎麼做…才能把自己的心鍛煉成如今這樣呢？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於早柚…",
      "text": "呵呵，除了長高的煩惱外，幾乎無憂無慮的小貉…她的夢境一定很甜美。要不是她有預感般繞著我走，我還真想請她來「秋沙錢湯」工作。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於瑪薇卡…",
      "text": "火神瑪薇卡女士？怎麼說呢…她是那種，光是看一眼都會讓人覺得想要戴上墨鏡的人。她就像是真正的太陽那樣，只要她握住你的手，你心中所有陰霾和憂鬱都會在一瞬間被燃燒殆盡。\\n嚐、嚐過夢境的味道沒有？沒有沒有沒有沒有沒有，我可不敢細緻地嚐，之前瑪薇卡女士親切地邀請我，但我一踏進她的夢裡，就和跳進了火山一樣，燙得我一直咳嗽…\\n可能是我的妖力還不夠吧…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於瑪拉妮…",
      "text": "瑪拉妮啊…她是我見過最熱心的人了。長住納塔期間我定居的地方正是「流泉之眾」，要是沒有她的幫助，我在「流泉之眾」的店鋪才開不起來。當時她直接帶著我去「話事處」找火神女士，真的嚇了我一跳…\\n不過她的性格也像是海浪一樣，有時候飛上浪尖，有時候沉在浪底，還有時候潛進暗流裡，我根本捉摸不透她…\\n心理？不用擔心她，她是我見過心理狀態最好的人之一。我可能還需要向她傾訴呢…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於納西妲…",
      "text": "我造訪過須彌，在那位神明的權能範圍內，我無法觸及任何人的夢境，更不必談影響和吞食。但那種感覺並非被壓制，不曾令我難受，更像一種心平氣和的約定…我想，她一定是位友善的神明。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解夢見月瑞希·其一",
      "text": "「吞食夢境」是我們食夢貘一族特有的能力，無論美夢還是噩夢都能成為我們的食糧，只是味道的好壞有別。以往我的同族大多出於本能將這種能力用於飽腹，但隨著見聞增長，我意識到這種能力可以幫助多愁善感的人類消解煩惱，發揮更大的價值…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解夢見月瑞希·其二",
      "text": "其實，食夢貘一族的妖力並不強大。當年漆黑的災厄湧來時，我們只能惶恐地躲藏。鄰家的狐齋宮姐姐在那場災厄中犧牲了，我非常傷心，但無力改變什麼…許多人也失去了重要的家人和夥伴，內心遍布瘡痍…從那時起，我就有了為人們進行心理診療的想法。於是我出國求學，先後遊歷了璃月、須彌和納塔，結合我的能力和人類的學術理論，慢慢確立了如今的診療之道。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解夢見月瑞希·其三",
      "text": "這幾年我雖然不在稻妻，但好在我出資建設的溫泉經營得小有名氣，大家一聽說我是「秋沙錢湯」的大股東，多少會給我些面子。我盡力綜合了多國見聞的「心理診療」服務才得以推行下去，當然，遇到的挑戰也不少…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解夢見月瑞希·其四",
      "text": "於我而言，最大的挑戰便是消化噩夢殘留下來的負面情緒。唯有面對普通診療無法治癒的煩惱時，我才會直接吞食患者的噩夢，這也導致我吞下的噩夢都有著不小的烈性，令我相當困擾…以前我會找個無人的地方緩慢「消化」它們的餘威，要是被人撞見，我會非常難堪…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解夢見月瑞希·其五",
      "text": "#但作為心理診療師，幫助患者消解「噩夢」，就是我的職責。\\n…或者說，這是我作為「食夢貘」的存在意義。\\n我之前一直在想，我們「食夢貘」究竟為什麼被賦予了這樣的能力呢？能做到什麼事情呢？如果「吞夢」只是為了飽腹，那夢境對我們來說，也只不過是以另一種形式存在的堇瓜而已。而我們，也和那些只知道叮咬堇瓜，既不知生也不知死的蟲孑沒有區別。\\n直到做了診療師之後，我才找到了我能夠做的事——那就是為了稻妻…不，為所有人驅除噩夢。\\n呵…我本來以為我一生都要獨自面對這些「噩夢」了，但是我卻遇見了一位能夠破除世間所有困境、連神明都認可——連神明的想法都能改變的人，願意接受我脆弱的一面、與我分享近乎無盡的美夢…某種意義上，我也是{F#妳}{M#你}的「患者」了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "夢見月瑞希的愛好…",
      "text": "#悠揚輕快的音樂對放鬆身心尤為有益。在納塔時，我經常去「流泉之眾」的科隆切廣場聽音樂，享受「悠可琴」那音色飽滿的旋律…聽說{F#妳}{M#你}也會許多樂器，要是有機會，能聽{F#妳}{M#你}演奏一曲嗎？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "夢見月瑞希的煩惱…",
      "text": "太過強大的噩夢，有時會超出我的承受極限，甚至成為致命的毒物…譬如經歷過漆黑災厄的稻妻將士、在夜神之國與深淵戰鬥過的納塔勇士，他們的潛意識或許刻入了絕望和恐懼的色彩，他們的噩夢也如刀割般難以下嚥…我曾為一名「巡夜者戰爭」歸來的勇士做過心理診療，在吞食她的噩夢後，我一連昏迷了幾天…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我最喜歡的食物？當然是完美無瑕的夢境了。開玩笑的，我才不會輕易去吃掉別人的美夢，最多…吃點甜食，彌補一下為患者治療後的精神虧空。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不能接受潦草的食物，譬如…乾巴巴的麵包、幾片蘿蔔和高麗菜，配上冷冰冰的火腿…要知道，吃飯也是改善心境的重要環節，連一天三餐都隨便應付，要如何維持心態健康呢？每個人都該對自己好一點，先從認真對待吃飯這件小事開始吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "嗚…這道料理的風味，是我做夢也沒嚐過的味道。享受這種美味之後，今晚我一定也能睡得香甜…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#嗯…既平穩又美好的味道，就像我平時入睡時的夢境一樣。謝謝{F#妳}{M#你}，我很喜歡。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#{F#妳}{M#你}昨晚是不是做了糟糕的夢，沒怎麼睡好？這樣的話…味覺的確可能稍稍失靈…菜餚我晚點再吃，請讓我先為{F#妳}{M#你}診療。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天對{F#妳}{M#你}我而言都相當重要，有{F#妳}{M#你}來到了這個世界，我才能探訪無盡的美夢、見識到瑰麗美妙的天地…不如，就用只屬於我們兩人的夢境來慶祝吧？當然，要構築這個夢境，還需要我們兩個人一同出力，請向我細緻描述{F#妳}{M#你}的期望…"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "不只武力，我的心力也有所增進，這樣一來我便能面對更為強大的負面情緒了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#由衷感謝{F#妳}{M#你}，在{F#妳}{M#你}的支援下，我有信心承受一切診療殘留的煩惱。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#得到了{F#妳}{M#你}的鼓舞，我便能探究脆弱的自我、解析自己的弱點——心理診療師的心病，因{F#妳}{M#你}而走向康復，這是前所未有的創舉。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#負面情緒也屬於「自我」的一部分，我們焦慮、躁動，以至於恐慌，究其根本是沒有信心面對它們，無法在它們與積極的情緒之間找到平衡點。如今，有{F#妳}{M#你}在我身旁，我已將這平衡點深深刻入意識底層，再烈、再毒的噩夢，我都不會畏懼。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "別皺眉啊。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "美夢療法。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "鎮定下來。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "噩夢噩夢快離開…"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "來吧，小安、小徹！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "「…曉時枕貘醒春風。」"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "令人愉悅的收穫。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "心情很不錯，更有幹勁了。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "財富是改善情緒的良藥。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不能逞強…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "似乎該讓步了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不妙啊…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "請退下。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "請暫時避戰。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "噩夢…蔓延了。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "無邊的漆黑…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "痛苦…沒有散去。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "真粗魯。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "好失態…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "麻煩的病患…"
    },
    {
      "id": "910003",
      "type": 2,
      "title": "受重擊·其三",
      "text": "如此惡毒的一擊…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "有煩惱要傾訴嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "診療時間到了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "周圍…好像沒有噩夢的味道。"
    }
  ]
}