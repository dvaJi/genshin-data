  "passives": [
    {
      "id": "bright_moons_restless_voice",
      "name": "名月浮聲",
      "description": "夢見月瑞希在夢浮狀態下觸發擴散或星擴散反應時，夢浮狀態的持續時間延長2.5秒。該效果每0.3秒至多觸發1次，在一次夢浮狀態期間至多觸發2次。",
      "level": 1
    },
    {
      "id": "thoughts_by_day_bring_dreams_by_night",
      "name": "晝想夜夢",
      "description": "夢見月瑞希處於夢浮狀態下時，隊伍中附近的其他角色的元素類型為<span style=\"color:#FF9999FF\">火元素</span>、<span style=\"color:#80C0FFFF\">水元素</span>、<span style=\"color:#99FFFFFF\">冰元素</span>或<span style=\"color:#FFACFFFF\">雷元素</span>的攻擊命中敵人時，夢見月瑞希的元素精通提升100點，持續4秒。",
      "level": 4
    },
    {
      "id": "all_ailments_banished",
      "name": "諸病無病",
      "description": "夢見月瑞希在隊伍中時，隊伍中自己的角色使用不具備復甦功能的恢復類料理時的回復量有機率提升30%，該效果的觸發機率取決於對應角色的好感等級（旅行者使用時，該效果將始終觸發）。",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1091,
      "id": "in_mistlike_waters",
      "name": "宿霧若水遙",
      "description": "夢見月瑞希處於夢浮狀態下時，每3.5秒將對附近的敵人施加持續3秒的「二十三夜待」效果。處於二十三夜待狀態下的敵人受到風元素傷害而觸發擴散或星擴散反應時，將移除該效果，使此次擴散/星擴散反應對該敵人造成的傷害提升，提升值分別相當於夢見月瑞希元素精通的1100%/550%。",
      "level": 1
    },
    {
