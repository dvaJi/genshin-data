  "outfits": [
    {
      "id": 209300,
      "name": "有客來儀",
      "description": "閒雲的裝扮款式。衣裝設計並非名家手筆，遠看時以為是上好綢緞織就，細看時發現料子非絲綢、非棉麻，螢光流轉，宛如仙人羽衣。不知閒雲從何取來這一身衣裳。",
      "isDefault": true,
      "characterName": "閒雲",
      "characterId": 10000093,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Liuyun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#怎麼，第一次看見本仙這般姿態，認不出來了？本仙漫無羈束，快意自在。想去哪裡、想陪誰一同旅行，還不是本仙自己說了算。咳咳，鑑於本仙聲名在外，人前，{F#妳}{M#你}還是喚本仙「閒雲」就好。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·機關術",
      "text": "機關術奧妙無窮，並非三言兩語能道明。但為什麼每次都會把人聊睏呢？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·人間",
      "text": "天下承平，永珍更新，正是人間好時節啊。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·趣聞",
      "text": "既然無事，不妨來本仙家中坐坐，講講最近的趣聞吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "如今人間風調雨順，也就無須本仙呼風喚雨了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "哎喲，有點吵呢…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "#視野不錯，適合登高望遠的好天氣。哦，本仙不會丟下{F#妳}{M#你}一人飛走的。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "#這風真是舒暢，不如為{F#妳}{M#你}貼些仙家符籙，隨本仙飛上雲霄如何？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#本仙早就醒了，閉著眼是在靜心冥想，對修行有益，{F#妳}{M#你}也可以試試。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#嗯？看本仙做什麼，今天不是輪到{F#妳}{M#你}準備午飯了嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#找本仙去逛夜市？呵，那裡有什麼好逛的。想要什麼稀奇玩意，本仙給{F#妳}{M#你}做一個就是了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#本仙還挺有精神呢…看{F#妳}{M#你}倒是眼皮打架，快去休息吧。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於閒雲自己·師徒",
      "text": "本仙向來逍遙自在，無拘無束，徒弟們自然也有樣學樣，一個個的忙得沒影，十天半月也沒個信…本仙心中並無寂寞之情！嗯…若是出於關心，抽空去看看她們，應該不會添什麼麻煩吧？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於閒雲自己·烹飪",
      "text": "雖然機關做菜不如人力精巧，但省下做飯的時間，就可以用去研製新的烹飪神機，新的機關又會節省更多時間…呵，如此循環下去，終有一日，本仙可以將世間美味盡收囊中。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·旅伴",
      "text": "#為了今後出行便利，本仙特意飛到空中勘測地形，做了這個指路羅盤，怎麼樣，沒見過做事如此周到的旅伴吧？{F#妳}{M#你}說{F#妳}{M#你}對附近地形很熟悉？呵…人的記憶總會有誤差，等{F#妳}{M#你}迷路的時候，就會感謝本仙未雨綢繆了。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·牽絆",
      "text": "#本仙雖不在意身外之物，亦深諳「牽絆」二字。這二字寫起來容易，個中真意卻難以言說。就像本仙與那些老傢伙們，有時幾年才相見一次，見了面也經常吵架鬥嘴，但不論彼此身在何處，都不會有漂泊無依之感。{F#妳}{M#你}是本仙認可的人，自然也在本仙的朋友之列，不知道{F#妳}{M#你}是否和本仙一樣珍惜這份「牽絆」呢？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "帝君曾言，「神之眼」代表的是一份責任，無論隱於山林還是居於鬧市，都不可忘記看護人間之責。從今以後是人的時代，本仙會心懷這份責任繼續走下去。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "這機關鳥是個試做品，本仙想做只大鳥，中間鏤空變成座駕，就能和那幫老友一起出去遊山玩水了…但是動力和操作問題是個難事，既要能升降，還要能變形，還要兼顧必要的安全措施…哎，若是歸終還在，她或許能想出不少異想天開的解決方案吧。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "奧藏山盡斂風華，蘊天地靈氣，是適合修行的好地方。當初本仙在山中靜思時，常有好奇的生靈前來張望，動輒嘰嘰喳喳、吵吵鬧鬧的…倒讓人一點也不討厭。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於甘雨…",
      "text": "#本仙問甘雨平時加班都在忙些什麼，她說了一堆拗口的詞，什麼會議紀要、工作總結、年度報告、財務預算…哼，若非她的仙麟血脈，又有本仙傳授的養生之法，可應付不來這些繁文縟節…{F#妳}{M#你}下次記得替本仙問她，有沒有每天喝本仙研製的明目清心茶？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於申鶴…",
      "text": "申鶴說她有一次給萬民堂送外賣，為了節省時間，直接踩著屋頂過去，從屋頂跳到人家門口，把顧客嚇了一跳，差點要喊千岩軍…好在她來去如風，沒等顧客喊出口，早已放下外賣消失不見了。申鶴這孩子處理危機的能力真是越來越強，本仙很是欣慰。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於鍾離…",
      "text": "帝君聽說本仙要在璃月港置辦住宅，便跟本仙細數家居裝潢與家具購置的注意事項。採光通風、木材訂製、瓷器選購、還有花卉擺放…本仙聽得頭都快大了，在人間居住竟要這般費心嗎？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於魈…",
      "text": "#降魔大聖比本仙還安靜，千百年的聚會，就沒幾次他願意出面的。本仙倒是聽說{F#妳}{M#你}和他交情不錯，平時{F#妳}{M#你}都跟他聊些什麼？要不然，下次{F#妳}{M#你}找他的時候，本仙做一份「豆腐布丁」讓{F#妳}{M#你}帶去吧。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於胡桃…",
      "text": "那丫頭年紀輕輕，說話稀奇古怪，但看「往生堂」的人卻對她畢恭畢敬，連帝君都客氣，還給她當那什麼「客卿」…聽說她對食物的品味也不同尋常，這號奇人，倒讓本仙有些興趣。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於香菱…",
      "text": "本仙閒聊時跟她說起過機關烹飪神機的事，那丫頭竟然說，做菜還是得親自動手才地道…哼，本仙造機關也是親自動手，怎麼就不道地了？本仙可得跟她比比…不過她做的璃月菜餚的確風味極佳…待本仙想想怎麼改進機關…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於凝光…",
      "text": "#這位「天權星」做起事還算八面玲瓏，講話也滴水不漏。哼，不得不說，璃月港在他們七星的治理下也算欣欣向榮。本仙也在細心觀察，研究其中奧秘…咳，此事{F#妳}{M#你}知道即可，不要對她講。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於刻晴…",
      "text": "她逢年過節便會代表七星來拜訪本仙，送節日賀禮給本仙，真是個有心的孩子。看她做事幹練，考慮又周全，甘雨與她共事，應該也不用本仙過於操心…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於雲堇…",
      "text": "「璃月戲」有不少以仙人傳說為藍本的故事，其中也有以本仙的經歷改編的戲曲…本仙當然未曾看過，看別人在臺上演自己，難道不會尷尬嗎？至於她以申鶴的經歷創作的戲，待本仙空閒，倒是可以去品鑑一番。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於瑤瑤…",
      "text": "有一次，瑤瑤把我的眼鏡借了過去，戴在了自己的鼻樑上，一個人樂呵呵地笑了半天…孩子啊，總能找到獨屬於孩子的樂趣。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於嘉明…",
      "text": "嘉明這小夥為人熱情，說話有趣，也從來不會誇誇其談，本仙很是看重。說起最初和他相遇的時候，看到本仙在池邊歇腳，他還主動拿出吃食與本仙分享呢。後來他說在他眼裡，比起仙人，本仙更像是一位可敬的長輩。呵呵，那本仙自然也該以長輩的身分照顧他囉。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於茲白…",
      "text": "茲白倒是經常過來與我閒聊，在一些數理問題上，她頗有見地，不過…咳，有一次瑤瑤幫阿萍捎帶東西過來時，茲白恰好在場，就順嘴問了瑤瑤幾個數理問題，那孩子聰慧，也就順嘴答了，結果茲白歡喜得厲害，越問越多，我還是第一次看見瑤瑤這孩子滿頭大汗的樣子，只好出聲解圍…唉，後來，茲白堅持瑤瑤有數理之才不能埋沒，還問我她現住何處，要寫套習題帶給她，我…唉，我這是說，還是不說呢…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解閒雲·其一",
      "text": "#想要知道本仙的過往？都是些陳年舊事，有什麼好說的。倒是{F#妳}{M#你}四處遊歷，想必遇到不少趣事。其他國家的神仙是何樣貌？可有哪位像本仙一樣喜歡聊天？沏壺好茶，跟本仙細細說來。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解閒雲·其二",
      "text": "有段時間，璃月盛行尋仙問道之法，也不知道他們如何得知本仙的洞府所在，隔三岔五便有人在奧藏山設壇供奉食物…哼，本仙豈會因凡間美食擾了清修？不過是念在他們一片誠心，才不得已等到旁邊沒人的時候，略加品…咳，略加回應罷了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解閒雲·其三",
      "text": "曾經也有其他人找到本仙的洞府，想要本仙收他們為徒。本仙閉門不見，他們便賴著不走，奧藏山都快成了露營公園…本仙便在洞府外貼了張便條，想要拜師者先想出清心的九十九種烹飪之法，每天做出一種…果然沒有人能堅持下來。哼，無論是仙家術法還是機關造詣，都需資質極佳，心性極靜之人方能領悟，如果連三個月也堅持不住，也就不必白費力氣了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解閒雲·其四",
      "text": "機關術雖有諸多神妙用途，但有時不過是本仙消磨時間的遊樂產物。有一年璃月大雪，奧藏山積雪很深，本仙見眾人終日待在洞府，無所事事，便造了個「追風滑雪神機」。削月那老傢伙見本仙和歸終、歌塵等人玩得起勁，也要加入，可他出師不利，第一次試滑便脫了軌道，連人帶機關砸進了旁邊的積雪裡。我們鏟了半天才將他挖出來…後來本仙特地給他在防護性上加固了不少，便是三歲稚子也能安穩操控，只是速度慢些罷了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解閒雲·其五",
      "text": "#本仙搬來璃月港之後，看了不少流行讀物，其中一些俠義小說頗為有趣。若是將本仙認識的形形色色人物寫進去，豈不比那些憑空想像的角色更為精彩？可惜本仙的徒弟們，似乎都不喜歡本仙跟其他人講她們的故事…那不如就寫{F#妳}{M#你}跟本仙聊過的旅途趣事如何？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "閒雲的愛好…",
      "text": "閒來無事，坐在山野之間吹吹罡風，總能讓人平心靜氣。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "閒雲的煩惱…",
      "text": "自從本仙搬來璃月港，前來拜訪、宴請本仙的新朋舊友一茬接一茬。如此往來，本仙手上的摩拉也未必夠用…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "與好友一起吃飯，無論是何種菜餚，都令人回味無窮。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#仙人不會被人間俗物阻礙修為，比起食物的種類，本仙更在乎味道…要是{F#妳}{M#你}自己嚐著都不夠可口，就不要拿到本仙面前了。還不如本仙來下廚…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#食材用得新鮮，口感也恰到好處。{F#妳}{M#你}偷學過本仙的烹飪技巧？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "味道倒是其次，能想起請本仙吃飯，心意可嘉。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#本仙的機關烹飪神機近來閒置了，可以借{F#妳}{M#你}一用。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#來，開啟這個木匣。這個機關小人是本仙閒暇時所做，{F#妳}{M#你}拿去玩吧。{F#妳}{M#你}看，只要像這樣拍拍手，蓮花的花瓣就會開啟，彩燈一圈圈亮起，隨後奏響的是小輩們最喜歡的生日快樂歌…這樣辦生日宴時，想必會平添幾分熱鬧吧。祝{F#妳}{M#你}過得開心。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "久居家中，偶爾出來活動筋骨倒也不錯。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "有些仙法多年不用，一朝拾起難免有些生疏。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#唉，既然{F#妳}{M#你}露出這般期待的眼神，本仙也只好再拿出些本事了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#在世間行走多了便有經驗。比起力量多寡，還是與人交往的技巧更為重要。若{F#妳}{M#你}有空，我們去找個風景開闊的地方，賞賞景、聊聊天，放慢腳步，好好享受享受生活吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "喝！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "御風！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "雲散！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "八風儛翮。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "仙人來哉！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "風匯，孤雲與歸。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "開啟寶箱·其一",
      "text": "能當零件用用。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "開啟寶箱·其二",
      "text": "什麼稀奇玩意，讓本仙看看。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "開啟寶箱·其三",
      "text": "本仙是不是該研發個…「奇物搜覓神機」？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "大膽！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "身法不錯。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "本仙奉陪到底。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "量力而行。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "怎麼不叫本仙？"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "肚子空著…這次不算…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "一著不慎…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "機關…還未使出…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "雕蟲小技。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "不過如此。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "機關調試完畢，動身吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "吃食可備好了？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#本仙日行千里，{F#妳}{M#你}可別跟丟了。"
    }
  ]
}