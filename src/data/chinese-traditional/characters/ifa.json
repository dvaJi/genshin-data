  "passives": [
    {
      "id": "field_medics_vision",
      "name": "場中醫者視野",
      "description": "伊法處於夜魂加持狀態下時，將基於隊伍中所有角色目前夜魂值的總和，每1點夜魂值都將使伊法獲得1點<b><span style=\"color:#FFD780FF\">「救援要義」</span></b>。救援要義可以提升隊伍中附近的角色觸發的擴散、星擴散、感電、月感電反應造成的傷害。",
      "level": 1
    },
    {
      "id": "mutual_aid_agreement",
      "name": "互助救援協議",
      "description": "隊伍中的附近的角色觸發「夜魂迸發」時，伊法的元素精通提升80點，持續10秒。",
      "level": 4
    },
    {
      "id": "night_realms_gift_focused_emergency_rescue",
      "name": "夜域賜禮·集念急救",
      "description": "在夜魂值耗竭後，伊法將會轉而消耗燃素來維持夜魂加持。<br/>在納塔存在燃素機制的區域時，能夠進行夜魂傳遞·伊法。目前場上角色位於一定高度的空中時，切換伊法登場時觸發：伊法將進入夜魂加持狀態，並獲得32點夜魂值。自己的隊伍每10秒可以觸發一次夜魂傳遞。",
      "level": 0
    },
    {
      "id": "tactical_warm_compress_bandaging",
      "name": "溫敷戰術包紮",
      "description": "在納塔存在燃素機制的區域時，隊伍中自己的目前場上角色或受魂附的龍生命值低於40%時，伊法將消耗10點燃素為其恢復40%生命值。該效果每10秒至多觸發一次，在秘境、征討領域深境螺旋中無效。",
      "level": 0
    }
  ],
