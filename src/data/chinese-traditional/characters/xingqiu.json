  "outfits": [
    {
      "id": 202501,
      "name": "雨化竹身",
      "description": "飛雲商會為行秋準備的宴會衣裝。竹紋清雅、剪裁服貼，但最令行秋滿意的還是其內層的口袋，足夠塞下一冊較薄的小說了。",
      "isDefault": false,
      "characterName": "行秋",
      "characterId": 10000025,
      "source": [],
      "filename_card": "UI_AvatarIcon_XingqiuCostumeBamboo_Card",
      "filename_icon": "UI_AvatarIcon_XingqiuCostumeBamboo",
      "filename_iconCircle": "UI_AvatarIcon_XingqiuCostumeBamboo_Circle",
      "filename_splash": "UI_Costume_XingqiuCostumeBamboo",
      "filename_sideIcon": "UI_AvatarIcon_Side_XingqiuCostumeBamboo"
    },
    {
      "id": 202500,
      "name": "錦鈺蘭衫",
      "description": "行秋的裝扮款式。飛雲商會所售之上品綢緞織就的褂裝。",
      "isDefault": true,
      "characterName": "行秋",
      "characterId": 10000025,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xingqiu_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "在下行秋，不過書海一蠹。某雖不才，仍願為君略盡綿薄。難得有機會說這種風格的臺詞，感覺還不錯。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·無人夜",
      "text": "「有時明月無人夜，獨向昭潭制惡龍。」"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·文章",
      "text": "「衣裓貯文章，自言學雕蟲。」"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·偷閒",
      "text": "正所謂「偷得浮生半日閒」，哈哈。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "閒聊·閱卷",
      "text": "如此如此，這般這般…欸？欲知後事如何，且聽下回分解？唔…"
    },
    {
      "id": "1105",
      "type": 1,
      "title": "閒聊·新書",
      "text": "盤算著也該到「萬文集舍」新進小說的日子了，不妨…我們順道去看看？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "這麼說來，我們家出品的錦緞傘，好像既不能遮陽也不能擋雨。唯一的用處就是掛在牆上。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "晴了就好，不然藏書會發霉的。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "只有這種天氣的時候，我才會覺得家裡比書店好。家裡炭火很足，而書堆裡就不准用火。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "練功的好…啊不，是看書的好時節啊。好啦，我臉上又沒有寫字，別一直盯著我看了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早啊。早上的時間這麼難得，能做做自己喜歡的事情就好了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午飯有點不想吃米飯，想吃糕點。待在書齋吃，父親和兄長就不知道了…嗯？想一起來嗎？嗯…只要{F#妳}{M#你}不把碎屑沾到書上就行。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#去偷點螢火蟲來看書，怎麼樣？唔，我的玩笑話{F#妳}{M#你}可別當真，對眼睛不好的。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#明天我也在老地方。只要{F#妳}{M#你}不中途迷了路，就準能找得到我。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於行秋自己…",
      "text": "#在人前彬彬有禮，是因為大家見我是飛雲商會的二少爺；在{F#妳}{M#你}面前能這麼輕鬆，大概因為{F#妳}{M#你}看我的方式並不一樣吧。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·書友",
      "text": "#{F#妳}{M#你}算是我的書友吧。什麼？打架？古華派？戰友？…唔！{F#妳}{M#你}都在說些什麼呢。不是說好這是我們兩人間的秘密嗎！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·結拜",
      "text": "#我要和{F#妳}{M#你}結拜，就去絕雲間的祭壇那邊。不行，不能拒絕。{F#妳}{M#你}知道了我的底細，也就知道了一直被我掩飾著的真實的自己…我不能放{F#妳}{M#你}走。除非…{F#妳}{M#你}答應我不會撒手不幹！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」·古書",
      "text": "#「神之眼」的事情，雖然一般少有記載，但在我所收集的古書中卻有一段特別的描述，待我找給{F#妳}{M#你}。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "關於「神之眼」·領悟",
      "text": "#受書中啟發，我領會到，槍術與劍術的本質，正是瞳術。唔，解釋起來可能有點費力…如果{F#妳}{M#你}真想知道，就跟我去「王山廳」走一趟吧。事先聲明，到時候{F#妳}{M#你}可不準笑。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "璃月非去不可的地方？這個問題很難回答，不過，如果消失了會讓我很難過的地方…「萬文集舍」穩排第一，「古華堂」能進前十吧。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "以前是兔子，後來是鹿。對我來說，「請從絕處，讀我俠義」是捨棄一切的覺悟，鹿卻是絕處逢得新生的希望。真想再見牠一次啊。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於北斗…",
      "text": "北斗閣下是我非常敬重的人。不過希望她不要喊我「小子」，也不要一見面就揉我頭髮。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於凝光…",
      "text": "「天權」大人是我不得不敬重的人。不然會給家父以及家兄添麻煩。嗯？對她本人，我想想。嗯…還是算了，不說人壞話了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於重雲…",
      "text": "唉，重雲這傢伙，雖然也知道我的底細，但真要和他搭檔去完成任務還得審慎。他現在還是執著「武」技，卻不理解「俠」心的境界。需要多練練。尤其…是吃辣的方面，哈哈。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於雲堇…",
      "text": "雲堇啊，她只要能喝到滿意的飲品，就會有動力去創作新戲。我呢，就一直在床底下囤著一小罐茶葉，就是為了等哪天她興致索然的時候給她送去。這樣，我就有聽不完的異俠傳奇了！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於胡桃…",
      "text": "那個小姑娘，正是「往生堂」的當代堂主。嗯？問我怎樣看待她的為人？…行事作風嘛，坊間傳聞是作不了數的。真想瞭解一個人，還得看她真正想要的是什麼。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於七七…",
      "text": "總感覺七七的身上藏著謎團。但只要白朮先生在場，就跟她說不上幾句話。除非，我們能找個白朮先生外出看診的機會，專門…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於香菱…",
      "text": "#見到香菱的時候，{F#妳}{M#你}可得多觀察一下她的表情。尤其是剛剛添置完食材回來的香菱，笑得越開心，就越危險。要是被她纏上、逼{F#妳}{M#你}試吃新品…這種情況，我一般會靠重雲來處理。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於辛焱…",
      "text": "辛焱到底是在哪裡演出的？從吃虎岩到玉京臺，哪裡都躲不過那種雞飛狗跳的穿透力…唉，能夠安靜看書的時日是多麼寶貴啊。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "下一卷、下下卷、下下下卷的重要場景，我都已經想好要配怎樣的插畫了！啊，必須趕快把靈感記下來，修書一封，寄給白堊老師…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於鍾離…",
      "text": "我看見過家父和家兄接待這位先生，就從他們行禮時候的恭敬態度來看…對方應該是很有地位的人物吧。我還聽說他是給仙人辦喪事的人，感覺很有底蘊。要不要一起去挖掘他身上的秘密呢？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於申鶴…",
      "text": "總覺得申鶴小姐看我的眼神裡略顯兇惡，讓我不敢隨便跟她搭話。奇怪，難道我無意中得罪過她嗎？或者…得罪過她身邊的人？"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於夜蘭…",
      "text": "#{F#妳}{M#你}聽說過「一人千面」這個詞語嗎？夜蘭小姐就給我這種感覺。上門來訪的時候，家父和家兄以禮相待，她也還之以禮，就像是個親切穩重的大姐姐。可在別的地方見到她時，又完全是不同的印象。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於嘉明…",
      "text": "#嘉明的工作頗有俠之風範。試想，功夫蓋世的黑衣少年攜手威武鎮煞的瑞獸，在月黑風高夜，將盜賊與惡徒打得落花流水，狼狽而逃…等他得空，真想聽他多分享一些走鏢路途中的見聞。{F#妳}{M#你}也一起來吧？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解行秋·其一",
      "text": "閣下近來可好？如果閒來無事，可以來「萬文集舍」轉轉。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解行秋·其二",
      "text": "問我為什麼總是一個人看書？好學…並不是什麼壞習慣吧。沒有什麼特別的地方，嗯，真的沒有。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解行秋·其三",
      "text": "今天的時間已經空出來了嗎？好，我也隨時可以出發。書？沒關係，書可以回來接著看，那些需要我們幫助的人可不能等啊。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解行秋·其四",
      "text": "#{F#妳}{M#你}說{F#妳}{M#你}有個好點子？用我們之前做的事情當原型，寫一本探案集加武俠題材的小說，《萬文集事件簿》？嗯，啊哈哈哈…是個好點子，但是不採納。嗯，不會採納的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解行秋·其五",
      "text": "#「洋洋萬言，織詩成錦。」唉，我也想有這樣的評價啊。這件事我只和{F#妳}{M#你}一個人說。其實，我也在寫小說。現、現在當然不能給{F#妳}{M#你}看，以後…以後{F#妳}{M#你}會在書店裡看到的。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "行秋的愛好…",
      "text": "#我的愛好自然是看書。什麼書都會看。嗯？{F#妳}{M#你}一臉壞笑看著我幹什麼。唔，那事我們兩個知道就行了，還是不適合在明面上講。說出來就沒意思了。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "行秋的煩惱…",
      "text": "煩惱啊，嗯…未來有朝一日兄長繼承了家業，我會怎麼樣呢？這樣無憂無慮的生活恐怕…啊，我不是在說身分之類的，我不在乎那些。我是覺得大哥太呆了，沒我幫忙不太行啊。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我比較喜歡吃糕點和月菜海鮮。主要是因為，我們家一直就吃得很清淡吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我很討厭胡蘿蔔，小時候家母經常搗碎胡蘿蔔做成…還是不要讓我講下去了。即使是在回憶裡，那種味道也…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "此等美食，吃過一次就再難忘懷了啊。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#既然{F#妳}{M#你}有這份手藝，不如我們開個路邊餐館，如何？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#{F#妳}{M#你}吃{F#妳}{M#你}吃，不必客氣。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日·祝福",
      "text": "#咳，咳咳。恭祝{F#妳}{M#你}福壽與天齊，慶賀{F#妳}{M#你}生辰快樂。"
    },
    {
      "id": "7002",
      "type": 1,
      "title": "生日·習俗",
      "text": "#據記載，天成石橋是上古戰爭時候，岩之神摩拉克斯投出的石槍倒塌後形成的。要是生日當天在橋上走一趟，往兩邊海裡投點摩拉，就能保佑一年安康…生日一年只有一次，想去的話就快點去吧…沒騙{F#妳}{M#你}，是真的。真的，快去吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "如果沒有能力，那我心中的那個字，可能也就停在紙面上了吧。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "如果心中沒有善惡的尺規，努力就會錯了方向。捨本逐末，變成追逐暴力的俗人。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "我所追求的那個字，在璃月這方土地上並非處處通行。不過行道至此，我對這一點早就有了足夠的認識。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#多虧了{F#妳}{M#你}的陪伴。我對自己也很滿意了——無論是武學，還是對那個字的理解。唉，算啦。我也不用對「俠」字諱莫如深了。我的「俠」，父親和兄長應該也不會質疑了。只不過嘛，低調行事這點還是得保留的。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "雨線難畫。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "裁——！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "斷！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "古華深秘。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "織詩成錦。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "裁雨留虹。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "形隨神至。"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "該行動了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "甚好甚好。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "尋得珍寶，真是充滿俠意的經歷。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "倘若還有幾卷失傳的古書，就完滿了。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "計畫有變…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "接下來就不再是「點到為止」了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "「請從絕處，讀我俠義。」"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "過來這邊，我有一計。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "小心行事為好。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "承蒙…賜教…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "燈華易散…我是知道的。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "失手了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "不妨事。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "大意了。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "不好…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "厚積而薄發。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "不慚世上英。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "扶善懲惡，當仁不讓。"
    }
  ]
}