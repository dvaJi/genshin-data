  "outfits": [
    {
      "id": 212900,
      "name": "霜鑄之銳",
      "description": "洛恩的裝扮款式。比起冒險者時期的裝束，騎士的甲胄顯然莊重了許多。但於洛恩而言，變化的不過是裝備的重量、旁人的目光，不變的卻是克敵制勝的銳意，與一往無前的執念。",
      "isDefault": true,
      "characterName": "洛恩",
      "characterId": 10000129,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Lohen_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "初次見面，我是第五小隊的現任副隊長洛恩。如果有任何需要西風騎士團協助的事務，請直接前往騎士團求助。如果需要我個人幫忙，那我們還得好好商量一下。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·副隊長",
      "text": "想要成為隊長，光有「隊長級」的實力可不夠。更重要的是…呵，我也不知道，不然我已經成隊長了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·風的歸處",
      "text": "呼…果然還是待在蒙德城最舒服，等一會再去喝點蘋果釀好了…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·人際關係",
      "text": "我在騎士團和大家的關係怎麼樣？嗯…至少，大家對我印象都滿深的，這樣也還不錯。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨勢不小啊，不知道又有多少東西被它沖刷殆盡了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "雨過天晴，權當之前那場雨從未發生。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的時候…",
      "text": "雷聲可以蓋過許多東西，但絕對蓋不住你自己的心跳。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候…",
      "text": "我十分熱愛貓尾酒館…尤其是在這種天氣下。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起風的時候…",
      "text": "起風了，可惜我手頭沒有蒲公英，不然撕一點紙吧，感覺也差不多。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "我非常懷念果酒湖。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安。今天要忙什麼？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午飯吃過了？行啊，下午還有事要做呢。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今天晚上…嗯，給隊員們來一趟「襲營訓練」吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#晚安，記得早點休息。無論{F#妳}{M#你}怎麼熬夜，明天都會到來的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於洛恩自己·痛覺留存",
      "text": "在平時治療時，我盡量不使用麻醉類藥物，一是這種東西會影響戰鬥，二是…呵，從某種角度來說，我還滿願意在戰鬥之後仔細感受「痛覺」的。畢竟這證明我活了下來，而我的敵人，則什麼都感受不到了。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於洛恩自己·力量與藉口",
      "text": "對於某些人來說，「力量」是一個很好用的藉口，只要用上了它，任何失敗和挫折都能找到原因，任何不安和恐懼都能尋見源頭…或許，有一個明確的目標，的確能夠給人們一種怪異的安全感吧。就算…這種「安全感」的背後，隱藏著更為恐怖和巨大的影子。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·戰鬥方式",
      "text": "我的戰鬥方式？哈哈哈哈哈，找到領頭的，和他好好打一場，盡可能快速分出勝負，就這麼簡單。我的隊友們應該都已經習慣了。當然了，不習慣也沒用。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·職責所在",
      "text": "#如{F#妳}{M#你}所見，我已經是副隊長了，希奧多那個傻瓜也正在承受他該受的懲罰。不過在我看來，他的才能還能派上一些用場，等他贖完罪，我還想把他撈回第五小隊。但副官是做不了了，他就做個普通隊員吧。不過，想要徹底相信他——還有我——都為時尚早。\\n{F#妳}{M#你}相信我，也有那個相信我的「實力」？哈哈哈哈哈，不愧是「榮譽騎士」，和傳聞中一樣可靠。不然{F#妳}{M#你}直接來做我們「第五小隊」的隊長吧，法爾伽一定會答應的。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "在執行任務的時候，這枚「神之眼」的確派上了不少用場。可惜，它只能用來剿滅有形的魔獸，不能撫平無形的創害。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "我不喝酒，酒對我來說唯一的作用就是幫傷口消毒。特別是晨曦酒莊的陳年蒲公英酒，消毒的效果和痛覺都很明顯，而且在消毒的同時，我還能順便欣賞一下我的同僚們——特別是法爾伽——抽搐的眼角，哈哈哈哈——"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "我之前一直對蒲公英過敏，聽砂糖說有一種「減敏療法」之後，我就買了許多蒲公英放在屋裡，每隔一段時間就去主動吸入一點，以此來治療我的過敏症狀。結果怎麼樣？反正我現在遇見蒲公英已經不打噴嚏了。但我不得不說，打噴嚏打到頭暈目眩的感覺，還是不可多得的。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於法爾伽·藥物耐受性",
      "text": "法爾伽對於藥物的抗性越來越高了，前幾天我調配的藥物居然只是讓他紅了紅臉，要不是他瞪了我一眼，我都要懷疑自己究竟有沒有下藥了。唉，要是還在挪德卡萊的話，我都想要給他摻一點那種帶月矩力的植物了…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於法爾伽·團長職責",
      "text": "團長的職責？就法爾伽而言，基本上是帶人出去打架吧。剩下的都被他丟給琴團長了，哈哈哈——畢竟敵人真的會被消滅，但文書工作真的沒有終結啊。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於琴…",
      "text": "正是因為有這位勤勉的代理團長坐鎮蒙德城，「大團長」才能在挪德卡萊放手施為，現在他回到了蒙德城…好吧，他也會繼續放手施為，情況好像沒有什麼改變。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於凱亞…",
      "text": "凱亞很擅長模仿其他騎士小隊隊長的簽名，特別是琴團長的簽名，他偽造得堪稱天衣無縫，幾乎沒有破綻。他練習這個的目的？凱亞說這是為了自己幫自己批假。我相信他，畢竟以他的人品，應該也做不出更過分的事了…呵呵。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於安柏…",
      "text": "聽安柏說，她和琴團長商量好了，過段時間會有一些不叫「偵察騎士」的偵察員來幫她的忙。可喜可賀啊，她總算不用一個人在蒙德城上空來回飛了。不過這麼一想，飛行執照考試的條例和考綱是不是也很陳舊了？不然，也一起更新算了？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "迪盧克老爺，還是應該說迪盧克「前輩」？從某個角度上來說，我們都被同一個混帳害得不輕，現在新仇舊恨都已經清算完畢，他還不考慮回西風騎士團？就算不能做最年輕的隊長了，也能做資歷最老的隊員啊。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於諾艾爾…",
      "text": "諾艾爾還沒有成為正式騎士啊？都過這麼長時間了，我還以為她肯定通過騎士試煉了呢…不知道法爾伽在想什麼，難道要替諾艾爾準備一個超級大試煉？那她的騎士稱號到底要多厲害，才能配得上她的訓練時長啊…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於優菈…",
      "text": "我對優菈最深的印象，就是她那雙靴子踢踏地板的聲音。只要她腳步急一點，我隔著一層樓都能聽見咚咚咚的聲音，既響亮又有穿透力，就和優菈的劍術一樣，印象深得根本忘不掉。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "第五小隊所用的軍備消耗品是第八小隊和阿貝多一塊開發的，弩箭、彈藥和各類煉金產品的品質都很不錯，我偶爾也會去拜訪他的辦公室，順便委託他做一些新的武器研究。不過，最近和我接洽的人換成了砂糖，阿貝多應該是又去忙其他研究了吧…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於可莉…",
      "text": "法爾伽之前和我說，他覺得那位愚人眾執行官「隊長」用蠟筆都能戳爆遺蹟守衛，所以呢，我用好吃的和可莉換了一盒蠟筆，準備帶給法爾伽，到時候如果遇見了魔物，正好讓他親手試一試。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於米卡…",
      "text": "米卡很擅長測繪，而我很擅長測謊。之前，他給我的測繪圖上專門掩蓋了魔物聚集點，就怕我一個人衝過去。而我只是看了看他的表情，就知道這張圖上哪裡的魔物最多。可惜啊米卡，沉默也沒用。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解洛恩·其一",
      "text": "抱歉啊，我沒有什麼陰暗深沉的「有趣秘密」。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解洛恩·其二",
      "text": "雖然平時用長槍比較多，但我好歹也是第五小隊的人，弩箭和銃槍的練習也是沒落下的。至於準度…反正我打蓬蓬果和史萊姆滿準的，基本算是抬手就能中的程度吧。我聽說稻妻有一種叫做飄浮靈的東西很難打？有趣，下次拿它試試身手吧。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解洛恩·其三",
      "text": "第五小隊？只是一支普通的遠距離支援隊伍而已，沒什麼值得說的。雖說我們的火力還算過得去，但要是對上某些…過於特殊的敵人，我們最多就只能在旁邊做做掩護了。就像是跟隨法爾伽阻擊獵月人那次一樣，到最後，主攻完全變成了大團長，我們都被命令散去周圍阻擊狂獵…只有這樣，我們才不會被捲入他和獵月人的戰鬥裡。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解洛恩·其四",
      "text": "為什麼我堅持用長槍？那是因為…戰場上最好的誘餌，當然是看起來像是隊伍主官的人啊。有我吸引住敵人，其他隊員只要盡情開火就好。至於危險的敵人…哈哈哈，越是緊張，我越是能集中精神，那種極致的專注感非常美妙…可惜啊，離開挪德卡萊之後，能讓我放手一戰的地方太少了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解洛恩·其五",
      "text": "和敵人展開貼身戰的時候害不害怕？怎麼說呢，我覺得敵人那邊應該「更」害怕吧？我出槍的速度是不會慢的。再說了，我背後還有醫療騎士等著呢…敵人也有怎麼辦？嗯，那我就只能盡可能搶先幹掉對面的醫療人員了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "洛恩的愛好…",
      "text": "除了上戰場廝殺，我平時的最大愛好，就是為我親愛隊友們的平淡生活添上幾分「驚喜」，這也算是日常訓練的一環，騎士可得時時刻刻提高警惕啊。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "洛恩的煩惱…",
      "text": "駐紮荊夫港的好日子結束了，回到蒙德城，琴團長可沒有大團長那麼好說話了。唉，就不能再給我一點外勤任務嗎？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我比較喜歡吃辣一點的東西。平時在外面執勤的時候，也喜歡嚼點曬乾的絕雲椒提神…「那叫絕雲椒椒」？謝謝，我只說一個「椒」字就好。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "別喝酒，好嗎？在挪德卡萊駐紮的時候，我總是被那些喝多了的騎士們吵醒…這幫人喝到最後，已經不知道自己在喝什麼了，就算我把酒換成了…呃，算了，沒什麼。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#謝謝，很合我口味。這道菜好吃到…我都有點懷疑{F#妳}{M#你}是不是偷偷調查過我了。沒事的，我也調查過{F#妳}{M#你}，我們平手了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#我之前學習如何在飯菜裡下毒的時候，基本上也是做到不會讓任何人起疑的程度…{F#妳}{M#你}已經下毒了？噢，我對毒藥的耐性很高，讓我再吃一點。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "…這麼直白的陷阱，我就…不主動往裡面跳了。下次還是換我來做菜吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天是{F#妳}{M#你}生日，拿著這把微型手弩吧。是我自己琢磨出來的，應該剛好能戴在{F#妳}{M#你}的手腕上…我什麼時候量尺寸的？目測的。我可是第五小隊副隊長，相信我的目測能力——哦對了，這把手弩還能反向發射，以防有人背後偷襲嘛。只要按這裡…哈哈哈，別躲嘛，這把手弩的安全鎖還扣著呢。難道我看起來像是那種送朋友手弩，然後看著他扣動發射扳機，把弩箭戳到自己身上的人嗎？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感覺不錯，武器都用得更順手了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "好像能看得更遠了…下次出槍的時候，應該能更準一些了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "頭腦更清醒了，哈，突然想到了一個訓練的新方法。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "看來，以我現在的實力，應該足夠做個「副隊長」了？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "開戰了！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "發抖吧。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "一個不留！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "出奇制勝。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "時機正好。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "哼。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "吵吵鬧鬧…待宰羔羊。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "掙扎——也沒用！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "哈哈哈，你不會安息的。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "收獲頗豐啊，來吧，看看裡面裝了什麼。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "好像不太值錢啊…不過，反正是免費的，拿著吧。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嗯，沒有陷阱，也沒有劇毒煙霧…無聊。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "感覺不錯…繼續！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "…還沒完呢！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "正好當我的對手！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "實力不足，就退後！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "讓我嚐嚐！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "我的…侷限…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "不…盡興…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "風啊…告訴…我…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "小伎倆。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "一點感覺也沒有。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "實力不錯啊…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "呵…！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "走吧，活動活動。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "打頭陣？行。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "這次我來殿後。"
    }
  ]
}