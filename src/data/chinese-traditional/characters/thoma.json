  "outfits": [
    {
      "id": 205000,
      "name": "焰之赤武",
      "description": "托馬的裝扮款式。由托馬自行裁剪後幾乎只剩佩楯與籠手的輕型具足，便於游刃有餘地處理戰鬥內外各種事物。",
      "isDefault": true,
      "characterName": "托馬",
      "characterId": 10000050,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Tohma_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#初次見面，異鄉的旅人，{F#妳}{M#你}的名字我可是早就聽說了。只要{F#妳}{M#你}不嫌棄，我托馬，從今天起就是{F#妳}{M#你}的朋友了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·請客",
      "text": "嗯…找個時間一起吃頓好的怎麼樣，我請客。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·擔憂",
      "text": "總覺得有什麼事忘記做了…庭院打理過，茶也煎了，嗯…應該是錯覺吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·摩拉",
      "text": "這幾天花得太多，身上只剩十摩拉了，不過幸好還有十摩拉！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "#怎麼突然下雨了？{F#妳}{M#你}沒事吧？要不要用我的外套擋擋？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "這種天氣就別在野外閒晃了，會被劈的。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#別在雪地上跑哦，跌倒了我可不扶{F#妳}{M#你}。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "天氣真不錯啊，一起散步吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早啊。要是{F#妳}{M#你}不忙，要不要跟我一起去市集上逛逛？早上的蔬菜可是最水靈的哦。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#今天午飯除了緋櫻天婦羅還有三彩糰子！來，{F#妳}{M#你}和派蒙都有份，還有神里小姐和家主大人的…欸等下，我好像忘了準備自己的份。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#快走快走，這個時間去市場買魚能便宜不少。要是心血來潮想買什麼小東西，我幫{F#妳}{M#你}砍價。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#嗯，晚安。{F#妳}{M#你}這一天也辛苦了吧。早點休息去吧，別熬夜。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於托馬自己·家政官",
      "text": "不論是神里小姐還是家主大人，最初都沒打算讓我擔任家政官，還是我自告奮勇的。我很喜歡這些事情，將一切打理得井井有條，特別有成就感。看大家的反應…嗯，我應該做得不錯。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於托馬自己·意義",
      "text": "#把居住的地方打掃乾淨，佈置整齊，讓所有生活在這裡的人露出笑容，這就是家政的意義。至於現在…我會連帶著為了{F#妳}{M#你}的份一起，好好努力的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·一人食",
      "text": "#怎麼一個人在這安安靜靜吃飯？…嗯，{F#妳}{M#你}介不介意跟我一起？還是說{F#妳}{M#你}比較想一個人吃？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·立誓",
      "text": "#要不是{F#妳}{M#你}在「狩眼儀式」上站出來，單槍匹馬與將軍對抗，我應該已經失去神之眼、失去願望了。我想了很久，恐怕只有這樣才配得上{F#妳}{M#你}挺身而出的覺悟——\\n我，托馬，願獻上我的武藝與忠誠。不惜一切，為{F#妳}{M#你}而戰。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "既然得到了神之眼，就得好好珍惜，我可不想把它弄丟了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "以我長期和大家打交道的經驗來看，比起蒙德人，稻妻人更加在意禮節。要是能始終保持禮貌的態度，事情會變得好辦不少。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·狸貓",
      "text": "我一直想見識狸貓的變化手段。傳聞中，狸貓能夠變化成各種各樣的形態，跟路人開玩笑，是一種很有幽默感的生靈哦。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞·動物",
      "text": "#{F#妳}{M#你}喜歡小動物嗎？要是{F#妳}{M#你}也喜歡的話，下次我帶{F#妳}{M#你}去城郊附近走走。到時候我一聲口哨，好多可愛的小貓小狗就會鑽出來，黏在{F#妳}{M#你}的腳邊向{F#妳}{M#你}撒嬌。哈哈，光是想像就覺得很開心了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於八重神子…",
      "text": "神子大人？為、為什麼突然提她？唉，每次小姐派我出去送口信，我最不想去的就是鳴神大社了。啊，倒不是神子大人的氣場讓人發慌，而是，呃…是敬畏…敬畏！啊哈哈…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於雷電將軍·比較",
      "text": "在我的故鄉蒙德，絕大多數人都尊敬著風神巴巴托斯大人。但稻妻人對待將軍大人的態度就不同了。怎麼說呢…除了愛戴與感激，好像還有些畏懼的成分。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於雷電將軍·未知",
      "text": "說實話，我對將軍本人沒什麼怨恨。雖說她差點奪走我的神之眼，但那是因為她的立場特殊吧。立場不同是很正常的事情。\\n我想不明白的，是她的目的。她所設想的永恆國度到底是什麼樣？為什麼非得犧牲民眾的願望換取。我無法理解，也無法認同。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於北斗…",
      "text": "「南十字」船隊的大姐頭可真是個颯爽的人哪。她曾經允諾帶我去遙遠的外海，看看封鎖一切的雷暴是個什麼樣子。只是可惜，我一直沒這個機會出去看看…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於神里綾人…",
      "text": "家主大人也真的不容易。時局動盪，人心不安，同僚裡又有不少貪官敗類，想想都頭痛。我所能做的，也就是在生活方面給予些照顧了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "#神里小姐知書達理，心地善良又溫柔端莊，就是不夠坦率。欸對了，下次說話的時候，要是小姐又露出那副欲言又止的模樣，{F#妳}{M#你}一定要主動些，多問問她的想法。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於宵宮…",
      "text": "#「長野原煙花店」的那位店長？她很容易相處的，算是心直口快的類型。哦對了，她家的煙花也是厲害得很，有機會一定要多看幾次。喏，優惠券給{F#妳}{M#你}。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於早柚…",
      "text": "唉，早柚太倔強了。不管我找她多少次，都不肯傳授我忍術。甚至最近都刻意躲著我了…明明只是想求師而已，是我做得太過頭了嗎？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "這位天領奉行麾下的將領，嗯…跟她交涉得拿出十二分的謹慎。她手握實權，又有點固執，嬉皮笑臉是絕對行不通的。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "#那是市井傳聞中的怪人，據說還擁有妖怪的血脈，{F#妳}{M#你}見過他了嗎？要是你們熟絡的話，幫我引薦引薦唄。廣交朋友總是好事…妖怪朋友也算！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於鹿野院平藏…",
      "text": "嚯，他可是天領奉行那邊的「偵探」。他給人一種我行我素的感覺，不太容易打交道。另外，需要偵探出現的場合，一般也不會有什麼好事。我還是和風暴中心保持距離吧。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於琴…",
      "text": "古恩希爾德家的琴小姐做了西風騎士團的團長嗎？的確合適，她的優秀正直是出了名的…哦，目前還只是代理團長嗎？哈哈，那種名頭根本無所謂啦。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於優菈…",
      "text": "#{F#妳}{M#你}還遇見過優菈·勞倫斯嗎？我只知道，他們家的人脾氣爛透了，最好不要有什麼來往。啊，跟{F#妳}{M#你}聊這些，又想起了很多蒙德的往事…真好。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解托馬·其一",
      "text": "有什麼需要我幫忙的嗎？家中雜務、人際交往，一句話的事。欸？聊天嗎…這樣這樣。那倒是需要更用心一些了。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解托馬·其二",
      "text": "#我應該跟{F#妳}{M#你}提過吧？我不是土生土長的稻妻人。我是從蒙德一路坐船來的，因為喜歡這裡的風土，又遇到了家主大人和神里小姐這樣親切的人，乾脆就留了下來。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解托馬·其三",
      "text": "其實我也會有想老家的時候，所以，我特別能理解離島上那些外國商人，也想盡量多關照關照。不同的是，他們只把自己當作一個過客，並不想融入稻妻，因此也就只是過客了。大多數稻妻人不會把他們當自己人。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解托馬·其四",
      "text": "對一些保守的稻妻人來說，一個外國人要做奉行家的家臣，是幾乎不能想像的事。因此，我有過一段不受人待見的經歷。要不是他倆力保，恐怕我早被趕走了。為了不辜負神里家的恩情，那之後我誠心努力了很久，最終才被大家接納。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解托馬·其五",
      "text": "#這個跟{F#妳}{M#你}說…應該沒關係吧。有一陣子，我很想回老家去。畢竟蒙德才是我的故鄉，但稻妻…我同樣難以割捨。{F#妳}{M#你}看，我受過許多稻妻人的恩惠——神里家始終有留給我的房間，還有不是親人勝似親人的人。就算吃過苦頭，但也是幫助我的人多。想來想去，覺得自己還是留在稻妻好。實在想念蒙德的時候…就找{F#妳}{M#你}聊聊好了。{F#妳}{M#你}不會嫌棄我囉嗦吧？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "托馬的愛好…",
      "text": "最近的話，我比較喜歡怪談故事，那些千變萬化的妖怪實在是神奇。之前的話，對忍術也有不小的興趣。嗯？三分鐘熱度？…不，不是這樣的！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "托馬的煩惱…",
      "text": "我現在真的很煩惱。晚上大人要在家設宴招待朋友，說好了由我來露一手，做奶油蟹蟹撐場面的。結果這兩天根本買不到螃蟹！難道我只能下水抓螃蟹了嗎？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "要說我最喜歡的食物，那絕對是市井雜煮了。煮好香噴噴的一大鍋，然後大家一起分著吃，又熱鬧又開心。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "食物的範圍裡沒什麼，但如果飲料也算的話…我不怎麼能喝酒。別笑我，我也懷疑過自己是不是蒙德人了。不過…過量飲酒對身體有害，不喝酒，也是好事吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "好香！我還想再添一碗米飯！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}還有時間嗎？和我一起分享廚藝心得吧！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "沒怎麼嘗試過的味道…雖然也不壞吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#快跟我來，現在就來！{F#妳}{M#你}的生日我當然不會忘記，{F#妳}{M#你}看，準備好了一場大聚會。有吃有喝，還有一大幫{F#妳}{M#你}的朋友。嘿，這是紀念{F#妳}{M#你}誕生的好日子，我可不會讓{F#妳}{M#你}一個人孤零零地過！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "這樣就能變強嗎？不是在開玩笑吧，我還有衣服沒洗完呢。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "似乎…有一股火焰在我心中燃燒。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "擁有了強大的力量，要用來做什麼呢？嗯…得好好考慮考慮了啊。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#謝謝{F#妳}{M#你}對我的信賴。{F#妳}{M#你}給予我的恩惠，比火焰更溫暖。放心吧，我找到自己想做的事了。這份力量將化作堅盾，一直守護{F#妳}{M#你}。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "火之盾！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "看看這個。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "小心著火。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "後援登場。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "護持之火！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "#我來守護{F#妳}{M#你}。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "裡面有什麼好東西呢？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "喲，果然今天運勢大吉。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嘿嘿，見者有份。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "喂！有必要嗎？"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "慘了慘了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "嘶，有那麼點痛…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "別怕，我會保護你的。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "真是亂來，快去歇著。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "要回老家了啊…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "各位…保重。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "沒能盡到…守護的職責…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "疼疼疼。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "住手！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "好吧，家務待會再說。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "出門找點新朋友。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "這次去哪裡逛逛？"
    }
  ]
}