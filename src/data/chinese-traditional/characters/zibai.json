    {
      "id": "the_selenic_adeptus_descends",
      "name": "月下素娥降仙",
      "description": "施放元素戰技<color=#FFD780FF><b>天地忽然身</b></color>時，或隊伍中附近的角色觸發月籠諧奏時，茲白將獲得持續4秒的<span style=\"color:#FFD780FF\">「太陰降」</span>效果：<b><span style=\"color:#FFD780FF\">靈駒飛踏</span></b>第二段攻擊造成的傷害提升，提升值相當於茲白防禦力的60%。",
      "level": 1
    },
    {
      "id": "layered_peaks_pierce_the_clouds",
      "name": "疊嶂巒岫出雲",
      "description": "隊伍中每存在一名元素類型為<span style=\"color:#FFE699FF\">岩元素</span>的其他角色，都會使茲白的防禦力提升15%。隊伍中每存在一名元素類型為<span style=\"color:#80C0FFFF\">水元素</span>的其他角色，都會使茲白的元素精通提升60點。",
      "level": 4
    },
    {
      "id": "moonsign_benediction_the_coursing_sun_and_moon",
      "name": "月兆祝賜·浮明若流",
      "description": "隊伍中的角色觸發水元素結晶反應時，將轉為觸發月結晶反應，且基於茲白的防禦力，提升隊伍中角色造成的月結晶反應的基礎傷害：每100點防禦力都將提升0.7%月結晶反應的基礎傷害，至多依此方式提升14%傷害。<br/><br/>此外，茲白在隊伍中時，隊伍的<span style=\"color:#FFD780FF\">月兆</span>將會上升一級。",
      "level": 0
    },
    {
      "id": "moonlit_flower_forest",
      "name": "花林如霰",
      "description": "在夜間（18時至6時），不處於戰鬥狀態下時，每2秒為茲白恢復1點元素能量。<br/>該效果在秘境、征討領域、深境螺旋中無效。",
      "level": 0
    }
  ],
