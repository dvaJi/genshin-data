  "outfits": [
    {
      "id": 209200,
      "name": "萬里飛虹",
      "description": "嘉明的裝扮款式。出門在外，行頭不需繁雜。幾件素衣疊穿，一雙舒適布鞋，輕便又穩陣。",
      "isDefault": true,
      "characterName": "嘉明",
      "characterId": 10000092,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Gaming_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#老闆{F#妳}{M#你}好呀，我是和記廳的鏢師，叫我嘉明就行，要運貨嗎{F#妳}{M#你}？請坐請坐，飲杯茶先，我幫{F#妳}{M#你}打包好貨就可以排期出發了！哦！如果是找我舞獸的話即刻可以出發！「威水舞獸隊」我就是話事人，嘿嘿，失禮失禮。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·舞獸",
      "text": "咚咚鏘，睜眼！咚咚咚咚鏘，洗鬚！唔…不好不好，還要練多點先。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·走鏢",
      "text": "水路山路陸路，走鏢時什麼路沒走過啊我？放心啦，金牌鏢師不是浪得虛名的。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·早茶",
      "text": "一盅兩件，再加個白灼時蔬和生滾靚粥，嗯…正啊…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "下雨啦！收衫啦！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#嗱嗱嗱，{F#妳}{M#你}聽，壞人發誓天打雷劈啊！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "啊——咦？為什麼下不到我嘴裡的？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "曬點太陽好啊，去去濕氣。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "這種地方買水喝肯定很貴吧？好在我自己帶水了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "我練完功了，準備去喝早茶，一起？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "雖然叫早茶，其實中午也能喝的，怎麼說，走？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "我訂到一間菜館，夜晚才開門，聽說只做熟客生意的，來都來了，不吃就走寶了，出發？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "要睡了嗎？餓不餓啊？不如吃個宵夜先？"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於嘉明自己·老家",
      "text": "#翹英莊，去過嗎？我老家。我們那裡茶葉很出名的，有「松蘿仙芽」，還有「遊韻單叢」。這樣這樣，擇日不如撞日，我這裡有盒靚單叢，我現在帶去茶樓，給{F#妳}{M#你}泡一壺，走走走，我埋單！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於嘉明自己·今時今日",
      "text": "我嘉明今時今日，有口飯吃，還能有時間精力鑽研舞獸戲，真的要多謝周圍好多人的理解和提攜。將心比心，我肯定會打醒十二分精神做好這份工。還有餘力，就多跑跑腿啊、請人飲茶啊，又不會少塊肉了，哈哈。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·賞臉",
      "text": "不用運貨的時候我通常在璃月港路邊表演舞獸戲，賞個臉來看看？不要錢的不要錢的，只要街坊朋友看得開心我就很滿足啦。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·得閒飲茶",
      "text": "#記住啊，出門靠朋友，有什麼困難不要硬撐喔{F#妳}{M#你}，需要我幫手隨時出聲！欸，大吉利是！最好就別聽到{F#妳}{M#你}有難的訊息啦，出門在外，最緊要是平平安安順順利利，我更希望聽到{F#妳}{M#你}約我得閒飲茶了。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#武俠小說有寫，打通任督二脈之後就會變成武林高手，拿到神之眼的瞬間就是這種感覺…哈哈，講笑而已！我不是什麼武林高手，不過是多了點精力，那就順手幫襯下街坊了。不過講開又講，{F#妳}{M#你}沒有神之眼都這麼厲害，有了還得了？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#「文仔」好調皮的，本來咧，我想他文靜一點才取的這個名，呃…如{F#妳}{M#你}所見，好像沒什麼用哈哈。不過也好，生生猛猛才能將舞獸戲做得風生水起嘛。看著文仔，我也慢慢能模仿出猊獸的神態動作，一戴上獸首，感覺就來了喂，吼！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "有很多花花草草，或者樹皮樹枝，曬乾後用來煲水喝，生津解渴，清熱降燥，好有益的！我阿婆阿嬸都跟我講過，吃煎炸食物前後，一定要記得喝這種「涼茶」，清清體內的熱氣喔。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於香菱…",
      "text": "香菱大師傅有好多拿手菜，我最喜歡那味水煮黑背鱸，雖然每次都用水涮了兩次先吃，還是辣得我「嘶哈嘶哈」，哈哈哈，不愧是萬民堂的生招牌，用料真足火候真猛！下次我還吃！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於行秋…",
      "text": "飛雲商會是鏢局的老主顧了，印象中一直都是他們的大少爺在打理生意上的事情，有次行秋少爺難得主動問起鏢物的事，我就一五一十地將飛雲商會最近貨物的路線和收發日子告訴他，結果他問的是能不能透露一下萬文集舍最新那批貨什麼時候到，哈哈哈。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於重雲…",
      "text": "聽說那位仁兄有「純陽之體」，按照我們那邊的說法，他體內可能虛火很旺啊，應該多喝點涼茶喔他。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於刻晴…",
      "text": "多得玉衡星大人，她帶頭整治完遺瓏埠跟璃月港之間的運輸路段之後，盜賊都不敢那麼猖獗了。我會不會失業？哈哈，那又未必，就算不用跟賊人打架了，擔擔抬抬這種粗重工夫總要有人幹的嘛。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於白朮…",
      "text": "走鏢也好舞獸也好，跌打損傷都是家常便飯。好在有白大夫，他配的藥真是舟車勞頓、居家旅行的必備良藥，鏢局的兄弟們都託我來璃月港的時候幫手帶點回去的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於七七…",
      "text": "#七七小妹妹非常熱心，見我每次來不卜廬都抓很多藥，覺得我是因為身體僵硬才會摔跤受傷，所以教我做了柔軟體操，哈哈，好簡單的，{F#妳}{M#你}也試試？來，一二七七…二二七七…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於雲堇…",
      "text": "雲堇大師是我榜樣啊！不管內行外行，聽過她的曲的都說好。真是不得了，什麼時候「威水隊」能做到「雲翰社」一半的影響力…我做夢都會笑醒！"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於辛焱…",
      "text": "#辛焱的演唱實在是太有感染力了！文仔聽的時候也一直搖頭晃腦的，喜歡得不得了！有機會的話真想請她一起辦一個「火爆搖滾舞獸會」，{F#妳}{M#你}見識多，{F#妳}{M#你}覺得有沒有搞頭？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於閒雲…",
      "text": "閒雲姨很關照我，見我的獸首磨損了，馬上說要做十個八個比我人還高的獸首給我，我講到口水都乾了，她才同意在我原來這個上改良…現在我這個獸首，又威武又輕便，獸披隨時隨地都能飄起來，就像有仙風托住一樣！我超喜歡！"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於鍾離…",
      "text": "我猜那位鍾離先生一定是位出身富貴的文人雅士。不管我運貨到茶館還是戲臺，都能撞見他在喝茶聽書，一看就懂很多的樣子。哇，有次無意中聽到他跟別人講茶，當時我就覺得他跟我老爸肯定可以講通宵了…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "#哦，那位記者小姐啊嘛！我知道她！遺瓏埠的楓丹人都喜歡看《蒸汽鳥報》，我也經常蹭著看看，有很多不得了的新聞都是她寫的喔！哦！我記得{F#妳}{M#你}還上過頭條啊！是不是？"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於藍硯…",
      "text": "#認識她，{F#妳}{M#你}有食神啦！{F#妳}{M#你}讓藍硯帶{F#妳}{M#你}去山裡吃農家菜，點名要去可以自帶食材加工的農莊——{F#妳}{M#你}說是嘉明指定那家她就知道了。那條山路特別難走，沒有她這樣有經驗的當地人帶路，我怕{F#妳}{M#你}走到天黑都找不到。{F#妳}{M#你}們儘管去吃，報我名字就行，老闆認識我的，吃完入我數！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解嘉明·其一",
      "text": "#鏢師裡最會舞獸的，舞獸師傅裡運過最多鏢的，怎麼樣？這樣介紹不知道能不能讓{F#妳}{M#你}記住我咧？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解嘉明·其二",
      "text": "是不是三腳貓功夫看基本功就知道了，紮馬、踢腿、劈叉、彈跳、翻滾…連這些都半桶水，輕則從高樁上跌下來，躺他個一頭半個月。重則運鏢打不過人，失鏢喪命…嚇不嚇人？嚇人就對了嘛，當初我就是這樣說服鏢局的兄弟每日同我一起練功的，哈哈哈。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解嘉明·其三",
      "text": "獸首獸披啊、鑼鼓鈸鑔啊，練得多了舊得也快，要勤力點養護，這裡面得花不少錢呢。再加上平時請人吃飯喝茶、過時過節送送禮、兄弟們周轉不靈借點錢…七七八八加起來，一個月走鏢賺的錢就沒幾多剩了…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解嘉明·其四",
      "text": "老爸一直想我跟他學做生意，不是沒想過啊我，正是因為想清楚了才離家出走的。一來要證明給他看，我舞獸不是三分鐘熱度，一定會出人頭地！二來嘛，也可以跟老爸少打點仗…兩父子哪有隔夜仇的，我不是恨他，只是他每次開口火藥味都很重，我避得到就避了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解嘉明·其五",
      "text": "嗱，這裡，前兩日練踢腿，淤了一片…這個包，上個月練翻滾的時候撞的，已經快好了~這個疤就厲害了，是我第一次上高樁時摔下來弄的，那時流了好多好多血，差點以為我的舞獸生涯剛剛開始就要結束了…不過好彩，這麼多年來都是有驚無險，我還能繼續…嗯，一定要繼續。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "嘉明的愛好…",
      "text": "#早茶不只有茶啦，還有各種甜點鹹點，有即點即上的也有現點現做的，每次喝完早茶我都不用吃午飯了。{F#妳}{M#你}得閒就叫我，我請{F#妳}{M#你}飲茶！想吃什麼就點什麼，沒所謂的吃不完打包回去嘛。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "嘉明的煩惱…",
      "text": "什麼？！茶位費就算了，擦手帕都要另外收錢的？好在我自己有帶，退掉退掉。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "小時候很頑皮的我，還記得每次闖禍後我不聽教，我老媽都會氣得罵一句「生塊叉燒好過生你」，現在每次吃叉燒，還滿想老媽的…"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "他們總說我口味刁鑽，我的要求很簡單啊——禽肉有禽肉味，魚肉有魚肉味，很過分嗎？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "這個味道——難道閣下的真實身分就是「神」？沒說錯吧？「廚神」閣下。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "你親手做的？有心了有心了！這樣的烹飪水平，擺到明是高手啦！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "錯就要認，打就要立正！如果我哪裡行差踏錯了不如你還是直接打我一頓吧！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#不是吧{F#妳}{M#你}，生日這麼好的日子都不提前告訴我？好在我已經在新月軒訂好一桌子菜啦，八菜一湯白飯任裝，還有壽包和糖水，叫多點朋友一起來賀一賀呀。另外咧，我還準備了一小段祝壽舞獸戲，小小意思，不成敬意，希望{F#妳}{M#你}鐘意啦。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哇，這些都給我了？這麼大手筆，怎麼好意思啊？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#哈哈，真看得起我啊，那我不練個砂鍋那麼大的拳頭有點對不住{F#妳}{M#你}喔。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#走鏢也是鏢，保鏢也是鏢，信得過我的話，以後我來當{F#妳}{M#你}保鏢了？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#多謝{F#妳}{M#你}為我的獸首點睛，接下來的旅途，不敢說包{F#妳}{M#你}順風順水，但我一定會落力豁出去，幫{F#妳}{M#你}採青！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "對不住了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "採青先！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "中頭獎啦！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "鴻運當頭。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "文仔，到你出馬！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "威水舞獸！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "開啟寶箱·其一",
      "text": "哇，好靚喔這批貨！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "開啟寶箱·其二",
      "text": "這趟鏢要運去哪呢老闆？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "開啟寶箱·其三",
      "text": "淡淡定定，有財進。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "小小痛楚等於激勵…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "呵，小意思啦…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "頂得住！繼續！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "歇一陣先，包在我身上！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "喂！不要硬撐啊！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "呵，我走先啦…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "還沒「採青」呢…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "快點走…不用理我…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不是吧你！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "停手！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "走鏢去囉。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "收到，開樁！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "急嗎？不急喝個早茶先？"
    }
  ]
}