  "outfits": [
    {
      "id": 203800,
      "name": "朔分星芒",
      "description": "阿貝多的裝扮款式。阿貝多實驗時常穿著的西風騎士團煉金術士制服。",
      "isDefault": true,
      "characterName": "阿貝多",
      "characterId": 10000038,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Albedo_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是阿貝多，西風騎士團首席煉金術士。我對{F#妳}{M#你}身上星海的氣息很感興趣，想要就近觀察研究。相信以後我們會有很多獨處的機會。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·寫生",
      "text": "風景不錯，趁著休息，就把這一幕畫下來吧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·深究",
      "text": "「世界的真相」…究竟是什麼呢？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·懷舊",
      "text": "用自己的雙腳丈量土地，將「未知」變為知識。…這種感覺，真懷念啊。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "土壤濕潤，適合採集爆爆瓜的根。沒關係，我來動手就可以。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "師父…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "光線充足，生物行為活躍，嗯，很適合寫生。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安，是準備出門尋找古代遺物嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午安，我聽到了{F#妳}{M#你}的腳步聲。工坊之外真是熱鬧啊。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "外面安靜下來了，呼。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#晚安，{F#妳}{M#你}先去休息吧，我打算把最後一個實驗做完。既然{F#妳}{M#你}那麼感興趣…明日再會時，我再與{F#妳}{M#你}一起探討實驗結果吧。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於阿貝多自己·天才",
      "text": "天才？…不少人這麼稱呼我。其實，我不這樣認為。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於阿貝多自己·人際",
      "text": "與人交往…很麻煩。一旦開始就要不斷維持，如果聯繫中斷了，想再重新恢復，就得消耗更多的時間。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·實驗",
      "text": "#{F#妳}{M#你}…這是準備陪我做實驗嗎？呼，真榮幸。\\n啊，不用緊張。我的實驗雖然危險，但通常不會傷及無辜。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·助手",
      "text": "#能麻煩{F#妳}{M#你}當我的助手嗎？鑑於{F#妳}{M#你}旁觀了那麼多次，想必早就熟練了吧。放心，我在{F#妳}{M#你}旁邊。就算是第一次實際操作，也不會有問題的。我相信我的指導能力，更相信{F#妳}{M#你}的天賦。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」？不過就是個實驗用的工具罷了，和燒杯、坩堝沒什麼不同。唯一讓我感興趣的，就是它的原理…我總有一天會研究明白的，這只是時間問題。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#一直有些難以開口，因為假設被{F#妳}{M#你}拒絕的話，我可能會失落吧…\\n嗯…我對{F#妳}{M#你}身邊那個飛著的小傢伙很感興趣，方便讓我拿去研究一下嗎？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#想知道更多石化古樹的事情？唔…{F#妳}{M#你}在附近秘境裡觀測到的那些，其實不算古老。稍微成熟一些的樹，一般能長到兩三公里高；在樹的根部，常常聚集著一種大蜘蛛。那種蜘蛛啊，用地梔子和香茅草捆緊，抹上白豆蔻，燻烤上幾個小時，那香味，是真的很…令我難忘。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於親人…",
      "text": "親人嗎？雖然艾莉絲總希望我叫她媽媽…唔，但在我心裡，談起親人第一時間想到的還是師父吧。我從有記憶起就和她一起探險了，她教會了我煉金術和世間無數知識。或許…「親人」或者「師父」，這些詞彙都不足以描繪出她對我而言的意義吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於砂糖·方向",
      "text": "砂糖嗎？我大概能理解她一心專攻「生物煉金」的理由…不管怎樣，看到她的研究越來越順利，我也為她感到高興。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於砂糖·堅持",
      "text": "雖然在學術方面的合作非常愉快，但課題以外的部分，砂糖也有很多她自己的堅持。比如我告訴她我們是平輩，叫我阿貝多就好，她卻堅持要用尊稱。…只好隨她了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於麗莎…",
      "text": "麗莎嗎？和她討論總會得到很有價值的觀點。如此有才華卻滿足於圖書管理員一職，想必背後藏著與那才華等重的因緣吧。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於可莉…",
      "text": "我的確把可莉當作親妹妹一樣看，所以每當這位妹妹惹出麻煩的時候，我都只能安慰自己，至少她現在的破壞力，還不及艾莉絲女士的零頭。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於琴…",
      "text": "琴嗎？她是一位正直的代理團長，甚至可以說比那位團長大人更為可靠。可能大家心中都在期待著她成為正式團長的那一天吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於行秋…",
      "text": "行秋嗎？他寫的小說挺有趣的。稻妻那邊的「八重堂」一直在旁敲側擊，希望我和別的作者合作，說這樣版稅收入也會更好。哼，我缺這點錢嗎？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "#芭芭拉嗎？她是一位認真的牧師，說來以前碰巧有機會為她畫過速寫…{F#妳}{M#你}問畫呢？嗯…我拒絕了艾伯特的開價，直接把畫送給了代理團長。人際交往…真是耗費精力啊。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於杜林…",
      "text": "我的這位兄弟正在探索很多新事物，他很聰明，也熱衷於思考。儘管他時常因此陷入某些認知困境，但這並不影響他對這個世界保持熱情。他的到來——或者說，他作為家人的到來——讓我對人類關係的理解有了新的心得。現在，有了最親近的同類，家裡變得熱鬧起來，這無疑是一種好的改變。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於布倫妮…",
      "text": "她時常找我探討「存在的本質」。不過，每當我提出幾個反問，討論就會提前結束。值得高興的是，她下次還會帶著寫滿答案的筆記本再來。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解阿貝多·其一",
      "text": "有問題想問我？請說吧。啊，冒昧地問一句，應該不會花費太多時間吧？手頭的研究馬上要進入最後一個階段了。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解阿貝多·其二",
      "text": "啊，隨口一提。沒有人為介入的話，黃金需要殺死一個八倍大的太陽才能自然生成。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解阿貝多·其三",
      "text": "人物畫的耗時主要和心情有關。有時候霍夫曼我也能畫半天，有時候凱亞都只需要三筆——這個圓是臉，這個是眼罩的帶子…這個是眼罩。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解阿貝多·其四",
      "text": "除了畫畫和研究之外的生活…我偶爾會去看稻妻和璃月的小說吧，能看到很多很有趣的想法，有時也會為創作提供意想不到的靈感。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解阿貝多·其五",
      "text": "#即便到了現在，師父傳授給我的「黑土之術」仍是充滿了謎團，師父到底想要用這個技術創造出什麼呢？…研究之期還遠未到盡頭，得麻煩{F#妳}{M#你}和我一起繼續探索了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "阿貝多的愛好…",
      "text": "嗯…研究之外我最願意花時間去做的應該是畫畫吧。一開始只是為了理解物體與材料的構成，便於研究開展，不過到了後來就變成了愛好。嗯，也是一種很好的放鬆方式。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "阿貝多的煩惱…",
      "text": "時間真是不夠用啊，即使把大部分麻煩的事情都推掉還是會覺得時間不夠。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我挺喜歡甜點的。怎麼說呢…在體力和精力同時消耗殆盡的時候，高能量的物質會提供原始而高效的支援吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "討厭的食物？餐館裡分量比較大的肉吧。我的胃口吃不了多少，只會面臨「浪費」或者「失去風味」的結局。後來我就乾脆不去餐館了，雖然這也意味著要花更多時間在做菜上…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "味覺彷彿折射出了色彩…我想它是金色的。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}似乎很願意花時間在做菜上，所以才能做出這樣的味道。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "量有點大…要一起分享嗎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。{F#妳}{M#你}看起來很高興，可以將{F#妳}{M#你}的樣子畫下來嗎？大腦的容量是有限的，人總會不斷忘記。如果畫在紙上，那麼這些畫就成了記憶的延伸，在未來重新看到這些畫面時，一定能回想起當時的感覺吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "「黑土」，是煉金術的詞源，也是最初的狀態。活在這個世界上，我等俗類必須尋找意義。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "「白堊」，即是變化的開始。抽離了雜質，準備好接受一切知識。要和我一起去探索世界嗎？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#「赤成」，煉金術中的意思是，情感的煉化。我的赤色好像來自於{F#妳}{M#你}。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "「黃金」，煉金術最後的階段。無價值的事物終於找到了自己的意義，變化成了黃金。我，也找到了意義。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "綻放吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "擬造陽華。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "創生之法。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "此即，誕生之刻。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "冥古，於此顯生。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "見證偉業吧。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "大地的秘寶。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "無言的敘事。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "雖無法比擬「黃金」，但終有價值。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "計算失誤…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "需要重新評估…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "必須改變策略。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "交給我吧。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "換人，對你來說太危險了。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "塵歸塵，土歸土…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "實驗失敗了嗎？"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我的研究，結束了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "閾值以內…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "失算了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "瞭解。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "是拓展課題嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "一起探索吧。"
    }
  ]
}