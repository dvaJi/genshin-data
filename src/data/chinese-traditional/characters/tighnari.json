  "outfits": [
    {
      "id": 206900,
      "name": "森林之歌",
      "description": "提納里的裝扮款式。把花草樹木的色彩穿在身上，讓自然的生機時刻包裹自己。即便是在衣著上，巡林官提納里也總是偏向更有森林氣息的選擇。",
      "isDefault": true,
      "characterName": "提納里",
      "characterId": 10000069,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Tighnari_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，我叫提納里，是道成林的巡林官，負責維護雨林生態與行人安全。若{F#妳}{M#你}初入此地，我的建議是先通讀《道成林生存指南》，並重點閱讀〈如何分辨可食用蕈與有毒蕈類〉一章。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·葉片書籤",
      "text": "將樹葉夾在乾燥的紙頁之間簡單壓製，就能做成好看又好用的書籤了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·犯錯",
      "text": "不要害怕犯錯，犯錯也是學習過程中的一環。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·知識的價值",
      "text": "知識的價值，是不能用金錢簡單衡量的。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "#這種天氣我已經習慣了，但{F#妳}{M#你}最好還是撐個傘哦。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "我的尾巴塗過用來防水的植物精油，甩甩就乾啦。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的時候…",
      "text": "哎呦，好響的雷！嗚…震得腦袋疼。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#這種天氣可真少見！哎，{F#妳}{M#你}冷嗎？冷的話可以把手埋進我的尾巴毛裡。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "耳朵！…耳朵要吹翻過去了。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "…好熱啊…這麼毒的太陽下，哪怕是冰霧花也會融化的吧…啊，仔細想想，其實不會啦，啊哈哈…唉…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "聽！是晨露滴落葉梢的聲音。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午休的時候我喜歡坐在樹上，盯著從樹枝縫隙間漏下來的陽光發呆，一不留神就會睡著…哈哈。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚安。我正準備去觀察夜光植被，要一起來嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}睡吧，我來守夜，順便記錄今天的巡林日誌。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於提納里自己·專業",
      "text": "我以前上學時從屬生論派，主攻植物學。本來導師想讓我畢業後留校任教，但說實話，我喜歡更自由一些的研究環境，而且就我的觀察，教令院的某些行事作風令人不敢恭維。還好當時導師沒有強求——…他強求也沒用。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於提納里自己·族人",
      "text": "確實有不少人覺得我這一族性格孤僻，也不怪他們這樣想。我的族人確實數量很少，還大多是學者，總是為了研究到處跑，一年也見不到一根尾巴毛。像我爸就是昆蟲學家，最近好像在沙漠裡研究甲蟲的古今演化過程，啊我就不跟著去湊熱鬧了。說來慚愧，我不擅長應付烈日。曬久了腦袋裡就一團漿糊，搖搖晃晃的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·相處",
      "text": "我認為人與人之間相互瞭解的最好辦法就是多花時間相處，其他的都不實際。所以不必急著自我介紹，時間會沉澱一切。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·朋友",
      "text": "#{F#妳}{M#你}問我們算是朋友嗎？怎麼，原來這種事情是需要官方認證的嗎？那趕緊把{F#妳}{M#你}的「朋友證書」拿出來，我必須在上面簽字。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我記得自己小時候曾經祈禱過，如果能有幸擁有「神之眼」，那一定要是草元素呀。不過那時的原因不是為了研究，而是想要製造藤蔓梯子，爬上去摘高處的果子吃。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·蘭那羅",
      "text": "我對這種生物早有耳聞，卻一直沒有親眼見過。有時樹林深處會有一些窸窸窣窣的響動，等我靠近時卻又消失不見。這樣也好，至少牠們懂得如何保護自己，比那些碰見叢林豹還要上去親切慰問的笨蛋冒險家們厲害多了。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·卡卡塔",
      "text": "#卡卡塔的事情{F#妳}{M#你}不必擔心。我已經跟認識的風紀官打過招呼，說卡卡塔是我研究工作中的助手，要動它的話得先找我過問——嗯怎麼，看{F#妳}{M#你}還挺惦記它的，要不要去素論派選些課程學學？那樣就算有一天我不在了，{F#妳}{M#你}也能繼續照顧它。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}知道嗎？植物會偽裝術。有些會擬態成昆蟲或者鳥類，恐嚇天敵；有些會製造誘餌，吸引其他生物為自己傳播花粉；還有一些則是純粹的捕食者，用香味或蜜糖吸引獵物上門…嗯，說到這裡，感覺已經不只是植物會這樣了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於柯萊…",
      "text": "#這孩子剛被帶過來的時候，可以說是大字不識一個。不過問題不大。她學習勤奮，態度也認真，進步很快。只是，距離她習得精湛醫術的目標還有很遠的路要走。她有時會給自己很大的壓力…噢，{F#妳}{M#你}有機會的話也多幫幫她吧？就當是我這個做師父的拜託{F#妳}{M#你}啦，多謝。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於賽諾·大風紀官",
      "text": "#{F#妳}{M#你}想見賽諾？那我醜話說在前頭，被他因為公事追在屁股後面可是要倒大霉的。大風紀官畢竟位高權重，平日裡還真不好找。不過他偶爾會到化城郭附近偷偷看望柯萊，就算他不想讓人看見，我也能聽出是他。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於賽諾·為什麼呢",
      "text": "在導師被救出來後，我向他寫了一封問候信，但沒想到導師說已經有人以我的名義拜訪過他了，並在回信的結尾附上了一個問題：「為什麼大風紀官說要靠須彌『強威』重振賢者們的名望？」\\n…問得好，到底是為什麼呢。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於艾爾海森…",
      "text": "小心艾爾海森。啊，倒不是說他是什麼壞蛋啦，但他做事始終被理性主導，總會有讓常人覺得無法接受的地方。不信的話可以去看看他的室友，經常被他氣得比風史萊姆還鼓。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於卡維…",
      "text": "卡維是須彌著名的建築師，代表作就是那座醒目的卡薩扎萊宮。當初在設計建造的時候，他還來找我諮詢過有沒有合適的觀賞植物推薦。但不知是怎麼搞的，他在宮殿完工後卻讓自己背了一身債，目前正被學弟艾爾海森接濟，借住在他家。這個…該說是幸，還是不幸呢…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於多莉…",
      "text": "大名鼎鼎的桑歌瑪哈巴依老爺——就是多莉啦。我能認識她，還是因為有次研究需要用到很稀有的材料，只有進貨管道成謎的多莉才能拿得到。啊那個…別問我找她買了什麼，也別問我當時在研究什麼，嗯。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於萊依拉…",
      "text": "我聽說過她，遠近聞名的「夢遊怪人」。關於她「夢遊」的傳聞真是千奇百怪，什麼怪力千斤頂啦、夜闖阿如村啦、徒手翻越防沙壁啦…甚至還有說她能邊睡邊寫完十萬字論文的！這都什麼跟什麼，完全不可信。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於麗莎…",
      "text": "我聽賽諾說過他的這位師姐，是難得一見的天才，博學多聞，才華橫溢，只可惜早早就回到了蒙德。難道她在進修的過程中，見到了「知識」令人畏懼的一面嗎…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "我在上學的時候曾聽過這樣的說法：「植物的歷史，便是草之國的歷史。」也許說者無心，但我總覺得此話另有深意。如果我有一天能見到小草神大人，她會為我解釋嗎？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於迪希雅…",
      "text": "之前情況危急，都沒來得及好好向她道謝。能有這樣強大又可靠的同伴是件非常幸運的事情，想要拉攏她的人一定不少。不過迪希雅看起來不像是願意加入教令院或者巡林隊的樣子，我就不去自討沒趣了。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於琺露珊…",
      "text": "琺露珊前輩見識廣博，我經常邀請她來檢查雨林裡的機關…只是希望下次她來化城郭的時候，不要再對柯萊偷偷塞吃的了——營養就跟藥劑一樣得均衡適量，過剩了可沒好處。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於賽索斯…",
      "text": "#{F#妳}{M#你}說賽索斯？他很有趣，有點像賽諾的遠房親戚，而且很好相處。上次他來化城郭作客，搶著要秀一手搭帳篷的技術，還跟賽諾爭著撈魚，柯萊覺得自己的工作被取代了很鬱悶呢。\\n大家都說賽索斯很擅長逗自己開心，過得很快活，工作起來又很認真。喔，說工作好像不太貼切，緘默之殿的事對他而言，比起工作更像是義務。如果{F#妳}{M#你}在沙漠需要幫助可以找他。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解提納里·其一",
      "text": "雨林生活還過得習慣嗎？建議眼觀六路，耳聽八方，注意安全，有事記得找巡林員。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解提納里·其二",
      "text": "哎，有時還挺羡慕那些什麼都搞不清楚，還敢到處亂摸亂吃的傢伙——在他們的世界裡，一定處處都有「奇蹟」發生吧？"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解提納里·其三",
      "text": "為了提昇管理道成林的品質，我時不時會為巡林員們開設「培訓」課程。要是逐字逐句深究的話，這些課程其實都算是在「傳播知識」。不過教令院又能怎樣呢？有本事就把我關起來，看看「健康之家」每天要多收多少千奇百怪的病患吧。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解提納里·其四",
      "text": "#悄悄跟{F#妳}{M#你}說啊，其實我很喜歡城裡大巴扎的氛圍。買賣興旺，生活熱鬧，還有人在劇場裡唱歌跳舞。但是很遺憾，嘈雜的聲音對我的耳朵太不友好了。嗯？{F#妳}{M#你}說可以在背後幫我捂住？哈哈，那也太難走路了，但是心意我領啦。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解提納里·其五",
      "text": "#我小時候做過許多美妙又奇幻的夢，但它們在我長大後的某一天，永遠地消散在了記憶中。{F#妳}{M#你}還可以做夢嗎？說說{F#妳}{M#你}的夢給我聽吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "提納里的愛好…",
      "text": "道成林裡經常有掉在地上的樹葉和花朵，有些在掉落的時候還很完整，就這麼扔在地上太可惜了…我總是忍不住把它們撿回來做成標本。既可以變成培訓巡林員的教具，還可以當作漂亮的裝飾品，一舉多得。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "提納里的煩惱…",
      "text": "煩惱嗎？嗯，我想想…道成林中出現的汙染、經常惹麻煩的冒險家、總是想要撲我尾巴的救援犬…但這些問題總有解決的辦法。要說大的煩惱，還真沒有。這麼一看，巡林官的生活還挺簡單的呢。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "說起來有點稀奇，我身體裡雖然流淌著肉食動物的血脈，但最無法割捨的食物卻是蘑菇。可食用的蘑菇種類繁多，無論是新鮮的還是晾乾的，都會散發獨特的香味。與肉類一起燉煮時，就連肉香也要為它們讓步。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "因為嗅覺太靈敏，我無福享受添加了太多香料的佳餚。唉，這在須彌可以說是重大遺憾了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "食材優質，調味精妙，簡而言之——非常好吃。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#不錯的搭配。可以請{F#妳}{M#你}抄份食譜給我嗎？我想把它加入巡林小隊下次聚餐的菜單裡。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#…需要我教{F#妳}{M#你}一些新菜嗎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！我選了一盆今日花期正盛的盆栽給{F#妳}{M#你}，另附養花指南。萬一它之後出現任何問題，都請不要客氣，隨時找我，它有「巡林官終生保育憑證」。\\n{F#妳}{M#你}知道嗎，在{F#妳}{M#你}生日時開的花可多了，我挑了好久呢。等到明年，再送{F#妳}{M#你}新的品種吧！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "種子萌發，破土生根。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "幼苗拔高，開枝展葉。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "花蕾滿枝，杏雨梨雲。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "碩果豐熟，來日更盛。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "一葉障目。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "障眼法！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "看不清了吧？"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "斬草除根！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "蔓引株連！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "聲音，我聽見了。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "跟緊了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "這裡怎麼會有寶箱？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "這個，應該不用寫失物招領吧。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "聞起來有好東西哦。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "唉，真是麻煩。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "尾巴毛都亂了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "該清雜草了。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "快去療傷。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "救人要緊。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "葉落…歸根…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "還有未完成的研究…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "沒能等到花開…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "哎呦。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "行啊？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "沒完沒了！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "等著入土吧！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "我來帶路。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "唉！有誰又吃毒蘑菇了嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "走，去採些樣本！"
    }
  ]
}