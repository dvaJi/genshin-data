  "outfits": [
    {
      "id": 209800,
      "name": "榮光之劍",
      "description": "克洛琳德的裝扮款式。在沒有力量作為擔保的情況下，法律的尊嚴和正義的秩序難免顯得脆弱。而身穿工作制服的克洛琳德成為了最凌厲的震懾。",
      "isDefault": true,
      "characterName": "克洛琳德",
      "characterId": 10000098,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Clorinde_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#楓丹廷決鬥代理人，克洛琳德，向{F#妳}{M#你}致意。如需僱用我來代理決鬥，請先陳述{F#妳}{M#你}所陷之糾紛…無需贅述人情，這與我無關。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·對手",
      "text": "我在決鬥中遇過不少對手，他們大部分都落敗了，剩下的則主動投降…我有沒有輸過？沒有。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·決鬥代理人",
      "text": "決鬥代理人是我的職業，我怎麼想並不重要。因為握緊長劍之時，我代表的是楓丹的律法與規則。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·制勝訣竅",
      "text": "#決鬥是意志的對戰，劍則是決鬥者心靈的延伸。如果{F#妳}{M#你}的心已然畏縮，那{F#妳}{M#你}的劍也會如同裹鞘一般，無法斬敗任何人。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "獵物會在雨天休息，但獵人不能。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "看來風和雲的對決分出勝負了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的時候…",
      "text": "希望世界上能少個惡徒。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候…",
      "text": "真新奇，但也夠冷清的。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "我從來沒這麼想念過楓丹。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安。我正準備去喝杯咖啡，一起嗎？我有自備咖啡杯，如果{F#妳}{M#你}需要，我可以借{F#妳}{M#你}一個。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#抱歉，現在還是我的工作時間。這份三明治給{F#妳}{M#你}，先吃點墊墊胃吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#很抱歉不能和{F#妳}{M#你}分享品酒心得，但我可以向{F#妳}{M#你}推薦幾家頗具特色的冷門餐館。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安，我維護好武器後也會休息。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於克洛琳德自己·新聞報導",
      "text": "#報紙上總是有一些談不上公正，也絕不算正義的報導，撰寫的人都被人情與摩拉帶偏了心。\\n如果{F#妳}{M#你}想知道某件事的真相，最好的方法是去找相關的人用{F#妳}{M#你}自己的嘴發問，用{F#妳}{M#你}自己的心去理解。\\n至少，別讓其他人的舌頭代替{F#妳}{M#你}的頭腦。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於克洛琳德自己·銃槍與長劍",
      "text": "我的武器裝備遵循逐影獵人的傳統制式。銃槍用來驅趕獵物，長劍則給予致命一擊。\\n當然，代理決鬥時我通常只用長劍，踏上決鬥場的人已經無路可逃，用不著再去驅趕。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·儀式",
      "text": "#在每次決鬥開始前，我會用浸了特製藥水的軟布擦拭武器，一方面是為了保養，另一方面是為了讓自己保持沉靜，排除雜念。\\n作為執劍者，{F#妳}{M#你}應該也有自己的儀式吧？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·人與魔影",
      "text": "#我的許多習慣都承襲自逐影獵人的傳統。他們對抗的是邪惡魔物，而我對抗的則是不法凶徒。但魔物本就生來邪毒，這是魔物的本能，那些墮落的人本來有行善的能力與機會，卻自尋惡孽。\\n{F#妳}{M#你}呢？{F#妳}{M#你}持劍的理由是什麼？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "在我獲得「神之眼」後，決鬥中向我投降的人數明顯增加了不少，有的代理人說這枚「神之眼」是我決鬥時的「震懾手段」。\\n我還以為我從未敗北的決鬥戰績才是「震懾手段」，或許我以後的決鬥應該贏得更有表現力一點。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "我曾多次見證某些矛盾瑣事，被當事人基於純粹的感性反覆咀嚼，最終演變成一樁事關人身尊嚴，不可退讓的驚天恥辱而鬧上審判庭，甚至引發一場荒誕的決鬥。\\n作為決鬥代理人，我對於用決鬥來維護名譽這件事沒有意見，但是…怎麼說呢…從一個普通的楓丹市民角度來看，咖啡裡到底該不該加茉潔草，實在不見得是一件非要用劍來論證的事情…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "看過蓬蓬果吧？蓬蓬果飄飛的速度和位置不易捉摸，很適合作為槍靶練習射擊，但是去野外找蓬蓬果很不方便，要是有人願意人工培育蓬蓬果就好了…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "夏洛蒂小姐是一位識趣的記者，我對她沒什麼壞印象。\\n畢竟夏洛蒂小姐既不會在上班的路上堵我拍攝畫片，也不會跟蹤我去咖啡廳，記錄我今天喝了什麼咖啡。最值得稱讚的是她明確知道我不接受記者採訪，所以不會來自討沒趣。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "從前參加茶會的時候，我總是扶著劍站在她背後，現在我卻能在長桌對面就座與她分享茶點。\\n位置變化之後，我開始理解為什麼她會一天到晚唸著要「控制體態」了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "娜維婭最近心情很好，沒幾天就會拉我去「桌上劇團」玩新劇本。\\n選材五花八門，除了擔任了幾次劇本主持人，我也作為玩家和她共同參與了幾場冒險。但我會盡量避免扮演和審判庭有關的角色，防止氣氛變得太過嚴肅…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "最高審判官的權威無庸置疑，他總是能做出最公正的判決。必要的時候，我也會用劍再次強調判決的公正性。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於夏沃蕾…",
      "text": "夏沃蕾隊長，我聽說過她的大名。她曾經因為抓捕凶犯時的手段太過強硬，而遭起訴過幾次。她應訴時態度依然十分強硬，將對方駁得啞口無言，實在出色。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於林尼…",
      "text": "這位大魔術師的職業素養值得稱讚。如果有空的話，我會以觀眾的身分享受他的魔術表演。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於菲米尼…",
      "text": "#有天我收到了一個包裹，裡面裝著迷你機械玩具和表達謝意的卡片。玩具十分精緻，下次有機會我會當面對菲米尼先生表達一下感謝…最好不要當面？好吧，那我也寫份卡片，請{F#妳}{M#你}幫我帶給他。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於千織…",
      "text": "我買過她家的衣服，做得不錯。但我平常比較習慣穿現在這套工作制服，一方面是可以明確闡述我的身分，另一方面是因為我喜歡熟悉的事物。這套制服就像是我的劍，熟悉且適用，不必多做更換。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "梅洛彼得堡並不是一處好打理的地方。能夠讓那個地方保持一定程度的穩定，萊歐斯利的手腕無庸置疑。\\n其中應該不乏一些不能明說的手段，這就不是我們可以知道的了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於希格雯…",
      "text": "希格雯小姐是一位優秀的護士，既擅長治療身體的傷痛，又懂得如何療癒人的內心。即使是梅洛彼得堡裡那些心懷惡孽的凶徒，想必也會被她的美德和善心感動，內心湧起一絲善念。\\n這一絲善念，或許就能成為他們踏上改邪歸正之路的契機。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "我聽說過這名香水設計師小姐，對她真正的職業也有所耳聞。我偶然有次遇到她正在撫摸一隻路邊的小狗，臉上掛著溫和的笑意。我們互相點頭後就道別了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解克洛琳德·其一",
      "text": "決鬥代理人的工作並不繁雜，甚至可以說十分簡單。遵循審判庭的要求，擊敗對手就好。除此之外，無需多想。\\n…也許這就是外面有些人把我稱為「劊子手」的原因。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解克洛琳德·其二",
      "text": "代理決鬥時，我會盡可能確保與對手公平較量。如果對手有眼疾，我就會矇住眼睛，如果對手雙腿不便，我則會限定自己的移動範圍。無論如何，我所參與的必須是一場公平的決鬥。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解克洛琳德·其三",
      "text": "我見過太多人臨陣投降。連拔出武器的勇氣都沒有，所謂的冤屈和名譽受損，想必也只是自私的一家之言罷了。\\n他們早已被自己擊敗，無需我動手，就自願變成心靈的囚徒了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解克洛琳德·其四",
      "text": "#{F#妳}{M#你}有看過審判庭上的罪人嗎？在我所經歷過的審判裡，罪人總會強詞奪理，將自己偽裝成好人。在他們口中，暴行變成義舉，罪惡變為正義…但他們狡辯的終點卻總是一句話——自己雖然一時糊塗，但罪過人人都會犯，實在無可指責。\\n他們掩蓋自身汙穢的方法，就是汙染整片水源。\\n而擊碎這群罪人的謊言，為正義之廷激濁揚清，正是我成為決鬥代理人的理由。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解克洛琳德·其五",
      "text": "我見過許多想要在審判庭上尋求溫和人情的人。我並無不敬，但他們來錯地方了。\\n審判庭是昭示公理正義的場所，而正義總是…也必須冷漠，否則就無從延續。\\n如果正義摻雜了人情，那有時候就容易被誤導偏折，讓基於公理執行的「審判」變為由人情驅使的「私刑」。而審判庭中的「私刑」，與那些違律的凶惡暴行無異。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "克洛琳德的愛好…",
      "text": "#與代理決鬥不同，「桌上劇團」主持人的身分能夠讓我游離於故事之外，在不捲入人情冷暖的情況下觀察人們的種種反應，為他們建立起一個受我掌控的世界。嗯？{F#妳}{M#你}說聽起來像在看籠子裡的獵物？有道理…是我沒有思考過的角度，不過我從來不會為難玩家，盡量讓他們開心地體驗故事，這點和打獵還是很不一樣的。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "克洛琳德的煩惱…",
      "text": "希望那些記者不要再打擾我喝咖啡、買花和看書，否則我會考慮抓兩個典型向審判庭起訴。如果他們申請代理決鬥，我會讓他們帶著留影機上場的。公平起見，我也會只帶留影機。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#用肉類做的菜餚都不錯，但肉一定要新鮮。剛獵來的肉用鹽簡單調味後烤製，旁邊搭配微酸的水果，味道十分不錯。下次有機會的話，隨我去打獵，我做給{F#妳}{M#你}品嚐看看。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "魚類不合我的胃口，一方面是刺太多，另一方面則是有一股腥味…或許我在兒時已經吃夠了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "完美的味道，很合我味口。不要讓記者和美食家發現，他們只會用鏡頭和報紙享受美食。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "嗯，不錯的美食，很適合慢慢品嚐。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "…幸好這道菜並非出自餐館，避免了一些廚師和食客之間的矛盾。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。這把短劍樣式的項鍊由我親手打造，送給{F#妳}{M#你}作為禮物。\\n按照逐影獵人的傳統，在新成員作為逐影獵人度過第一次生日時，教導這位獵人的導師會為{M#他}{F#她}親手打造一把刻有姓名的短劍項鍊，並讓{M#他}{F#她}把項鍊時刻掛在胸口。這象徵著用劍鋒指問自己的內心是否涉足惡孽，是否心無旁騖，是否有決心逐滅邪魔。\\n雖然{F#妳}{M#你}不是逐影獵人，但我相信{F#妳}{M#你}和我們一樣有著懲惡揚善的決心。\\n為什麼樣式不是銃槍？因為銃槍會走火，指問內心的手段太直接了也不行。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "原來如此，的確有所長進。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "劍揮舞時的手感更好了，完全能適應。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "眼力有所提升？讓我朝那片落葉試射一下。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#在武力方面，我並不認為{F#妳}{M#你}會需要我的幫助。但倘若{F#妳}{M#你}希望藉助我的力量，我會盡我所能，一如既往。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "預備。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "上膛。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "獵影！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "射獵邪魔！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "你的自證時刻。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "洞見惡孽，逐滅鬼影！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "路遇好運，不錯。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "沒有歸屬的物品，不會引發糾紛。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "先到者得，合理。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "…速決勝負。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "驕縱輕狂。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "…可笑。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "退場！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "由我接手，後退。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "勝負…已分…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "敗者…當如此…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "你已證明了名譽…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "還算精準。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "夠了！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "#如{F#妳}{M#你}所邀。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#需要我為{F#妳}{M#你}代理決鬥嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "劍鋒，直指暗影。"
    }
  ]
}