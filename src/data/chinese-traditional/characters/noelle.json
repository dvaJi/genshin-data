  "outfits": [
    {
      "id": 203400,
      "name": "甲鐵玫瑰",
      "description": "諾艾爾的裝扮款式。甲冑與厚實絲絨連綴成的沉重裙裝。",
      "isDefault": true,
      "characterName": "諾艾爾",
      "characterId": 10000034,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Noel_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是諾艾爾，西風騎士團的女僕，從今天起會陪{F#妳}{M#你}一起去冒險。如果遇到任何困擾或者麻煩，不用擔心，我都會盡全力幫{F#妳}{M#你}解決的。嗯，現在就可以哦。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·幫忙",
      "text": "#交給我吧！什麼都可以交給我！——對了，{F#妳}{M#你}要拜託我做什麼來著？我還沒來得及聽…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·休息",
      "text": "#有點累了嗎？那就在這裡休息吧，我去為{F#妳}{M#你}沏茶，要全糖、半糖，還是無糖？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·可靠",
      "text": "#只要{F#妳}{M#你}需要我，我隨時都會出現在{F#妳}{M#你}的身邊。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "糟了，大家的衣服還晾在外面！我能不能現在回去收拾一下？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "遇到打雷還是待在屋子裡比較好哦，如果有非出門不可的事，就交給我吧。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "#天氣晴朗，不如做一些和「陽光」有關的事吧。欸？具體一點…只要能讓{F#妳}{M#你}的心情也變得晴朗的事，都可以。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "聽見了嗎？是風神的聲音。每到我心煩意亂的時候，聽見風聲就能平靜下來。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安，早餐已經做好了哦。我就待在{F#妳}{M#你}身邊，如果哪裡不合口味，請隨時告訴我。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#想要坐下來喝杯茶嗎？我去為{F#妳}{M#你}準備。對了，我還順手準備了厚雲朵鬆餅，是我的拿手菜哦，請一定要嘗一嘗。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上是大家的休息時間，也是我最忙的時候…安柏洗好的髮帶放在哪了？凱亞新買的眼罩有幾套？我會全部記住的，這是女僕的責任。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#今天的冒險辛苦{F#妳}{M#你}了，請去休息吧。我還要回騎士團一趟…欸？要我守候{F#妳}{M#你}入睡嗎？…唔…倒是沒什麼問題，不過…不是在捉弄我吧？"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於諾艾爾自己·自律",
      "text": "我只是每天都做同樣的事，和真正的騎士比起來還差遠了…但這是通往騎士之路的修行，修行可不能只是嘴上說說而已啊。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於諾艾爾自己·分歧",
      "text": "我有點不太擅長和別人爭辯，很多時候說不清道理，還會惹別人生氣，所以我就會先按我的想法去做，結果又被人說是「固執」了…我只是想用結果說服他而已，這也是「固執」嗎？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·身分",
      "text": "#我的奉獻是出於自由的奉獻，「女僕」在我看來就是最自由的身分。廚師、園丁、戰士、嚮導…{F#妳}{M#你}需要我是什麼，我就是什麼！"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·叮囑",
      "text": "#就算再怎麼倉促，一日三餐也不能應付，不可以吃來歷不明的東西，也不能光吃肉不吃蔬菜。對了，盡量不要喝冷水，對胃不好…唔，{F#妳}{M#你}不會在想「因為太麻煩所以還是交給諾艾爾」吧？唔唔…如果{F#妳}{M#你}真的這麼想…好吧，還是交給我來吧！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·歡迎會",
      "text": "#我聽說了，{F#妳}{M#你}成為了西風騎士團的榮譽騎士，真是羡慕啊…那今後{F#妳}{M#你}就是我的前輩了。對了，應該為{F#妳}{M#你}舉辦一場熱鬧的歡迎會！我現在就去準備！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "說實話，有點失望…雖然這「神之眼」象徵神明對我的肯定，但為什麼不是「風」，而是與風的性質相差最遠的「岩」呢？我覺得最適合西風騎士團的元素，畢竟還是…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "其實我很喜歡聞酒的味道，可是現在的我還沒到喝酒的年紀…雖然不止一次有偷偷嘗的機會，但我都忍住了，還是把這份神秘感保留到我成年的那一天吧。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#女僕要嚴守秘密，所以我很喜歡玫瑰，玫瑰在蒙德就代表「守口如瓶」，它總是能提醒我…欸？在{F#妳}{M#你}的家鄉，玫瑰代表「愛情」嗎？…居、居然還有這麼火熱的含義啊…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於安柏…",
      "text": "#她是我非常尊敬的前輩，實力很強不說，對人也很親切。她還教我怎麼做「兔兔伯爵」，{F#妳}{M#你}看，我會把它當成護身符帶在身邊，做得不錯吧？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於可莉…",
      "text": "我一直很想知道，她還這麼小，是怎麼正式成為騎士的。有一次向她請教經驗，她還沒聽完我的話，就拉著我去騎士團外面玩炸彈…我以為這是什麼修行，結果最後我和她都被琴團長關了禁閉…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於琴…",
      "text": "琴團長一直都是我的榜樣，我的實力和認真程度完全比不上她。她對別人就像對自己一樣嚴格，所以如果有一天我能得到她的認可，那也是對我一直以來努力的最大肯定了。在那之前，我都是不會鬆懈的！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "本來我想跟著他的隊伍一起去冒險，履行女僕的責任，但大團長說我留在蒙德他才不會有後顧之憂…大團長這麼器重我，我很開心！雖然後來我知道大團長不只對我一個人說了這句話，不過…器重就是器重嘛。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於凱亞…",
      "text": "他很神秘，來如影，去如風，每天都有很重要的任務要去處理。他還經常會給我安排一些小任務，就好像我已經是他的小隊成員了一樣…嗯？只是跑腿？不不不，雖然確實是跑腿，可是我很珍惜的！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於班尼特…",
      "text": "他不止一次來邀請我，說什麼比起騎士團，還是冒險家協會更適合我…雖然我是會像一個普通的冒險家一樣，幫他照顧他的老爹們，但…騎士團對我來說有特別的意義，而且我也不想認輸…嗯，果然還是沒法答應。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於菲謝爾·茶點",
      "text": "她好像是從別的世界來的，其他的我也不清楚…不過她好像很喜歡騎士團的圖書館，總是在那裡看書。我打掃的時候會送去一些熱呼呼的茶點，她每次都會感謝我，還會說很多聽不明白，但都很誇張的話…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於菲謝爾·身世",
      "text": "以前我打掃圖書館的時候，記得有本書叫《菲謝爾皇女夜譚》，我還以為只是幻想小說…但沒想到，裡面的主人公居然真的存在！能有一本自己的傳記，她一定很厲害吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "我們經常在一起喝茶，有時候她會輕輕哼出很好聽的調子，告訴我靈感來了。雖然我對音樂給不出什麼實用的建議…但能跟芭芭拉享受這樣的時光，我真的非常高興！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解諾艾爾·其一",
      "text": "#是需要我幫忙嗎？哦…只是想和我聊聊天，好吧，如果這就算幫上了{F#妳}{M#你}的忙，那想聊多久都可以。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解諾艾爾·其二",
      "text": "#沒關係，什麼樣的事都可以交給我，不用照顧我的感受的…欸？那不是「女僕」而是「工具」？唔…工具做了很多事也不一定會開心吧，但我為{F#妳}{M#你}做的每件事，我都很有成就感哦。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解諾艾爾·其三",
      "text": "#這、這些點心是送給我的嗎？不不不，這怎麼好意思呢？那…那我也要做很多點心作為回報！我現在就去，馬上就去！半個小時…嗚，最多一個小時就做好了。{F#妳}{M#你}可以先去做別的事，茶點很快就會熱呼呼地端到{F#妳}{M#你}的面前！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解諾艾爾·其四",
      "text": "#我每天做的都是一些瑣碎的小事，但只要這些小事能幫到{F#妳}{M#你}的冒險、{F#妳}{M#你}的生活，我就會很開心…因為{F#妳}{M#你}的道謝，會讓我覺得這些小事，也都有小小的意義。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解諾艾爾·其五",
      "text": "#我是為騎士團服務的女僕，也一直想要幫到更多人的忙。但不知不覺，用在{F#妳}{M#你}身上的時間已經變得越來越多了…唉，像我這樣自私的做法，是不是…不太好？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "諾艾爾的愛好…",
      "text": "愛好嗎？我最喜歡洗各種各樣的東西，洗衣服，洗地板，洗窗戶，看到髒東西變乾淨我就會特別有成就感…欸？是指「休息時的愛好」？我想想…嗯，果然還是洗東西！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "諾艾爾的煩惱…",
      "text": "該怎麼用最少的預算、採購到最多最好的物資呢…我試過一個人跑去璃月比對所有商鋪的價格、再一個人把東西全都搬回來…但那次花的時間太長，琴團長差點以為我在路上被風魔龍吃掉了…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#當然是「滿足沙拉」，蒙德的自然水土匯於一盤，營養均衡，熱量也不會超標…{F#妳}{M#你}問吃不膩嗎？當然不會，很好吃的！我已經吃了十年了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不挑食！但有一種情況會讓我比較頭痛…宴會上的一大桌菜，作為女僕，每一道菜都必須自己先嘗一嘗。但這樣一口接一口…唉，太罪惡了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#能把普通的菜餚做得那麼好吃…我對{F#妳}{M#你}的欽佩，又多了一些！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#味道真好。我也要向{F#妳}{M#你}學習！再怎麼說，這也是女僕的職責…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "熱量…會不會已經超過一整天的份額了…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#每天都忙於冒險，是不是積壓了很多瑣事來不及處理？今天我就是{F#妳}{M#你}的專屬女僕，全都交給我吧！還有…在這最棒的一天，祝{F#妳}{M#你}生日快樂！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#這就是…新的力量？謝謝{F#妳}{M#你}，這樣我就能幫到更多人了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "還不能滿足，在成為正式的西風騎士之前，我都要加倍努力。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#多虧了能和{F#妳}{M#你}一起冒險，我才獲得了這麼多的成長。明明女僕的職責是為你排憂解難，結果反倒是讓{F#妳}{M#你}為我花了這麼多心思…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#蒙德城的大家都說我變得比以前更可靠了，還說我馬上就能成為真正的西風騎士了，但其實我…什麼？{F#妳}{M#你}也這麼覺得？呃…謝謝{F#妳}{M#你}能這麼說，這是對我最好的誇獎！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "岩石的重量，令人安心。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "一定要乾淨俐落。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "交給我吧。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "該打掃戰場了。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "我會注意騎士的風度。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "我會注意女僕的禮儀。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "應該趕得上。"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "還有人需要幫忙。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "心滿意足。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "真高興…"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這些寶藏蒙灰了，先清洗一下！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "沒關係，輕傷而已。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "唔，衣服都弄髒了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我不會退縮的。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "別動，小心傷口，我來治療！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "交給我吧！換我來！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "讓騎士團…蒙羞了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我還想…保護大家…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "再見了…主人…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "唔…失態了。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "真高興…啊、嗯。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#一定會保護{F#妳}{M#你}。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#嗯，如{F#妳}{M#你}所願。"
    }
  ]
}