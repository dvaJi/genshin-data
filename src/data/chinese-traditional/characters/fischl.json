  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#<color=#37FFFF>菲謝爾：</color>我即斷罪之皇女，真名為菲謝爾。應命運的召喚降臨在此間——哎？{F#妳}{M#你}也是，異世界的旅人嗎…？那好吧，本皇女恩許{F#妳}{M#你}同行。\\n<color=#37FFFF>奧茲：</color>她的意思是「{F#妳}{M#你}好，很高興認識{F#妳}{M#你}」。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·真命低語",
      "text": "我聽見命運的嚅囁，低聲呼喚我之尊名…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·天地創造",
      "text": "哼哼，就讓皇女的光彩榮耀此間天地吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·彼方之人",
      "text": "<color=#37FFFF>菲謝爾：</color>不知在遙遠彼方的扈從…\\n<color=#37FFFF>奧茲：</color>毋須擔心冒險家協會的大家。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨過天晴…",
      "text": "天晴了嗎，真舒…咳，此間須臾的霽月光風，就如命運的轉捩點一般呢！愉快！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "<color=#37FFFF>菲謝爾：</color>啊啊，看那昭告命運的聖裁之雷…\\n<color=#37FFFF>奧茲：</color>這麼說來，是不是還有衣服沒收？\\n<color=#37FFFF>菲謝爾：</color>欸？！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "<color=#37FFFF>菲謝爾：</color>哼哼，這可是好光景。就像在「那個世界」，罪人的血與淚在斷罪的皇女面前凝結的模樣呢——啊、啊——阿嚏！阿嚏！\\n<color=#37FFFF>奧茲：</color>面對小姐，罪人的鼻涕恐怕都要凝結了。\\n<color=#37FFFF>菲謝爾：</color>奧茲——啊、阿嚏！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "<color=#37FFFF>菲謝爾：</color>奧茲，我之眷屬啊…\\n<color=#37FFFF>奧茲：</color>喔？怎麼突然——\\n<color=#37FFFF>菲謝爾：</color>以皇女之名，以你的祝聖之翼，遮蔽日月星空，帶來永恆的幽夜吧。\\n<color=#37FFFF>奧茲：</color>不要強人所難！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安·問候菲謝爾",
      "text": "#晝夜時空皆為虛像，命運的紐帶卻再次將{F#妳}{M#你}帶到了我的永恆長夜中。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "早安·問候奧茲",
      "text": "#<color=#37FFFF>奧茲：</color>早安！聽說{F#妳}{M#你}要來，小姐在準備早點…\\n<color=#37FFFF>菲謝爾：</color>奧茲！…咳，有何貴幹？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "午安…",
      "text": "哈…即使貴為皇女，在這樣的時辰也不免睏乏…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚上好…",
      "text": "<color=#37FFFF>菲謝爾：</color>天穹上的星光，都是奧茲在無盡的夜幕上啄出來的洞。\\n<color=#37FFFF>奧茲：</color>是才怪啦！"
    },
    {
      "id": "1005",
      "type": 1,
      "title": "晚安…",
      "text": "#<color=#37FFFF>菲謝爾：</color>{F#妳}{M#你}的深眠將平安無夢。畢竟，豈有夢魘，敢染指幽夜淨土所祝聖之人…\\n<color=#37FFFF>奧茲：</color>她說「晚安」。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於菲謝爾自己·斷罪之皇女",
      "text": "<color=#37FFFF>菲謝爾：</color>我嗎？哼哼。記好了，我乃幽夜淨土的主人，斷罪之皇女菲謝爾，裁斷此世一切罪責，透徹此間一切真知。\\n<color=#37FFFF>奧茲：</color>就是冒險家協會的調查員。\\n<color=#37FFFF>菲謝爾：</color>…那只是膚淺的表象！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·降臨此間之人",
      "text": "#我與{F#妳}{M#你}同為異世界的旅人，在此相遇。錯不了，想必是命運的意志吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·射落世界之獸",
      "text": "#看{F#妳}{M#你}有什麼煩惱的樣子…？旅人啊，不必困惑。因為，我以我的左眼，這隻透徹因果之絲的「斷罪之眼」，守望著{F#妳}{M#你}的命運；以奧茲那見證過一千世界寂滅的鴉眼，觀察著{F#妳}{M#你}的進路。假若名為「世界」的夜巡凶獸覬覦你的夢想，那我便以斷罪的聖裁魔矢將其射落！"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·重要之人",
      "text": "<color=#37FFFF>菲謝爾：</color>奧茲，我之忠友啊…能遇到「那個人」，與本皇女同樣不屬於這個世界的旅人…連殘酷的命運，也會對我罪孽深重的血脈，展露微笑呢。就算是我的命運，我無法逃離的「現實」…\\n<color=#37FFFF>奧茲：</color>啊啊，我明白。那個旅行者的話，不管發生了什麼，都不會拋棄小姐的吧。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·守望",
      "text": "#<color=#37FFFF>菲謝爾：</color>奧茲華爾多·赫芙那梵茵斯。為我，為幽夜淨土的主宰，斷罪的皇女，做好獻出生命的覺悟，守望{F#她}{M#他}註定多舛的命運吧。\\n<color=#37FFFF>奧茲：</color>不要隨便讓我送命啊！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "嗯？這個「淵色的幽邃秘珠」嗎。那是我族的王器，向一切無禮者昭告斷罪皇女之儀。即使流落到了這個荒蕪的世界，王器仍然追隨著皇族之血與崇高之魂，找到了我，這就是無法斬斷的因果吧…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "<color=#37FFFF>菲謝爾：</color>這麼說來，按照這個世界的曆法，我有三千多歲了。當然，日月流轉的虛像對看破三千宇宙因果的我而言沒有意義。\\n<color=#37FFFF>奧茲：</color>小姐，這招是騙不過酒保的，沒到喝酒的年紀就是沒到喝酒的年紀。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#奧茲的全名，是奧茲華爾多·赫芙那梵茵斯，在「那個世界」主宰著三個宇宙的星海與夜空，以影之翼蔭蔽所有戰死的勇者之魂。順帶一提，叫錯他的名字會被處以拔舌之刑。但我是皇女，而{F#妳}{M#你}是我認可的人，所以我們可以隨意叫他奧茲。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於班尼特…",
      "text": "<color=#37FFFF>菲謝爾：</color>那位厄運的少年嗎…錯不了的，我這隻「斷罪之眼」見證過，他那被世界唾棄的悲哀——\\n<color=#37FFFF>奧茲：</color>那個倒楣蛋，置之不理可不行。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於麗莎…",
      "text": "<color=#37FFFF>菲謝爾：</color>那司書的魔女，坐擁著宇宙知識的寶庫…如果能贏取她的信任，或許就能獲得偉大智慧…\\n<color=#37FFFF>奧茲：</color>她說「圖書館的規矩就是有借有還，再借不難」。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於凱亞…",
      "text": "<color=#37FFFF>菲謝爾：</color>無法看透的真實，無法斷明的因果，虛實交織的狂言…那個人，或許也與我一樣，背負了「魔眼」的命運…\\n<color=#37FFFF>奧茲：</color>也可能暗地裡是個海盜…？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於莫娜…",
      "text": "<color=#37FFFF>菲謝爾：</color>啊啊，那位「偉大的占星術士莫娜」…哼，此人曾經妄圖窺探本皇女的命運，結果卻渾身顫抖呢。\\n<color=#37FFFF>奧茲：</color>當時占星術士似乎在努力憋笑，非常不容易。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於蘿莎莉亞…",
      "text": "<color=#37FFFF>菲謝爾：</color>她嗎？似乎是虔信風神的忠實修女呢。\\n<color=#37FFFF>奧茲：</color>「虔信」？「忠實」？\\n<color=#37FFFF>菲謝爾：</color>沒錯。有天晚上看到過，她對什麼人說「以風神巴托巴斯的名義，去死吧」這樣的話，想必是在領禱吧。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解菲謝爾·其一",
      "text": "哼哼，為應受罪罰之徒斷罪，為命運青睞之人祝聖，以無盡的幽夜淨土收容世間一切不被容赦的夢想，這就是斷罪皇女血脈背負的沉重使命，誰人也不許質疑。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解菲謝爾·其二",
      "text": "#我的左眼？我的左眼是透徹世間一切真相的「斷罪之眼」。至於為何要遮起來…那麼，窺見此間與彼方一切真實的負擔與痛，{F#妳}{M#你}願意承受嗎？再說了，通曉此世與常世一切妄念與謊言，又是何等無趣的事，哼哼。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解菲謝爾·其三",
      "text": "<color=#37FFFF>菲謝爾：</color>風魔龍？那種本皇女寢宮花園裡拴著的寵物級別的東西，沒想到在這個世界也能形成災禍呢。哼，一群沒用的傢伙…\\n<color=#37FFFF>奧茲：</color>雖然小姐這麼說，當時不也為大家擔心得不得了嗎。\\n<color=#37FFFF>菲謝爾：</color>那、那還不是因為身為皇女，有守護塵世眾生一切靈魂的崇高職責…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解菲謝爾·其四",
      "text": "<color=#37FFFF>奧茲：</color>有的人會用其他的名字呼喚小姐。但對我來說，將生命與力量分給我的人，只有「菲謝爾」這個名字。這才是符合她命運的名字，千萬不要弄錯…\\n<color=#37FFFF>菲謝爾：</color>你們，商談之事為何？\\n<color=#37FFFF>奧茲：</color>關、關於至夜幻現！還有斷罪之名！"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解菲謝爾·其五",
      "text": "#皇女應斷之罪為何，那當然是「違逆命運」了…畢竟，正是命運，讓你…是命運，令{F#妳}{M#你}我降臨此世，將因果交織相連。我、我會守護{F#妳}{M#你}，只、只因這是命運的默示錄中昭告之事！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "菲謝爾的愛好·詢問菲謝爾",
      "text": "本皇女馳騁星間，行遍諸多世界，領略過一萬種宇宙的命運，通讀一切靈魂的默示錄。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "菲謝爾的愛好·詢問奧茲",
      "text": "<color=#37FFFF>奧茲：</color>小姐喜歡看小說。唉…「奧茲」這個名字，也是她從喜歡的小說裡挑的。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "菲謝爾的煩惱…",
      "text": "嗯？這世間能困擾皇女的事情…硬要說的話，那就是，總有人無法接受我的真實身分。但無妨，畢竟高貴者註定孤獨嘛。只要我不失卻這顆崇高之心…"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "<color=#37FFFF>菲謝爾：</color>哼，食物只是凡骨肉胎所受的桎梏。但硬要說的話，能配得上斷罪皇女的，那莫過於罪人之淚與謊言之舌…\\n<color=#37FFFF>奧茲：</color>並不是小姐常做的「常夜夏宮蜜吐司」嗎？\\n<color=#37FFFF>菲謝爾：</color>——只，只是為了補充這具軀殼所需的能量！"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "討厭的食物…",
      "text": "<color=#37FFFF>奧茲：</color>小姐討厭的，應該是那個吧…\\n<color=#37FFFF>菲謝爾：</color>那個嗎。被違抗自然的鎖鏈束縛的肢體…\\n<color=#37FFFF>奧茲：</color>再也不能如我這般飛翔…\\n<color=#37FFFF>菲謝爾：</color>失去了那生來便仰慕皇族王者的卑下頭顱，簡直是「那個世界」的地獄略影。其名為…\\n<color=#37FFFF>奧茲：</color>好像是叫什麼釀雞來著？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "<color=#37FFFF>菲謝爾：</color>此等珍饈，可納於忘憂之御膳園中。\\n<color=#37FFFF>奧茲：</color>小姐說，這就是她理想的美味。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "<color=#37FFFF>菲謝爾：</color>為射落世界之獸，必須突破塵俗欲望，編織通向命運之間的道路。\\n<color=#37FFFF>奧茲：</color>但剛才，小姐不是吃得很香嗎？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#<color=#37FFFF>菲謝爾：</color>為何要將殘破與毀滅，呈於本皇女面前？\\n<color=#37FFFF>奧茲：</color>小姐不太喜歡這道菜餚，請{F#妳}{M#你}見諒。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#<color=#37FFFF>菲謝爾：</color>哼哼，既然今日是{F#妳}{M#你}的命定之日，那我不可能坐視不管。來，說吧！在這腐朽而幽邃的世界裡，在{F#妳}{M#你}渺小而短暫的人生中，有什麼想要實現的願望，儘管說來，讓本皇女聽聽！嗯…即使是…\\n<color=#37FFFF>奧茲：</color>她說「生日快樂，如果{F#妳}{M#你}想要，她」…\\n<color=#37FFFF>菲謝爾：</color>奧茲！多嘴！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "<color=#37FFFF>菲謝爾：</color>至夜的魔箭…它在高聲呼喚著我的祝聖之名，祈求著罪罰的蒼紫雷光，射落命運之敵！\\n<color=#37FFFF>奧茲：</color>偉哉！考慮到晚飯，如果能射落鴿子就更好了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "<color=#37FFFF>菲謝爾：</color>有了這個，就能更好地行使斷罪皇女的威儀，擊敗名為「現實」的命運之敵了。\\n<color=#37FFFF>奧茲：</color>嗯，就能更好地完成協會的工作了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "狂喜吧！戰慄吧！要問為何的話，須知幽夜淨土的斷罪皇女，已經用這隻左眼，看清了編織宇宙的命運之絲！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#來到這個世界而失去的力量，似乎已經恢復了大半。哼哼哼，定罪之時即將…啊啊，不必擔心。即使到了終末之刻，我在此世降下罪罰之雷時，也不會傷及{F#妳}{M#你}。因為，{F#妳}{M#你}可是我的祝聖之人啊。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "以斷罪之名！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "現身吧，奧茲！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "回應我吧！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "奧茲：又來了…"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "黑之翼，屏斷晝夜——"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "至夜幻現！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "影之鴉，渴求幽夜——"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆發·其四",
      "text": "奧茲：一如小姐所願！"
    },
    {
      "id": "200005",
      "type": 2,
      "title": "元素爆發·其五",
      "text": "奧茲：至夜幻現！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "命運，指引我來此！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "荒蕪的世界，竟藏有這等瑰寶！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "哈哈哈，高呼我的祝聖之名吧！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "只好稍微認真一點了，哼。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "奧茲：小姐，如果妳倒下了，我——！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "皇女的命運，不應在此完結…！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "哼，就讓我來吧！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "奧茲：小姐，那邊有些不妙…"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "這個世界，也容不得本皇女嗎…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我將再度降臨…嗚…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "奧茲：小姐！…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不敬之徒。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "以皇女之名！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "菲謝爾：讚頌我的降臨吧。奧茲：偉哉！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#{F#妳}{M#你}的命運，已成為我掌間之絲！"
    }
  ]
}