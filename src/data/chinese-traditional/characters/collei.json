  "outfits": [
    {
      "id": 206700,
      "name": "一葉新生",
      "description": "柯萊的裝扮款式。再也不必蜷縮在厚重的斗篷下，像新葉一樣舒展身體，迎接每個美好的清晨吧。",
      "isDefault": true,
      "characterName": "柯萊",
      "characterId": 10000067,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Collei_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#見習巡林員柯萊，前來報到！我會保障{F#妳}{M#你}在林間出行時的安全——呼，總算能說出這句出場詞了，我沒唸錯字吧…"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·巡林路線圖",
      "text": "今天的巡林路線圖…先往這裡再拐到那裡…嗯，字好多…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·狀態",
      "text": "呼，今天的狀態不錯，趁著這個機會，多做一點事吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·回憶",
      "text": "手邊沒有事情，心裡就容易東想西想——唔，一說就想起了不好的事…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨過天晴…",
      "text": "雨雖然停了，還是要小心水窪。就像一些事，明明過去了還是會留下回憶…咳咳！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "打雷的時候，最好避開大樹。對巡林員來說，還要格外注意檢查，謹防森林火災。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "天氣不錯，多曬曬太陽，對身體也好。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "嗯，風力正好。安柏應該會很喜歡趁這樣的天氣挑戰自己吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安！哈…抱歉，昨晚又在補習…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "巡林路線一長，中午回不來也很正常。我多準備了一些「口袋餅」，要來一份嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "天快黑了，走在林子裡一定要加倍小心。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#準備休息了嗎？篝火已經生好了，我會為{F#妳}{M#你}守夜的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於柯萊自己·巡林",
      "text": "來須彌之前，我在野外流浪過一段日子，能吃不能吃的東西都嚐過了好幾遍，對野外還算熟悉，所以來這裡之後就做起了巡林的工作。如果「野外生存」也算一門科目的話，我還是有自信考到及格的…嗯，不考筆試的話。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於柯萊自己·補習",
      "text": "#欸？{F#妳}{M#你}問我每天都在補習什麼？跟著這麼厲害的師父，是不是什麼很高深的知識…呃…這個嘛…《提瓦特識字大全》…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·舊識",
      "text": "#我聽安柏在信裡提起過{F#妳}{M#你}，沒想到在蒙德又發生了這麼多事。可惜跳著字讀，好多細節都沒弄懂…欸，{F#妳}{M#你}願意再跟我講一遍嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·新交",
      "text": "#我曾經以為「朋友」什麼的，這輩子都不會和我扯上關係，直到去了蒙德…後來在須彌遇見了師父，現在又遇到了{F#妳}{M#你}。果然，我還是很幸運的啊。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "哈…真沒想到，我也會有拿到神之眼的一天。以前總覺得神明會看的，都是那些天生就被大家喜歡的人…唔，我…我承認我有很多不好的偏見。是我不對。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·技能名",
      "text": "#師父常說最有效的學習就是實踐，所以我偶爾也會找些輕小說來看，想多認些字…起碼比師父的論文好讀。不過，我最近讀到的一本書裡，主角有好多能力，取的名字全是我看不懂的詞…嗯？書的名字？應該是叫…《鬼武道》？{F#妳}{M#你}也讀過嗎？"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·封印之力",
      "text": "唔哇…又是「被封印的力量在躁動」…還有什麼「離我遠點才是上策」…為什麼稻妻人都能這麼自然地說出這些話，他們以後不會覺得尷尬嗎？啊…不行，不能再讀下去了！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "花草動物嗎…除了能不能吃，好像也沒有太大差別。噓，這話不能被師父聽見。如果問我的話，我比較喜歡有樹洞的樹吧？尤其是在想要「找個地方鑽進去」的時候…每個人都會有的吧？不是嗎？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於提納里…",
      "text": "師父雖然平時說話有些嚴厲，還經常批評那些亂吃毒蘑菇的冒險家，但他其實是個很溫柔的人。不僅會耐心地幫我補習，還會為我讀蒙德寄來的信。我一直很感激他！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於多莉…",
      "text": "有次我在巡林路上遇見了她，像是知道我口渴一樣，她從袋子裡掏出了一瓶看起來特別好喝的果汁…還好當時師父在場，制止了她。不然，我差點就一個衝動，把好不容易存起來的摩拉都花出去了…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "草神啊…小時候我很多次想大聲問問神明，為什麼要讓我經歷這麼多苦難。唉，說不定就連神明自己，也經歷著各種無奈的事吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於賽諾…",
      "text": "欸…我們能不提他嗎？不，大風紀官不是什麼壞人，當初就是他帶著我從蒙德回到了須彌，才讓我有了安身的地方。只是一想起回須彌前那個「封印」的過程…唔…脖子後面又開始覺得痛了…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於卡維…",
      "text": "大風紀官曾帶著他來我們這裡吃過一頓飯。在餐前水果剛端上桌的時候，他就開始大談他那個又不講情理又固執的室友，我們連插話的時機都找不到。只能點點頭，憋著笑，吃完了整頓飯。唉，真是不容易。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於妮露…",
      "text": "感覺她有點迷迷糊糊的樣子，如果來化城郭附近表演的話，不會走著走著就迷路在深林裡吧…那我一定要好好看著她，盡我見習巡林員的職責。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於安柏…",
      "text": "安柏她真的很厲害，又熱情又活潑，又勇敢又正義…是我最欽佩、最崇拜的人了！她總能像一團火一樣照亮別人，要不是她，我一定沒辦法走到今天這一步…過了這麼久，她現在一定變得更加沉穩、更加帥氣了吧！真不知道什麼時候才能趕上她。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於凱亞…",
      "text": "蒙德的大家都還好嗎？那陣子我可是惹了不少麻煩啊，要不要找個時間回去道歉呢…唔，但感覺一露面就會被那位騎兵隊長捉弄…還是再等等吧，再等等…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於麗莎…",
      "text": "#明明已經過去了那麼久，麗莎寫信給我的時候，還是在叫我「小柯萊」，總感覺…嗯？{F#妳}{M#你}說她也叫{F#妳}{M#你}小可愛？噗…對不起，我不是有意要笑出來的…一下子就開心了好多啊。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於菲謝爾…",
      "text": "…「斷罪之皇女」？抱歉，我在蒙德待的時間不長，沒有聽過這樣的人物。不過這個名字…嘶…咳，沒什麼。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於琺露珊…",
      "text": "呃…老實說，我不太擅長應付這位前輩…雖然她經常誇我勤奮好學，但我真的是因為學得太慢，沒辦法了，才總是在補習啊！還有一回，我不小心看到了她的研究筆記，雖然只瞄了一眼，但那絕對是全須彌最可怕的書！——上面全是古文，我連半個字都看不懂。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解柯萊·其一",
      "text": "#我的事情嗎？如果{F#妳}{M#你}問的是來須彌之前的…唔，要不然…{F#妳}{M#你}寫信問一下安柏？啊，不行，要是讓凱亞發現了就全完了…不對，他肯定會發現的吧！還、還是我自己來說吧，呼——對不起！請先讓我再做幾天心理準備…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解柯萊·其二",
      "text": "流浪到蒙德的時候，我對安柏他們說了很多不該說的話，現在回想起來還是會很羞愧…我這人真是的，怎麼能對想幫我的人說那些話呢！他們那時候究竟是怎麼看我的？想想就又…嗚，抱歉，今天先到這裡可以嗎？不然等到明天…我又要為剛剛說過的話後悔了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解柯萊·其三",
      "text": "因為「魔鱗病」的關係，我曾經被送到「博士」手下治療…不，那不是治療，而是「實驗」。在那種環境裡待久了，我也忍不住開始想，自己到底做錯了什麼？為什麼沒有人來救我…漸漸地，就連「愚人眾」以外的人也一起懷恨了。現在想想…實在是，太幼稚了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解柯萊·其四",
      "text": "#多虧有{F#妳}{M#你}們在，「魔鱗病」消失了，是我從前想都不敢想的奇蹟。嗯…我一直對完全治癒不抱希望，只想在身體不能活動前，多做一些事情。起初是復仇，後來是巡林…現在，我終於可以自由地活下去了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解柯萊·其五",
      "text": "#{F#妳}{M#你}接下來還會繼續旅行嗎？請讓我多盡一份力吧。我會努力學習…不管是認字還是學醫術，還有戰鬥、偵察…甚至是檢查路燈這種小事！希望這一路上，能有更多和我一樣的人得到幫助——就像{F#妳}{M#你}拯救了我一樣。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "柯萊的愛好…",
      "text": "#愛好嘛…縫紉、練習飛行，還有幫助他人！嗯？{F#妳}{M#你}說聽起來有點耳熟？因為…我也想成為「能照亮別人的人」。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "柯萊的煩惱…",
      "text": "「針對目前…農作物品種…單一化…避兔長期食用菌類…採取的進口錯施…」——這都是什麼和什麼啊？為什麼教令院的論文連「不想吃蘑菇」都能寫得這麼複雜啊！"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "「口袋餅」方便攜帶，又容易吃飽，應該是我最常吃的東西了？如果不考慮肚子的需要，我最喜歡的食物…嗯，應該是「炸蘿蔔丸子」吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "流浪的時候肚子餓了，連鉤鉤果都要掰碎了吃下去，所以我沒有什麼特別討厭的食物。一定要說的話，我不會碰的只有各種蘑菇吧？和口味無關，只是不希望被師父長篇大論批評的人是自己而已…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#嗯——真好吃！{F#妳}{M#你}能教教我嗎？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "有這樣的手藝，流浪在外也不會餓肚子了吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "抱歉，師父交代過我，不能吃奇怪的東西。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生、生日快樂！這個是我準備的蛋糕，這個是備用的蠟燭…安柏在信裡說這樣就行…啊，還有、還有這個是送給{F#妳}{M#你}的禮物！\\n…不好意思，我沒什麼辦生日會的經驗，也不知道合不合{F#妳}{M#你}的心意…弄得手忙腳亂的。有什麼不足一定要跟我說，明年，我一定會準備得更好！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我這是在進步嗎？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "我能感覺得到，我已經…不再是以前的我了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "就算到生死關頭，也不必再依靠「它們」的力量了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#現在的我，即使解開被封印的力量，也可以駕馭自如了吧？嘿！\\n說笑的，和{F#妳}{M#你}一起辛苦冒險的經歷，才是我現在擁有的力量啊。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "去。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "飛吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "嘿。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "拜託了，柯里安巴！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "試、試試這個！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "來跳舞吧！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "在野外要時刻注意補給。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "真幸運啊。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嗯…箱子裡沒長毒蘑菇吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我…還撐得住！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "這點小痛，不算什麼！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "需要…盡快治療…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "身體要緊！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "這樣下去不太妙啊。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "得做優秀的…巡林員。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "居然會…這麼倒下…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "還是…到這一天了…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "怎麼會…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "別碰我！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "就由我來保護。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "準備齊全，出發吧！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "見習巡林員報到！"
    }
  ]
}