  "passives": [
    {
      "id": "floral_sidewinder",
      "name": "飛葉迴斜",
      "description": "在<span style=\"color:#FFD780FF\">飛葉輪</span>返回前，如果隊伍中自己的角色觸發了燃燒、原激化、超激化、蔓激化、綻放、超綻放、烈綻放或月綻放反應，則會在返回時為角色賦予「新葉」狀態，持續對身邊的敵人造成相當於柯萊攻擊力40%的<span style=\"color:#99FF88FF\">草元素傷害</span>，持續3秒。<br/>新葉效果持續期間再次產生新葉效果時，將移除原有的效果。新葉效果造成的傷害視為元素戰技傷害。",
      "level": 1
    },
    {
      "id": "the_languid_wood",
      "name": "徐如曠林",
      "description": "<span style=\"color:#FFD780FF\">柯里安巴領域</span>中的角色觸發燃燒、原激化、超激化、蔓激化、綻放、超綻放、烈綻放或月綻放反應時，將使領域的持續時間延長1秒。<br/>一次<span style=\"color:#FFD780FF\">貓貓秘寶</span>中，至多依此方式延長3次持續時間。",
      "level": 4
    },
    {
      "id": "gliding_champion_of_sumeru",
      "name": "「須彌飛行冠軍」",
      "description": "隊伍中自己的角色滑翔消耗的體力降低20%。<br/>無法與效果完全相同的固有天賦疊加。",
      "level": 0
    }
  ],
