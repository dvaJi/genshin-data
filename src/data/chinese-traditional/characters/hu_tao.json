    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#喲，找本堂主有何貴幹呀？嗯？{F#妳}{M#你}不知道嗎，往生堂第七十七代堂主就是胡桃我啦！嘶，不過瞧{F#妳}{M#你}的模樣，容光煥發、身體健康，嗯…想必是為了工作以外的事來找我，對吧？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·往生堂",
      "text": "不如去我那喝杯茶？嘿~"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·客戶",
      "text": "一個客戶，兩個客戶，三個客戶…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·偷懶",
      "text": "咳咳…太陽出來我曬太陽，月亮出來我曬月亮囉~"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "哎呀…麻煩囉。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "打雷啦，起身啦。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "哇，是雪！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "嗯，真舒服。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "欸？…唉，帽子都要吹飛了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "嗯~早起身體好，晚睡人會飄。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "喲！中午好呀，吃了嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "嘻嘻，月亮出來囉~咱們也出門吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#哦，睏了嗎？那{F#妳}{M#你}好好休息，我一個人四處轉轉。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於胡桃自己·名字",
      "text": "胡桃的胡是胡吃海喝的胡，胡桃的桃卻不是淘氣的淘！嘿嘿…不、不好笑嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於胡桃自己·拿手好戲",
      "text": "#變個戲法給{F#妳}{M#你}看，瞧好了哦…火！然後…嘩！火蝴蝶！呼，飛啦——哈哈。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·好奇心",
      "text": "#{F#妳}{M#你}到處旅行，一定見多識廣。有空也給我講講{F#妳}{M#你}自己的故事吧。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·夜晚",
      "text": "#白天{F#妳}{M#你}儘管到處跑，晚上可得小心點。我不在的時候，務必謹慎行動。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·幫手",
      "text": "#需要幫手嗎？需要幫手嗎？我來啦！若{F#妳}{M#你}需要幫助，胡桃我定當全力以赴，絕不推辭。"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "關於我們·戰鬥",
      "text": "#戰鬥是件麻煩事，對我來說，它不是目的而是手段。用手段來達到目的，用戰鬥來維護不願讓步的東西。就這方面而言，我和{F#妳}{M#你}是一樣的。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」…「神之眼」？唔，這東西，隨緣就好。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "受人之託，忠人之事。我們往生堂性質特殊，肩負著雙倍責任，所以，一定要讓兩個世界的人都滿意才行。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#有些花草只長在陰氣重月光多的地方，{F#妳}{M#你}見過嗎？沒有？那下次帶{F#妳}{M#你}見識見識。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於鍾離…",
      "text": "鍾離長得那麼年輕，性格倒像是老古董，什麼都懂，卻什麼都不關心，他該不會…？嘻嘻…\\n唉，算了，隨他去吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於七七…",
      "text": "看到七七了嗎？快告訴我她在哪，我要把她藏起來，嘿！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於白朮…",
      "text": "白朮？哼，麻煩的傢伙。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於凝光…",
      "text": "天權凝光，富甲一方；明眸善睞，桃羞杏讓；目達耳通，百了千當！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於北斗…",
      "text": "北斗姐可是璃月名人，她不認識我沒關係，我認識她就行。啊~真想和她交個朋友啊。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於行秋…",
      "text": "聽說行秋少爺在寫書？話本還是怪談呢？好想把平日遇見的雜事說給他聽，寫成書一定很好看吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於重雲…",
      "text": "純陽正氣，陰陽合一？嘖嘖，嘶…沒想到世上真有這種體質的人。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於魈…",
      "text": "#仙家的事，我怎麼知道？哎呀呀，天機不可洩露。{F#妳}{M#你}就別問我啦。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於刻晴…",
      "text": "「玉衡」刻晴啊，嘶…是個很難打交道的人呢。嘿嘿，瞧那一本正經的樣子，真想逗逗她。哎呦，她應該不會用劍敲我頭吧？不會的吧？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於香菱…",
      "text": "香菱可好玩了，一碰就跳，特別容易被唬住。做我們這行，最喜歡這種人囉。不過也得注意分寸，畢竟，鍋巴會替香菱出頭呢。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於雲堇…",
      "text": "#雲堇她在正式場合很優雅，私底下卻非常容易親近哦！上次我跟她打了個賭，輸的人要用自己習慣的唱法唱對方填的詞。哎呀呀，戲腔版的丘丘謠，{F#妳}{M#你}真該聽一次！"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於申鶴…",
      "text": "#她可真是個有意思的人哪，跟別人都不一樣。{F#妳}{M#你}說，要是我從現在開始天天吃仙草、喝山露，會不會也變成她那麼不染紅塵的樣子？嘿嘿…"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於藍硯…",
      "text": "藍姑娘啊…她實力不俗，可不僅僅是「皮毛」這麼簡單。奇門秘術可真了不得，病氣死氣都被搬走啦。哎呀，可謂是——世風日上，身強力壯，往生堂的生意越來越難做囉。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解胡桃·其一",
      "text": "大丘丘病了，二丘丘瞧；三丘丘採藥，四丘丘熬；五丘丘死了，六丘丘抬~\\n欸…呼。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解胡桃·其二",
      "text": "小巷派暗黑打油詩人，正是本人！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解胡桃·其三",
      "text": "如果要我說，往生堂的工作既不困難也不可怕，只是麻煩而已。可惜旁人理解不了，見到咱們夜裡出工，總是有些懼怕。唉，是他們不懂啊。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解胡桃·其四",
      "text": "我是「往生堂」第七十七代堂主，我爺爺是第七十五代。我經手的第一份工作，就是替爺爺辦葬禮。是不是很意外啊？哎呀，不知不覺就在這行做了好些年，時間過得可真快。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解胡桃·其五",
      "text": "陰陽有序，命運無常。死亡難以預測，卻也有它的規矩。記住了，無論何時何地，無論有何原因，人都不該輕易挑釁「死」之一事。唯有認識它、尊重它，才能明白活著的價值。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "胡桃的愛好…",
      "text": "天清海闊，皓月凌空，此情此景，正適合作詩一首。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "胡桃的煩惱…",
      "text": "唉…真想找些新樂子，無所事事比死亡可怕多了。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "♪啦啦啦啦~吃水煮魚配蝦餃啦~"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "清心炒史萊姆凝液…嘔…這是香菱對我的復仇嗎？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "甚好甚好。本堂主現在就來為這道菜餚題詩一首——"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "真不用我來幫忙嗎？做一道送一道喔！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "噫…這是什麼東西呀？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今夜天星璀璨，月相壯麗，想必是個好日子。嘶，待我一算…嗯~我知道我知道，是{F#妳}{M#你}的生辰！哎呀，真是個好日子。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哦呀？哦呀呀？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "嗯~真不錯，謝啦。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "沒想到沒想到，胡桃我現在力如泉湧，心似雄鷹，非常有自信哦。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#力量若達到極限，接著考驗的便是人心。多虧了{F#妳}{M#你}，我才能來到這片未曾踏足的領域。在這裡，心和靈魂就像一片雲彩…生老病死、天地萬象，盡在吾輩。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "喝！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "起！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "散！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "吃飽喝飽，一路走好！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "再會啦！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "蝶火燎原！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "嚯——！"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "走~"
    },
    {
      "id": "700003",
      "type": 2,
      "title": "衝刺開始·其三",
      "text": "咻~"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "順風順水~"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "走大運囉！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "讓我看看，都有什麼好東西。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "快埋進土裡，等它長出好多寶箱！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "哎喲哎喲！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "噫——！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "糟糕！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "注意點！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "放著我來！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "到我了嗎…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我記…仇…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "呃啊——"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "幹嘛呀！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "喔？該我出馬了？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#{F#妳}{M#你}很有眼光嘛！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "一波送走，全送走。"
    }
  ]
}