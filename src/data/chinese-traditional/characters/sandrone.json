  "outfits": [
    {
      "id": 213300,
      "name": "發條與淑女與圓舞曲",
      "description": "桑多涅的裝扮款式。獲得了新生的她，覺得也是時候為自己做一套新衣服了，全新的人生值得一條全新的裙子。而這其中少不了的，自然是屬於淑女的優雅、華麗、大氣…還有就是祈禱它不要在戰鬥中破損，不要濺上咖啡和茶漬吧。",
      "isDefault": true,
      "characterName": "桑多涅",
      "characterId": 10000133,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_MarionetteNew_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#我討厭做自我介紹。該認識我的自然會認識，不需要認識的我何必去費這力氣？不過，好吧。出於淑女的禮儀，我就只說這一次——好好看清楚了。在{F#妳}{M#你}面前的，是「愚人眾」執行官第七席——「木偶」。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·茶會",
      "text": "差不多該約一次茶會了吧？也不知道其他人有沒有空。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·鋼琴",
      "text": "#我喜歡音樂，自學過很多樂器。{F#妳}{M#你}不信？哈，要是哪裡有鋼琴的話，我讓{F#妳}{M#你}見識見識。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·會議",
      "text": "又通知要回至冬宮？哈…怎麼總是有這麼多會要開？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "…煩人。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "我養的花喜歡這種天氣。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的時候…",
      "text": "防護系統…嗯，運轉正常。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候…",
      "text": "又到了那傢伙會撲到雪裡的時候…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "陽光很好…",
      "text": "這種天氣就適合泡杯濃濃的咖啡，吃個點心，然後舒舒服服靠在陽臺上看一下午的書。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "颳大風了…",
      "text": "裙襬真礙事…也不知道羅莎琳以前是怎麼解決的…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早，要來杯熱咖啡嗎？很提神。嗯？{F#妳}{M#你}問我喝咖啡有什麼用？嘖，我單純喜歡這個味道不行嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "已經這個時間了？我去準備一些茶點。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚飯也來找我？我這裡不是餐廳…算了，來都來了，叫法潔歐隨便做一點吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}去睡吧。我要趁晚上安靜沒人打擾的時候做一些研究——我沒有作息不規律！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於桑多涅自己·名字",
      "text": "叫我「桑多涅」不就行了？欸…？原本的名字？哈…就這麼想知道？好吧好吧…我還記得第一次睜眼——也就是阿蘭剛把我創造出來的時候——他叫了我一聲「小瑪麗安」。我試著開口確認這個名字的發音，卻觀察到阿蘭臉上浮現出了某種複雜的表情。我後來才知道，那是「後悔」與「內疚」，他在那之後再也沒叫過我「小瑪麗安」。阿蘭在同我講了水仙十字結社和他妹妹的故事之後，說我是自由的，應該擁有自己的人生和名字。他說我可以選擇自己的名字。我說「小瑪麗安」也滿好的，我不介意。小瑪麗安·吉約丹，我出生時被賜予的名字，獨一無二。巧合的是，女皇將「木偶」這名字分配給了我，它的叫法和「小瑪麗安」一模一樣。呵…這也算是某種「命運」？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於桑多涅自己·睡覺",
      "text": "剛誕生那時覺得專門找個地方躺下睡覺好麻煩，所以我都是在椅子上完成每天的「休眠」。後來到了至冬我才慢慢試著在床上睡覺。不得不說，在辛苦了一天，和太多煩人的同事打交道之後，換身輕鬆的衣服鑽到軟軟的被窩裡的確很愜意。這是由觸覺系統和情感回路共同構成的安全感，能理解為什麼那麼多人喜歡賴床了。不過在床上睡覺也有相應的煩惱，我身後的發條使我不能躺著睡，側著睡又不好保持平衡，最後就只能選擇趴著的睡姿了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·日記",
      "text": "#{F#妳}{M#你}連我的日記都看過了，是不是也該告訴我一點{F#妳}{M#你}的秘密才算得上公平？嗯？冒險手冊？我要那個幹嘛？想知道{F#妳}{M#你}每天幹了什麼我可以直接問凱瑟琳啊。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·立場",
      "text": "#雖說我們算滿熟了，但去到「至冬」，還是按規矩辦事。畢竟{F#妳}{M#你}這一路總是和「愚人眾」對著幹，不知道{F#妳}{M#你}在那邊又會惹上什麼麻煩…我當然會盡量不讓{F#妳}{M#你}為難，{F#妳}{M#你}也盡量別讓我為難。互相理解的基礎上互相幫助，這才是同伴，對吧？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「星之楔」…",
      "text": "滿好的，冰元素很實用。不用煩心大量計算後機體過熱的問題了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "沒有了普隆尼亞，生活中出現了很多不便，所以我造了「全功能通用型自動機關」，法潔歐。她能幫忙處理很多我不喜歡沾手的雜務瑣事以及日常戰鬥。嗯？原名很複雜？功能型機械不就應該這麼取名嗎？普隆尼亞的名字是阿蘭取的，意為——「未來事象觀演機關」。其他人不這麼取名？呃，原來這是遺傳…？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "我不否認自己在研究之餘，也會偶爾思考一些形而上的問題。就像每個國家的人都對死亡有著自己的信仰。常聽到他們聊「死後的世界」、「靈魂的歸處」什麼的…但從我的核心在對付多托雷的戰鬥中損壞，到「星之楔」啟動阿蘭的遺產將我重啟的這段時間，我沒有任何記憶。完全的虛無。機械造物，或說「人偶」死後會去哪裡？我們的「靈魂」應該如何被定義？我們是否真的有「靈魂」？這些問題無法被回答，所以最終我還是會老老實實回到自己的研究。但知識乃世界的基石，我相信這些石塊不斷壘砌，終有一天它的高度能讓我觸到這些問題的答案。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於茜特菈莉…",
      "text": "#那位大薩滿人滿好的。聽說她年紀滿大了？唔，真有活力，但就是有時候很容易激動。{F#妳}{M#你}問什麼時候？哦，上次是和她聊到{F#妳}{M#你}我結伴下水找東西的時候，再上次是聊到{F#妳}{M#你}在挪德卡萊幫哥倫比婭找回了名字什麼的…她聽完激動得臉都紅了，是上了年紀的關係嗎？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於琳妮特…",
      "text": "我真是服了！那個貓貓女到底是怎麼能每次都找到機械最薄弱的地方下手的？她哥能不能管管她？唉，算了…這恐怕也是種天分，下次讓她幫忙監修機械漏洞吧。要是連她這一關都過不了，那也別談什麼實戰了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於阿蘭·吉約丹…",
      "text": "阿蘭死後，我為他立了一塊墓碑。他生前說，希望我來為他撰寫墓誌銘。於是我寫了。這沒什麼難度——列舉他的事蹟，再選上一句能代表他的話：「很遺憾，但這就是結局。」這便是他常說的話。聽起來有些悲觀？哈，對不瞭解他的人來說是有點吧。但他總是微笑著說出這句話的。那不是認命或說放棄，更多是種滿足吧。就像解開了一道數理題。死亡不過是一個平靜的等號，而他現在去了公式的右邊。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於「冰之女皇」…",
      "text": "我尚且會因內心情感的「錯繆」感到煩心，但女皇大人…她究竟是如何將「情感」凍結得如此徹底的？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於「丑角」…",
      "text": "發號施令的傢伙。總覺得映在他眼中的景色，要比其他人遙遠得多。看到他第一眼我就感覺得出，這個世界奪走了他太多的東西。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於「隊長」…",
      "text": "大家都理解卡皮塔諾平時不喜歡摘下面罩，但儘管這樣，他還是會將茶會上倒給自己的茶喝完。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「博士」…",
      "text": "#{F#妳}{M#你}要不把耳朵摀上？我怕自己控制不好情緒。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於哥倫比婭・煩人",
      "text": "哥倫比婭以前就很煩，現在也沒好多少。虧我還覺得沒她在會清淨，誰知道見不到她的時候更煩！真受不了。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於哥倫比婭·生活",
      "text": "這傢伙現在的生活很幸福的，家人和朋友都在身邊，沒事還能外出旅行…我怎麼就沒有這種好運氣？算了，我也不是真的羨慕她。我們都知道，幸福是這個傢伙應得的。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於阿蕾奇諾…",
      "text": "阿蕾奇諾信守諾言、行事果斷，是個值得託付事情的人。不談私交，我希望工作上所有和我有交集的同事，至少先去學習一下阿蕾奇諾的品格。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於「公雞」…",
      "text": "他是皇都評議會的主持者，有時更像是…掌控者。評議會上的每一票都牽動著無數人的利益。要調和如此之多權利關係，沒有點手段是絕對辦不到的。從這點上來說，他就比其他人要可怕得多。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於「富人」…",
      "text": "當初就該嚴查他和多托雷之間的內部利益輸送好不好？憑什麼我的研究經費批得要比多托雷那個精神病慢十倍？這其中沒點什麼我都不信。我還當面質問過潘塔羅涅，結果他就用那笑瞇瞇的眼睛看著我說：「哎呀，看來桑多涅小姐終於對經濟管理感興趣起來了。我可以推薦幾本書給妳看，不如就從《禮貌用語100句》開始吧。」"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於羅莎琳…",
      "text": "她向來為自己而活。用自己的方式去愛，用自己的方式去恨。這種活法最終燒盡了她的生命。但直到最後一刻，那簇火焰也依舊是屬於她獨一無二的顏色。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於「公子」…",
      "text": "又是一個讓人不省心的同事…明明能和兄弟姐妹開開心心過日子，幹嘛偏要來當什麼「執行官」？還有，他到底要什麼時候才想得通，不是所有人都像他一樣喜歡打架。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解桑多涅·其一",
      "text": "哈？我可沒有隨隨便便就分享自己生活的習慣。再怎樣也得找個天氣好的日子，配上一些美味的茶和點心再聊吧？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解桑多涅·其二",
      "text": "儘管「愚人眾」裡有很多煩人的同事，但不可否認那是一處十分適合做研究的地方。幫女皇辦事就能得到豐厚的研究資源和專案資金，在我看來是個不錯的算式。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解桑多涅·其三",
      "text": "#我從不介意阿蘭以他妹妹瑪麗安的樣貌為基底創造了我，也不介意自己名字是「小瑪麗安」。在我看來，這便是出生時世界給予你的東西。{F#妳}{M#你}難道會在意自己長得像父母，名字中帶有他們的姓嗎？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解桑多涅·其四",
      "text": "我喜歡數理。公式與邏輯構成的世界，有一種基於確定性之上的優雅。我也喜歡音樂，它和數理相通。但從前的我，以為演奏音樂應當像演算數學題一樣，將譜子上的音符與節拍完美對應，不差毫釐。後來我才發現，一些演奏時的「小瑕疵」——甚至是「小錯誤」——反倒會讓音樂更加動聽。這裡稍微停頓一下，那裡突然來點即興的裝飾音…這些微小的「錯繆」，即是情感誕生的地方，是演奏者「心」的餘顫。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解桑多涅·其五",
      "text": "世界給予你的，世界又將之奪走。活著即是不斷得到與失去，在失去與告別中拾起那些世界奪不走的東西，然後繼續前進。如果一個人的願望僅僅是「活著」，那會太渺小嗎？就像一個人只為了「自救」而拯救世界，這樣的理由會太簡單嗎？「活著」，去感受，去見證。然後終有一日，說不定那些世界奪不走的東西，會多到足以撼動整個世界。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "桑多涅的愛好…",
      "text": "除了音樂和機械數理之外，我還喜歡在有條件的時候種些花草，記錄它們成長的過程。它們大多不需要什麼干預就能生長得很好，獨立而頑強。我以前就覺得這和我很像。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "桑多涅的煩惱…",
      "text": "想抱著什麼毛茸茸的小動物狠狠揉一揉…但牠們不喜歡機械，經常見到我就躲遠遠的。喂！別用那種憐憫的眼神看著我！抱不到就抱不到好了！也沒…沒那麼可惜…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "拜這具身體所賜，我不會過敏，也不會消化不良，所以品嚐美食對我來說是純粹的享受。不過硬要說的話…嗯，喜歡小巧而精緻的點心吧。那種典雅的造型光看著都令人心情愉悅，是視覺與味覺的雙份享受。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "不喜歡油膩辛辣的食物。倒不是說味道不好，只是在享用的過程中，那類東西的氣味很難不附著到衣服上。一點也不優雅。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#哼…哼。我就好心聽聽{F#妳}{M#你}是怎麼做的，幫{F#妳}{M#你}提提意見吧。不浪費是淑女的禮儀！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#哦？味道可以啊。下次茶會上我準備一份回禮給{F#妳}{M#你}。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "法潔歐，清掃時間到了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#哼。給，我平常才不會送這些。但今天對{F#妳}{M#你}來說是個值得慶祝的日子，它代表著{F#妳}{M#你}與這個世界初次相識的那一天。我已經叫了阿蕾奇諾和哥倫比婭，還有一些我們都認識的朋友。茶點也換成了我親手製作的蛋糕，{F#妳}{M#你}就好好期待吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "解算開始。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "填入變量。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "進展良好。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "析構萬理。我果然厲害！啊哈哈哈。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "歇一歇。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "跟上。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "無聊。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "哼。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "呵呵。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "再快點。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "演算，開始。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "茶間餘興。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "哼，可笑。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#哈？{F#妳}{M#你}忙半天就為這個？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "裡面有什麼？我…我沒在好奇！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#{F#妳}{M#你}拿去吧，忙這一趟怪辛苦的。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "法潔歐，還行嗎？"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "還沒分出勝負…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "有來有回也很正常！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "喂！沒事吧？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "小心點啊！我只會修機械！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "演算…出錯了嗎…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "茶會…該結束了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "很遺憾…但這就是結局…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
