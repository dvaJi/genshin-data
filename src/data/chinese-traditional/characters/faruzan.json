  "passives": [
    {
      "id": "impetuous_flow",
      "name": "迅捷流風",
      "description": "琺露珊處於<span style=\"color:#FFD780FF\">非想風天</span>的「疾風示現」狀態下時，瞄準射擊所需的蓄力時間減少60%；並能對「風壓坍陷」效果產生的風渦命中的敵人施加<span style=\"color:#FFD780FF\">摶風秘道</span>的「詭風之禍」效果。",
      "level": 1
    },
    {
      "id": "lost_wisdom_of_the_seven_caverns",
      "name": "七窟遺智",
      "description": "處於<span style=\"color:#FFD780FF\">摶風秘道</span>的「祈風之賜」效果下的角色的普通攻擊、重擊、下落攻擊、元素戰技或元素爆發對敵人造成<span style=\"color:#80FFD7FF\">風元素傷害</span>時，會產生烈風護持效果：基於琺露珊基礎攻擊力的32%，提高造成的傷害。每0.8秒至多產生一次烈風護持效果，該效果將在「祈風之賜」持續時間結束或生效1次後消失。",
      "level": 4
    },
