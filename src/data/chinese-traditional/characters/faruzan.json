  "outfits": [
    {
      "id": 207600,
      "name": "碧葉素華",
      "description": "琺露珊的裝扮款式。素雅的風格象徵著不為外物所動的純粹，百年前曾在教令院內風靡一時，現如今已經沒什麼人穿了。",
      "isDefault": true,
      "characterName": "琺露珊",
      "characterId": 10000076,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Faruzan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "這是當年教令院的傑出學者獎，這是須彌解謎協會終身成就獎，還有遺蹟機關研討會的…如何，可有意願拜入我門下？咳咳，順帶一提，琺露珊前輩我是知論派學者，找我請到室羅婆耽學院來，不是剎訶伐羅學院，別找錯地方了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·規矩",
      "text": "都過去一百年了，教令院的這些傻規矩怎麼一點都沒改啊…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·前輩",
      "text": "嗄——？什麼？年紀大，聽不見。先叫聲前輩聽聽吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·做學問",
      "text": "做學問並不是趕流行，沒有冷門熱門之說。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "早就不是小孩子了，下雨天有什麼好興奮的。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "嗚哇！？怎、怎麼啦？年紀大就不可以害怕打雷了嗎？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "好美…讓人著迷…哈啾！好吧…也讓人著涼…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "太舒服了，還是空氣流通的環境好啊。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "怎麼兜兜轉轉又到這邊來了…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "年輕人，早上就該拿出點精神來！快重新向我問候一遍。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "有點餓了…去大巴扎吃嗎？我口味不挑，別太新潮就行。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "別大驚小怪，不管哪個時代的學者，都會徹夜做研究。夜晚是能夠寧靜思考的寶貴時段。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "這篇古文看得我頭昏眼花…今天就到這吧，早點休息，我也睡了，晚安。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於琺露珊自己·前輩",
      "text": "#想瞭解什麼？壓力機關的變體？元素方碑的底層設計？嗯，等等…{F#妳}{M#你}剛剛向我提問的時候，是不是忘了叫我前輩？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於琺露珊自己·零學生導師",
      "text": "我希望我的學生都能打心底裡喜歡古文研究，要是遇不到這樣的孩子，那就乾脆當一輩子的零學生導師！啊、啊？找新生幫忙的事？偶爾用課餘時間幫助一下前輩很合理吧？說得像是誰不是這樣過來的一樣…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·招生",
      "text": "#認真說，要不要當我的學生？我會針對實際幫{F#妳}{M#你}定制課題，講得比誰都要透徹。現代機關解謎是重點，相關文獻解讀作為拓展…我是過來人，這些知識對今後的冒險大有裨益，{F#妳}{M#你}還能不信我？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·解謎時光",
      "text": "#那一百年間，我不斷重複著解謎，不知不覺變得麻木，連時間的流動都感受不到…現在好了，面對謎題，我不必再獨自彷徨了。也許可以和{F#妳}{M#你}一起拓抄碑文、破譯字符、解構機關…好好地品味每分每秒的鑽研時光。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我的學術水準，哼，就算不談我過去的光輝履歷，這可是連神明他老人家都認可的。至於為什麼招不到學生…不是我的問題，也不是學科的問題，大概是契機吧…就像我獲得神之眼也是在特定的契機下。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·妙論派",
      "text": "「剎訶伐羅學院是未來唯一有能力研究機關的學院」…哼，現如今，妙論派的宣言也未免太過自大了，我在須彌解謎的時候，他們還不知道在哪裡玩積木呢。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·知論派",
      "text": "知論派那群傢伙總喜歡以太過冷門、無人問津為由卡我的研究經費。按照這個評判標準，知論派至今都是人數最少的學派，乾脆把室羅婆耽學院都關了算了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "我去過大大小小的遺蹟，從有限的古代圖文來解讀，「遺蹟龍獸」，確實是精妙絕倫的機關，唔…也許不能用「機關」二字來概括，說它們是一種從古代遺留至今的「生命」也不為過…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "就像知論派的研究也會被用在妙論派上…知識本就是無法被限制的。所有學者都會感激小吉祥草王，讓教令院，不，讓須彌這個智慧的學城得以擺脫私欲的裹挾，讓求知之人都有機會在學術之海中鉤深索隱…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於提納里…",
      "text": "雨林遺蹟研究算是最讓我省心的專案，喔，得找提納里一起。把活的《雨林生存指南》帶在身邊多好玩。哎呀，不得不說，雖然我年紀大，但吃過的蕈類遠不如他見過的多呢。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於柯萊…",
      "text": "柯萊啊…這女孩尊敬師長，又勤勉又好學，是一等一的完美學生！對這樣的孩子就該溫柔激勵才對，提納里有必要這麼嚴苛嗎？真是的…得想辦法把她搶過…咳咳！我是說…身為前輩…得想辦法改善一下當今年輕人的求學環境才行…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於賽諾…",
      "text": "#賽諾的笑話明明是由現代的文字和語言構成的，但我還是沒辦法從文法和文義上推演出藏在話語中的意思…{F#妳}{M#你}是說就只是字面意思和諧音？真的…？那這些笑話也太無趣了…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於萊依拉…",
      "text": "有時她看見我會低著頭繞路走開，半夜裡偶遇卻又會大大方方地打招呼…搞不懂。算了，能擠進梨多梵諦的小孩子們大多都是天才，天才總有些自己的怪癖，我就不計較了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於卡維…",
      "text": "卡維這孩子是個好苗子。我跟他隨便聊過一些機關構造原理，怎麼說呢…儘管浪漫思想和藝術細胞都有些過甚，但還算有自己的想法，不容易。聽說他日子過得有點緊，我一直等著哪天拿到經費就請他吃頓好的…等著吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於妮露…",
      "text": "有印象，是個有禮貌的女孩。去了大巴扎幾次就把我記住了，還勸別人不要和我吵架。說的很對嘛，現在的年輕人啊，就該多向妮露學習。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於賽索斯…",
      "text": "#哦？那個新來的小子？來得正好！我還不知道他是哪個院的，最近老是看到他晃來晃去——街上啊、商店啊、餐廳啊…哪裡都有他，這孩子說話的時候一直點頭，像個…像個小狗腦袋？能說善道得很，應該是個人才。欸，{F#妳}{M#你}要是認識他，記得勸他轉到我門下來。前輩我啊，絕對不會讓他吃虧的。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解琺露珊·其一",
      "text": "#琺露珊前輩我的故事都趕得上某些文獻的跨度了，得從一百多年前講起…還想聽嗎？很好，積極求知是學者不可或缺的素質。{F#妳}{M#你}入門了。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解琺露珊·其二",
      "text": "#從前的那些機關解謎需要配合大量的文獻解讀研究。不是我吹噓，跟{F#妳}{M#你}解過的謎題恐怕完全不在一個層次。不服？好啊，{F#妳}{M#你}挑點{F#妳}{M#你}覺得難的，擺出來看看。能思考超過半小時就算我輸。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解琺露珊·其三",
      "text": "要不是誤入那個赤王遺蹟，我還能為須彌貢獻更多…好在之前的手稿和論述沒有白費，現在都便宜了妙論派，成了機關學的學科基礎。呵呵，這一聲「前輩」，我還是擔得起的。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解琺露珊·其四",
      "text": "身為學者，原本就該坦然接受失敗、承受後果…我絕不希望別人可憐我，無論是過去還是現在！再說，我明明是憑實力解開了最後的謎題，逃出了那個鬼地方…比起可憐，不該多從我身上找點激勵和啟發嗎？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解琺露珊·其五",
      "text": "我研究方向的地位已經大不如從前了，知論派卡我經費也不是一次兩次了…妙論派三番四次邀請我到那邊當導師，那條件還真誘人啊，更高的經費額度、更多的學生…但我還是拒絕了。不管怎樣，總要有人負責鑽研那些無人問津的領域，將全人類的智慧往外推出一小步。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "琺露珊的愛好…",
      "text": "有些黑心商販和傭兵常常混進奧摩斯港，拿著不知從哪裡弄來的「古董」高價兜售，其實全是些用壞用舊的破爛！哼，我見一次就拆穿一次。論「鑑古」，除了「塵世七執政」，我還從不覺得自己能差過誰的。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "琺露珊的煩惱…",
      "text": "一百年前，我最大的煩惱不過是解讀不了遺蹟碑文上的內容。一百年後，什麼煩心事都比不過弄不到研究經費…唉！太難了…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#麵糊拿去烤一烤，香味倍增！有機會我露兩手給{F#妳}{M#你}，讓{F#妳}{M#你}也嚐嚐我那一輩的做法和風味。「古法秘製」，保證{F#妳}{M#你}逛遍大巴扎都找不到。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#那個叫什麼…帕蒂沙蘭布丁，那是誰發明的做法啊？布丁不應該是用米飯做嗎？現在的這些創意，越來越譁眾取寵了。不…謝謝，我沒有嘗試的興趣，即使是{F#妳}{M#你}做的也免了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "唔…唔…比許多老字號做得還好，難道美食界也在不斷進步？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#色香味樣樣不差，莫非{F#妳}{M#你}常看美食製作類的書籍嗎？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#嗯？這什麼東西，好晦澀的食物，{F#妳}{M#你}是想讓我解讀嗎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！為{F#妳}{M#你}做了個玩具，拿好。它集合了微縮機關裝置，這裡有按鍵和推桿…側面有滾輪…{F#妳}{M#你}就隨便放在手上撥弄吧，壞了包修。把{F#妳}{M#你}當小孩子？笑話。快樂和放鬆是每個人都需要的東西，管它什麼孩子大人的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哈，手腳很俐落呀年輕人，找起素材來都是風風火火的。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#噢？{F#妳}{M#你}解開了什麼機關嗎？力量正源源不斷地湧過來呢~"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#呵，{F#妳}{M#你}倒是挺賣力的…放心吧，引導與保護，是前輩的職責，我不會讓{F#妳}{M#你}陷入困境的。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#在無邊的智慧之海中，百年，也只能短暫地瞥見一角浪花…那些仍未深入的學問和未能解開的謎題，就靠{F#妳}{M#你}和我一起努力了。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "後悔也晚了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "敢惹我？"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "走著瞧。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "毗嵐重機！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "送你，拿去玩吧！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "真理，復始周轉。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "有文物出土？喔…這個啊。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "算沒白跑一趟。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#給{F#妳}{M#你}拿去用好了，快說謝謝前輩。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "也不是第一次了！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "這種困境…不算什麼…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "別小看我了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "注意安全，別送命了。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "這種時候要學著依靠前輩！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "謎題…仍未解開…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "學者之路…不應有盡頭…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "時間…沒為我停留…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "宵小狂徒！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "目無尊卑！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "還得靠前輩幫忙吧？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "好久沒舒展筋骨了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "好吧，陪陪年輕人。"
    }
  ]
}