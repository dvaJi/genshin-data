  "outfits": [
    {
      "id": 203000,
      "name": "凡世致身",
      "description": "鍾離的裝扮款式。「往生堂」客卿鍾離先生近來最為青睞的假日常服。",
      "isDefault": true,
      "characterName": "鍾離",
      "characterId": 10000030,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Zhongli_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#一份新的「契約」？好吧…雖然我還在度假，但也可以陪{F#妳}{M#你}走一趟。契約書上，該簽什麼名字呢？我有許多名字，度假期間的話…我會自稱「鍾離」。{F#妳}{M#你}呢，旅行者？{F#妳}{M#你}會簽下什麼名字？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·旅程",
      "text": "旅程總有一天會迎來終點，不必匆忙。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·遊覽",
      "text": "接下來想去哪裡？如果想遊歷璃月名勝的話，我有一些不錯的參考方案。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·璃月",
      "text": "為「流通」而造的船，遇到港口也會停泊，所以璃月是一切財富「沉澱」的地方。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "閒聊·懷舊",
      "text": "欲買桂花同載酒…只可惜故人，何日再見呢？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨過天晴…",
      "text": "「琉璃袋」這種植物，它偏愛潮濕的環境，最適合雨後採摘。如果發現的話，適當儲備些吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#找個地方避避雪吧。我不會有事，但{F#妳}{M#你}可能會著涼。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "颳大風了…",
      "text": "嗯…不適合度假的天氣。去聽聽戲吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "希望今日也有好景氣。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "想要吃點提神的？嗯，吃虎岩倒是有間不錯的店…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "雖然這種時候已經錯過了雲先生的戲，但夜晚的璃月仍有許多好去處。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "集市已收，喧鬧的碼頭也已沉睡。去休息吧。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於鍾離自己…",
      "text": "不以規矩，不能成方圓。不管是常人還是仙人，惟有各司其職，方能保璃月長久太平。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·黃金",
      "text": "#黃金是璃月的財富，是令璃月的心臟搏動的血液。{F#妳}{M#你}是否擁有黃金般閃耀的心，就讓我拭目以待吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·契約",
      "text": "#{F#妳}{M#你}我既有「契約」之交——那麼凡在契約範圍內的事，都可同我商量。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·公平",
      "text": "#「契約」之外的事也可與我相談。畢竟我在這片土地上活了這麼久，凡事都略通一二。哦，雖說如此，我也有希望{F#妳}{M#你}能為我做的事情。畢竟，這樣才符合「公平」嘛。"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "關於我們·困惑",
      "text": "#「契約」無法界定「友誼」、無法丈量「情誼」，那到底用什麼才能稱量{F#妳}{M#你}我之間情感的重量呢？「朋友」，{F#妳}{M#你}知道答案嗎？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」…也是一種「契約」。須知一切力量皆有其代價，一千種權力伴隨著一千種責任。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "「交易」的規矩是「契約」，準則是「公平」。這是訂立、遵循「契約」者絕不可忘卻之事：倘若失了公平，那契約便成了欺瞞的憑據。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}若去往「絕雲間」，便替我採來一束「清心」吧。一束就好。此行的旅費…啊，差些忘了，「契約」生效期間，旅費由{F#妳}{M#你}代為墊付。那就有勞了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於魈…",
      "text": "#{F#妳}{M#你}說，歸離原的少年仙人…啊…直至今日，他仍在履行他的職責…哦，這副「連理鎮心散」，請替我帶給他。對了，可千萬不能讓小派蒙偷吃了去，這裡的藥力…絕非常人所能承受。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於溫迪…",
      "text": "#嘶…好濃的酒氣。那個詩人剛剛來過吧，那個和風雅二字搭不上一點關係的酒鬼詩人！你這裡…唔，被他誘騙著灌了酒，話也說不清了嗎…{F#妳}{M#你}等一下，我去沏一壺「醒神茶」，只需三個時辰便好。{F#妳}{M#你}等一下…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於凝光…",
      "text": "即便每日經手的事務千條萬縷，她仍不失進取之心，實屬難得。讓我想起，彼時的她赤著腳從瑤光灘走到南碼頭，一路叫賣貨品的樣子。時間對於常人，真是殘酷…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於胡桃…",
      "text": "當代堂主？嗯…那孩子，我應付不來。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於達達利亞·沉著",
      "text": "#那位來自至冬的武人，還沒離開璃月嗎？沒關係，要是他找{F#妳}{M#你}麻煩，{F#妳}{M#你}可以喚我去應付他。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於達達利亞·酒桌",
      "text": "#聽說「公子」最近在愚人眾的風評又變糟了不少。但像他這樣的人，一定會用積極的行動去掃清那些對他的怨言吧。嗯…這樣想來，下回酒桌上又有不少趣事可以聽了。旅者，{F#妳}{M#你}也一起來嗎？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於甘雨…",
      "text": "#璃月這個國度的繁榮，靠的絕不僅是「岩王帝君」的神諭，而是無數響應「契約」的岩神子民。在這之中，甘雨已是就職時間最長的一位了。關於她的往事…我怕她怪罪，讓她自己和{F#妳}{M#你}說吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於刻晴…",
      "text": "她是當代七星中最「不敬神」的，但我還挺欣賞這樣的人。「覺得自己是正確的，就大聲地說出來、堅決地去行動」——就是因為璃月有這樣的人，我才會考慮退休一事。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於煙緋…",
      "text": "她未曾與我簽訂「契約」，卻在以自己的方式維護璃月各界的規矩，並將有失偏頗的觀念糾正。倘若某天，她的父親遠遊歸來，想來會比我更欣慰吧。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於巴爾…",
      "text": "時間會淬煉一切意志。而她，恰好是會為信念付出所有的人。或許正因如此，她才能走到這一步。如有機會，我也想見識一下她為之傾盡一切的「永恆」。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於布耶爾…",
      "text": "智慧之神布耶爾，不僅統管整個須彌，還肩負著守護世界樹的職責。若非有大智慧，的確難以司掌這些。拯救世界樹一事，整個提瓦特的生靈都理應向她致謝。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "與「自我」簽訂下拯救國家的契約，並嚴守五百年，最終騙過了天理…我尊敬一切需要自我踐行的「正義」。即便神性的部分已經消散，神座不復存在，但對於整個楓丹的歷史來說，芙寧娜依舊是值得被認可的正義之神。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於閒雲…",
      "text": "我聽不少商人聊起過「閒雲」的逸聞。說是這位女子看似倨傲，不喜言談，交談一番卻發現她性格耿直，作風正派，是位值得結交的良友。我為她高興。但「出手闊綽」這則評價，嗯，也有不少人對我說過…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於赫布里穆…",
      "text": "納塔將悠久的抗爭歷史譜寫成詩，激勵無數戰士前仆後繼，由此得以跨越深淵與宿命的威脅，創造出新的未來。而率領他們的，是一位將時間與歷史化作武器的人類戰士，她足以與神明比肩的實力，令人嘆服。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於白馬仙人…",
      "text": "白馬，白馬…這位仙人，其實也是我許久未見的一位故人。只可嘆，春夜短，秋日速，隙過駒，風過燭。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解鍾離·其一",
      "text": "怎麼，難得閒暇，不好好休息卻反來找我。是想聽我講故事嗎？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解鍾離·其二",
      "text": "「黑岩廠」的起源，聽說過嗎？\\n在過去，人們一邊將天衡山中的礦脈挖空，一邊在裡面修建工廠設施，漸漸建成了東大陸最大的工廠。山中黯道四通八達，一些甚至能通往大地深處的古遺蹟。能掌握其中一切通路的人，如今大概沒有了吧。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解鍾離·其三",
      "text": "「海燈節」的起源，聽說過嗎？\\n在很久以前的戰爭中，璃月人會在夜裡放飛明亮的燈，讓廝殺的戰士不迷失回家的方向，不迷失自己的心。這種事情，如今大概已經沒有人記得了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解鍾離·其四",
      "text": "「契約之神」的事情，聽說過嗎？\\n他的記性很好。每位對手的名字，璃港船局建成以來製造的每一艘船起航的日子，都不曾忘卻。畢竟，有這樣的記憶力，才能銘記一切「契約」。\\n然而，記性很好有時是令人不快的事。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解鍾離·其五",
      "text": "#活得太久的人，只能在記憶中尋訪往昔的戰友、過去的景色。\\n即使如此我也不後悔與{F#妳}{M#你}相識，「朋友」。假使有一日不得不同{F#妳}{M#你}相別，{F#妳}{M#你}在我的記憶中也會如黃金般閃耀。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "鍾離的愛好…",
      "text": "得閒時在城內散步，就能讓我心安不少。嗯…這種心情，是從何時開始…？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "鍾離的煩惱…",
      "text": "讓人們遵循「契約」，依照契約的規矩行事，其實是希望人們能遵循「公平」。只是這一點，總有人意識不到。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "很久以前，與朋友共飲的酒。是因為氣候變了嗎？唉，過去的滋味，或許再也不能重現了吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不喜歡海鮮。僅僅是看到海鮮，就會想到那種…該怎麼說呢，滑溜溜的觸感，洗不淨的腥味。哦，原因的話…\\n唉，說來話長，就當是因為我記性太好了吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "用料講究，做法道地。屬實不易。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#烹飪是一件饒有趣味的事，想來對{F#妳}{M#你}而言也是如此。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#既有閒暇，不如找一處庭院，和{F#妳}{M#你}說一段故事吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。這是曾在{F#妳}{M#你}出生的那天盛開的，「琉璃百合」的乾花。\\n很久以前的璃月人會說，這種花承載著大地中的美好記憶與祈願而盛開。我願意相信，{F#妳}{M#你}的誕生也是同樣的道理。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "力量似乎漸漸回來了。不多，但有用。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "力量增長了，身體的負擔隨之劇增…哦，我沒事，我的構造不同常人，請不用擔心。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "原來如此，驅動「神之眼」駕馭元素力，對於常人而言不啻偉業。哦，原來如此…那時的他們，是抱著這樣的覺悟站在我身旁啊…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#不曾料想，放下「神之心」後，還能看到這種景色——感謝{F#妳}{M#你}，「朋友」…對了，我這裡有一份新的「契約」，不一起來看看嗎？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "壁立千仞。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "震天撼地。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "靡堅不摧。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "俱收並蓄。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "安如磐石。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "固若金湯。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "天理長驅。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "此乃天道。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "天動萬象。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "遺珠棄璧，吉光片裘…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "偶遇之物，亦有風雅。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "不虛此行。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "你的實力我姑且認可。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "哈，有點意思。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不太擅長危機應對啊。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不可貿然進攻。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "下去休息。這裡交給我。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "啊，略感疲憊…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "#讓{F#妳}{M#你}看到，難堪的一面了啊。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "磐石…也會歸於塵土…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "大意了嗎。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "不足為懼。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "也好。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "就當是散心了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "做些什麼好呢…"
    }
  ]
}