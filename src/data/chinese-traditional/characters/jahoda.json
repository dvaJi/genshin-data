  "outfits": [
    {
      "id": 212400,
      "name": "嶄星遊影",
      "description": "雅珂達的裝扮款式。衣服由雅珂達最最親愛的英明神武無所不知的老闆奈芙爾訂做，護目鏡由愛諾免費贈送，風帽由伊涅芙親手織造。換一套新衣服，是與過去訣別的第一步。",
      "isDefault": true,
      "characterName": "雅珂達",
      "characterId": 10000124,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Jahoda_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#喲，初次見面，有什麼要委託的事儘管說吧。無論是什麼事，只要錢有付夠，我都能幫{F#妳}{M#你}——呃…大部分的事…肯定能幫{F#妳}{M#你}搞定。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·奈芙爾",
      "text": "唔…老闆什麼時候替我加點薪資呢？還有好多想買的東西…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·逛街",
      "text": "#走，逛街去啊，帶{F#妳}{M#你}見識點好玩的東西…別聲張哦，我們悄悄去。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·阿舍魯",
      "text": "上次我摸阿舍魯的時候，牠居然哧溜一下跑掉了，哼，今天不幫牠買魚乾吃了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "下雨了？走走走，躲躲雨去，別被淋濕了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "嗚哇！雪飛進脖子了，冷死了冷死了——"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "呸呸呸，沙子飛嘴裡了！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早啊，吃早飯了沒？我帶{F#妳}{M#你}去吃點好吃的？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "唔…不然還是回店裡睡個午覺吧，總覺得好睏…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "都這個時間了，收工收工，回去摸阿舍魯去囉~"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#呼啊——該睡覺了…喂，{F#妳}{M#你}還在忙啊？差不多也該休息去啦。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於雅珂達自己·經歷",
      "text": "來「秘聞館」之前，我的「工作經歷」很雜的，奮力求生了那麼長時間，才遇見了奈姐這麼一個好老闆，也算是我苦盡甘來吧。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於雅珂達自己·秘聞館",
      "text": "老闆對我滿好的，阿舍魯對我也還算不錯。嗯…但我有時候會不由自主地把老闆叫作奈姐，怎麼樣也改不過來…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·故鄉",
      "text": "我的故鄉？我都不記得了…我也不在意這種東西，只要能吃飽飯、能安穩睡覺的地方，就算是我的「故鄉」囉。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·朋友",
      "text": "#我們都一起出生入死過了，當然已經是朋友了。下次遇見麻煩的時候，我的背後就交給{F#妳}{M#你}囉——盡量別出賣我，好嗎？就算要賣，也請賣一個好價錢，不然我的身價可要跌了…哎呀，開玩笑的，我知道{F#妳}{M#你}不會出賣我，{F#妳}{M#你}是一個好人，不會做這種自私的事。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "嘿嘿，它可是我的寶貝，有了它之後，工作都輕鬆不少。沒想到啊沒想到，我雅珂達也有運氣這麼好的時候…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·寶藏獵人",
      "text": "#{F#妳}{M#你}在街上是不是有遇見過自稱「寶藏獵人」的傢伙？別被這個名號唬住了，{F#妳}{M#你}就把他們理解成挪德卡萊的「僱傭兵」就好了，只要給夠錢，他們就會願意幫{F#妳}{M#你}辦事。如果{F#妳}{M#你}真的想找這群人幫忙的話，我認識幾個好手，到時候介紹給{F#妳}{M#你}。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·大炮",
      "text": "「轟隆隆月矩力能量炮」開炮的時候，真的很帥氣啊。唔…要是能買一臺那門大炮的等比例縮小機械模型就好了，愛諾能不能幫我做一臺呢？反正這門大炮也是她造的…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#我昨天突然胡思亂想，{F#妳}{M#你}說…到底多少粒沙子聚在一起，才能被稱為「一堆沙」呢？一百粒？一千粒？好像都不太對，過幾天我去找愛諾問問好了，她肯定知道。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於菈烏瑪…",
      "text": "菈烏瑪小姐？嗯…雖然我不怎麼瞭解她，但我也知道她的身分很高，實力也很強，而且她還能和動物說話。這麼一來，希汐島上的那些動物，不都等於是菈烏瑪小姐的耳目了？怪不得沒有寶藏獵人敢去希汐島「尋寶」呢，一上島不就等於自投羅網嗎…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於伊涅芙…",
      "text": "#啊，那個笨蛋機器人啊？做蛋捲滿好吃的啊，就是總記不住人說話，而且也沒什麼幽默感，隨便說個玩笑都要認真地問我哪裡好笑，但她的蛋捲真的很好吃喔。有機會{F#妳}{M#你}一定要嚐嚐。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於奈芙爾…",
      "text": "奈姐當然是我最最親愛的老闆啦！嘿嘿嘿，她不僅給我工資，還管吃管住。不過，她手底下好像也就只有我一個正式員工…啊，還有阿舍魯，差點忘了。不過，阿舍魯說是員工，卻一次委託都沒處理過…哼，居然吃免費的，下次我就抱著牠出外勤去！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於愛諾…",
      "text": "愛諾的手藝很好哦，無論我把手臂折騰成什麼樣，她都能修好。但是每次修理手臂的時候，愛諾都會在上面畫畫，說什麼這樣比較可愛，雖然的確滿可愛的，但她怎麼不在伊涅芙身上畫呢？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於菲林斯…",
      "text": "#我聽奈姐說過，執燈人是一個歷史很悠久的組織，裡面的人又厲害又聰明，還知道很多古老的秘辛。{F#妳}{M#你}覺得…菲林斯會不會也知道某些寶藏的線索？或者是知道哪裡有沒被挖過的遺蹟？呃…我就是想想，不會去問的，不然奈姐又要訓我了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "#{F#妳}{M#你}說法爾伽大叔啊？他倒是和我說過自己是西風騎士團大團長…但是根本看不出來嘛…騎士團團長不應該是那種很認真，看起來就很可靠的人嗎？啊！我可沒有說法爾伽大叔不可靠的意思哦。不過，西風騎士團的大團長在這裡，那留在蒙德的騎士們又歸誰管呢…欸？一個很認真，看起來就很可靠的人，哈哈…西風騎士團，真是複雜啊…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「庫塔爾」…",
      "text": "那位大人物啊…唉，要是放在之前，遇見背景這麼複雜的人，我一定會離她遠遠的，跑得越遠越好！不過…她之前救過我，我也要還她的人情才行，不然也太不講義氣了。\\n雖然話是這麼說，但我總共就只有一條命，再這麼折騰下去，我看多少條命都不夠往裡面賠的，老闆保佑老闆保佑…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於「木偶」…",
      "text": "下次，我絕對不會去那種地方了！就、就算要去，也要老闆和我一起去才行。又是狂獵又是愚人眾的，我有命賺錢，沒命花錢啊！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解雅珂達·其一",
      "text": "在「秘聞館」裡，大事歸奈姐，小事歸我，開門接待的事歸阿舍魯。什麼算大，什麼算小？那就得看奈姐了，她是老闆嘛，說什麼就是什麼…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解雅珂達·其二",
      "text": "好好賺錢，好好吃飯，這就是我現在的人生信條。反正只要跟緊奈姐的腳步，我肯定天天能吃飽，嘿嘿嘿…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解雅珂達·其三",
      "text": "我的右手臂？啊…沒什麼大不了的，它只不過是被我作為「代價」交換出去了。放心啦，那一筆買賣做得很划算，至少在我看來，不算是虧本買賣。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解雅珂達·其四",
      "text": "就像買東西需要付出摩拉一樣，如果你想要獲得某種東西，就一定會付出某種「代價」。那些有形的「代價」能夠被計算規劃，但某些無形的「代價」，卻總是難以估量，它們會蟄伏在你的影子裡靜候時機，待到你孤立無援時，它們就會現出身形，向你索要一份你根本無法付清的贖金。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解雅珂達·其五",
      "text": "#喂，如果{F#妳}{M#你}也要為什麼事情支付「贖金」的話，可以來找我幫忙喔。就算我的錢不夠，我也可以厚著臉皮找奈姐的，大不了…我就再替她打白工一段時間——但{F#妳}{M#你}千萬別直接找奈姐，如果{F#妳}{M#你}一定要欠一個人的錢，那{F#妳}{M#你}還是欠我的好。記在奈姐手上的債，可能是世界上最難還的了…我怎麼知道？呃，啊…{F#妳}{M#你}、{F#妳}{M#你}別問這麼多，聽我的就是了！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "雅珂達的愛好…",
      "text": "#我閒下來的時候，偶爾會縫一縫布娃娃，雖然沒真正找哪位大師學過，但我之前…認識的人都說，我縫得有模有樣，下次也做一個送給{F#妳}{M#你}。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "雅珂達的煩惱…",
      "text": "不知道為什麼，只要我睡的床太軟，我就會失眠，但我睡在硬邦邦的地板上時，卻能迅速睡著，而且睡得特別熟，到底是為什麼呢？真奇怪…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "特別喜歡的食物？一時半會我還真的想不到，肉和魚我喜歡，糖雕和餅乾我也喜歡…嘿嘿，只要是好吃的，我都喜歡！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不喜歡那種混合著很多食材，煮了很久…煮到食材都完全融化的大濃湯…呃，但如果非要喝的話，我也不是不能喝啦，就是盡量不喝嘛…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#好吃！{F#妳}{M#你}手藝居然這麼好，再幫我盛一點，嘿嘿嘿，比奈姐的手藝還…咳！那個…{F#妳}{M#你}吃了沒？不然…一起吃？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "不錯啊，嘿嘿，快快吃飽，好去工作。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "呃…我能…能吃完，不會浪費食物的，哈哈哈…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！喏，這個布娃娃給{F#妳}{M#你}，我剛縫好的。我第一次用這種方法縫娃娃，花了不少時間呢。娃娃裡面還放了助眠安神的草藥，{F#妳}{M#你}就把它放在枕頭旁邊吧，保證{F#妳}{M#你}睡得安安穩穩，絕對不會做噩夢。手怎麼包著絆創貼…啊…和阿舍魯玩的時候，被牠的爪子抓了一下，沒事啦，哈哈哈…沒事…"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "喔？不錯啊！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "身手更靈巧了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "嗯…該活動活動筋骨了！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "嘿嘿，夠我幹一票大的了…怎麼樣？要一起嗎？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "目標就是你！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "該明搶了！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "往哪裡跑！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "都是我的！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "拿來吧！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "我從不走空。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "喔！都是我們的了！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "收穫不錯，總算沒白跑。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "又賺了一筆。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "好…好…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "你等著…！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "看我把你…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你傻了嗎？！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "回來！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "還是…難逃…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我的債…還清了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "這樣…就好…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "有工作了？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "包在我身上。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "看我的吧。"
    }
  ]
}