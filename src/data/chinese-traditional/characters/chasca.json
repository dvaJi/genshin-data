    {
      "_id": 1044,
      "id": "sparks_the_sudden_shot",
      "name": "星火，瞬息的擊發",
      "description": "元素爆發<span style=\"color:#FFD780FF\">索魂命襲</span>中的<span style=\"color:#FFD780FF\">溢光索魂彈</span>命中敵人時，將為恰斯卡恢復1.5點元素能量，並會根據<span style=\"color:#FFD780FF\">溢光索魂彈</span>的元素類型，造成相當於恰斯卡攻擊力400%的對應元素範圍傷害，該傷害視為重擊傷害。<br/>上述造成對應元素範圍傷害的效果，每次施放<span style=\"color:#FFD780FF\">索魂命襲</span>至多觸發1次該效果。",
      "level": 4
    },
    {
      "_id": 1045,
      "id": "brim_the_sandshadows_silhouette",
      "name": "帽簷，沙影的輪廓",
      "description": "元素爆發<span style=\"color:#FFD780FF\">索魂命襲</span>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 5
    },
    {
      "_id": 1046,
      "id": "showdown_the_glory_of_battle",
      "name": "相決，鬥爭的榮光",
      "description": "恰斯卡進行<span style=\"color:#FFD780FF\">多重瞄準</span>所需的蓄力時間減少，且觸發突破天賦「子彈的戲法」中的「附靈轉化」後，恰斯卡將獲得「命襲」狀態，在接下來的3秒內，恰斯卡下一次施放元素戰技<span style=\"color:#FFD780FF\">靈韁追影</span>中的<span style=\"color:#FFD780FF\">多重瞄準</span>時，會立即完成蓄力，並且本次<span style=\"color:#FFD780FF\">多重瞄準</span>中的<span style=\"color:#FFD780FF\">追影彈</span>和<span style=\"color:#FFD780FF\">煥光追影彈</span>的暴擊傷害提升120%。每3秒至多獲得一次「命襲」效果。<br/><br/>上述效果需要解鎖突破天賦「子彈的戲法」。",
      "level": 6
    }
