  "constellations": [
    {
      "_id": 1041,
      "id": "cylinder_the_restless_roulette",
      "name": "彈匣，躁動的輪盤",
      "description": "觸發突破天賦「子彈的戲法」中的「附靈轉化」時，會額外使第二枚裝入彈匣的<span style=\"color:#FFD780FF\">追影彈</span>轉化為<span style=\"color:#FFD780FF\">煥光追影彈</span>。<br/>觸發「附靈轉化」的機率增加：若隊伍中存在符合元素轉化條件的元素類型角色，則觸發「附靈轉化」的機率提升33.3%，至多提升至100%。<br/><br/>需要解鎖突破天賦「子彈的戲法」。<br/>此外，不處於戰鬥狀態下時，恰斯卡的夜魂加持狀態消耗的夜魂值與燃素降低30%。",
      "level": 1
