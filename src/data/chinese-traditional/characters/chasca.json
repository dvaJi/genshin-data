  "outfits": [
    {
      "id": 210400,
      "name": "特拉洛坎夜幽靈",
      "description": "恰斯卡的裝扮款式。血液中流淌著爭鬥之意，瞳孔裡倒映出不屈之志，超越死亡帶來的痛苦，這是特拉洛坎英雄的傲骨。",
      "isDefault": true,
      "characterName": "恰斯卡",
      "characterId": 10000104,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Chasca_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "「花羽會」，恰斯卡。有什麼「矛盾」需要我調停嗎？視情況而定可能要費點面子、花些錢酒，或者…耗幾枚子彈。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·俯瞰",
      "text": "如果迷失了方向，不如飛到高處去看看吧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·聲音",
      "text": "倘若任由深淵的聲音牽引，我早就不是我自己了。比生存更難的是克服本能。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·調解",
      "text": "最近有點生疏了…嗯…哪裡有「矛盾」可以調解一下嗎？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨水…會打濕頭髮跟羽毛，晚點要好好護理。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "啊？在這種天氣裡飛行，是想跟閃電比誰快嗎？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "起風的時候…",
      "text": "風裡有獵物的氣味…做好準備。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "風向正好——全速前進！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "「早起的絨翼龍有肉吃。」——所以我準備了一點早餐，有什麼任務都先填飽肚子再說吧。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午安。中午的日頭正盛，可以先休息一下。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚餐準備怎麼解決？不然去「花羽會」吧，宴請「強者」的酒和肉永遠都夠。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}要休息了嗎？嗯…飛了一整天，我也該保養一下我的槍械了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於恰斯卡自己·自信",
      "text": "「花羽會」曾經承擔梭巡援護納塔全境的職責，飛行隊裡更集結了全納塔最精銳、最迅猛的戰士。\\n時至今日，這股孤高與驕傲依舊銘刻在許多絨翼龍騎士的心裡…嗯？我嗎？我並不「孤傲」，只是有「自信」而已。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於恰斯卡自己·花羽會",
      "text": "…剛回「花羽會」的時候，我跟整個人類世界格格不入，像是一個突然被丟進人群的異類…但是葵可，還有她的…不，還有我們的父母，接受了那時的我。\\n跟他們相遇是值得我慶幸一生的事，所以我也會用一生…去守護他們所愛的「花羽會」。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·擺平",
      "text": "#以{F#妳}{M#你}的身手，在納塔應該不會有誰敢主動招惹。但凡事都有個萬一，如果遇上什麼不太好直接透過動手擺平的麻煩，記得來找我。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·家人",
      "text": "#柯婭的事…真是多謝了。如果那時候沒有{F#妳}{M#你}在，也不知道會怎麼收場。\\n姐姐現在已經沒那麼厭惡人類了，但要改變這麼多年來的習慣，恐怕還要花上一點時間來適應。\\n奇梅倒是很喜歡來「花羽會」玩，現在跟婭特蘭他們處得不錯…呵，有時候看著他們，就像是看到了小時候的我跟姐姐一樣。\\n最麻煩的反而是媽媽那邊…她最近總愛催我學姐姐早點築什麼巢？還說要看看身邊有什麼適合的家人？真搞不明白她是想表達什麼意思…嗯？{F#妳}{M#你}在笑什麼？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "這枚「神之眼」在我與深淵的對抗中意義重大。如果不是它及時出現，不知道現在的我會是什麼樣子。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "經常會有人覺得小時候做錯的事難以啟齒…這是為什麼呢？人類也好絨翼龍也好，不都是靠著認清過去的錯誤來成長的嗎？\\n所以我從不迴避小時候動手打架不經思考的事實。至於現在，我在拔槍前都會思考幾秒…或者零點幾秒。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#納塔有不少高聳的樹木，站在上面能獲得良好的視野和起飛高度，{F#妳}{M#你}要不要也來試試？別怕，真的掉下去了我會接住{F#妳}{M#你}的。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於卡齊娜…",
      "text": "「每隻絨翼龍在學會飛行前都曾跌落山崖。」卡齊娜的勝利不是一朝一夕突然降臨的奇蹟，而是長久努力累積出的結果。像她這樣的戰士，理應獲得更多尊重和榮譽。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於瑪拉妮…",
      "text": "瑪拉妮說我們小時候因為爭搶玩具的關係打過架，不過我已經沒什麼印象了。\\n嗯…難道是因為我小時候打過的架實在太多了？還是說那時候我想要搶奪的並不是什麼「玩具」…而是盯上了衝浪板的水上狩獵效能…\\n呵，不管是因為什麼而起，跟瑪拉妮之間的衝突，都留不到下一天。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於希諾寧…",
      "text": "希諾寧她看起來總是沒幹勁，但真要較起勁來可比誰都認真。\\n我請她幫忙打造槍械的時候沒想太多，只是給了最基本的需求，就把這事放在腦後了。等到她正式開始動工，她抓著我問了一整天平時的飛行習慣和使用預期，出了滿地的圖紙跟廢案…真沒想到我也會有比她先睏到睡著的一天。\\n後來她還硬是讓我背下了她寫的《槍械維護手冊》，說是免得我以後天天來煩她…不過她真正的意思，大概是要我「注意安全，謹慎飛行」吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於瑪薇卡…",
      "text": "有人因為我在「歸火聖夜巡禮」中的勝率高，就拿我和火神大人比較。這太片面了。如果把我比作樹梢上的一隻鷲，那火神大人便是天上的太陽。實力越強，越是知道她的深不可測。我只是贏了幾場比賽，而她…卻冠絕了整個時代。\\n——但也正因為這樣，我才能清晰地看見，自己想要飛上的高度，到底在哪裡。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於基尼奇…",
      "text": "我最早見到阿喬的時候，還以為牠跟基尼奇也是情同家人的關係，沒想到錯得離譜…原來人跟龍還能這樣相處。\\n不過阿喬會人類語言這點倒是滿讓我羨慕的，要是「媽媽」也能開口說話，我們就不用靠比劃跟猜測來聊天了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於茜特菈莉…",
      "text": "聽老爹說，當年他們請教了全納塔最富學識的長老們，來為我制定控制深淵影響的方案。當時他們各執己見、爭論不休，都沒人留意到茜特菈莉一聲不吭地走出了門。等她回來，只見她把酒和菜往自己面前一放，自顧自地吃了起來…一時間全桌人鴉雀無聲。\\n光看外表，還真難想像她有這麼高的資歷跟輩分。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於伊法…",
      "text": "葵可跟老爹經常找他討論醫術。從空中工坊回來之後，我第一時間就去找伊法來檢查姐姐的情況。但他只是看了一眼，撂下一句「沒多大問題，庫斯可能解決」就轉頭去治別的病患了…唉，事實也證明他的眼光的確精準，是我關心則亂了。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於伊安珊…",
      "text": "我一直覺得「讓自己變得更強」和「讓別人也變得更強」是兩種不同的才能。能兼具這兩者的人少之又少，伊安珊就是其一。\\n比如我就不太懂該怎麼教人。每次向飛行隊的成員講解示範時，總是要在一些簡單枯燥又顯而易見的技巧上說明半天…還會反覆被問「這麼會顯而易見呢？」\\n要是換了伊安珊來，「花羽會」每年通過飛行試煉的人大概能直接翻倍吧…可惜她的訓練項目裡向來沒有飛行。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解恰斯卡·其一",
      "text": "#身為一名調停人，我很清楚用武力無法解決所有衝突。但很多時候持有武力本身，就是讓人願意聽{F#妳}{M#你}說話的前提。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解恰斯卡·其二",
      "text": "「花羽會」的戰士向來高傲，但絨翼龍卻比他們更高傲。即使是像我這樣從小跟絨翼龍相伴著長大的人，要想登上龍背成為騎士，都要經過嚴苛的訓練，再取得絨翼龍的認可。畢竟讓實力不濟的人乘著龍飛向天空，不管是對龍還是對人而言，都是不負責任的。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解恰斯卡·其三",
      "text": "一些屢次在飛行試煉中失利，沒有獲得絨翼龍認可的人，最後會失去鬥志，放棄挑戰。這些人在「花羽會」裡會被稱作「失翼者」…不過曾經挑戰過飛行試煉的人，往往都已是出類拔萃的戰士。即便戰意一度熄滅，也終會有重燃的一天。我們會一直默默關照這些人，就像絨翼龍關照還沒學會飛行的幼龍一樣。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解恰斯卡·其四",
      "text": "我從出生起就失去了普通人應有的童年…但「媽媽」在我瀕死垂危時給了我新的生命，葵可在我迷茫不前時給了我新的信念…在我的背後，有人與龍兩個家庭，還有納塔無數生命牽繫的家庭——所以我絕不能被吞沒，「深淵」也好「苦難」也好…都由我來「超越」！"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解恰斯卡·其五",
      "text": "葵可她…希望我成為「英雄」，所以我不能為她停下腳步，不能讓自己變得軟弱…\\n可是在「遺物」爆炸，姐姐衝到我面前的時候，我…我還是忍不住會想起，失去家人的恐懼…\\n…抱歉，這些話我不知道能說給誰聽，一直試圖留在腦後…不過現在我感覺好多了。\\n既然忘不掉這股恐懼…那就試著記住它，然後…「超越」它吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "恰斯卡的愛好…",
      "text": "如果我喜歡的是「爭鬥」，就容易惹是生非；但如果我喜歡的是「調解爭鬥」，「爭鬥」就容易自己找上門…呵，玩笑而已。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "恰斯卡的煩惱…",
      "text": "深淵的力量——倒不是因為它現在會怎麼影響到我，而是因為身邊有許多人，會為了它過度地擔心我。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "小時候住在海邊，最常吃的是生魚；來「花羽會」後我最喜歡的是快火炙烤的肉排…人類跟絨翼龍的飲食區別很大，不過我不管在哪邊都吃得很開心。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "酒精含量過高的食物吧。不是因為不喜歡酒，只是飛行前要嚴格控制飲酒量，但偏偏有些食物看起來可口，氣味也被香氣掩蓋，吃進嘴裡才發現不妙。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "要是能拿這道菜下酒，調停的成功率應該能上升個三成吧？哼，美食和美酒總是讓人心情愉悅。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "滿不錯的，謝了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "嗯…難道是做給絨翼龍吃的嗎？…恐怕也不會合牠們的胃口。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#來，這把槍裡有六發子彈，其中有一發是特別的。找片空曠的地方試試槍吧，飛到天上去試的話效果更好。\\n哦？第一發就開出了特製的禮炮嗎？{F#妳}{M#你}的運氣還真不錯…這是我親手為{F#妳}{M#你}做的，為{F#妳}{M#你}的誕辰鳴炮敬禮！\\n嗯…{F#妳}{M#你}問剩下五發子彈是什麼？當然也是禮炮啊，不過是剛剛那枚之前試做的，顏色不一樣，算不上完美。來年我盡量六發都換上最好的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哦？是新的子彈？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#想要我為{F#妳}{M#你}調停什麼？部族紛爭？還是一場大戰？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "心與血都在渴望著「爭鬥」…但現在，已經能讓這種渴望為我所用了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#「有恩必報，有德必酬。」不管是在絨翼龍還是人類的世界，這都是不變不移的公理。從今以後，無論{F#妳}{M#你}想去往哪裡，我的「羽翼」與「槍火」都隨時為{F#妳}{M#你}待命。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "飛吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "喝！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "要起風了。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "全彈…發射！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "風湮狙破！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "嘯塵盡滅。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#戰利品分配不均是起衝突的一大成因。好在我用不上，{F#妳}{M#你}拿著就好。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "能用錢財調停的事都不算事——所以錢財多多益善，不是嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "唔…亮晶晶的東西…真漂亮呢。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "值得一戰…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "該認真點了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "要戰…那就來戰吧！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "…不准死！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "到我身後。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "媽…媽…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "無法…超越…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我也…墜落了嗎…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "這下麻煩了。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "…再來！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "這次又是誰在鬧事？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "今天的風聲，不太安靜呢。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "走吧，子彈已經上膛了。"
    }
  ]
}