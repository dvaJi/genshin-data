  "outfits": [
    {
      "id": 204400,
      "name": "靈魂熱望",
      "description": "辛焱的裝扮款式。裝飾有尖刺的搖滾樂手服飾。",
      "isDefault": true,
      "characterName": "辛焱",
      "characterId": 10000044,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xinyan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是辛焱，璃月港唯一的搖滾樂手，最近在想要不要去其他地方巡迴演出，目的地的話…啊，聽說{F#妳}{M#你}是走遍了很多地方的旅行者，對吧？讓我加入你們吧！去哪裡都行。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·氣勢",
      "text": "搖滾不可缺少的，就是激情——喂，別發呆了，快動起來！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·新曲",
      "text": "#要不我來彈首曲子給{F#妳}{M#你}聽，我新寫的哦？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·注目",
      "text": "快看那邊！好像有很搖滾的東西！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "這麼大的雨…可不能讓琴被淋到了啊。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "看樣子這雨一時半會不會停…嗯，但演出不會推遲！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "唔…這種天氣要怎麼吸引觀眾呢？對了！來一場「暴風雪極限耐力搖滾挑戰」怎麼樣！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "嗚哇，快找個地方躲躲，不然髮型要塌了！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早啊，我剛剛在開嗓，今天嗓子的狀態也好得很呢。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "啊，收工了收工了，哈…沒什麼事的話，我去打個盹。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#馬上就要演出了，{F#妳}{M#你}也一起來嗨嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#哦，好的，{F#妳}{M#你}先去睡吧。我嗎？我還要保養我的琴，還想改改曲子，嘿嘿，剛從舞臺下來，睡也睡不著的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於辛焱自己·兇惡",
      "text": "#{F#妳}{M#你}居然不怕我？唉，有人說，我眼神跟刀子一樣，衣服不好好穿，講話也不守規矩。他們一看到我就躲得遠遠的，唉，真是…只是風格不一樣而已，我又不是什麼怪物…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於辛焱自己·搖滾",
      "text": "搖滾是從楓丹傳過來的，算是新東西吧。不過啊，在璃月挺不受歡迎的，一般人都覺得吵吵嚷嚷，不喜歡聽。所以我啊，很感激每一個能來聽我唱歌的人，哈哈。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·觀演",
      "text": "來看我演出？哈，到前面來吧！前面的感覺更好。咳咳，那麼，璃月獨一份的搖滾現場，現在開始！"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·投緣",
      "text": "#我還在想為什麼和{F#妳}{M#你}這麼聊得來，原來{F#妳}{M#你}不是這個世界的人，那也就用不著關心這個世界的條條框框了——人生就該是這樣！繁文縟節什麼的統統閃一邊去，無拘無束，自由自在。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·邀請",
      "text": "#我想讓我搖滾的音樂元素更豐富一點。其實，{F#妳}{M#你}的節奏感很好嘛，要不要試試幫我打鼓？沒打過？唉呀，不要怯場，關鍵是氣勢。來試試看嘛，{F#妳}{M#你}絕對很有天賦的。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "會把「神之眼」的火用來給搖滾伴奏的，大概全提瓦特也就我一個。有人批評我，應該好好敬重這種力量…不過，既然神都把「神之眼」給了我，就說明他對我的用法，也是認可的吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·命名",
      "text": "#這把琴，是我親手做的哦。本來是按照楓丹的搖滾樂器來做的，但做著做著就不再是一個東西了。我一直想給它取一個好聽又好記的名字，比如「焱琴」「碎玉」「定山」什麼的，但還是差點味道…{F#妳}{M#你}有什麼好主意嗎？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什麼想要分享·宴樂",
      "text": "#欸，{F#妳}{M#你}知道「宴樂」嗎？就是有錢人在宴會上聽的曲子。一會唱這個多有本事，一會又唱那個多了不起…把音樂用成這個樣子，哎呀，一點都不搖滾。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#我最喜歡的一套演出服，是我親手用「霓裳花」織的。{F#妳}{M#你}肯定也見過那種花吧，紅得夠激情。而且，和我的搖滾也很搭呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於香菱…",
      "text": "#我經常去「萬民堂」吃宵夜，香菱如果手頭不忙，還經常跟我聊天，一直聊到很晚很晚。啊？{F#妳}{M#你}問我都點的啥？嗯…其實是香菱做啥我吃啥，哈哈。每次都不一樣，味道也千變萬化，她可以說是料理界的「搖滾明星」了！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於鍾離…",
      "text": "以前沒什麼人聽我的搖滾，有一天他突然來邀請我，說可以去他那裡試試，適合的話可以去當駐唱歌手，我心裡激動啊，終於有人理解我的音樂了！就直接答應了下來。結果去了場地才知道，他居然是那個「往生堂」的客卿…這明顯不適合啊，真是個怪人。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於凝光…",
      "text": "#{F#妳}{M#你}知道千岩軍吧？他們以前總是妨礙我，說什麼這裡也不准搭舞臺，那裡也不准，麻煩死了。咳咳，不過在我找總務司申訴之後，聽說那個「天權星」專門修訂了璃月的什麼…呃…反正是某個規則，劃定了演出專屬場地，還要申請什麼許可。哎…其實還是很麻煩，不過，好歹不用像之前一樣，被趕得到處亂跑了嘛。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於白朮…",
      "text": "白朮先生開的藥方保養嗓子效果一流，為了答謝他，我在他面前來了一段即興搖滾，結果…他養的那條蛇就暈了過去。從那以後，那條蛇看到我就一個勁地往白朮先生的衣領裡面鑽，哈哈哈。我從那以後才知道，蛇原來對震動很敏感。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於北斗…",
      "text": "她啊，說話直爽，氣量也大，聊起來特別投緣。「死兆星」號乘風破浪的故事，實在是太帥了，給了我很多搖滾的靈感。嘿嘿，我還專門寫了一首歌給他們。現在，只要我唱第一句，好多船員都能跟我唱下去，都快變成船歌啦。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於重雲…",
      "text": "他超有意思！看上去文靜內向，但有一次演出，他好像是被朋友叫過來，要跟我說什麼話。舞臺上聲音太大，我還沒聽清呢，他已經一個箭步跳上臺來和我一起唱了，還唱得特別搖滾。這就叫「人不可貌相」吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於胡桃…",
      "text": "她明明是往生堂的堂主，卻每天一副開開心心的樣子，完全不知道在想什麼。街上碰到的話，還會大大方方地和我打招呼，說什麼「喜歡玩火的人，是生意興隆的保障呢。」…呃，有、有點詭異。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於雲堇…",
      "text": "#告訴{F#妳}{M#你}個小秘密，別到處亂講哦。那個人可喜歡搖滾了，不管多忙，一周都來聽我三場，只多不少。按理說，「和裕茶館」的戲班頭牌，該喜歡什麼琴棋書畫，花鳥蟲魚才對吧？肯定是平時被憋壞了，哈哈哈。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於嘉明…",
      "text": "他第一次說我是「搖滾發燒友」的時候，我還仔細摸了摸額頭，回答他說「沒有啊」，結果他來了句「妳絕對是」，我們爭論了小半天，最後才發現是誤會，他跟我說「發燒友」就是「愛好者」的意思。哈哈哈，他可真好玩，我要把這個詞寫進歌裡！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解辛焱·其一",
      "text": "#想要瞭解我？哈，一般人看到我就躲得遠遠的了，{F#妳}{M#你}還真是奇怪。那好吧，那就…從瞭解我的搖滾開始？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解辛焱·其二",
      "text": "小時候，大人都讓我要像個女孩子，讓我學這個，學那個，但我天賦不行，總是挨罵。搖滾就不一樣，沒人教我，我也能做得很好，但卻被大人說「沒個女孩樣」，唉，這就叫成見。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解辛焱·其三",
      "text": "#{F#妳}{M#你}有注意到我今天有什麼區別嗎？其實為了見{F#妳}{M#你}，我出門之前做了面部的按摩，放鬆了眼睛和嘴，還對著鏡子練習了半小時的微笑。怎麼樣？是不是看上去沒那麼兇了？比原來更兇了？唉…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解辛焱·其四",
      "text": "#陪我練琴辛苦了！欸？差不多到中午了，來吃午飯吧，{F#妳}{M#你}的份我也準備了！喏，裡面有番茄，香腸，煎蛋…什麼？我不像是做這種事的人？別、別小看我啊！做個吃的，擺個可愛的造型，也、也沒什麼不行的吧。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解辛焱·其五",
      "text": "我很信奉搖滾的反抗精神，但我覺得這不代表我就一定要去張揚個性，我也可以有很正常的生活，可以做縫紉，可以養花養魚，可以做造型可愛的菜餚，可以喜歡任何事，還有…任何人，對吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "辛焱的愛好…",
      "text": "#愛好那當然是搖滾！{F#妳}{M#你}有沒有全情投入過某件事呢？當{F#妳}{M#你}與{F#妳}{M#你}最愛的東西合二為一，時間空間什麼的都不再重要，只需要盡情享受，盡情宣洩——對對！這樣沉醉進去的感覺，上百次上千次都不夠！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "辛焱的煩惱…",
      "text": "我每次不小心和路邊的小孩子對上眼，都會把他們嚇哭。唉，到底有沒有辦法，能讓我看起來不那麼兇啊？能想到的辦法我全試過了，都沒什麼用…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "璃港船局的午飯真的超好吃！油水很多，肉也夠，雖然菜就那麼幾樣，但我怎麼吃都吃不膩！要我說，光是為了嚐嚐他們的午飯，就值得去船局幹一天活！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我幾乎不挑食，但我討厭清湯寡水的菜。鹹就是鹹，辣就是辣，有滋有味吃起來才過癮！哪怕食材只夠做一道「珍珠翡翠白玉湯」，我也會事先備好醬料。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "身體情不自禁想要跟著律動起來。太酷了！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#味道不錯，稍微欠點「火花」…需要我幫{F#妳}{M#你}擺個盤嗎？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#{F#妳}{M#你}不介意我調點佐料，配著吃吧？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！{F#妳}{M#你}看，這是我特地做的刺繡，我參考楓丹的洋娃娃的樣子，把我們兩個紋在了上面，很可愛對吧？欸…為什麼這樣看著我呀，我、我會刺繡是很奇怪的事嗎？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "嗯！就是這樣的節奏！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "狀態火熱，期待我的下一次演出吧！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#掌握了這麼強的力量，說不定也能創作出前所未有的搖滾！謝謝{F#妳}{M#你}，我的新作不會讓{F#妳}{M#你}失望的！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#酷！我感受到{F#妳}{M#你}飽滿的「激情」了！那麼，就讓我寫一首專屬於{F#妳}{M#你}的搖滾，只為{F#妳}{M#你}而奏響吧！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "能跟上節拍嗎？"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "熱情還不夠！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "來點火花吧！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "搖滾時間到！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "為反抗高歌！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "聽我的最強音！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "為了慶祝，演奏一曲吧！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "很「搖滾」嘛！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "氣氛嗨起來了！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "都還只是前奏…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "樂感不太好啊。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "這種程度，早習慣了。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我的搖滾會支援你的。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "這可不搖滾！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "節拍…亂了。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "還不夠…激昂…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "不該…走音的。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "這可不搖滾。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "啊，我的琴！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "輪到我登場了！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "非常搖滾的選擇！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "一起演奏吧！"
    }
  ]
}