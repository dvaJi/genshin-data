  "outfits": [
    {
      "id": 207400,
      "name": "夢裡星",
      "description": "萊依拉的裝扮款式。幽深安寧的夜中，點點星光包裹著她進入最甜蜜的夢鄉——以上是萊依拉的美好願望。",
      "isDefault": true,
      "characterName": "萊依拉",
      "characterId": 10000074,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Layla_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#哈…{F#妳}{M#你}好，我是梨多梵諦學院的在讀學生萊依拉。…嗯？對不起，昨天沒睡好我現在精神有點差，{F#妳}{M#你}剛才是在說「想和我組隊」嗎？\\n沒有沒有，我不是不願意，只是怕{F#妳}{M#你}不習慣我的作息方式…那、那個…請多關照！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·注視",
      "text": "就算我們不抬頭仰望，星空也永遠注視著我們。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·夢遊",
      "text": "腿好痠…唉，大概昨天晚上又夢遊了吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·哀嘆",
      "text": "…為什麼報告和論文永遠寫不完？為什麼？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "天氣好差，今晚沒辦法觀測星空的話…唉，我的星圖課作業真的不能再拖了啊…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "雪地看起來亮晶晶的，很像天上的星星。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "太陽曬著…好睏…對，保持這個感覺，趕快找個枕頭睡一覺…我已經兩天、兩天沒有…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "白天曬，晚上冷，我、我要不行了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#{F#妳}{M#你}睡得飽嗎？要是還睏就回去再睡一下吧…我？我…習慣了…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#我在計算星軌呢，剛算到一半，午餐{F#妳}{M#你}就先吃好了…這裡的角度不太對勁吧…不、不會吧…我是從哪裡開始算錯了呢？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今晚我要早早躺到床上去，努力早點睡著。偉大的智慧之神啊，求您庇護我的睡眠。好，我要閉上眼睛。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#…哈，讓我看看她又被什麼難住了。嗯…要整理三年份的舊星表，中期報告的附錄還缺幾張星圖沒畫…好吧，從這份開始。\\n嗯，{F#妳}{M#你}怎麼來了？現在可是最重要的睡眠時間。我？我當然是在夢遊了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於萊依拉自己·理論星相學",
      "text": "按照教科書上的說法：「利用理論星相學知識解決具體生活中的麻煩，這不是我們該關心的問題。」其實我覺得還有一個重要原因…就是…嗯，成本太高。我們測算的時候，通常會動用好多台星象儀，至少要查閱一年份的星圖，才好給出一套…嚴謹的答案。但如果是為了算明天香料會不會漲價，怎麼想都不太划算吧…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於萊依拉自己·理由",
      "text": "既然有了自己喜歡又能做得好的事，就得堅持下去，哪怕這條道路特別艱辛、哪怕一路上競爭極其激烈、哪怕不一定能順利畢業、哪怕不能順利畢業的話，就要把所有的獎學金還回去…啊，不然我還是回家吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·陪伴",
      "text": "#嗯哼，我也不想熬夜補課題進度，可是誰叫她總有那麼多做不完的事。沒辦法，我當然得幫幫她囉…{F#妳}{M#你}想陪我一起嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·漫遊世界",
      "text": "#如果畢業之後，我沒有留在教令院工作，就和{F#妳}{M#你}一起去漫遊世界吧。{F#妳}{M#你}覺得怎麼樣？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "哈…是什麼在亮？我睡覺的時候忘了關燈嗎…哦，是神之眼啊，我就說嘛…欸，不對，我睡覺之前…把它放在床頭了嗎？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#我們學院主編的星表匯聚了所有生靈的命運，毫無疑問是占星知識的頂峰，第一次看到的時候我整個人都被嚇得說不出話了！欸？{F#妳}{M#你}感興趣嗎？只是簡單看看的話…我幫{F#妳}{M#你}申請吧，應該能獲得批准，應該…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "有沒有什麼能捕蟲的植物啊，快救救我吧。晚上本來就睡不著，房間裡還有小飛蟲，一直嗡嗡響個不停，但我、我怎麼找都找不到牠在哪裡…嗚嗚…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於莫娜…",
      "text": "在明論派學者的小圈子裡，阿斯托洛吉斯·莫娜·梅姬斯圖斯發表在《蒸汽鳥報》上的星相學文章名氣不小。那些文章專業性都很高，但卻能被學者之外的群體喜歡，要做到這點還是滿不容易的…欸？我把她的名字唸得很流利？因為…厲害的人…得多多尊敬。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於麗莎…",
      "text": "#啊，我知道{F#妳}{M#你}在說誰了。麗莎·敏茲，傳說中只用了兩年就學成畢業的素論派天才，要是我也能有這樣的頭腦…{F#妳}{M#你}在蒙德的時候見過她本人？真、真的嗎？她平時都是怎麼學習的？看些什麼書、做些什麼工作？我…我該從哪裡向她學起？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於多莉…",
      "text": "多、莉、嗎…我咬著牙、握緊拳頭在她那裡買過一次東西，她看我結帳很痛快，好像誤以為我是什麼有錢人，後來還一直寄商品宣傳單給我，唔…真是天大的誤會！那次購物的代價…不僅把我的獎學金墊進去了，接下來的大半年裡，我吃飯都不敢多要肉，買書還得等打折…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於賽諾…",
      "text": "「大風紀官」大人很擅長「七聖召喚」嗎…啊我是在想，有機會的話，說不定可以和他打一局。像「七聖召喚」這種牌類遊戲，熟練掌握運算技巧的人玩起來總是簡單一點，我反而…不一定…或許不會輸給他。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於坎蒂絲…",
      "text": "#我第一次夢遊醒來的時候，曾經見到過{F#妳}{M#你}描述的這個人，原來她叫坎蒂絲啊。我還記得自己醒來的那一刻…所有報告和文章都被完成了。當時的感覺就好像…好像我每天對著星空碎碎唸，終於被星星聽見了，它們派了一位使者來幫助我，嗚嗚…太感動了！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於艾爾海森…",
      "text": "職務達到書記官這種高度的人，應該就不用煩惱能不能立項、能不能成功了吧。不對，既然都當了書記官，應該連研究項目都不用做了。真好啊…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "偉大的智慧之神，我最近每晚都在熬夜複習，考試就請讓我通過吧！拜託了拜託了…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於琺露珊…",
      "text": "琺露珊老師招到學生了嗎？聽知論派的人說，她的計畫申請經費一直很難，招不到學生也很正常。唉…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解萊依拉·其一",
      "text": "#我不算有天賦，領悟力也不太好…是拚命讀書通過考試才進了教令院。對不起，我…我先不跟{F#妳}{M#你}閒聊了，一說到教令院我就想起來，我的課題進度報告…到現在為止還沒有進度呢。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解萊依拉·其二",
      "text": "#我和導師的關係嗎？嗯…怎麼說呢…啊，{F#妳}{M#你}不要誤會了，其實導師對我滿好的，我入學的時候還得到了她的推薦呢。每次我覺得自己要撐不住了，她都會鼓勵我，然後順便多要求一篇論文…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解萊依拉·其三",
      "text": "#整個須彌最有才能的人幾乎都到教令院來了，而且這裡還有那麼多聰明得讓人發抖的外國學者，{F#妳}{M#你}想想，這裡的競爭該有多大！和這些人一起學習…我真的夠格嗎？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解萊依拉·其四",
      "text": "#噓，小聲點，不要吵醒她，就讓她安心睡上一覺吧。{F#妳}{M#你}問我嘴裡的「她」是誰？噢，當然是每天為課業傷腦筋的萊依拉呀。那我是誰？呵呵，我也是萊依拉呀。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解萊依拉·其五",
      "text": "#我聽別人提過，她好像以為所有寫不完的課業總能在一場夢之後自動完成，都是「星空的賜福」。她呀，完全搞錯囉…不過，{F#妳}{M#你}可別告訴她喔。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "萊依拉的愛好…",
      "text": "畫星圖真的是件累人的事，如果不是因為喜歡，我恐怕也堅持不下來。一下子要用尺、一下子要拿紙算、一下子要查歷年的星象…不知不覺一天時間就過去了。但看著畫得整整齊齊的巨大星圖，總是很有成就感。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "萊依拉的煩惱…",
      "text": "從前我還沒進入教令院的時候，睡眠品質還算過得去。但自從在這裡唸書之後…唔，壓力實在是太恐怖了…我真的很想每天安安穩穩一覺到天亮，嗚嗚…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "每晚我躺上床之前，都會為自己熱一杯牛奶喝，希望夜裡能有個好覺…希望夜裡能有個好覺…希望夜裡能有個好覺…"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "有一次，我聽人說，有個神奇商人在賣的「睡眠軟糖」很有效。我花光了獎學金和存下的零用錢試了試，確實有效，那陣子我也睡得很好。但一盒賣二十萬摩拉…實在太貴了，我、我絕對不會再買了，買一送一也不行…買一送二的話…我就再考慮考慮。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#好厲害，好羡慕，{F#妳}{M#你}還真是什麼都會呀。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "…嗯，味道還算不錯。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "不然…我們還是去店裡買外帶吧？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂，我把這個袖珍星盤送給{F#妳}{M#你}。希望從過去到未來，見證了我們所有人類命運的星星能把目光分給{F#妳}{M#你}，伴隨{F#妳}{M#你}走過沙漠、穿過海洋，到達{F#妳}{M#你}所探尋的終點。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "萊依拉啊萊依拉，妳還要更勤奮。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "萊依拉啊萊依拉，妳已經很勤奮了，不過妳的知識還不夠全面。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "萊依拉啊萊依拉，妳讀書又勤奮又廣博，這很好。但妳可千萬不能鬆懈，一時懈怠，就會落後於人，最後悲慘延畢。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "萊依拉啊萊依拉，要相信自己，也要相信幫了妳那麼多的那個人。妳們一起，什麼問題都能解決！\\n呼…好了，所有擔心我都拋到腦後了，我們出發吧！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "寒星！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "拒絕打擾！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "星星的加護。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "星辰，為我降下。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "極寒，任我驅使。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "別害怕。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "性價比不錯。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#還是{F#妳}{M#你}眼睛尖。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "哇！突然感覺不睏了。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我好睏…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "完了完了完了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "現在逃還來得及嗎？"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "醒醒，別昏過去！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "糟了糟了，你、你受傷了！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "永恆的睡眠…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "老師，對不起…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "拜託了，這是個…夢…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "你不講理！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "這是違反規定的！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "睡不著就四處走走吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "請好假了…沒有忘記的吧？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "唉，腦袋空空，出去放鬆。"
    }
  ]
}