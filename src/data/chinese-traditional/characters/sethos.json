  "outfits": [
    {
      "id": 209700,
      "name": "金沙行者",
      "description": "賽索斯的裝扮款式。沙黃色的衣襟象徵著養育他的廣闊沙海，亦是他信仰的一部分。",
      "isDefault": true,
      "characterName": "賽索斯",
      "characterId": 10000097,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sethos_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#這位{M#先生}{F#小姐}，是在叫我嗎？{F#妳}{M#你}好{F#妳}{M#你}好，我叫賽索斯。{F#妳}{M#你}呢，找我有什麼事嗎？哎呀，也不要光站著了，我知道一個適合坐下來聊天的好地方，跟我來吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·思考",
      "text": "過度思考「為什麼」很容易鑽牛角尖，不如放過自己。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·動靜",
      "text": "#{F#妳}{M#你}聽到了嗎？那邊有動靜。先下手為強，我想去湊湊熱鬧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·上學",
      "text": "教令院裡面怪人真多，搞得我都想考進去上個學了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "沙漠裡極少下雨，所以就讓我享受一下這樣的天氣吧，不用幫我撐傘啦。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "糟了糟了糟了，快去地勢低的地方…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "嘶…快快快，跑起來，跑起來就不冷了！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "天氣真好，不找個地方露營太浪費了。走嗎？一起去綠洲釣魚？"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "#{F#妳}{M#你}有在沙地上畫畫過嗎？從高處看會很壯觀哦！就是要找個風小的地方。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早早早，要跟我去吃點東西嗎？我從昨晚就惦記著要做幾個烤肉卷了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "現在喝咖啡的話就沒辦法享受午覺了哦。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "雖然沙漠白天沒什麼生機，但晚上總有很好看的星星。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "睡了睡了，準備迎接明天的太陽！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於賽索斯自己·印象",
      "text": "#有些長輩說我像野生動物一樣難以控制。不是要說他們的印象有錯，但首先，想要控制別人的想法有點不太對，{F#妳}{M#你}說是吧？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於賽索斯自己·首領",
      "text": "老實說，做首領還是滿有壓力的，更不用說是在緘默之殿。不過受爺爺耳濡目染了這麼多年，我清楚那些最不能讓步的底線。而且經歷了之前的決鬥之儀，又認識了那麼多新朋友，我也明白緘默之殿之後要走的路在哪裡了。放心吧，不會搞砸的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·閒聊",
      "text": "抱著想要和對方打好關係的目的刻意談話，很容易陷入僵局。就像這樣一起走走，隨便聊聊，反而更容易熟悉起來。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·篝火",
      "text": "#夜晚的篝火，既能為人提供溫度，又能防範野獸。{F#妳}{M#你}給我的感覺就像篝火一樣。\\n說得太抽象了？唉呀，就是把{F#妳}{M#你}當朋友的意思啦。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "沙漠人獲得神之眼時，大夥都會說這是誰誰誰的恩賜，實際的人選視各自信仰而定。看一群人為了別人的神之眼爭論赫曼努比斯大人和索貝克大人究竟誰更強，怪好玩的。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "如果去沙漠旅行，夜間趕路是個不錯的選擇。氣溫的確寒冷，但可以避免在炎熱的光照下流失過多水分。多帶件衣服總比四處尋找水源方便多了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "「悼靈花」這個名字不知道是誰取的，還滿浪漫的。要是我的話，也許只會以為它是被太陽曬蔫了才垂頭喪氣的。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於賽諾…",
      "text": "賽諾很優秀，無愧於赫曼努比斯力量的傳承。作為「大風紀官」，他對知識與智慧有著至高的敬畏之心。如果教令院能與緘默之殿再次合作，有他在我會放心很多。\\n哦對了，他還有個難得的優點，就是講話很好笑。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於提納里…",
      "text": "#提納里滿厲害的。我後來才聽說他不太適應沙漠的氣候，決鬥之儀那時候完全沒看出來。我也沒想到他會寫信邀請我去化城郭做客，說是讓我有機會見見賽諾的朋友們。{F#妳}{M#你}覺得他們平常吃飯都會講那種笑話嗎？真期待！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於艾爾海森和卡維…",
      "text": "我在酒館見過他們，也在咖啡館見過…好像在大巴扎也有一次。那位建築師總是嘀嘀咕咕一些不想被別人知道的事情，但實際上嘛…欸，不是我故意偷聽，是那兩位先生湊在一起很難不引人注意吧？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於流浪者…",
      "text": "這位小兄弟，是不是外國來的留學生啊？帽子滿別緻的，有次我想湊近仔細看看，但一眨眼的功夫他就咻地一下消失了。可惜，下次不會再讓他跑了。而且聽人家說那位兄弟很有想法，我要和他多聊幾下！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於迪希雅…",
      "text": "#「熾鬃之獅」——沙漠裡人人都聽說過這個名號。{F#妳}{M#你}也知道，鍍金旅團裡不全都是好人，像迪希雅這樣正直可靠的就更少了。如果{F#妳}{M#你}要來大赤沙海探險，迪希雅是做嚮導第二好的人選。第一嘛…當然是我囉？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於坎蒂絲…",
      "text": "#{F#妳}{M#你}被坎蒂絲招待過嗎？她做的飯超大份的，連我都差點沒吃完。不過吃飯就好了，千萬別吃她的拳頭。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於琺露珊…",
      "text": "很少見到比我還自來熟的人！在教令院附近閒逛時被她當成新生，非要帶我進去參觀，還說什麼現在加入知論派就能享受二十種語言教材大禮包，包準教到會，嚇我一大跳。問了別的學生才知道這是他們院的內部笑話，根本沒有這種畢業要求。所以到底哪裡好笑？只會讓人更不想加入吧？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於妮露…",
      "text": "我是個閒不下來的人，但不介意在祖拜爾劇場多站一會，看看這位小姐的舞蹈。能夠讓人內心寧靜也是一種很難得的能力。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解賽索斯·其一",
      "text": "#想打聽事情？{F#妳}{M#你}找對人了。萬一有我不知道的東西，也可以幫{F#妳}{M#你}四處問問。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解賽索斯·其二",
      "text": "#{F#妳}{M#你}要是有什麼裝備或工具壞掉可以叫我來修。{F#妳}{M#你}問我是做什麼工作的？哎呀，當然是無業遊民了，不然哪有這麼多閒工夫做手工呢？"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解賽索斯·其三",
      "text": "我喜歡徒步旅行。提前規劃好路線、整理行囊，挑選好日子踏上旅途，這種有條不紊的感覺很不錯。當然，我不會把行程排得很滿，也要享受突如其來的邂逅嘛。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解賽索斯·其四",
      "text": "在大巴扎閒逛很好玩的喔。我會挑選各種香料混在一起，搭配現烤的肉類食用。我不會特意去記配方，所以很多時候都是「單次限定食譜」。怎麼樣，有沒有興趣吃吃看這種限時限量、獨一無二的美味？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解賽索斯·其五",
      "text": "自懂事以來我就在緘默之殿生活，老實說沒有太多的選擇。能夠承受赫曼努比斯的力量對個人而言不知是福多還是禍多，但的確為我的生活賦予了更崇高的意義。\\n人生中的遺憾有千千萬個，可以圓滿解決一件事我就很滿足了。現在我成為了緘默之殿的新首領，赫曼努比斯之力也有了適合的歸屬，爺爺應該也很欣慰吧…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "賽索斯的愛好…",
      "text": "老是待在屋子裡滿無聊的，無論天氣好壞，我都喜歡出門走走。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "賽索斯的煩惱…",
      "text": "出遠門前一定要做好準備，尤其是前往沒去過的地方。當初第一次在樹林裡過夜不知道要帶防潮墊，把我害慘了。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我喜歡調配香料，是為了能夠讓肉變得更好吃，不要本末倒置了哦。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "綠色植物是很養眼啦，但吃起來就…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#好香好香好香。我食量有點大，{F#妳}{M#你}不介意吧？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "真不錯，怎麼做的？下次徒步旅行我也弄一點帶著。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "唔…嗯…好像沒什麼味道，我再吃吃看…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#{F#妳}{M#你}的頭髮…按照沙漠人的風格編一下應該會非常好看。馬上就要步入人生新的一年了，想不想試試看新髮型？怎麼樣，交給我，保證幫{F#妳}{M#你}弄個魅力四射的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#原來{F#妳}{M#你}們都是這樣鍛煉的嗎？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "噢…原來連看三天書是這種感覺…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "厲害喔，感覺可以一口氣從阿如村跑到赤王陵。不是開玩笑哦，要試試看嗎？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#沒想到{F#妳}{M#你}會幫我到這種地步。有時太依賴古老的智慧，會讓人忘記自己和同伴本身的力量。謝謝{F#妳}{M#你}讓我回想起這些。"
    },
    {
      "id": "120001",
      "type": 2,
      "title": "普通攻擊·其一",
      "text": "小心背後！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "先手為贏。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "打擾了！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "各退一步如何？"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "眾賢的智慧。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "阿赫瑪爾的遺榮！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "抱歉，你擋路了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#快看看，有合{F#妳}{M#你}心意的東西嗎？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "是旅途中的驚喜呢。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "啊！裡面有怪物！…欸，沒上當嗎？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不會認輸的。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "還可以，再撐一下…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哎呀哎呀…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "換我了哦？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "逞什麼強啊…"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "可惜，前功盡棄…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "太陽…也會落下…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "對不起了，爺爺…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "好吧好吧。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不不不。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "哎喲，是我慢了！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "來了來了。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#好好好，聽{F#妳}{M#你}的。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "嗯，帶好行囊了。"
    }
  ]
}