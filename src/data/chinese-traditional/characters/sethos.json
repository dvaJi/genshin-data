  "passives": [
    {
      "id": "black_kites_enigma",
      "name": "黑鳶的密喻",
      "description": "瞄準射擊時，賽索斯每1點目前元素能量都將使蓄力時間減少0.285秒，依此方式，至多使蓄力時間降低至0.3秒並計入20點元素能量；發射時，若發射的是<span style=\"color:#FFD780FF\">貫影箭</span>，將消耗計入的元素能量；如果發射的是一段蓄力的箭矢，則消耗計入元素能量的50%。",
      "level": 1
    },
    {
      "id": "the_sand_kings_boon",
      "name": "砂王的賜禮",
      "description": "賽索斯獲得「熱砂炫影」效果，使<span style=\"color:#FFD780FF\">貫影箭</span>造成的傷害值提升，提升值相當於賽索斯的元素精通的700%。<br/>熱砂炫影期間滿足以下任意條件時效果將被移除：<br/>·貫影箭首次命中敵人5秒後。<br/>·4枚貫影箭命中敵人後。<br/><br/>熱砂炫影效果下的貫影箭首次命中敵人15秒後將重新獲得熱砂炫影效果。",
      "level": 4
    },
    {
      "id": "thoths_revelation",
      "name": "猿月的顯跡",
      "description": "在小地圖上顯示周圍的<span style=\"color:#FFD780FF\">須彌區域特產</span>的位置。",
      "level": 0
    }
