  "passives": [
    {
      "id": "spring_rite_of_the_chosen_one",
      "name": "獲選者的春祭",
      "description": "奧黛塔召喚<b><span style=\"color:#FFD780FF\">獨舞倒影</span></b>時，還會獲得4層<b><span style=\"color:#FFD780FF\">華彩</span></b>。",
      "level": 1
    },
    {
      "id": "pathetique_of_pateticheskaya",
      "name": "赤忱者的悲歌",
      "description": "基於奧黛塔攻擊力超過1000點的部分，每100點攻擊力都將使奧黛塔造成的星爍反應傷害額外造成原本1.5%的傷害，至多依此方式額外造成原本30%的傷害。",
      "level": 4
    },
    {
      "id": "stellar_jubilee_dance_of_aurore",
      "name": "星耀祝禮·銀曉之舞",
      "description": "處於<b><span style=\"color:#FFD780FF\">極星輝域</span></b>中時/隊伍中的角色在附近觸發星擴散反應後的8秒內，奧黛塔將分別進入<span style=\"color:#FFD780FF\">輝映·星超導</span>/<span style=\"color:#FFD780FF\">輝映·星擴散</span>狀態。<br/>隊伍中的角色觸發超導/冰元素擴散反應時，將轉為觸發星超導/星擴散反應，且基於奧黛塔的攻擊力，提升隊伍中角色造成的上述反應的基礎傷害：每100點攻擊力都將提升0.7%上述反應的基礎傷害，至多依此方式提升14%傷害。",
      "level": 0
    },
    {
      "id": "echo_of_winter_daydreams",
      "name": "迴響中的冬夢",
      "description": "在小地圖上顯示周圍的<span style=\"color:#FFD780FF\">至冬區域特產</span>的位置，在影域中亦能提供相同的佑助。<br/>在閒暇時練習舞蹈，或許還會觸發其他的效果…",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1501,
      "id": "on_this_danceless_morn_she_gazes_at_her_reflection",
      "name": "「不曾起舞的清晨，她望向倒影」",
      "description": "施放特殊元素戰技<b><span style=\"color:#FFD780FF\">柔板·破曉終奏</span></b>後，在共舞結束時，奧黛塔將對附近的敵人造成一次額外的<span style=\"color:#99FFFFFF\">冰元素範圍傷害</span>，該傷害視為：<br/>·<span style=\"color:#FFD780FF\">輝映·星超導</span>或不處於輝映狀態：相當於奧黛塔攻擊力300%的星超導反應傷害。<br/>·<span style=\"color:#FFD780FF\">輝映·星擴散</span>：相當於奧黛塔攻擊力450%的星擴散反應傷害。<br/><br/>此外，突破天賦「獲選者的春祭」獲得強化：召喚<b><span style=\"color:#FFD780FF\">獨舞倒影</span></b>時，奧黛塔將額外獲得2層<b><span style=\"color:#FFD780FF\">華彩</span></b>，且奧黛塔處於隊伍後臺時，清除<span style=\"color:#FFD780FF\">華彩</span>的速度提升至每秒2層。",
      "level": 1
    },
    {
      "_id": 1502,
      "id": "i_must_see_the_snow_swans_unseen_dream_for_myself_she_thought",
      "name": "「她想，我要見證雪鵠未見之夢」",
      "description": "突破天賦「獲選者的春祭」獲得強化：每層<b><span style=\"color:#FFD780FF\">華彩</span></b>還會使角色的攻擊力提升7%。<br/>此外，<b><span style=\"color:#FFD780FF\">獨舞倒影</span></b>在場時，若奧黛塔處於<b><span style=\"color:#FFD780FF\">輝映·星爍</span></b>狀態，<span style=\"color:#FFD780FF\">獨舞倒影</span>附近敵人的對應元素抗性還會降低20%：<br/>·<span style=\"color:#FFD780FF\">輝映·星超導</span>：<span style=\"color:#99FFFFFF\">冰元素</span>、<span style=\"color:#FFACFFFF\">雷元素</span>。<br/>·<span style=\"color:#FFD780FF\">輝映·星擴散</span>：<span style=\"color:#99FFFFFF\">冰元素</span>、<span style=\"color:#80FFD7FF\">風元素</span>。",
      "level": 2
    },
    {
      "_id": 1503,
      "id": "ill_chase_the_shouting_wind_along_climbing_alone_as_i_go",
      "name": "「我要追逐呼嘯的風，向上獨行」",
      "description": "元素戰技<color=#FFD780FF><b>柔板·幻靈夜舞</b></color>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 3
    },
    {
      "_id": 1504,
      "id": "up_up_the_long_delirious_burning_blue",
      "name": "「向上，墜往恍惚、燃燒的藍空」",
      "description": "元素爆發<span style=\"color:#FFD780FF\">疾板·蒼羽一夢</span>獲得強化：奧黛塔獲得<span style=\"color:#FFD780FF\">雪鵠之夢</span>時，還會使隊伍中附近的其他角色造成的星爍反應傷害提升，提升值相當於<span style=\"color:#FFD780FF\">雪鵠之夢</span>效果的50%。<br/><br/>此外，隊伍中的角色對敵人造成星爍反應傷害時，奧黛塔還會對敵人進行一次協同攻擊，造成一次<span style=\"color:#99FFFFFF\">冰元素範圍傷害</span>，每3.5秒至多觸發一次，該傷害視為：<br/>·<span style=\"color:#FFD780FF\">輝映·星超導</span>或不處於輝映狀態：相當於奧黛塔攻擊力66%的星超導反應傷害。<br/>·<span style=\"color:#FFD780FF\">輝映·星擴散</span>：相當於奧黛塔攻擊力99%的星擴散反應傷害。",
      "level": 4
    },
    {
