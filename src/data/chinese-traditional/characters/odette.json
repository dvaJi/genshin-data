  "outfits": [
    {
      "id": 215000,
      "name": "雪鵠之舞",
      "description": "奧黛塔的裝扮款式。製作精良的芭蕾服裝，以雪鵠為靈感來源，伴著勤懇的芭蕾舞者度過無數長夜。其上珠寶總在舞臺燈光下折射出靜雅的輝光，一如剔透的舞者本人。",
      "isDefault": true,
      "characterName": "奧黛塔",
      "characterId": 10000150,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Odette_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#…謝謝{F#妳}{M#你}的支持，簽名的後面需要什麼圖案？一片羽毛可以嗎？噢，不是粉絲。看來是我誤會了。重新自我介紹一下，奧黛塔，至冬科洛列夫茨基劇團的芭蕾舞者…依舊謝謝{F#妳}{M#你}的支持。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·忙碌",
      "text": "如果沒有別的事情的話，我先去練習舞蹈了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·簡單",
      "text": "能簡單回應的事情，不需要長篇大論。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·時間",
      "text": "時間能變成雙倍……不，三倍就好了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨滴落下時淅淅瀝瀝的聲音總能讓我感到平靜，這樣的天氣很適合獨自練舞。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "平靜而美好的時刻總是短暫的。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候…",
      "text": "至冬的雪，向來冷得刺骨，又永無盡頭。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "髮型…等一下再重新梳理吧。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "…還好不會在這種地方開見面會。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "我已經暖身完畢，隨時可以行動。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#我不需要午睡，午後這種不適合訓練的時間，我通常會看看舞劇劇本。嗯？{F#妳}{M#你}問這些信紙嗎？是沃雅妮莎塞給我的粉絲來信，她要我好好看完。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚飯時間到了嗎？等下就要登臺，吃一個水煮蛋就夠了，等今晚演出全部結束之後，再隨便吃點吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#…任務完成，訓練量達標，新舞蹈也練習完畢。表情管理有些不足，還需要再對著鏡子調整一下…已經到這個時間了嗎？{F#妳}{M#你}先休息吧，我還有安排。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於奧黛塔自己·呼嘯社",
      "text": "嚴冬計畫推行後，來劇院看演出的觀眾越來越少了。大家的生活已經跌入困境，更有危害民眾的蛀蟲，對此我無法無動於衷。我知道僅憑一己之力無法扭轉局勢，但我仍想做一些力所能及的事情。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於奧黛塔自己·記性",
      "text": "以前的記憶一直烙印在腦海中，在夜深人靜的時候，像映影一樣反覆播放…記性太好不是好事。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·寄託",
      "text": "來自他人的保護就像剛剛凝結而成的薄冰一樣，是十分脆弱的東西，我不會把希望寄託在別人身上。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·傷口",
      "text": "我對痛覺的感受很遲鈍，等我察覺傷口時，傷口已經結痂了。這樣也好。無論是練習舞蹈還是接受愚人眾特訓，都不會因為身體狀況耽誤我的行程。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「星之楔」…",
      "text": "以前，在一次訓練中，極寒凍傷了我的腿腳，讓我近乎失去知覺，最後是在「星之楔」散發出的亮光中醒來的。不過從沒有聽說「星之楔」能將人喚醒的傳聞，當時醒來是因為…我本能地想要活下去嗎…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "每一次彩排，我都會當作正式演出一樣認真對待。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "有些冰醋栗吃起來不夠甜，只要撒一些細鹽，就會變得香甜好吃了。據說是有了鹹味的襯托，甜味就會被放大。一位粉絲告訴我的。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於羅莎琳·曾經",
      "text": "羅莎琳有恩於我，但我也一度憎恨著她。她的要求非常嚴苛，在她手下訓練的那段時間，挨凍、累倒、受傷與生病都是常有的事情。曾經我天真地想，只要我能獨立站上舞臺，靠跳芭蕾舞也能養活自己和母親了，我就離開愚人眾給她看。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於羅莎琳·燃珀",
      "text": "人不在了，很多話就失去了說出口的意義。「燃珀」砸碎起來是那麼容易，卻讓誤會和傷痛顯得更加諷刺…為什麼事到如今，我們才能互相理解呢？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於「女皇」陛下…",
      "text": "「女皇」陛下是全至冬的信仰，她事務繁忙，鮮少露面。我能見到她的次數寥寥無幾，她十分莊重威嚴，她的目光不管落在哪裡，都像是萬年不化的冰雪一般冰冷但堅定。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於「少女」大人…",
      "text": "她走路的姿態好像一片羽毛在飄起飄落。任何一位舞者都會羨慕這份輕盈。沃雅妮莎也曾和我聊起過她空靈的歌聲。但我們看到與羨慕的，都是她「臺前」的模樣，我們並不了解真實的她心中是否背負著不為人知的痛苦，不是嗎？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於「僕人」大人…",
      "text": "壁爐之家的孩子們都將「僕人」大人視為「父親」。有父親庇佑的孩子，成長路上總歸會少些冰雪風雨。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於「木偶」大人…",
      "text": "從前羅莎琳參加完「木偶」大人的茶會，心情都會變得比平時更好——雖然要求依舊嚴苛，但語氣明顯緩和了許多，任何人都能察覺出來。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於沃雅妮莎·微笑",
      "text": "第一次「女皇」陛下要來科洛列夫茨基劇團看我們演出的時候，沃雅妮莎提前把這個消息告訴了我，我回答說嗯。結果她伸出食指把我的嘴角提了上去，硬是製造出一個微笑，還要我跟著她一起念：「太、好、了！」\\n我依然不覺得「女皇」陛下喜歡看到那樣的笑容。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於沃雅妮莎·看病",
      "text": "沃雅妮莎生病的時候總會纏著我，讓我陪著她一起…理由是萬一需要打針或者吃苦藥的話，她會很害怕的，所以想要緊緊抓住我的手臂。我的痛覺很不明顯，自然也不會甩開她。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於阿羅夏…",
      "text": "身為獵戶養活自己並不難，但他還是經常來劇院打零工，為了援助那些受苦的人們…我並不奇怪他會加入呼嘯社。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於米提亞…",
      "text": "這位…「粉絲」先生，他經常來劇院觀看我和沃雅妮莎的表演。但每次表演開始，他都在低著頭寫些什麼，在一眾翹首看向舞臺的觀眾中很是醒目。或許他的圍巾比他更懂得欣賞演出。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於瓦列里…",
      "text": "瓦列里少校，一位有著嚴格時間觀念的愚人眾軍官，聽說他總用一種冷靜且駭人的態度為同僚安排工作。但我們所屬不同所以鮮有交集，而且…我該做的事情並不需要任何人提醒。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於薇斯納…",
      "text": "#別因為她有對翅膀，就把她當成華麗無害的蝴蝶，那個受人簇擁的傢伙是冬契軍的總司令，冰雪之中的獵食者。{F#妳}{M#你}要擦亮眼睛，別被熱情的笑容騙了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解奧黛塔·其一",
      "text": "我的行程安排比較緊湊，等會還有訓練。請見諒。要聊天的話，我們長話短說。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解奧黛塔·其二",
      "text": "我的母親出自芭蕾世家，父親曾效力愚人眾，他們因一次演出而結緣，那是一段能讓任何聽者都露出笑容的浪漫往事。幼時，母親會帶我一起輕盈地跳舞，父親會給我買漂亮的新舞裙。我唯一的煩惱是每天到底要從糖果罐子裡選擇哪一塊。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解奧黛塔·其三",
      "text": "後來父親因公殉職的噩耗傳來，母親悲痛欲絕，在演出時摔斷了腿。糖果罐子裡所有的糖都灑了出去，而我被關在了那裡面。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解奧黛塔·其四",
      "text": "#再後來的事情，{F#妳}{M#你}也知道了。這些回憶被我咀嚼了太多次，已經不會再傷害到我了。但對抗命運過程中獲得的力量，卻是屬於我自己的。我不會忘記這一點。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解奧黛塔·其五",
      "text": "#我不想對任何粉絲說這些，好在{F#妳}{M#你}不是。我的身分已經太多了，任何一面最好都保持其應有的剔透……我會向著我心中的完美舞下去。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "奧黛塔的愛好…",
      "text": "從始至終我都很喜歡芭蕾，我會竭盡全力在這個舞臺上為觀眾帶來我能跳出的最好的舞蹈。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "奧黛塔的煩惱…",
      "text": "#說實話我一直覺得自己不太受小動物歡迎。劇院周圍經常有小貓出沒，沃雅妮莎會拉著我一起去餵牠，我一走過去，小貓就開始磨爪子…嗯？{F#妳}{M#你}說那是歡迎我的意思嗎？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "餐廳快打烊時，會半價出售當天的沙拉，從前有段時間經常吃這個。放久了的沙拉味道當然比不上新鮮的，但因為口感實在熟悉，反倒讓人安心。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "從我個人喜好上來說，並沒有難以下嚥的食物。但作為芭蕾舞者，必須在飲食上保持克制，每日飲食計畫外的食物是不推薦吃的。所以我不吃。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#這幾天演出比較多，或許……不，沒什麼。謝謝{F#妳}{M#你}，這個很美味。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "一道菜？更像…一整天的食物。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "抱歉，我在控制體重。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。不知道{F#妳}{M#你}想要怎樣的生日禮物？我收到的總是鮮花、舞鞋與音樂盒。但我猜那並不是{F#妳}{M#你}的願望。不如{F#妳}{M#你}向我許願吧，只要是我能實現的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "還欠缺了一些什麼…再加點訓練量好了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "嗯，動作更加精準了。保持這樣的訓練量。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "現在我有信心能夠完美地完成鞭轉了。不過訓練量不能減。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#「情感也是芭蕾舞不可欠缺的一部分。」現在我能理解它的含義了，謝謝{F#妳}{M#你}一直以來的陪伴和支持，今天有我的演出，這是門票。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "開始了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "冰中雪影。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "起。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "共舞時刻。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "旋轉。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "呵。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "冰封的旋律。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "鏤冰履凌。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "獻上，雪鵠的禮讚。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#我不需要這些，{F#妳}{M#你}收好。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "旅途就像練習，每一步都算數。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "努力的成果。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不足為意。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "區區小傷。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我還可以。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你還好嗎？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "換人吧。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "是我不夠努力…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "不行，要站起來才對…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "原來，還能感到疼痛…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "…嗯？"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "然後呢？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "就這樣嗎？"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "不痛不癢。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "我準備好了。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "是特邀演出嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "這次去哪裡？"
    }
  ]
}