      "filename_iconCircle": "UI_AvatarIcon_Yoimiya_Circle"
    }
  ],
  "voices": [
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "想看煙花嗎？"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "點燃引信！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "小心火燭~"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "祭典重現！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "金魚來啦！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "煙花來囉！"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "飛高高啦——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "會有煙花材料嗎？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "裡面有什麼呢？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "我來開我來開！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不妙不妙！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "出醜了啊…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "得小心起來了啊。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "換我來支援你！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "別擔心，有我在。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "一不小心就…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "玩過頭了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "祭典…結束了。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "輕一點啊。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "這下不算！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "#{F#妳}{M#你}想辦祭典嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "一起去玩吧！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "同行的夥伴增加了！"
    },
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "歡迎光臨「長野原」！我叫宵宮，有什麼需要的都可以告訴我！\\n呃…「什錦炸串」和「鳥蛋燒」…不不不，我們家不是餐廳啦，是做煙花的！嗯，就是這個，閃閃亮亮，啪啦啪啦的，小煙花~"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·煙花",
      "text": "煙花易逝，人情長存。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·講故事",
      "text": "#沒事做的話，我來跟{F#妳}{M#你}講故事吧！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·金魚",
      "text": "#{F#妳}{M#你}養過金魚嗎？很乖巧很可愛哦。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "嗚哇，煙花要濕透了！得找地方躲躲，啊，要來不及了！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "哈哈，看我搓個雪球，咻——"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "全身上下都暖暖的，好舒服啊。嗯，感覺要飄起來了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "風好大啊——聲音都被吹回來啦——！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "啊——早上好啊，早上的空氣最新鮮啦，多吸兩口就會變聰明哦。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "嗯，該吃午飯啦，欸…今天的雞蛋，是雙黃蛋呢。嘿嘿，運氣真好。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "現在是最適合測試煙花效果的時間，無論是在天上還是地上炸開都會很好看。嘿嘿，開玩笑的，我會注意安全啦。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "提問時間——！請問，當看完一整天的煙花之後，接下來要做什麼？嘿嘿，答案揭曉：當然是去夢裡看煙花啦！晚安，明天見。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於宵宮自己·家事",
      "text": "我的老爹耳朵不太好，小時候我無論對他說什麼，他都是一副笑呵呵的樣子，我就以為我說的都是對的，所以就一直說，一直說，他就一直笑。後來我才知道他笑是因為他聽不清楚，但…只要他真的很開心，那我還是會一直說給他聽。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於宵宮自己·說話",
      "text": "我不擔心什麼「禍從口出」，因為蘊含在語言中的情感是不會騙人的。就算說錯話被誤會，用更多的話去化解就好，但如果什麼都不說，對方就沒辦法瞭解你的心意，也就沒有和你拉近關係的契機了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·猜拳",
      "text": "我們來玩剪刀石頭布吧！聽我口令：剪刀、石頭、布！好欸，我贏了！我贏了！嗯？我沒變拳啊，才不會變呢。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·陪伴",
      "text": "#其實我不在意我要做什麼事，我更在意的是和我一起做事的人。比如和{F#妳}{M#你}在一起，就算只是看看風景，踢踢罐子，我都很開心。因為，跟{F#妳}{M#你}說話怎麼都說不膩嘛。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#悄悄告訴{F#妳}{M#你}一件事哦，我剛剛拿到「神之眼」的時候，我是把它當打火石來用的。我用它點過煙花燒過水，回家就把它往庫房一丟不管了。結果，還是我老爹發現，告訴我這是個特別珍貴的東西，要好好保管。哈哈…幸好沒有被神明大人收回去。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·海燈節",
      "text": "#{F#妳}{M#你}知道嗎？璃月的海燈節，有很多煙花都是從我們家訂購的。我按照要求做好，再找北斗阿姊用船送去璃月。雖然按鎖國令的規矩，我不該把這些東西往外送，但…有節日的地方，煙花一定不能缺席。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什麼想要分享·循環",
      "text": "「煙花在天空中留下的光點消失之後，會變成雨，會變成雪，重新落到地上。它們滋潤了大地，撫育了人類，為的是再一次被送上天空，重現華麗的瞬間。」在老爹講的很多很多故事裡，這是我很喜歡的一個。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什麼想要分享·光斑",
      "text": "#{F#妳}{M#你}小時候踩過地上的光斑嗎？就是陽光很好的時候，光線穿過樹葉在地上留下的那種光斑。本來以為踩了就會消失，結果它總是會跳到腳背上，我就一直踩，一直踩，試了好久也沒成功。那時候挺不甘心的，坐在小石頭上嘆氣，「唉，這個世界上居然有踩不到的東西啊…」"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "有一次夏日祭，我蹲在孩子們旁邊看他們撈金魚的時候，我突然想，有沒有可能做出一種能在水上放的煙花呢？然後，「金魚煙花」就誕生了！能在水面上游來游去，能發出七彩的光，還能吐泡泡呢，很不可思議吧！…我也沒想到我真的能成功，但這個世界上就是有很多很多不可思議的事呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於北斗…",
      "text": "稻妻鎖國之後，都是北斗阿姊幫我運煙花出去，為了給她一個驚喜，我準備了一個巨大的船型煙花。在「南十字船隊」準備離開的時候，這煙花就在他們眼前衝了出去，直飛天空。船員們都以為是船隊的船飛出去了，嚇了一大跳，但北斗阿姊特別喜歡這個創意。她告訴我，驚喜驚喜，就是要又驚又喜，哈哈。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "煙花是和將軍追求的「永恆」距離最遠的東西，她可能覺得須臾的華光對於稻妻來說沒有實際意義。唉，這就是執掌「永恆」的人難以理解的東西吧，正是因為我們都是「須臾之人」，才更需要紀念須臾的美好。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於神里綾華·認真",
      "text": "因為工作關係，她和我家有很多合作。和其他兩個奉行的人不同，她每次都會聽我把話說完，還會很認真地回答我，完全不會有不耐煩的樣子。嗯，「大家閨秀」這個詞，就是為她而生的吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於神里綾華·泡澡",
      "text": "有一次談夏日祭的事談到很晚，我們都很累了，我就邀請她去泡澡解乏。但她聽說「泡澡」是很多人泡在同一個池子裡的時候，臉一下子就紅了，那時候我才意識到，大小姐是不能使用公共浴場的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於托馬…",
      "text": "他是個很擅長說話的人，話從他的嘴裡說出來，就一定會有他的想法。雖然看似沒什麼聯繫，但繞著繞著，最後都巧妙地指向了同一個目的。嗯…總之就是和我的風格完全不一樣啦，遇到我搞不定的事，我就會請他出馬。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於八重神子…",
      "text": "有次神社祭典，綾華問我能不能為宮司大人準備玩樂用的煙花。可是…宮司大人不是要出席祭典，全程坐在神社裡嗎？然後我祭典的時候就一直看著她，想知道她要怎麼放煙花。我等啊等，等啊等，結果等來了綾華，說宮司大人特別滿意…欸？她已經放過了？難道，坐在裡面的不是她？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於荒瀧一斗·對決",
      "text": "哦，他呀。別看他長得那麼兇，他很受小孩子歡迎的。不過他的勝負心很強，每次我們一起陪孩子們玩，最後都會變成我和他一決勝負，比如一口氣喝完拉麵湯，面無表情吃酸梅什麼的，孩子們會猜我們誰會贏，還會在旁邊加油助威，哎呀，那我可不能輸了，對吧？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於荒瀧一斗·幫派",
      "text": "「荒瀧派」？欸？！原來他不是無所事事的人啊？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於楓原萬葉…",
      "text": "像我這樣沒有心事的人，就喜歡有話直說。而有心事的人，往往都喜歡說古代的詩歌或者沿途的風景，比如花與鳥，風與月，唯獨不提眼前的現實。他也是有故事的人吧。嗯，我懂的，我懂的。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "因為治安和消防問題，我經常被抓去天領奉行的屬地接受訓導。在那幫人裡，九條裟羅應該是最講道理的一個了，至少她不會在瞭解情況之前就預設我的對錯。如果我是正確的，她也會認同我的觀點，如果我錯了…嘿嘿，那就去拜託托馬幫我賠禮道歉。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於早柚…",
      "text": "#如果{F#妳}{M#你}見到她，記得告訴我哦？我很想帶她去參加祭典，給她介紹很多很多新朋友。因為我看她平時精神不是太好，如果認識一些能玩在一起的人，她應該就會慢慢活潑起來吧。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於可莉…",
      "text": "#嗯？{F#妳}{M#你}說在蒙德有個擅長製作炸彈的小孩子？唔，炸彈和煙花其實相差不大，也就是說，她是這方面的天才？真想見上一面哪。欸，但是…讓小孩子玩炸彈很危險吧？蒙德人不會擔心嗎？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於綺良良…",
      "text": "#{F#妳}{M#你}說「狛荷屋」的那位快遞員呀，她手腳很敏捷的。做煙花的時候，時常有一兩種決定顏色的素材消耗得比別的都快，這種時候，她總能很快補來新貨，幫了大忙。有次我送了她一個煙花，想要表達感謝。她卻怎麼也不敢放，說是之前被煙花的動靜嚇到過，哈哈。那就只好讓她跑到遠遠的地方，我來放給她看囉。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解宵宮·其一",
      "text": "#要聽我講故事啊？好呀好呀，這邊坐，我給{F#妳}{M#你}講講最讓我自豪的、「長野原」家的故事吧！是難得的正經話題喲。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解宵宮·其二",
      "text": "我們家有項悠久的傳統，那就是我們會給每一位來訂做煙花的客人附贈一張紙條，這張紙條只有我們家的人能看懂，上面記錄了煙花的具體配方。不管是過去了十年還是一百年，只要客人能把這張紙條帶回來，我們家就能做出和當年完全相同的煙花。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解宵宮·其三",
      "text": "最美的煙花配最棒的瞬間。那些易逝的小心情就這麼被封裝在煙花裡，以另一種形式傳承下去。紙條就像一把鑰匙，等待想要紀念過去的人來開門。那麼，「長野原」煙花匠人的工作，就是幫大家把門看好。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解宵宮·其四",
      "text": "夏日祭上每時每刻都在誕生動人的故事，在煙花下相識相知的人們慢慢成長，成熟，最終老去。當他們放起如初的煙花，天空中倒映出的依然是他們如初的模樣…煙花不是永恆的，但藏在煙花背後的美妙情感，我覺得應該和稻妻一起走向永恆。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解宵宮·其五",
      "text": "#最後的故事，就不由我來講了吧，我很想和{F#妳}{M#你}靜靜看一場煙花，把今夜的美景，還有{F#妳}{M#你}想說的話全部記錄下來。啊，不要誤會，不是到此為止的意思，而是關於我們的「故事」，從此才要開始。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "宵宮的愛好·玩耍",
      "text": "煙花！啊，這個不算嗎？那我想想，唔…這個問題好難啊，我喜歡和鄰居聊家常，也喜歡和小孩子一起逛夏日祭、游泳、摘野果，好像沒辦法挑一個特殊的出來…哦，我懂了！我喜歡的，應該就是和大家一起玩吧！"
    },
    {
      "id": "6006",
      "type": 1,
      "title": "宵宮的愛好·模仿",
      "text": "咕嚕咕嚕咕嚕，嘿！哈哈，我在學派蒙消失的動作。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "宵宮的煩惱…",
      "text": "嗯，我追讀了好長時間的小說，終於迎來了大結局，結果女主角失憶了，說好的婚禮也沒辦成…好難過，怎麼這樣！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#比起主食，我更喜歡吃點心，每次祭典的時候我都會一家一家吃過去，直到吃不下為止。對了，{F#妳}{M#你}擅長做點心嗎？我拿我做的糰子和{F#妳}{M#你}換，這幾個大的都給{F#妳}{M#你}。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "牛奶。喝了牛奶的話肚子裡面就像開煙花會一樣，劈哩啪啦的。但加了牛奶的菜或者點心我可以吃，我也不知道為什麼。可能是肚子裡的小仙靈比較挑食？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#哇，{F#妳}{M#你}做點心的手藝很不一般啊！去祭典上擺攤的話，肯定會成為最熱門的那一個吧！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "吃到了好吃的東西，人就會變得很有精神。一有精神，就想開始講故事。嗯，我來挑個故事吧！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "哎呀，肚子裡面好像有飄浮靈在上下鬧騰…這不應該呀…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日從來都不是{F#妳}{M#你}一個人的節日哦，願意為{F#妳}{M#你}送蛋糕，點蠟燭，鼓掌歡呼的人，都發自真心地感謝{F#妳}{M#你}能夠降生在這個世界上。所以，一定要熱熱鬧鬧的才好，讓所有人都有感謝{F#妳}{M#你}的機會！那麼，生日快樂！準備好了嗎？我要放煙花了！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "飛得更高，炸得更響！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "哈哈，我來試試看，直接用弓箭把煙花送上天空吧！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#難得從{F#妳}{M#你}這裡學到了這麼多戰鬥技巧，乾脆除了煙花工匠之外，我再去兼職當冒險家好了，或者…「英雄」也不錯？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#「『英雄形態』的宵宮姐姐登場！邪惡退散！正義必勝！」\\n就這麼和小孩子們介紹{F#妳}{M#你}教給我的新力量，沒問題吧？應該很帥吧。嘿嘿，如果有人欺負{F#妳}{M#你}也要告訴我哦，宵宮姐姐幫{F#妳}{M#你}出頭！"
    }
  ]
}