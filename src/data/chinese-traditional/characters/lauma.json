      "characterId": 10000119,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Lauma_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#睜開眼睛。我名菈烏瑪，此地乃霜月之光慷慨彌散的謐林。無論去往何方，皆在天目所及之處。現在，閉上眼睛，{F#妳}{M#你}不再迷路了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·月光",
      "text": "即使不在夜晚，即使看不到天空，月光也從未消散。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·動物",
      "text": "#在挪德卡萊，如果有動物的行為讓{F#妳}{M#你}不解，可以來找我。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·旅途",
      "text": "想好要去哪邊了嗎？或者，找塊草坪休息一會吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "啊，又快到草木繁茂的季節了…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "一瞬的閃耀，比月光更難捕捉…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "聽說不能長時間注視如此純粹的白，是這樣的嗎？我還滿喜歡的…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "聽奈芙爾提過世界上有像這樣的地方…原來是這般風貌。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安。月神保佑，不論日夜。"
    },
    {
      "id": "1005",
      "type": 1,
      "title": "早安…",
      "text": "#早安。月光聯繫著{F#妳}{M#你}我，不論日夜。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "…啊，我剛剛打瞌睡了嗎？抱歉。有什麼需要，請講吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今晚的月光很平靜。要一起去樹林裡走走嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "群星已互道過晚安，輪到我們了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於菈烏瑪自己·責任",
      "text": "諸律無法則為把戲，人之無心即為偽神。無論何地，人群聚集的地方都需要規則。即使是像「霜月之子」這樣有著共同信仰的地方，也必須要有屬於人的規矩。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於菈烏瑪自己·解憂",
      "text": "我本應是聽取教眾煩惱、為他人解憂的神使，但很多時候卻在聽動物們嘰嘰喳喳呢…呵呵…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·溪流",
      "text": "林間溪流總是朝向大海而行，或許我們的相遇也是既定的命運。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·草木",
      "text": "草木扎根於泥土，向上，也同時向下生長。星辰與深淵都難以窮盡，希望我們的未來亦是如此。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「月之輪」…",
      "text": "這是神明的慈悲，據稱以願望衡量。\\n為什麼說「據稱」？嗯…因為沒有地方去確認啊。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#置一盆水於月下，對其訴說{F#妳}{M#你}的快樂與煩惱吧。如果月影應邀浮現在水面，那麼{F#妳}{M#你}便得到了月光的祝福。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#想聽動物們對{F#妳}{M#你}的評價嗎？呵呵…那可能得講上好多輪月升月落。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於伊涅芙…",
      "text": "在挪德卡萊有不少經過義體改造的人，但全身都由機械構成就是別的問題了…不過轉念一想，和那些心懷不軌的人相比，如此溫和、友善、又充滿好奇心的她，反而更像理想化的人類呢。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於愛諾…",
      "text": "十分聰慧，卻又命運坎坷的孩子。她的發明幫助了許多人，挪德卡萊應當為擁有這樣的寶物感到榮幸。如果她想來霜月之坊生活，我一定會保證她營養充足，攝取足夠的新鮮蔬果與甘泉。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於菲林斯…",
      "text": "#他看起來是位很講究禮節的先生，然而動物們卻似乎畏懼著他的存在…我會保持警惕，但不想在沒有證據的前提下就對不熟悉的人妄下定論。每次他路過霜月之坊時，我都會讓他收下一份今日收穫。\\n{F#妳}{M#你}說他不是壞人，只是名字太長…嗯…真的嗎？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於奈芙爾…",
      "text": "她和我的行事風格很不一樣，但我始終認為，我們並不是無法相處的類型。\\n無論如何，月光都會庇佑她的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於雅珂達…",
      "text": "在結伴潛入試驗設計局前，我只知道她是「秘聞館」的成員，是奈芙爾值得信賴的部下。夾在奈芙爾和各種客戶之間一定很辛苦吧…我一直想好好招待她一次…呵呵，不知道奈芙爾以前是怎麼在她面前稱呼我的呢。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "雖然挪德卡萊一向人員混雜，但也很難見到比這位先生融入得更好的外鄉人了。他待人接物時有一種天然的親和力，是難能可貴的特質。記得第一次見面，他便向我稱讚「霜月之子」分發餐品的美味…雖然我不記得自己曾給過他任何食物，但奇怪的是，我並不懷疑他的誠懇。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「庫塔爾」…",
      "text": "新生的神明無法從任何地方學到與信眾共處的方法，過去的她一定很難過吧…\\n為了能找到調和這種關係的辦法，我對神明提出了近乎無禮的要求。雖然她聲稱自己的確更喜歡獨處，但我總還是懷有一絲希望，希望有朝一日「庫塔爾」與「霜月之子」——明月與仰望明月的人——能夠在同一片天空下共飲。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解菈烏瑪·其一",
      "text": "看看月亮吧。它永遠在那裡，無聲無息。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解菈烏瑪·其二",
      "text": "在很多地方，殘月都是厄運的徵兆。\\n但月亮並不是自己想要破碎的…它們也只是命運顛簸的結果。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解菈烏瑪·其三",
      "text": "有時，神的代言人需要比神本身表現得更有「神性」，這樣才能符合人們的期待。信眾對神明的任性往往表現出超脫常識的寬容，但對使節就不一樣了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解菈烏瑪·其四",
      "text": "水果放的時間稍微長一點，就會散發酒的味道。我沒有喝酒的習慣，但聞到這種氣味時總覺得會更放鬆一些…我，應該不太適合喝酒吧？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解菈烏瑪·其五",
      "text": "「霜月之子」的小孩子們很喜歡將輕薄的白紗舉過頭頂奔跑，因為大人們總是哄他們說身披白紗就像被月光照拂，一切災厄都將被隔絕在外。不過一旦過了一定年紀，大家便不再這樣嬉鬧，轉而對著夜幕下蒼白的月色禮拜。\\n我也做過嗎？當然。人都是從小孩開始，一點一點長大的。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "菈烏瑪的愛好…",
      "text": "我喜歡漆黑的夜色中，獨自一人的時光。只有風吹過樹葉的聲響，鳥獸也不再言語。這樣最安靜。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "菈烏瑪的煩惱…",
      "text": "頭頂…很重。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "無關戒律與信仰，清淡的飲食對我來說最易入口。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "油脂豐富，或者缺乏水氣的…我適應不來。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#這樣新鮮的食材，{F#妳}{M#你}費心了，就由我帶給教眾們吧——什麼，只給我嗎？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#感謝{F#妳}{M#你}的禮物，不如一起分享吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#應該有比我更需要的人，我會幫{F#妳}{M#你}留意的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#一把帶著祝福的匕首，贈與被月輝與謐林寵愛的貴客。匕首並非一定是凶物，偶爾也作為禮器在祝禱儀式中出現。\\n當然，{F#妳}{M#你}想用它做什麼都是自由的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "不可貪求捷徑…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "不可貪享力量…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "若一切都是為了與「真實」相見——"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我願意為此獻上求道者的血淚。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "蒼林的守護。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "迷途之子啊…"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "去吧。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "如月輝綻放。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "林風之頌。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "帶去我的祝福。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "願霜月如故。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "願林野如初。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "祈禱，為眾心之所向。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "對辛勞者的贈禮。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#是世界在對{F#妳}{M#你}示好。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#或許，它一直在等{F#妳}{M#你}的到來。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "呼…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "是對我的考驗…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "應當反省。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "密林的影子會為你掩護。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "送還霜月的懷抱。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "深林啊，請收下，這折斷的角冠…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "月汐的擾動，終於結束了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "無月的夜幕…降臨。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "請別這樣…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "…不義之舉。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "走吧，去月色溫柔的地方。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "聖者自會走上正途，無光亦然。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "無需顧慮，我應願而來。"
    }
  ]
}