  "passives": [
    {
      "id": "light_for_the_frosty_night",
      "name": "奉向霜夜的明光",
      "description": "菈烏瑪施放元素戰技<color=#FFD780FF><b>聖言述詠·終宵永眠</b></color>後的20秒內，將依據隊伍的<span style=\"color:#FFD780FF\">月兆</span>，分別產生不同的強化效果，不同月兆等級提供的強化效果無法疊加。<br/><br/><span style=\"color:#FFD780FF\">月兆·初輝</span><br/>隊伍中附近的所有角色觸發的綻放、超綻放、烈綻放反應造成的傷害能夠造成暴擊，暴擊率固定為15%，暴擊傷害固定為100%。該效果提供的暴擊率可以與使對應元素反應能夠造成暴擊的同類效果提供的暴擊率疊加。<br/><br/><span style=\"color:#FFD780FF\">月兆·滿輝</span><br/>隊伍中附近的所有角色造成的月綻放反應傷害，暴擊率提升10%，暴擊傷害提升20%。",
      "level": 1
    },
    {
      "id": "cleansing_for_the_spring",
      "name": "奉向甘泉的沐濯",
      "description": "菈烏瑪的每點元素精通，都會使菈烏瑪獲得以下增益效果：<br/>·元素戰技造成的傷害提升0.04%，依此方式至多提升32%。<br/>·重擊<span style=\"color:#FFD780FF\">「靈使化形」</span>的冷卻時間縮短0.02%，依此方式至多使「靈使化形」的冷卻時間縮短20%。",
      "level": 4
    },
    {
      "id": "moonsign_benediction_natures_chorus",
      "name": "月兆祝賜·千籟恩寵",
      "description": "隊伍中的角色觸發綻放反應時，將轉為觸發月綻放反應，且基於菈烏瑪的元素精通，提升隊伍中角色造成的月綻放反應的基礎傷害：每點元素精通都將提升0.0175%月綻放反應的基礎傷害，至多依此方式提升14%傷害。<br/><br/>此外，菈烏瑪在隊伍中時，隊伍的<span style=\"color:#FFD780FF\">月兆</span>將會上升一級。",
      "level": 0
    },
    {
      "id": "prayers_for_the_forest",
      "name": "奉向蒼林的禱言",
      "description": "在小地圖上顯示周圍的<span style=\"color:#FFD780FF\">挪德卡萊區域特產</span>的位置。<br/>此外，對受到月矩力影響的部分小動物，菈烏瑪似乎有著特殊的親和力…",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1191,
      "id": "o_lips_weave_me_songs_and_psalms",
      "name": "「唇啊，為我紡出歌與吟哦」",
      "description": "菈烏瑪施放元素戰技<color=#FFD780FF><b>聖言述詠·終宵永眠</b></color>或元素爆發<color=#FFD780FF><b>聖言述詠·眾心為月</b></color>後，將獲得「生之紡線」，持續20秒。<br/>持續期間，隊伍中附近的角色觸發月綻放反應時，為附近的目前場上角色恢復生命值，回復量相當於菈烏瑪元素精通的500%，該效果每1.9秒至多觸發一次。<br/>此外，菈烏瑪的靈使形態消耗的體力減少40%，最大持續時間延長5秒。",
      "level": 1
    },
    {
      "_id": 1192,
      "id": "twine_warnings_and_tales_from_the_north",
      "name": "「紡出那終北的告誡與述說」",
      "description": "元素爆發<color=#FFD780FF><b>聖言述詠·眾心為月</b></color>獲得強化：<br/>·<b><span style=\"color:#FFD780FF\">「蒼色禱歌」</span></b>的效果提升：隊伍中附近的所有角色觸發綻放、超綻放、烈綻放反應時造成的傷害額外提升，提升值相當於菈烏瑪元素精通的500%；隊伍中附近的所有角色造成的月綻放反應傷害額外提升，提升值相當於菈烏瑪元素精通的400%。<br/><br/><span style=\"color:#FFD780FF\">月兆·滿輝</span>：隊伍中附近的所有角色造成的月綻放反應傷害提升40%。",
      "level": 2
    },
    {
      "_id": 1193,
      "id": "seek_not_to_tread_the_sly_foxs_path",
      "name": "「汝、切莫貪求狡狐的小徑」",
      "description": "元素爆發<color=#FFD780FF><b>聖言述詠·眾心為月</b></color>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 3
    },
    {
      "_id": 1194,
      "id": "nor_yearn_for_the_great_bears_might",
      "name": "「汝、切莫貪戀巨熊的權柄」",
      "description": "元素戰技<color=#FFD780FF><b>聖言述詠·終宵永眠</b></color>中的<b><span style=\"color:#FFD780FF\">霜林聖域</span></b>的攻擊命中敵人時，將為菈烏瑪恢復4點元素能量，該效果每5秒至多觸發一次。",
      "level": 4
    },
    {
      "_id": 1195,
      "id": "if_truth_may_be_subject_to_witness",
      "name": "「若是得以將真實之物見證」",
      "description": "元素戰技<color=#FFD780FF><b>聖言述詠·終宵永眠</b></color>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 5
    },
    {
      "_id": 1196,
      "id": "i_offer_blood_and_tears_to_the_moonlight",
      "name": "「我願將這血與淚奉予月明」",
      "description": "<b><span style=\"color:#FFD780FF\">霜林聖域</span></b>攻擊敵人時，會額外造成一次視為月綻放反應傷害的<span style=\"color:#99FF88FF\">草元素範圍傷害</span>。該傷害基於菈烏瑪元素精通的185%，不會消耗<b><span style=\"color:#FFD780FF\">「蒼色禱歌」</span></b>，而是會使菈烏瑪獲得2層「蒼色禱歌」，並重置依此方式獲得的「蒼色禱歌」的持續時間。<br/>一次霜林聖域持續期間，該效果至多觸發8次；施放元素戰技<color=#FFD780FF><b>聖言述詠·終宵永眠</b></color>時，將清除依此方式獲得的「蒼色禱歌」。<br/><br/>此外，菈烏瑪在擁有「蒼色禱歌」的情況下進行普通攻擊時，會消耗一層「蒼色禱歌」，轉為造成相當於菈烏瑪元素精通150%的<span style=\"color:#99FF88FF\">草元素傷害</span>，該傷害視為月綻放反應造成的傷害。<br/><br/><span style=\"color:#FFD780FF\">月兆·滿輝</span>：隊伍中附近的所有角色造成的月綻放反應傷害<b><span style=\"color:#FFD780FF\">擢升</span></b>25%。",
      "level": 6
    }
  ],
