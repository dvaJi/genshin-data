    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#芭芭拉，閃耀登場~治療就交給我吧，不會讓{F#妳}{M#你}失望的！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·犯睏",
      "text": "再這樣站下去，會…想睡覺的…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·激勵",
      "text": "大家應該都在努力著，那我們也不能偷懶，對吧？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·提神秘訣",
      "text": "欸，是沒精神了嗎？嘗一嘗我做的辣味飲料吧，很提神的喔！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "這樣淋著不要緊嗎？會感冒的吧？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "嗚哇！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "欸！是雪花欸！冰冰涼涼的~！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "這樣的好天氣，嗯~適合比較明快的曲風呢！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "放心，我不會被吹走的！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安~今天也要加油呀。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "欸，想聽我唱歌…？對不起，還…還沒有到演出時間呢。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "想吃獵鹿人餐館的香辣鱸魚…可是最近的肚子，嗚…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "辛苦了！請好好休息吧。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於芭芭拉自己…",
      "text": "「指引我前進的風啊。在我困頓時給我繼續前行的力量，在我迷惑時給我辨明善惡的智慧，在我遭受不義時給我抗爭的勇氣…」…哎呀，抱歉，剛才在專心祈禱。有什麼事嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·願望",
      "text": "#我的願望，是給身邊的大家帶來笑容！只要能幫上{F#妳}{M#你}的忙，我就很開心了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·夢想",
      "text": "#謝謝{F#妳}{M#你}陪我走到現在，離我的夢想已經越來越近了呢。未來的日子，也請多多關照啦~！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "每個人都會有自己的願望。匯聚大家的願望，讓大家感到幸福，這一定，就是神給予我的使命吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "蒙德城外青青的原野，真的百看不厭。但我聽說，世界上還有藍色的樹林呢！就在海對岸的稻妻城那邊。嗯！我還得多存一點…欸？問我在存什麼？嘿嘿，是秘密哦~！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "向日葵一直對著陽光的樣子，很耀眼呢。其實，媽媽送過我一條向日葵風格的禮裙…但我什麼時候才能穿上它去演出呢？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於琴…",
      "text": "代理團長大人…騎士團的領袖，大家都很喜歡她哦。欸？問我嗎？我…我當然也非常尊敬她！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於麗莎…",
      "text": "我一直承蒙麗莎姐姐照顧呢。要是她也成為偶像的話，我絕對會全力應援，喊到嗓子啞掉…啊，這樣會嚇到別人的吧…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於安柏…",
      "text": "以前就經常看到安柏風風火火地往城外跑，偵察騎士還真是辛苦呀。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "迪盧克老爺嗎？上次在「天使的饋贈」演出，他一直皺著眉頭…是不是我唱的歌他不喜歡呢？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於溫迪…",
      "text": "溫迪的聲音很好聽！不過，他唱的歌跟我擅長的風格差異很大。我試著偷偷學過…那旋律還真是複雜呀。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於班尼特…",
      "text": "班尼特經常帶著一身傷痕來教堂…他卻一直毫不在意、大大咧咧地笑著。唔…還是應該更愛惜自己才好啊。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "父親跟著法爾伽大團長一起出遠門了，也不知道路途中會不會遇到什麼…啊，沒關係，大團長可是「北風騎士」，一定沒問題的！我…也會為他們祈禱的。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於蘿莎莉亞…",
      "text": "蘿莎莉亞修女雖然難以接近，也從不參加祈禱，但我覺得…唔，她一定是相信著風神的！不過，不過我並沒有勇氣和她交流就是了…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於諾艾爾…",
      "text": "諾艾爾實在是太可愛了！人又溫柔，還很有耐心，跟她在一起的時候，完全不會有什麼壓力…哦，對了，她做的茶點也很特別。又香，又甜，而且很健康，嘿嘿。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於塔利雅…",
      "text": "塔利雅是一位十分可靠的前輩，由他傳達的神諭，總能為大家帶來很大幫助。不過，他不喜歡待在教堂裡，經常光顧市集和酒館這樣人聲嘈雜的地方。有時想找他人都找不到…就跟蘿莎莉亞修女一樣。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解芭芭拉·其一",
      "text": "#騎士們揮劍作戰的樣子好帥啊！{F#妳}{M#你}是不是也有這種感覺？我自己也試過用劍…欸嘿嘿，可惜我在劍術上，完全沒有天賦呢。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解芭芭拉·其二",
      "text": "想要治癒大家。就是這麼簡單的心情，讓我成為了牧師。要是能幫上大家就好了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解芭芭拉·其三",
      "text": "偶像，唔…是從艾莉絲那邊瞭解到的…「優秀的偶像能夠治癒人們的心靈。」嗯，嗯，總之就是這樣啦。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解芭芭拉·其四",
      "text": "我每天都在努力，這份努力…如果能配得上蒙德城大家的信任…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解芭芭拉·其五",
      "text": "#每次演出的時候我都會想…我真的能夠治癒蒙德城裡的每個人嗎？但是看著{F#妳}{M#你}，我總覺得只要一步步向前，總有一天…欸？至少已經把{F#妳}{M#你}治癒了…？這時候不是應該說！我已經治癒很多人了嗎？！不過這樣也不錯…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "芭芭拉的愛好…",
      "text": "是大家臉上的笑容，一直在支持我。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "芭芭拉的煩惱…",
      "text": "同伴們一直在受傷…我，沒有替大家分擔痛苦的力量。但我可以盡最大的努力治療！一定，要讓大家恢復健康。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#{F#妳}{M#你}喜歡麻辣小魚乾嗎？我這還有兩條…喏，給{F#妳}{M#你}一條！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不太喜歡苦的東西，特別是…苦瓜。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "很少吃到那麼合我口味的菜餚。今天是幸運日呢！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#謝謝{F#妳}{M#你}特意做的這些，這次，是被{F#妳}{M#你}治癒了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "不、不好…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#請收下！這個是給{F#妳}{M#你}的生日禮物，專屬簽名繪喲~欸嘿，等下一首新歌，我會第一時間唱給{F#妳}{M#你}聽的！生日快樂呀！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "芭芭拉的舞步…治癒力UP！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#謝謝{F#妳}{M#你}的支持~啊，不好，好像有點太激動了…心臟怦怦跳個不停。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#請告訴我繼續變強的秘訣~欸？放心交給{F#妳}{M#你}就行？…這怎麼行，我也要一起努力！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#和{F#妳}{M#你}一起旅行，我才意識到舞臺是沒有邊界的。謝謝{F#妳}{M#你}！嘿嘿…好！一起喊出那句咒語吧！三、二、一，——芭芭拉衝呀！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "我會保護大家！"
