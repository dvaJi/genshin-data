      "id": "710001",
      "type": 2,
      "title": "衝刺結束·其一",
      "text": "呼…呼…沒問題！"
    },
    {
      "id": "710002",
      "type": 2,
      "title": "衝刺結束·其二",
      "text": "跟得上！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "想用歌聲，帶給人們同樣的驚喜。"
