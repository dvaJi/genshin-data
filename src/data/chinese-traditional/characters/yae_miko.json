  "outfits": [
    {
      "id": 205800,
      "name": "御子之諭",
      "description": "八重神子的裝扮款式。宣昭鳴神大社齋宮高貴地位的巫女服飾。願她身著此衣時的美麗容姿，像那潔白襦裙上永不凋謝的神櫻花一般駐留。",
      "isDefault": true,
      "characterName": "八重神子",
      "characterId": 10000058,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Yae_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是鳴神大社的宮司，此番造訪，自是為了確認{F#妳}{M#你}的一舉一動，此為大社詔令…呵，不用那麼緊張，場面話罷了，這樣才有正當理由休沐嘛。快，去做些有趣的事讓我看看吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·創作體裁",
      "text": "最近八重堂穿越異世的小說也太多了，哼，就對自己的世界如此不滿嗎。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·故事",
      "text": "很多人的一生，寫於紙上也不過幾行，大多都是些無聊的故事啊。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·塵世",
      "text": "於我而言，不變也是一種美好，哎呀，可塵世哪是如此不變之物。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "下起雨後，渾身的毛髮都會變得濕漉漉的…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "很多人會害怕打雷，不過我聽到雷聲只會覺得親近。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "未生靈智的小狐狸，往往會一頭栽入雪地來覓食…想看我那樣做？哼。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早，嗯？怎麼一副無精打采的樣子，沒有睡好嗎？哎呀，昨晚是去做什麼壞事了嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "嗯~傷腦筋，中午吃些什麼呢？油豆腐吃膩了，想吃點清淡的。話說好久沒見到社奉行家的小姑娘了，我們不如就去吃她做的點心吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今夜的月光如此清亮，不做些什麼真是浪費。隨我一同去月下漫步吧，不許拒絕。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "該入眠了，呵，在夜裡不聽到連綿的雷聲，甚至都會睡不安穩呢。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於八重神子自己·永恆",
      "text": "所謂的永恆，就是不再失去已擁有之物，但從別的角度說，也放棄了得到更多的可能，不過世事總是如此，沒人能夠得到全部。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於八重神子自己·趣味",
      "text": "人類很有趣，所以我才如此喜歡人類。明明生命短暫，卻能散發映晝光輝。他們之中，有些人的光芒，即使隔開久遠時間長河都不曾黯淡。閱讀這樣的人生，是一大樂事啊。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·作家",
      "text": "#無聊，這本也無聊透頂…啊呀，這些人都是為了什麼才成為作家的。欸，對了，不如{F#妳}{M#你}把自己的經歷寫下來投給八重堂吧，感覺一定能給我一點樂…一定能大受歡迎吧。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·磨損",
      "text": "#將自己封閉起來，或許會更快地遭受「磨損」。只有自己的世界，無他人作鏡以對映，可是很可怕的事…{F#妳}{M#你}我共處之時，重要的就是互相關照哦。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#{F#妳}{M#你}說…{F#妳}{M#你}很喜歡我佩戴「神之眼」的方式？真有眼光。那麼…要來摸摸看嗎？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#在油溫到八成熱時，沿鍋下豆腐，再開成小火，等到煎至金黃的時候再夾出來，熱乎乎的，這世上沒有比油豆腐更好吃的東西了。咦，做法都已經告訴{F#妳}{M#你}了，{F#妳}{M#你}怎麼還愣在這裡呢？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "雖然因為在鳴神大社，日日抬頭都能得見，有時也會覺得厭煩。不過，那棵神櫻畢竟已經是我命運所繫之物了啊。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "明明想要出來，卻一直把自己關在一心淨土裡，簡直就是自我折磨嘛…從另一個角度來說，也挺可愛的不是嗎。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於神里綾人…",
      "text": "社奉行家的那個小子啊，從小就不安分，別看他表面上笑得春風和煦，暗地裡可不知道在盤算什麼呢，令人討厭…哼，我可跟他不是一類人，哪來同類相斥的說法。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "我很喜歡社奉行家的小姑娘，任何事都安排得井井有條。不過社奉行一直都在做些吃力不討好的活，可憐，如果她不是神里家的人，我早就把她挖到八重堂了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "這塊愚笨的木頭啊，遠不如她那天狗爹爹心思活絡…哎呀，怎麼說呢，雖說木訥耿直也有木訥耿直的好處吧，不過還是希望下次不要在神社攔著我，一個勁追問影的事了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於宵宮…",
      "text": "長野原的煙花嘛，也是每年難得的值得期盼之物了。據說前些天她還大鬧天領奉行，在敷地大放煙花。呵，九條家的人恐怕氣得臉都變青了，真是可惜呀，沒能親眼看到那副場景。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於甘雨…",
      "text": "這麼說來，很久沒有見過甘雨姐姐了。稻妻尚未鎖國時，璃月與稻妻往來事務都是我與她接洽，真是相當可靠，下次若有機會去璃月，再給她帶些新鮮的海靈芝吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於珊瑚宮心海…",
      "text": "現在的巫女，一個比一個可愛。不知道這孩子跳起太平神樂之舞會是什麼樣子，說不好群魚也會跟著旋轉吧。只要她肯叫我一聲神子姐姐，呵呵…我倒有些心得願意分享。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於國崩…",
      "text": "我當時就覺得那是個麻煩，不過她卻說畢竟是自己創造之物不願出手。早知變成現在這樣，還不如當初就瞞著她處理掉算了。現在？呵…現在，已經變麻煩啦。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "他呀，鬼族的奇怪小子，呵，聽說他找了九條家不少的麻煩。天領奉行的人想要以有傷風化為由將他寫於街上的留言擦掉，是我找人保留的，呵，這麼有趣的小鬼，這些年可是難能一見了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於五郎…",
      "text": "五郎的尾巴色澤很漂亮，不過…還是我的更柔軟一些。呵…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於早柚…",
      "text": "這個子小小的孩子，躲倒是挺會躲的，鹿野奈奈經常向我抱怨，得花很多時間找她，連看小說的時間都變少了。要我說啊，或許是有人在暗中幫助早柚呢？"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於久岐忍…",
      "text": "聽說阿幸的這位妹妹很有個性，雖說出自巫女世家，卻遠離神社，學了許多門手藝，甚至去過璃月留學，最後還加入了荒瀧派…如此有趣的女孩子，應該讓阿幸幫忙引薦一下，嗯，阿幸肯定不會拒絕我的。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於綺良良…",
      "text": "最近對人類社會感興趣的妖怪真是越來越多了。這種趨勢，該說是好事嗎？我的態度？哎呀，當然是勸大家及時行樂啦。再說，乖乖掏錢請客吃飯的小後輩，誰會不喜歡呢？"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於夢見月瑞希·產業競爭",
      "text": "「焦慮勞累之人根本讀不進小說」？唉…我們「八重堂」真是失敗啊…旗下的小說還是趣味性不足，到現在為止還沒有推出足以獲得瑞希小姐認可的小說。再給我的編輯和作家一點時間吧。要是接下來的作品還是沒辦法讓瑞希店長點頭，我這個沒用的主編，就只能親自幫瑞希小姐寫一本小說囉，名字…就叫「夢貘記」好了。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於夢見月瑞希·重遇",
      "text": "瑞希剛回來稻妻那時總是一副揣著心事的樣子，明明在路上看見了我，卻還要把目光撇開…我？我當然沒有主動搭訕她——還想多看一陣子她那副彆扭的模樣呢。如果我沒想錯，等我們兩個擦肩而過之後，她還要扭過頭，瞪著眼睛瞅我兩眼…要是我這時候再回頭看她，只怕瑞希要被我嚇得露出原形，捂著耳朵飄走了。\\n不過現在嘛…她都已經會在閒事月刊的讀者來信裡挑我毛病了。食夢貘的成長，真是迅速啊。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解八重神子·其一",
      "text": "#想知道更多我的事？也不是不行，不過世事都講究一個互惠互利，想瞭解我，就拿{F#妳}{M#你}自己的事來交換如何？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解八重神子·其二",
      "text": "狐齋宮大人啊，說著出一趟遠門，就再也沒有回來。唉，我那時可一點都不想接手鳴神大社的麻煩事，她對我說，說我要是當了神社的宮司，就可以隨心所欲地吃油豆腐了。什麼糟糕的理由呀，吵吵鬧鬧的，令人頭疼的女人…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解八重神子·其三",
      "text": "#最開始建立八重堂的動機當然是為了看有趣的小說，不過到後來樂趣就變成看那些小說家殫精竭慮的樣子了。呵，{F#妳}{M#你}永遠想不出來那些人在拖稿的時候說出的理由，哎呀，比他們自己寫的小說要有趣多了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解八重神子·其四",
      "text": "無論如何，魔神皆有消亡之時。若是他們的那些故事隨時間一起散佚於天地，再無人憶起，那就太可惜了。然而，有資格寫他們故事的人，必須得有上乘的文思與筆法…如果世上沒有這樣的人，那就培養出…培養出足以書寫那些故事的作家吧。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解八重神子·其五",
      "text": "#說來，雖然看過許多人寫的小說，我自己倒是從未動筆過，寫小說畢竟還是很麻煩的事嘛。不過，如果{F#妳}{M#你}的冒險結束了，想要有人記錄{F#妳}{M#你}的故事，而我那時正好有空的話…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "八重神子的愛好…",
      "text": "我第一喜歡的是他人的故事，第二喜歡的就是看他人煩惱的神色，兩者若是在一起，哈，那可是相得益彰的有趣啊。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "八重神子的煩惱…",
      "text": "過度安穩的日子實在是太過無聊了啊…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#{F#妳}{M#你}有聽說過一物，其名為「狐狸烏龍」嗎，其實也就是加了油豆腐的烏龍麵啦。怎麼樣，油豆腐加烏龍麵，聽上去就很好吃吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "不行，醃製過的東西不行，不管是花鱂還是醃海雀，不覺得都有一股不能讓人接受的臭味嗎？本宮身為鳴神大社的宮司，怎麼能嚥下如此不潔不淨之物。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#哎呀，小傢伙，{F#妳}{M#你}對我的口味瞭解得很清楚嘛。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#既然是{F#妳}{M#你}親手做的，我就嚐嚐看吧，呵呵…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "怎麼說呢…小傢伙，需要努力的地方還有不少喔？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生辰…",
      "text": "#今日是{F#妳}{M#你}的生辰啊…\\n「凡御歲之祝禮，以徒名之令，遇其其之所求，遂其其之所願，正心明神，以受萌蔭庇佑。」好了，就這樣。祝{F#妳}{M#你}這一年能夠諸事順遂，得償所願吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "所謂巫女修行階位，在修習畢業之後，能準確開口唸誦祭言即可稱為「直階」。對於人類來說很方便，不過對狐族來說倒是最困難的一步…畢竟是狐狸嘛。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "成為宮司代理，也就是「正階」的修行可是很辛苦的，要受諸多清修戒律，修行的秘訣唯有一條，就是晚上偷偷進食時，不要被人發現。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "升為「明階」，即要求進入天地明察的境界，神通宇內，世事洞明。只要進入了這個境界，一般都會受獲神之眼，擁有遠超一般狐族的悠長壽命了哦。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "鳴神大社的「淨階」，歷來只有鳴神大社的宮司具有，僅此一位。「淨階」只是類似榮譽職位的東西，跟實力倒沒什麼關係，不過我若是自稱實力最強的「淨階」，倒也無何不可。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "律令。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "咒禁。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "敕！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "顯化。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "留形。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "真瞳顯現！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "雷霆侘寂！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "雷光淒美啊。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "有什麼有趣的東西嗎？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "就只有這些嗎…"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "快，打開來給我看看。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "這樣下去可不行啊。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "可不能再玩下去了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "好了，要認真一些了哦。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "別再勉強了。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "交給我就好。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "哎呀，玩過頭了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "結局真是糟糕啊…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "止步於此，何談永恆…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "就這樣？"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "真是麻煩。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "這時候想起我了？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "去做點有意思的事吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#好吧，既然{F#妳}{M#你}都來邀請我了…"
    }
  ]
}