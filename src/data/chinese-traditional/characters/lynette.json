  "outfits": [
    {
      "id": 208300,
      "name": "魅影貓",
      "description": "琳妮特的裝扮款式。貓藏匿在暗影中，只在牠想要現身時才走進人的視線，就像魔術助手小姐一樣，讓人捉摸不定。",
      "isDefault": true,
      "characterName": "琳妮特",
      "characterId": 10000083,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Linette_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "初次見面，我是林尼的魔術助手，工作事宜請諮詢林尼。觀看演出請諮詢售票處。找我？…請長話短說。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·喝茶",
      "text": "茶泡好了，接下來可以休息一會了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·哥哥",
      "text": "林尼好像又在說什麼奇怪的話了…真讓人放心不下。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·發呆",
      "text": "進入待機模式…希望不要有人來打擾我。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨天適合發呆…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "這麼快天晴了，可惜。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的時候…",
      "text": "唔…耳朵痛。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#冷…把{F#妳}{M#你}藏到帽子裡吧。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "陽光很好…",
      "text": "太陽底下沒有新鮮事…真是這樣嗎？"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "颳大風了…",
      "text": "風裡傳來的氣息…不，沒什麼。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安…充能尚未完成，即將再次休眠。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "我習慣工作之前喝一杯茶，能轉換心情，也能保持清醒。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#太陽下山之後，人們內心潛藏的欲望，就會浮上水面…我是說，晚上的演出會很精彩。要給{F#妳}{M#你}留票嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "快睡吧，我還要處理白天沒做完的事情…（還要把弄壞的吸塵器修好。）"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於琳妮特自己·魔術",
      "text": "表演的時候，我通常擔任林尼的助手，因為一直不說話也不做表情，有人以為我是魔術人偶…這種誤解能避免不必要的交際，倒也不錯。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於琳妮特自己·情報",
      "text": "沉默有助於集中精神，看清有用情報。曾經來看演出的某位貴客，掏出了不屬於他太太的手帕…至於情報的具體用途，嗯…就看那位大人的意思了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·傾聽",
      "text": "#我不習慣主動表達，但應該算是個不錯的聽眾。如果有什麼煩惱，就來找我吧。我會為{F#妳}{M#你}保密。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·興趣",
      "text": "#我曾經以為，金色的「太陽」和夜色的「暗影」，是無法互相理解的，但{F#妳}{M#你}身上有著奇特的複雜性，讓我產生了不必要的好奇心…今後也讓我繼續觀察{F#妳}{M#你}吧。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "比起武力，我更喜歡用自己的眼睛掌握現狀，找到適合的解決方法。不過，擁有力量就會擁有更多底牌，就能在危急情況下保護重要的人。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "泡茶是一件看似簡單實則費心的事情，茶葉的品質、茶水的溫度、沖泡的次數，只有所有的變數都控制恰當，才能泡出味道最純正的茶。要來一杯嗎？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "小動物們也會表達自己的情緒，如果仔細聆聽的話就會知道牠們現在的狀態。對於小貓來說，「喵~」比起「喵喵喵！」，前者心情比較好，這時候不管怎麼摸牠都不會逃走哦。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於林尼·默契",
      "text": "#我和林尼一直都待在一起，我們即使不開口也能明白對方的想法，所以單獨相處時，他會比平時要安靜。{F#妳}{M#你}問我他說的哪些是真話、哪些是假話？其實我都知道，但這是最高保密事項。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於林尼·擔憂",
      "text": "林尼平時總是自信不疑，做起事來游刃有餘，或者說，他讓所有人都以為他一直如此，所以在遇到麻煩的時候，他也總會想要一個人完美地解決…如果遇到這種情況，還請多多關照他吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於菲米尼…",
      "text": "他是個細膩溫柔的孩子，卻有些喜歡妄自菲薄…或許是和之前的經歷有關吧。有時候他給我的感覺就像是林尼的反面…既然兩邊都是我的家人，意見不合時，我會負責彌合分歧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於「父親」…",
      "text": "「父親」表達愛意的方式…不一定能被每個人接受，但正是因為有「父親」在，家…才得以為家。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "最高審判官總給我一種奇怪的疏離感，明明言行談吐都很謙和…還是說，他也不怎麼喜歡跟人打交道呢？不過他和美露莘們說話的時候，倒是很親切。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "芙寧娜大人的行為太難解讀了，也觀察不出什麼有用的情報，總覺得她一舉一動像是在扮演不同的人…不愧是神明，不能用普通人的角度來揣測。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "雖然是「刺玫會」的新會長，作風卻像鄰居家愛管閒事的大姐姐呢。要是「家」裡真有這麼一位姐姐就好了…啊，這話好像不太適合…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "我曾經奉命觀摩過她的決鬥，僅僅是從旁觀察，就能感覺到令人害怕的寒意…真不知道在決鬥場上直面她會是什麼感覺…嗯，希望這輩子都不要知道。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於千織…",
      "text": "我跟林尼的演出服都是請她訂製的。有一次林尼用小刀表演魔術，不小心劃到了袖口，後來被她數落了好久…真可怕。幸好每次去她店裡，都可以躲到林尼背後。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "呃…我後來也被她抓著採訪過幾次。明明被林尼拒絕了那麼多次，真是毅力可嘉…可惜她準備了這麼多問題，我一個也沒回答。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "這位香水設計師小姐的作品熱門到需要凌晨排隊搶購。但我對香水的味道太敏感，打出噴嚏來就太失禮了…所以只能繞著走。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於愛可菲…",
      "text": "嗯…看愛可菲今天的尾巴…大概是開發出讓她滿意的新甜點了，期待下次茶會。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解琳妮特·其一",
      "text": "如果要解釋魔術，就會失去看表演的樂趣，人際關係也是這樣，想瞭解我的話，不妨一點一點收集資訊，拼湊答案吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解琳妮特·其二",
      "text": "人是很複雜的生物，即便不是有意欺瞞，也會不自覺地隱藏自己的真實一面。雖然我總能注意到一些「多餘」的細節，但除非必要情況，我不會拆穿別人的偽裝。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解琳妮特·其三",
      "text": "魔術曾經是我和林尼的謀生手段，現在更多是一種便利的社會身分，以魔術表演的名義，我們就能融入這座城市，成為家的「眼睛」。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解琳妮特·其四",
      "text": "在來到新家之前，我和林尼一直到處流浪，經歷了許多艱難和危險的狀況。從那時起，我便習慣隨時注意一切危險的跡象，也逐漸學會解讀他人的所思所想。好在，如今我們擁有了一個安身之所。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解琳妮特·其五",
      "text": "#建立人際關係是一種賭局，無論掌握多少資訊，都難以預測人心的變化。一直以來我習慣待在安全的距離，但如果是{F#妳}{M#你}的話…我願意承擔輸掉的風險。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "琳妮特的愛好…",
      "text": "人的精神和弓弦一樣，如果一直繃得太緊，就會有斷裂的風險。所以在工作之外，我會做一些能放鬆神經的事情，比如泡茶、餵貓、發呆。平時心情越是平靜，就越能應對將來的危險。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "琳妮特的煩惱…",
      "text": "我不是很習慣操作機械，一旦不注意就會出現意外狀況，有一次在雨天搞壞了烘乾機…還好菲米尼很擅長修理東西。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "撬開貝殼，在新鮮貝肉上擠點檸檬汁，連餐盤都不需要了。完美。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "調味過重的食物，不行。食材就是要保留原始的口味才好。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "好吃，配方我已經記下來了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "謝謝招待。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "調味料的比例，再斟酌一下吧？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！卡片給{F#妳}{M#你}…這不是賀卡，當然沒寫東西了。寫下{F#妳}{M#你}想要的禮物，放進我的帽子裡，不管是什麼，都會為{F#妳}{M#你}準備的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感知更敏銳了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "思考速度…繼續上升。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "看到了，勝利的條件。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我竟然能獲得這樣的力量…這樣我也能站在{F#妳}{M#你}的身前了吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "一點把戲。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "在這裡。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "驚喜。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "魔術開場。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "來點燈光。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "請看這邊。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "寶物的氣息。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "不出所料。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "輕鬆到手。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "保持冷靜。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我得集中精神。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "啟動應敵模式…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "快退後。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我來吸引火力。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "我…看漏了什麼…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "魔術失誤了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "林尼…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "還好。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "啊，沒躲開。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "魔術要開演了嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "下午茶時間到了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#{F#妳}{M#你}帶路吧。"
    }
  ]
}