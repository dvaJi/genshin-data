  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#蒙德城的迪盧克，應約而來。閒聊恕不奉陪，如果{F#妳}{M#你}是想做一番大事，我倒有點興致。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·放鬆",
      "text": "偶爾悠閒一下，也不錯。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·騎士團",
      "text": "#應該換騎士團的那些家伙來陪{F#妳}{M#你}。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·行會",
      "text": "#行會裡還有很多事，{F#妳}{M#你}在這休息，我回去看看。"
    },
    {
      "id": "1106",
      "type": 1,
      "title": "閒聊·準備",
      "text": "提前做好準備，先於對方進攻吧。"
    },
    {
      "id": "1107",
      "type": 1,
      "title": "閒聊·計畫",
      "text": "休息時，也可以思考接下來的計畫。"
    },
    {
      "id": "1108",
      "type": 1,
      "title": "閒聊·提醒",
      "text": "#任何行動難免都有風險，{F#妳}{M#你}要多加小心。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候·傘",
      "text": "#我不用傘，{F#妳}{M#你}隨意。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雨的時候·清洗",
      "text": "雨嗎？可惜洗刷不了那些汙穢的心。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "只要堅信自己的道路，就無所謂天氣是晴是雨。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "呼嘯的風聲，會被用來遮掩犯罪的痕跡。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "寒暄就免了。昨夜一切平安就好。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "想試試隱藏菜單嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "夜晚到了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#嗯，下次見。我會目送{F#妳}{M#你}安全離開的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於迪盧克自己…",
      "text": "「暗夜英雄」的傳說嗎？有趣的傳言。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·需要",
      "text": "需要什麼就直說。報帳問題找埃澤。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·證明",
      "text": "#{F#妳}{M#你}已經證明了{F#妳}{M#你}的決心。那麼，也讓{F#妳}{M#你}見證一下我的意志吧。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "對於無法看清眼前道路的人來說，「神之眼」或許是神的一盞明燈。但對於有信念的人來說，只是一個可有可無的獎章罷了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "我偶爾會去「天使的饋贈」親自調酒，因為酒館是情報集中流通的地方。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "…是夜梟。在黑暗中守望、觀察的猛禽，只在最合適的時機出手，沒有任何破綻。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於凱亞…",
      "text": "凱亞嗎…那個男人說的話，只能信一半。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於麗莎…",
      "text": "麗莎，能成為騎士團內最值得仰賴的人之一。如果她願意的話。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於琴·敵人",
      "text": "無意義的瑣事，是琴最大的敵人。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於琴·職責",
      "text": "琴那無人能及的責任心，終究讓她沒能看清自己真正的職責啊。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於莫娜…",
      "text": "蒙德的土地浸潤著風神的恩澤，就不需要贊助占星術士來預測收成了吧。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於迪奧娜…",
      "text": "迪奧娜對我的態度很是生硬，我也一直沒找到合適的機會交流。如果是涉及到家族恩怨的話…嗯？不是？只是單純地討厭酒？沒想到在這蒙德，也會有討厭酒的酒保啊。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "大團長法爾伽，我能理解他的立場，卻無法認同他的做派。呵…是我多言了。我早已不是西風騎士，忘了我說的話吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於優菈…",
      "text": "我聽說過她，她有自己的理念。努力掙脫家族束縛的氣勢也值得稱道。但她…卻加入了西風騎士團。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解迪盧克·其一",
      "text": "有何貴幹？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解迪盧克·其二",
      "text": "#嗯，{F#妳}{M#你}問騎士團？哼…沒什麼可多談的，道路不同罷了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解迪盧克·其三",
      "text": "很久不和管家之外的人對弈了。難得有這份閒暇，跟我下局棋吧。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解迪盧克·其四",
      "text": "將軍。哼，但能把我逼到這個地步，還真是不簡單啊。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解迪盧克·其五",
      "text": "#{F#妳}{M#你}還不賴。無論是對弈還是戰鬥，都不乏讓人眼前一亮的表現。不…這樣的合作，對我來說也算新奇…那麼，今後也同行吧，「吾友」。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "迪盧克的愛好…",
      "text": "莊園裡的那些藝術品？那不是我的。是先父有收集的愛好。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "迪盧克的煩惱…",
      "text": "真正應當消滅的敵人，孕育罪惡的「黑暗」本身，需要用刀劍以外的方法去斬斷…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#{F#妳}{M#你}問我杯子裡的是什麼酒？葡萄汁而已，我通常喝這個。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不喜歡酒。沒什麼…我不喜歡酒的口感。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "很精緻。風味令人難忘。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "能品嚐出廚師的專注。不錯的菜餚。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "…謝謝。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂，這是屬於{F#妳}{M#你}的重要日子。說吧，{F#妳}{M#你}的心願。如果在我能力範圍之內，我會考慮的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "為了達成目標，力量是必須的。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "前方會有什麼？我很少會思考這種問題。\\n我必須前進，不論有誰阻擋在我面前。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "力量增強了…雖然還不夠，但終歸是在向前方探索。\\n在「黎明」到來之前，必須有人稍微照亮「黑暗」…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我原以為——要掃蕩罪惡的話，我必須獨自行走在長夜之中。\\n但{F#妳}{M#你}的堅持讓我意識到，我又一次錯了。「同伴」，我向{F#妳}{M#你}致以感謝。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "呵。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "哈。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "哈——！"
    },
    {
      "id": "100010",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "呵。"
    },
    {
      "id": "100011",
