  "outfits": [
    {
      "id": 207300,
      "name": "萬識一偈",
      "description": "納西妲的裝扮款式。唯有闡釋真知的讖語妙詞堪為智慧之神作飾，因此她的一切衣飾均被信徒視為聖言。",
      "isDefault": true,
      "characterName": "納西妲",
      "characterId": 10000073,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Nahida_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#初次見面，我已經注意{F#妳}{M#你}很久了。我叫納西妲。別看我像個孩子，我比任何一位大人都瞭解這個世界。所以，我可以用我的知識，換取{F#妳}{M#你}路上的見聞嗎？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·邀請",
      "text": "#不知道做什麼的話，要不要我帶{F#妳}{M#你}去走走呀？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·心事",
      "text": "#又有心事嗎？我來陪{F#妳}{M#你}一起想吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·感受",
      "text": "果然要親眼去看，才能感受到世界的美。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "快去避雨吧，小心頭頂上長出蘑菇喔。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#{F#妳}{M#你}知道嗎？雷鳴是生命的前奏，很快這片大地就會充滿生機。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "聽見了嗎？天空正對萬物輕語：「睡覺時間到了喔。」"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "天氣真好啊，暖洋洋的，我們的身邊馬上也要熱鬧起來了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起風的時候…",
      "text": "#宮殿裡是不會起風的…哦，抱歉，對{F#妳}{M#你}來說是理所當然的知識吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安，我們趕快出發吧，這世上有太多的東西都是「逾時不候」的呢。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午休時間到，我想喝樹莓薄荷飲。用兩個和太陽有關的故事跟{F#妳}{M#你}換，好不好？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "太陽下山啦，我們也該把舞臺讓給夜行的大家族了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#快去睡吧，放心，我已經為{F#妳}{M#你}準備好甜甜的夢啦。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於納西妲自己·見識",
      "text": "燼寂海啊，那裡什麼都沒有，就像蕈豬的腦子一樣空空如也，我當然知道。啊？我…我確實沒有親眼見過，那也是我所觸及不到的地方呀。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於納西妲自己·癡迷",
      "text": "神明只送給人類填飽肚子的知識，人類卻藉此製作了工具、書寫了文字、壯大了城邦，現在又放眼星辰與深淵…他們每時每刻都在創造全新的「知識」，也令我再也無法移開雙眼。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·故事集錦",
      "text": "#{F#妳}{M#你}旅途中的見聞，比我學習到的知識要精彩太多，而且我還能隨時提問，把所有的細節都瞭解到一清二楚…真是太滿足了。好了好了，別浪費時間，我們快繼續吧。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·旅行",
      "text": "#我早就不滿足於當一位聽眾了，一直都想出去看看。{F#妳}{M#你}冒險經驗這麼豐富，當我的嚮導好不好啊？{F#妳}{M#你}之後所有的故事，我都想親身感受。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#天空長出眼睛是為了見證大地的美好，而本來就擁有雙眼的人類，是在什麼模樣的情況下，才需要靠「神之眼」觀察這個世界呢？這個問題的答案，聰明的{F#妳}{M#你}能夠明白嗎？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "很多時候，我們直到經受切膚之痛，才不得不直視自身的懶惰、愚昧、魯莽或傲慢。但大可不必為此懊悔。我們無法觀測未來的所有可能性，只能靠這樣略顯笨拙的方式獲得知識。學費而已，再正常不過啦。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·未見之花",
      "text": "須彌的沙漠看起來比雨林缺乏生機，但它也承載了久遠的文明，孕育了穩定的生態。等哪天它不再和雨林吵架了，一定能開出我從來沒見過的花吧。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於賽諾·笑話",
      "text": "#他講的笑話確實深奧，還滿有趣的。嗯？{F#妳}{M#你}有哪句沒聽懂嗎？那我來解釋給{F#妳}{M#你}聽吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於賽諾·職責",
      "text": "在面對秩序與正義的衝突之時，不是每一位「大風紀官」都能得出絕對堅定的答案。他應該最清楚，妥協的結果只有無路可退，所以他現在能回到屬於他的位置上，對整個須彌而言都是一大幸事。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於提納里…",
      "text": "雨林能夠對抗「死域」的侵蝕，至今都生機煥發。巡林官們的付出舉足輕重，而提納里又是他們之中的佼佼者。只是…希望他可以稍稍溫柔一些，這樣才更有利於巡林員招賢納士嘛。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於柯萊…",
      "text": "我聽說過她的故事，她的堅韌如寶石般璀璨奪目。她經歷了太多，希望須彌的蔥綠能夠長久地庇護她，令她像普通的女孩子那樣健康成長。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於艾爾海森…",
      "text": "他擁有很超前的知識體系，並且每時每刻都在保持思考，或許這個世界上沒有什麼事能瞞過他吧。然而對智慧者而言，普通人的凡庸是一種與生俱來的錯嗎？那都是「我們」不可分割的一部分。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於妮露…",
      "text": "我曾經借用別人的身體，問她想不想讓小吉祥草王來看她的舞蹈…雖然我已經悄悄看了很多次，但按理來說，應該要我本人到場，才算是對她「花神誕祭」表演的尊重。結果我卻被委婉地拒絕了…唔，有點傷心。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於多莉…",
      "text": "#她見到我的第一句話就是，「我看上了{F#妳}{M#你}的宮殿，怎麼賣啊？」淨善宮怎麼可能賣給她呢？不過她的問題確實把我問倒了。我想了好久，也不知道淨善宮該定價多少摩拉…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於卡維…",
      "text": "#他對須彌推行智慧這一事的理解，已經非常接近本質了，很可惜的是，他掌握的真相無法成為這個國度的主流。什麼？{F#妳}{M#你}說他和艾爾海森是室友？世上居然還有這種可能性…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於琺露珊…",
      "text": "#她的身體遭受了赤王遺蹟中殘留力量的影響，就像是被時間這隻大烏龜不小心甩下了背，永遠忘在身後。如果{F#妳}{M#你}感興趣的話，應該能從她身上窺見過去須彌的一角吧。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於塵世七執政·引薦",
      "text": "#好像塵世七執政之間在很久很久以前還會定期聯絡，只是我的情況比較特殊，已經不記得這段經歷了…既然須彌的混亂告一段落，我覺得我該重新見他們一面。{F#妳}{M#你}熟識的那幾位神明，能為我引薦一下嗎？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於塵世七執政·遊戲",
      "text": "聽說玩遊戲能夠快速縮短人與人之間的距離。神也是如此吧。不如，在和大家相聚之後，我就主動提議一起玩「跳房子」…好像也不適合。弄得像是我把房門做成了小小的洞口，仗著自己的優勢欺負大家一樣。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於散兵…",
      "text": "當他自認為追尋已久的願望終於實現，他眼中所見的究竟是滿足，還是更大的空虛呢？正是因為我們不會飛，才會無比嚮往天空…讓他好好想想吧，在擁抱過空無一物的天空之後。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "#人們常說，智慧並不取決於知道什麼，而是取決於可以改變什麼。毫無疑問，那個「預言」早就刻寫在了世界樹中…明明好像一切都沒改變，但又好像什麼都已經改變了。{F#妳}{M#你}我都知道，她是聰明到可以扭轉世界命運的人呀…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於赫布里穆…",
      "text": "深淵會以最致命的形態在提瓦特顯化，在須彌是「禁忌知識」，在納塔則是魔物。正因如此，須彌的諸多經驗也無法幫助到她，對此我有些愧疚。所幸現在危機已經化解，她說會有很多納塔人到須彌遊玩，我很歡迎他們，而且已經做好準備啦。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解納西妲·其一",
      "text": "#我的過往相當單調，大概{F#妳}{M#你}聽上一陣子就會像炮魨吸水那樣打哈欠。不過好奇心是彌足珍貴的東西，我也不想浪費…既然這樣，我跟{F#妳}{M#你}分享一些我做過的夢吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解納西妲·其二",
      "text": "#我的夢中總會出現一個花盆，每次澆水施肥就會長出相同的花。對於完全確定的收穫，{F#妳}{M#你}還能享受養花的過程嗎？呵呵，對我來說，至少每次開花之後飛過的蝴蝶，都有不一樣的顏色，有時候還會有蜜蜂呢。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解納西妲·其三",
      "text": "我的夢中總會出現一個沙漏，我喜歡往裡面加一點點水，攪勻之後看它走完一次需要多長時間，和上一次又差了多少。沒有規律，也沒有意義，卻能帶走我大腦累積的疲憊。我想「什麼都沒有」正是它的樂趣所在。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解納西妲·其四",
      "text": "我的夢中總會出現一片空地，無論周遭的景色如何變化，它都會佔據最重要的位置，滿奇怪的吧？我覺得這裡曾經應該存在過什麼東西，可是就算我驅使夢境的權能也無法獲得答案。唔，夢中居然也有我不能掌控的東西…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解納西妲·其五",
      "text": "#我的夢中什麼都有，唯獨缺少來來往往的人。但在與{F#妳}{M#你}相遇之後，這裡漸漸變得熱鬧了。或許{F#妳}{M#你}在夢中扮演的是「嚮導」這樣的角色，不僅讓我的夢變得更有人情味，也帶我走出了牢籠。呵呵，走吧，接下來的旅途也請{F#妳}{M#你}引路了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "納西妲的愛好…",
      "text": "#就這麼看著{F#妳}{M#你}，算是愛好嗎？因為{F#妳}{M#你}的一舉一動都讓我很好奇啊。作為世界的旅行者，{F#妳}{M#你}從哪裡來、將到哪裡去、會遇到什麼人、戰勝什麼困難，都是我想尋求的答案。{F#妳}{M#你}不用太在意我，就讓我一直觀察{F#妳}{M#你}吧。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "納西妲的煩惱…",
      "text": "我自認為我擅長提問和回答問題，但我漸漸明白，有很多人是揣著明白裝糊塗，問題的答案並不能幫上他們的忙。是不是隨著年齡增長，大家都會失去面對質問和答案的勇氣呢…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "當然是棗椰蜜糖了，只要吃上一小塊，大腦就會劈哩啪啦地飛速運轉，沒什麼問題解決不了。唯一需要注意的是，裝蜜糖的罐子不能放在太容易伸手搆到的地方。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "那些海鮮，牠們在無邊無際的黑暗中出生，成長在我所不瞭解的海底深處。要我吃下牠們，就好像要我咽下一團髒兮兮的烏雲一樣。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#像這樣的好味道，應該被世界永久記錄下來。謝謝{F#妳}{M#你}。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#呵呵，{F#妳}{M#你}的心意我收到了，味道也可圈可點。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#…怎麼說呢？打比方的話，{F#妳}{M#你}不會讓狗狗喝蔬菜汁吧？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#我想了想，要慶祝{F#妳}{M#你}的生日，至少也要像「花神誕祭」一樣隆重…欸？太誇張了嗎？可是我都讓人準備好了，走吧走吧，僅限一次也好，絕對會讓{F#妳}{M#你}滿意的！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "變聰明啦~"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "想法變得更開闊了，天空和大海都能裝進去。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "這種感覺，就像月蓮找到了蓮葉，珊瑚真珠找到了貝殼。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#感謝{F#妳}{M#你}願意讓我成為{F#妳}{M#你}的同伴，還教會了我那麼多新的知識。我以智慧之神的名義為{F#妳}{M#你}賜福，從今往後不再會有困惑阻礙{F#妳}{M#你}的旅途。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "記住你了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "蔓延吧。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "等一下會有點痛喔。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "嘿！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "手牽手~"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "全都看見囉。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "來我家作客吧~"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "知識，與你分享。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "此即智慧之殿堂。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "好奇心值得嘉獎喔。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "是源自誰的饋贈呢？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#有{F#妳}{M#你}想要的嗎？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "換個策略吧。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "別打啦！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "這樣不太明智…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "讓我來想想辦法。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "別再硬撐了。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "生命…終有盡時…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "枯萎之刻…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我…不明白…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "好痛啊。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "被打暈了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "#我等{F#妳}{M#你}好久啦。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "沒去過的地方還有很多呢。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "又可以增長見識了。"
    }
  ]
}