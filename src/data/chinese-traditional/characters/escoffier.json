  "outfits": [
    {
      "id": 211200,
      "name": "雪酪蜜派",
      "description": "愛可菲的裝扮款式。「甜點大校」愛可菲工作服上細細縫著的飛袖，就像她本人製作的蛋糕一樣精緻，不由使人聯想到純澈而細膩的甜蜜風味。",
      "isDefault": true,
      "characterName": "愛可菲",
      "characterId": 10000112,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Escoffier_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#「技術料理」廚師、「甜點大校」愛可菲，向{F#妳}{M#你}致以問候。貴為神明座上賓的{F#妳}{M#你}，也應享用提瓦特最頂尖的美食，希望我的作品能讓{F#妳}{M#你}滿意。\\n如果對烹飪技藝有興趣，我願意與{F#妳}{M#你}分享所有心得，帶你前往廚藝奧秘的殿堂…不過，成為我的學員前，還請做好充分的心理準備，我可不接受半路退學喔！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·背景音樂",
      "text": "最近有什麼新的交響樂唱片嗎…適當更換烹飪時的背景音樂，有助於找到新的靈感，製作不同的菜餚…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·刀工",
      "text": "調味料對食材的「滲透」，是許多料理的重中之重。為此，廚師的刀工必須無比精準，最好達到外科手術的級別，勤加練習總歸不會錯。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·敏銳洞察",
      "text": "尋常可見的材料裡，也有可能隱藏著驚人的風味物質，將嗅覺、味覺和思維鍛煉得足夠敏銳，才有機會充分發掘它們…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "潮濕的空氣，綠葉和土壤的味道相融…下一頓正餐，就做「久雨蓮魚羹」好了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "雨過天晴…",
      "text": "水氣蒸發，溫度回升…這悠閒的感覺，該用怎樣的「味覺變量」去傳達呢？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "呵，希望這雪足夠潔淨，將萬物保鮮。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "明亮的陽光…「明亮」的口感，橙酸、樹莓葉沫與砂糖的混合物，或許是個新解法。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#還有點睡意嗎？早餐就該用剛出爐的「海鹽羊角麵包」、「青蜜莓蝴蝶酥」，佐上「泡泡桔果茶」！保證能喚醒{F#妳}{M#你}的活力。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午餐在歷史上有過一段不受重視的時期，但在更加追求生活品質的現代，它就像交響曲中的弦樂組，地位毋庸置疑，不能隨便應付。現在就跟我去找最新鮮的食材，做幾道份量十足的硬菜，怎麼樣？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#對於每一天的晚餐，都該拿出應對高級宴席的態度。哪怕只有兩三道菜，最晚下午三點，也該取出預處理的食材了…欸？現在已經太晚…時間可能不夠？別緊張，我又不是要催{F#妳}{M#你}下廚——這些食材我幾小時前就已經預處理好了，準備享用一頓上乘的晚宴吧！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#適量的甜點有助於提升睡眠品質，我幫{F#妳}{M#你}準備了「緋櫻烤蘋果味低糖布丁」…不用在乎體重那種虛無縹緲的數字，需要調節膳食平衡時候，我也能讓{F#妳}{M#你}吃上味道絕不妥協的健康餐！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於愛可菲自己·形式束縛",
      "text": "雖說我有著「甜點大校」的稱號，但並不代表我只會做甜點。專心致志深耕一種烹飪的廚師值得敬佩，可我不想束縛自己。只要能向極致的味覺享受發起衝擊，無論什麼形式的料理，無論用到哪個地區的食材，我都願意嘗試。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於愛可菲自己·全副武裝",
      "text": "在我的烹飪理論中，「準確提取並運用各式風味物質」是核心理念。為此，我需要各種功能的廚具。之前如果需要長期離開常駐的廚房，我得將所有廚具仔細封裝，打包至行李箱裡。那時娜維婭經常打趣，說我「像長途行軍的特巡隊一樣全副武裝」。好在，後來我委託楓丹科學院，製作了「全頻譜多重任務廚藝機關」，外出烹飪才變得方便起來…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·創新的準則",
      "text": "#暴露在空氣中的食材會變質，沐浴在陽光下的新芽會茁壯成長…人們對料理的審美，也在不斷更新與發展。經典的配方固然可貴，但不可能永遠停滯於它成名的那一刻。當然，創新也不能亂來，否則，改進的方向有可能太過離譜，產生諸如…「堇瓜奶凍通心粉」「絕雲椒椒伯爵茶」之類的奇怪作品…我希望{F#妳}{M#你}…至少{F#妳}{M#你}心中要明確這一個標準喔！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·評判的資格",
      "text": "#廚師的原則是對每位食客盡心盡力，但這也不意味著毫無原則地接受所有人的批評。有人的味覺生來粗放，有人則毫不在意菜餚的細緻風味，更別說其中隱藏著由視覺、嗅覺和味覺共同編織的心流。在我看來，唯有{F#妳}{M#你}這樣的特殊案例——見識過諸多國家的美食，貴為神明的座上賓，還有著細膩的心靈——才有資格，讓我接受所有的評判。要是{F#妳}{M#你}覺得我的哪道料理不對勁，儘管直說不用有任何顧慮！"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我對「神之眼」的原理一無所知，還好這也不妨礙我把它當成寶貴的廚具。正如我常說的，料理是一門科學。這世界上還有許多事物的風味等待揭曉…有的魔物看起來很髒，但細細切作碎末後，能夠萃取出非常不錯的調味品。如果沒有「神之眼」的力量，我想拿下它們，就要付出百倍千倍的代價了…最重要的是，能自如地運用冰元素後，冷藏食材也更方便啦！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "我背後的這個裝置呢，正式名稱是「自適應運動訊號響應型輔助機關」，與「全頻譜多重任務廚藝機關」屬於同一技術領域的產物，能對我習慣性的小動作作出回應。易於控制，幫廚的效率也無可挑剔…許多人覺得它像「尾巴」，甚至為此渲染我是「惡魔主廚」…如果惡魔的身分能讓我更方便地除掉難吃的料理…倒也不錯？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "如果順利開發出了遠在「德波大蛋糕」之上的甜品，讓芙寧娜大人滿意的話…我想去提瓦特的每個國家旅居一段時間，為那裡的神明烹製料理。如此一來，我就能找到突破自我的方向了。運氣好的話，說不定還能嚐到神明的拿手菜，獲得超脫凡塵的靈感…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於芙寧娜·初遇…",
      "text": "我剛入行時，在瓦薩里迴廊的小餐館工作。有一次，芙寧娜大人結束演出後突發奇想，隨機選了一家店用餐。我當時忙得暈頭轉向，聽說有客人想見主廚，連刀都沒放下，就匆匆去了客人的餐位，結果迎面撞上芙寧娜大人，腦袋裡一片空白…後來，我憑本能準備了一份「鈴蘭糖霜劇院蛋糕」，幸好芙寧娜大人十分滿意，還說記住了我的名字。當晚，我翻來覆去，一夜都沒睡著，結果第二天就等來了沫芒宮的特聘信…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於芙寧娜·現狀…",
      "text": "在那以後，芙寧娜大人封我為「甜點大校」，讚賞我在這個領域「能一人成軍」。為了不負這個名號，我閉關深造過一段時間，結果好像錯過了不少大事件，芙寧娜大人也搬出了沫芒宮…我不懂那些複雜的問題，但我知道芙寧娜大人永遠是我生命中最重要的貴人，只要她有需要，我隨時都會以專屬廚師的身分回到她的身邊，薪資什麼的完全無所謂！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "五歲生日的時候，爸媽第一次帶我去了德波大飯店。在飯店門口，我撿到了一頂非常漂亮的帽子，順著帽子上那種無與倫比的、熱情的玫瑰香氣，我找到了它的主人。娜維婭的氣息至今沒變，我一有空就會約她喝點下午茶，聊聊近況，嚐嚐點心，每分每秒都很開心…只可惜過了那麼多年，她那個「甜品就是越甜越好！」的口味也還是沒變…算啦，我也不打算去糾正，喜歡什麼樣的口味，總歸是自己說了算。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "對於我們廚師而言，夏洛蒂小姐稱得上是「影響力倍增者」。她貴為專業的記者，文字功底絕佳，對於菜餚風味的描寫細緻入微，配合無可挑剔的攝影技術，轉眼間就能完成一則圖文並茂的報導。如果有什麼想要宣傳的料理新品，請她第一時間來試吃，絕對不會錯。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於希格雯…",
      "text": "護士長嗎…唔…嗯…護士長的性格很棒，但她畢竟有著特殊的體質…我理解她、敬畏她，盡量探索了她的味覺世界。她值得成為映影中的傳奇主角——一位能兵不血刃，用奶昔除掉目標的刺殺高手…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "那位公爵彬彬有禮、做事穩重，是一位老學派的紳士。不過，他似乎沒有意識到「特許餐廳」的某些菜品，對我而言…是加刑。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於琳妮特…",
      "text": "說起來你可能還不知道，琳妮特也是我們「甜點茶會」上的一員喔。她跟林尼先生常來德波大飯店演出，我們也有過不少交流。一開始我還以為琳妮特有點冷淡，鼓起勇氣請她來茶會上做客之後，我才發現她的情緒豐富得就像繽紛馬卡龍…遇到喜歡的甜點就會撲扇耳朵，遇到不喜歡的就會垂下尾巴！等等…尾巴…該不會我也…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於「僕人」…",
      "text": "她的身影，我只是遠遠看過一眼，就再也忘不掉了。起初我警告自己，假如自己做的菜餚有什麼瑕疵，讓那樣的客人感到了不滿，後果的恐怖程度完全可以預見。對於不成器的學員，我有時會讓他們「想想把這種料理端給阿蕾奇諾女士的下場」。但我後來聽娜維婭說…她似乎不是特別苛刻的人？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "#{F#妳}{M#你}知道嗎？「食品調香」也是調香學的一大熱喔。向艾梅莉埃小姐諮詢了幾種香味物質的提煉方法後，我對「嗅覺與味覺的共同作用」有了更深一層的認知，說不定，以後還能開發出充分運用香味，分層影響口感的全新佳餚…她對我用科學分析料理的觀念也相當認可，真是難得啊。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於瓦雷莎…",
      "text": "瓦雷莎啊，她的水果中蘊含著「懶洋洋的陽光」，就算讓我加價20%，我都覺得很值！所以每次交易後，我都要請她飽餐一頓。她的食量出了名的驚人，但我詢問她的用餐體驗時，發現她並沒有忽視料理的細節。也就是說瓦雷莎一直「用心在吃」，我喜歡這樣的食客！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於香菱…",
      "text": "聽說璃月有句古話叫「山外有山」，香菱小姐對我而言就像是…「穿過山洞直接抵達了異世界」。她的許多烹飪技法，我聞所未聞，對食材的選擇也令人驚嘆，請我品嚐的料理更是包含著無盡的可能性，不該用傳統楓丹料理的思維去分析。遇見她以後，我更加相信了自己的判斷——絕不能把自己鎖死在廚房裡，而是要多去各地走走，充分領略並融合各地的廚藝！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解愛可菲·其一",
      "text": "對我來說，料理不只是「能量的必需品」或「營養補充物」這麼簡單，而是人生中最重要的儀式的主角。美好的料理能為人提供希望、力量和愉悅的心情。「烹飪」這件事也如詩歌中的雪翅雁一般，有著高潔的本質，需要我窮盡一生去鑽研。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解愛可菲·其二",
      "text": "很多人並不是無法理解料理中蘊含的美好，而是沒有財力或時間去品味。這就與我們廚師的使命息息相關了——不斷尋找CP值優異的食材，不斷改進食譜，將原本只有少數人能享受的奢侈品普及到每個人的餐桌上。當然，這事說來容易做起來難。我在開始學習烹飪的時候就撞得鼻青臉腫，這才讓我走上了「技術料理」的道路…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解愛可菲·其三",
      "text": "「技術料理」流派的要義，就是「分析」、「萃取」與「調和」…簡單來說，就是採用定量分析的方法，確定目標風味所需的各種物質，隨後從其他替代食材中提煉出這些原料，爭取將昂貴的料理變得平易近人。所以，我經常研究各種看似和做飯無關的機關，這些都是我的「正統廚具」。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解愛可菲·其四",
      "text": "理論上，我的「技術料理」流派不僅能在壓縮菜餚成本上發揮作用，在探索更出彩的料理時，也能充當前鋒。當然，我不會幼稚到想要成為什麼「天下第一廚師」，或拿下「最強」之類的頭銜，我的目標從一開始就很明確——讓稀世的菜餚變得不再高貴神秘，並不斷探尋地平線上的美味新巔峰。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解愛可菲·其五",
      "text": "#我最嚮往的生活，是每天都能沐浴在動聽的音樂中，驗收富含潛力的新食材，擁有充足的時間，找到耐心的冒險夥伴兼食客，去探索百萬千萬種風味物質的組合…這些都需要足夠的財力，我會為此好好賺錢。至於幫助我將一切目標食材納入囊中的助理，兼最最完美的食客，我心中已經有人選了…唔，{F#妳}{M#你}別移開目光啊！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "愛可菲的愛好…",
      "text": "#{F#妳}{M#你}應該見過許多厲害的武器工匠吧？不知道，{F#妳}{M#你}喜不喜歡…應用了多種鍛造技術，呈現出各種花紋的刀？有的像蛋糕卷的切面，有的像正在融合的果醬，有的更像寶石那樣錯落斑駁、五光十色…它們切開食材的手感也各不相同喔，有的順滑得堪比鮮奶油、有的喀嚓喀嚓節奏清晰、有的就像是提琴的琴弦在振動…各有各的享受啊！"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "愛可菲的煩惱…",
      "text": "根據一位「品牌形象顧問」的建議，我應當打造一個「富有投資價值的個人職業形象」，這樣就可以爭取到更多資源，有助於挑戰更高的料理境界…不過，我完全不擅長在鏡頭前表演，只能和他們說，「記錄我平常工作與教導學員的場景就夠了吧」…結果映影播出後，大家的關注點好像微妙地跑偏了…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#我品嚐過提瓦特絕大多數的傳統料理，現在，我更在乎菜餚中「出乎意料」和「可供挖掘」的風味搭配。要是能嚐到基於經典食譜，卻以奇妙想法對其加筆的傑作，我會相當滿意。從經驗和機率的角度來分析，在這方面潛力無限的廚師就是{F#妳}{M#你}本人了，我非常期待{F#妳}{M#你}以後的作品。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "「近似某種味道」、「馬馬虎虎」、「味道還行」…這樣的話語，在我的詞典中，只會位於「不可饒恕」的分頁。任何對風味把控不夠精確，偏離了預期目標的菜餚，都會被我倒進垃圾桶。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#嗯…嗯？嗯…{F#妳}{M#你}居然，居然這麼有天賦！我該把自己的心得盡快、全部、全心全意地教給{F#妳}{M#你}，這樣一來，{F#妳}{M#你}就能成為…沒有上限的天才廚師！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#唔…中規中矩，沒有明顯的亮點，但也沒有犯下什麼錯誤。憑{F#妳}{M#你}的才能，肯定還能讓這盤菜繼續蛻變吧？我會期待{F#妳}{M#你}全力以赴重做它的效果。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#…憑我們的關係，我就直說了喔，要是我的學員端出這樣的料理給我，我肯定會毫不猶豫地把盤子扣到他頭上！但考慮到是{F#妳}{M#你}，我會細細吃完，然後…請{F#妳}{M#你}仔細聽好我的分析，記住自己的問題，下次烹飪時認真一點，對自己和食客的味覺負責。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#尊貴的{F#妳}{M#你}，是給提瓦特帶來了獨一無二風味的「終極變量」，為{F#妳}{M#你}慶祝誕生之日的宴席，至少要有八十九道菜品——前菜就該包含四道肉菜、四道野味、四道糕點和兩道湯…不過，粗放地大吃特吃對{F#妳}{M#你}的身體和料理本身，都是一種不敬…我會將接下來的一週定為{F#妳}{M#你}的「誕生週」，來為{F#妳}{M#你}精細拆分這道宴席，每天安排十餘道精緻的料理，以便{F#妳}{M#你}能盡情享受所有美食，體會一場節奏有致的味蕾狂歡！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感官更敏銳了，食物的香氣、質感與色彩，在我的意識中加倍清晰…這很好！能幫我更為準確地烹飪。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "能力的演進，不限於力量的增長，還有對各種「變量」一絲不苟的把控…我正在這一領域不斷成長。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "我能看見…形態與風味共同作用時，張力達到極值的「黃金時間點」。風味物質傳遞與擴散時，效率最高的脈絡。甚至，咬開菜餚表面時，不同頻率的聲音訊號對味覺的細微影響…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#萬分感謝，有了{F#妳}{M#你}的支援和啟迪，現在的我，足以拿下一切潛在的食材，提取自然界中至臻的風味物質，向極致的料理發起挑戰，然後…尋找在那之後無窮無盡的，新的山峰！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "冷凍時間。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "餐前甜點。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "低溫處理。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "即興烹飪。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "順從靈感的搭配…"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "希望會有驚喜。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "如雪雁般…振翅！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "臻品呈現！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "形與味，迸發！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "嗯哼，就像驚喜餅乾。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "這食材…過期了嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "寶箱的保藏技術，很不錯。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "失誤，小失誤。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "問題不大…調整火候。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "要謹慎下刀…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "這盤菜得重做…"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "別氣餒啊！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "討厭的味道…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "失控了…"
    },
