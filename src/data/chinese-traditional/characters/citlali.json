  "outfits": [
    {
      "id": 210701,
      "name": "星與煙帷的夜語",
      "description": "茜特菈莉的裝扮款式。閒居在家的茜特菈莉偶爾會換上一身少女感十足的衣裝，屆時任何以公務為由上前叨擾的人都會遭到重擊。於是那身衣裝成為了傳聞中的凶煞之物，見到了就得盡快繞路。",
      "isDefault": false,
      "characterName": "茜特菈莉",
      "characterId": 10000107,
      "source": [],
      "filename_card": "UI_AvatarIcon_CitlaliCostumeXia_Card",
      "filename_icon": "UI_AvatarIcon_CitlaliCostumeXia",
      "filename_iconCircle": "UI_AvatarIcon_CitlaliCostumeXia_Circle",
      "filename_splash": "UI_Costume_CitlaliCostumeXia",
      "filename_sideIcon": "UI_AvatarIcon_Side_CitlaliCostumeXia"
    },
    {
      "id": 210700,
      "name": "啟明視",
      "description": "茜特菈莉的裝扮款式。薩滿是窺視過去與未來的預言者，眼睛對於他們而言有特別的象徵意義。茜特菈莉半披於身的這件長袍上編有「啟明之眼」圖案，與她的身分及品味完美契合。",
      "isDefault": true,
      "characterName": "茜特菈莉",
      "characterId": 10000107,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Citlali_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#「煙謎主」的茜特菈莉，已經透過迷煙看到了未來的道路。諸惡曜必不會傷害{F#妳}{M#你}，諸吉星必環繞{F#妳}{M#你}。{F#妳}{M#你}會擁有強大的「盟友」，請讓我也同行——呃，見到認真的我很奇怪嗎？不要用這種眼神看著我啦！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·小說",
      "text": "基、基本上八重堂出版過的小說我都看過，也、也不奇怪吧！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·喝酒",
      "text": "歲月獻給小酒杯，借錢九出十三歸。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·出神",
      "text": "「出神儀式」對旁人來說還是滿不穩定的，就不要太好奇了吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "在家裡看小說的好日子。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "今晚應該能看到星星了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "嗚啊，從來沒有見過！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "#呸——啊，我不是在隨地吐痰，我怎麼可能那麼沒有素養？是嘴裡進沙了！{F#妳}{M#你}相信我！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "啊——早安啊。上次這麼早起床都是出師以前了，獨當一面之後我都是睡到自然醒。說吧，什麼事？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午安啊。其實我還是很節制的，起床到中午的時間內是不會喝酒的…至於熬夜主持儀式結果徹夜不眠直到第二天天亮就是另一碼子事了…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好啊。納塔有些荒野晚上會有大幅度降溫，別著涼了。燃素活躍的地方倒是白天晚上都一樣——{F#妳}{M#你}沒問？沒問也給我聽好！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。今晚惡曜不顯，地靈微眠，迷煙淺睡，是個好夜晚——我的枕頭怎麼掉到地上了…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於茜特菈莉自己·蜃樓戰記",
      "text": "#哦，{F#妳}{M#你}有興趣啊？《蜃樓戰記》是稻妻八重堂中島純先生所著的幻想小說，算是八重堂活化石等級的老系列了。故事發生在名叫「葦之原」的幻想島國，大部分章節的主角都是東渡而來的貓頭道士「東之山君」——真身正是超古代諸侯東王公。小說的篇幅很長很長，中間換過三次作者，最終還是沒有揭開「方壺」的真相…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於茜特菈莉自己·終結",
      "text": "#縱使「還魂詩」可以喚回血氣之身，但星曜、太陽尚有終結，何況生命？{F#妳}{M#你}問死亡是什麼樣的？那就像是在永恆的午後，{F#妳}{M#你}騎著龍馳騁在大平原上，天際線那邊有一張看不清的臉。無論{F#妳}{M#你}速度多快，那張臉都在天邊不動——突然某一刻動了起來，以恐怖的速度向{F#妳}{M#你}迎面撞上。{F#妳}{M#你}來不及躲避，當看清那張臉時，一切都結束了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·幫助",
      "text": "#欸，除了輩分虛高，我也不知道我在納塔能幫{F#妳}{M#你}什麼。{F#妳}{M#你}的「盟友」強大，前途光明，在這方面我已經沒什麼能為{F#妳}{M#你}做的了。更何況像我這種年紀的奶奶，通常不是都應該在家裡找張椅子躺著了嗎？除非{F#妳}{M#你}真的要我幫忙用輩分去壓人…{F#妳}{M#你}不會真的需要這種吧…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·侷促",
      "text": "#我、我對{F#妳}{M#你}的態度和對其他人一樣啊？沒、沒什麼差別吧？呼…好吧，村裡人對我的誤會已經傳承好幾代了，我早就放棄努力了——但是{F#妳}{M#你}不一樣，{F#妳}{M#你}面前的我才是真正的我。對外無所顧忌、大剌剌的模樣，都是我努力裝出來去迎合外界忌憚的…在{F#妳}{M#你}面前的侷促才是真的我。我就是一個謹小慎微的人啊…我從來都不騙{F#妳}{M#你}，但是這個真心話我只說一次。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "獲得神之眼就是獲得了另一種強大的「盟友」。不過當我們說某人「盟友」強大的時候，本質上還是在說其人本身超凡。畢竟「盟友」只是協助你的力量，只有你自己擁有無堅不摧的意志，才能把力量發揮出來。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "稻妻的小說連載運到納塔會晚兩週，而合訂本要整整晚一年，不知道背後有什麼深意…在這兩週內，各種稀奇古怪的內部消息、先行透露滿天飛，不知道多少是造謠，多少是自己編的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#傳說納塔曾有一種特殊的仙人掌，被我老師的老師稱呼為「梅斯卡利脫」，據說食用它能讓凡目也看到另一重世界——我也只是說說，現在不知道「梅斯卡利脫」滅絕了沒有，{F#妳}{M#你}遇到了千萬不要吃。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於歐洛倫…",
      "text": "哼哼。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於瑪拉妮…",
      "text": "瑪拉妮和我之間有筆算不清楚的帳。她應該付我的報酬、弄壞我家門的賠償、實付報酬、蹭我零食、帶給我的小吃…總之算不清了。如果她不介意的話，我倒是想就此算了。正應該睡覺的週末上午十一點…啊，沒什麼！總之，突然被她咚咚咚捶門，太可怕了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於希諾寧…",
      "text": "#像她這樣既不在乎關於我的奇怪謠言，又不會過分熱情的人相處起來最輕鬆不過了。啊，不是——在{F#妳}{M#你}面前我也很輕鬆，我拘謹的本性都不自覺流露了！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於瑪薇卡…",
      "text": "瑪薇卡這傢伙…咳咳，不好意思，火神大人她前些日子突然過來找我說了一大堆話，後來我半夜吃宵夜時才明白她過來炫耀了什麼。有一句異邦的古話，想想還滿適合她的：「聖者謙卑，只有談到自己責任時，會驕傲地加一句：『我說句大話…』。」"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "對神里綾華…",
      "text": "哈…小妹，妳轉過來給我看看，嗯…這是《奧西茲小姐事件簿》啊。唉…我還以為是《赫爾洛克》系列的女二呢。楓丹的衣服在我看來都一樣。好了，妳繼續吧，我沒事了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於基尼奇…",
      "text": "#他身邊的那個小東西有點煩人，他是{F#妳}{M#你}朋友嗎？那我想想還有什麼別的印象…他本人還是滿可靠的。嗯。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於伊安珊…",
      "text": "好像對她沒什麼更深的瞭解。不過根據八重堂小說的套路來看，這個人能力這麼強，個子這麼小，是不是遇到緊急情況會有一個230公分的百分之二百出力模式啊？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於瓦雷莎…",
      "text": "帶上面具的戰士會被認為是「英雄」、「自然」、「神靈」的化身。曾經就有一個大家喜聞樂見的英雄扛著被酒打敗的巫婆耀武揚威的故事，還是在半夜足足敲了一百戶人家的門。我倒是也不剩什麼好名聲了，所以沒有很在意。嗯，沒有。為了她飲食健康，我要給她下連吃十天蘑菇的詛…呃，祝福！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解茜特菈莉·其一",
      "text": "#啊？{F#妳}{M#你}怎麼突然過來和我說這個？是聽到了關於我的傳聞？唉…對對對，我就是薩滿裡的老妖怪，想信就信吧。我已經放棄解釋了。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解茜特菈莉·其二",
      "text": "#{F#妳}{M#你}還是想聽我解釋嗎？唉…「煙謎主」有一個秘而不宣的傳統——為了敦促後輩進步，老師會故意算計徒弟，讓他們和師叔們結下梁子。為了不挨長輩的揍，後輩就必須拼命努力反超長輩。如今「煙謎主」大半都是我朋友的譜系，他們所有人都喜歡找我來當這個壞人巫婆，怎麼辦呢？我根本沒想為難後生，可是這麼多年沒有一個人能贏過我！唉！於是關於我多恐怖、脾氣多差的謠言就根深蒂固了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解茜特菈莉·其三",
      "text": "#沒錯，我在人前的狀態是裝出來的，這才是我本來的性格。這也很好理解吧？所有人都期待著妳說話帶著口音和過時表達的時候，妳說出了優雅、字正腔圓的標準口音，對面也會愣住的。{F#妳}{M#你}說的沒錯，這就是一種不自知的愚蠢。但是這種愚蠢很難從習性上摒棄，{F#妳}{M#你}看，我一開始還以為{F#妳}{M#你}也和其他人一樣啊，嘿嘿。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解茜特菈莉·其四",
      "text": "#{F#妳}{M#你}想知道「煙謎主」的後輩是怎麼被他們師父算計，和我結下梁子的嗎？最傳統的做法就是師父騙徒弟自己被騙了，要去騙子家門口塗鴉。通常徒弟聽了就會義憤填膺，捲起袖子就塗。真的很過分欸，對吧？不過最近大家都知道我家在哪裡了，所以這招不怎麼能見到了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解茜特菈莉·其五",
      "text": "#這些龍遺蹟研究協會送回來的酒瓶…啊，這、這是…對，是歐洛倫他喝完隨地亂丟的，和我沒關係。對吧，歐洛倫？快出來認錯！我酒量還不錯，不會輕易喝醉的，就算醉了也不會亂丟垃圾。何況協會說是野外找到的，在野外也沒有給別人添麻煩，而且這也不是我丟的…啊，解釋不清楚了！請{F#妳}{M#你}相信我！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "茜特菈莉的愛好…",
      "text": "我的生命太過無意義，只剩下喝酒的迷醉、看小說的妄想和睡覺的昏沉了。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "茜特菈莉的煩惱…",
      "text": "#這樣{F#妳}{M#你}還看不出來嗎？看起來什麼都不在乎只是我的保護色，其實我什麼都很在乎。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#我喜歡五分熟的肉，比較接近祭祀品本來的味道。然後就是吃起來簡單，可以一隻手拿著另一隻手翻小說的東西。再然後就是——{F#妳}{M#你}推薦的我都喜歡！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "就是…稍微有些不理解酸味的食物。餓了就吃東西、睏了就睡覺、渴了就喝水——既然需要酸味開胃，那不就是不餓不需要吃東西嗎？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#嗚啊，太好吃了。「煙謎主」附近的東西我都吃過了，全都沒有{F#妳}{M#你}做的好吃。真的真的。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "平常吃這種東西不多…不不不，不是說不好吃的意思！就是…現在感覺吃出來了另一番風味。是誇獎，真的是誇獎！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "怎、怎麼會不好吃呢？啊哈哈哈…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！我也不知道有什麼可以送{F#妳}{M#你}的，{F#妳}{M#你}的前途上災星惡曜不顯，愛情、功業、武勳的運勢也很通暢，米克特蘭式的祝福對{F#妳}{M#你}效果甚微。之前本想送{F#妳}{M#你}我傳教用的《菲謝爾皇女夜譚》，但是看到{F#妳}{M#你}好像有很多八重堂藏書，我都羨慕…這就為難了，送{F#妳}{M#你}什麼好呢？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "不像是提瓦特外面世界的占卜技術，我——至少我這一系——不依靠天，反而更依靠大地。天上虛假的凶星惡曜顯露之時，我就依靠迷煙、大地之靈和動物骨頭將其綁縛。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "天上對人間命運的操控如同木偶提線，這些惡曜本身並沒有自我意志，但是這些力量被封進布偶體內之後，憑著小動物骨頭附著的念頭呈現出了意識。我把這些玩意…咳…小傢伙叫做「星魔」，可以說是凶星惡曜的化現吧。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#每個布偶裡都有小動物的骨頭，仔細想想的確也有點嚇人吧…用這樣的秘術被其他人所恐懼，可能有十分之一的責任的確在我，但是這都是我遊歷野外時所撿的，我絕沒有傷害小動物！{F#妳}{M#你}千萬不能誤會我！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#從今以後，我會一直與{F#妳}{M#你}同行，直到所有星辰消隱，直到所有的火熄滅，直到迷煙散盡。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "出來做事！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "履行盟約吧，星魔們。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "不必留情。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "小心…小心地…"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "不會手抖的。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "好的。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "滅口交給你們了！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "茜特菈琳、伊茲帕帕，給我上！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "讓你見識見識惡曜傷人！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "滿好的，收下吧。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#先收下，答謝諸星的祈禱我替{F#妳}{M#你}做。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#兩隻手都抱不下的話我來幫{F#妳}{M#你}。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不該出門的…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "唉…想回家啊…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "#不能…在{F#妳}{M#你}面前…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "…不准死！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "給奶奶我小心點。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "天上的諸曜啊…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "大地的迷煙啊…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "對不起…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "好膽子！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "痛痛！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "我才沒遲到…"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "蛤？幹什——啊，沒事的，準備好了！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "那我鐵定幫忙啊。"
    }
  ]
}