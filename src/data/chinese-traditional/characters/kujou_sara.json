  "outfits": [
    {
      "id": 205600,
      "name": "嚴正淨衣",
      "description": "九條裟羅的裝扮款式。潔淨端正，足以面神的虔信者裝束。",
      "isDefault": true,
      "characterName": "九條裟羅",
      "characterId": 10000056,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sara_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我的名字是九條裟羅，{F#妳}{M#你}記不住也無妨，只需知道：我將永遠護衛稻妻、踐行鳴神的意志，不論神鬼，遇敵必除！呼…別緊張，既然答應與{F#妳}{M#你}並肩，我自當盡心盡職。大義外的事情，我不會計較的。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·正鵠",
      "text": "只有保持心、弓、箭三位一體，才能命中正鵠。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·永恆",
      "text": "為將軍大人實現「永恆」，這就是我的「願望」。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·使命",
      "text": "天狗的職責是護佑山林，九條家的使命是守衛稻妻，兩者並無二致。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨滴的聲音會掩蓋腳步聲，多加注意吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "聽見了嗎？鳴雷正是將軍大人的意志。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "想要留住雪花。但在手心裡，它只會融化得更快。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "天清氣朗，適合演武。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早上嗎？對於我而言，這已經不早了。通常我睜開眼時，天還沒亮。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#我沒有午休的習慣，但如果{F#妳}{M#你}想，我可以等{F#妳}{M#你}。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好。隨口一提，花見坂的夜櫻，是不可多得的景致。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "去休息吧，這裡有我看著就行。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於裟羅自己·天領奉行",
      "text": "#家主於我有恩，「天領奉行」是我唯一的依靠，我會傾盡一切來捍衛家族的榮譽。嗯？{F#妳}{M#你}問「天領奉行」的行事準則？那自然是忠於雷電將軍大人，這也是我九條裟羅此生唯一的信條。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於裟羅自己·備戰",
      "text": "#「準備好了嗎？」如果在出發前，{F#妳}{M#你}有這樣確認的習慣。十次中，恐怕只有一次{F#妳}{M#你}能聽到我的答覆。其餘九次，我已經化身利刃，身處前線。這並非蠻勇或不忠，而是戰場從來不會留給人喘息的時間。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於裟羅自己·願望",
      "text": "#我的願望？我原以為{F#妳}{M#你}早已知道，輔佐將軍大人實現「永恆」就是我的願望。嗯？為自己所想的願望？這種東西，我沒有想過…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·觀察",
      "text": "#雖然{F#妳}{M#你}對於將軍大人的「永恆」而言是個「不安定」的因素，但「不安定」也未必代表「阻礙」。我不會與{F#妳}{M#你}為敵，但，我會一直盯著{F#妳}{M#你}。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·體會",
      "text": "#收繳神之眼時，我漠視了人們的願望。在眼狩令已然結束的當下，我有責任作出彌補。聽說{F#妳}{M#你}能聽見千手百眼神像上那些神之眼蘊含的願望？請跟我好好聊聊吧。還有…也跟我說說{F#妳}{M#你}的願望吧，我想知道。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "得到神明的注視，才能獲得「神之眼」。既然我的「神之眼」是由將軍大人所賜，最後，我也會將它還給將軍大人，不怨不悔。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·陀螺",
      "text": "#上次執行任務時，花見坂的商戶送給我一個名為「獨樂」的陀螺，那是種「一個人也能玩」的玩具，我覺得挺有意思，就留在了身邊。{F#妳}{M#你}說…一起玩？那豈不是違背了「獨樂」的原則，請容我拒絕。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什麼想要分享·特產",
      "text": "知道稻妻最具代表性的特產是什麼嗎？不對，並非刀具。是「御建鳴神主尊大御所大人像」造型的漆器，由老練的漆器師傅手工打造，城內幾乎每家每戶都供奉著一座。我的屋裡？有五座。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "當我心中有難解之事時，我會佇立在神櫻樹下閉目養神，再次睜開眼時，飄落的花瓣就會為我指引方向。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於托馬…",
      "text": "「天領奉行」的宅邸很大，如果有像托馬一樣優秀的家政官就好了，一定能將家中紛繁事務打理妥當。要是什麼時候，他不再想侍奉神里家了，我很希望他能過來幫忙。不過大概不會有這一天吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "平時在九條家，只有士兵們在道場訓練的聲響，而每次路過神里家，總會聽見舞樂聲、打鬧聲和笑聲。聽聞神里家的大小姐棋技了得，我一直等候時機，想要登門拜訪，卻又擔心…像我這般嚴肅的人，是否會與那般氛圍格格不入呢。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於宵宮…",
      "text": "只要她不在我的軍營裡亂放煙花，我是不會找她麻煩的。哼，我知道，拋開別的不談，她做的煙花的確流光溢彩，值得稱讚。只不過煙花易逝，刹那光輝結束後，夜空上留下的依舊是黑暗。所以我時常提醒自己，想要貫徹護佑稻妻的使命，就不能沉淪在這些虛幻的光景中。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於鹿野院平藏…",
      "text": "鹿野院…雖說這位是我的同僚，但我對他沒什麼好感。總感覺他有很多自己的盤算，沒有把組織的事放在第一位。要不是看在他探案有功的份上，早該對他多加管束。\\n唉，真是頭疼。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於雷電將軍·相信",
      "text": "#{F#妳}{M#你}肯定從不少地方聽說過吧？將軍大人追求的是無念無執的永恆，捨棄塵世的執念，執著不變的永恆。將軍大人的言行決斷，我並非每一處都能參透。但既然這是她的決定，我便相信她。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於雷電將軍·追隨",
      "text": "#「眼狩令」廢除…嗯，看來{F#妳}{M#你}才是對的。咳…但這並不說明將軍大人是錯的。只是追求「永恆」之路的方式將要改變罷了。不知那位千百年來守護著稻妻的將軍大人，如今心中是否平靜呢。我只知道，不管道路上有多少險阻，我都會一如既往追隨她。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於八重神子…",
      "text": "八重宮司大人的所作所為，經常會讓我產生誤會…但她既然貴為鳴神大社的大巫女，不難得見將軍大人對她的信任與默許，我自然也會敬重她。不過，如果哪天她做了忤逆將軍意志的事情，那就恕我冒犯了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於珊瑚宮心海…",
      "text": "比起「巫女」，她作為「軍師」的才能更高。用錦囊打仗，此前實屬聞所未聞。我是否也該學習著用這種方法來指揮幕府軍呢？嗯…但這樣恐怕會演變成雙方把錦囊擺上檯面，像卡牌一樣逐張對戰…想想還是不妥。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於五郎…",
      "text": "他之於珊瑚宮心海，正如我之於將軍大人。同為堅守忠義之人，我很欣賞他。只可惜立場不同，註定沒辦法同行。但有這樣值得敬佩的對手，還不賴。而且，「五郎」…可是個好名字。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "#…說起這位，難免有些頭疼。收繳他的神之眼時鬧了不少動靜，是我見過最聒噪的人…不，最聒噪的鬼。能堂堂正正認輸算是有點男子氣概，只不過他的復仇之約實在是…到此為止，我不想說了。{F#妳}{M#你}如果實在想知道，還是自己去問他吧。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於久岐忍…",
      "text": "以她的才華和資質，留在那個名為「荒瀧派」的組織實在有點可惜。但不得不說，有她在，至少有效地阻止了閒散人士滋事擾民，減輕了天領奉行的負擔。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於綺良良…",
      "text": "#近來總覺得暗處有奇怪的視線，待我確認時又消失無蹤。真是不明所以的惡作劇。{F#妳}{M#你}說…是隻貓又？嗯…既然有事找我，堂堂正正報上名來就行。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解裟羅·其一",
      "text": "#瞭解我…請問是指什麼？天領奉行的各項事務均為機密，將軍大人的事情更是無可奉告，我不明白{F#妳}{M#你}有什麼意圖。嗯？瞭解我本身？倒也並非不可，只是…從未遇過這種情況。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解裟羅·其二",
      "text": "#我的生活還算簡單，不用領隊戰鬥時，我會準時在凌晨五點零五分起床，在庭院做五組深呼吸後走五圈，早飯習慣吃五口米飯…「五」是能為我帶來幸運與勝利的數字，所以我會一直堅持「五」，請問{F#妳}{M#你}有什麼異議嗎？"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解裟羅·其三",
      "text": "#執行眼狩令的過程中，最令我感到棘手的，是那些頂著幕府軍頭銜動用私刑的官兵。將軍大人的任務固然要堅定執行，但我決不允許他們濫傷無辜！我已經三申五令禁止這種行為，就結果而言…依然難以杜絕。{F#妳}{M#你}若是有什麼好辦法，還望賜教。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解裟羅·其四",
      "text": "雖然名義上是九條家的養子，但孝行大人看我的眼神，與看鐮治時的不同。即使木訥如我，也會偶感寂寞，尤其…在看到部下與親人相見的溫暖場面後。\\n抱歉，家主於我有恩，原是不該說這種大不敬的話的…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解裟羅·其五",
      "text": "#現在回想起來，{F#妳}{M#你}我也算「不打不相識」。我們一度處於對立面，說勢不兩立也不為過，真沒想到現在竟然能這樣並肩而行，促膝長談。這樣想來，我還真是得到了命運的眷顧…不，沒什麼。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "裟羅的愛好…",
      "text": "即使到了現在，素引練習和草靶練習依然是我每天必不可少的訓練項目。從身法到瞄準再到聽弦，絕不是枯燥的重複，而是對昨日的突破。與其說是愛好，不如說是一生的修行。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "裟羅的煩惱…",
      "text": "#天狗的翅膀是固有的客觀存在，並排站的話肯定會佔據一定的空間，我不明白{F#妳}{M#你}說的「拉近距離」究竟要怎麼實現。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "長久以來，我已經習慣吃飯糰之類方便攜帶、能夠迅速飽腹的食物了，這也是戰場上恢復體力的首選。不過，這只是個人習慣，我不會要求部下跟我一樣。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "沒有厭惡一說，只是我平日會避免吃甜食。問我原因嗎？甜食會使人身心放鬆，一旦吃了就容易…呃，總之，我不能懈怠，話題到此結束，不要再追問了！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "比飯糰更美味的食物…值得記下它的名字。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "我吃飽了。多謝款待。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "甜點還是不必了…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#來得正好，那我就免去禮節，直接問了。有什麼生日願望嗎？只要不與將軍大人的大義相悖，我都會竭盡全力幫{F#妳}{M#你}完成。為表誠意，今天{F#妳}{M#你}可以許五個生日願望。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "滿意的弦音，看我一擊即中。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "力量已經融入我體內，隨時聽命。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "我一個人，就是一支幕府軍！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#磨煉自身，突破武藝，本是我的職責所在，但{F#妳}{M#你}卻傾盡心力相助…我不會辜負這份力量，定將其用於大義！還有，天狗的情誼，與{F#妳}{M#你}同在！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "羽移！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "散！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "雷閃！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "常道恢弘，鳴神永恆！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "落雷…不悔！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "雷光千道！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "不錯的寶物，能夠提振士氣！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "很好，沒有放過任何角落。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "補充完就上路吧！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我會堅持到底…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "必須尋找突破點！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "快到極限了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不要勉強！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "退下！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "生命終非永恆。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我絕無怨言…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "哼，是我敗了。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "再來！"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "不錯的對手…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "怎麼會！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "戰況不順…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "#我會帶領{F#妳}{M#你}獲得勝利。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "哼，來吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#與{F#妳}{M#你}並肩！"
    }
  ]
}