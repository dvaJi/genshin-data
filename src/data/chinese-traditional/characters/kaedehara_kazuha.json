  "outfits": [
    {
      "id": 204700,
      "name": "葉落天涯",
      "description": "楓原萬葉的裝扮款式。染有楓葉紋樣的浪人衣裝。",
      "isDefault": true,
      "characterName": "楓原萬葉",
      "characterId": 10000047,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Kazuha_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#「飄搖風雨中，帶刀歸來赤腳行」…我的名字是楓原萬葉，遊歷四方的浪人。既然{F#妳}{M#你}我都在旅行的路上，這段路不妨結伴同行。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·自然",
      "text": "見到了這麼美麗的景色，自然會產生雲遊四海的想法吧？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·吹奏",
      "text": "#既然手邊有樹葉，我可以為{F#妳}{M#你}吹奏一曲。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·劍技",
      "text": "飄搖風雨中，睹物思故鄉，這把刀…是我與故鄉唯一的聯繫了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "在大雨中漫步，讓人神志清醒。不過等雨停之後，還是盡快把衣服烤乾比較好。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "比起在海上航行時遇到的雷暴，這倒也算不上什麼。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "我喜歡下雪，雪後的世界很安靜，無人來擾我清夢。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "晴空萬里，真讓人心情愉快。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "清晨的鳥鳴，是大自然的餽贈。啟程吧，屬於我們的旅途也要開始了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "正午的陽光，讓人想要小睡片刻。找個地方休息一下如何？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "抬頭見月，側耳聽風，壺中有酒，我心太平…\\n晚上好。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "風停了…\\n安靜的世界，適合好好休息。明天見。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於楓原萬葉自己·航行",
      "text": "其實，大海並非每晚都充滿風浪。天氣清朗的時候，月光倒映在搖晃的海面上，魚群在船舶的周圍隨行。我坐在船頭眺望遠方，會覺得這段旅程非常值得…唯一的遺憾是水手們的歌聲太吵了，他們不用睡覺的嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於楓原萬葉自己·貴族武士",
      "text": "楓原家曾經也是有名的武士門第，可惜傳承到我這裡時，除了貴族的名號外已經別無長物。不過對我來說倒也足夠了，武士不需要富足的生活，我們需要的是詩歌、美酒與手中的刀。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·出海",
      "text": "找個好天氣，出海看看如何？"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·暢談",
      "text": "#我喜歡性格爽朗的人，這樣相處時可以暢所欲言。有什麼想說的不必藏在心裡，我能夠聽到自然萬物的聲音，其中也包括{F#妳}{M#你}的聲音。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "在我看來，神之眼是力量的「證明」，而不是力量的「來源」。神之眼象徵的是凡人繼續向前的願望，而我們武士的底氣，一直都是手裡的刀。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·竹刀",
      "text": "想學劍道的話…我想想，拿著這個吧，這是我剛剛做好的竹刀。用這個切磋的話，我們就都不會受傷了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什麼想要分享·楓葉",
      "text": "「深山踏紅葉，耳畔聞鹿鳴」…我很喜歡楓葉，可惜楓葉紅時總多離別。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "海鷗別叫啦，從今天起，我也是漂泊者呀。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於北斗…",
      "text": "北斗大姐頭是我的恩人。大姐頭她收留了從稻妻逃出來的我，並在我最困難的那段時期裡，給了我重返稻妻的勇氣。她是我和所有船員都可以託付後背的戰友。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於五郎…",
      "text": "我在被通緝的那段時間裡，反抗軍給了我許多幫助。那時候我與五郎只有短暫的接觸，但我對他的印象很深刻。他是那種有話就說的直性子，與部下同甘共苦，為朋友兩肋插刀，與我很合得來。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於九條裟羅·態度…",
      "text": "能在御前決鬥中戰勝我的朋友，我確實認可她的實力。但她卻用這樣的力量為虎作倀，帶領九條軍不斷回收「神之眼」，我無法原諒。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於九條裟羅·改觀…",
      "text": "原來如此。看來她也有自己堅持的信念。只是不知道風波平息後，「九條」家還能否延續曾經的昌盛。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "離開稻妻後，我許多次捫心自問，我對雷電將軍的不滿是否源於那一次御前決鬥，是否源於她對友人落下的那一刀？\\n我想了很久，覺得並非如此。我的友人是堂堂正正地死在決鬥場上，雷電將軍的那一刀也並無不妥。我對她的不滿來源於「眼狩令」。沒有任何人有資格剝奪他人的願望，即便是「神」也不行。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "生活在稻妻的人，應該都聽過「白鷺公主」這個名字吧。神里家的大小姐，近乎完美的一個人，不過我跟她沒什麼交集，不知道她對如今的稻妻抱有怎樣的看法。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於宵宮…",
      "text": "上次她託大姐頭把煙火運到璃月，還是我親自去卸貨的。很沉！除了她以外，應該沒人能造出這麼大的煙火了吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於珊瑚宮心海…",
      "text": "我在反抗軍的時候，周圍的同伴無不對珊瑚宮大人充滿敬仰。她愛惜兵力，很少會做出不計死傷的打法，總是能夠用最小的代價取得勝利。聽說她還要統管海祇島的政務和外交，真的忙得過來嗎…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於鹿野院平藏…",
      "text": "別看我這位偵探朋友平日裡瀟灑隨性，一旦他辦起案子來，那些原本圍繞在他身旁活潑靈動的風，就聚成了凌厲銳氣。確實讓人欽佩。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解楓原萬葉·其一",
      "text": "#想要瞭解我的事？如{F#妳}{M#你}所見，我只是個隨處可見的流浪武士。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解楓原萬葉·其二",
      "text": "我的耳朵很敏銳，能夠聽到各種各樣的聲音。比如風吹過山崗的聲音，雲散開的聲音，林間的小狐狸啃咬蘋果的聲音，螃蟹吐泡泡的聲音…這是自然萬物對我的眷顧，讓我總能提前發現危險的到來。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解楓原萬葉·其三",
      "text": "小時候我很喜歡下雨，那種沙沙的聲響容易給人一個安穩的夢。但長大了以後，對雨的感情就變得複雜了許多…雖然依舊喜歡聽雨，但每次看到烏雲的時候，卻又忍不住感嘆「今天能不能找到好心人讓我借宿呢」。穿著濕漉漉的衣服聽雨，往往會被噴嚏聲打斷了情調。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解楓原萬葉·其四",
      "text": "我不會在一個地方駐足太久。因為太久的停留會讓我跟「自然」產生隔閡，也會讓我手裡的刀變鈍。趁我還能遠航，我希望自己能去各種各樣的地方，見到不同的人們。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解楓原萬葉·其五",
      "text": "不必擔心，就算有一天我們去往不同的地方，也一定會在世界的某處再次相遇。人與人的「緣」不是那麼容易就斷掉的東西。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "楓原萬葉的愛好…",
      "text": "躺在被正午的陽光曬暖的岩石上休息，醒來後繼續漫無目的地前行。只要與刀相伴，我可以去任何地方。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "楓原萬葉的煩惱…",
      "text": "每逢風暴降臨的時候，「自然」的聲音就會變得嘈雜，我的耳朵也會嗡嗡作響。如果是在晚上的話，往往會輾轉許久都無法入眠，讓人有些頭痛。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#在大海上航行時，最容易取得的食材便是魚肉。怎麼樣把魚做得好吃，是每個在海上冒險的人都要思考的問題。有機會的話，也想讓{F#妳}{M#你}嚐嚐看我的手藝。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我呢，不是特別喜歡那些粗製的食物。在我看來，就算是一條普普通通的魚也要燒得好吃才行，吃本應是讓人身心愉快的事情，怎麼能將就呢？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#能將魚肉烹調出如此滋味，{F#妳}{M#你}的手藝當真了得。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}做的飯菜不僅能夠飽腹，對我而言也是慰藉。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "要休息一下嗎？內心疲憊的話，做出來的菜也會失去風味。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#哈…得知今天的生日，我特地寫了新的詩歌。只可惜詩才不佳，幾個晚上只想到前兩句，就先送給{F#妳}{M#你}吧。\\n「流光換日月，鶴歸雲起慶生時」…等等，先別說話，我有靈感了。最後一句…「異鄉有故知」，如何？\\n生日快樂，今天一起去…吃點甜品吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "這把刀，更加鋒利了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "雪落在地上的聲音，細不可聞…但現在的我，應該可以聽到了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "海上的風浪很大，我也要變得更強。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#行走世間，自然會有各種煩惱相伴，但既得與{F#妳}{M#你}相遇，不管是武藝還是內心都有了新的成長。想必今後的人生也會更加自在吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "起！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "嘿！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "踏風！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "御風而行。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "朔風解意。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "往返自然！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "雲隱…雁鳴！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "風共雲行。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "可嘆，落葉飄零。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "該出發了。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "順著風的方向。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "令人快慰。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "天地的饋贈。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "偶遇珍寶，是雲遊四方的妙趣之一。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "呼、有一套嘛…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "靜心凝神。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "保持專注！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "換我來保護你了！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "你可以把後背交給我。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "深感遺憾…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "下次…絕不會再…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "結束了嗎…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不要…緊。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "好痛！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "要帶上我嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "出發出發。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "就這麼做吧。"
    }
  ]
}