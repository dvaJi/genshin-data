  "outfits": [
    {
      "id": 208801,
      "name": "赫爾洛克變奏曲",
      "description": "夏洛蒂的裝扮款式。本來是《大偵探赫爾洛克》的拍攝用服飾，在拍攝結束後，劇組便作為紀念品贈予了夏洛蒂。",
      "isDefault": false,
      "characterName": "夏洛蒂",
      "characterId": 10000088,
      "source": [],
      "filename_card": "UI_AvatarIcon_CharlotteCostumeDong_Card",
      "filename_icon": "UI_AvatarIcon_CharlotteCostumeDong",
      "filename_iconCircle": "UI_AvatarIcon_CharlotteCostumeDong_Circle",
      "filename_splash": "UI_Costume_CharlotteCostumeDong",
      "filename_sideIcon": "UI_AvatarIcon_Side_CharlotteCostumeDong"
    },
    {
      "id": 208800,
      "name": "「皆在鏡前」",
      "description": "夏洛蒂的裝扮款式。「如果報導不夠真實，那就是你靠得不夠近。」當夏洛蒂談及報導事務時，她常這麼說。但有時候，她也會補充道：「當然啦…也可能是你用的鏡頭不太好。」",
      "isDefault": true,
      "characterName": "夏洛蒂",
      "characterId": 10000088,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Charlotte_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#初次見面，我是《蒸汽鳥報》記者夏洛蒂，很高興見到{F#妳}{M#你}。有空的話，{F#妳}{M#你}願意接受我的專題訪談嗎？記者的直覺告訴我，{F#妳}{M#你}的身上能挖掘出不少爆炸性新聞。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·新聞",
      "text": "只要眼睛夠尖，腦子夠快，每天都能找到好新聞。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·記者",
      "text": "#楓丹廷裡有許多記者，但並不是每一位都擁有合格的職業素質。如果{F#妳}{M#你}想接受採訪的話，最好還是來找我喔！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·《蒸汽鳥報》",
      "text": "《蒸汽鳥報》是一家優秀的報社，有一位開明的主編和許多出色的記者。最重要的是，稿費也結得非常迅速。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "留影機鏡頭不能進水！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "欸！可惜，又沒抓拍到閃電…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "…真是夠冷的，手指都按不動快門了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "#哇…光線真不錯！來，快擺個姿勢，我幫{F#妳}{M#你}拍張畫片！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安，今天的報紙看了嗎？沒有？那我唸給{F#妳}{M#你}聽。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "是午餐時間了嗎？我知道一家餐廳很不錯，跟我來吧！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上最適合談心了，{F#妳}{M#你}有什麼故事願意和我分享嗎？放心，我們事先說好可不可以登報，我一定遵守約定。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安，趕快休息吧…我還要去報社校對稿件，明天見啦…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於夏洛蒂自己·職業",
      "text": "記者並不是一個討人喜歡的職業。畢竟就像那句話說的：「謊言處處圓滑，真相稜角分明。」"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於夏洛蒂自己·留影",
      "text": "只有在拍攝有趣的東西時，我才能拍出一張好畫片。對於某些無聊透頂的留影對象…我能按下快門，就已經足夠有耐心了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·長篇專題",
      "text": "嗨…準備好接受專訪，成為最耀眼的大明星了嗎？來，聽我指揮，先擺一個好看的姿勢…派蒙也飛得好看一點！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·扉頁人物",
      "text": "#好消息！我已經說服了歐芙小姐，下一刊《蒸汽鳥報》的「扉頁人物」就是{F#妳}{M#你}們了，而且還會搭配本記者親自撰寫的專題報導。欸…不用了？我可是求了歐芙小姐好久啊！再考慮一下吧？我…我可以再請{F#妳}{M#你}們吃一頓大餐！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "說到這個…其實我更想要一枚「風元素」神之眼的。那樣的話，也許我就能藉助風飛來飛去，輕鬆地去各地採訪了。但這枚「冰元素」的神之眼也不錯，至少我不用擔心留影機內部機關過熱的問題了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "真實至上，故事超群。這就是我的工作原則。欸？哪一個是重點？那當然是「真實性」啦！「故事性」只是一種幫助讀者們理解新聞的輔助手段。唉…但據我觀察…比起「真相」，讀者更願意為「故事」付錢啦…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#為{F#妳}{M#你}介紹，我最好的夥伴和助手，獨一無二的留影機「溫亨廷先生」。看看他的帽子和領帶，都是我專門找千織小姐訂做的，是不是很好看？我還幫他訂做了好幾套不同風格的服飾，以應對不同的採訪場合。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "娜維婭的父親沉冤得雪，「少女連環失蹤案」也結了案，她總算可以稍微放心了。真不知道為什麼，她最近總是成為各種壞新聞的主角，還好我把報社裡所有關於她的報導都接了下來，盡量控制著稿件內容。\\n雖然…因為這件事我也被歐芙小姐訓了很多次，但為了幫到她的忙，還有和她約好的那篇深度獨家訪談，我挨一點罵也值得了！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於林尼…",
      "text": "好吧…林尼先生又拒絕了我一次。這是第幾次了來著…沒關係！林尼先生越是拒絕我，我就越能確定，他的身上藏著某些富有巨大價值的故事，這個故事的爆炸性一定是前所未有的。我一定要挖掘出來！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於琳妮特…",
      "text": "無論被問的是什麼問題，琳妮特小姐都只是安安靜靜地垂下眼眸，臉上沒有任何表情，就像一個…一個發條人偶。我真想寫一篇報導，就叫做《魔術的訣竅——天才魔術師的「人偶助手」》！但我覺得，她就算看見這篇報導也不會有任何反應…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "克洛琳德小姐可是楓丹廷裡最著名，也最神秘的「決鬥代理人」，我從私人管道打聽到，她會用一些神秘的儀式維護自己的武器。也許這就是她在決鬥中常勝不敗的關鍵？但她曾公開表示過不想接受記者的採訪…我應該沒辦法當面問她這個問題了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "#最近有見到那位「公爵」嗎？有沒有幫我留意和他有關的資訊呀？特許券、特許餐廳…「不勞動者不得食」…這種大家都知道的消息就算了，有沒有關於「公爵」個人的故事？什麼，保密…怎麼連{F#妳}{M#你}的口風也那麼緊！把我的那頓大餐還來！哼…騙子！{F#妳}{M#你}乾脆回去接著服刑啦！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "#艾梅莉埃小姐的香水是整個楓丹廷裡最好的！前兩天她還向我推薦一款兼具驅蟲、快速止汗、隱藏汗水味道的香水呢！這款香水對我這種經常出外勤的人真是太重要了。我今天還噴了一些在手腕上…喏…{F#妳}{M#你}聞聞，多香啊…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於千織…",
      "text": "我曾經仔細觀察過「千織屋」。店裡除了楓丹貴婦人和慕名而至的外國遊客之外，還經常會來一些看起來就不好惹的角色！有的一身肌肉、臉上留疤，有的蒙面戴帽、懷裡揣刀…但不管怎樣，他們手上幾乎都提著禮物樣式的東西，態度也畢恭畢敬。呃…那些態度不好的，出門時都是飛出來的，我還抓拍過那樣的瞬間呢！"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於菲米尼…",
      "text": "在那之後，我和菲米尼又見了幾次面。他對我的留影機助手「溫亨廷先生」很感興趣，還幫我改良了鏡頭。說實話…他三兩下就把「溫亨廷先生」拆解成零件的時候，我的心臟都快跳出來了…沒想到他安裝的手法也一樣乾淨嫻熟。我差點都以為他是楓丹科學院出來的，但他否認了。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "如果有記者要去採訪「最高審判官」的話，必須提前定好所有採訪問題，並且把這些問題送去給沫芒宮裡的有關部門審定，只有通過審定的問題才能出現在採訪中…以此保證整場採訪不會出現任何差錯。這樣的流程實在是太繁瑣了，光是想到這些我就精疲力盡了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "水神芙寧娜大人的言行舉止都十分富有感染力，是一個天生的大明星。歐芙小姐之前還指派了一位記者專門去跟訪她，但是他沒過多久就辭職了。\\n至於辭職的原因…據我打聽到的消息，是因為這位記者每拍一張畫片，都要拿去給芙寧娜大人看，如果她不滿意就要重拍。最誇張的一次，這位老兄對著芙寧娜大人的一個姿勢整整重拍了一百二十七次…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於愛可菲…",
      "text": "說起來都有點不好意思了，託愛可菲小姐的廚，我試吃了許多厲害的菜餚…她自己的新品，她飯店下屬的新品，甚至是學員的新品…我都快變成兼職美食評論家了，一分摩拉都不用付，就能吃遍楓丹最新最棒的美食！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解夏洛蒂·其一",
      "text": "我很清楚地知道，追尋「真相」這種行為伴隨著風險，不過，一個「獨家真相」也意味著一篇「獨家新聞」，我絕對不會放過…咳！我的意思是，我絕對不會放過這個…這個履行記者職責的大好機會。我一定要將最真實、最有力、最有趣的獨家新聞報導帶給所有人！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解夏洛蒂·其二",
      "text": "剛做記者的時候，我對寫報導一竅不通，只能透過閱讀其他報導來學習。除了《蒸汽鳥報》之外，還有一些在小範圍印發的私人刊物。比如專門報導楓丹廷內各種明星八卦的《觀窺者報》、持續關注各種娛樂活動和賽事的《娛樂家週刊》、評論美食的《主廚》、只會胡說八道和散播謠言的《驚奇！》等等。\\n這些報紙都給了我很大的啟發，讓我學會了…嗯，駕馭許多不同的行文風格。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解夏洛蒂·其三",
      "text": "為了揭示真相，我曾經假扮成遊民，混進了一家不良食品製造商的後廚做了六個月的雜工，在收集到足夠的第一手資料後，我就將他們幹的事都寫成報導，登在了報紙上。\\n報導的反響十分強烈，那家不良食品製造商也受到了懲罰，但他們的報復也隨之而來，我每天回家時床頭櫃上都放著一封恐嚇信，報社的門口也總是被人潑泥巴…\\n報社很快就報了警，而我則被指派去蒙德做「七聖召喚」的報導，過了好一陣子才回楓丹。\\n唉，這樣的事發生了很多次，真不知道歐芙小姐是怎麼把它們全擺平的…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解夏洛蒂·其四",
      "text": "在小時候，我還沒進入記者這行的時候，我的好奇心特別重，總覺得萬事萬物後都隱藏著秘密。\\n對我來說，這個世界是一片巨大的藏寶地，藏匿著無數不為人知的故事等待發掘。每當遇見那些我覺得藏匿有秘密的事物，就會拿出留影機拍下一張畫片，放在我的畫片集裡。\\n這些畫片都是只屬於我的「藏寶圖」…而我也一直不斷用各種方法解讀著它們，試圖揭示出隱藏在畫片中的「真相」。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解夏洛蒂·其五",
      "text": "#我不在意這些「真相」究竟有什麼價值、代表著什麼、或者說和什麼事有關…我只是想要將它們揭示出來。如果用冒險家的說法，我應該是屬於那種…專注於享受尋寶過程的人吧，至於最後究竟能尋到什麼寶，我倒是不怎麼執著啦。\\n在求證的過程中，我認識了許多人。楓丹的朋友們，認為我天生就是做記者的料的歐芙小姐，還有陪我一起探尋和見證「真相」的{F#妳}{M#你}。沒有大家的幫助，我恐怕還是那個只會到處拍照的野丫頭吧。\\n總之…我很高興能接受{F#妳}{M#你}的「特殊採訪」。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "夏洛蒂的愛好…",
      "text": "#我最喜歡收藏各種各樣的留影機鏡頭了。有些鏡頭有著超高的縮放焦距，有些鏡頭的視野非常廣闊。對了，還有一些鏡頭有著特別功能，拍出來的畫片會帶著各種特別效果，{F#妳}{M#你}看這個鏡頭，用它拍攝人像的話，會把人的臉拍得胖嘟嘟的。來！我幫{F#妳}{M#你}拍一張，派蒙也來！"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "夏洛蒂的煩惱…",
      "text": "也許是因為我有時提問的態度會有點…激烈，導致一部分人對我的印象不太好。我每次去採訪的時候，大家都是一副防備我的樣子…唉…但對於某些採訪對象，我必須要用這種態度來提問啊…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "嘿嘿，我最喜歡甜甜的東西了。無論正餐吃多少東西，都能繼續吃甜點。用我媽媽的話來說就是…我的胃裡永遠有留位置給甜點呢。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我吃不了辣的東西。我的胃就像是裝有一部超敏感的辣味監測機關一樣，無論辣味有多淡，只要我敢吃，它就敢痛…而且一痛就是一整天，嗚…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#哇…{F#妳}{M#你}的手藝真好！要不要在報紙上做一個廚藝專欄？我都想好排版和構圖了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "味道不錯呀！有空的話…下次也教教我吧？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "唉…這道菜的味道…還有品嚐這道菜的我，都足夠上新聞了…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！{F#妳}{M#你}讀了今天的《蒸汽鳥報》嗎？我對{F#妳}{M#你}的生日祝福已經登載在上面啦。欸…{F#妳}{M#你}沒買嗎？沒關係，我離開報社的時候順手拿了一份，{F#妳}{M#你}看，就在這裡，這是我能爭取到的最好版面啦！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "這感覺真奇妙，必須記錄下來。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "這些東西居然真的能助人成長？我之前只是聽說，沒想到今天能親身體驗。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#{F#妳}{M#你}之前也用這種方式幫過其他人嗎？所用的素材有什麼不同？還有…呃，不好意思，又犯職業病了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "喔！我能感覺到，思考的速度變快了，身體裡也充滿力量…我一定能抓住更多獨家新聞！但在那之前，我們先合張影吧…為這個美好時刻留下點紀念。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "看鏡頭！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "笑一個。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "擺個好姿勢！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "真實至上！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "爆炸新聞！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "夏洛蒂，為您報導！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "喔！看起來不錯。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "真想採訪一下把箱子放在這裡的人。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這些東西應該不在失物招領清單上吧？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我…我還能記錄…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "還有新聞要報導！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "留影機還能用！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "小心一點！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "喂！我可不想寫訃告！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "把報導…帶回報社…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "至少…記錄下來了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "標題，還沒想…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "真沒禮貌。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "我的鏡頭！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "採訪開始囉！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "有什麼新聞嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "靠得越近，報導越真實。"
    }
  ]
}