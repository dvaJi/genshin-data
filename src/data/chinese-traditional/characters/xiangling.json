  "outfits": [
    {
      "id": 202301,
      "name": "歲夜歡譁",
      "description": "香菱的裝扮款式。冷風中的一抹紅色灶火，帽子在胡桃的提議下特別根據鍋巴的形象設計而成，很受香菱喜愛。",
      "isDefault": false,
      "characterName": "香菱",
      "characterId": 10000023,
      "source": [],
      "filename_card": "UI_AvatarIcon_XianglingCostumeWinter_Card",
      "filename_icon": "UI_AvatarIcon_XianglingCostumeWinter",
      "filename_iconCircle": "UI_AvatarIcon_XianglingCostumeWinter_Circle",
      "filename_splash": "UI_Costume_XianglingCostumeWinter",
      "filename_sideIcon": "UI_AvatarIcon_Side_XianglingCostumeWinter"
    },
    {
      "id": 202300,
      "name": "椒紅薑黃",
      "description": "香菱的裝扮款式。洋溢著火辣熱情的輕便衣裝。",
      "isDefault": true,
      "characterName": "香菱",
      "characterId": 10000023,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xiangling_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "我是來自璃月的廚師香菱，最擅長的是做各種撈…撈，料理…哎呀，練了那麼多次，還是會緊張，嘿。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·點心",
      "text": "要吃點點心休息一下嗎？我準備了一簍！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·火史萊姆",
      "text": "火史萊姆，是椒鹽…還是做成蒜香的好呢？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·覓食",
      "text": "嗯，閒著也是閒著，還不如一起找找食材去！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候·態度",
      "text": "嗯…我不太喜歡雨天。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雨的時候·疏忽",
      "text": "我想想…今天有沒有曬衣服出去…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雨過天晴…",
      "text": "#走走走，我帶{F#妳}{M#你}去找松茸！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "#風史萊姆最喜歡在這種天氣活動，快趁機多收集點！我給{F#妳}{M#你}做史萊姆冰沙！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "來得正好！一起去補充點食材吧？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午飯已經做好了，快過來吃哦！啊嗚…來晚了可就沒了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "要吃消夜嗎？我這正好做了串炭烤岩蜥蜴。哎呀，別盯著了，快嚐嚐吧！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#喂…{F#妳}{M#你}不會是想背著我偷偷吃什麼好東西吧？哦，只是休息啊……嘿嘿，那晚安喔。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於香菱自己…",
      "text": "#{F#妳}{M#你}見過蒙德城的龍？有多大？哇，不是吧。那要是做成龍肉排——嗯，該有多棒啊！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·長處",
      "text": "雖然比起認路我更擅長做飯，但…不管啦，出門找我準沒錯！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·新知識",
      "text": "#自從認識{F#妳}{M#你}，我好像學會了不少料理以外的知識。欸？呃…{F#妳}{M#你}問我都有些什麼？嗯…嗯…{F#妳}{M#你}突然這樣問，我又有點想不起來了。算了算了，我原本就不擅長這些，還是幫{F#妳}{M#你}做兩道新菜嚐嚐吧！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "無論什麼時候，我都要做出所有人都愛吃的料理。神一定也認為這是正確的事情，才授予了我這個連大師父也沒有的「神之眼」…唔，怎麼說來著…哦，以玆鼓勵！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "如果拉肚子了，喝一杯霓裳花泡的茶就會好的！欸？我懂一點食療方法也不用奇怪吧！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "我喜歡洋蔥！…我試過十幾種切洋蔥不會流淚的方法，沒一個對我有用。但這也阻止不了我喜歡洋蔥！"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於白朮…",
      "text": "#嗯？我聞到了霧虛花的香氣！是白先生，白先生來幫{F#妳}{M#你}看病了嗎？{F#妳}{M#你}是哪裡不舒服，頭暈還是胃痛？還是嗓子癢？還是沒力氣？哦…沒生病啊。那還好。不然白先生會給{F#妳}{M#你}超——苦的藥哦。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於凝光…",
      "text": "#哦！剛才那個，是「天權」大人啊…嗯，{F#妳}{M#你}湊過來點。再，再過來點。我跟{F#妳}{M#你}說哦，她可是一個特別厲害的人，港內的事情她什麼都知道。所以，{F#妳}{M#你}也要小心一點，不要被她盯上了…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於胡桃…",
      "text": "#唔，{F#妳}{M#你}是不是也被胡桃欺負過？她老是趁我不注意躲到我後面，這樣突然拍我的後背，得逞了還嘿嘿地笑，哼。但我大人大量，看在她每次都會給我帶釀梅花做線花糕的份上，才沒跟她斤斤計較。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於迪奧娜…",
      "text": "清泉鎮的迪奧娜！啊啊，聽說她能調出特別好喝的酒，我專門拜訪過她！想著如果能把調酒的秘方借鑒到料理上，說不定也能做出美味。但是，她給我的秘方，比如啤酒裡泡蜥蜴尾巴，蒲公英酒裡放小塊燻魚…做出來都不是很好吃。嗚，果然還是要靠自己嗎？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於北斗…",
      "text": "北斗姐姐人很好！跟著她出去航海的話，每次都能捕獲到好多新鮮的食材！章魚腳拿來煲湯最好，海天青就要用辣椒好好熗一熗。不光北斗姐姐，「南十字」的船員們都很喜歡我做的菜呢。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於鍾離…",
      "text": "#我遇到過不少挑剔的食客，但像鍾離先生那種嘴巴上講究，還能一針見血的，真的就只有他一個！那天我給他上的第一道菜是「椒鹽豆腐」，他只嘗了一口，就問我用的是什麼鹽，然後又說什麼「不妨試試孤雲閣淺海處提煉的海鹽吧，它的層次感能夠為豆腐賦予更多鮮味」。我試過之後味道真的大有不同。{F#妳}{M#你}說，他是不是好厲害！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於重雲…",
      "text": "#重雲啊，他總是跟著行秋一起來「萬民堂」吃飯…呃，或者應該說，是被行秋拖來的？但是重雲不吃熱食。每次熱菜上桌，行秋就會客客氣氣地說一聲「失敬」，然後動起筷子逐一評點起每道菜的美味之處，他那誇得呀，我都想衝過去嘗一口！{F#妳}{M#你}是沒見到重雲那種眼神，哈哈哈。還挺有趣的呢，他倆。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於甘雨…",
      "text": "甘雨？嗯…啊啊有印象有印象，是那位只吃素食的客人吧！她來「萬民堂」的次數不算多，每次都是一個人躲在小角落裡不吭聲地吃著飯。我嘛，看她孤孤單單有些可憐，就總幫她多舀兩大勺菜。沒想到，她每次都能全部吃完！真是不可貌相。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於瑤瑤…",
      "text": "嘿嘿，她啊，是我引以為豪的小師妹喔！不過呀，她很久沒來「萬民堂」玩了。是大師父放心不下吧…哼，明明生的雲來大章魚那麼好吃，瑤瑤上次不光不讓我吃，還叫上大師父一起訓斥我，嗚…有時候真不知道，到底誰才是師姐了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於辛焱…",
      "text": "辛焱經常來「萬民堂」吃宵夜喔！像行秋、重雲他們不敢試吃的新品，辛焱就會毫不猶豫地下筷…而且有八成以上的機率喜歡！哎，真是很不錯的人呐。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於夜蘭…",
      "text": "夜蘭姐？我當然記得她啦。第一次見面時，我還猜她會喜歡那種清淡的菜色，沒想到她是我見過最能吃辣的客人！菜餚裡的辣味她覺得不夠，居然把絕雲椒椒直接嚼來吃！真了不起。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於嘉明…",
      "text": "哎呀，知道嘉明要來，我就會早早備上一大壺茶水，方便他涮辣菜。我提議說幫他做一份不辣的，但他卻擺著手說就喜歡原汁原味的配方…不會錯的，那不是客套話，我能分辨出真正食客的眼神！嘿嘿，那我當然也不能讓他失望啦！"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於藍硯…",
      "text": "#鍋巴很喜歡她！第一天見面就不停地跟她握手，不知道的話還以為他們認識很久了呢哈哈！我已經跟藍師傅約好啦，讓她帶我去抓昆蟲、採野蕈…嘻嘻，等我的新菜創作出來之後，{F#妳}{M#你}們都要來吃哦！"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於愛可菲…",
      "text": "啊！那個楓丹的廚師姐姐，我很喜歡她！那天她請我試吃了許多新奇的菜品，裡邊的口感非常…那個詞怎麼說的來著？哦，是「精準」！就像用各種味道的食材，在嘴裡精雕細琢地製成了一尊雕塑！她對做菜過程中每個階段、每種原料的控制手法，都讓我眼界大開。我是不是也該託申鶴去找閒雲姨，做個能夠定時定量還定溫度的機關，再來學學她的手法呢？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解香菱·其一",
      "text": "烤鴿子肉，來兩串？哎呀~嚐嚐嘛。加了我的獨門秘方，絕對跟其他家的不一樣！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解香菱·其二",
      "text": "#大師父教我的槍法，很厲害吧？{F#妳}{M#你}想學的話我也可以教給{F#妳}{M#你}喔！不過說到這個…要是{F#妳}{M#你}願意跟我學廚就好了！我的這些技巧和配方，要流傳得遠遠的才好呢。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解香菱·其三",
      "text": "#問我的願望嗎？那當然是要創造全新的新菜系！璃菜和月菜都是有極限的。喔，關鍵一定在於辣味吧！事不宜遲，讓我爆炒個鍋巴辣椒給{F#妳}{M#你}嚐嚐！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解香菱·其四",
      "text": "#嗯！我看{F#妳}{M#你}已經快被我的廚藝征服了嘛~是時候給{F#妳}{M#你}品嚐我苦心研製的新菜品了——七彩琉璃大煎餅。喏喏，這薄薄一層蛋皮裡面包著紅色的松鼠火腿，橙色的胡蘿蔔，黃色的太陽蛙肉，綠色的嘟嘟蓮，藍色的蝴蝶翅膀…呃？真的不想吃嗎？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解香菱·其五",
      "text": "#我…有點想不明白，明明以前睡一覺就好了的，這可不是我的風格。啊呀，不行！還是讓{F#妳}{M#你}來想吧！嗯…我很想讓{F#妳}{M#你}一直試吃我的新菜，但不知道從什麼時候起，如果{F#妳}{M#你}吃壞了肚子，我也會特別難受。我，我到底該怎麼辦呢？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "香菱的愛好…",
      "text": "#看著點喔！像這樣燒熱一鍋油，然後，把去掉翅膀的晶蝶這樣放下去炸…哎呀{F#妳}{M#你}別走啊，超香的啦！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "香菱的煩惱…",
      "text": "嗚，史萊姆滑蘑菇一份也沒賣出去。就因為賣相不好嗎？口感明明很棒的呀…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "喜歡的食物呀，嘿，那當然是尚且不知道味道的新菜啦！欸，我這樣回答很狡猾？嗚，明明說的是實話嘛。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我是不會對食物有什麼偏見的！只有不合適的做法，沒有不合格的食物！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "哇，這就是…「噼咔」的味道！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#嗯，{F#妳}{M#你}做菜真有一套。下次就換我來露兩手吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "難道是做法的問題嗎？總覺得哪裡怪怪的…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#啊，找到{F#妳}{M#你}了！快來，我給{F#妳}{M#你}做了一整桌的菜喔！嘿嘿，不用急著誇我，先等{F#妳}{M#你}嚐過味道再慢慢說吧！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "呼哇~！好爽！全身上下都充滿了力量！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "嘿、哈！好！一拳就能把野物打暈…保證食材新鮮！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "有這種力量的話…終於可以…不好，口水要流下來了！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#父親曾經說過：「想做出十分的菜餚，就要投入十二分的熱情。」我懂的、我懂的！能走到今天這個地步，一定是因為有{F#妳}{M#你}付出了十二分的熱情陪我練習。嗯，那我也要再加倍…用再加倍的熱情來回應{F#妳}{M#你}！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "鍋巴，噴火！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "熱和熱和嘛。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "開鍋了開鍋了！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "嘿…哈！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "講不通，就打扁囉！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "見識一下師父的槍法！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "跑起來跑起來！"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "衝刺結束·其一",
      "text": "肚子岔氣了…"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "是新的食材！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "大豐收大豐收！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "我會物盡其用！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "嗚，今天的食材好凶啊。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "哎呀，痛痛痛…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我是不是惹了個不得了的傢伙！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "別著急，歇會兒再打吧？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "快回來！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "搞砸了呢…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "突然…好渴啊…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "#是不是…連累{F#妳}{M#你}了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "不要打我…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "救命啊，食材打人啦！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "還滿痛的唔…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "佐料帶全了！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "長槍磨亮了！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "一刻都不想多等！"
    }
  ]
}