      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Mona_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "我的名字是阿斯托洛吉斯·莫娜·梅姬斯圖斯，意為「偉大的占星術士莫娜」。如果想找我占卜，記住我的名字是最基本的尊重…而且要一次性全唸對！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·占卜",
      "text": "占卜就是把既定的命運準確地展示出來。過度的修飾，只會讓人們產生誤解。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·生活",
      "text": "限制物欲是占星術士修行的一部分，只有簡樸地生活，才能窺探到世界的真實。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·命運",
      "text": "正是因為無法更改、無可違逆，只能接受，命運才會被稱之為命運。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "這麼大的雨…不僅看不見星光，連水占盤都模糊了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "這些落雷…究竟是從哪個星空降下的呢？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "純淨的融雪之水，很適合用在水占盤裡。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "嗯，是個無須占卜也能感覺到的好天氣。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#{F#妳}{M#你}來得不巧，清晨的啟明星剛剛消失了…早餐？我、我已經吃過了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "已經正午了，去吃點東西吧，嗯？我…我吃份沙拉就行了，呃…簡樸的生活是…是占星術士修行的一環！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "入夜了，過會就可以開始占卜…呃，昨天的稿子我寫了沒…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#已經這麼晚了，明天截稿的稿子一點沒動…什麼？{F#妳}{M#你}要去休息了？嗚…我也想去睡覺…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於莫娜自己…",
      "text": "占星術士的工作，是向人們明確地展示他們即將面對的命運，我也是這麼做的…不過，總有些人不願意接受。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·工作",
      "text": "為什麼要寫稿，不用占卜來賺錢？…我才不會為摩拉而使用「水占術」…我也不是因為這個而學習「水占術」的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·我的命運",
      "text": "我不知道。除非萬不得已，占星術士不會占卜自己的命運。老太婆以前說過，這種行為可能會導致命運的自相矛盾，很危險。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "#關於我們·{F#妳}{M#你}的命運",
      "text": "#{F#妳}{M#你}不是這個世界的人，所以我無法準確地為{F#妳}{M#你}預言。我只能告訴{F#妳}{M#你}，{F#妳}{M#你}要走的路還遠未到盡頭。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」·嫌棄",
      "text": "我剛剛拿到「神之眼」的時候，那個老太婆還假模假樣地說什麼「願妳求真之心永在」。結果這東西在「水占術」上一點用場都派不上，只會濺我一身水…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "關於「神之眼」·價值",
      "text": "唉…不過，「神之眼」當成個小飾品，裝在身上倒是無所謂。畢竟，這也算那個摳門老太婆破天荒送我的「教具」。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#{F#妳}{M#你}聽說過「命之座」嗎？占星術士認為，「命之座」是「神之眼」持有者的命運在星空上的映射，過去、現在和未來，所有的一切都在其中昭示。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#欸——{F#妳}{M#你}身邊帶著的這個小傢伙，到底來自哪裡？無論我用什麼方法，都沒辦法找到一絲關於她命運的蹤跡。\\n…啊？{F#妳}{M#你}也不知道？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於琴…",
      "text": "那位西風騎士團代理團長？她的「命之座」是「幼獅座」，象徵著力量，還有過早擔負的責任。「雄獅」早早離群，但她會繼續成長，直到能完全繼承獅群的榮耀。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "阿貝多？啊…我真羡慕他，只用專注於研究就好，不用管其他的雜事，真是美好的生活啊。如果那個老太婆腦筋正常一點，我應該也過著這種生活吧…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於可莉…",
      "text": "#{F#妳}{M#你}是說，艾莉絲的女兒啊。她住在西風騎士團，還有阿貝多照顧…怎麼說呢，唉…她的「命之座」不愧是象徵著幸運的「四葉草」啊，真羡慕…\\n啊不過，要是我也有這麼好的運氣，首先就不會遇見那個老太婆了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "迪盧克·萊艮芬德。「夜梟」是他的「命之座」，象徵著黑夜中的警覺，和孤獨的守望。在他所認可的白晝來臨之前，他都將孤獨前行。\\n等等，「夜梟」象不象徵財富來著？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於凱亞…",
      "text": "凱亞·亞爾伯里奇嗎？他的「孔雀羽座」象徵著高貴，但同時也象徵著「華麗的掩飾」。他以為已經和過去一刀兩斷。但到了命中註定的那天，他依然必須做出自己的選擇。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於麗莎…",
      "text": "她的「命之座」以「沙漏」為名，象徵著知識、時間與等價交換。一粒沙子落下，時間…或者說生命，就消逝一刹。如果想要止住沙粒奔流，只能平放沙漏，讓它永不流動。唉…簡單來說，就是變著法偷懶啦。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於溫迪…",
      "text": "溫迪？那個成天無所事事的吟遊詩人？咦，他有什麼有趣的嗎？我占卜看看…\\n咦，水占盤怎麼…什麼也看不清，怎、怎麼起風了，眼睛都睜不開了！我的帽子！衣服、衣服要被吹跑了！停下來！我不幹了！我不幹了！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解莫娜·其一",
      "text": "#{F#妳}{M#你}的意思是…想要閒聊？唔，我很少做這種浪費時間的事，而且稿子還有很多沒寫…嗯，不過，對象是{F#妳}{M#你}的話，也不是不行。呵呵，就當是換個心情吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解莫娜·其二",
      "text": "#占卜的收入…？不要用錢財這種…「東西」來衡量占星術！{F#妳}{M#你}聽好了，我的「水占術」可是這片提瓦特大陸上，唯一能窺探到真實命運的占卜術！無論是摩拉還是寶石，都無法用來秤量「命運」！所以，不要再問這種蠢問題了！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解莫娜·其三",
      "text": "#我的占卜術？說了{F#妳}{M#你}也不明白，哼，不過…跟{F#妳}{M#你}解釋一下也不是不行。\\n我使用的是「水占術」。是基於星空映射在水面上的幻象進行推演的占卜術，以水中幻相倒映虛假之天，以此來窺探著世界的真實。這是那個老太婆唯一一個正經的研究成果。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解莫娜·其四",
      "text": "#阿斯托洛吉斯·莫娜·梅姬斯圖斯。這是那個老太婆之前和我一起定的名字，她說這名字的拼寫裡有一些她很喜歡的要素。哼，不過她有時會叫我「梅姬」，和常用的「莫娜」不一樣，更像是小名…喂！{F#妳}{M#你}不能這麼叫！很害羞的！早知道…早知道就不告訴{F#妳}{M#你}了！"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解莫娜·其五",
      "text": "#占卜師有一個禁忌：在占卜時只陳述預言，絕不提出任何建議。以免自己也陷入別人的「命運」之中。但如果占卜對象是{F#妳}{M#你}，那這個「禁忌」就無所謂了。\\n因為，我們的「命運」早就交織在一起了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "莫娜的愛好…",
      "text": "我的愛好？仰望星空。在這個真實得太過分的世界裡，每個人都需要仰望星空，更何況，我還是個占星術士。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "莫娜的煩惱…",
      "text": "儀器修繕費，預訂的星象儀要補款了，學術雜誌的訂購錢也沒交，還有下個月的房租…到底先交哪個比較好。果然還是…先把星象儀的尾款補了，不然被搶購光了就糟糕了…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "沙拉，沙拉是天底下最棒的食物。原料便宜，容易做，飽肚子。而且吃起來很方便，在寫稿或者修理儀器的時候，可以很快吃掉。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "各種…價格很昂貴，吃起來又很麻煩的食物。因為，呃…用摩拉去滿足不必要的食欲，既低俗又危險。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#啊，好滿足——沒想到，認識{F#妳}{M#你}還是挺不錯的嘛。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#我再確認一下。真的是…{F#妳}{M#你}請客嗎？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "我沒有什麼想挑剔的。就是…唔…沒怎麼吃飽。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。這個袋子給{F#妳}{M#你}，裡面有一個幫{F#妳}{M#你}渡過難關的「建議」。別著急打開，在往後的一年之內，這個袋子會有自己打開的機會。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "命中當如此，我早已預知到了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "…再進一步，就能找到世界的真實了嗎？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "虛假之天，星空下的命運早已註定。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "水中之影，漣漪中窺見啟明星升起。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "水中幻願。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "…命運的虛影。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "命運，倒映水中。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "命運，在此顯現。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "命定於此。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "天命既定！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "這樣更能看清星空了…"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "希望這種好事能多來幾次…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "房租和伙食費，都有著落了！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嗚…找到寶物的感覺真棒啊…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "無法判斷…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "討厭的命運…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "還沒…推算到這！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "再硬撐，你就會倒下囉。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "你還沒到命運的終點。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "星空…黯淡…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "無法違抗的…命運…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "推算結束了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "煩人。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "離我…遠點！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "此乃，命運。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "真沒辦法。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "繁星，盡在掌握。"
    }
  ]
}