  "outfits": [
    {
      "id": 204101,
      "name": "星與月之約",
      "description": "莫娜的裝扮款式。為迎接占星術概念中的「命定之刻」而特別購置的衣裝，感謝星象儀補款七折優惠券。",
      "isDefault": false,
      "characterName": "莫娜",
