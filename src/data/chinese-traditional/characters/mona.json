      "filename_splash": "UI_Costume_MonaCostumeWic",
      "filename_sideIcon": "UI_AvatarIcon_Side_MonaCostumeWic"
    },
    {
      "id": 204100,
      "name": "星命流轉",
      "description": "莫娜的裝扮款式。由於縮減了布料用量因而物美價廉的輕便術士衣裝。",
      "isDefault": true,
      "characterName": "莫娜",
