  "outfits": [
    {
      "id": 206400,
      "name": "氍毹煙雲",
      "description": "雲堇的裝扮款式。由飛雲商會的巧手裁縫設計製作的裙裝，被雲堇一眼相中，成為了她最心愛的常服。",
      "isDefault": true,
      "characterName": "雲堇",
      "characterId": 10000064,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Yunjin_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#有道是聞名不如見面，今天終於有緣與{F#妳}{M#你}相會，實屬榮幸。我姓雲，單名一個堇字，不才正是雲翰社當家主事的人。我們戲社最近掛靠在和裕茶館，日後還請多多賞光，常來聽戲。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·敏感話題",
      "text": "這兩天總覺得身上腰封有點緊，難道…我胖了？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·閒適",
      "text": "不勒頭，不畫臉，今天樂得清閒。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·清唱",
      "text": "雲嬋娟來花嬋娟，風流盡在山水間。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#…嘶，{F#妳}{M#你}聽、聽見打雷沒有？嚇我一跳。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "喂呀，凍煞我了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "暖陽和煦，真是好風光呀。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早，清晨露水正好煎茶，喝完這杯茶再出發吧。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午飯吃完之後，想睡一覺…哈…{F#妳}{M#你}不睏嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "一道去聽聽晚場說書吧，劉蘇先生講《裁雨聲》是一絕。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "夜裡寒氣重，早點歇息，晚安。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於雲堇自己·開蒙",
      "text": "我開蒙早，剛記事的時候父親就在教我讀書了。可惜，他的本事要是有十分，我恐怕只學到了三分。寫戲是夠用了，但要和飽學之士相比，還差得太遠。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於雲堇自己·坐科",
      "text": "#我母親早年是璃月港內大有名氣的角兒，我學的戲都是她教的。{F#妳}{M#你}是不知道她有多嚴厲，一想起以前學戲的經歷…不不不，我還是別想了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·搭班",
      "text": "#最近有幾場大戲，正好缺一位擅長舞劍的演員，我覺得{F#妳}{M#你}各方面都挺適合。怎麼樣，有興趣搭班嗎？休息時，還能一起品茶。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·搖滾",
      "text": "#咦，{F#妳}{M#你}還聽搖滾？正好正好，下回我想出去聽演唱會的時候，就找{F#妳}{M#你}一塊去。回來的時候，我就說是拜訪{F#妳}{M#你}去了，這下戲社裡的老人肯定找不到藉口嘮叨我。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "這神之眼嘛…說不定岩王爺也喜歡聽戲呢？大概他老人家聽得開心，就把神之眼送給我了，哈哈。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·飲品",
      "text": "#我最喜歡嘗試各種各樣的飲品。老一輩發明的那些講究茶飲，什麼松間露呀梅上雪的，都讓我試了個遍。現在正愁沒有新飲品可以喝呢，欸，{F#妳}{M#你}有什麼推薦嗎？"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什麼想要分享·心願",
      "text": "我偶爾也想脫下戲服，遠遊海外，去更大的世界看看。為了實現這個心願，得更加努力才行。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "每天天剛破曉就能聽見鶯雀鳴囀，心情總能變得很好。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於辛焱…",
      "text": "戲社裡那幾個老人天天念叨，說是聽多了搖滾會被帶壞，不讓我去聽辛焱的演唱會。嘴上說著為我好，哼，我看他們只是接受不了新事物而已。我才不會聽他們的，辛焱的演唱會我每週都要去，就是這樣。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於胡桃…",
      "text": "胡桃她呀，表情豐富，腦筋還轉得快，哪怕只是聊些家常都能「妙語連珠」。真讓人羡慕。和這樣的朋友在一起，無論做什麼事情都很有趣。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於鍾離…",
      "text": "我們這行的規矩代代相傳，講究多得很。有些事我只知其然，卻不知其所以然。但鍾離先生講起這些竟能如數家珍，有這樣懂行的觀眾，誰不開心呢？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於凝光…",
      "text": "天權星出手闊綽，沒少資助我們戲社。領了她的情，自然也要回報給她最好的演出。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於行秋…",
      "text": "#原來{F#妳}{M#你}也認識行秋。哈哈，他聰明得很，鬼主意那麼多，怕是一不留神就會捉弄{F#妳}{M#你}，可得留個心眼啊。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於申鶴…",
      "text": "《神女劈觀》的劇本我早就唸得爛熟，但直到今天我才知道「神女」原來真有其人，世上緣分果然奇妙。惟願她往後都有好友相伴，不再孤寂。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於刻晴…",
      "text": "我倒沒見過玉衡星來聽戲。印象裡，路邊偶遇這位時，她也總是一副行色匆匆的樣子。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於楓原萬葉…",
      "text": "愛聽戲的外國人士也有不少，這位楓原萬葉就是其中之一。不論台上演的是文場還是武場，他總是安安靜靜地聽，是個規矩的好觀眾。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解雲堇·其一",
      "text": "我們戲社現在常唱的幾齣戲，有不少是我當家之後新寫出來的。寫也是我，唱也是我，一人多職，大概是因為這一點，我在璃月港有了些名氣。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解雲堇·其二",
      "text": "按照傳統，伶人登臺之前要勒頭、畫臉、穿行頭，還有其他一些零碎的準備工作。雖然這樣「全副武裝」之後扮相會更好看，但也累人。所以我能清唱時就清唱，非得彩唱的話，我往往會挑輕便點的行頭。\\n幸好和我們戲社長期合作的和裕茶館管得寬鬆，要不然我真是要累慘了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解雲堇·其三",
      "text": "當初我剛登臺唱戲，憑著觀眾抬愛，不免有些心高氣傲。戲本不喜歡就不唱，戲臺子小了也不唱，觀眾少了還是不唱。現在想來，那時候可真是…太傲慢了…以後萬萬不能這樣。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解雲堇·其四",
      "text": "回想起來，雲翰社傳到我手上也有段時間了。原本我只懂得寫戲、唱戲，從來沒把心思放在經營交際上。做了戲社的當家之後，才不得不在這些事上多長點心眼，因此體味到不少人情冷暖…\\n這時候我才真知道，人生如戲，戲如人生啊。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解雲堇·其五",
      "text": "#璃月多傳說，大都是些魔神、仙人故事，所以璃月戲裡最多的就是神仙戲。最近新演的《神女劈觀》就屬此類。雖然老戲迷們最愛聽的就是這類故事，但如今是「人」的時代，我想多寫些屬於人類的故事，把天下人心唱給大家聽。\\n這些想法，過去我不曾向人提起。多謝{F#妳}{M#你}能耐心聽我說這些。有一知音，我很幸運。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "雲堇的愛好…",
      "text": "愛好？當然是戲了。我是打定主意要唱一輩子的。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "雲堇的煩惱…",
      "text": "煩惱…唉，為了保持體型，我平時一口都不能多吃。人生在世，連美食都不能奢求，真是遺憾哪。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#天樞肉、水煮黑背鱸、乾鍋臘肉…我都想吃。可惜平時基本吃不了，那個…我就隨便問一問，{F#妳}{M#你}…會做這幾道菜嗎？"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "天天都是清炒蝦仁，天天都是…再怎麼做都還是那個味道，我是真的吃膩了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "美食，總會讓人備感幸福…可惜只能點到為止，不能再多吃了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "看著就很豐盛！稍等，我去找些飲品來，配著飯菜一起享用吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "不好意思…這道菜餚呀，我是吃不了多少的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#原來今天是{F#妳}{M#你}的生日嗎？我沒有置辦宴席的本事，只能為{F#妳}{M#你}唱一曲了。不過，這一曲只為{F#妳}{M#你}一個人唱，要聽什麼？{F#妳}{M#你}來定。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "俗語說：「業精於勤而荒於嬉。」"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "勤學苦練至今，總算是有了些成果。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "學槍一事，原先是為了臺上舞槍好看，後來是為了掌握傍身武技。如今這兩個目標都已達到。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#槍術千變萬化，奧妙無比，讓我慶幸的是，練槍時一直有{F#妳}{M#你}相伴。我已經領悟到其中旨要。往後切磋時，{F#妳}{M#你}可得小心了。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "著！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "崩！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "旗來！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "飛雲旗！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "看槍！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "聽我號令！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "戮力同心！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "一鼓作氣！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "我來瞧瞧。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "是旅行中用得上的物資嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#別客氣，{F#妳}{M#你}收著就行。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "別把裙子弄壞了…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "得重整旗鼓才行。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哼，好戲在後面。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你先下場。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我來救場。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "曲終…人散…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "罷了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "沒辦法…唱下去了…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "要沉住氣…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "有點狼狽…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "下手好重…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "走——了——"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "今天該唱哪齣呢？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#{F#妳}{M#你}叫我，我當然要來了。"
    }
  ]
}