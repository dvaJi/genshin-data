  "outfits": [
    {
      "id": 207800,
      "name": "崇理者",
      "description": "艾爾海森的裝扮款式。「別拿沒意義的雜事打擾書記官大人了，他戴耳機就是為了應付這種情況。」\n——緘默之殿工作人員的經驗之談。",
      "isDefault": true,
      "characterName": "艾爾海森",
      "characterId": 10000078,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Alhatham_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是教令院的書記官艾爾海森。想調閱資料的話，請把{F#妳}{M#你}的需求按照格式填好申請表後遞交。\\n還沒整理完？沒關係。我的工作時間貼在辦公室門外，等下個工作日再來吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·工作",
      "text": "書記官的工作很簡單，我就是為此才選擇這個職位。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·讀書",
      "text": "讀書並不會讓人變聰明，看看教令院裡的那些傢伙就知道了。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·思考",
      "text": "嗯…最近亂七八糟的申請表有點多，都駁回吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨天出門是最麻煩的。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#沒什麼可怕的，自然現象而已。除非{F#妳}{M#你}朝大樹下躲過去。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "很冷嗎？我還好。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "這種好天氣，最適合什麼都不做。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "糟糕，鞋裡進沙子了…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "時間還早，我先去喝杯咖啡。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "沒什麼事的話，我要戴著隔音耳機睡一下。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "接下來就是私人時間了，再見。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "希望室友不要半夜敲敲打打做模型…或者他不在家最好。我不想晚上睡覺還得戴著耳機。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於艾爾海森自己·事實",
      "text": "比起辭藻的包裝，我更喜歡用事實說話。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於艾爾海森自己·流言",
      "text": "#哦？聽過不少關於我為人的傳言嗎？很在意？\\n沒必要，因為我也並不在意{F#妳}{M#你}相信與否，只要別徒增額外的事端就好。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·打招呼",
      "text": "要是在街上和我打招呼我卻沒有反應的話，不要見怪。我只是開了耳機隔音而已。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·互助",
      "text": "#{F#妳}{M#你}是自理能力非常強的人，甚至能兼顧身邊的伙伴。我沒什麼要給{F#妳}{M#你}的建議，{F#妳}{M#你}應該也不需要我的幫助。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "說實話，草元素「神之眼」對我的研究幫助不大。不過有了元素力後打人倒是更痛了，所以還算有用。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "真理誕生不是為了服務於誰。人類不是知識的載體，知識也不是人類的目的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "這世上吸引人注意力的東西有很多，不要太相信自己的雙眼。如果所見即為真實，人就不需要思考了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "過於小看或敬畏神明都是不可取的。神明需要信徒，同時神明也是生物鏈中的一環。所以我並不因為參與拯救過神明而自豪，希望小吉祥草王也不必介懷。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於卡維·關懷…",
      "text": "他對所有人和事都抱有過度的關懷心，可能是因為他自己太脆弱了吧，整天大驚小怪的。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於卡維·上當…",
      "text": "有人在路邊擺攤，說只要賣出一個手工鑰匙圈，就會有一個貧困家庭的孩子有飯可吃。卡維買了十幾個回來。\\n在醫療服務都免費提供的須彌…我不多說了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於提納里…",
      "text": "好像很多人覺得他脾氣不夠好，我倒認為有失偏頗。當初卡維把房子建在死域上，弄出很大一個爛攤子，添了不少麻煩給巡林隊。就算這樣這位巡林官也沒有記恨卡維，還願意請他到家裡吃飯…可能就是因為世界上有這樣的好人，才能讓卡維繼續生存下去吧。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於多莉…",
      "text": "她精明又警覺，懂得怎麼把夢想落實到實際，是能把生活過得很好的聰明人。沒有要包庇她的意思，但立場不同並不影響我認可她的生活態度。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於賽諾…",
      "text": "「叢集意識」的案件增加了風紀官們的工作量，但我並沒有什麼心理壓力。說到底，該起事件的根本成因並不在我。賽諾應該也是明白人，後來沒再為這事找過我。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於妮露…",
      "text": "藝術家的優點和缺點都很明顯。妮露在揚長避短方面做得非常好，所以能過得簡單又快樂。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於迪希雅…",
      "text": "能力很強的人，留在鍍金旅團裡有點浪費。要是她能接受我的提議來教令院任職就好了，有這樣的幫手，我們的工作也會輕鬆不少。不過她對安穩的生活不感興趣，我能理解，可惜了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解艾爾海森·其一",
      "text": "大部分人都不會主動跟我接觸，也許是因為忌憚，也許是因為性格不合。對此我很滿意。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解艾爾海森·其二",
      "text": "#我向來對社交不感興趣。如{F#妳}{M#你}所見，我的生活過得比大部分人舒適，這足夠證明社交不是生活的必需品了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解艾爾海森·其三",
      "text": "每個人都應該有自己的主張，並始終保持清醒，不然很容易被各種突發狀況綁架，甚至誤入歧途。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解艾爾海森·其四",
      "text": "一旦秩序被破壞，其後果會迅速蔓延。我不喜歡這樣，會打擾到我現在的生活。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解艾爾海森·其五",
      "text": "下班後我偶爾會去酒館喝一杯。\\n不是想知道這個？什麼，我還以為分享閒暇時間是比分享個人觀點更隱私的事情。畢竟，無論誰都可以在留言板上侃侃而談呢。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "艾爾海森的愛好…",
      "text": "看晦澀難懂的書，欣賞其他人抓耳撓腮的樣子。 \\n開玩笑的，別人的痛苦並不會給我帶來快樂，我也很少碰到讀不懂的書。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "艾爾海森的煩惱…",
      "text": "據我觀察，很多人的煩惱都是自找的。生活中已經有不少難處，就別自添煩憂了。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "美味程度高於美觀程度的。很簡單的要求吧？不然就是本末倒置了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "有湯有水的菜餚很難在看書的時候吃。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "嗯，可以看出對調味配比的精準拿捏。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "是流行的味道，我不討厭。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "不在這吃了。介意我打包回家嗎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。我總覺得人們在慶祝出生這一天上付出了不必要的熱情，不如把這些精力用在讓自己生活中的每一天過得更愉快上來得實際。{F#妳}{M#你}這方面做得還不錯。\\n不知道送什麼禮物好，就預留一次申請表的特別批准給{F#妳}{M#你}吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "謝謝。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "原來不是一次性的。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#在奮進這件事上，{F#妳}{M#你}比我更熱心。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "不能讓教令院那些喜歡偷懶的傢伙知道我又在進步，否則他們會想方設法把麻煩推給我。我當然不會接了，但溝通起來總會浪費點時間。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "接好了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "鏡閃。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "哼。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "散射。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "分光。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "理論的推演。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#{F#妳}{M#你}自己收好。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "動作快，東西掉太遠就難撿了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "哦。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "麻煩的事。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "計畫有變。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "要多花時間了。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我來吧。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "不意外。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "預料之外…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "失策。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我的誤算。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "嘖，誰啊。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "呃…好。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "有事？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "公事公辦吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "不需要太長時間吧？"
    }
  ]
}