  "outfits": [
    {
      "id": 212100,
      "name": "蓬蓬天才工作服",
      "description": "愛諾的裝扮款式。白色大衣在嬌小的愛諾身上顯得尤為寬鬆。大大的袖口似乎是藏寶貝的好地方，甩一甩的話，不知道裡面會蹦出什麼東西呢？",
      "isDefault": true,
      "characterName": "愛諾",
      "characterId": 10000121,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aino_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}是來陪我玩的嗎？嘿嘿，我叫愛諾，擅長機械發明，現在和伊涅芙住在一起。這個世界上所有的甜食我都喜歡，其中最喜歡的是白靈蛋捲！歡迎{F#妳}{M#你}常來我的叮鈴哐啷蛋捲工坊做客。{F#妳}{M#你}呢{F#妳}{M#你}呢？互相介紹完自己，我們就是朋友啦！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·安排",
      "text": "好久沒吃甜點了，腦子像生鏽的螺絲轉不動了…決定了！今天的晚餐我要吃五碟蛋捲！就算伊涅芙進入超級生氣模式也攔不下我。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·牙痛",
      "text": "嘶——牙齒突然好痛。怎麼會這樣？伊涅芙——救救我，嗚嗚…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·玩耍",
      "text": "今天的待辦事項我都交給伊涅芙了，放心放心，我們去找重拳出擊鴨一起玩吧！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "哈啾——鞋子襪子都濕漉漉的，愛諾好想回家…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "天晴了，我們出去郊遊吧，帶著伊涅芙一起！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#呼哈，下雪了！來，這個呱呱雪球機給{F#妳}{M#你}，用它夾雪球的時候會發出呱呱的叫聲哦！很有趣吧？我嘛，就用嘎嘎雪球機好了，我們去打雪仗吧。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "#啊，好大的太陽，這邊的袖子借給{F#妳}{M#你}，擋一擋太陽吧…唔…{F#妳}{M#你}可以蹲下來一點嗎？我已經很努力踮腳了，但還差一點點…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "咦？沙漠裡好像傳來了機械運作的聲音…我們過去找找看吧，好不好嘛~說不定有很多有用的零件，嘿嘿…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#我叫伊涅芙幫{F#妳}{M#你}做好早餐了，是一碟小蛋糕，很甜很好吃哦…呃，嘴角的蛋糕屑是、是…好吧好吧，朋友之間不應該說謊的，對不起，我已經把我的份吃掉了。嗯？{F#妳}{M#你}說還可以分我一半嗎？太好啦！那我的蔬果杯就全送給{F#妳}{M#你}啦！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "二號螺絲…二號…唔，到底在哪裡呢？…算了，伊涅芙——借妳手關節的二號螺絲用一下！哎呀，午飯我待會就來吃，妳先聽話。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#看我發明的餐盤！下達指令後，它們會自動朝{F#妳}{M#你}走過來哦。晚餐，出列！上菜！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#欸…？{F#妳}{M#你}這就要走了嗎…？要、要不要再試試看我發明的咕嘟咕嘟泡茶機？或者再玩一局遊戲！唔…好吧，我們打勾勾，明天也一定要來和我玩哦，不見不散！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於愛諾自己·實用主義",
      "text": "我做機械的零件基本都是我從廢舊物品上拆下來的哦，包括伊涅芙身上的零件也是。垃圾只是放錯地方的資源罷了。不管從哪裡來，只要最後能動起來就沒問題。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於愛諾自己·家長義務",
      "text": "身為家長當然要好好關愛每個家庭成員，所以每次伊涅芙做完清掃工作之後，我都會摸摸她的頭表揚她。當然，別的小機器人工作完之後，我也沒有漏掉表揚。嗯嗯，愛諾真是個好家長！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·喀噠喀噠",
      "text": "#我身後的機械？它叫做喀噠喀噠，是我的小助手之一，搭載的功能非常多！{F#妳}{M#你}要試試看嗎？它很乖，不會咬{F#妳}{M#你}的。來，喀噠喀噠，打個招呼。「喀噠喀噠！」"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·沒吃",
      "text": "#道理我都懂啦…伊涅芙控制我的糖分攝取量，是出於對我健康的關心。但愛諾不是機器人，甜食的誘惑真的很難抵抗啊。我的答案是…只要伊涅芙沒發現就是沒吃！來吧來吧，我偷偷帶{F#妳}{M#你}去吃甜品，我請客，只要{F#妳}{M#你}幫忙瞞著伊涅芙。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#我總想讓伊涅芙多搭載一些功能，為此裝了又拆、拆了又裝，後來在抓零件的時候，摸到了這枚神之眼，我還以為是太久沒休息所以出現幻覺了…欸？{F#妳}{M#你}問伊涅芙的總製作時長嗎？咳咳，這種事情不重要啦，{F#妳}{M#你}只要知道愛諾是天才就行了！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "我一開始取的名字明明是叫「轟隆隆月矩力能量炮」，結果除了伊涅芙，幾乎所有人都只會用「大炮」來稱呼它。唉，算了，反正是功能性為主的發明，我能理解關鍵時候念一長串名字是有點拖泥帶水。看在大家都誇它有用的份上，我就不追求聽起來可愛了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}信不信，只要{F#妳}{M#你}從一數到一百，我就能拆完一隻螃蟹？再數到兩百，我又能把螃蟹復原回去。哼哼，其實拆機械和拆螃蟹也差不多。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於伊涅芙·溫暖",
      "text": "#伊涅芙醒來後，我還陸陸續續幫她做了一些升級，譬如說為她搭載了模擬體溫模組，因為拉手和擁抱就是要暖暖的嘛！{F#妳}{M#你}一定能懂吧？下次我們同時和伊涅芙抱在一起吧？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於伊涅芙·家人",
      "text": "#伊涅芙是我最重要的家人，她能順利回家，甚至連偶爾失憶的小毛病都被修好了，我真的應該好好謝謝{F#妳}{M#你}。對了，不如{F#妳}{M#你}現在就跟我回家吧！我叫伊涅芙…哦不，還是我自己來吧，我下廚做蛋捲給{F#妳}{M#你}吃好不好？還有還有夏槲蛋糕也不錯，{F#妳}{M#你}喜歡吃嗎？欸？{F#妳}{M#你}跑什麼啊…我還沒說完呢！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於雅珂達…",
      "text": "#別看雅珂達總是和伊涅芙拌嘴，其實她們關係很要好！她還是伊涅芙第一次交到的好朋友。作為一位開明的家長，我可不會限制伊涅芙交朋友。而且我知道的，有些朋友之間就是會拌嘴，越吵鬧關係反而越好。哦，差點忘記告訴{F#妳}{M#你}了，她的機械臂雖然現在由我學生在維護，但一開始的製作者是我本人，很漂亮吧？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於菈烏瑪…",
      "text": "#{F#妳}{M#你}喜歡她頭上的角冠嗎？我可以幫{F#妳}{M#你}做一對類似的——對了，要不要安裝發光和開花的功能？或者{F#妳}{M#你}喜歡能綻放煙花的角冠嗎？這些對愛諾來說都是小菜一碟。「霜月之子」會找{F#妳}{M#你}麻煩？好吧，那我也幫他們做就是了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於菲林斯…",
      "text": "他是一位有品位的男士，說出來的話總是很悅耳，就像機械們碰撞發出的叮鈴哐啷聲一樣。這讚譽太高了？好吧，可能稍微有點…但也是實話！不是因為被甜點收買了！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於多莉…",
      "text": "之前她來找我談過合作，哼哼，不錯，她的確是個有眼光的商人，但價格壓太低了啦。伊涅芙說，我為多莉工作一天的工錢都不夠買兩份剛剛出爐的雙果捲。天才也是要填飽肚子的！唉…除非她願意把手頭上那些來歷不明的奇妙機械借給我拆一拆…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於奈芙爾…",
      "text": "奈芙爾姐姐有隻黑貓叫阿舍魯，我曾經提議過要幫阿舍魯裝載一個翻譯器，這樣我們就能知道阿舍魯在說些什麼了。但奈芙爾姐姐想也沒想就拒絕了這個提案，說她知道的情報已經夠多了，不需要再知道一隻貓咪想說的話了。什麼嘛！那麼冷冰冰，她是被菈烏瑪的翻譯傷害過嗎？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "#伊涅芙去找{F#妳}{M#你}們的那段時間，法爾伽大叔偶爾會來陪我玩哦。我想伊涅芙的時候，還被他看出來了，他拍了拍我的頭安慰我。他的大手上都是厚厚的繭，而且還重重的，但是也很溫暖。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於莉奈婭…",
      "text": "莉奈婭姐姐？小時候，她每次出門回來都會和我們講很多好玩的事情，我很喜歡她。等我學會做機械之後，送了一些給她…可惜她都沒有收下，只是告訴我心意她收下了。一定是沒送到符合她心意的款式，接下來我要做更多更多的機械，總有一個會是她喜歡的！"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於布倫妮…",
      "text": "我非常歡迎她！她每次來都會把伊涅芙為她準備的甜點讓給我吃，這樣我就能趁伊涅芙看不到的時候吃掉兩份甜點！欸，布倫妮去了蒙德後還會回來嗎？難得有能認真聽我講機械原理的朋友…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解愛諾·其一",
      "text": "#想知道更多我的事情？當然沒問題！我們來交換吧，我說一個關於我的事情，{F#妳}{M#你}也說一個{F#妳}{M#你}的故事，怎麼樣？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解愛諾·其二",
      "text": "我一點也不討厭預算很低的客人，就算只有五千摩拉也能做很多事情了。比起預算不夠，那些自己無聊又不懂得欣賞的人問題才更大，就算我在他們想要的機械裡加入好玩的功能，他們也只會唸叨著實用性，真是沒救了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解愛諾·其三",
      "text": "#「扳手老爹」？{F#妳}{M#你}從哪裡聽說這個名字的？他是我的老師，他連自己的名字都忘記了，卻還記得所有零件的標準規格。我和他說了我的很多想法，不管多麼奇妙，他都會笑著摸摸我的頭和我說：「好好好，那我就等著愛諾能造出來的那一天。」"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解愛諾·其四",
      "text": "我拼裝出來的第一個機器人叫做叮鈴叮鈴，和我現在的作品完全不一樣，它沒有任何別人眼裡所謂實用的功能，不會說話也不會做家務，很難想像吧？它陪了我很長一段時間，直到它的外殼破損、脫落的螺絲再也沒辦法安裝回去了，我才把它收了起來。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解愛諾·其五",
      "text": "其實最初我選擇製作機器人而不是別的發明，只是希望有人陪我玩而已…我明白人類往往有自己的事情要做，就算陪了我一段時間，很快我也會重新變成一個人，只有機械才是我的歸宿。但有一天伊涅芙告訴我，她把我當作「家人」，我可以相信她…我忍不住哭了，因為我知道機器人是不會說謊的…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "愛諾的愛好…",
      "text": "我喜歡為機械裝上別人意想不到的功能——想想看，可以當做狗狗來遛的掃地機，肯定比普通的掃地機好玩不少吧？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "愛諾的煩惱…",
      "text": "經常有各種零件在我需要的時候找不到，在我不需要的時候才突然出現…我又不可能為每個零件都安裝上自動搜尋功能…試試吸鐵石？唉，我這裡的精密機械太多了，伊涅芙也會被吸過來的…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#如果我有一天變成了機器人愛諾，那{F#妳}{M#你}一定要幫我把供能設定成糖！沒有糖分的日子，那不就成了徹底的苦日子了嗎？我一天都過不下去。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#挪德卡萊有種硬硬的薄餅，{F#妳}{M#你}吃過嗎？跟咬伊涅芙的外殼一樣！最關鍵的是它居然不甜，簡直不可饒恕！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "哇——我要叫伊涅芙把我下週的零食全部換成這個！太好吃了，不如下下週也換吧！還有嗎還有嗎？再讓我吃一份嘛，就一份！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#好吃哦，但是稍微少了點幸福的味道。對了對了，這包砂糖給{F#妳}{M#你}！下次多加點糖，一定會更好吃的！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#唔…吃起來沒什麼味道…不如我幫{F#妳}{M#你}做飯？欸？不要嗎？好吧…那不然我把閒置的蛋捲機器改進一下送給{F#妳}{M#你}吧！稍微給我一點時間。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#{F#妳}{M#你}是不是在等著愛諾給{F#妳}{M#你}驚喜啊？嘿嘿，看！嘰哩咕嚕願望神燈！{F#妳}{M#你}點亮蠟燭，它就會邊唱生日歌邊咕嚕咕嚕地轉起來，好玩吧？喜歡的話，新的一年也要陪我一起玩哦！然後——現在是許願時間，說出{F#妳}{M#你}的願望吧，天才愛諾一定會幫{F#妳}{M#你}實現的！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "嗯嗯，機器人的升級也是這種感覺嗎？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "升級完成。愛諾執行穩定度上升，能量消耗相應增大，請多多準備甜點用以供能。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#{F#妳}{M#你}對天才愛諾的欣賞我已經感受到了，哼哼，很有眼光嘛！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我理想中的家人，恐怕就是像{F#妳}{M#你}這樣的…理解、支持並且陪伴著我…嗯，我沒在難過。接下來相信我就好了，畢竟，還沒有天才家長愛諾解決不了的問題！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "吃我一擊！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "喀噠喀噠！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "嚐嚐這招！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "瞄準你啦。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "預備！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "哼哼！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "快看，有彩虹！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "嘩啦嘩啦水彈！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "灑水時間到——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "我看看，裡面有零件嗎？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "好多東西，伊涅芙在就好了。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "呃…更亂了，對不起！我不是故意的。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "這、這不對啊…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "一點也不好玩！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "犯規了犯規了！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "別鬧，聽我的！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "不怕，還有我！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "嗚…不是這樣玩的…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "好冷啊，伊涅芙…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "蛋捲…還沒吃完…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "壞人！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "沒躲掉…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "痛痛。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "出去玩出去玩。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "到了，放我下去，喀噠喀噠。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "愛諾——到！"
    }
  ]
}