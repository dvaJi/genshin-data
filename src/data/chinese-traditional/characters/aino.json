  "constellations": [
    {
      "_id": 1211,
      "id": "the_theory_of_ashfield_equilibrium",
      "name": "灰與力場的平衡理論",
      "description": "愛諾施放元素戰技<color=#FFD780FF><b>妙思捕手</b></color>或元素爆發<color=#FFD780FF><b>精密水冷儀</b></color>後，愛諾自身的元素精通提升80點，附近的目前場上其他角色的元素精通提升80點，持續15秒。<br/><br/>該命之座提供的元素精通提升效果無法疊加。",
      "level": 1
    },
    {
      "_id": 1212,
      "id": "the_principle_of_transference_in_gear_differentials",
      "name": "齒輪差分的進位原理",
      "description": "元素爆發<color=#FFD780FF><b>精密水冷儀</b></color>中的<span style=\"color:#FFD780FF\">對點水冷域</span>持續期間，若愛諾處於隊伍後臺，隊伍中自己的目前場上角色的攻擊命中附近的敵人時，<span style=\"color:#FFD780FF\">「冷靜一下鴨」</span>將對該敵人發射一枚額外的水彈，基於愛諾攻擊力的25%與元素精通的100%，造成<span style=\"color:#80C0FFFF\">水元素範圍傷害</span>。該效果每5秒至多觸發一次，且造成的傷害視為元素爆發傷害。",
      "level": 2
    },
