  "outfits": [
    {
      "id": 209900,
      "name": "芳草馥奇",
      "description": "艾梅莉埃的裝扮款式。為了紀念一款經典香水的推出，設計師以「能夠觸摸到的香韻」的概念為靈感製作這套翠色裙裝，也成為了艾梅莉埃的收藏之一。",
      "isDefault": true,
      "characterName": "艾梅莉埃",
      "characterId": 10000099,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Emilie_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，我是艾梅莉埃。請問是因為香水設計相關的事宜來找我的嗎？\\n如果是其他事由，還請移步安靜處詳談。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·靈感",
      "text": "突然有了新的靈感…請稍等片刻，容我記錄下來。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·香扇",
      "text": "不少楓丹廷的淑女喜歡將香水噴在小巧的蕾絲摺扇上，扇動時便會有陣陣幽香，的確是十分巧妙的做法。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·報紙",
      "text": "#若{F#妳}{M#你}方便，可以陪我去買一份今天的報紙嗎？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨水會沖洗掉許多痕跡，有時是件麻煩事。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "雷電產生時，空氣中會有一種特別的氣味。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "在這種特殊的地理環境下，會有更珍貴的材料吧。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "太陽真好，希望一切如常。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "即使在貧瘠的沙漠，人們也能從沙蟲的體脂中提取出高級香料。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "我喜歡起床後喝一杯冰水，可以讓自己迅速清醒。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "餐後適當散步有助於促進食物消化和血液循環，想和我一起走走嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "一些調香的原料必須在特定的時間採集，所以有時我需要深夜出門。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#晚安，雖然我有很多助眠香薰可以推薦給{F#妳}{M#你}，但自然放鬆地入睡才是最好的選擇。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於艾梅莉埃自己·分享",
      "text": "#我不算非常健談的人，也不太擅長主動尋找話題，但如果{F#妳}{M#你}有想要分享的故事，無論好壞，我都願意聆聽。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於艾梅莉埃自己·現場清理人",
      "text": "#凶案或事故現場調查結束後，需要有人做收尾和打掃工作——清理人體組織等殘留物、洗去血跡、消毒殺菌…等等，這些便是「現場清理人」的職責。我並不隸屬於楓丹廷的任何組織，正以個人身分從事這項工作，既和警備隊有著長期合作，偶爾也會接私人委託。\\n關於這份工作我要介紹的就是這些了，{F#妳}{M#你}還有什麼想知道的嗎？請問吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·推薦",
      "text": "#想知道我平常最喜歡用哪種香水？可能要讓{F#妳}{M#你}失望了，為了避免其他香味的干擾，我平時工作並不常噴、塗香水。不過請告訴我{F#妳}{M#你}現在的心情，我可以為{F#妳}{M#你}推薦一二。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·參觀",
      "text": "#想參觀我的工作室？當然歡迎。不僅可以教{F#妳}{M#你}簡單的調香方法，還有一個很大的香水收藏庫可供體驗。我母親也是一位香水愛好者，我的收藏中有很多都是她買給我的。如果時間充足，我們可以每瓶都試一下。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我曾想藉助神之眼創造一株無需汲取營養，也能生長的植物。很遺憾，最後以失敗告終。看來哪怕有了神之眼的力量，有些超出自然規則以外的事情還是無法實現的。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "人的五感並不是完全分離的，例如看到紅色會感到溫暖——香氣也有類似的規律，這種規律大多會被用在推銷上。當顧客心情低落時，就很容易被推薦具有芳草香或蜜甜香的香水。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{M#沒有什麼比新鮮事物更能引發人的興趣了。你遊歷諸國，見識之廣一定非我能及，可以向你提一個請求嗎？你是否見過令你印象深刻的香料或花卉？能否告知與我？\\n「因提瓦特」…如此宏大的名字，我從未聽說過。嗯，我記下來了，如果我有緣見到這種花，一定馬上聯絡你。}{F#可以請問妳一個問題嗎？妳頭上的花…我此前從未見過。妳將它製成頭飾始終佩戴著，那它對妳來說一定意義深刻吧？\\n「因提瓦特」…聽起來是如此宏大…能夠取得這種花的妳，對這個世界來說應該是十分重要的存在吧。}"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於夏沃蕾…",
      "text": "#不知她有沒有向{F#妳}{M#你}提過我們是工作認識的？不過大部分時間我們並不會特別嚴肅地對話，記得有次她看了一本小說，講的是有人使用人體組織製作香水的故事。按照書中的想像，最後的成品是驚為天人的傑作，但以我的經驗，實際上大概不會有這麼美妙的結果…\\n不過夏沃蕾的重點不在這裡，她當時正在努力盤算其中各方應當承擔的法律責任呢。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於千織…",
      "text": "千織小姐是位對流行趨勢很敏銳的設計師，儘管我們的工作內容完全不同，我還是很喜歡聽她介紹服裝設計的想法與創意。她選香水的眼光也很不錯，經常在試做樣品的階段就挑中了上市後會大賣的那款。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "這是一位活力四射的小姐哦。會有不少人覺得她很「麻煩」吧？但這位記者小姐在知道了我的真實工作後卻沒有到處傳播，這並不是她必須要幫我的忙，甚至與她的職業需求有所衝突，所以我對她印象不錯。如果她需要幫助，我是不會拒絕的。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "楓丹廷大概沒有人不知道這位實力頂尖的決鬥代理人吧？但我不覺得克洛琳德小姐會不好相處，越是武力強大的人，反而越不抗拒溝通。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於希格雯…",
      "text": "如果沒記錯的話，希格雯小姐應該在我還不懂事的時候就見過我了…對了，我是不是沒說過？因為家父就職於逐影庭，我家常有美露莘來做客，聽說我出生後被很多美露莘小姐們關照過。\\n不過希格雯小姐並沒有把我當後輩看待，還對我的香水一直讚賞有加。我做新的樣品時，常常會多留一份給她。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "調香師在嗅覺疲勞時有一種很簡單的緩解方法——就是飲用清水。我對水的品質並無苛刻的要求，但出於好奇，我參加過一次那維萊特先生舉辦的品水會。\\n他對每種水的特徵都有著縹緲卻又十分獨到的見解，就像雜誌上對香水的評價文章一樣。他在瞭解我的需求後，向我推薦水源的態度也十分真誠。出於敬重，我時不時會專門購買他推薦的種類。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "#{F#妳}{M#你}認識萊歐斯利先生？呵呵，{F#妳}{M#你}果然不是普通人。據我所知，這位公爵大人十分低調，甚至不太有人知道他的存在。那維萊特先生曾想將我引薦給他，不過他似乎表示梅洛彼得堡沒有需要我工作的場合。\\n我從未當面見過這位先生，對他自然不甚瞭解，但恕我冒然揣度…也許他是不想將某些痕跡清洗得太過乾淨，藉此留作警示吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於提納里…",
      "text": "我和他見面得不多，但常有書信往來。一開始是他不知透過什麼管道輾轉聯絡到我，字裡行間十分客氣。一位知名植物學家向我請教花卉知識，著實令我受寵若驚。不過我也就此抓住機會，向他諮詢了很多關於須彌香料的知識，他都幫我一一解答了。\\n現在我們之間的書信就隨意了很多，他還時常提起他身邊的同伴們，我很開心能夠透過這樣的機會結交到更多有趣的朋友。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於愛可菲…",
      "text": "愛可菲小姐是位勤奮好學的大廚。能將枯燥的調香知識聽得津津有味，已屬難得。她還擅於總結和歸納事物之間微小的連結，擁有著將各類知識迅速應用於實踐的行動力。有人羨慕地稱她為楓丹烹飪史上的「天才」，我絲毫不懷疑她成功背後的緣由。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解艾梅莉埃·其一",
      "text": "人們常為香水賦上浪漫與詩意，但實際的調製過程卻與科學緊密相關，本質上和化學試驗並無二致。如何做好這兩者間的橋樑，就要看調香師的本事了。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解艾梅莉埃·其二",
      "text": "人也許能說出香味帶給自己的感受，但很難依照文字描述精確反推出那種氣味的原貌——我也不例外。所以很抱歉，我不接訂製工作，但如果我調製的那些香水中能有一款合顧客的心意，那將是我莫大的榮幸。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解艾梅莉埃·其三",
      "text": "一款香水在出品前需要經歷一系列測試，其中一項便是閒置試驗。可以存放多久？是否容易變質？會不會在一段時間後產生有毒物質？或是直接消散殆盡？\\n話說到這裡，有沒有覺得人與人之間的關係也需要這種檢驗呢？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解艾梅莉埃·其四",
      "text": "我沒有刻意隱瞞過我真正的職業，但還是傾向於不要太過聲張。並非擔心買香水的客人們對我的作品心生疑慮，而是現場清理人的工作會接觸很多不便公開的資訊，委託方因為信任才將工作交到我的手中，我自然也不希望害他們引來不必要的關心。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解艾梅莉埃·其五",
      "text": "調香始終是我的一項愛好。就像有人會在業餘時間學習某種樂器、有人會製作手工藝品，調香對我來說也是如此。\\n不過，我的人生目標的確發生過轉變。我的母親是一位專業法醫，我從小也希望能夠和母親一樣從事和刑偵有關的工作，我非常擅長與化學相關的學科，曾想成為一名痕跡鑑定專家。不過隨著學習的持續深入，我接觸到了一些真實的事發現場。曾有一名孩童慘遭殺害，血液浸透地毯與牆紙，警官調查後結案離開，但孩子的父母要以什麼樣的心情收拾房間呢？\\n就這樣，我開始了這份工作。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "艾梅莉埃的愛好…",
      "text": "我喜歡剪報，將我覺得不可思議的事件報導收集起來，慢慢有了好幾個厚本子，翻起來就像夏沃蕾喜歡的那種短篇小說集一樣。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "艾梅莉埃的煩惱…",
      "text": "公園裡的小狗們都非常熱情。想要感受牠們柔順的皮毛，往往得先縱容牠們的熱情。呵呵，真是甜蜜的煩惱。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#新鮮蝦肉用撒過海鹽的水煮熟，再沾上融化的奶油，簡單又美味，{F#妳}{M#你}也可以試試看。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不常吃紅肉，還請見諒。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#味道和聞起來一樣好。謝謝{F#妳}{M#你}願意與我分享，我很喜歡。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "嗯，色澤不錯，口感也很好。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "原來有人喜歡這種味道…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。雖說香味是種十分私人的喜好，但我還是冒昧為{F#妳}{M#你}選擇了一瓶香水，是我的個人作品之一，並未在市場上販售。\\n我盡力融合了這段時間內自然界特有的花香與果香，這不是一款個性十分突出的香水，我衷心希望這瓶香水能夠陪{F#妳}{M#你}度過一段和緩又安逸的時光。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "非常感謝。無需推辭，這是必要的禮節。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#謝謝{F#妳}{M#你}的提議，為我提供了更多方向。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#能力要掌握在正確的對象手中才能發揮作用，希望我不會辜負{F#妳}{M#你}的信任。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#很多事物必須要在強光下才能讓人看清，而{F#妳}{M#你}現在將這束光交到了我的手中，是想邀我同行的意思嗎？那麼請吧，我就在{F#妳}{M#你}身邊。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "重組。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "單離。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "清理開始。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "芬馥之語。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "霧散吧。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "予我輝光。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "呵呵，是符合期待的收穫嗎？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#需要我幫{F#妳}{M#你}收納嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "似乎沒留下失主的資訊…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "嗅覺疲勞了…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "難道是過敏反應？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "需要重新評估現場。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "放鬆。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我在。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "泥土的氣息…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "如燈之熄…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "到我了嗎…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "我的破綻。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "防備不足。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "理應更加謹慎。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "榮幸之至。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#向{F#妳}{M#你}致意。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#感謝{F#妳}{M#你}出面邀請。"
    }
  ]
}