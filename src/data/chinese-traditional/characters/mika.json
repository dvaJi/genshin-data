  "outfits": [
    {
      "id": 208000,
      "name": "高飛信標",
      "description": "米卡的裝扮款式。為野外作業特別設計的這款騎士裝束大量採用柔韌布料，並增添了收納武器與工具的位置。祝穿戴者一路順風！",
      "isDefault": true,
      "characterName": "米卡",
      "characterId": 10000080,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Mika_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#西風騎士團游擊小隊所屬，前進測繪員米卡，向{F#妳}{M#你}報到。與{F#妳}{M#你}並肩作戰是我的榮幸，請隨意差遣我吧…我會竭盡全力，為{F#妳}{M#你}探清前路，查明敵情！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·目標",
      "text": "趕快調整好狀態，不知道下個任務什麼時候會來。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·記錄狀況",
      "text": "核對目前位置、向目標扇形區域測距…嗯，地理狀況記錄完畢。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·探明道路",
      "text": "無論處在什麼環境裡，只要仔細探索，應該都可以找到通順的道路。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "好大的雨…希望地面不要變得泥濘，不然就要幫大家擦靴子了…做飯的時間要不夠了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "雷聲可以掩蓋行動的聲響，是我們的好朋友。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "積雪很漂亮，但又會把原來的地貌覆蓋掉，我不太喜歡。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "陽光柔和，視距充足，觀察條件良好。嗯，心情真舒暢！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "這風…是出自風神的旨意，還是地形對大氣的作用呢？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "哦！早啊，我準備了遠征隊常吃的早餐，不介意的話，請一邊用餐，一邊和我說說今天的行動計畫吧？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "請稍等，游擊小隊最愛的三號野戰午餐很快就準備好。等等我再看看，附近有沒有適合午休的地方。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚飯完成了，雖然還是行軍餐，有點簡陋…但提供的營養肯定足夠，請不要介意…如果有需要維護的裝備，也請交給我吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#時間還早，我要整理一下今天的勘測紀錄。行軍床已經準備好了，請{F#妳}{M#你}先休息吧。等到{F#妳}{M#你}的精力恢復，宵夜應該也做好了，到時候，我們可以輪替值守。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於米卡自己·工作",
      "text": "前進測繪員？這個崗位的職責是率先進入未知的區域，探明地形，尋找最有價值的陣位，有時還要對付敵方的哨兵。所以，除了測繪地形，我也得掌握戰鬥、醫療和野外生存的技巧。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於米卡自己·瑣事",
      "text": "搭建營帳、生火做飯、維護裝備，這些事總得有人來做嘛。如果別人嫌這些事麻煩，而我做得還勉強合格，那我至少可以…讓大家輕鬆一點，開心一點？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·傳聞",
      "text": "#對不起，剛回蒙德那幾天，我聽說了{F#妳}{M#你}們的事蹟。像{F#妳}{M#你}和派蒙這樣的超級強者，總有自己獨特的原則。有些強者的脾氣不太好，也許我說錯一個詞，就會讓他們不高興…好險{F#妳}{M#你}們都很和善，我根本不用擔心！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·暗語",
      "text": "#有的前鋒會用「奧克塔維」表示「弩箭耗盡，正在返回營地」；用「薇拉」表示「狀況良好，可以交戰」。要不然，我們也約定幾個暗語？畢竟我們會長期合作，這樣更方便。哦，{F#妳}{M#你}說了算，我都聽{F#妳}{M#你}的！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "說實話，能夠得到「神之眼」，我也很吃驚。它的確能為我提供不少幫助，但我不能依賴它的力量，而是要把它當成一種保險手段。作為騎士團的一員，我更應該重視團隊合作，想辦法和同伴們一起戰勝困難。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#有個簡單的測距法，應該對{F#妳}{M#你}們有用：伸直手臂，豎起拇指對準目標，分別用右眼和拇指的軸線對準目標的左側，左眼對準目標右側，把兩側間的距離乘以一個數，就能提前確認山有多高，河有多寬，能不能一口氣爬上山頂，游到對岸。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "聽可莉前輩說，世上有種傳遞聲音的植物，要是這種植物可以能夠隨身攜帶就好了。這樣一來，我就能即時彙報地形情況，甚至待在前方，為後方的同伴提供指引，用弩箭遠遠地拋射，早早排除威脅。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於凱亞…",
      "text": "入團之前，我接受了許多測試，主考官就是凱亞隊長。凱亞隊長一直支持著我，給我各種建議…不過，有時我不太理解他的話，擔心自己跟不上他的節奏，讓他掃興。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於法爾伽·教誨",
      "text": "法爾伽大團長是萬分可敬的強者，也是我在戰鬥方面的老師。他覺得我個子小，體力沒優勢，教導我「打架的理念要靈活」、「避免和敵人短兵相接」。所以，我才學著用長槍和手弩對付敵人，這樣的戰法的確更適合我。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於法爾伽·隊長",
      "text": "大團長還說，我要樹立更高的目標，不斷磨練本領，我一直是這麼想的，但直到遠征期間，我才明白事情的嚴重性。有一天，我們遇見了自稱「隊長」的愚人眾執行官。我完全沒法想像，該怎麼招架那樣的對手。強者的境界，對我來說實在太遙遠了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於琴…",
      "text": "副團長…代理團長是讓人安心的好前輩，一直守護著大家的強者。在工作排期、戰地醫療，還有下廚這幾個領域，我能向她學習的東西，根本無窮無盡。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於安柏…",
      "text": "安柏長官…安柏前輩是最可靠的前鋒，偵察領域的強者！前進測繪員和偵察騎士的陣位很接近，總是先於主力部隊行動。安柏前輩的經驗太豐富了，我從她那裡學到了很多野外生存的技巧，還有維護弩弦和箭矢的訣竅。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於優菈·任務",
      "text": "優菈隊長是戰鬥風格獨樹一幟的強者，她一直很照顧我。我剛剛入隊時，她就幫我安排各式各樣的任務，數量是其他隊員的好幾倍，更快地鍛煉了我的適應力。只要習慣了她的表達方式，和她相處起來就很愉快！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於優菈·作風",
      "text": "其實，我很羡慕優菈隊長，她為人友善、作風灑脫，內心特別強大。要是我也被別人用奇怪的目光盯住，還在背後不停議論，我大概會不敢出門吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於麗莎…",
      "text": "在我自學測繪的時候，麗莎長官一直在幫我，為了我找到好多有用的書，要是我也像她那樣博學就好了。知識總是不嫌多的，也許哪天就能用到呢？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於可莉…",
      "text": "可莉前輩？她的性格特別開朗，好像還是…和大團長旗鼓相當的強者？她好幾次邀請我一起冒險，我們玩得超開心！雖然她偶爾會試驗厲害的武器，讓我重畫很多地方的地圖…不過，我也覺得很值得！"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於溫迪…",
      "text": "好喜歡那位吟遊詩人，他是演奏樂器的強者，他的曲調總讓我有種回到家裡的親切感。如果要選出最能代表蒙德的曲子，我一定投他的作品一票。可惜我平常待在城裡的時間不多，不然就可以每天送他一些禮物了。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "阿貝多長官對我有恩，我常用的測繪裝備就是他幫我製作的，還有一種繪圖筆，就算倒掛在樹上，也能正常使用。嗯不過，測繪地圖和畫畫好像並不相通？之前我對著目的地區域畫過幾張寫生，作為補充的情報，聽說阿貝多長官看見之後，沉默了好久。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於洛恩…",
      "text": "#{F#妳}{M#你}看見洛恩了嗎？我現在才發現我的筆記本跟他的互換了，而他一大早又不見了。唉，他肯定是一個人衝去魔物聚集點了…明明說過這樣做很危險的…要是我也是「隊長」就好了，那樣我說的話他就會聽了…呃，會嗎…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解米卡·其一",
      "text": "#我自己的事？我只是個普通人，沒什麼有趣的故事。如果只聊我以前的經歷，{F#妳}{M#你}願意聽嗎？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解米卡·其二",
      "text": "從小時候起，我就想當一個地圖測繪員，描繪出提瓦特每個角落的輪廓。後來我發現，騎士團正好有這樣的崗位，就在哥哥和爸爸的支持下參加了選拔，當上了前進測繪員。這份工作讓我過上了理想中的生活，我已經心滿意足了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解米卡·其三",
      "text": "騎士團的大家都好強，每個人都有值得我學習的地方。我從大家身上學到了新的本領，也應該給大家回報，如果大家有需要我的地方，我都會盡全力幫忙。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解米卡·其四",
      "text": "不過，幫大團長和優菈隊長跑腿過幾次後，有的同伴已經把我當成兩位長官的信使了。如果我說錯了話，給兩位長官帶來了困擾，那可就是我的過錯了。所以，每次和不太熟悉的同伴交談，我多少都有點拘束，讓大家覺得我很膽小，這算是一種誤解嗎？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解米卡·其五",
      "text": "好在經歷過遠征後，我沒那麼擔心了。只要不給其他人添麻煩，就算大家對我有什麼看法，我也不會介意。騎士團就像是我的第二個家，我要把前進測繪員的工作做到完美無缺，讓我的家人們平平安安地完成任務，輕鬆愉快地度過每一天。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "米卡的愛好…",
      "text": "愛好嗎…除了工作，我最喜歡的應該是…在陌生的地方露營了。沉浸在新鮮的美景裡，搭一個舒舒服服的營地，升起篝火做一頓好吃的飯菜，真的很愉快！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "米卡的煩惱…",
      "text": "#說實在的，我不擅長和陌生人打交道，也許是我不懂說話的技巧吧。這方面的訣竅，能請{F#妳}{M#你}教一教我嗎？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "大團長說，我這種年輕人就該多吃肉，把力量和體能練得棒棒的。雖然我怎麼也不可能長出一身結實的肌肉啦，但我確實很喜歡肉類料理，這一點倒是和游擊小隊的大家很一致。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "不像我的哥哥，我完全欣賞不了酒的風味，只要喝上一小口，我就會醉得不省人事，給大家添麻煩。碰上有的陳年烈酒，光是打開瓶塞後的氣味，都能讓我腳步發晃。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "太感謝了，這道料理實在太珍貴，我怎麼捨得吃！可以把它收藏起來嗎？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#口味和份量都無可挑剔，讓{F#妳}{M#你}為我費心了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#唔…不管怎麼樣，這可是{F#妳}{M#你}為我做的飯菜，我一定會吃完的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#這種時候應該怎麼說才好呢…嗯，今天是最特別的日子！應該用最熱烈、最盛大的方式來慶祝！我為{F#妳}{M#你}準備了一本「蒙德絕景遊覽手冊」，手冊上記錄了很多風景優美的地點，但沒什麼人知道這些地方哦。希望{F#妳}{M#你}從今天到明年的今天，每天都開開心心！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#雖然比起{F#妳}{M#你}還差得遠，但我現在有一點信心了，至少不會再拖{F#妳}{M#你}的後腿。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#希望我能為{F#妳}{M#你}帶來更多有用的情報，真真切切地幫{F#妳}{M#你}分擔壓力！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#請允許我…一直和{F#妳}{M#你}同行，一起丈量腳下的大地！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "實在感謝！這下，我就距離目標更近了——讓大家安安心心地前進，不必在崎嶇的地形受苦受累，也不用懼怕角落裡隱藏的危險！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "速射牽制。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "試探攻擊。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "請你後退。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "精確射擊！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "對不起了！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "肅清威脅！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "大家，請振作！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "我負責醫療！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "打開突破口！"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "從高處觀察…"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "是新的收穫！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "有戰利品嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "找到了寶藏，恭喜大家！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "有點麻煩…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "要改變戰術嗎？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "對手…很強啊。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "請後撤，我來頂住！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "要快點治療…"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "早知道…就迂迴了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "對不起，大家…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "完了…我搞砸了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "要忍住！"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "沒問題的！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不痛…不痛！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "不能慌張…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "清點裝備…一切就位。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "嗯，長槍和弩箭都準備好了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "我…我來為隊伍探路！"
    }
  ]
}