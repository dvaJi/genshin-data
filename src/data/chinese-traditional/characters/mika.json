  "passives": [
    {
      "id": "suppressive_barrage",
      "name": "速射牽制",
      "description": "在下列情況下，<span style=\"color:#FFD780FF\">星霜的流旋</span>的靈風狀態將獲得偵明效果強化，使角色處於場上時，造成的物理傷害提升10%：<br/>·霜流矢命中超過1名敵人時，每額外命中1名敵人就產生1層偵明效果；<br/>·冰星破片命中敵人時，將產生1層偵明效果。每枚冰星破片只能觸發1次。<br/><br/>靈風狀態的偵明效果至多疊加3層，在持續期間內重複施放星霜的流旋時，將移除原有的靈風狀態與其偵明效果。",
      "level": 1
    },
    {
      "id": "topographical_mapping",
      "name": "地貌測繪",
      "description": "同時處於<span style=\"color:#FFD780FF\">蒼翎的頌願</span>的鷹翎狀態與<span style=\"color:#FFD780FF\">星霜的流旋</span>的靈風狀態下的目前場上角色，在攻擊造成暴擊時，靈風狀態將產生1層突破天賦「速射牽制」的偵明效果。在一次靈風狀態的持續期間內，依此方式至多產生1層偵明效果。<br/>此外，靈風狀態下偵明效果疊加層數上限提升1層。<br/>需要解鎖突破天賦「速射牽制」。",
      "level": 4
    },
    {
