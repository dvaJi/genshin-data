  "outfits": [
    {
      "id": 205200,
      "name": "御建鳴神主尊之典",
      "description": "雷電將軍的裝扮款式。因以「雷之三重巴」紋為飾而獲得無上地位的尊崇著物。",
      "isDefault": true,
      "characterName": "雷電將軍",
      "characterId": 10000052,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shougun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#無須行禮，此身雖然尊貴殊勝，不過此般前來，是想要做些微服遊歷民間的事。我看上了{F#妳}{M#你}的身手，現在{F#妳}{M#你}就是我的御側保鏢了。不用擔心，遇到危險，我會出手的。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·徒然",
      "text": "徒然無事，對硯枯坐。哼。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·浮世",
      "text": "浮世景色百千年依舊，人之在世卻如白露與泡影。虛無。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·花鳥餘情",
      "text": "無人相陪，此般花鳥餘情，也不過襯托我身不移不變的背景罷了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "只是雨滴有什麼麻煩的。這還沒有打雷呢。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#哎呀，{F#妳}{M#你}不會怕了吧。明明此世最為殊勝最為恐怖的雷霆化身就站在{F#妳}{M#你}身邊。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "冬將軍也來了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "晴天的時候…",
      "text": "#天晴也並不能掩蓋雷霆的威光。不下雨也可以降下神雷，看到那棵樹了嗎？{F#妳}{M#你}說{F#妳}{M#你}懂了，叫我停手。好吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#道完早安就打呵欠，太懈怠了。我這次就赦免{F#妳}{M#你}的無禮了。早安。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "啊，想吃甜點心。嗯，為什麼不行？什麼叫「哪有這個時間吃甜品的」。之前是因為他們看我是將軍所以慣著我的？這樣啊。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#{F#妳}{M#你}想知道夜晚流星的真相嗎？哈哈，真相就是縹緲須臾的一瞬天光罷了。嗯，{F#妳}{M#你}說其實是{F#妳}{M#你}？{F#妳}{M#你}也是天狗嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#我命十方世界雷鳴平息，願{F#妳}{M#你}今晚得享安睡。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於雷電將軍自己·須臾",
      "text": "雷鳴閃電，一瞬即逝。正因如此，才會想要擷取「永恆」。不，才必須掌握「永恆」。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於雷電將軍自己·永恆",
      "text": "「磨損」是一件很可怕的事情。此身誕生的意義，就是承受磨損。這樣，或許「內在」就可以觸及永恆了吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·奧詰眾",
      "text": "#現在{F#妳}{M#你}是我的側用人，換言之，依我判斷，{F#妳}{M#你}是對幕府有用，對我忠誠的人。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·用心棒",
      "text": "雖然是微服出訪的保鏢，但是我遇到危險不用替我擋刀了。將軍她構造還挺結實的，壞了還能替換呢。所以遇到危險把將軍她推到前面就好了。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·直傳",
      "text": "#稻妻的薙刀術和劍術以及鍛刀技法，基本都是由我直接傳下的，隨後因人資質不同而分枝開花、各自結果。\\n如何，再接我一刀？還能無事的話，許可{F#妳}{M#你}在稻妻開宗立派哦。啊，武藝的精進真是叫人欲罷不能。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "外面的世界居然已經這麼久沒有出現過雷元素的神之眼了嗎？雖然我因為一些制約無法說明…賜予神之眼這件事，和我的意志無關。重要的，還是人的「渴望」，以及…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#有什麼想要分享的？沒有。倒是{F#妳}{M#你}，為什麼沒有神之眼卻能使用元素之力。和我說說。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "雖然身消夢隕，但是她化作了神櫻。這，也是「永恆」。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於八重神子…",
      "text": "那傢伙啊，最初她就是個會被油豆腐引誘的傢伙。現在居然這麼工於謀略了，讓人欣慰。不過被她算計了，還是有些不愉快。雖說是為了我好，下次見到她恐怕會被她嘲笑的…那就先發制人，斬她一刀好了。反正她也能躲掉。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於神里綾人…",
      "text": "神里一門，無愧於稻妻名門筆頭之格。綾人雖然此前在三奉行事務中，耍了不少手段，但是本身忠心可鑒。既往不咎了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "#神里一門，無愧於稻妻名門筆頭之格。欸，{F#妳}{M#你}說我和將軍的評價一模一樣。那…綾華她、她劍術也很好。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "忠義之士，武藝精湛，可擔「豪傑」二字。有此麟兒，九條家應該還能興盛下去吧。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於宵宮…",
      "text": "是誰來著？啊，做煙火的。製造須臾幻象的人，沉醉於夏日幻覺的人，雖說如此，亦為我之臣民。\\n嗯，在天領奉行屬地裡放煙花？誰啊，她嗎？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於托馬…",
      "text": "雖然差點奪走他神之眼這件事，我也不能說是完全沒有責任。但要說道歉的話，還是應該讓將軍她去比較好吧…好吧，我也會好好反省的。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於珊瑚宮心海…",
      "text": "奧羅巴斯確為此身所斬。但是我也許可了珊瑚宮之民，以海祇大御神之名繼續祭祀，讓牠得享牲醴。現在珊瑚宮搗毀鳴神分社，反叛幕府。她作為海祇大御神的現人神巫女，必須要承擔責任。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於國崩…",
      "text": "那小子是製造將軍的副產物。對他不加以管束，應該是因為我內心還是覺得對他有所虧欠吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "誰？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於摩拉克斯…",
      "text": "曾經與他共飲之時，我還只是一介影武者，敬陪眾神末席。他做出了這樣的選擇是嗎？不過，我想他在下一個時代，仍然會繼續和更多的人相遇吧。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於溫迪…",
      "text": "風神的化身現在還叫這個名字嗎？說實話，第一次見他就感覺他渾身透著和我一定相處不來的氣質。然後就是，他的確很能喝酒。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於布耶爾…",
      "text": "我很欣賞她的謙遜，謙遜也的確是智者的美德。她的權能理應可以做到許多超乎想像的事，但布耶爾只是將它用在「糾正與守護」之上…真是個溫柔的神明。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "#「雷電將軍」曾與我在意識世界中進行數百年的決鬥，以確定我的意志不曾動搖。而{F#妳}{M#你}所說的這位芙寧娜，雖是人類之軀，但五百年間的表演也無異於每時每刻都在進行精神上的「實戰」。我認可她，此等意志，可謂已臻神境。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於赫布里穆…",
      "text": "五百年前我抵達坎瑞亞之時，曾在戰場上見過不亞於無想刃狹間的大片焦土，我聽聞那就是火神的憤怒。時至今日，我竟然還有和這樣一位人類見面的機會…可否為我引薦一番呢？作為「武人」，我想前往適合的空曠之地，與她交流一些心得。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於夢見月瑞希…",
      "text": "夢見月瑞希是神子的舊識，不過，我有些看不明白她們兩位的關係…既是彼此無可替代的友人，又不願將感情置於檯面。總是為某些計畫相持不下，想要決出高低…鑑於這些計畫的核心都是幫助民眾享受生活，我便不多說什麼了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解雷電將軍·其一",
      "text": "有什麼事情，說來便是。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解雷電將軍·其二",
      "text": "民間都相信，雷雨天口唸「桑原桑原」，便可以無恙。如是因我一念而起的雷暴，必不會加害於你。但是自然天氣形成的雷雨就難說了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解影·其三",
      "text": "《珍說》一書所言大致都是真的。那時她正忙於周旋島內之事，於是我作為影武者，假託她名出現在了平定海祇的軍陣中。但是後面的劇情，就只是人們的一廂情願罷了。我原本只是醉心劍技的武人，沒有那種感化萬民的德行。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解影·其四",
      "text": "追求「永恆」可能也只是一種逃避罷了。最後我採取的方法也和縮頭烏龜一樣。不過烏龜本來就是長壽的象徵，說不定追求永恆就是會變成這樣的形態。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解影·其五",
      "text": "#恐懼是因為我在五百年前目睹了她的消亡和「那個事物」。但，如果…如果是{F#妳}{M#你}的話，一定可以拯救所有人的。如果是{F#妳}{M#你}的話，一定會拯救世界的。就像是我記得稻妻的一切一樣，只要{F#妳}{M#你}記得我，我就能永遠地活著。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "雷電將軍的愛好…",
      "text": "愚問。只有必須要做的事情，和一定不能做的事情。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "影的煩惱…",
      "text": "#{F#妳}{M#你}不要讓我做飯啦。我什麼都能辦到，但是真的不會做飯。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#{F#妳}{M#你}別聽將軍她的。甜點心！蛀牙什麼的，換一套就好了。這怎麼會影響對永恆的追求呢。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "愚問。只有維持身體營養必須吃的，和會損害身體的。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "熟悉的味道。不壞。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "放在這裡吧，我會嚐的。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "會損害身體機能，拿走。"
    },
    {
      "id": "6010",
      "type": 1,
      "title": "收到贈禮·其四",
      "text": "#好吃。心情也放鬆了不少，謝謝{F#妳}{M#你}。"
    },
    {
      "id": "6011",
      "type": 1,
      "title": "收到贈禮·其五",
      "text": "看起來不錯，是怎麼做出來的？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "收到贈禮·其六",
      "text": "恕我謝絕。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生辰…",
      "text": "#今日是{F#妳}{M#你}的生辰之日嗎？隨我回城，我來對全體旗本眾宣讀祝詞吧。嗯？「太丟人別這樣。」…好吧。"
    },
    {
      "id": "7002",
      "type": 1,
      "title": "生日…",
      "text": "生日快樂！那今日就一起慶祝吧，使之成為可以銘記一年的美好瞬間。然後等到來年今日，便繼續慶祝。如是便可得「永恆」的快樂。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我之流派裡，「初傳」之位，可以學習太刀的九向劍路之勢，以及薙刀術的基本。與其他流派並無大差異。應該說，其他流派與我之流派並無差異。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "我之流派裡，「中傳」之位，太刀術需要研習各種「構」位與變化，薙刀術則需熟練諸「切」與「返」之理。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "我之流派裡，「皆傳」之位，需要研習諸般奧義。無奈大部分都需要配合元素之力，對凡人來說可能有些太難了。世間其餘流派大多都無法觸及此境。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#奧義中的奧義，也就是「無想」又無雙的一刀。有{F#妳}{M#你}作為陪練之賓，我好像能揮出更強更快的一劍。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "威光無赦！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "無處遁逃！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "泡影看破！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "無念，斷絕！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "此刻，寂滅之時！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "稻光，亦是永恆！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "收下吧，於我無用。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "…不過須臾之夢。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "嗯？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "…枷鎖當斷。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "…諸惡當斬。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "…肅清阻礙。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "至我後方待命。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "退下。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "浮世一夢…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "無念，無執…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "雷鳴，將歇…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "無禮…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "荒謬…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "有什麼事？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "隨我左右即可。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "出征之時已至。"
    }
  ]
}