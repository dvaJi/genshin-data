  "passives": [
    {
      "id": "the_last_djeguako_songstress",
      "name": "最後的塑詩者",
      "description": "施放元素戰技<span style=\"color:#FFD780FF\">宣敘·晨聲紛流</span>時，將使目前場上的星輝風旋轉化為「流蕩風旋」，且隊伍中附近的角色在<color=#FFD780FF><b>遙久之歌</b></color>效果持續期間觸發星擴散反應時，將取代星輝風旋創造流蕩風旋。<br/>創造或引爆流蕩風旋時，還會使附近敵人的<span style=\"color:#80FFD7FF\">風元素抗性</span>降低35%，持續6秒。<br/>此外，<span style=\"color:#FFD780FF\">遙久之歌</span>持續期間，隊伍中附近的角色進入<span style=\"color:#FFD780FF\">輝映·星擴散</span>狀態時，<span style=\"color:#FFD780FF\">輝映·星擴散</span>的持續時間延長4秒。",
      "level": 1
    },
    {
      "id": "dirge_of_the_fandyr",
      "name": "十二弦的淚歌",
      "description": "施放元素戰技<span style=\"color:#FFD780FF\">宣敘·晨聲紛流</span>時，沃雅妮莎還會獲得25層<b><span style=\"color:#FFD780FF\">「領唱」</span></b>與10層<b><span style=\"color:#FFD780FF\">「重唱」</span></b>。<br/>上述兩種效果分別持續30秒，並會在施放元素戰技時重置層數。",
      "level": 4
    },
    {
      "id": "echoes_over_the_frozen_lake",
      "name": "餘聲繞冰湖",
      "description": "不處於戰鬥狀態下時，長按元素戰技，沃雅妮莎將顯現出水妖的本貌，以消耗體力為代價，進行至多10秒的游動。因為是水妖，所以當然也可以在水面上移動。再次施放元素戰技、持續時間結束或體力耗盡時，沃雅妮莎將不再維持水妖的本貌。<br/>此外，沃雅妮莎的游泳速度提升，但消耗體力的速度也更快。",
      "level": 0
    },
    {
      "id": "heartless_siren_song",
      "name": "無琴的誘音",
      "description": "身為科洛列夫茨基劇團首席女高音，沃雅妮莎在演奏樂器時，將改為親自獻唱。",
      "level": 0
    }
  ],
