  "outfits": [
    {
      "id": 212200,
      "name": "翠謎",
      "description": "奈芙爾的裝扮款式。她口中的話語構成重重謎題，她翠色的眼瞳背後藏著謎底。謊言無法逃過她的質詢，因為計謀與故事本就是她手中的棋。",
      "isDefault": true,
      "characterName": "奈芙爾",
      "characterId": 10000122,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Nefer_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#幸會，我是「秘聞館」的老闆，奈芙爾。{F#妳}{M#你}也許聽過許多有關於我的流言，但{F#妳}{M#你}不用為此憂心，無論那些流言是真是假，都不會影響我們目前的合作事務。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·阿舍魯",
      "text": "阿舍魯為什麼在櫃檯上？喔，那是牠在進行招待客人的工作。阿舍魯得自力更生，為自己賺點貓糧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·觀察",
      "text": "觀察事物時，別太依賴眼睛。人只愛看到自己想看的東西，別被自己騙了。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·情緒",
      "text": "情緒是奔流在人們腦海的怒濤，試圖阻擋它的人，大多數都被捲入了內心的深淵之底；而試圖忽視它的人，卻總是被它把心靈摧殘成一片狼藉。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "由天恩賜，也由天偏愛。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "又有人的謊言被揭穿了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "起風的時候…",
      "text": "讓我聽聽風帶來了什麼壞消息。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "讓人不快的熟悉感。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安，{F#妳}{M#你}每天都這麼勤快，雅珂達真應該向{F#妳}{M#你}學習。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "呼啊…沒什麼人來啊，先去午睡一會吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#嗯…差不多是時候了，我要出門一趟，茶已經泡好了，{F#妳}{M#你}自己倒。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "差不多是睡覺時間了，拉好窗簾，別被月亮偷看了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於奈芙爾自己·秘中之秘",
      "text": "「秘聞館」的工作是什麼？普通的客人會拜託我們去抓貓趕狗、尋人追債，但這些事通常也輪不到我出面。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於奈芙爾自己·秘聞館",
      "text": "只有當握有「鑰匙」的客人來訪時，「秘聞館」裡那扇有關「北大陸情報網」的大門才會單獨為他敞開。在大門後，既有光輝爍爍的黃鐵，也有暗淡失色的金杯…到底能拿走哪一個，就得看來客自己的本事了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·故鄉",
      "text": "人在念及「故鄉」的時候，往往是在懷念自己的過去。但我的過去沒什麼好懷念的，只有未來尚且值得我略作展望。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·心思",
      "text": "普通人並不會掩藏自己的情緒，只要仔細觀察表情變化，就能窺破他們的心思。要是看不穿怎麼辦？那圖特賜予我的力量就有用處了…開玩笑的，到現在為止，我還沒遇過看不穿的人。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「月之輪」…",
      "text": "或許是由於圖特和「月亮」之間也有些關聯，讓我獲得了這枚「月之輪」。但比起什麼「神明的注視」，這枚「月之輪」總讓我感覺是那個老騙子在背後盯著我，雖然明知道沒什麼根據，呵…但善騙者總是擔心自己亦被欺騙。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "我在教令院學習時，所屬的學派是「因論派」——就是研究歷史和社會的那一派。在彼時的教令院眼裡，我們沙漠人唯一的意義就是把自己的歷史寫下來，為人們提供教訓與話題，或許還有人會為我們這群倒楣蛋流下幾滴高貴的同情淚水…即使他們除了垂淚之外，什麼都不會為我們做。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#沙漠中其實有許多能夠飲用的東西，像是植物根莖裡的汁液、深處潮濕沙子裡擠出來的水分…但是，別輕易喝動物的血。這麼做只會讓{F#妳}{M#你}越喝越渴，而且那些沒嚥下去的血會黏在{F#妳}{M#你}的嘴巴和喉嚨裡，吐不出來，也舔不下去。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於菈烏瑪…",
      "text": "#我們慈悲又聖潔的「詠月使」大人，時時刻刻心懷悲憫、溫柔善良，是個多麼讓人想要親近的人啊——就連動物路過她身邊，都想跑過去蹭蹭她的手。{F#妳}{M#你}要小心，別太靠近菈烏瑪，不然說不定哪天就被她感化成信徒了。\\n啊，{F#妳}{M#你}不會已經是了吧？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於菲林斯…",
      "text": "常言總說，禮貌是對陌生人最好的遏止手段。在這一點上，菲林斯先生顯然做得很好，他用「禮節」為自己編出了一個漂亮且無可指摘的偽裝。別誤會，我是一個很識趣的朋友，很擅長捧場。無論菲林斯先生是執燈士還是妖精，是生於挪德卡萊還是來自至冬，我都不在意。在一切事情之前，我們首先是朋友，而朋友之間最重要的，就是信任。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於雅珂達…",
      "text": "我們「秘聞館」最能幹，也是最重要的員工，要是沒有雅珂達，這間「秘聞館」就只能停轉了。她魯莽又驕傲，但也勇敢且善良，或許在旁人看來，她是個不成熟的年輕人，但我覺得不成熟反而是件好事。畢竟，「成熟」的下一步就是「凋落」了。呵呵，我還指望著她多替我跑幾年腿呢。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於愛諾…",
      "text": "她幫雅珂達做的那副手臂滿好用的，就是價格不菲。噢，放心，製作費用和保養費我都已經墊付了。雅珂達是我最重要的員工，這些錢我就幫她免除利息了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於迪希雅…",
      "text": "我早就聽說過好心的「熾鬃之獅」的名號，願意付那麼多錢照顧孩子的傭兵並不多見。另外，聽說她手鎧中的力量也和赤王有些瓜葛？瞧瞧，須彌沙漠的事就是這樣，雖然表面上看似毫無關聯，但總有些看不見的脈絡在暗地裡勾連串結，直到時機到來，它們才彼此糾結著擠出地面，給大家一個「驚喜」。\\n不過，僱用迪希雅小姐工作的老闆，是一個普通的富貴人家，這倒是個好消息。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於坎蒂絲…",
      "text": "坎蒂絲算是我的舊識了，當初我流落到阿如村時，就和她見過面。在當時的村裡，她是為數不多願意和我說話的小孩。我們一起驅趕過野獸、擊退過盜賊、照顧過落難者…或許，這能算是「朋友」了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於賽諾…",
      "text": "赫曼努比斯看人真夠準的，居然能找到這麼一位責任心大過天的人幫自己做事。不過，倒是也苦了這位「大風紀官」了，不僅被教令院督工，背後還有這麼一位勤勉的「大老闆」時刻盯著，也不知道他平時是用什麼方法放鬆精神的。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於多莉…",
      "text": "桑歌瑪哈巴依老爺經常和我做生意。她在為我帶來摩拉的同時，也會替我捎來一些須彌的消息。譬如在圖書館裡夢遊的倒楣學生、從魔鱗病裡解脫的小可憐，還有如今人丁興旺、未來可期的因論派…看來，教令院裡也難得熱鬧起來了，真是可喜可賀啊。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "#迪盧克·萊艮芬德老爺是我在蒙德城重要的線人，我對他的呼號是「夜梟」。我們具體如何結識，又是如何達成合作的，出於對迪盧克老爺隱私的考量，我就不和{F#妳}{M#你}細說了。不過，和迪盧克老爺合作是一件非常愉快的事，至少…他付錢的時候非常爽快。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於夜蘭…",
      "text": "夜蘭小姐也算是我們「秘聞館」…啊不，「北大陸情報網」的大貴客了，她來購買情報的時候，從來都是用現金一次付清款項，一點賣人情的餘地都不留給我。就算是那些不能輕易賣出的貴重情報，她也會眼睛都不眨地砸下兩倍、三倍的摩拉，直到用錢砸到我認輸，把情報賣給她為止。\\n璃月港的人，出手就是闊綽，有錢真好啊…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解奈芙爾·其一",
      "text": "#如{F#妳}{M#你}所見，我是「秘聞館」的老闆，幫人們處理一些他們不知道如何處理，或是不方便自己處理的問題。幸運——或者不幸——的是，挪德卡萊有很多問題需要解決，所以我的收入尚可，餓不著肚子。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解奈芙爾·其二",
      "text": "挪德卡萊聚集著各色人等，有志向遠大的冒險家、無法無天的狂徒、惶惶不可終日的罪人，還有失去家園，無處容身的流浪者…這些追逐著夢想的人都目光炯炯，指望在這片無法之地裡發家致富、出人頭地。我也想追夢？哈哈哈，我才不會做這種風險高、回報低的生意——比起「追夢」，我更願意「幫助人追夢」。\\n畢竟，夢想雖然虛無縹緲，但追夢的人們卻是真實存在…而且很願意為自己的夢想付錢的。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解奈芙爾·其三",
      "text": "在我看來，須彌不是我的「故鄉」。它沒給過我任何憐憫和溫情，只是把刀塞到我手裡，讓我自生自滅。還好，它至少給了我一把刀，讓我有能力為自己開闢出一條生路。\\n如今的須彌不一樣了？那說不定我也該回去看看了。原先那個無趣的教令院，會變得有趣起來嗎？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解奈芙爾·其四",
      "text": "#所謂「故鄉」，我想應該是一處能夠讓人安睡歇息、遠離恐懼和勞碌的地方。在「故鄉」裡，你有著溫柔美好的回憶、感情堅實的舊友，還有雖然你久未歸鄉，但仍對你無條件敞開懷抱的家人。你在這裡稍作休憩，重新在心胸填滿勇氣和志向，然後整裝出發，邁向遠大的未來…\\n{F#妳}{M#你}的故鄉，是這樣的嗎？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解奈芙爾·其五",
      "text": "#我並不奢望能夠找到一處讓我真心安歇的「故鄉」，畢竟以我的經驗來看，任何與我產生關聯的事物，都會在某個契機之後與我徹底割離。或許這也是接受騙子的禮物所需要付出的代價吧…無論是{F#妳}{M#你}、雅珂達、阿舍魯，甚至是挪德卡萊，都逃不開這個結局。\\n…{F#妳}{M#你}會常常來看我？還會和我保持聯絡，至少會經常寫信？\\n哈哈哈哈哈，{F#妳}{M#你}想用這種方法挑戰沙漠的詛咒嗎？雖然聽起來有點笨，但我不討厭，那我就期待著{F#妳}{M#你}的信件了，希望它不會突然中斷。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "奈芙爾的愛好…",
      "text": "#我偶爾會在窗邊觀察人群，單純用思維推理某個人的想法和動向。這是一種有趣的思想訓練，有空的時候{F#妳}{M#你}也可以試試看，滿有趣的。而且，如果朋友或客人登門的時機恰當，{F#妳}{M#你}就可以順便告訴他窗外的某個人是何職業、為何事所惱，這一定能讓{F#妳}{M#你}的朋友大吃一驚，或者讓客戶高看{F#妳}{M#你}一眼。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "奈芙爾的煩惱…",
      "text": "#我尚未找到圖特所需要的答案，被人…或者神明牽著走的感覺並不是那麼好。雖然䴉之王認為我的回答夠有趣，但很遺憾，那並非赤王所承認的「正確」。不過轉念一想，假若我找到了正確的答案，那圖特就會獲得自由，我可不想把這麼寶貴的禮物奉給這個老騙子…{F#妳}{M#你}看，一個糟糕的兩難選擇。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#我對食物並沒有太大的偏愛。不過，大量飲水倒是我的一個習慣，{F#妳}{M#你}也多喝點水，對身體好。為什麼是水？只是個不值一提的習慣，源於我不那麼愉快的過去。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我沒有特別討厭的食物，只要別讓我吃生食或者是動物血液製品就好，我更願意吃安全的全熟食物。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "這道菜色還真不錯，有考慮來「秘聞館」做廚師，改善改善我們的伙食嗎？待遇從優。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#吃起來還滿不錯的，沒想到{F#妳}{M#你}還有這般手藝。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "嗯，讓人印象深刻的味道…待會讓雅珂達嚐嚐。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#我不太會為人挑選禮物…這樣好了，不如我也出三個問題，只要{F#妳}{M#你}找到了正確答案，我就可以…別皺眉，我只是開個玩笑。喏，拿著這本書，裡面記載著流傳在沙漠人之中的民俗傳說和童話，這幾篇算是相對完整的故事了。這些故事可是教育了一代又一代的沙漠人，好好看吧，說不定讀完之後，{F#妳}{M#你}也可以成為一個優秀的沙漠人呢。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "呵，原來如此。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "些許真相…微不足道。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "又一條通向真理的路徑。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "看來，我們兩人之間的連結，並不會那麼容易就被摧毀了，對嗎？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "我看懂了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "別說謊。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "真言如影。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "原來如此。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "說點真話。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "剖析時間。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "欺謊的喚聲。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "索見諸心。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "如是觀想，真謎具解。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#對{F#妳}{M#你}好奇心的嘉獎，都拿著吧，但還是得留點心。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "嗯…並不是陷阱，我們的運氣不錯。"
    },
    {
      "id": "300003",
