  "passives": [
    {
      "id": "a_wager_of_moonlight",
      "name": "月下的豪賭",
      "description": "依據隊伍的<span style=\"color:#FFD780FF\">月兆</span>，奈芙爾將獲得對應的強化效果。<br/><br/><span style=\"color:#FFD780FF\">月兆·滿輝</span>：施放元素戰技<color=#FFD780FF><b>弈術·千夜一舞</b></color>時，將使目前場上的草原核轉化為「誑言之核」，且附近所有角色在接下來的15秒內觸發月綻放反應時，將取代草原核與豐穰之核產生誑言之核。誑言之核無法觸發超綻放與烈綻放反應，也無法迸發。<br/>奈芙爾施放重擊或<b><span style=\"color:#FFD780FF\">幻戲</span></b>時，可以吸收附近一定範圍內的誑言之核，每吸收一枚誑言之核，奈芙爾便會獲得一層<b><span style=\"color:#FFD780FF\">「偽秘之帷」</span></b>效果。該效果疊加至3層或3層的持續時間重置時，奈芙爾的元素精通提升100點，持續8秒。",
      "level": 1
    },
    {
      "id": "daughter_of_the_dust_and_sand",
      "name": "塵沙的女兒",
      "description": "奈芙爾處於<b><span style=\"color:#FFD780FF\">「影舞」</span></b>狀態下時，隊伍中的角色觸發月綻放反應後的5秒內，奈芙爾的<color=#FFD780FF><b>蛇行</b></color>狀態還會額外為隊伍提供<b><span style=\"color:#FFD780FF\">草露</span></b>；依據奈芙爾的元素精通超過500的部分，每100點元素精通都將使上述提供草露的效果提升10%，至多依此方式提升50%。",
      "level": 4
    },
    {
      "id": "moonsign_benediction_dusklit_eaves",
      "name": "月兆祝賜·廊下暮影",
      "description": "隊伍中的角色觸發綻放反應時，將轉為觸發月綻放反應，且基於奈芙爾的元素精通，提升隊伍中角色造成的月綻放反應的基礎傷害：每點元素精通都將提升0.0175%月綻放反應的基礎傷害，至多依此方式提升14%傷害。<br/><br/>此外，奈芙爾在隊伍中時，隊伍的<span style=\"color:#FFD780FF\">月兆</span>將會上升一級。",
      "level": 0
    },
    {
      "id": "conspiracy_of_the_golden_vault",
      "name": "金室的密謀",
      "description": "在挪德卡萊執行時長為20小時的探索派遣任務時，獲得的獎勵增加25%。",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1221,
      "id": "planning_breeds_success",
      "name": "謀篇乃成敗之始",
      "description": "奈芙爾的<b><span style=\"color:#FFD780FF\">幻戲</span></b>造成的月綻放反應傷害的基礎傷害提升，提升值相當於奈芙爾的元素精通的60%。該效果同樣會受到<b><span style=\"color:#FFD780FF\">「偽秘之帷」</span></b>的加成。",
      "level": 1
    },
    {
      "_id": 1222,
      "id": "observation_feeds_strategy",
      "name": "明察為籌算之先",
      "description": "突破天賦<b><span style=\"color:#FFD780FF\">「月下的豪賭」</span></b>的效果獲得強化：<b><span style=\"color:#FFD780FF\">「偽秘之帷」</span></b>的持續時間延長5秒，上限提升至5層，且至多使<b><span style=\"color:#FFD780FF\">幻戲</span></b>造成原本140%的傷害；奈芙爾施放元素戰技<color=#FFD780FF><b>弈術·千夜一舞</b></color>時，將立刻獲得2層「偽秘之帷」。此外，「偽秘之帷」疊加至5層或5層的持續時間更新時，奈芙爾的元素精通改為提升200點，持續8秒。<br/>需要解鎖突破天賦「月下的豪賭」。",
      "level": 2
    },
    {
      "_id": 1223,
      "id": "deceit_cloaks_the_truth",
      "name": "誑言掩虛實之跡",
      "description": "元素戰技<color=#FFD780FF><b>弈術·千夜一舞</b></color>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 3
    },
    {
      "_id": 1224,
      "id": "delusion_ensnares_reason",
      "name": "眩惑入謎局之網",
      "description": "奈芙爾在場上且處於<b><span style=\"color:#FFD780FF\">「影舞」</span></b>狀態下時，獲得草露的速度提升25%。<br/>此外，奈芙爾處於「影舞」狀態下時，還會使附近敵人的<span style=\"color:#99FF88FF\">草元素抗性</span>降低20%，當奈芙爾不處於「影舞」狀態或離開敵人一定距離後，該效果會在4.5秒後移除。",
      "level": 4
    },
    {
      "_id": 1225,
      "id": "opportunity_hides_in_the_margins",
      "name": "見機在忽微之間",
      "description": "元素爆發<color=#FFD780FF><b>聖約·真眸幻戲</b></color>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 5
    },
    {
      "_id": 1226,
      "id": "victory_flows_from_the_turning_of_tides",
      "name": "決勝於逆轉之時",
      "description": "奈芙爾施放<b><span style=\"color:#FFD780FF\">幻戲</span></b>時，自身的第二段傷害將轉為造成相當於奈芙爾元素精通85%的<span style=\"color:#99FF88FF\">草元素範圍傷害</span>。此外，幻戲的攻擊結束時，還會造成一次相當於奈芙爾元素精通120%的<span style=\"color:#99FF88FF\">草元素範圍傷害</span>。上述傷害均視為由幻戲造成的月綻放反應傷害。<br/><br/><span style=\"color:#FFD780FF\">月兆·滿輝</span><br/>奈芙爾造成的月綻放反應傷害<b><span style=\"color:#FFD780FF\">擢升</span></b>15%。",
      "level": 6
    }
