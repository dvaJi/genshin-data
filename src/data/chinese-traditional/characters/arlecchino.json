  "outfits": [
    {
      "id": 209600,
      "name": "月光",
      "description": "阿蕾奇諾的裝扮款式。古老的厄月於夢中再度升起，投下冰冷赤紅的月光將她包裹。以此月光為證，直至嶙峋的命運來到盡頭，她將滿飲生命之杯。",
      "isDefault": true,
      "characterName": "阿蕾奇諾",
      "characterId": 10000096,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Arlecchino_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "我是愚人眾執行官第四席——「僕人」阿蕾奇諾，也是壁爐之家的孩子們口中的「父親」。希望我們相處愉快——這並非什麼難事，現在的我們還沒有衝突的理由，不是嗎？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·眼睛",
      "text": "#不要一直盯著我的眼睛，不保證{F#妳}{M#你}會看到什麼。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·家庭",
      "text": "孩子們在做什麼？算了，由他們去吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·匯報",
      "text": "有事情向我匯報？說吧，我在聽。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "打雷的時候…",
      "text": "無需畏懼，雷光也要避讓我們。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "身處寒冷之中，人們才會懷念火焰的溫暖。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "這個天氣更適合待在樹蔭下。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "#不要輕易講述自己的秘密，{F#妳}{M#你}不知道風會把它們帶去什麼地方。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安，今天有什麼計畫嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "正午回到家，總能見到孩子們橫七豎八地睡在地上。這個時間很容易犯睏，休息一下再走吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "有人說月亮就像俯瞰人間的眼睛，只是我們已經習慣被它注視。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#睡覺的時間到了。「睡不著」？那{F#妳}{M#你}得自己想想辦法了。我猜{F#妳}{M#你}不會喜歡我的方案。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於自己·認知",
      "text": "清醒地認識自己並不容易。一般來說，做不到的人反而活得比較開心。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於自己·冷血",
      "text": "偶爾，我會聽到其他人在暗處議論說我是個感情冷淡、手段狠辣的人。對此我無意澄清，偏見會將真相包裹起來，對我來說是件好事。不過我的確需要採取一些手段，來「滿足」他們的期待…希望他們有足夠的實力和地位，能夠從我手上活下來。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·讓步",
      "text": "#{F#妳}{M#你}我所持理念不盡相同，想要並肩而行，彼此都要做出讓步。我可以分享一些秘密，至於隱瞞的那部分——不要深究，這也是為了{F#妳}{M#你}好。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·做客",
      "text": "#孩子們很喜歡聽{F#妳}{M#你}講故事，時常問我{F#妳}{M#你}什麼時候會再來。期望落空總需要支付代價，希望{F#妳}{M#你}將這點納入考慮。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "有很長一段時間，我沒有什麼願望——直到某天產生了「刺殺庫嘉維娜」的想法。這個主意當時看來很荒誕，畢竟她是成名已久的執行官，而我的武藝幾乎都是她教出來的。\\n不過神明似乎只看願望是否強烈。最終我得到了神之眼，在付出一些代價之後，成功掌控了這份力量。徒弟想要戰勝老師，總要做出些意料之外的事情。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "「火焰如血液般在我的身體中流淌」…對普通人來說，這是一句粗劣的小詩，對我來說卻是一種無奈的現實。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·極光",
      "text": "至冬的極光很美麗，可以去看看。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞·蜘蛛",
      "text": "#我曾養過一隻叫「斑比」的蜘蛛。飼養蜘蛛是件有趣的事情，相較於貓狗一類的寵物，蜘蛛是無法有情感交流的。牠並不會給{F#妳}{M#你}回報，{F#妳}{M#你}也不會在牠身上寄託多餘的情感。這樣的關係對我正好。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於林尼…",
      "text": "克雷薇曾問過我一個問題：「什麼是真正的『家』？」我無法回答。因為構成壁爐之家的，正是一群「無家可歸」的人。\\n我否定家中不合理的地方並制定新的規矩，殺死庫嘉維娜後成為了孩子們的「父親」——但我很清楚，這仍然不能算真正的家。我會把這個問題保留下去。期待有一天，林尼能夠給我全新的答案。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於琳妮特…",
      "text": "沉靜的個性是琳妮特的特點，也是她的優勢，我相信她的聰明足夠理解到這一點。她在那支小隊中有著無可替代的作用，而這麼做也令她感到幸福。作為「父親」，我會給她充分的空間施展才華。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於菲米尼…",
      "text": "#菲米尼的內心非常複雜，藏著各式各樣的感情。他會將許多無關的問題歸咎在自己身上，並為此感到難過，其他孩子未必可以理解他在想什麼。我有注意到{F#妳}{M#你}的情感也很細膩，或許{F#妳}{M#你}可以和他成為很好的朋友。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "工作——以及私下——那維萊特先生刻意維持著一種「距離感」。很多人說他不近人情，我認為恰恰相反——就像律法的冰冷源於其庇護眾生的公平，這本質上是一種特殊的善意。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "我託林尼幫忙帶了一些蛋糕過去分給劇團的人當茶點，蛋糕是孩子們親手做的。用「熱心觀眾」的名義贈送，希望她喜歡。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於「女皇」…",
      "text": "在我入獄時，是女皇大人赦免了我的罪過，賜予我執行官的身分。相較於偽善之人冠冕堂皇的話術，我可以從她身上感受到真正的「慈愛」。然而…這份慈愛能否融化遼闊的冰雪，沒有人清楚答案。我只知道，如果有一天我們被迫決裂，我會毫不猶豫地向她揮劍，這是我能夠給出的最高敬意。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「丑角」…",
      "text": "作為最初的執行官，他的一切都很神秘。初次見面他就能夠輕易看出我的身世，而我時至今日仍然對他所知甚少。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於「隊長」…",
      "text": "他所擁有的力量讓他背負更多的責任，不過在我看來，即使沒有強悍的力量，他仍然是一位值得尊敬的人。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於「博士」…",
      "text": "我剛接手壁爐之家時他就向我提出了許多合作計畫，要我將「淘汰的孩子」交給他去做實驗，他則向我共享實驗成果。聽說他跟前代「僕人」合作得很愉快，如果不是同為執行官，我很想送他去見前代「僕人」。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於「少女」…",
      "text": "#她是一位非常特別的執行官。如果{F#妳}{M#你}向她提問，她不會給{F#妳}{M#你}「預料之中的回答」，有時甚至不會給出「正式的回答」，但那一定是個「有趣的回答」。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於「公雞」…",
      "text": "就像「公雞」先生不喜歡我一樣，我對他也沒什麼好印象。他是一位合格的市長，甚至可以用出色來形容。他可以用很小的代價換取巨大的收益，在政要圈子中廣受好評。可惜這「很小的代價」中經常出現壁爐之家的影子，我們遲早…哼。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於「木偶」·研究",
      "text": "我對她沒什麼興趣。她熱衷於研究，很少公開露面，許多士官甚至都沒有見過她。相較於另一個把自己切成很多份、全世界亂跑的人，她算是另一個極端。"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "關於「木偶」·回歸",
      "text": "在共同經歷了挪德卡萊的事件之後，我認為自己此前對她的評價有失公允。她是一名可靠的戰友，也是令人安心的同伴。嚴冬來臨之際，任何能夠提供支援的人手都將使現狀得到改善，我很欣慰桑多涅能在此時回歸。這對孩子們來說也是不小的慰藉。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於「富人」…",
      "text": "不可否認，他既有想法也有手腕，但我認為他並不「清醒」。他可以制定宏偉的計畫、操控冰冷的經濟，但驅使他行動的仍是內心深處壓抑的仇恨與憎惡。理性的人往往自認為能夠控制情感，這種自信就是最大的弱點。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於「女士」…",
      "text": "她與皮耶羅是我最先認識的兩位執行官。她第一次來壁爐之家做客時，那副趾高氣揚的做派不受孩子們喜歡。那之後她每次來訪都會帶些禮物，堂而皇之地表示「不喜歡我的人就沒有得拿」。為了禮物，孩子們很快就學會了逢場作戲，她也照單全收。我猜測她很享受孩子們圍在身旁的感覺，這或許源於她內心的孤獨…對於她的犧牲，我深感遺憾，願她能夠與死去的愛人重逢。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於「公子」…",
      "text": "平心而論，他的個性並不適合做執行官。他常以善意揣測別人，也常被別人利用。當然，他的天賦很好，仍然在不斷成長，對他的評價不必急於一時。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解阿蕾奇諾·其一",
      "text": "#想要瞭解我的事情？當然可以。本著互信的原則，我不會對{F#妳}{M#你}有太多隱瞞。不過{F#妳}{M#你}真的做好準備了嗎？秘密比刀劍更鋒利，危險往往源於不起眼的好奇心。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解阿蕾奇諾·其二",
      "text": "#當{F#妳}{M#你}刺出手中的利刃，{F#妳}{M#你}會意識到生命有不同的分量。有的人看似榮耀等身，卻不過是一具無聊的空殼，臨終前最後的思考仍是求饒與苟活；有的人外表平平無奇，靈魂卻意外地沉重。即使如此，死亡對於每個人都是平等的。殘酷？我只不過說了現實。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解阿蕾奇諾·其三",
      "text": "雪奈茨維奇、雪奈茨芙娜…敢於在陰影中睜開明亮雙眼的孩子們，敢於在火焰旁起舞的孩子們，我盡己所能教他們如何面對生活。壁爐之家無需討好他人，我們像蜘蛛那樣狩獵。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解阿蕾奇諾·其四",
      "text": "人們無法選擇自己的出身，世界就是這樣不公；但世界又是公平的，每個人都有抗爭的權力。我收留孩子並非為了獲得回報。只要願意付出代價，想要離開的孩子可以追求新的生活。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解阿蕾奇諾·其五",
      "text": "命運是種很奇妙的東西。小時候，我就會使用一些特別的力量，「母親」因此對我格外偏愛。但那時沒有人知道這份力量的本質是什麼——包括我自己都將這份力量視為延續在血脈中的詛咒。它讓我變得強大，也為我帶來痛苦。直到我成為執行官才從「丑角」口中得知真相，他說自己很驚訝，原來「赤月」的血脈仍未斷絕，而壁爐之家兜兜轉轉，居然又重新回到了赤月遺孤的手裡。\\n命運會將我導向怎樣的未來？總有一天它會給我答案。而我，也做好了將之斬破的準備。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "阿蕾奇諾的愛好…",
      "text": "空閒時，我會獨自觀察叢林中的昆蟲。牠們之間的博弈很有趣，捕食、競爭、合作…看似強大的個體未必有辦法存活到最後，一著不慎就可能丟掉性命。我會把牠垂死前的掙扎慢慢記下，一如我記下那些敗者的結局。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "阿蕾奇諾的煩惱…",
      "text": "孩子們會講很多只有彼此才聽得懂的流行語——就像執行任務用的暗語。他們需要一些安全的空間，對此，我充分理解。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "家裡會不定期舉辦燒烤晚會，食材交由孩子們自己準備。他們很喜歡參加這種活動，我也一樣。畢竟誰都無法預料下次舉辦晚會的時候，人群中又會減少哪些熟悉的面孔。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不喜歡調味複雜的食物，調味會讓嗅覺與味覺變得遲鈍。讓食材保留原有的味道，也算是對食材的一種尊重。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "好手藝，有興趣來壁爐之家開烹飪課嗎？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "嚐起來還不錯，或許孩子們會喜歡。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#感謝{F#妳}{M#你}的一片心意，不過在味道上還有很大的提升空間。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#備忘錄上寫著今天是{F#妳}{M#你}的生日，對嗎？生日還是要過得熱鬧一點，人們總是需要理由讓自己從繁忙的事務中抽出身，或是為自己慶祝，或是為別人慶祝。走吧，我在壁爐之家中準備了宴會，孩子們已經在等{F#妳}{M#你}了。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "不要停下前進的腳步，也不要為力量所困。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "憤怒帶來衝動，傷感讓人猶豫。時刻記住調整自己的心態。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "有些人說我過於嚴格，事實上，我對自己也一樣。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#這段時間我從{F#妳}{M#你}身上學到了許多，希望{F#妳}{M#你}也有所收穫。就讓我們繼續保持這份友好關係吧…或許將來，我們會共同應對某些棘手的麻煩。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "貫穿。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "否決。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "展現。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "於此墜落。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "於此升起。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "如月長存。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "意外是最大的樂趣。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "不錯的收穫。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "紀念此刻的歡愉。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不錯的進攻。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "該反擊了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "看來要再認真一點。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "退後。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "計畫變更。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "爐火，熄滅了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我聽見…孩子們的歌聲…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我不會接受這樣的命運。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "平庸。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "繼續。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "別擔心，我會處理好。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "遇到解決不了的麻煩了？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "希望是一次有價值的合作。"
    }
  ]
}