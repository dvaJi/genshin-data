  "outfits": [
    {
      "id": 211000,
      "name": "勇士之骨",
      "description": "伊安珊的裝扮款式。覆蓋花紋的顱骨是伊安珊的標誌性配飾，健身培訓班的學員原本以為教練伊安珊戴它是為了紀念那頭不幸夭折的突角龍，直到他們發現它不是死物。",
      "isDefault": true,
      "characterName": "伊安珊",
      "characterId": 10000110,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Iansan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#叫我伊安珊就好，我來自沃陸之邦，是那裡最有名的健身教練。看{F#妳}{M#你}體格還不錯，對健身感興趣嗎？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·舉鐵",
      "text": "今天的指標還不夠，再做一組吧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·飲食規劃",
      "text": "考慮到之前攝入的熱量…晚餐得重新規劃一下。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·力量",
      "text": "#總有人認為我是天生神力，其實我從血脈中繼承到的只有永遠長不高的個子。我所有的力量都是透過合理的健身計畫獲得的，只要付出相同的努力，{F#妳}{M#你}也可以擁有。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "趕緊找個地方躲雨吧，感冒了對身體不好。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "該出來曬曬太陽了，集合！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "這種天氣很適合拉練。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "逆風奔跑，也算是一種負重訓練吧。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "這裡不太適合搞拉練…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "嗨，早安啊。如果想要鍛煉自己的意志，早起是最基礎的項目之一。從床上爬起來都做不到的人，肯定也無法將任何計畫堅持下去。話說回來，這個時間很適合晨跑，要不要一起？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午安啊，有好好吃午餐吧？在我看來，午餐是一日三餐中最重要的一餐，不僅擔負著補充能量的重任，還是平衡營養的關鍵一環。如果不知道該怎麼吃，我可以提供一些建議。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好，{F#妳}{M#你}對夜間運動感不感興趣？剛入夜的這段時間很適合到戶外做一些運動。這個時間沒有陽光暴曬，可以減少水分消耗，適當運動後獲得的疲憊感還可以增加睡眠品質，要不要試試？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "該休息了，熬夜可是健身的大忌。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於伊安珊自己·健身教練",
      "text": "健身算是我們沃陸之邦的一項傳統，年輕人都喜歡互相秀肌肉以示友好。想要在這樣的部族裡當健身教練，只有嘴上的功夫可不行，必須有拿得出手的本事。至於我嘛，其實我一開始沒有當教練的心思，只是默默執行著自己的健身計畫。不知從何時起，旁觀的人臉上只剩下目瞪口呆的表情，而向我請教健身技巧的人也越來越多，我就自然而然地成為了教練。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於伊安珊自己·身高",
      "text": "不要把我當小孩子，我只是長不高。我祖先也都這樣，這好像是某種遺傳…不過不必擔心，對肌肉力量沒有影響。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·見聞",
      "text": "#我聽說{F#妳}{M#你}周遊各國，踏足過很多人跡罕至的秘境，真是了不起。有時間的話，能不能跟我講講{F#妳}{M#你}的見聞？我偶爾也需要向學員們提供一些精神上的激勵，而冒險者戰勝困難的故事絕對是上好的素材。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·共勉",
      "text": "#作為教練，我經常需要向別人提供指導，但其實我更喜歡能與我共勉的人。健身也是一種修行，如果總是獨自堅持，即便是我也不免會身心疲憊。所以，{F#妳}{M#你}能作為朋友向我提供鞭策嗎？如果哪一天我被懶惰和糖分誘惑了，必須有人敢於點醒我啊。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "剛獲得神之眼的那段時間，我製作了一份詳細的計畫表，用來測試這枚神之眼的各項效能。我認為使用神之眼就和健身差不多，自己具體能舉多重，能跳多遠，都必須詳加瞭解，否則一不小心就會受傷。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·健身器材",
      "text": "#我經常會嘗試設計一些新式的健身器材。如果{F#妳}{M#你}在俱樂部看到了一些奇奇怪怪的東西，八成就是我的作品。倒不是我喜歡標新立異，而是我明白每個人的最佳健身方式各不相同，不是所有人都適合天天舉鐵。所以我想從器材入手，讓那些被普通器材嚇退的人也能享受到健身的樂趣。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·體格",
      "text": "沃陸之邦的族民大多體格健碩，我這樣的小個子可不常見。小時候，周圍的人都預設我是需要被保護的對象。後來我不顧長輩的阻攔加入了健身俱樂部，那段時間沒少受傷…一路堅持下來，或許是為了踐行我的古名，或許也是因為我不喜歡他人眼中的憐憫。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "沃陸之邦的族民們喜歡和突角龍比力氣，別看它們平時看起來溫順，就算被掀翻，好像也不會生氣，但其實牠們非常危險，一旦被惹怒，就會橫衝直撞，在耗盡力氣之前不會停下來。僅僅一頭發怒的突角龍，就能拆完整座村落…至於如何與突角龍相處才能避免惹怒牠們，就是一件很專業的事了，我還專門為此開設過培訓課程呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於茜特菈莉…",
      "text": "黑曜石奶奶的確是一位了不起的人物，但是…她的生活習慣我實在不敢苟同。我晨跑時偶爾會遇到她，本以為她也有早起的好習慣，後來才知道她是熬了通宵後正要回家睡覺…能這樣生活兩百多年還沒有把身體搞垮，煙謎主的薩滿真是一種神秘的存在。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於瑪拉妮…",
      "text": "瑪拉妮一直是個讓我驚嘆的人，她的體態和力量比我的絕大多數學員都要好，但她從來沒有接受過任何正規的健身訓練。之前她報過我的培訓班，但最後也沒來。或許，是因為水上運動對肌肉的鍛煉更全面？不過我能看出來，她從來沒有為了保持身材刻意做過什麼，難道這樣的心態才是關鍵？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於希諾寧…",
      "text": "希諾寧是我在回聲之子第一個認識的朋友。我設計健身器材的時候總有很多新點子，而她是少有的能實現這些點子的工匠之一，且成品的品質絕對有保證。不過，我提出的交付日期總會被她延後，或許這就是「慢工出細活」？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於瑪薇卡…",
      "text": "或許是因為小時候的經歷，我一貫不喜歡依賴別人，或者成為被保護的對象。但瑪薇卡在場的話，即便是我也會安心地站在她的身後。我並非是被她作為領導者的威嚴所懾服，恰恰相反，我一直把她當作一位貼心朋友。而跟隨她的感覺，更像是一種身處黑暗中追隨火光的本能。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於卡齊娜…",
      "text": "卡齊娜是一個很特殊的學員，主要就特殊在參加培訓的次數最多…我一次次看著她緊張地走進競技場，再失落地走出來。明明是我沒有實現宣傳廣告上的豪言，她卻會主動向我道歉。後來，我免除了她的報名費，並承諾她隨時可以找我訓練。我能看出她的潛力很不錯，問題出在其他方面…作為教練，我把能做的都做了，而她的突破將由她親自實現。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於基尼奇…",
      "text": "基尼奇會將瓦雷莎果園裡的水果精挑細選，替我省了不少精力。不過，他身邊那個阿喬總是把每次合作都攪得很不愉快，那張嘴真是缺少嚴厲的管教。我曾建議基尼奇安排這個阿喬參加我的培訓班，本教練肯定能讓牠學會禮貌。不過基尼奇還是拒絕了，他似乎自有教訓阿喬的方法。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於瓦雷莎·態度",
      "text": "#我最最特別，也是最讓我為之自豪的弟子瓦雷莎，希望她沒有給{F#妳}{M#你}添麻煩…不，不是指戰鬥上拖後腿，也不是日常生活中冒冒失失之類的事，而是她的鬆弛感…如果不是我反覆叮囑，強調她一定要抓緊時間，她每次出門都悠悠哉哉，好像是郊遊，走著走著，注意力就被各種食物吸引走了，一次兩次沒關係，嚴肅的冒險中總這樣可不好，我已經讓她自省了！另外，她的食量構成了巨大的負擔，畢竟我們不可能揹著半隻突角龍那麼大的…裝滿食物的背包，去翻山越嶺吧？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於瓦雷莎·節制",
      "text": "目前讓我煩惱的是，瓦雷莎對力量的控制太過粗放。她的身體似乎長期處於一種高消耗的狀態，白白浪費了很多能量，她那驚人的胃口大概就來源於此。我希望她更加瞭解自己的情況，合理分配力氣，這樣她也不用總是大吃特吃了…看她吃得滿足，我是替她開心，但還是要提醒她注意飲食健康，不能暴飲暴食，不能營養失衡，不能攝入過量的油脂和糖分！要不然，吃出什麼病來，麻煩可就大了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解伊安珊·其一",
      "text": "#{F#妳}{M#你}聽說過「歸火聖夜巡禮優勝者培訓班」嗎？是我辦的。之前我連續好幾次獲得優勝者資格，很多人都以為我擁有某種常人無法奢望的神秘力量，畢竟一個小個子打穿競技場的事可不常見。但我想要告訴他們，我的力量並不神秘，而是規劃與堅持的結果。為了證明這一點，我就辦了這個培訓班。不過讓我奇怪的是，這個培訓班最初是免費的，但被好多人檢舉詐騙，後來我聽瑪薇卡的建議設了報名費，報名的人反倒絡繹不絕…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解伊安珊·其二",
      "text": "正常的槓鈴對我來說還是太大了，舉起來的時候遮擋視線，甚至看不到附近的人，差點傷到一名學員。所以我找希諾寧專門訂製了一副槓鈴，這副槓鈴用的材料十分特殊，分量很足，但個頭不大，操練起來很方便。唯一的缺點可能就是迷惑性很大，很容易讓別人誤以為這是個玩具模型。有次我把它落在俱樂部，被一幫新人看到。一個人想抓起這副槓鈴打鬧一下，結果一發力，槓鈴紋絲不動，他自己倒閃了腰。其他人不信，然後一個個都閃了腰…那之後，我就一直隨身攜帶這副槓鈴了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解伊安珊·其三",
      "text": "我是在一次養傷期間接觸到營養學的，那時大家對於健身期間該怎麼吃都沒有明確的概念，只覺得多吃肉就行。俱樂部的其他成員一頓就能吃完半張桌子那麼大的烤肉，而我的體型可撐不起那麼大的胃口，所以就想尋找獲得營養更高效的方式。受傷期間無法出門，我就借來介紹食材的織卷，嘗試烹飪健身餐。失敗了很多次之後，真讓我找到了一種適合的配方。藉助這種健身餐，我不但很快痊癒，還突破了上次的臥推紀錄。唯一遺憾的是，雖然我把配方分享了出去，但在健身俱樂部之外的推廣情況一直不太好。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解伊安珊·其四",
      "text": "我成為總教練之後，加入俱樂部的新人都要先完成一項挑戰——任選一個健身項目與我進行比試。當然，絕大部分挑戰者筋疲力竭地倒下後，我還能撿起他們丟下的器材再做十幾組標準動作。但這樣的考驗並不全是為了確立教練的威嚴，也是為了撫平年輕人內心的浮躁。很多新人學習健身的初衷就是為了炫耀，而我必須告訴他們，健身的本質是一種苦修。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解伊安珊·其五",
      "text": "沃陸之邦有個習俗，就是找突角龍角力，並將這種比賽的勝利視為榮耀。我健身一段時間後，嘗試過幾次，但都沒有成功，一度以為自己的健身策略是錯誤的。後來突角龍族群的首領突然失控，闖進部族駐地橫衝直撞，為了救下一個來不及逃走的女孩，我正面攔下了牠。角力過程中，意識到身後有需要保護的人，我竟然爆發出了之前從未察覺到的力量，成功掀翻了牠。從那時起我才明白，我的選擇是正確的。健身是一個積蓄力量的過程，但把這份力量完全發揮出來所需要的吶喊聲，必須來自心靈深處。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "伊安珊的愛好…",
      "text": "研究健身方法，設計健身器材，搭配健身餐飲…總的來說，就是健身吧。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "伊安珊的煩惱…",
      "text": "個子矮是最讓我煩心的事，倒不是我對高大健碩的形象有什麼追求，主要是不方便。每次給學員們講解的時候，我都得擺個凳子站上去。不然的話，站在後面的人根本看不到我的演示動作。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我最喜歡的食物…沒什麼喜歡不喜歡的，我更關注熱量是否超標，營養是否均衡，口味倒在其次。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "油炸和過度加工食物…我知道，這世界上可能有一半的「美食」都是這樣製作出來的。我並非想指摘它們的口味，只是想強調一下，這類食物的熱量控制和營養分配都很糟糕。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#很有眼光嘛，我健身的時候就經常吃這種菜餚，熱量適中，營養均衡。我還有改良版的配方，如果{F#妳}{M#你}感興趣的話可以來嚐嚐。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "哦，謝啦。這的確是大家都喜歡的口味，不過我就算了，熱量有些超標…不好意思，嚴格執行飲食計畫是健身流程中不可或缺的一環。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "唔，這種熱量炸彈…這已經不是健身不健身的問題了，這是健康不健康的問題！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快樂！要不要嚐嚐我專門訂製的健身蛋糕？沒有熱量超標的鮮奶油和糖霜，還特別加入了用來補充營養的穀物和蔬菜。人們平常吃的蛋糕可是一種非常危險的東西，稍不留意，脂肪就要隨著年齡一起增長囉。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "健身最重要的是正確的「方法」，是合理的訓練梯度和科學的營養搭配。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "盲信「毅力」的健身者遲早會把自己練到病床上去，就像最初的我那樣。事實證明，強行挑戰高難項目的結果就是雙臂骨折再加上一個月的禁閉修養。「毅力」最適合的用途，就是執行正確的「方法」。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "現在的我很少像最初那樣因為多做一個伏地挺身就歡欣雀躍了，因為我明白，只要堅持下去，變強就是一件理所當然的事。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "或許這一切就是繼承古名所必須經歷的試煉，而我也早已領悟到了祖先想傳達給我的話：「力量無須與生俱來，力量無法不勞而獲。」"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "風馳電掣！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "更快，更強！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "調整呼吸！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "動起來！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "計時開始！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "聽我的口號！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "天道酬勤。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "我會把這東西擺到山尖上，這樣攀岩的時候更有目標感。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "要不整箱扛走？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "還行，再咬咬牙！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "快到極限了嗎？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "得留意下肌肉的承受能力了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "悠著點！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "小心肌肉拉傷！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "又得去找醫生了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "這下練出事了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "這次要在床上躺多久？"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "湊活。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "這還像回事…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "暖身完畢！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "有誰需要指導？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "開練！"
    }
  ]
}