  "outfits": [
    {
      "id": 208500,
      "name": "冰的肌膚",
      "description": "菲米尼的裝扮款式。如同第二層肌膚一般包裹著深潛者，陪伴他一次又一次遊向寂靜海床的潛水套裝。",
      "isDefault": true,
      "characterName": "菲米尼",
      "characterId": 10000085,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Freminet_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，我叫菲米尼，是一名潛水員…啊，握手的話就不必了…我是說，不用那麼客氣。咳、如果{F#妳}{M#你}需要勘測水下遺蹟或者打撈素材的話，我能為{F#妳}{M#你}所用…但其他方面的指派，我可能會讓{F#妳}{M#你}失望…"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·海底",
      "text": "想去無人的海底，一個人安靜地待著…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·原理",
      "text": "熟悉機械裝置的構造與原理，就能夠檢測故障…但要熟悉一個人卻難得多。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·家",
      "text": "無論我在何處漂流，只要那盞爐火亮著，我就有家可歸…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "每到雨天，心情都會沉重不少…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "雨停了嗎？那就好。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的時候…",
      "text": "佩伊，我會保護你的。不要怕。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候…",
      "text": "我是不是應該把潛水頭盔戴上…保暖…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "想鑽進海裡。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早。請問，有需要我執行的任務嗎？沒有的話，我準備出門了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#機械內部沒有故障，是發條老化了嗎？那修起來簡單…抱歉，我…呃…{F#妳}{M#你}剛才和我說了什麼嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "要來一碗海鮮湯嗎？是用今天現捕的蝦和貝類做的。我不怎麼會做飯，但食材新鮮，味道…應該不會太差。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}休息吧。我還想看一會書再睡。欸？什麼書？這個…唔，是有關潛、潛水的書，有很多技術要點要學…總之，先道晚安了！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於菲米尼自己·潛水",
      "text": "#如{F#妳}{M#你}所知，我為數不多的強項是潛水，我和汐藻打交道的時間比和人說話的時間還多。它們不會責問、不會流露失望，只會安靜地陪{F#妳}{M#你}一同漂流…水下的世界要比陸上簡單許多。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於菲米尼自己·發條企鵝",
      "text": "在我感到孤獨的夜晚，是佩伊給了我最珍貴的陪伴。我想，或許有其他孩子像我一樣，需要一位陪在身邊的玩具夥伴。於是，我做了一批發條企鵝，拿去萊舒的發條工坊寄售…聽說口碑不錯，但銷量普通，來購買的反倒是成年人居多…唉。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·命令",
      "text": "#「命令」就像是背在我身後的發條，離開它反而令我不習慣。如果有任何對我的安排，請{F#妳}{M#你}一定不要顧慮。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·同伴",
      "text": "#讓我多瞭解一點{F#妳}{M#你}的事吧。{F#妳}{M#你}的愛好、口味、喜歡的顏色、想養的動物…既然{F#妳}{M#你}是我的「同伴」，那我們之間的聯結，就比齒輪與機關更緊密了。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "自從有了「神之眼」，我潛水已經不再需要使用頭盔。但我卻離不開它。它將我與外界的嘈雜隔絕，讓我感到安全。「神之眼」、頭盔…還有佩伊，我的呼吸，一直在藉助它們的力量。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "透過海水望天，陽光也不會那麼刺眼。所以，我才總是願意待在水裡。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·蒼晶螺",
      "text": "我曾在水下看過許多蒼晶螺。盯著那些精緻細巧的紋路，不知不覺就忘記了時間。這麼美麗的生物已經變成了化石，那我們周圍的景色，是不是遲早也會沉入深海之下呢？"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞·幽光星星",
      "text": "#幽光星星總是會依附在其他東西之上，有時是礁石，有時是碼頭，更多時候則是龐大的水下建築群。{F#妳}{M#你}說，它們是不是就像飛螢靠近光源那樣，對人類心存嚮往呢？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於「父親」·眼淚",
      "text": "「父親」不喜歡孩子們哭，說眼淚是感性和軟弱的混合物。被「父親」訓斥過後，我總要忍到水下才敢哭出來，還好海露花會陪著我。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於「父親」·教導",
      "text": "小時候，我受到的教育是：為了家，我們應該獻出自己的生命。自從「父親」掌權後，這一理念產生了變化。「父親」說我們每一個人都很重要，必須重視自己的生命，發揮所有力量，在這個世界上站穩腳跟…說實話，這比單純服從命令難多了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於林尼·表演",
      "text": "在家裡，林尼時常會向我表演一些小魔術。一旦我笑了的話，他就會特別開心，說那個魔術一定會讓觀眾都滿意…我平時真的笑那麼少嗎？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於林尼·面具",
      "text": "林尼是我們小隊中的領袖，總是以哥哥的身分自居…我能看出他硬撐的時候，也嘗試過勸他不要一直戴著面具…但他不肯承認，我們還起過爭執…從那之後，我就不再觸碰這個話題了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於琳妮特…",
      "text": "同樣的任務，如果交給林尼或者琳妮特，他們就能完成得很出色，而我卻做不好。琳妮特總會寬慰我說大家各有所長，家裡那些突然故障的器械都在靠我維修…哈，我在其他方面也能這麼得心應手就好了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "有次我浮出海面時，正巧看到最高審判官大人獨自站在海邊。他或許在想心事，或許在看風景…我當然沒問。我只和他匆匆對了一眼就潛回海裡了。事後想想像是做了虧心事一樣…唉。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於芙寧娜·回避",
      "text": "我…我沒法客觀地評價水神大人，還是…不說了吧。況且我和她接觸得也不多…看法一定會有偏頗。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於芙寧娜·判斷",
      "text": "好吧，我看過水神大人坐在觀眾席上的樣子。在我看來，她說話的時候非常引人注目，沉默的時候反倒更耐人尋味…她的眼睛，就像不透光的海底那樣，藏著深深的秘密，害怕他人的碰觸…我、我亂說的…對不起。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "#我聽林尼聊了事情經過，很感謝{F#妳}{M#你}和娜維婭小姐的慷慨與熱心，也請代我向她轉達…欸？當面道謝？我、我有點…唔，肚子突然痛起來了，抱歉先走一步。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "不知道為什麼，夏洛蒂小姐始終不願相信我是一名普通的潛水員，反倒覺得我的身世藏有值得報導的「新聞」…是我說謊的時候不夠自然嗎？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "克洛琳德小姐對我有救命之恩，卻說不需要我做任何「報答」。給別人添了麻煩，到頭來只能空洞地道謝…這種感覺，真難受啊！"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於夏沃蕾…",
      "text": "聽說夏沃蕾小姐常去博蒙特工坊，為火槍購置最昂貴精細的零件。我要是能賺到很多錢的話，說不定也能為佩伊換上性能更好的零件了吧。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解菲米尼·其一",
      "text": "#請原諒。我講不出什麼有趣的故事…說了也會掃{F#妳}{M#你}興致…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解菲米尼·其二",
      "text": "#要是{F#妳}{M#你}答應不看著我，或者允許我戴上頭盔的話…我可以試著說下去。心理素質是一方面…但更主要的原因，恐怕是我習慣了逃避自己的過去…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解菲米尼·其三",
      "text": "書上說，人死後會化作天上的星辰，遙望人世…我討厭自己的親生父親，他拋下了我和母親，我不在乎他…但如果母親在天上看見她用生命保護下來的孩子如此怯弱，躲在另一個屋簷下那麼久，也沒有成長為獨當一面的樣子，她會不會…對我感到失望呢？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解菲米尼·其四",
      "text": "我不太想回憶前任院長管理時期的「家」。只能說…躲進海裡的習慣，就是那時候養成的…但「父親」不僅改變了我，也改變了我對「家」的看法…後來林尼和琳妮特也成為了我們的「家人」…那是我第一次遇到能交心的夥伴。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解菲米尼·其五",
      "text": "#我曾發誓，我會不惜一切地守護現在這個家，一絲一毫都不退讓。它不再是前任院長的命令，或者「父親」的期待…而是我自己的願望。請{F#妳}{M#你}保守「家」的秘密…還有我的願望。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "菲米尼的愛好…",
      "text": "除了潛水之外，我還喜歡拆解和改造機械，有時也會把收集來的材料製作成新的發條玩具。佩伊？它更像是我的家人，和我一起長大…是真的。我一直在為它增添更多功能…真希望未來有一天，它能夠自由地飛上高空。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "菲米尼的煩惱…",
      "text": "…真難回答啊。既可以說我沒有亟待解決的問題，又可以說我身上麻煩重重。即使將我自己看作一臺櫥窗裡的發條玩偶，我也想不出要從哪裡開始維修…癥結可能還是會落回…我太弱小了吧。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "魚、蝦之類的海鮮…螃蟹也可以。我很高興自己和林尼、琳妮特他們口味相近，大家能享受同樣的美味…在烹飪形式的選擇上，我會尊重他們的意見。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我不太能喝咖啡。一旦超過半杯，沒過多久，心臟就會跳得很快，呼吸也沒法恢復平穩。人們常說咖啡有提神的效用，但對我來說，它更像是一種折磨…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "好吃。好吃到讓人捨不得吃完。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#烹飪是{F#妳}{M#你}的愛好嗎？所以{F#妳}{M#你}才會不斷投入心血，做出這些美味的料理。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#對不起，剛才我有一瞬間想要逃走。明明是{F#妳}{M#你}辛苦做出來的東西…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#{F#妳}{M#你}願意跟我去個地方嗎？我知道一片水域，景色非常漂亮，甚至比書裡描繪的世界更加夢幻。我在那裡有個秘密基地，還養了一些會發光的海洋生物…我想陪{F#妳}{M#你}度過一個不一樣的生日，最後再說出那句祝福…能給我這個機會嗎？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "真的…可以嗎？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#即使不為我做這些，我也會服從{F#妳}{M#你}的。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#{F#妳}{M#你}的時間和精力非常寶貴，拿去陪別人會更好…吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我不知道如何才能報答{F#妳}{M#你}，要怎樣表達才足夠傳遞自己的想法…我…我平時練習太少，現在非常害怕會說錯話…讓{F#妳}{M#你}不開心、讓{F#妳}{M#你}覺得後悔…對不起，我可以什麼都不說，就在{F#妳}{M#你}身邊待一會嗎？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "佩伊！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "運轉吧。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "寒潮將至。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "下潛…就緒。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "清剿…開始。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "該道別了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#如果有{F#妳}{M#你}不需要的金屬碎片或者零件，可以丟給我。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "好多寶藏。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "分類存放吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "區區疼痛而已。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我還能承受…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "要恢復…呼吸節奏。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "#{F#妳}{M#你}的傷口…"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "#{F#妳}{M#你}…要不要…"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "我還是…無處可歸…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "要沉入海底了嗎？…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "「父親」…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不好…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "不要…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "帶我走吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "命令我吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "我還能去哪裡呢…"
    }
  ]
}