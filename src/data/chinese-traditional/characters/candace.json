  "outfits": [
    {
      "id": 207200,
      "name": "沙漠與夜",
      "description": "坎蒂絲的裝扮款式。不論走到哪裡，點綴在衣間的金黃沙漠和故鄉的夜空都陪伴著她。",
      "isDefault": true,
      "characterName": "坎蒂絲",
      "characterId": 10000072,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Candace_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好呀，遠道而來的旅行者，夜晚的沙漠可是很嚴酷的，不如就在敝處稍住一晚吧，由我來照看{F#妳}{M#你}的無夢之夜。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·盾與槍",
      "text": "為了保護珍貴之物，只有盾是不夠的。所以…我才會握起槍。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·生活",
      "text": "希望每個人都平安無事。只要能維持這樣的生活，我就心滿意足了…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·願望",
      "text": "無論以怎樣的方法，我都希望守護住那些重要的東西。儘管有時…這會是一種奢望。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "可別著涼了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#雷聲轟隆——會讓{F#妳}{M#你}害怕嗎？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "這些白色的東西，冰冰涼涼的…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "在沙漠裡，這樣的風會吹起沙暴，得小心了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "#我就在{F#妳}{M#你}身旁。若{F#妳}{M#你}不放心的話，就請牽著我的手吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安啊，不知旅者昨夜可曾安然入眠？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "已經是中午了，天上明眸之光灼然炫目，不如找個蔭涼處歇息一下吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "夜晚啊，在那光芒褪盡的諸多帷帳之後，藏著多少難言的隱秘呢…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#嗯，確實已經到休息的時間了，{F#妳}{M#你}先去睡吧。我嗎？離我入睡的時候還早，夜晚雖然美麗卻也危險，我得好好幫{F#妳}{M#你}守夜才行啊。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於坎蒂絲自己·瞳色",
      "text": "很奇怪嗎？不管是琥珀色還是蔚藍色，應該都還算常見的瞳色吧…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於坎蒂絲自己·阿如村",
      "text": "我自小就在阿如村出生長大，在我尚且懵懂之時就知道，將來一定會從祖父手中接過守護阿如村的職責…如今，這已是我欣然接受的天職了。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於坎蒂絲自己·父母",
      "text": "我的父親是教令院的學者，當時為了研究才到了阿如村，也由此和我的母親相遇。關於母親的事，我全是從父親口中得知的…在我出生那日，母親就走入永夜之中了…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·主客",
      "text": "#{F#妳}{M#你}永遠是阿如村的客人，無論何時，若是在旅途中覺得困倦疲累，{F#妳}{M#你}都可以到這裡來歇息一下。阿如村永遠歡迎{F#妳}{M#你}…我永遠會歡迎{F#妳}{M#你}。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·寶匣之中",
      "text": "據說每個人心中都有一個寶匣，他們將珍視之物裝入匣中，花上一生的時間好好守護。這樣想要守護的東西，在我的寶匣之中也有許多，要猜猜看都有什麼嗎？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "在我獲得「神之眼」的時候，村裡不少人都說這是阿赫瑪爾的恩眷…但對我來說這並不重要。無論有沒有神明的恩賜，我都會履行「守護者」的職責。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "我很喜歡在阿如村度過的日子。同時，在這裡度過的每一天也都在提醒我，如果我因為鬆懈失察而釀成大錯的話，就再也無法回到這樣的生活了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}有在旅行的途中見過棗椰嗎？村裡的人經常把它們摘回來做成糖果吃，味道非常甜美。如果感興趣的話，{F#妳}{M#你}也嚐嚐看吧。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "草神啊…作為阿赫瑪爾血脈延續的我既然能在此安然生存，或許也仰賴她的仁慈吧。不過，雖說心中懷有淡薄的感激之念，但我畢竟是沙漠的子嗣…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於萊依拉…",
      "text": "「狀若夢遊的古怪少女」嗎…我確實在防沙壁附近看到過，雖然完全聽不懂她說的話和寫在紙上的一堆算式…不過，她似乎說完那些心情變好了許多。或許這是她排解心中壓力的方式吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於艾爾海森…",
      "text": "真是奇怪的須彌學者，跟我接觸過的其他學者都有些不太一樣，他的想法與見解都很獨到…希望他的這份銳利，不會打擾到阿如村的安寧吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於賽諾…",
      "text": "教令院的大風紀官…之前很少到防沙壁的這一側來，最近卻常常出現。關於他，鍍金旅團裡似乎流傳著一些相當可怕的傳說…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於迪希雅…",
      "text": "迪希雅，她每次帶著鍍金旅團的人在阿如村寄宿的時候，都能約束好手下的行動，可以說…幫我省了很多麻煩。迪希雅小姐，跟看起來大大咧咧的樣子不同，是個非常可愛的人哦。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於賽索斯…",
      "text": "赤王的子民永遠保有驕傲，他也是如此。我有聽說他的事，赫曼努比斯的威光將與有能力的人共存。聽說他最近在須彌城很活躍，還跟賽諾他們提起阿如村說是想來作客，我很期待。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解坎蒂絲·其一",
      "text": "#想要瞭解我的事情嗎…那算不上是一個好故事，但要是{F#妳}{M#你}執意想聽的話…那就在入夜之後，由我在篝火邊為{F#妳}{M#你}講述吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解坎蒂絲·其二",
      "text": "我們是失去了神明庇護的一族，對我們而言，謊言不是什麼敵人，沒有明天才是。懷揣謊言行走於痛苦的荊棘之路上，說不定…說不定比自顧自擁抱真相死去的人要高尚一些呢…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解坎蒂絲·其三",
      "text": "即使到現在，也有人相信赤王有朝一日能夠復活，但那是不可能的。一切的過去都如同被吹拂的砂礫，對過往之事來說，隨風而去才是最好的歸宿。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解坎蒂絲·其四",
      "text": "我的盾牌？喔，如果按照村外人的說法，這面盾牌上可是有著「貝努」的祝福喔，只要拿著這面盾牌，沙漠裡的每一顆沙礫都是我的斥候，沙暴也任我驅使…這其實都是外人的臆想。但無論如何，對我來說…至少這面盾牌滿好用的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解坎蒂絲·其五",
      "text": "#我真想用這隻琥珀色的眼睛，預見{F#妳}{M#你}的未來…我想，它大概會是一片金黃，介於陽光和黃金之間，是充滿希望的顏色。{F#妳}{M#你}的前路一定會順利，我由衷祝福著它。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "坎蒂絲的愛好…",
      "text": "在村中散步就是我最喜歡做的事。看到一切都好，就讓人覺得今日猶如昨天，昨天猶如過去，而過去又總是好的。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "坎蒂絲的煩惱…",
      "text": "#偶爾還是會有不長眼的宵小之徒，企圖打擾阿如村的寧靜。或許…只將那些傢伙趕進全是魔獸的山谷裡還是太過仁慈了，怎麼樣，{F#妳}{M#你}有更好的建議嗎？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "對我來說…食物的分量比口味更重要。在沙漠裡生活需要耗費比想像中更多的體力，一天的勞累過後，沒有比吃飽肚子更為愜意的事了吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#倒也沒到討厭的程度，不過相較於肉，魚吃起來確實非常麻煩…可能也是在沙漠中很少吃魚的關係吧，我對於那種將刺從魚肉中剔除的工作並不擅長…讓{F#妳}{M#你}見笑了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#好吃極了，為做出這樣的美食，{F#妳}{M#你}想必付出了相當的努力吧。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#明明是四處漂泊的旅人，{F#妳}{M#你}做的飯，卻有家的味道呢。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "或許是我對可食用之物的定義太過保守…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#祝{F#妳}{M#你}生日快樂！多了不起啊，{F#妳}{M#你}在過去某年某月的這一天出生了。有什麼想要實現的願望嗎？如果要去險遠之處，我就作{F#妳}{M#你}旅途的護衛。若是想稍作休息，那就來阿如村，我用最好的烤肉和飲料招待{F#妳}{M#你}。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感覺到了更堅實的力量，希望我可以保護更多…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "更堅固的盾、和更鋒利的槍。我曾聽說過一個槍和盾的故事…不，我不會做出槍盾相擊的嘗試。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "人在「現在」獲得的力量，或許都是為了應對「將來」的不安。就像我過去鍛煉槍術和持盾的技巧，實際上都是為了守護現在的安穩。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#現在的我，已經可以站在{F#妳}{M#你}的身前，替{F#妳}{M#你}擋下所有的危險。如果{F#妳}{M#你}相信我的話，就請閉上雙眼，將敵人交給我吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "破！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "走開！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "來吧！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "墜刺！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "不過如此！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "有破綻！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "聽取我的戰禱！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "賜予我們祝福！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "此為守護之戰！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "都是些有用之物呀…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "怎麼樣，有看得上眼的嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#希望裡面有能幫上{F#妳}{M#你}的東西。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不用手下留情了。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "仍不悔改嗎？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "請你們，滾開…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "好好休息一下…"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "站我身後吧！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "仍需磨煉…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "對不起，我沒有守護…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "盾，破碎了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "沒問題。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "了不起。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "小傷罷了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "怎麼了，遇到危險了嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "記得跟緊我哦。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#我會保證{F#妳}{M#你}的安全。"
    }
  ]
}