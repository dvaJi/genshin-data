  "outfits": [
    {
      "id": 205300,
      "name": "小貉服",
      "description": "早柚的裝扮款式。以神秘生物——「貉」為靈感設計的奇妙裝束。",
      "isDefault": true,
      "characterName": "早柚",
      "characterId": 10000053,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sayu_Circle"
    }
  ],
  "voices": [
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "走啦…唔。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "溜囉…啊。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "咕嚕，哈！…嘿呀。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "極意遁走。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "抓不住我…嗚。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "隨風而遁…嗚。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "分身之術。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "出來吧！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "嘿咻…嗚。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "疾風遁術。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "這個箱子…好像可以睡進去。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "大豐收！可以睡覺了嗎？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "是對長高有幫助的東西嗎？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "逃跑的話，該用…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "頭暈乎乎的。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "呼，好累。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我來掩護。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "先退下休息。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "沒能…逃掉…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "…晚、晚安了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "不該偷懶的…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "痛。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "沒躲開。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "嗚，要暈倒了。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "好睏。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "可以睡覺嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "嗚，居然被抓住了。"
    },
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "「終末番」早柚，參上。\\n呼——如果沒有什麼事情的話，我先去睡覺了。對了，不准趁我睡覺的時候偷偷摸我的頭。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·睡著",
      "text": "呼啊…呼嚕呼嚕——"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·工作",
      "text": "工作還不如睡覺。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·長高",
      "text": "什麼時候才能長高呢？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "快躲雨，被雨淋到就長不高了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "好大的動靜，不過只要整個人都鑽到被子裡就能安穩睡覺了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#雪天很方便躲藏。比如說「雪降之隱」這種忍術，藉助飄雪隱去身形，等別人察覺的時候，對方的眼前就只剩下飄落的雪花了。啊，{F#妳}{M#你}千萬不要把這些告訴巫女姐姐。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "舒舒服服的好天氣，啊——好睏哦。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起風的時候…",
      "text": "風起之時，便是開溜的好時機。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "颳大風了…",
      "text": "風吹得眼睛睜不開了，不如就這樣，閉起眼睛睡一覺吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "已經…已經早上了嗎？再睡10分鐘…就10分鐘嘛…那、那5分鐘也行…呼…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "好睏，午睡時間還沒到嗎？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "確認完畢，方圓十里內沒有巫女姐姐的蹤影。今晚可以睡個好覺啦~"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "終於…可以睡覺了…晚…晚安…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於早柚自己·終末番",
      "text": "我雖然屬於「終末番」，但交給我的工作無非就是些情報收集、偷取物品之類的瑣事。所以…所以不做也沒有什麼關係嘛。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於早柚自己·翹班",
      "text": "「終末番」的工作本來就沒什麼意義嘛，一直拖著不做，就會有更合適的人去做。但是睡覺不一樣啊，只要睡得夠久，說不定哪天就能長高了，這可是意義非凡的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·幫個忙",
      "text": "如果巫女姐姐來了，記得告訴我一聲哦，我稍微睡…啊不，休息一下。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·摸摸頭",
      "text": "#摸摸頭？唔，如果是{F#妳}{M#你}的話…那好吧，我不會咬{F#妳}{M#你}的，但是不能摸太久了，否則會長不高的！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "雙手劍真的很重，光靠忍術的話，我肯定舉不起來。但是有了「神之眼」就不一樣了，所以不管怎麼說，「神之眼」對我幫助很大。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "老師說我是我們流派最後一代傳人了。畢竟也不是什麼特別適合戰鬥的流派，我學的也都是些逃跑和隱蔽氣息用的忍術，這也是沒辦法的事情吧…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}知道貉嗎？一種比狸貓可愛得多的小動物，下次帶{F#妳}{M#你}一起去看看吧~"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "神里家的大小姐優雅又端莊，但是她專門任命了一位巫女姐姐來監督我，不讓我偷懶…怎會如此…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於神里綾人…",
      "text": "我在樹上休息的時候，經常會聽到巫女姐姐們在聊他，似乎是一位工作很忙的大人。真是奇怪，工作什麼的明明翹掉就好了…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於托馬…",
      "text": "明明都有神之眼了，他每次出現還是纏著我說想要學忍術，真是搞不懂。而且我睡覺的時間都不夠，哪有時間教他嘛。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於宵宮…",
      "text": "她每次碰到我就說什麼，小狸貓我們一起去祭典玩之類的話。我才不是狸貓，也不想去祭典。說是一起去玩，其實就是想著在祭典上讓我配合她的煙火表演忍術，但是這和「終末番」的工作有什麼關聯嘛！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "那位大人…不是我能見到的人物。想知道更多事情的話，或許問問綾華大小姐比較好。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於八重神子…",
      "text": "她總喜歡摸我的頭，可是我不敢咬她，也不敢反抗，總感覺如果拒絕了她會發生很可怕的事情。但是，再這樣被摸下去，我會不會真的長不高了？怎麼辦呀…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "怎麼會有這麼吵吵嚷嚷的人，而且他還能長這麼高！"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於久岐忍…",
      "text": "沒什麼印象的名字，讓我想想…欸？她是荒瀧一斗的小弟嗎？那肯定也是干擾睡眠的人，畢竟有個詞叫做一丘之貉，啊不對，是一丘之狸！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於綺良良…",
      "text": "有次我午覺睡醒，感覺身後暖暖的，一轉頭就看見有隻貓正蜷著睡覺，而且竟然有一對毛茸茸的尾巴！嚇得我差點從樹枝上掉下去。這，這也是變身術嗎？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於夢見月瑞希…",
      "text": "奇怪的紫色妖怪…被她盯著的時候，感覺好像要被吃掉一樣…唔！惹不起，我還是躲著她走吧！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於布倫妮…",
      "text": "她送了我一本很厚的書，叫《營養學導論》。她說光睡覺是不夠的，還要按照上面的公式吃飯才能長高。但是，她明明懂這麼多，我們好像也差不多高嘛…奇怪，難道她不想長高嗎？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解早柚·其一",
      "text": "呼——"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解早柚·其二",
      "text": "#呃…{F#妳}{M#你}是問我忍術流派的名字嗎？那個…想不起來了啦，我還沒睡醒，我再去睡一覺，睡醒後說不定就能想起來了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解早柚·其三",
      "text": "#好吧，告訴{F#妳}{M#你}也行。{F#妳}{M#你}先答應我不准笑，不然我就再也不理{F#妳}{M#你}了。我們流派叫做——嗚呼流…\\n說是因為我們流派的忍術以戲弄敵人為長而取的名字，可是，可是…唉。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解早柚·其四",
      "text": "#{F#妳}{M#你}會爬樹嗎？我非常擅長這個，可以教{F#妳}{M#你}哦。還有，神社那邊有棵樹特別適合偷…啊不，特別適合小憩。下次{F#妳}{M#你}想睡午覺的時候，記得來找我，我們一起爬上去午睡吧。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解早柚·其五",
      "text": "#其實這套衣服是老師給我的，說是以貉為原型做的，還有助於我逃跑什麼的…然後又說我已經長大了可以獨當一面了，但也要保護好自己，說完老師就離開了我。可是我這個身高，真的能獨當一面嗎…\\n唔…欸？{F#妳}{M#你}是說{F#妳}{M#你}會陪著我嗎？{F#妳}{M#你}真的不會離開我嗎？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "早柚的愛好…",
      "text": "套上衣服上的帽子，不用擔心會被巫女姐姐找到，然後睡個天昏地暗，這應該是世界上最幸福的事情了吧。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "早柚的煩惱·誤會",
      "text": "很多人第一次見到我的時候，都會大呼小叫，還把我當成狸貓。可是早柚就是早柚，才不是狸貓。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "早柚的煩惱·身高",
      "text": "什麼時候才能長高呢？跟我同年的人身高都快是我的兩倍了，可是我還…不行，再睡久一點一定能長高的！我要睡覺了，晚安。"
    },
    {
      "id": "6006",
      "type": 1,
      "title": "早柚的煩惱·死循環",
      "text": "我上次聽人說，煩惱太多也會長不高…嗚，我該怎麼辦才好…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "能一下子提供很多能量的食物吧，比如說飯糰。睡醒了吃一個就不會頭暈眼花，然後又能繼續睡覺了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "想要長高的話，就不能挑食！說來最近好像身高也沒有變化，是不是因為蔬菜吃少了，但是沙拉真的沒有辦法提供飽腹感，而且還苦苦的，嗚欸——"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "肚子好飽。這下可以安心睡覺啦。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "吃著吃著…就睏了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "要想個辦法…逃走。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#{F#妳}{M#你}有什麼想學的忍術嗎？我可以教{F#妳}{M#你}！當然僅限於我會的。呃？{F#妳}{M#你}問我為什麼不睡覺？嗯…我還不睏，而且，而且今天是特別的日子，我不可以睡過去，因為我想親口對{F#妳}{M#你}說——生日快樂呀。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我有長高一點點嗎？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "太好了，能溜得更快了，這下子肯定不會被抓住了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#謝謝{F#妳}{M#你}幫我收集了那麼多材料，要是我自己來的話…肯定在路上就會睡著了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我好像確實像老師說的那樣，可以獨當一面了。這樣子長不長高或許對我來說也沒有那麼重要了，因為現在重要的是…有{F#妳}{M#你}陪在我身邊。"
    }
  ]
}