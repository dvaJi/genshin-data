  "outfits": [
    {
      "id": 204300,
      "name": "萌生的靈風",
      "description": "砂糖的裝扮款式。帶有砂糖個人特色的西風騎士團煉金術士制服。",
      "isDefault": true,
      "characterName": "砂糖",
      "characterId": 10000043,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sucrose_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是砂糖，煉金術的…研究員。聽說{F#妳}{M#你}去過很多地方，一定也…不，沒什麼，第一次見面，不該這麼麻煩{F#妳}{M#你}。但…如果{F#妳}{M#你}願意，和我講講路上有意思的事，那個…我，會很開心的。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·好奇",
      "text": "那是什麼？啊…不見了，我可以去看看嗎！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·整理",
      "text": "趁現在，趕快整理一下研究筆記…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·深呼吸",
      "text": "嗯——！好久沒出來透氣了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "颳大風了…",
      "text": "#今天城裡的風車，轉得好快。欸，{F#妳}{M#你}說，如果在小動物背上，也裝一個像風車一樣的東西，會讓牠們跑得更快呢，還是會飛起來呢？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "這麼大的雪，一年都沒有幾次，錯過了，想研究就要等明年了，所以就別攔我啦。啊…阿嚏！呃…我知道了，我多穿一點…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "天…天已經亮了？！那、那再做最後一次實驗吧，做完就休息！嗯，最後一次…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "下雨的時候…",
      "text": "濕度上升，嗯…要不要再加一組實驗呢？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安，昨晚睡得還好嗎？研究表明，只有睡眠充足，第二天的精神才會好，而且，腦袋的運轉也會更順暢哦。欸…什麼？我總是熬夜？那個…唔，沒辦法嘛。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "嗚哇！別、別過來！啊…不是，我的意思是，不要靠得太近，我在做實驗，這個…可能會爆炸的。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好，啊…請稍等一下！「實驗體玖零伍式」的光照分泌物其實有兩種，為了明確區分，就叫「壹零三參式」和「壹零參伍式」…嗯，好了，請問有什麼事情要找我嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "不用等我，先去休息吧。唔…有這麼不放心嗎？實驗已經在收尾了，不會熬夜的，真的…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於砂糖自己·「生物煉金」",
      "text": "「生物煉金」，比起「創造」，更注重「改造」，找到生物隱藏起來的優點，然後放大，結合，結果往往都讓人大吃一驚。嗯…生命真的是太神奇了，究竟還有多少我們不知道的東西呢？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於砂糖自己·怕生",
      "text": "我…其實我不知道怎麼和陌生人說話。每個人性格都不一樣，在意的東西也不一樣，一不小心就會不夠禮貌，或者哪裡冒犯了，唉…說話真的好難啊，比煉金術什麼的難多了。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於砂糖自己·耳朵",
      "text": "#{F#妳}{M#你}…{F#妳}{M#你}注意到了啊。我的耳朵是家裡遺傳下來的，和其他人很不一樣，所以平時我都會用頭髮盡量把它們藏起來…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·觀察",
      "text": "#我對{F#妳}{M#你}的經歷，特別好奇，所以…我可以「觀察」{F#妳}{M#你}一段時間嗎？我會很安靜的，不會打擾你，這樣…{F#妳}{M#你}會介意嗎？"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "關於我們·收穫",
      "text": "#老實說，一開始我看{F#妳}{M#你}不怎麼說話，有點害怕…還以為是在哪裡冒犯了{F#妳}{M#你}，後來時間長了才慢慢發現，原來，{F#妳}{M#你}還是挺好相處的。嘿嘿，這也算…「觀察」的意外收穫吧。"
    },
    {
      "id": "2007",
      "type": 1,
      "title": "關於我們·請求",
      "text": "#聽說，是{F#妳}{M#你}趕走了風魔龍？戰鬥一定很危險吧，幸好{F#妳}{M#你}沒事。那個…有件小事，風魔龍牠在戰鬥的時候，有沒有，掉下來什麼東西呢？鱗也好，皮也好，一點點就可以，我想，研究一下…"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#「神之眼」，是我最重要的實驗器材。欸？就、就是實驗器材啊，沒有了「神之眼」，很多跟元素相關的實驗，就沒辦法進行了。{F#妳}{M#你}說戰鬥？啊…偶爾吧，去野外找材料的時候，偶爾會用到。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "這個房間裡，都是我收藏的骨頭。放在左邊櫃子裡的，有蜥蜴，青蛙，還有草魚，掛在前面的是野豬，右邊角落裡的那個，是丘丘人…啊，別緊張，不用害怕，其實都是很可愛的東西，習慣了就好了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}看，種在這裡的冰霧花，其實每一朵都不一樣。這一朵冰元素含量更高，這一朵花期更長…嗯？{F#妳}{M#你}問那一朵，哦，那一朵叫「參式冰霧花改十七號放大版」，特點，嗯…就是更大一點。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於諾艾爾…",
      "text": "她…經常會主動幫我的忙，但有時候太熱情了，反而…讓我有點苦惱。有一次，她看到我實驗室門前堆了三箱器材，就很俐落地幫我搬了進來，但其實…那些都是我剛剛搬出去的。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於可莉…",
      "text": "她已經被琴團長關過好多次禁閉了，但只要被放出來，不久就又會闖禍，唉，不知道有沒有真的反省過。啊…我答應她，要幫她做一個會蹦會跳，又很安全的蹦蹦，只不過現在，設計上還有不少問題…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於琴…",
      "text": "我有點不敢和琴團長說話，因為她太嚴肅了…我知道她是個很好的人，但、但知道歸知道，害怕…還是會害怕。我通常都不會去打擾她，實在有不得不找她的事，我…我也會拜託阿貝多先生。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於麗莎…",
      "text": "我覺得她，好像懂的很多。她明明沒有看過我的研究，但有好幾次，都給了我最關鍵的建議。她到底是怎麼知道的呢？是…觀察？還是推理呢？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於凱亞…",
      "text": "唔…我知道他喜歡開玩笑，也沒有存心捉弄我的意思。可是，我實在是…分不清他的哪句話是真話，哪句話又是玩笑，所以最後要不然就變得很尷尬，要不然，就是我出洋相…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於阿貝多·藝術",
      "text": "當他的助手，每天都能學到很多。重點不是知識，而是「天才」的思考方法，無論是多麼複雜的問題，他總能抽絲剝繭，再一一解決。在我看來，那就是藝術…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於阿貝多·天賦",
      "text": "#{F#妳}{M#你}說天賦？嗯…假如和他做同樣的研究，可能確實一輩子都沒法超過他。但，我研究「生物煉金」並沒有故意要躲開他的意思，只是…嗯，我和他恰好有不同的愛好，還有夢想，僅此而已吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於安柏…",
      "text": "#我很好奇，為什麼她做的布偶，名字叫「兔兔伯爵」呢？和兔子沒什麼關係吧。唔…{F#妳}{M#你}說，頭上的髮帶，很像兔耳朵？…有道理，但其實這是刻板印象，也有很多兔子耳朵是垂下來的。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於菲謝爾…",
      "text": "#{F#妳}{M#你}是說《菲謝爾皇女夜譚》？我知道，作者創造出的世界很有意思，要是能親眼去看一看就好了…欸？{F#妳}{M#你}在說那個「菲謝爾」啊？她啊…嗯，她…應該是沒辦法帶我去的。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於優菈…",
      "text": "游擊騎士的工作很危險，優菈小姐的行動又格外大膽，所以我幫她製作了一個偵察裝置，這樣她就不用潛入敵人的營地了。但優菈小姐的氣勢太嚇人，我有點怕她，告訴她使用方法的時候，不小心漏掉了幾條注意事項，結果真的發生了意外…\\n怎麼辦？我會不會被她記仇了…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解砂糖·其一",
      "text": "#瞭解我？{F#妳}{M#你}…是對「生物煉金」感興趣嗎？{F#妳}{M#你}有疑問的話，我會盡量幫{F#妳}{M#你}準確答案的。嗯？不是煉金，而是「我」？唔，這個，我也不知道該說什麼…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解砂糖·其二",
      "text": "研究的本質，是尋找答案的過程。這個過程有時候很繁瑣，也很累，但每次只要看看累積起來的成果，就會覺得…嗯，我是真的很喜歡做這樣的事。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解砂糖·其三",
      "text": "小時候，我有兩個好朋友，我們無話不說。本來我以為，我對她們瞭解得一清二楚，但後來發生了一些事，我突然就…看不透她們了。她們現在在哪裡，在做什麼，還記不記得我，這些…我都不知道。就算再好的朋友，也會變成這樣呢。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解砂糖·其四",
      "text": "#告訴{F#妳}{M#你}一個小秘密，我對誰都沒有講過。「生物煉金」的最終目標，是創造出「仙境」…對，就是童話裡的那個，能找到永遠的快樂與幸福的「仙境」。嘿嘿，有點幼稚對吧？但，我現在都還相信那個故事。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解砂糖·其五",
      "text": "#嗯…如果{F#妳}{M#你}忙的話，就去忙吧，我不想給{F#妳}{M#你}添麻煩。不忙？真的不忙嗎？沒事的，就算忙也沒關係，一個人做實驗我早就習慣了。啊…真、真的不忙？那…那可不可以，幫幫我的忙？或者…只是陪我說說話，什麼的…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "砂糖的愛好…",
      "text": "#我喜歡看起來很規則的東西，{F#妳}{M#你}看，書架上每一本實驗紀錄，厚度都是一樣的，實驗台上的幾百瓶藥水，都是按功效與顏色分別排好…欸？…欸欸？！為什麼這瓶紫色的藥水會出現在這裡！我、我要全部整理一遍！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "砂糖的煩惱…",
      "text": "#我想知道，{F#妳}{M#你}平時休息的時候，會幹些什麼呢？每到休息日，我就找不到事情做，只能發呆…明明做實驗的時候時間過得很快，休息的時候，怎麼就有種度日如年的感覺…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我會提煉出甜甜花的花蜜，做成糖塊。腦袋轉不動的時候吃一塊，就又可以集中精神了。做研究，糖分的補充是很重要的。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#知道了很多「生物煉金」的知識之後，我就不怎麼吃蘑菇了…{F#妳}{M#你}應該知道吧？蘑菇，是長在死掉的生物上的，聯想到同類的其他東西，我、我的胃口就…呃…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "好吃！啊…趁著現在狀態最好，趕緊把研究做完…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "比我做的營養餐好吃了不少。嗯，我也算改善伙食了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "對不起。我對這道菜，還是有點…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！我做了好幾個月的實驗，終於，可以把這個藥水送給{F#妳}{M#你}了。它能喚醒{F#妳}{M#你}這一年來最美好的回憶，名字叫做「生物秘藥參玖壹陸號」…唔，不是「參壹玖陸號」，是「參玖壹陸號」啦！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "「生物煉金」的研究，終於有突破了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#這次旅行，我又收集到了很多研究材料，謝謝{F#妳}{M#你}，我會好好利用的。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#最近我在做實驗的時候，經常會莫名地期待起來，什麼時候又可以和{F#妳}{M#你}一起去冒險。唔…好奇怪，這是為什麼呢？我要研究看看。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我收集到的研究素材，已經很足夠了！花更多時間在我的身上，會…會很浪費的！至少…也讓我用「生物煉金」，做點什麼回禮給{F#妳}{M#你}！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "吸附力測試。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "陸參零捌式風單元！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "確認…安全距離！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "超擴散態！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "柒伍式超級風模組！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "無相之風…擬造！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "寶箱的出現成因…也值得研究。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "真希望實驗材料也能成箱出現啊。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "太好了，有這麼多素材！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "這種誤差，還能接受…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "有點，超出預想…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不痛不痛，不痛的…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "快回來，我這裡有藥水！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "小心點，看準了再上！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "研究…又失敗了。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "還需要…調整。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "該…睡一會了。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "不應該啊…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "眼鏡會碎掉的！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "希望能幫上忙…"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "我、我會努力的！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "實驗…一定要成功。"
    }
  ]
}