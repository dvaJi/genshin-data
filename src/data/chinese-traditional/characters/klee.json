  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "西風騎士團，「火花騎士」，可莉，前來報到！…呃——後面該說什麼詞來著？可莉背不下來啦…"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·收穫",
      "text": "#可莉今天又勇敢地抓到了花紋奇怪的蜥蜴！從沒見過這種圖案，{F#妳}{M#你}要看看嗎？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·冒險",
      "text": "要和可莉一起去炸魚嗎？雖然被抓住就是一整天的禁閉，但魚很好吃，所以值得！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·守則",
      "text": "「城裡放炮禁閉室報到」、「炸彈傷人琴找上門」、「放火燒山可莉完蛋」——這就是可莉在騎士團的生存守則。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "哼哼哼，這次的炸彈可是防水的。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "啊！什麼東西爆炸了？！…哦，是打雷啊。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "颳大風了…",
      "text": "風神保佑，把可莉的炸彈往合適的地方吹吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安！帶可莉出去玩吧！我們一起來冒險！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午飯時間到了！啊…吃什麼呢？我來看看《提瓦特遊覽指南》…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好！拜託{F#妳}{M#你}也幫我跟霍夫曼先生說說吧，可莉不是小孩子了，可莉晚上也可以出去玩——帶我出去玩——"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#雖然出來玩的時候說不想回家，但天黑以後的曠野，不認識路…拜、拜託{F#妳}{M#你}回去的時候，把我也送回家好不好…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於可莉自己·肇事",
      "text": "嗚…這次居然炸歪了大風車的葉片…真對不起！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於可莉自己·賠償",
      "text": "#我，我還挺會做手工的，請讓我幫{F#妳}{M#你}們重新做一個…什麼？禁止雇傭童工？嗚…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·騎士",
      "text": "#呼呼…榮譽騎士，可莉作為「火花騎士」，可以說是{F#妳}{M#你}在西風騎士團的前輩喔？所以！所以…這次我闖的禍，能不能幫我隱瞞一下…"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·玩伴",
      "text": "#不行！才九點，可莉今晚一定要撐到看完馬戲團的午夜專場！{F#妳}{M#你}是可莉的玩伴吧！那就別想現在就把我送回家，略略略略…"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "這個小小的玻璃球，就代表了巴巴托斯大人對可莉的肯定嗎…唔…究竟是認可了我的哪一部分呢？是自由嗎？那以後要不要更自由地出去炸魚，來回應巴巴托斯大人的期待呢…？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "可莉知道，騎士團的牆是不能炸的。雖然打通了能從禁閉室出去很方便，但凱亞哥哥說，這樣做了以後，琴團長恐怕會讓我再也見不到第二天的太陽…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "每一隻蜥蜴的花紋都是不同的，有些蜥蜴的尾巴乾燥以後磨成粉，可以當做炸藥的材料哦。這是阿貝多哥哥告訴我的事。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於雷澤…",
      "text": "我們是朋友！雷澤努力對抗危機、保護可莉的樣子，讓人安心！…唔…雖然基本上都是我把危機帶到他身邊的…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於父母…",
      "text": "爸爸和媽媽都是全大陸有名的旅行家！媽媽寫的《提瓦特遊覽指南》，有好多餐館和旅店都很在意它的權威評價呢。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於凱亞…",
      "text": "凱亞哥哥是好人！《騎士團生存守則》就是凱亞哥哥幫可莉寫的。可莉闖禍的時候，他也經常幫忙遮掩呢。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於安柏…",
      "text": "安柏姐姐是好人！兔兔伯爵摸起來也是毛茸茸的，而且還會爆炸，太棒了！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於琴…",
      "text": "琴團長是好人！雖然…有點可怕…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "奇怪的大人，一直都是不太開心的樣子。唔…為什麼不喜歡笑呢？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於麗莎…",
      "text": "麗莎阿…麗莎姐姐是好人！每次可莉靠近她的工坊，她就會給可莉好吃的茶點…欸？說起來我想進她的工坊，好像一開始是想做新的炸藥來著…？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於班尼特…",
      "text": "班尼特哥哥是好人！和他一起冒險，可莉總能有更多收穫！…雖然班尼特哥哥自己總是什麼寶物都找不到，嗯…這是為什麼呢？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於迪奧娜…",
      "text": "迪奧娜姐姐是好人！「靠一己之力摧毀蒙德酒業」的想法好有趣，可莉也要用炸彈來幫忙！——呃，雖然不太懂什麼叫做「蒙德酒業」，是怪物嗎？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "阿貝多哥哥跟可莉有個秘密的約定！要是可莉看到工坊門前掛著「實驗進行中」的牌子，就要晚點再去找他。阿貝多哥哥不工作的時候，會很耐心地陪著可莉，所以可莉也會很耐心地等著的！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於莫娜…",
      "text": "莫娜姐姐是好人！她每次找阿貝多哥哥和可莉玩的時候，都會說好多聽不明白，但是很有趣的東西！可莉喜歡她來玩！"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於砂糖…",
      "text": "砂糖姐姐是好人！她問我，想不想要一個會跑會跳的蹦蹦！嘿嘿嘿，當然想要了，我還想要好幾百個，讓蒙德的街道上，臺階上，廣場上，全是蹦蹦！"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於杜林…",
      "text": "好耶！小杜林哥哥現在住在蒙德，我要天天找他玩！炸魚的時候，我想叫小杜林哥哥帶我飛上很高很高的地方，在天上丟蹦蹦炸彈！"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於洛恩…",
      "text": "洛恩哥哥是好人！他上次幫可莉拿了好多好吃的，卻只要了可莉一小盒蠟筆！要是洛恩哥哥有時間，可莉願意教他畫畫，再叫法爾伽叔叔一起！"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於布倫妮…",
      "text": "布倫妮姐姐是好人！媽媽寫信來說布倫妮姐姐其實是想找人陪她玩，但是不好意思說出口，所以，可莉決定了！下次去炸魚、去雪山、去金蘋果群島、去希穆蘭卡…都要邀請布倫妮姐姐一起去玩！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解可莉·其一",
      "text": "#{F#妳}{M#你}好！{F#妳}{M#你}是來找可莉玩的嗎？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解可莉·其二",
      "text": "#是啊，這個炸彈是可莉最新改良的作品！{F#妳}{M#你}看我做得好不好？…呃——如果是在什麼縱火現場發現的話，那就不是我做的，絕對不是。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解可莉·其三",
      "text": "哎，雖然新炸藥的配方，很多都是在被關禁閉的時候想出來的…但如果不被關禁閉的話就更好了…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解可莉·其四",
      "text": "這是嘟嘟可，是可莉很久以前就交到的好朋友。要記得它的名字哦，以後別叫它「掛在妳包上的玩偶」啦。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解可莉·其五",
      "text": "#謝謝{F#妳}{M#你}總是幫可莉解決麻煩！就用這串「可莉烤魚」來報答{F#妳}{M#你}吧！——呃，其實魚是直接在湖裡就被炸彈烤熟了，不過這件事就和平時一樣，假裝不知道好了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "可莉的愛好…",
      "text": "可莉喜歡毛茸茸的東西。比如嘟嘟可、蒲公英，還有雷澤的頭髮。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "可莉的煩惱…",
      "text": "#唉，{F#妳}{M#你}是好人，我是壞孩子…等我這次的禁閉結束、好好反省過以後，再來找{F#妳}{M#你}帶我出去玩…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "蒙德的鱸魚是很好吃的，從果酒湖裡抓到的尤其好吃！這可不是亂說的，連媽媽也認同可莉的想法喔。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "討厭蒙德蟹——什麼蟹都討厭——可莉要出去玩——不要坐在餐桌前慢慢剝殼——"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "好香好香！可莉已經吃到吃不下啦…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#今天也吃到了好吃的東西，可莉好開心！謝謝{F#妳}{M#你}！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#看起來很好吃，但吃起來不太方便…嘿嘿，{F#妳}{M#你}來幫幫可莉好不好！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！過生日很開心，{F#妳}{M#你}比可莉大，那過生日的次數一定比可莉多吧？可莉很羡慕！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "嗯，新型炸彈研究完畢！趁琴團長發現之前，開溜！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "又進步了一點！不過琴團長總是說：「進步是分內之事。」"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#謝謝{F#妳}{M#你}總是陪我一起收集研究用的材料！如果{F#妳}{M#你}想學習炸彈的製作方法，我也可以來教{F#妳}{M#你}哦。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#很久以前，第一次聽到爆炸聲的時候，我沒有害怕…後來我才知道，大部分人不是這樣的…不過，{F#妳}{M#你}也不害怕我的炸彈呢！嘿嘿，太好了，可莉果然交到了很好的朋友！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "蹦蹦炸彈！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "彈起來吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "嘿咻！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "轟轟火花！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "火力全開！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "全——都可以炸完！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "啦啦啦~"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "噠噠噠~"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "可莉又找到新的寶物了！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "亮閃閃的，好開心！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "地下會不會埋著更多寶箱呢…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "哇…怎麼會這樣…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "琴團長…它欺負我…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "玩累了，有點暈…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "火花騎士，爆破支援！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "你不要緊吧？"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "看我成功開溜…！啊，失敗了。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "可莉…想回家了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "又闖禍了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "過分…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "好疼啊！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "可莉來幫忙！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "鏘鏘——可莉登場。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "好耶！是大冒險。"
    }
  ]
