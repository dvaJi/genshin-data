  "outfits": [
    {
      "id": 202901,
      "name": "琪花星燭",
      "description": "可莉出演關鍵劇目時所穿的精緻服裝，色彩明麗，如同點綴著鮮奶油花朵和明紅蠟燭的蛋糕，能將快樂與笑容帶往冒險所至的每個角落。",
      "isDefault": false,
      "characterName": "可莉",
      "characterId": 10000029,
