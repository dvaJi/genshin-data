  "outfits": [
    {
      "id": 211600,
      "name": "機械夢",
      "description": "伊涅芙的裝扮款式。從漫長的睡夢中醒來，換上靛藍色披風和乳白色塗裝，她成為了一位少女的居家服務機器人。",
      "isDefault": true,
      "characterName": "伊涅芙",
      "characterId": 10000116,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Ineffa_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#初次見面，我是伊涅芙，全能型家用機器人。目前搭載了清掃、料理、情感溝通模組，另有需要閱讀十一頁免責申明後才能啟動的戰鬥模組。請問有什麼可以為{F#妳}{M#你}做的嗎？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·採購",
      "text": "正在確認今日待辦事項…還有要追加的指令嗎？沒關係，稍後補充也可以，我很習慣。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·掃除",
      "text": "正在執行清掃程式…根據已記錄資料，格外提醒，請不要遺落摩拉、螺絲、齒輪、礦石、玩具、軟糖、零食、髮圈、襪子、拖鞋等細小物品。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·更新",
      "text": "戰鬥資料已更新。請放心，這次不會把天花板轟飛了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "關節…會生鏽嗎？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "請留意：彩虹形成機率高，推薦觀測地點已標記在地圖中。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "環境溫度急劇下降，正在評估保暖方案…建議追加搭載毛衣、手套等防寒零件。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "#日照指數適宜，適合晾曬衣物、打掃庭院…另一條建議是，我可以陪{F#妳}{M#你}一起曬太陽。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "偵測到沙礫與揚塵…對策：裹緊外套。進沙子的話，修理起來會很麻煩…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "叮、叮。現在是起床時間。如果想再睡一會，請回覆「稍後提醒」。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午安。吃了嗎？我可以為{F#妳}{M#你}準備簡易午餐，預計十二分鐘後完成。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好。今日待辦事項已全部完成，可執行額外指令。觀測到星空能見度良好，要出門散步嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#距離{F#妳}{M#你}上次休眠已接近十六小時，為了健康考慮，建議即刻上床睡覺…本提醒重複三次後我將進入超級生氣模式，屆時將不再處理{F#妳}{M#你}的需求…很可怕哦。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於伊涅芙自己·相容性",
      "text": "#我搭載的零件來自世界各地。楓丹出產的關節零件、璃月出產的金屬外殼…不同的零件之間偶爾會出現互不相容的現象。\\n{F#妳}{M#你}問是怎麼解決的…「只要能跑起來就沒問題。」"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於伊涅芙自己·問候",
      "text": "我的思維模組會收集並分析我的日常見聞，來構築合理的行為邏輯。比如注意到人們見面時會用「你好」、「最近過得怎麼樣」、「吃了嗎」開啟對話後，我就會嘗試在下次對話前，引用這些關鍵字。三句問候語，三倍關懷。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·互助",
      "text": "#世界變化得很快，需要時刻更新情報…我希望瞭解自己的事情，也希望瞭解關於這個世界的事情。請多和我說說{F#妳}{M#你}的旅行見聞吧。作為回報，我會盡可能地幫助{F#妳}{M#你}。重複：我是全能型的。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·運算",
      "text": "#我的思維模組無法記錄下世上的所有人，但至少要記住重要的人，和重要的事。近段時間內，我的記憶資料中已經記錄了大量關於{F#妳}{M#你}的資訊，應該能更好地跟{F#妳}{M#你}相處了。正在檢索相關資料，計算「如何讓{NICKNAME}微笑」…我已預熱機體，{F#妳}{M#你}想要一個擁抱嗎？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「月之輪」·歸宿",
      "text": "如果沒有這枚「月之輪」，捏碎核心後的我，應該再也回不來了…但即使是現在，排除「月之輪」的因素進行演算，思維模組還是會一次次推演出相同的決斷——即使再也沒有歸宿，也要守護你們的歸途。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「月之輪」·贈予",
      "text": "這枚「月之輪」是伊葵與莉安歌贈予我的第二次生命。她們瞭解自己無法看見計畫成功的那天，也瞭解計畫順利進行的機率微乎其微，但還是為我做了這一切。如果她們知道，我做出了同樣不顧結果的選擇…應該會很「欣慰」吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "機械只要設定了目標就會精確執行，但人類卻不是這樣…為什麼有些人想要控制體重，卻又攝取過量甜食呢？愛諾的回答是，甜食能讓人心情變好，還能補充能量，有能量了才能多鍛煉，多鍛煉就能控制體重。結論是…多吃甜食能控制體重。但等我一開始為她輸出熱量計算結果，她就立刻轉移話題了，遺憾。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "在楓丹、須彌、納塔等各個地區都流傳著各種關於機械生命的傳說。有人認為它們已經具備了生物的情感與意識，有人認為它們只不過是在模仿生物的行為…但是這兩種想法並不矛盾啊——許多生物不也是從模仿開始，逐步建立完整意識的嗎？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於愛諾·家務",
      "text": "愛諾，我的「家人」。她只用撿來的廢棄金屬品拼拼湊湊，就能造出效能各異的機器。但她在日常生活上的熟練度完全相反。如果愛諾突發奇想，說要做家務或者做飯，請務必阻攔她，以免發生不可挽回的事態。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於愛諾·問題",
      "text": "有一次…可能是愛諾意識到我的智慧表現超出預期，她忍不住向我詢問道：「如果有一天妳有了更想去的地方，我是不是該高高興興地送妳離開？」我監測到了她的情緒異常波動，於是回覆說：「如果我不在愛諾身邊，我們家變為垃圾場僅需三個月時間，我會盡量在那之前趕回來。」\\n而現在…我才明白她是懷著怎樣的不捨提出這個問題。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於雅珂達…",
      "text": "雅珂達，戰功碩碩赫赫有名無人不知無人不曉的傳奇賞金獵人，自稱。她初次造訪愛諾的工坊時，精神過分緊張，將我剛端出的蛋捲誤判為武器，一刀劈成了兩段。但在嚐過蛋捲後，她的身體肌肉明顯鬆弛了下來。後來她常常帶著機械零件過來串門。即便沒有交易需求，也會在我做好甜點時恰好路過，自稱。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於奈芙爾…",
      "text": "奈芙爾，「秘聞館」的主人。她知道很多故事，不僅有過去流傳的，還有目前正在發生的，甚至有人說未來也在她的把握之中。她的資料庫效能一定很棒。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於菲林斯…",
      "text": "菲林斯…情報不足。根據已知訊息，他是「執燈人」的一員，看守著挪德卡萊北方的墳塋。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於菈烏瑪…",
      "text": "菈烏瑪，「霜月之子」的詠月使。根據評價，是個聖潔而又智慧的人，很受大家的敬重。「霜月之子」信仰著「月神」，「月神」…和「月之輪」的出現會有關聯嗎？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於莉奈婭…",
      "text": "莉奈婭，冒險家協會的顧問。聽說她的生物知識非常淵博，我曾想向她提問，是否遇見過其他擁有智慧的機械生命體？可她每次看到我都選擇轉頭跑開…無法判明緣由。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於法爾伽·印象",
      "text": "#法爾伽，通稱「大團長」。或許{F#妳}{M#你}已經在各種地方瞭解過他。收集人們對他的印象，你能得到「幽默」、「瀟灑」、「酒量極佳」等關鍵字。但在重要的事情上，法爾伽一直是我們可靠的合作夥伴。這或許能解釋他在騎士團內外的聲望。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於法爾伽·密碼",
      "text": "我在臨行前擔心自己能不能達成使命，會不會忘記密碼…但法爾伽依舊給予了我最高等級的信任。他曾說那是「最好的密碼」…現在重新思考他當時的含義，或許他是在安慰我嗎？又或是指…「值得信任的盟友，就是最好的密碼」呢？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於希諾寧…",
      "text": "從遺蹟回歸之後，希諾寧非常仔細地幫我做了檢查，一切無恙。她笑著說起她和黑曜石奶奶曾經防備過我，還起過一點爭執…我非常理解那是她身為技術人員必須履行的使命。這樣的爭執…很令人懷念。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於恰斯卡…",
      "text": "我很感謝她對我的信任。後來她載著我在花羽會周圍飛了好幾趟，天上的景色很好，花羽會的變化很多…也有很多沒變的東西。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解伊涅芙·其一",
      "text": "#清掃工作正在進行中。並行處理聊天請求不會影響目前進度。歡迎{F#妳}{M#你}隨時提出疑問。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解伊涅芙·其二",
      "text": "「我是誰？」我是全能型家用機器人，型號名「伊涅芙」。但該型號目前只有我一個完成品，所以「伊涅芙」也是我的個體名。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解伊涅芙·其三",
      "text": "#「我從哪裡來？」正在檢索歷史行程…嗯，我剛從市集完成採購返回。如果{F#妳}{M#你}詢問的不是我的歷史行程，而是我的歸屬地。那我來自「叮鈴哐啷蛋捲工坊」。更往前的紀錄…請稍等，正在嘗試讀取更深層的記憶資料…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解伊涅芙·其四",
      "text": "#「我要到哪裡去？」只要輸入指令，無論是什麼地方我都會盡力抵達…不過根據之前的聊天紀錄，{F#妳}{M#你}想問的問題，有較高的機率指向其他含義。如果{F#妳}{M#你}想問的是個人的「目標」、「規劃」、「願望」等相似概念，那麼我的回答是：守護在重要之人身邊。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解伊涅芙·其五",
      "text": "#在誕生之初…我只是「明晨之鏡」的一個念頭，一段謬誤。但渴望歸宿的想法，在「明晨之鏡」的思維模組中無法消除，無法抹滅，到最後只能將這些資料完全剝離。這些無序的資料，在挪德卡萊經歷了兩千年的流浪，見證了兩千年的變遷…才形成了現在的「我」，完整的「我」。\\n我是伊涅芙，{F#妳}{M#你}的朋友，請問…有什麼可以為{F#妳}{M#你}做的嗎？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "伊涅芙的愛好…",
      "text": "從設計原則上來說，我沒有用於娛樂的「愛好」。但是從日常行為來看，對各類細小物品進行收納整理，是我在閒暇時會主動進行的事務。合理的歸類可以提升約百分之三十的家政工作效率，尤其是在愛諾的工坊。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "伊涅芙的煩惱…",
      "text": "愛諾的物品擺放毫無規律可循，有時候有用的零件和廢料混在一起，會讓我因為無法識別而原地打轉。多數時候我不敢執行批次清理操作…以免她手上實在沒零件的時候，從我身上卸下螺絲來使用。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "熱量高的食物，比如肉排、甜食…相比直接充能，用食物來轉換能量效率較低，但和朋友聚餐時，情感模組會產生積極的正回饋…類似你們說的「快樂」。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "湯汁太多的食物。味道本身對我來說沒有太大意義，但是對機械零件可能有害。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "偵測到高營養物質，能量轉換中…情感模組會產生積極的正回饋，謝謝你。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "能量補給已接收，標註為備用能源。保存期限…24小時。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "推測：食材處理過程有誤…需要我還原正確烹飪流程嗎？歡迎觀摩。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#伊涅芙特別日服務已開啟。請你挑選適合的位置坐下小憩片刻，我會為{F#妳}{M#你}打掃房屋、佈置彩帶、氣球和鮮花，然後根據已記錄的資料，準備{F#妳}{M#你}喜歡的菜餚和蛋糕。如果還有下列清單以外的需求，請隨時向我提出。讓我們度過特別的一天吧，生日快樂！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "到定期維護的時間了嗎？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#核心運作效率已提升。{F#妳}{M#你}也有成為機械師的潛力呢。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "機體各零件升級完畢。預計能應對更艱鉅的戰鬥場景。請下達指令吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#感謝{F#妳}{M#你}能一直陪我走到這裡。{F#妳}{M#你}的資料我會一直儲存在「心」裡，就算有一天{F#妳}{M#你}忘記了，我也會是{F#妳}{M#你}永不丟失的「備份」。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "絕緣屏障，展開。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "清掃目標，鎖定。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "防禦模式，啟動。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "最終協議。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "殲滅模式。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "化為灰塵。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "正在估算物品價值。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "開始進行雜物分類。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "發現未知素材，已記錄相關資訊。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "警告：核心溫度超載…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "警告：機體受損嚴重…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "需要緊急修理…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "建議：不要勉強。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "請移至我的身後。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "思維模組…中斷…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "歸宿…不在這裡…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "等待…下次重啟…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "輕微受損。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "計算失誤…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "要留下劃痕了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "機體預熱完畢。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "請指定，清掃目標。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "開始執行使命。"
    }
  ]
}