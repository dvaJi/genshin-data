  "passives": [
    {
      "id": "lunacys_lure",
      "name": "月亮誘發的瘋狂",
      "description": "觸發<b><span style=\"color:#FFD780FF\">引力干涉</span></b>時，哥倫比婭將獲得月誘效果，使自身的暴擊率提升5%，持續10秒。該效果至多疊加3層。",
      "level": 1
    },
    {
      "id": "law_of_the_new_moon",
      "name": "新月自己的法則",
      "description": "處於<b><span style=\"color:#FFD780FF\">月之領域</span></b>中的角色觸發月曜反應時，將分別獲得以下效果：<br/>·<span style=\"color:#FFD780FF\">月感電反應</span>：雷暴雲對符合條件的目標進行雷擊時，有33%機率額外進行一次雷擊。<br/>·<span style=\"color:#FFD780FF\">月綻放反應</span>：觸發月綻放反應時，將為隊伍提供一枚特殊的<b><span style=\"color:#FFD780FF\">山月草露</span></b>，每18秒至多依此方式為隊伍提供3枚山月草露。<br/>·<span style=\"color:#FFD780FF\">月結晶反應</span>：觸發月籠諧奏時，每枚月籠有33%機率額外進行一次攻擊。",
      "level": 4
    },
    {
      "id": "moonsign_benediction_moonlight_lent_unto_you",
      "name": "月兆祝賜·借汝月光",
      "description": "隊伍中的角色觸發感電/綻放/水元素結晶反應時，將轉為觸發月感電/月綻放/月結晶反應，且基於哥倫比婭的生命值上限，提升隊伍中角色造成的月曜反應的基礎傷害：每1000點生命值上限都將提升0.2%月曜反應的基礎傷害，至多依此方式提升7%傷害。<br/><br/>此外，哥倫比婭在隊伍中時，隊伍的<span style=\"color:#FFD780FF\">月兆</span>將會上升一級。",
      "level": 0
    },
    {
      "id": "lunar_vigil",
      "name": "月的守望",
      "description": "處於挪德卡萊或霜月區域時，隊伍中自己的角色倒下時，哥倫比婭將復甦該角色，並為其恢復生命值，恢復值基於哥倫比婭的好感等級，該效果每100秒至多觸發一次。該效果在秘境、征討領域、深境螺旋中無效。<br/>此外，對受到月矩力影響的部分小動物，哥倫比婭似乎有著特殊的親和力…",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1251,
      "id": "radiance_over_blossoms_and_peaks",
      "name": "遍照花海，隱入群山",
      "description": "施放元素戰技<span style=\"color:#FFD780FF\">萬古潮汐</span>時，還會立刻觸發一次等同於<b><span style=\"color:#FFD780FF\">引力干涉</span></b>的效果，該效果每15秒至多觸發一次。<br/><span style=\"color:#FFD780FF\">月兆·滿輝</span><br/>觸發引力干涉時，若為哥倫比婭累積最多引力值的月曜反應類型為：<br/>·<span style=\"color:#FFD780FF\">月感電反應</span>：為隊伍中自己的目前場上角色恢復6點元素能量。<br/>·<span style=\"color:#FFD780FF\">月綻放反應</span>：提升隊伍中自己的目前場上角色的抗打斷能力，持續8秒。<br/>·<span style=\"color:#FFD780FF\">月結晶反應</span>：喚出<span style=\"color:#FFD780FF\">雨海護盾</span>，傷害吸收量受益於哥倫比婭生命值上限的12%，對<span style=\"color:#80C0FFFF\">水元素傷害</span>有250%的吸收效果，持續8秒。<br/><br/>隊伍中附近的所有角色造成的月曜反應傷害<b><span style=\"color:#FFD780FF\">擢升</span></b>1.5%。",
      "level": 1
    },
