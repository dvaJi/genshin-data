  "passives": [
    {
      "id": "there_shall_be_a_plea_for_justice",
      "name": "公理終有辯訴之日",
      "description": "萊歐斯利的生命值低於60%時，將獲得「恩典之誡」，使下次<span style=\"color:#FFD780FF\">普通攻擊·迅烈傾霜拳</span>的重擊強化為懲戒·凌躍拳：不消耗體力，造成的傷害提升50%，並在命中後為萊歐斯利恢復生命值，回復量相當於萊歐斯利生命值上限的30%。<br/>每5秒至多依此方式獲得一次「恩典之誡」效果。",
      "level": 1
    },
    {
      "id": "there_shall_be_a_reckoning_for_sin",
      "name": "罪業終有報償之時",
      "description": "萊歐斯利的目前生命值提升或降低時，若萊歐斯利處於<span style=\"color:#FFD780FF\">冰牙突馳</span>的寒烈的懲裁狀態下，寒烈的懲裁將獲得一層「檢償之敕」效果，該效果至多疊加至5層，每層使萊歐斯利的攻擊力提升6%。",
      "level": 4
    },
    {
      "id": "the_dukes_grace",
      "name": "公爵的恩饋",
      "description": "合成武器突破素材時，有10%機率獲得兩倍產出。",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 861,
      "id": "terror_for_the_evildoers",
      "name": "予行惡者以懲懼",
      "description": "突破天賦「公理終有辯訴之日」的「恩典之誡」轉變為：<br/>萊歐斯利的生命值低於60%，或在<span style=\"color:#FFD780FF\">冰牙突馳</span>的寒烈的懲裁狀態持續期間，斥逐拳的第五段攻擊命中時，將獲得「恩典之誡」，每2.5秒至多獲得一次「恩典之誡」效果。<br/><br/>此外，懲戒·凌躍拳獲得以下強化：<br/>·造成的傷害提升進一步提升至200%。<br/>·命中時，若處於寒烈的懲裁狀態下，該狀態的持續時間延長4秒，在一次寒烈的懲裁狀態持續期間，至多依此方式延長一次。<br/><br/>需要解鎖突破天賦「公理終有辯訴之日」。",
      "level": 1
    },
    {
      "_id": 862,
      "id": "shackles_for_the_arrogant",
      "name": "予驕暴者以鐐鎖",
      "description": "施放<span style=\"color:#FFD780FF\">黑金狼噬</span>時，突破天賦「罪業終有報償之時」的每層「檢償之敕」效果都將使造成的傷害提升40%。<br/>需要解鎖突破天賦「罪業終有報償之時」。",
      "level": 2
    },
    {
      "_id": 863,
      "id": "punishment_for_the_frauds",
      "name": "予婪詐者以譴罰",
      "description": "<span style=\"color:#FFD780FF\">普通攻擊·迅烈傾霜拳</span>的技能等級提高3級。<br/>至多提升至15級。",
      "level": 3
    },
    {
      "_id": 864,
      "id": "redemption_for_the_suffering",
      "name": "予貞苦者以拯贖",
      "description": "懲戒·凌躍拳為萊歐斯利恢復生命值的回復量提升為50%生命值上限，需要解鎖突破天賦「公理終有辯訴之日」。<br/>此外，萊歐斯利受到治療時，若此次治療回復量溢出，將根據萊歐斯利是否處於目前場上產生不同的效果：處於目前場上時，萊歐斯利的攻擊速度提升20%，持續4秒。處於隊伍後臺時，隊伍中所有自己的角色攻擊速度提升10%，持續6秒。上述這兩種攻擊速度提升效果無法疊加。",
      "level": 4
    },
