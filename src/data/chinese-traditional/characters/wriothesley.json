  "outfits": [
    {
      "id": 208600,
      "name": "凜冬夜嘯",
      "description": "萊歐斯利的裝扮款式。彰顯威嚴與力量感的衣裝，粗獷的灰狼粗鍊是他統領梅洛彼得堡的標誌。",
      "isDefault": true,
      "characterName": "萊歐斯利",
      "characterId": 10000086,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Wriothesley_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，請盡量簡潔地說明{F#妳}{M#你}的來意。嗯？不是公事？那我反而更緊張了。\\n坐下詳談吧。順帶一提，{F#妳}{M#你}可以稱呼我「公爵」，他們都是這樣叫的，我也聽習慣了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·貼紙",
      "text": "如果看到我背後黏著美露莘畫的貼紙，幫我撕掉吧？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·寵物",
      "text": "我曾經考慮過要不要在辦公室裡養寵物，但小貓小狗在不見陽光的地方生活太可憐了，還是算了吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·忠告",
      "text": "不要違法。還有什麼需要叮囑的嗎？哦對了，不要違法。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "下雨了？還好。要是在梅洛彼得堡感到頭頂在滴水的話，問題可就大了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "心中無罪的人，在這種天氣下也能安睡吧。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "嗯…和水下的冷不太一樣。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "「太陽之下無新事」，但可以找個好地方野餐。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早，晨報上的天氣預測怎麼說？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "現在特許餐廳人正多，我叫人送餐到辦公室來吧！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "已經這個時間了？總覺得才剛剛喝過下午茶。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安，我要等會再睡，趁夜深人靜正好算幾筆帳。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於萊歐斯利自己·誤解",
      "text": "他們不是把我想得太神秘，就是太全能了。我只有一雙眼睛、一對耳朵，怎麼可能照顧到梅洛彼得堡的每一個角落呢？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於萊歐斯利自己·小憩",
      "text": "我早已服完刑，現在是自由公民，當然可以來水上閒逛。\\n不必擔憂。要是梅洛彼得堡必須要我一直待在下面才能穩定運作，那也太不健康了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·收監",
      "text": "#我對很多人的第一印象都是從收監登記表開始的，看來{F#妳}{M#你}也不是例外。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·出獄",
      "text": "都說沒了利益牽扯才好做朋友，我們可以從現在開始。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我以前跟一些罪人學過藉助化學藥劑使用元素的方法。無論「神之眼」的發放歸哪個部門管，他們似乎不是很介意這點僭越之舉。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "知道怎麼做比較容易逃脫警備隊的追捕嗎？幫自己取個又長又難記的名字，然後他們在大喊「那個誰，把手舉起來！」時就會卡住。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "「不勞動者不得食」，這句話很久以前就刷在梅洛彼得堡牆上了。我也不知道是誰安排的，在水下的確很實用。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "記得有次被那維萊特叫去上面談事情，走到沫芒宮門口正好看到他在路邊淋雨。我幫他撐了傘，他禮貌地道了謝，表情卻不太自然，我大概是打擾到了什麼吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "可能是因為我認罪得太快，芙寧娜小姐在當年的審判中看起來興致索然，早早就退場了。讓水神大人失望可是大事，只好今後多送些好茶給她了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於希格雯…",
      "text": "希格雯護士長具備一名醫護人員所需的全部美德，並關心著身邊每一位同伴。\\n不過她似乎從我身上學到了一些壞習慣，比如時常和她的美露莘朋友們打賭，看誰能偷偷在我的東西上貼更多貼紙。不，我並不覺得困擾。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "#克洛琳德應該是{F#妳}{M#你}能找到最好的決鬥代理人了，實力有目共睹。我從未和她比試過，沒有那個必要。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於林尼…",
      "text": "我承認，拔除「壁爐之家」安插在水下的眼線是種挑釁，而他們的回應是只派幾個孩子下來，的確令我有點難辦。是真心覺得他們也可以被犧牲，還是看準了我不會對小孩下狠手呢…唉。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "梅洛彼得堡和刺玫會有一些物資方面的合作，但僅限於此。並不是不信任娜維婭小姐或是質疑她的能力——實際上恰恰相反——只不過，我們之間水下水上的事務互不干涉是我與卡雷斯先生約好的規矩，維持不變就好。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "梅洛彼得堡應該用不到她的服務，有些痕跡就是作為「前車之鑑」被留下來的…氣味也是痕跡的一種，不是嗎？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於夏沃蕾…",
      "text": "被特巡隊關照過的犯人大多滿老實的，這位隊長功不可沒。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解萊歐斯利·其一",
      "text": "理論上來講，完全不認識我的人會比較幸福。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解萊歐斯利·其二",
      "text": "身上的疤痕？曾有深海巨獸企圖占領梅洛彼得堡，我和牠搏鬥時被抓傷了…當然是假的，不要信。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解萊歐斯利·其三",
      "text": "#{F#妳}{M#你}知道嗎？手銬只要型號相近，大部分都能夠用通用的鑰匙打開，只有我這副不一樣。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解萊歐斯利·其四",
      "text": "#我的個人能力其實很有限。{F#妳}{M#你}看，我既不會治病，也不會做發明，更不會造大船。我只是知道該去哪裡找人做這些事，而他們恰好願意賣我這個面子而已。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解萊歐斯利·其五",
      "text": "我現在過著還不錯的生活，但也仍然羨慕一些我得不到的東西——比如安逸快樂的童年，和輕易信賴他人的能力。可能有人認為這很矛盾，或者難以啟齒，我倒是覺得沒什麼不好承認的——何必和自己的本心過不去呢？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "萊歐斯利的愛好…",
      "text": "#拳擊？不算是愛好吧，只是生活所需。{F#妳}{M#你}有什麼其他推薦嗎？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "萊歐斯利的煩惱…",
      "text": "我的確有著楓丹人的長相，但沒辦法百分之百肯定——只能跳胎海水確認了？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "喝咖啡時我習慣加牛奶，茶的話，兩塊糖就好了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#{F#妳}{M#你}喝過護士長做的奶昔嗎？能從中嚐出…「荒蕪」的味道。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "完美的調味，我就不擅長這個。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "好吃。下次換我請客。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "等我去泡杯茶。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#楓丹的孩子是伴隨著雙親的心願與祝福誕生的，不過我願意相信這世上的每一個人都是如此。和這個比起來，我的祝願就有點微不足道了。\\n不，如果{F#妳}{M#你}犯法的話我是沒辦法幫{F#妳}{M#你}減刑的，只能在今天幫{F#妳}{M#你}安排一份特殊的福利餐。所以生日期間還是安分一點，保證我們可以在水上慶祝，好嗎？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#能獲得{F#妳}{M#你}的信任，是我的榮幸。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#這下必須還{F#妳}{M#你}一個人情了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#哈，{F#妳}{M#你}怎麼看起來比我還要得意？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我喜歡力量和希望的信號，會讓我感覺未來一切往好的方向發展。這並非悲觀，只是陳述事實，因為現實本來就不可能一帆風順。但有個好消息，就是當壞事發生時，我們可以站在同一陣線，對吧？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "開始吧！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "別跑啊！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "請留步。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "一路順風。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "注意防寒。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "無需畏懼，直面罪責。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "沒有鎖嗎？真方便啊！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "先收好吧，總能派上用場。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "無主之物最好充公…所以這裡什麼都沒有，對吧？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不用慌。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不叫增援？也可以。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "見機行事。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "退後。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "去醫務室。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "抱歉，沒能守住…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "孤注一擲的後果…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我沒有異議。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "這麼客氣？"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "…還可以。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "開工。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "請我出外勤？走。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "我盡力，但不保證贏。"
    }
  ]
}