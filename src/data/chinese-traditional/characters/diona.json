  "outfits": [
    {
      "id": 203900,
      "name": "糖粉青釀",
      "description": "迪奧娜的裝扮款式。貓尾酒吧明星調酒師工作時的日常裝束。",
      "isDefault": true,
      "characterName": "迪奧娜",
      "characterId": 10000039,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Diona_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#「貓尾酒館」的招牌調酒師，迪奧娜，我的出場費可是很貴的。唔？{F#妳}{M#你}居然…不是為了酒才來的？哼，那{F#妳}{M#你}的邀請…我就勉為其難地接受了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·放鬆",
      "text": "哈~~好舒服，身體都變得更柔軟了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·思考",
      "text": "蜥蜴尾巴、胡椒、星螺…還差點什麼才能調出「難喝到頭腦炸裂的酒」呢？嗚…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·等待",
      "text": "#才，才沒有在等{F#妳}{M#你}。我只是，正好在休息而已！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "嗚嗚…討厭下雨…去屋子裡吧。唔，只是因為弄乾衣服很麻煩！才不是什麼怕水呢！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "欸？！…我沒有在發抖！沒有！…嗚…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候·玩雪",
      "text": "這個涼颼颼的觸感，哇…好棒，好有趣。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候·觀雪",
      "text": "白茫茫的雪在風裡跳舞，真好看呢。嗯…我旁邊的座位還空著，沒人坐哦。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "陽光很好…",
      "text": "#走囉，曬太陽…{F#妳}{M#你}不去我可就自己去了哦…唔，最後一次機會！走不走！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早，把櫥櫃裡那罐醃泥鰍遞給我一下——好咧，我要開始摧毀蒙德酒業啦。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安·異響",
      "text": "#咕嚕嚕…嗯？沒有！{F#妳}{M#你}什麼都沒有聽到！"
    },
    {
      "id": "1005",
      "type": 1,
      "title": "午安·罐頭",
      "text": "#這個魚肉罐頭是我好不容易省下來的，別，別看啦！最多…最多只能給{F#妳}{M#你}嘗一口。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "失敗了…又失敗了…大家都喝得好開心，嗚…別安慰我，我才不需要安慰…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#{F#妳}{M#你}沒有貓的夜視能力，走夜路不要緊吧？要我護送{F#妳}{M#你}的話…欸，有燈啊？…誰，誰要護送{F#妳}{M#你}啦，快點走快點走。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於迪奧娜自己…",
      "text": "#耳朵和尾巴才不是什麼裝飾，是「凱茨萊茵家族」血統的象徵，真是少見多怪。呃…{F#妳}{M#你}、{F#妳}{M#你}把手伸過來幹什麼？這個…唔…好吧，耳朵的話可以讓{F#妳}{M#你}摸一下…但是尾巴、尾巴絕對不可以！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·飲料",
      "text": "想喝無酒精飲料？難倒是不難，但是沒有意義！無論成功還是失敗，都和摧毀蒙德酒業的目標沒有關聯。我才不會做呢。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·貴賓待遇",
      "text": "#喏，這個是「了不起的夏日夢幻憂鬱珊瑚氣泡茶」，只是因為最近無聊才做的。熱門產品？排隊搶購？{F#妳}{M#你}在說什麼呢，我可沒聽見。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·聊天需要",
      "text": "#唔…要是，要是{F#妳}{M#你}感覺孤單了，我可以隨便陪{F#妳}{M#你}聊聊天。我還是知道很多事情的哦！也是很好的…那個叫什麼，說話對象哦。沒錯沒錯！來跟我，多說說話吧…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·好奇心",
      "text": "#是什麼是什麼？{F#妳}{M#你}拿著的是什麼？快給我看看！說不定丟到酒裡能做出相當難喝的…啊，什麼嘛，原來只是長得奇怪了點的蘑菇而已呀，真無趣。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」·遺傳",
      "text": "問我的「神之眼」是怎麼來的？哼，是、呃…是凱茨萊茵的家族遺傳！唔？杜拉夫先生根本沒有神之眼？欸——露餡了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "關於「神之眼」·來歷",
      "text": "#為什麼非得告訴{F#妳}{M#你}啦，哼！算了，看在{F#妳}{M#你}一直追問的份上，看在…看在我們是朋友的份上。那次我爸爸外出打獵，差點出大事，在大雨中，我腦袋裡想的全部事情就是要找到他，救出他…好了啦，滿意了吧！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "龍脊雪山上，會不會長著奇珍異草呢。「擁有致命的苦味」或者「沾到一點就嘴巴發麻」這樣？要拔好多下來！然後…嘿嘿嘿…嚯嚯。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "我撲…捕捉蝴蝶的技巧可是一流的。喂，不是啦！抓蝴蝶是為了加進酒裡做出難吃的味道，不要把我當成貓啦！喵！"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "那個…迪盧克，是我最討厭的人！沒有迪盧克就不會有蒙德酒業，沒有蒙德酒業爸爸就不會喝酒，爸爸不喝酒就…就會陪我了，哼。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於凱亞…",
      "text": "為什麼連我的「護衛隊長」也是個令人討厭的酒鬼啦！就是那個，說起話來總是笑盈盈的傢伙！喝起酒來一杯接一杯的，沒完沒了。呼！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於溫迪…",
      "text": "溫迪？不太熟的樣子。但說到吟遊詩人，就是那夥會給酒鬼們唱歌助興的人吧。那就不喜歡！不喜歡不喜歡。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "芭芭拉小姐的粉絲們，都是大哥哥大姐姐…好羡慕，為什麼我的粉絲都是一群大叔呢。嗚…可惡，哼，不想了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於琴…",
      "text": "琴啊，騎士團的代理團長，嗯…難得一個不喝酒的成熟大人…但總感覺認真過了頭，騎士團的大家對我有些過度保護了吧？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於阿貝多…",
      "text": "首席煉金術士大人？唔…我這種一直調出好酒的體質，他會知道破解的方法麼？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於麗莎…",
      "text": "麗莎姐姐，很和善對吧，很溫柔對吧？但是，這樣的姐姐也經常喝酒！嗚嗚嗚…這是為什麼啦…蒙德城已經沒救了吧…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於香菱…",
      "text": "我向香菱討過一份「口感搭配特別糟糕的食物組合」，據說是她親自實踐下來的，絕對難吃什麼的…沒用，完全沒用。「續杯」兩個字已經聽到貓耳朵都生繭了！嗚…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於可莉…",
      "text": "可莉每次來找我玩的時候，我都只好把她帶去離酒館遠一點的地方。酒和炸彈…實在是太危險了！就算我想摧毀蒙德酒業，也得用堂堂正正的方式。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於父親…",
      "text": "爸爸是我最尊敬的人！爸爸是最厲害的人！但是…喝了酒的爸爸，唔——果然還是要早點終結蒙德的酒業！沒時間閒聊啦！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解迪奧娜·其一",
      "text": "「調酒師」可是很忙的！即使不在酒館工作，也要抽出時間來收集配方。所以，所以沒有要緊事情的話，就不要來打攪我。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解迪奧娜·其二",
      "text": "#{F#妳}{M#你}不會…也像那些討厭的酒鬼一樣要我學貓咪叫吧？不會的，絕對不會的！我才不是什麼抖抖耳朵伸伸懶腰的寵物！我可是…可是…「酒業殺手」！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解迪奧娜·其三",
      "text": "#{F#妳}{M#你}問我…為什麼「酒業殺手」變成了「貓尾酒館」的招牌…？{F#妳}{M#你}，{F#妳}{M#你}是故意這樣問的吧！就是想看我的笑話。嗚，壞人！再也不幫{F#妳}{M#你}調喝的了，水也不給！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解迪奧娜·其四",
      "text": "#別再惹我了啊，我寬容大度，但也不好欺負！我警告{F#妳}{M#你}，我生起氣來可是會咬人的！喵！雖然不一定捨得咬{F#妳}{M#你}…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解迪奧娜·其五",
      "text": "#我和{F#妳}{M#你}…已經成為好朋友了，對吧。我隱約記得…我以前也有過這樣一個朋友，但我不確定那是不是夢…\\n把{F#妳}{M#你}的手給我。啊嗚，唔…暖和的。這樣就好，不要變成夢走了…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "迪奧娜的愛好…",
      "text": "#我喜歡打獵，追捕獵物可是我的強項！但爸爸說野外情況瞬息萬變，只有跟著可靠的大人一起，才能深入森林。{F#妳}{M#你}…算是可靠的大人吧？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "迪奧娜的煩惱…",
      "text": "嗯…到底怎樣才能調出難喝的酒呢…連我給予厚望的惡夢搭配——「醬油牛奶絕雲椒椒配蒲公英籽特調」都被說成是「小迪奧娜又有進步了」，嗚…我不會認輸的…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我喜歡吃魚！作為主食的魚…爸爸做的魚！但是…不要作為下酒菜，那是對魚的褻瀆！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "胡蘿蔔、馬鈴薯、洋蔥、番茄…這些味道都不太喜歡。我，我可不是吃素的啊！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "好吃…我，我就隨便問一下喔，下次還有嗎？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}可別指望我嚐了點甜頭，就會來蹭{F#妳}{M#你}…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#喂…{F#妳}{M#你}是把我當成路邊的野貓了嗎！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#炸魚，配上這個我特別調製的醬料，給{F#妳}{M#你}。\\n…沒有加奇怪的東西！我認真調味的手藝才不會差呢，先嘗過才可以說話。\\n哼…這才對嘛…唔，那個，生日快樂。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "貓的眼睛，看得見黑暗中的一切獵物！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "貓的耳朵，聽得到地上最細微的腳步聲。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "貓的四肢，爬得上全提瓦特最高的樹。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#貓的鼻子，聞得出熟悉的、喜歡的人…唔？！是{F#妳}{M#你}聽錯了！我怎可能說出那種話…嗚…"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "嘿…呀！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "咻咻——"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "目標確認。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "攻守兼備。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "抓到你了！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "我可不好欺負！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "迪奧娜特調！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "貪杯的下場…哼！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "反省吧，酒鬼！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "唔，來了。"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "出發，出發！"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "衝刺結束·其一",
      "text": "呼。"
    },
    {
      "id": "710002",
      "type": 2,
      "title": "衝刺結束·其二",
      "text": "哈唔…"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "飛起來囉。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "讓酒變難喝的材料啊，出現吧！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "亮晶晶的…想要…撲過去！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "寶箱裡有些什麼，我很好奇！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我不會認輸…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "喵…喵…！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "勝負還沒分呢！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "太亂來啦！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "去休息去休息！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "酒的味道…好臭…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "泉水精靈…不要走…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "眼睛…睜不開了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "沒躲開…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "從哪裡來的？"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "狩獵開始！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "果然需要我出手嘛！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "哼，就包在我身上。"
    }
  ]
}