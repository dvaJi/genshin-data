  "outfits": [
    {
      "id": 207500,
      "name": "寂忿空相",
      "description": "{REALNAME[ID(1)]}的裝扮款式。修驗之人的常服，斗笠可以為雨中的流浪人留下一隅駐足之地，對心中肆虐的風嘯雷鳴，卻無能為力。",
      "isDefault": true,
      "characterName": "流浪者",
      "characterId": 10000075,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Wanderer_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#要我報上名來？此行世間，我名號諸多，雖然隨便一個對凡人來說都高不可及，但於我都已成過往。\\n想稱呼什麼就隨{F#妳}{M#你}吧，讓我見識一下{F#妳}{M#你}的品味，可別讓我失望。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·風",
      "text": "這世上沒有純粹的自由。風也會有吹到盡頭的時候。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·說話方式",
      "text": "我說話刻薄嗎？只是實話實說罷了，接受不了的人才該自己反省原因。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·寒暄",
      "text": "寒暄就免了吧，沒話找話的樣子也太可笑了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "#想用我的斗笠遮雨？虧{F#妳}{M#你}提得出這種要求。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "見了點陽光就能高興成這個樣子？幼稚。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的時候…",
      "text": "嘖…煩心。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的時候…",
      "text": "明明和雨沒什麼區別，卻討人喜歡多了…真是人各有命。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "#這點程度，{F#妳}{M#你}都能做到吧？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#「快醒醒——太陽要曬屁股囉——」…哈，{F#妳}{M#你}不會以為我會這麼叫{F#妳}{M#你}起床吧？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#我不需要吃飯。管好{F#妳}{M#你}自己和身邊的小東西，就算是讓我省心了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "終於，無聊的一天就要結束了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "在我身邊睡不著嗎？呵呵。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "#關於{REALNAME[ID(1)]}自己·人偶",
      "text": "燒掉一個人偶會留下灰燼。至於灰燼中會誕生什麼…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "#關於{REALNAME[ID(1)]}自己·心",
      "text": "那種東西隨便了。執著於註定不屬於自己的事物只是在浪費時間，現在的我有更重要的事情要做。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·對手",
      "text": "#對{F#妳}{M#你}我以前的對峙耿耿於懷？喔。所以呢，{F#妳}{M#你}要怎麼做？慢慢想，我不急。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·同夥",
      "text": "#我不可能皈依「正義」，但既然說過要償還{F#妳}{M#你}的恩情，就定會做到。\\n倒是{F#妳}{M#你}，在和我接觸的時候可能需要想想自己立場哦？萬一被人撞見，說{F#妳}{M#你}與罪人「狼狽為奸」，我可概不負責。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#所謂「神明的注視」令人不爽，但反正是可用的力量，我不挑。{F#妳}{M#你}覺得「風元素」有其深意？呵，為什麼會這麼想？神明行事蠻橫又無理，我不是讓{F#妳}{M#你}領教過嗎？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#沒有。{F#妳}{M#你}想問什麼就問吧，我看心情回答。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "看啊，鳥雀會炫耀羽毛，松鼠忙著囤積食物，人類為了柴米油鹽整日奔走。頭腦簡單的生物活得就是比較容易呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "#她選擇不除掉我，或許不只是因為我有利用價值。也許是因為她很賢明，又有至善之心，又或許，是她在我身上看到了孤獨的影子…{F#妳}{M#你}說我是在惡意揣測？哈，這不是當然的事情嗎！我又不是什麼好人。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "對自己的造物視若不見，卻又美其名曰不忍心干預…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於「女皇」…",
      "text": "人人都稱讚她的溫柔與慈愛，卻不知「愛」也是「罪」的一種。搞不好是補償心理作祟喔？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於「丑角」…",
      "text": "「丑角」是坎瑞亞的遺民——除此之外，我對他知之甚少，也從未與他有過什麼密切的交流。但他似乎對我意有所求，以前指派過不少重要的任務給我，包括前往「深淵」。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於「隊長」…",
      "text": "#「剛正不阿的『隊長』」、「正直果敢的『隊長』」、「戰功累累的『隊長』」…這些愚人眾裡流傳的言論，就算是人偶的耳朵也要聽得長繭了。{F#妳}{M#你}不覺得，絕對的「正直」，其實是個極其危險的隱患嗎？更不用提，「隊長」擁有頂尖的實力。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於「博士」…",
      "text": "真遺憾，小吉祥草王讓他消除了那麼多的切片，剝奪了我將他一片一片千刀萬剮的快樂。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於「少女」…",
      "text": "#試問：當遇到一名「無論何時」都懵懂無知、「無論做什麼」都麻木平淡的「少女」時，該作何反應？我的話，尚可一戰；{F#妳}{M#你}的話…因為太有良知，還是離她遠點吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於「僕人」…",
      "text": "道貌岸然的偽君子。她對人展露「優雅」與「親切」都只是為了更確實地「控制」罷了。而直面過她瘋狂一面的人，大多已經…呼~。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於「公雞」…",
      "text": "也只有「公子」才會覺得「公雞」是真心誠意、不求回報地關心他和他的家人。雖然那位市長大人確實做了不少實事，但稍微有點腦子的人都能看出來，這裡的潛臺詞是「你的家人都在我掌控之中」吧？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於「木偶」…",
      "text": "她除了自己的研究以外什麼都不關心，性格惡劣得很。但即便做到如此極端的地步，卻也只是製造了大量廢物，在我仍是執行官時還低我一席，真是可憐。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於「富人」…",
      "text": "那個第九席啊，他對「公平交易」過分偏執，甚至試圖推翻神與人之間天生的不平等。不過凡人就是這樣，容易有不切實際的妄想，倒也沒什麼特別的，就像他平庸的能力和眼光一樣——選擇和「博士」密切合作，哼，是不會有好下場的。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於「公子」…",
      "text": "頭腦簡單，四肢也不太發達。讓他做最後一席都是在拉低執行官的整體水準。萬幸，我已經不在其列了。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於「女士」…",
      "text": "她的灰燼裡什麼都沒有。我對失去未來的人不感興趣。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於八重神子…",
      "text": "油腔滑調的妖怪，為博神明的青睞，將自己偽裝成關心人類的樣子。其實，只是為了找樂子吧？"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "關於楓原萬葉…",
      "text": "#{F#妳}{M#你}說楓原家的後人？那豈不是…喔？他也有風元素的「神之眼」，還扛下過雷電將軍的一刀？呵呵…哈哈哈哈哈哈哈哈！"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "關於賽索斯…",
      "text": "#{F#妳}{M#你}為什麼覺得我會認識他？就因為他經常追在我後面吵著要看我的帽子嗎？我們沒怎麼說過話，第一次見面他就問我是不是叫阿帽——這又何嘗不是以貌取人？哼，阿帽，這個名字倒是流傳開了…"
    },
    {
      "id": "4017",
      "type": 1,
      "title": "關於杜林…",
      "text": "#那個傢伙剛從書裡出來時就已經帶了一堆問題了，沒想到成為人類之後，問題更多。每次都把信寫那麼長，字還歪歪扭扭的看都看不清楚，嘖。\\n{F#妳}{M#你}要是閒得發慌，倒是可以去為他解答解答。免得他走上什麼歪路。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "#想要瞭解{REALNAME[ID(1)]}·其一",
      "text": "真稀奇，竟然想瞭解我。會招來麻煩喔？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "#想要瞭解{REALNAME[ID(1)]}·其二",
      "text": "啊，一定有很多、很多人想要找我清算前塵。無所謂，我來者不拒——或者說，還滿期待的呢。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "#想要瞭解{REALNAME[ID(1)]}·其三",
      "text": "我曾以為成神便可摒棄無用的情感，現在不這麼覺得了。至少「憤怒」，無論來自他人還是自我，都是方便使用的工具。\\n怎麼會有人永遠不生氣呢？難以想像，這種人就沒有一點脾氣嗎？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "#想要瞭解{REALNAME[ID(1)]}·其四",
      "text": "在進入世界樹時，我心中只有一個念頭：希望自己從未來到這個世上。\\n世界樹回應了這個願望，卻沒有帶來我期盼的結果。這片土地的命運在捉弄它的囚徒方面一如往常。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "#想要瞭解{REALNAME[ID(1)]}·其五",
      "text": "#{F#妳}{M#你}我有過交集，但終有一天會去往不同的地方。誰知道以後會發生什麼呢？走著瞧吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}的愛好…",
      "text": "愛好？那是閒人才有空研究的東西吧，我看起來像是沒事做嗎？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}的煩惱…",
      "text": "#在想怎麼才能把{F#妳}{M#你}甩掉，去胡作非為一番。——開玩笑的，{F#妳}{M#你}信了？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "有茶嗎？越苦越好，回味無窮。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#甜甜膩膩的東西，牙齒都要黏在一起了。{F#妳}{M#你}自己留著吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#還可以吧，算是{F#妳}{M#你}為數不多的優點了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "不錯，至少做出了能入口的食物。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#想害我？難不成{F#妳}{M#你}笨到忘了我非凡胎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#把手給我。…呵，別緊張啊，只是帶{F#妳}{M#你}去高處看看而已。\\n如何？應當是非凡的景色。感謝就免了，謝來謝去的沒意思。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#…看得出來，{F#妳}{M#你}盡力了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#風吹過來了…{F#妳}{M#你}做了什麼？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#給我力量，{F#妳}{M#你}不擔心後果嗎？…好吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#雖說我可以成為{F#妳}{M#你}的助力，但將我視為同伴仍是件危險的事情，希望{F#妳}{M#你}清楚自己在面對什麼。若{F#妳}{M#你}不畏懼，便站到我身後吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "風起！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "俯瞰凡塵！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "怒風騰天！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "不度螻蟻！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "鼠雀之輩！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "叫大聲點！"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆發·其四",
      "text": "把頭低下！"
    },
    {
      "id": "200005",
      "type": 2,
      "title": "元素爆發·其五",
      "text": "毫無自知之明！"
    },
    {
      "id": "200006",
      "type": 2,
      "title": "元素爆發·其六",
      "text": "就憑你，也配直視我？"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "風馳！"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "衝刺開始·其二",
      "text": "疾風隨行！"
    },
    {
      "id": "700004",
      "type": 2,
      "title": "衝刺開始·其三",
      "text": "…真慢。"
    },
    {
      "id": "700005",
      "type": 2,
      "title": "衝刺開始·其四",
      "text": "#沒叫{F#妳}{M#你}跟著。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "多餘。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "#嗄？這{F#妳}{M#你}也要？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "#{F#妳}{M#你}自己拿著玩吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "習慣了。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不值一提。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "要你何用！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "也沒指望你派上用場。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "墜入…深淵…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "皆為…徒勞…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "罪業的報償…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "不過如此。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "…可笑。"
    },
    {
      "id": "910003",
      "type": 2,
      "title": "受重擊·其三",
      "text": "…你死定了。"
    },
    {
      "id": "910004",
      "type": 2,
      "title": "受重擊·其四",
      "text": "等著求饒吧。"
    },
    {
      "id": "910005",
      "type": 2,
      "title": "受重擊·其五",
      "text": "做好付出代價的準備。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "沒想到…叫我做什麼？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#{F#妳}{M#你}最好有要事相求。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "非我不可？…好吧，勉為其難。"
    }
  ]
}