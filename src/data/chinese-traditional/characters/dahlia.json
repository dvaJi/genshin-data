  "outfits": [
    {
      "id": 211500,
      "name": "無瑕禱言",
      "description": "塔利雅的裝扮款式。比起拘束莊重的教會長袍，活潑的助祭塔利雅更喜歡輕便的衣褲。誠然，虔信是值得神明青睞的優秀品格，但自由更受風神巴巴托斯讚許，塔利雅相信慈愛的風之神一定也會認同自己的著裝品味！",
      "isDefault": true,
      "characterName": "塔利雅",
      "characterId": 10000115,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Dahlia_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#初次見面，我是塔利雅，西風教會的助祭，風神巴巴托斯的傳道者。如{F#妳}{M#你}所見，現在正閒得發慌。{F#妳}{M#你}最近遇到了什麼麻煩的事嗎？要不要講給我聽聽？我很有可能會笑，但我更有可能會幫{F#妳}{M#你}解決問題哦。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·風的聲音",
      "text": "#{F#妳}{M#你}聽到了嗎？風中的聲音…好像有人被石頭敲到了頭？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·無聊",
      "text": "好閒，真希望能遇到哪位愛找麻煩的糊塗蛋啊…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·熱鬧",
      "text": "走，看熱鬧去！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "風來雨至，這也是神諭的一種。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "我聽說這是某位神明傳達神諭的方式…不是我要說自家神明好話…巴巴托斯溫柔多了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "起風的時候…",
      "text": "起風了，開始禱告吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安啊，閣下。晨禱剛剛結束，真幸運，我的提問再次得到了風神的解答。當然，我也為{F#妳}{M#你}祈福了哦。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午安，要不要去酒館坐一會？正常人肯定不會在這個時間買醉。但正因如此，現在去酒館的話，更有可能遇到一些有趣的人。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好，要不要去城牆上吹吹風？{F#妳}{M#你}問為什麼是城牆？當然是因為視野好呀！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚風帶來了神明的勸告——到休息的時間了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於塔利雅自己·職責",
      "text": "#助祭的職責主要是輔助西風教會完成祝禱儀式，但由於某些過人的天賦，我還負責聆聽神明的旨意，並傳達神明的諭示。某種意義上說，我算是風神在教會的代行人。另外{F#妳}{M#你}可能想不到，我還是教會合唱團的領唱哦。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於塔利雅自己·神的偏愛",
      "text": "每當蒙德人面臨重大的難題，就會向風神尋求指示。而這時，維多利亞修女就會邀請我主持晨禱，因為我的提問一定會得到巴巴托斯的回答。哈哈，或許是因為我這個人很討神明喜歡吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·事蹟",
      "text": "#我聽說，{F#妳}{M#你}無論到什麼地方，都能陷入各式各樣的麻煩——{F#妳}{M#你}看我，我不光擅長製造麻煩，也擅長解決問題哦。怎麼樣，我們難道不是天生的好搭檔嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·身分",
      "text": "我有想過，騎士團的榮譽騎士和教會的助祭，某種意義上職責相通，不是嗎？我們的崗位看似輕鬆閒適，可我們經常接觸人們心中最沉重的煩惱，並代表風神吹散它們——啊，多麼高尚，這杯蘋果釀敬我們自己！"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我一直以為我會獲得風元素的神之眼，但結果就是如此有趣…或許在巴巴托斯眼裡，我並不是需要他投下目光的迷途之人？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#{F#妳}{M#你}有沒有想過，讓祈禮牧師芭芭拉擔任「偶像」，其實是一種很高明的宣傳策略？或許當事人並不知情，這也不是艾莉絲女士的初衷，但它的結果整個蒙德城都喜聞樂見。人們喜歡芭芭拉，天天都有理由走入教堂。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "據說風神的子民死後都會化為蒲公英，它們從不甘心停留在自己扎根的土地，每當風起之時，便紛紛奔向天空。即便不能遠行，也要把自己釀成最烈的酒，用醉意給無趣的人帶來大膽的改變。啊，願風神保佑，讓我死後化為蒲公英。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於溫迪…",
      "text": "溫迪，我親愛的朋友。需要請示風神的旨意時，他會主動為我解惑；而一旦遇到他不方便親自出手的時候，我會出面擺平。嗯…總的來說，我們保持著一種非常良性的合作關係呢。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於琴…",
      "text": "在西風騎士團，我最熟悉的人或許就是琴團長，大概是因為我和她都經常出現在需要處理麻煩的場合。不過，我們解決問題的思考方式大不一樣，我從不吝於和她分享好點子，而她也一直堅持她的做法。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "#芭芭拉是我的同事，也是我的朋友。每當我需要幫助時，她總是願意施以援手。作為回報，我會盡量找出更多可以讓她幫忙的事，然後繼續邀請她幫忙。嗯？哪里奇怪？{F#妳}{M#你}知道的，芭芭拉總能在幫助別人的過程中收穫快樂，她快樂，我們也都為她感到開心啊。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於蘿莎莉亞…",
      "text": "我和蘿莎莉亞算是知根知底的好朋友，也早就習慣了她平時不在教堂。不過剛認識的時候，她非常不願意與我分享她的秘密。後來我找到了一種總是能抓到她的辦法，她才和我進行了互利的交易。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於凱亞…",
      "text": "凱亞是我最要好的酒友，能偶爾為溫迪提供酒館包月暢飲服務，還要多虧他從中斡旋。不過，他也沒少用這個理由鼓勵我請客。好吧好吧，誰讓我是深受大家信賴的巴巴托斯傳道者呢。以風神的名義，讓我們乾杯吧！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "#迪盧克是一位非常特別的酒館老闆，唯有他能夠識破凱亞給我的話術，拒絕我的砍價。除此以外，我對這位前任騎兵隊長的瞭解，也不比檔案室記載的多多少。這麼說來，{F#妳}{M#你}對他肯定瞭解更多吧？怎樣，有興趣去「天使的饋贈」一起聊聊嗎？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於可莉…",
      "text": "可莉呀~有一次被她撞見我用水史萊姆練習水壓劍，她非常開心，說又掌握了一種讓蹦蹦炸彈蹦得更高的辦法。我也非常開心，記得那幾天都陪她玩到很晚，試著把史萊姆和蹦蹦們送到更高的地方——直到我們把城門頂上的磚牆炸塌，被守門的勞倫斯老哥告發，從那以後琴團長就嚴禁我用水壓劍配合蹦蹦炸彈了。嗚嗚。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解塔利雅·其一",
      "text": "比起呆在教堂裡，我更喜歡去人群聚集的地方，人越多越好。作為教會的助祭，聆聽信眾的煩惱既是我的職責，也是我的愛好。但是，並非所有人都有向他人傾訴的勇氣，所以我必須主動出擊。長椅上的那位姑娘為什麼要嘆氣呢？牆邊的大叔又為何要眉頭緊鎖？人與人之間的種種，一直吸引著我啊。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解塔利雅·其二",
      "text": "#對於我來說，幫別人處理麻煩更多是興趣使然。很多人討厭處理麻煩，那是因為他們沒有發現其中的樂趣。想像一下，一對年輕人彼此傾慕，卻因為不瞭解對方的想法而羞於表達心意，為此苦惱許久。{F#妳}{M#你}稍加安排，於是某次聆聽唱詩班表演時，他們意外地發現對方就坐在身邊，偷偷看向對方時視線相交，臉上浮起了紅暈…欣賞這樣有趣的瞬間，就是我擔任助祭的動力之一啊。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解塔利雅·其三",
      "text": "#{F#妳}{M#你}是不是很好奇我如何獲得風神的偏愛？其實也不難，只要足夠瞭解蒙德城的酒館，並按時邀請一位特別的客人喝酒就行。哈哈，不要這麼驚訝，我的確和{F#妳}{M#你}一樣知曉風神的秘密，並從未向他人透露過。是偉大的巴巴托斯說服了我，保留秘密才是更有趣的選擇。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解塔利雅·其四",
      "text": "我很喜歡助祭這個身分，但我也必須承認身為助祭還是有煩惱的，那就是如何傳達神諭。人們面臨重大的問題時，巴巴托斯給出的許多指示其實相當直觀、簡潔。但是為了讓人們心悅誠服，更迅速地採取行動，我必須讓這種指示更具有「神聖感」。「歸風帶來了高天的甘露，風神的子民啊，可曾在土地上播撒辛勞，靜候恩澤？」其實就是「快點播種，馬上下雨」的意思，但是前者明顯比後者更像是「神聖的諭示」，不是嗎？所以，每次請示之後，我都要花費不少心思才發言呢。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解塔利雅·其五",
      "text": "#偷偷告訴{F#妳}{M#你}，我一直想離開蒙德城，前往風也吹不到的地方，再捲進各式各樣的麻煩裡…就像{F#妳}{M#你}那樣。可是，只要迷茫的人們還需要尋求風神的指引，我就無法忍心脫身吧？嗯…不如多尋找些生活中的「樂趣」作為裝點吧！比如風中的音符，佳釀裡的氣泡…{F#妳}{M#你}身上的新故事。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "塔利雅的愛好…",
      "text": "請求神明賜予我足夠精彩的偶遇，哪怕它本身是麻煩也行。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "塔利雅的煩惱…",
      "text": "人生中的絕大部分時間，都只能重複波瀾不驚的日常，唉…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#嗯…{F#妳}{M#你}聽說過變態辣嗎？味覺的頂點，不外乎如此吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "麵包、白粥…沒有味道的果腹之物，跟樹皮又有什麼區別？樹皮還有木香呢…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#感謝{F#妳}{M#你}的饋贈，願風神庇佑{F#妳}{M#你}！品味這種料理，最好能配上新釀的蒲公英酒——要不我請客？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#感謝{F#妳}{M#你}的饋贈，我會在晨禱的時候為{F#妳}{M#你}祈福。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "不好意思，很久之前我收到過來自風神的諭示。身為西風教會的助祭，我被禁止食用這種料理。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#願沃土賜我以豐登的五穀，釀製迎客的美酒。願歸風賜我以初綻的花瓣，裝點此刻的相聚。願我等的神明賜福友人的誕辰，為{M#他}{F#她}降下庇佑…嗯，該吹蠟燭了吧？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我的虔誠得到了回饋，但我仍會繼續禱告，因為神明依舊注視著我們。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#純淨的風拂過人群後，就帶上了各式各樣的氣息。小孩子的懵懂，中年人的慨嘆，都藏在這風中。{F#妳}{M#你}品味到了嗎？這風中的氣息。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#邁出腳步，踏上{F#妳}{M#你}必行的路吧。門外的鈴聲便是神明的諭示，正在喚{F#妳}{M#你}動身。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "禱告完畢，聽憑風引。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "好玩的來了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "再熱鬧點！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "水~壓~劍！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "#願神明庇佑{F#妳}{M#你}！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "風神啟示！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "西風，加護我身！"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "感謝風神。"
    },
    {
      "id": "800002",
      "type": 2,
      "title": "打開風之翼·其二",
      "text": "沒掉下去就好。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#神諭指示{F#妳}{M#你}收下這份財物，這是為了防止後來人為此陷入紛爭。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "剛剛有微風吹過，這是來自巴巴托斯的饋贈啊！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "要不把空箱子蓋好，留在這裡？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我還要出席明天的晨禱呢…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "治療人員在哪裡？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哎呀，不該捲進來的…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "看來戰鬥相當激烈啊。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "要不讓我跟對面聊一下，先停戰？"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "巴巴托斯…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "鬧得…太大了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "晨禱，可以不去了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "麻煩來了？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "稍等一下…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "神諭沒提到啊…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "湊個熱鬧！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "應神諭而來。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "開始禱告吧！"
    }
  ]
}