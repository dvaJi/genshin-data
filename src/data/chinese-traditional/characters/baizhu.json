  "outfits": [
    {
      "id": 208200,
      "name": "君臣佐使",
      "description": "白朮的裝扮款式。肩上的氅衣以長生喜好的草木薰染，清芬長伴，安神消乏。",
      "isDefault": true,
      "characterName": "白朮",
      "characterId": 10000082,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Baizhuer_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#嗯，我是「不卜廬」的大夫白朮。身體哪裡不適，有幾天了，和我說說吧…哦？不是來問診而是專程來找我的？抱歉，恐怕要請{F#妳}{M#你}稍候了，我接待完後面的病人就來和{F#妳}{M#你}詳談。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·慢節奏",
      "text": "<color=#37FFFF>白朮：</color>這一路上的無限風光，得慢慢欣賞才有意趣。\\n<color=#37FFFF>長生：</color>你是不是跑不動了？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·天道",
      "text": "生死有道，天行有常…呵呵，不試一試，誰能知道這天道的邊界在哪裡呢？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·體質",
      "text": "#咳…咳…老毛病了，不是什麼大事，{F#妳}{M#你}別擔心。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨天濕寒，還是找個地方避避吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "別怕，小心看路，不要在樹下行走，雷電傷不了我們。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "<color=#37FFFF>長生：</color>…好冷，好睏。\\n<color=#37FFFF>白朮：</color>長生？這就睡著了嗎…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "天氣很好…",
      "text": "<color=#37FFFF>白朮：</color>好天氣，「不卜廬」新收的藥草…\\n<color=#37FFFF>長生：</color>放心啦，就算七七忘記晾藥草，阿桂也不會忘的，好好曬太陽吧。\\n<color=#37FFFF>白朮：</color>的確。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "#碰上這麼大的風{F#妳}{M#你}也不躲嗎？唉，要愛惜自己的身體啊。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早安，我習慣餐前一杯茶，要給{F#妳}{M#你}倒一杯嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午餐後不要久坐，最好起身走一走，有助於消化。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好，如果是來看病的話，抱歉了，今天「不卜廬」大夫的坐診時間已經結束。不過，{F#妳}{M#你}有緊急情況的話那自然另當別論。如果只是來找我的話，正好，現在是我的私人時間。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#還不想睡嗎？可是{F#妳}{M#你}已經在打哈欠了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於白朮自己·今方古方",
      "text": "師父的確留下了不少古人總結出的千金良方。不過古方雖然久經考驗，我們這些今人卻不能一味泥古。古時與今時，環境不同，風俗有異，過去管用的方子今天不一定管用。還守著過去的千金良方，最終是要耽誤病患性命的。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於白朮自己·醫心",
      "text": "久病的人精神萎靡，如果得的是重症，更是全憑一口氣撐著。這時候最要緊的事不是醫治他的身體，而是穩固他的信心。畢竟病人要是認定自己活不成，也不想活了，再高明的醫術也都無能為力了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·醫患",
      "text": "#凡是來「不卜廬」求醫的，不論貴賤，我都會一視同仁，盡力救治，{F#妳}{M#你}也不例外。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·試藥",
      "text": "#甲之毒藥，乙之蜜糖。對某些人來說百害無一利的毒物，對另一些人來說卻恰好是救命的良藥，這在藥理上也是成立的。只是這些話卻不能對普通病患說，要是讓他們知道我開的方子裡有毒藥，恐怕以後就再也不敢來這裡了吧。\\n知道了這件事卻毫不恐懼的，{F#妳}{M#你}還是第一個。不愧是見多識廣的旅行者，那麼以後我也可以放心開些猛藥給{F#妳}{M#你}了吧？正愁找不到試藥的人呢，呵呵。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "呵呵，神也允許我這狂妄之人探索生死之道呢。這神之眼來得正好，多謝了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·蜜餞",
      "text": "#說了不怕{F#妳}{M#你}看笑話，其實我自己也不愛喝苦藥。我的體質{F#妳}{M#你}也知道，常年喝藥是免不了了，沒辦法，只能喝完藥多吃點蜜餞緩解一下嘴裡的苦味。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·秘藥",
      "text": "我曾遇上一些人，身體略有不適，便以為自己得了重病，以理相勸仍是不依不饒。後來，我乾脆以甜甜花和清心為原料，調製出了一批白色無味的藥丸，配給這批疑心過重的「患者」。他們得到安慰後，「病情」有所緩和，轉而稱讚起了我「秘藥」的效力。像這類情況，我也是能夠理解的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "據說須彌雨林中的蘑菇種類眾多，有些品種甚至能讓人產生幻覺，大概有些藥用價值。不過我一直沒有機會詳細考察一番，要是以後能有閒暇親眼看看就好了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於七七…",
      "text": "#{F#妳}{M#你}猜得沒錯，封住七七一縷神智的的確是仙人的秘法。也是多虧七七，我才摸索出了保住將死之人的方法。既然仙人都憐憫這孩子，施法將她留在「此岸」，那我順水推舟收留她，又有何不妥呢？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於胡桃·道不同",
      "text": "觀念不同而已，我對胡堂主本人並無意見。非要說的話，應該是她防備我居多吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於胡桃·疲憊",
      "text": "<color=#37FFFF>白朮：</color>有可能的話，我還是希望胡堂主做生意時注意些方式方法。\\n<color=#37FFFF>長生：</color>哦，原來你還記著她到「不卜廬」門口打廣告的事啊。\\n<color=#37FFFF>白朮：</color>唉，沒事的時候，也別總是惦記七七了。\\n<color=#37FFFF>長生：</color>你其實對她有意見吧？\\n<color=#37FFFF>白朮：</color>我又怎麼會真跟她計較呢，只是每次她把七七帶走，我都要費勁拜託總務司尋人，實在太累人了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於甘雨…",
      "text": "仙家體質強健，即便身體有恙，不需藥物也能自癒。不像凡夫俗子，一旦傷筋動骨，沒有醫治非落下殘疾不可。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於刻晴…",
      "text": "從面部狀態來看，玉衡星應該是習慣了熬夜，且思慮過多，才會時不時顯露疲態。想要保養好身體的話，還得放下工作，靜養為宜。可惜她太過上進，似乎是打定了主意要用健康換事業，我這話說了她未必聽得進去。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於瑤瑤…",
      "text": "…這孩子每次來找七七玩耍時都要和我抱怨藥苦，問我有沒有不苦的藥。治病救人的藥，哪有不苦的呢？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於鍾離…",
      "text": "鍾離先生這樣的博學多聞之士，哪怕是聊起偏門的古醫方也能從容應答，肯定自有一套養生調理的講究。普通的頭疼腦熱他自己就能解決了，的確沒必要到我這裡來開方子。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於魈…",
      "text": "<color=#37FFFF>白朮：</color>降魔大聖殺生為護生，心有大慈悲。我曾有幸親眼見過他本人，還將昏迷的他帶回廬中照顧了一天，只可惜當時我不識仙師真身，又沒來得及多交談幾句，他就獨自離開了。\\n<color=#37FFFF>長生：</color>後來你們不是又見過嘛，不用遺憾啦。\\n<color=#37FFFF>白朮：</color>說得也是。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於提納里…",
      "text": "#原來須彌教令院裡有{F#妳}{M#你}的相識？那能否麻煩{F#妳}{M#你}幫我與這位提納里先生聯絡一番，我有不少藥草方面的事情想要請教。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於嘉明…",
      "text": "比起這個年紀的尋常少年，他身上有更多傷痕舊患，每每過來又常添不少淤青扭損…唉，勸恐怕是勸不住的。我教過他一些包紮和養護的方法，希望對他有幫助。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解白朮·其一",
      "text": "#我一個治病的大夫，身上能有什麼有趣的故事。{F#妳}{M#你}要是對傳奇故事感興趣，不如去和裕茶館請說書先生講幾段。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解白朮·其二",
      "text": "非要說什麼驚心動魄的故事，我這裡實在沒有。當初我拜師學醫時，也沒經歷什麼重大考驗，師父他老人家看我不算太笨，讓我發了簡單的誓，也就入門了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解白朮·其三",
      "text": "誓言不算複雜，我還記得個大概：\\n「…若有疾厄來求救者，不得問其貴賤貧富，亦不得瞻前顧後，自慮吉凶。見彼苦惱，若己有之，如此可為蒼生大醫。」"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解白朮·其四",
      "text": "師父的意思我明白，他是希望我勿為外物所動，多為病患考慮。唉，他老人家的確是宅心仁厚，一心捨己救人，可惜未享天年便早早去了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解白朮·其五",
      "text": "醫者普救世人，但我以為醫者自身也在世人之列。身為醫者，既要救人也要救己，捨己為人固然值得欽佩，但沒有人生來就是要為他人犧牲的，不該這樣。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "白朮的愛好…",
      "text": "分揀藥材，再依其各自特性炮製成藥丸或是藥膏，這其中的過程我再熟悉不過。世人都覺得製藥過程繁難，但在我看來，其實樂趣無窮。試想，竟有人能將天地造化之功凝聚於小小一劑藥中，挽救蒼生性命，不是很奇妙嗎？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "白朮的煩惱…",
      "text": "為病人看診時最麻煩的從來不是配藥，而是找對病因。唉，病人們身體不適的原因真是千奇百怪，有和人比賽吃絕雲椒椒吃到腸胃受損而不自知的，有過量飲水導致頭暈噁心的…我只盼望世人都能以健康為重，沒事不要胡亂折騰自己的身體。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#挑食可不是好事。肉、蛋、奶、蔬菜、水果…凡是有營養的食物都要吃，但也不能吃得太多，暴飲暴食同樣對身體有害。{F#妳}{M#你}別嫌我嘮叨，正因我是大夫，才深刻地明白禍從口入的道理。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#怎麼買了這麼多糖？{F#妳}{M#你}別一口氣吃太多，糖吃多了容易蛀牙。我？我對甜味的攝入很有分寸，辛辣的食物也不常吃。{F#妳}{M#你}說的沒錯，我的確非常注意飲食管理。畢竟，如果我連自己的飲食都管不好，又怎麼好意思給病人提飲食建議呢。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "<color=#37FFFF>長生：</color>還有嗎？多來點！\\n<color=#37FFFF>白朮：</color>味道的確不錯。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#{F#妳}{M#你}的廚藝有進步，恭喜。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "不用擔心，味道總比藥好些。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#<color=#37FFFF>長生：</color>那話怎麼說來著…哎呀，白朮，提醒我一下。\\n<color=#37FFFF>白朮：</color>過生日時的吉利話嗎？\\n<color=#37FFFF>長生：</color>對對對。\\n<color=#37FFFF>白朮：</color>願{F#妳}{M#你}年年有今日，歲歲有今朝。旅行者，生日快樂。\\n<color=#37FFFF>長生：</color>話都被你說了，那我說什麼？算了，我再想點別的。我祝旅行者…嗯…嗯…唉，想不出來了，祝{F#妳}{M#你}心情愉快吧。\\n<color=#37FFFF>長生：</color>{F#妳}{M#你}們笑什麼嘛，人就是麻煩，比蛇還難理解。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "凡事需循序漸進，不必急躁。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#多勞{F#妳}{M#你}費心，感覺身體比以前強健了不少。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#大概是最近體質有所變化的緣故，精神比從前好了許多，坐診一天下來也不覺得疲憊。這都是{F#妳}{M#你}的功勞。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#連日來辛苦{F#妳}{M#你}了。明明我自己就是大夫，卻還要麻煩{F#妳}{M#你}為我的身體忙前忙後，咳咳…慚愧。放心，往後不會有這種事了，我會照顧{F#妳}{M#你}。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "<color=#37FFFF>長生：</color>得治治。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "良藥苦口啊。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "是藥三分毒。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "病宜速救。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "須知惜命。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "且嚐，苦盡甘來。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "咳…咳。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "<color=#37FFFF>長生：</color>忙了半天是為了這個啊。\\n<color=#37FFFF>白朮：</color>長生…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "冒險生活不容易啊。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "回頭擦擦手吧，這箱子我怕不夠乾淨。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "…我還能撐。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "<color=#37FFFF>長生：</color>不妙不妙！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我不能…先倒下。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不可冒進。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "留心傷口…"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "人死燈滅…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "長生，抱歉…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "愧為醫者啊…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "嘖，眼鏡。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "這點痛，哼。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "傷口由我處理。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "這就出診。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "希望別走太遠…"
    }
  ]
}