  "outfits": [
    {
      "id": 212700,
      "name": "不懈執望",
      "description": "葉洛亞的裝扮款式。出於工作考慮，葉洛亞為自己訂製了這套工作用制服。雖說是「工作用制服」，但因為葉洛亞的工作太多，他基本上也沒有換衣服的機會，所以，這件衣服基本上也能算作是葉洛亞的「日常服」了。",
      "isDefault": true,
      "characterName": "葉洛亞",
      "characterId": 10000127,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Illuga_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好呀，我是葉洛亞，執燈人調查分隊的隊長。請問是遇上什麼麻煩了嗎？這也是常有的事，附近的路的確不太好走。不過別擔心，跟我來吧，我會幫{F#妳}{M#你}照亮前方的路。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·警惕",
      "text": "越是平靜的地方，就越有可能隱藏著危險…我也不知道這話對不對，但警惕點總沒錯。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·巡夜",
      "text": "#{F#妳}{M#你}是不是覺得冷？巡夜的時候很容易受涼，我煮碗暖湯給{F#妳}{M#你}喝吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·困難",
      "text": "只做擅長的事情可不行，只有強迫自己去做困難的事，才能在掙扎中變強嘛。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨過天晴…",
      "text": "太陽出來了，看來這次是光明的一方打贏了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "老爹說這是天上的神明們在交戰，我只希望他們不要殃及無辜。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "難得的好天氣啊。要是能一直這麼好，我們執燈士的工作也會輕鬆很多吧。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "起風了，總感覺會有不好的事情發生…要不我們還是去附近的營地躲躲吧？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "夜晚過去了，看來我們又度過了平安的一天。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "陽光正好，應該趁這個時候觀察一下周圍有沒有什麼隱患…唔，不過好像有點睏了…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "天黑之後說不定會有魔物出沒。走夜路的話，請一定要小心謹慎。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#嗯，時候不早了，{F#妳}{M#你}先休息吧。放心，今晚我會替{F#妳}{M#你}守夜的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於葉洛亞自己·執燈人",
      "text": "加入執燈人的事，是我求了老爺子好幾次才說服他同意的。比起一直待在皮拉米達城被前輩們保護，我更想要去到戰場的最前方，和大家一起成為阻擋狂獵前進的力量。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於葉洛亞自己·分隊長",
      "text": "成為分隊長意味著要肩負起同僚的性命，雖然我還是時常懷疑自己是否有這樣的資格…但是既然大家都選擇了相信我，那我也不可以辜負大家的信任，對吧？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·職責",
      "text": "#為往來的商旅提供保護，是我們執燈人的職責…{F#妳}{M#你}問保護對象包不包括冒險家？嗯…雖然理論上這確實超出了我的責任範圍，但我可不能允許任何人在我負責巡察的區域裡受到傷害。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·隊員",
      "text": "#現在{F#妳}{M#你}已經算是我們調查分隊的隊員了，這就意味著，我必須為{F#妳}{M#你}的生命安全負責…聽他們說{F#妳}{M#你}最近又去了危險的地方冒險，現在看到{F#妳}{M#你}平安無事，我稍微安心了一點…所以說，下次要不還是讓我跟{F#妳}{M#你}一起去吧？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "曾經有人告訴我這只是枚好看的寶石，直到終於有機會將它掂在手裡，我才明白其中承載的重量。我想，命運把它交到我的手上並非偶然，我得努力配得上它。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "從皮拉米達城的最高處向北眺望，可以看到至冬雪原的一角。據說那裡就是我們的初代執燈長，鑄燈者索洛維的家鄉。失去一切而無法回到家園的人，最後在這裡找到了歸宿…說不定，這座城堡從一開始就是為了讓我們這樣的人抱團取暖而存在的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#皮拉米達城附近有許多散發著月矩力的奇妙生物，像是曼陀草、獺懶羊…可不要被它們的表象所欺騙，雖然看起來像是{F#妳}{M#你}們見過的動物，但它們其實是擬態成動物模樣的植物…不過實話說，它們的味道還不錯。不介意的話，下次可以做一份給{F#妳}{M#你}嚐嚐。嗯？{F#妳}{M#你}問我為什麼會知道這個？巡夜的時候總會有許多不得已的情況嘛…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於菲林斯·拜訪…",
      "text": "剛認識菲林斯先生的時候，還以為他是不善交際或者性格乖僻才選擇離群索居的呢，但沒過多久，我就發現事情與我想的恰恰相反…不過每次我們聊天，他總是在故事最後加入些吊胃口的情節，我在想，這是不是因為…他其實歡迎我多去拜訪呢？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於菲林斯·秘密…",
      "text": "#{F#妳}{M#你}是說菲林斯先生身上藏著許多秘密？當然，這在執燈士當中並不稀奇。我的同僚們出身各不相同，誰能沒有幾個不想告訴別人的秘密呢？就連老爹也很少向我提及他年輕時的往事。至於菲林斯先生嘛…最近發生了那麼多事，好歹也是朋友，他的秘密我多少能猜到一點點。我試著求證過，他既沒有否認，也沒有承認，可能那也是一種表態。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於菈烏瑪…",
      "text": "自鑄燈者的時代開始，我們與霜月之子就保持著傳統的友誼。這一代的詠月使是位溫柔又和善的小姐，每次拜訪我都能從她那裡學到很多。以如今這個世道，當詠月使不會比做執燈人輕鬆。她能始終保持這種態度，想必也承受了許多吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "法爾伽先生是位了不起的戰士，我們曾並肩對抗過狂獵。聽說西風騎士團也和我們執燈人一樣，是為了守護家園而建立的組織。或許有一天，等挪德卡萊的狂獵都被消滅乾淨了，我們也能遠赴異域，為更多生活在苦難中的人們而戰。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於奈芙爾…",
      "text": "多虧了秘聞館的關照，我們在那夏鎮的行動才會如此方便，以前可不是這樣的。據說在奈芙爾小姐來到挪德卡萊之前，執燈士們和那些不守規矩的幫派分子經常發生衝突，老爺子還一度為此苦惱…現在真是好多了呢。不過，奈芙爾小姐也和菲林斯先生一樣愛拿我尋開心，也讓我有些苦惱就是了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於愛諾…",
      "text": "#我們執燈人維修複雜機關，通常都會請愛諾小姐來幫忙，不過她看起來好像是真的想教會我們…自從有一次，我被她看到在自己修理機關之後，她就大吵著怎麼說也要拉我去上課…嗯？{F#妳}{M#你}問我是怎麼修的？那我當然是跟老爹學的，機關不靈，只要用力敲兩下就好了，誰知道她會這麼生氣…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於莉奈婭…",
      "text": "像莉奈婭這樣的妖精小姐，即便在魚龍混雜的挪德卡萊也很少見。在認識之前，我原本以為她會是更加沉穩的類型。沒想到第一次見面，她看到阿咚之後直接兩眼放光地撲了上來…阿咚可是面對狂獵都從不退縮的信鳥，但現在每次只要一聽到她的聲音，就會馬上躲進燈裡不肯出來…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於「月神」…",
      "text": "挪德卡萊是「人」的樂園，這條道路是由數百年來無數執燈士的血與骨所鋪就的。就算如今迎來了一位新的神明，屬於挪德卡萊的生存方式也不會因此而改變吧。不是不相信那位「月神」小姐…只是我覺得，比起等待別人來拯救，還是擁有能主動保護身邊人的力量更安心。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解葉洛亞·其一",
      "text": "#想要瞭解我的過去？嗯…讓我想想…好像沒有那種說出來能讓人開心的部分啊，{F#妳}{M#你}真的想聽嗎？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解葉洛亞·其二",
      "text": "#阿咚是我的信鳥，每次出門巡夜的時候我都會帶上牠。牠不僅會提醒我周圍的危險，還能幫我照亮前方的路，是非常可靠的夥伴…嗯？{F#妳}{M#你}是說{F#妳}{M#你}走過這麼多國家也從沒見過這種會發光的鳥？等等…該不會牠真的不是普通的信鳥吧…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解葉洛亞·其三",
      "text": "#如{F#妳}{M#你}所見，我的誓言之燈與大家的制式並不相同。這可不是因為我是分隊長就有什麼特殊，它是我在後勤分隊的時候所用的信號燈。後來執燈人的裝備更新換代，就只剩下了我手上這最後一盞…我大概是習慣了吧，每次想到要換掉它就覺得很難受。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解葉洛亞·其四",
      "text": "我的老爹尼基塔，同僚們都叫他老爺子。說是這麼說，我可一點沒覺得他老。各地燈塔的部署情況，他比我記得還清楚，我的事情也從來瞞不過他。不過越是這樣我就越忍不住想，要是有一天他真的老了該怎麼辦呢？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解葉洛亞·其五",
      "text": "狂獵到來時，我總能聽到狂風中夾雜著逝者的哀鳴。每到這個時候，就彷彿又回到了那個地獄般的戰場，回到了被老爹撿回來的那一天。或許只要狂獵還沒被徹底消滅，纏繞著我的夢魘就不會離去。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "葉洛亞的愛好…",
      "text": "#{F#妳}{M#你}這樣一說，我的閒暇時間好像也都和同僚們待在一起…最近執燈士中很流行一種叫作「桌上劇團」的遊戲，我們還沒湊夠一起玩的人，{F#妳}{M#你}要不要也來參加？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "葉洛亞的煩惱…",
      "text": "無辜之人因為突如其來的災難而莫名其妙地丟掉性命，這種事情我無法原諒。我所做的一切努力，都是為了讓這樣的事不再發生在其他人身上。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "食物嘛…我倒是沒什麼特別的偏好。在我看來，只要能和大家一起圍著爐火，熱熱鬧鬧地吃上一頓，無論煮的是什麼，那都是最好的美食。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#只要是熱乎乎的食物都沒問題，涼的最好不要…{F#妳}{M#你}想想啊，要是等到了冬天，大晚上值夜的時候吃到的飯菜還是涼的，想想都忍不住要說難聽的話了…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "令人驚豔的味道，能告訴我調味的秘方嗎？我也想學學看。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "不錯啊，真想讓同僚們也嚐嚐。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#嗯…要不還是讓我再多教{F#妳}{M#你}幾道料理吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂，親愛的隊員。今天就別管什麼委託了，也暫且忘掉那些冒險吧。這麼重要的日子，就應該一整天都跟朋友們待在一起，吃飽喝足然後睡個好覺，{F#妳}{M#你}說對不對？放心，我會替{F#妳}{M#你}守著的。要是有什麼煩人的傢伙敢來打擾{F#妳}{M#你}，我就用我手上的這盞燈把他們都趕走。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "原來還有這種變強的方法，事半功倍了啊。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "力量有所提升，但要用來保護大家還遠遠不夠…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#多謝{F#妳}{M#你}教我，這段時間我學到了很多，對自己稍微有些信心了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#真是慚愧，一直在麻煩{F#妳}{M#你}。不過現在我已經變得足夠強大了，所以接下來希望{F#妳}{M#你}也能多依賴我一點。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "去吧，阿咚！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "趁現在！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "#交給{F#妳}{M#你}了！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "瞄準好了。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "你跑不掉的。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "機不可失。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "我的燈下沒有陰霾！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "接受明光的制裁吧！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "迎接黎明的曙光！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "寶藏應該交給需要它們的人。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "居然不是陷阱，看來是我多慮了。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "之前沒注意到啊…得加強巡察了。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "有種不祥的預感…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我還是高估自己的實力了啊…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "現在叫增援還來得及嗎？"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "別離開我的視野。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "#該輪到我來保護{F#妳}{M#你}了。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "要是能再努力一點的話…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "至少要將情報帶回去…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "還是，沒能保護大家…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "可惡…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "大意了。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "還能忍受。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "再堅持下。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "明白了，這也是執燈士的職責。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "#讓我來替{F#妳}{M#你}掌燈吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "#我會努力不讓{F#妳}{M#你}失望的。"
    }
  ]
}