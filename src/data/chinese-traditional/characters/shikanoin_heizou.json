  "outfits": [
    {
      "id": 205900,
      "name": "弁武朝風",
      "description": "鹿野院平藏的裝扮款式。解下外套，隨意繫在腰間，天領奉行的偵探總是一副自在瀟灑做派。",
      "isDefault": true,
      "characterName": "鹿野院平藏",
      "characterId": 10000059,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Heizo_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我叫鹿野院平藏，是天領奉行裡破案最多最快的偵探…哎呀呀，{F#妳}{M#你}身上一股麻煩纏身的味道。快坐下，這邊坐，從頭說給我聽聽吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·罪案",
      "text": "唔…我好像聞到了罪案的味道。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·偵探",
      "text": "偵探就要有偵探的樣子，所以就得到處走走，收集罪證才對嘛。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·直覺",
      "text": "我的直覺告訴我，馬上就要有精彩的事件發生了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨過天晴…",
      "text": "剛才那場雨，可別沖散了線索啊。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "哦？是哪個狡猾的犯人在發誓嗎？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#{F#妳}{M#你}聽說過嗎？很久以前，發生在龍脊雪山上的午夜凶靈事件…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "加油呀！這麼點風力是成不了「風暴」的。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早呀，看{F#妳}{M#你}精神不好，沒做噩夢吧？早知道的話，就該晚些再讓{F#妳}{M#你}接觸重案嘛。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "吃飽了玩點鍛煉腦力的遊戲吧！繼電石？哈哈，這個只能鍛煉心態吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "太陽下班的時候，就輪到星星盯著犯人了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "真好啊，又到了睡覺時間！今天會做怎樣的夢呢？"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於鹿野院平藏自己·偵探",
      "text": "偵探，就該用腦力摧毀那些犯人企圖逃脫的僥倖，所以說，真正的偵探，根本犯不著使用武力嘛。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於鹿野院平藏自己·關鍵字",
      "text": "#我習慣將見到的東西以關鍵字的形式記在腦子裡，它們對推理大有幫助。{F#妳}{M#你}看這邊這個人，乾淨褲腿上的貓毛，手腕處的抓痕，看來是想和動物玩，但卻不太懂怎麼逗貓。那位，很在意自己受傷的手，穿著和身分不符的新鞋…等等，說不定我要有新委託了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·委託",
      "text": "#我看{F#妳}{M#你}身邊的委託，就像永不乾涸的井口一樣，撈都撈不完。那我就來沾點便宜吧。{F#妳}{M#你}懂的，打架、跑腿、找東西之類的工作我是不做的。只做解謎推理，只解重案要案…嘿嘿，記得幫我留意哦。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·必然結果",
      "text": "#「巧合」是個好詞，聽起來就像是命中註定。但可惜偵探不相信巧合，我和{F#妳}{M#你}的相遇，是此前每一個選擇、每一次行動的必然結果，也就是說，是我們自己決定的哦。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "#有傳言說我不用神之眼也能放倒同僚？唔…我更正一下。第一，我雖然是奉行所同心，但也只是個偵探，動的是腦力。第二，我們平時是不會打架的。第三…欸，矇不過{F#妳}{M#你}啊。那算了~"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·成就感",
      "text": "把線索串聯起來，一步步找出真凶，直到親手為拼圖嵌上最後一塊。那種成就感，哎呀呀，實在是太迷人了。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什麼想要分享·同心",
      "text": "同心這個職位，既能帶來聲望，又離凶案現場最近，這舞臺，比我在偵探社的時候大了不少。當然，當然…巡邏和抓捕這種工作還是請厲害的人代勞吧，偵探的精力是有限的嘛。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#{F#妳}{M#你}對木材有什麼研究嗎？啊，沒錯，說的就是那種路邊隨處可見的樹木。犯人蹭到了樹皮啦、刮到了木屑啦、踩到了樹葉啦，說不定就會留下些什麼。根據它們的生長區域，有時還能推斷出重要的線索。完全可以說，樹是偵探的好朋友啊。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "九條裟羅大人啊…絕對是全天領奉行最嚴肅的人！真希望她能變得寬容一些，多多體諒下屬，別再因為偶爾的缺勤責備我了。說到底，我也是為了查案嘛。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於荒瀧一斗…",
      "text": "受人所託，我去牢裡帶過幾次烤堇瓜給他，有次還正巧聽到他在唱歌。說實話，歌詞很爛，但唱得不錯。蹲牢房的人能有這樣的精神狀態，不算多見。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於久岐忍…",
      "text": "荒瀧派真是個自由多元的組織呀，無論是怎樣的風格都能接納。了不起，了不起，多虧那位阿忍小姐管教有方。我是怎麼知道的？哈哈，這已經簡單到連推理都算不上了吧？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於八重神子…",
      "text": "#說起來，宮司大人的八重堂也會出版推理小說吧？什麼時候能請{F#妳}{M#你}當面引薦一番？在這個時代，要成為名偵探，實力以外，宣傳也不能落下。哎呀呀，我哪有別的心思啦。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於楓原萬葉·共通點",
      "text": "萬葉他呀，太可靠了。在他的提醒下，線索就像裝寶石的匣子被翻倒一樣，滾落得滿地都是了。我要是也有他那種對於自然的感知力…哦！我明白了！「風」之於他，就像是「直覺」之於我吧！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於楓原萬葉·邀請",
      "text": "好可惜呀！眼狩令廢除後，我就不能堂堂正正地逮捕他了！不過這樣一來，也就意味著…我可以光明正大地邀請他來天領奉行，跟我一起討論案情了吧！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於五郎…",
      "text": "在這位大將的叮囑下，我的海祇島之旅可是熱鬧了不少，到哪都有軍士們盯著。天地良心，我不過是個平平無奇的觀光群眾，最多算個小小偵探，連白蘿蔔也不會惦記半根的呀。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於珊瑚宮心海…",
      "text": "珊瑚宮大人我是沒見過的。畢竟有她出席的場合，村民們會圍個裡三圈外三圈吧，我就不湊熱鬧啦。啊，對，最裡面那層還要算上巫女！像我們這樣的年輕人，想要獲得大家的認可，總要多付出一點努力的。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於神里綾華…",
      "text": "我和神里家的大小姐，只能算點頭之交吧。還好我的家族不是什麼名門。那種生活，可不適合我呀。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解鹿野院平藏·其一",
      "text": "#就算一個人保持沉默，也能從他的衣著、動作、表情來掌握資訊哦。如果接下來我的話就此打住…{F#妳}{M#你}又能從我身上讀到什麼呢？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解鹿野院平藏·其二",
      "text": "某次旁聽時，我受腦海中的推導鼓動，阻止了判決的下達。如果當時提出的異議無效，那它就不會成為我當偵探的契機，而會是——鹿野院平藏，因擾亂庭審秩序受到拘留處罰，哈哈哈…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解鹿野院平藏·其三",
      "text": "調查外遇、尋找寵物…從偵探社接到的案件總是那麼幾類，不夠我挑戰自己的呀。我只好找機會溜去天領奉行囉。另一部分的原因，是我跟珊瑚社長的理念不太合啦，這也沒辦法。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解鹿野院平藏·其四",
      "text": "剛進天領奉行時，我拿未結案的卷宗來練手，不知不覺間，那座「卷宗山」也快被我咻地推平了…可惜啊，現在已經沒時間再看以前的卷宗囉，很多案子都點名要我支援，忙得喘不過氣啊…也沒辦法嘛。足夠優秀的偵探，案子會自己找上門來。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解鹿野院平藏·其五",
      "text": "#面對犯罪的時候，偵探已經失敗了。無論怎樣還原真相，找出真正的犯人，都無法挽回事件發生造成的損失。所以，我才會想要擴大自己的名聲，成為能讓壞人想想就感到害怕的名偵探！也就是，扼殺犯罪在搖籃之中。好了，既然把這一點都告訴{F#妳}{M#你}了，就快來一起幫我的忙吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "鹿野院平藏的愛好…",
      "text": "#要來旁聽天領奉行的法庭判決嗎？看著真相就像碎裂的剪貼畫一樣被拼接完整…我可以替{F#妳}{M#你}佔個絕好的觀看席位。我們只要裝作不認識就行了，裝作。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "鹿野院平藏的煩惱…",
      "text": "總有人在最後關頭暴力反抗，好像那就會管用一樣。真是的，我明明期待的是對方在完整的證據和推理面前，認罪伏法的樣子。偵探要是動手，不就已經輸了嗎。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "被油炸過的食物就沒有不好吃的吧？不管是肉還是蔬菜，只要是從油鍋裡撈上來的，我都愛吃！而且…這種香味，對那些餓肚子的人來說，也很難拒絕得了吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我很討厭奉行所的晚飯，總是固定的菜品，規規矩矩的，味道也說不上好。食物嘛，要想吃什麼就能吃到什麼才會開心。可憐的我，就只能溜出去墊肚子囉。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#喔…好吃好吃！費了不少力氣吧，太謝謝{F#妳}{M#你}啦。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#烹飪該算體力活還是腦力活呢，或許都算吧，難怪{F#妳}{M#你}能做得這麼好！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#讓我想想…{F#妳}{M#你}是在哪個步驟出錯了…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#在知道今天是{F#妳}{M#你}的生日之後，有那麼一瞬間，我想把{F#妳}{M#你}帶到一間擺滿了機關與禮物的密室裡，讓{F#妳}{M#你}解出謎題後再出來…嘿嘿，開玩笑的啦，在確認{F#妳}{M#你}是否喜歡之前，我是不會這麼做的。來，和我一起走吧，趁著太陽還沒下山，有非常漂亮的景色想和{F#妳}{M#你}分享哦！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#我的直覺告訴我…{F#妳}{M#你}想讓我變強！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "武力是增加了，腦力也有這樣的增幅就好了…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "哎呀呀，我真要變成大家口中的「風暴」了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#謝謝{F#妳}{M#你}對我的信任和付出，我的搭檔，能做到這一步多虧了{F#妳}{M#你}。來擊掌吧，接下來也一起去解開更多的謎團！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "吃拳！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "別抵賴！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "來吧！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "認罪吧！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "風暴！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "破開迷霧！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "別讓寶物翻箱出逃哦~"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "就是這個，我的直覺不錯吧？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "哇，好耀眼！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "唉，就非要動武嗎？"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "好猖狂哦。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "這在偵探的職能以外了吧？"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "哎呀呀，小心哦！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "事關重大，換我來。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "這不是真相…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "呵，偵探變成受害人了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我竟然會…失算…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "別這樣。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "真麻煩！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "有新案子？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "遇上難題了？和我說說。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "出發吧，我的搭檔。"
    }
  ]
}