  "outfits": [
    {
      "id": 205100,
      "name": "浪尖之舞",
      "description": "優菈的裝扮款式。俐落且能突顯典雅風範的騎士裝束。",
      "isDefault": true,
      "characterName": "優菈",
      "characterId": 10000051,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Eula_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#西風騎士團，游擊小隊隊長，「浪花騎士」優菈·勞倫斯，向{F#妳}{M#你}致以問候…嗯，勞倫斯，沒錯。如{F#妳}{M#你}所見，我是罪人的後裔、是騎士團的內鬼，正在向他們復仇。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·禮儀",
      "text": "騎士和貴族的禮儀一脈相承，只是前者腳踏實地，簡化了繁文縟節。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·劍技",
      "text": "#西風劍術？想和我學兩手嗎？等{F#妳}{M#你}學成再找{F#妳}{M#你}報仇，想必能增添不少樂趣。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·規矩",
      "text": "貴族們的陳腐規矩啊…聽聽就好，哪怕像我一樣，被迫背誦了幾百條，也不必當真。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "#快到傘下來，別被淋濕了。要是{F#妳}{M#你}生病，身體早早就垮掉，那我去找誰報仇？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "麻煩的天氣，雷聲會干擾聽覺，影響我對周邊的感知。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "視野不錯！登上高地，就能將周圍的敵情盡收眼底。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "該起床了，日出前兩個小時，站哨一夜的哨兵最為疲憊，是我們活動的絕佳時間！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午飯要少吃穀物、多吃肉類，防止午後睏倦，被人趁機暗算。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "「願柔風伴你，度過安詳的一夜。」…舊貴族的問候語裡，難得有這麼中聽的一句。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#想聽骨哨的催眠曲嗎？會讓{F#妳}{M#你}長睡不醒…但這樣的報仇方法，實在太無聊了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於優菈自己·騎士",
      "text": "打入敵人內部，不就能更方便地復仇了嗎？所以我才加入騎士團啊。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於優菈自己·態度",
      "text": "既然成為了西風騎士，基本工作還是要盡職的，不然就連混日子的庸人們都不如了。哪怕是罪人，也不能這麼丟臉。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於優菈自己·游擊",
      "text": "游擊騎士的職責是自由狩獵敵軍，或者從旁在戰場牽制敵人，沒有太多規矩，更符合我的作風。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於優菈自己·舞蹈",
      "text": "勞倫斯家的傳統倒也不全是糟粕，至少「祭禮之舞」純淨而高潔，讓我心境平和，給過我不少慰藉。這麼多年來，我一直沒有放下它，每個舞步都刻進了我的身體…所以，言歸正傳，想要學到只屬於我的「西風劍術」，還得先過舞蹈這關。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於我們·共同點",
      "text": "#其實我們倆有點像，對於蒙德，我們都是「外人」。只不過，{F#妳}{M#你}這個外人受到歡迎，而我一直被提防、被人敵視。"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "關於我們·復仇",
      "text": "#{F#妳}{M#你}還會和我結下更多仇的，不如就等到哪天一併清算吧，這樣能省掉不少麻煩。也許是十年後，二十年後…放心，我不會忘的。在那之前，{F#妳}{M#你}可要生龍活虎、平安無事啊。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「罪人的後裔」，這個名號不太中聽，我只有不斷用我的方式復仇，才能徹底擺脫它。想要復仇就需要力量，得到「神之眼」，也是情理之中的事吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·骨哨",
      "text": "我的骨哨能吹出各種音色，迷惑敵人，相當實用。我經常用它吹奏海浪的聲音，「浪花騎士」的稱號就是這樣來的。但沒人在乎，這骨哨的技藝起源於璃月。畢竟他們也不會去深究…一個被蒙德排斥的罪人，找了個被人遺忘的璃月人當老師嘛。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什麼想要分享·品酒",
      "text": "按理說，陳釀蒲公英酒要搭配銀杯，醒酒十二分鐘後加入冰塊，酒面沒過冰塊六成為宜。但這樣實在太麻煩了，我可不樂意。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "冰霧花呀，怎麼就這麼罕見呢？它製作的粉末有奇效，能讓骨哨的音色變得更通透。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於安柏…",
      "text": "安柏總是自作主張，我剛加入騎士團那天，她替我打掃宿舍、帶我四處參觀，之後也主動幫我搞定各種麻煩事。在別人看來，我就像是個被妹妹照顧的姐姐，這怎麼像話！這些仇，我都記下了！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於琴…",
      "text": "代理團長啊，她和我的家族是宿敵。但她公私分明，認可我的實力，邀請我加入騎士團，給了我不少機會。所以我考慮在復仇時，賞她一個不算難看的敗北。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於麗莎…",
      "text": "啊，麻煩的女人，她的腦袋裡裝著幾千本書，也許是幾萬本。她能隨口數落勞倫斯家的黑歷史，每件事的日期都很準確。按理來說，她能幫我追查某個人的下落，但我又拉不下臉去找她。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於芭芭拉…",
      "text": "她到底有什麼秘訣，這麼討人喜歡？要是能和她學兩招…哦不，還是算了吧，「偶像」和「罪人的後裔」，怎麼想都不合拍。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於法爾伽…",
      "text": "大團長啊，他的性格很直爽，不在乎瑣事和傳聞，算是個老好人吧。我和他切磋過一次，打成了平手，但他那輕鬆的表情、散漫的態度，絕對是在放水！是對我最大的輕視！這個仇，我絕不會忘記的！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於溫迪…",
      "text": "那個吟遊詩人唱過幾首歌，把勞倫斯家放進輕快的故事，用從沒聽過的口吻調侃，連我都憋不住笑…這個仇，我不會忘的。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於雷澤…",
      "text": "不用拘泥於禮儀，不必在乎他人的目光，也沒有所謂的家族責任…他的生活方式，還滿輕鬆的。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於砂糖…",
      "text": "那個煉金術士？她給過我一種裝置，說是能用來潛入深淵教團的營地，結果卻發出巨響爆炸了，害我當場暴露，被十三個丘丘暴徒圍攻。事後我本來想找她算帳，可看她慌張又內疚的樣子，還有牆上貼著的失敗紀錄，我也不好說什麼。反正我沒受傷，只是灰頭土臉，有點丟臉。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於迪盧克…",
      "text": "我和騎士團的某些人相處不來，他也看騎士團不順眼，理論上，我們兩個是同一邊的。但他總是對人不理不睬的樣子，感覺比代理團長還麻煩。唉，我可不想和他打交道。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於迪奧娜…",
      "text": "她呀，是個奇妙的調酒師呢，居然和我聊得來。她為了毀滅蒙德酒業在酒館工作，而我為了向騎士團復仇加入了騎士團，天下還有這麼巧的事。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於煙緋·相識…",
      "text": "說來話長…有次我們追蹤深淵教團的一批危險物品，碰巧救下了她。當時，教團的危險品被偽裝成普通貨物，要從荊夫港轉運到璃月港，她是跟隨商船的顧問，發現貨物有鬼，就擅自進行了調查，結果引火上身。要是我們再晚幾分鐘到，她就要倒大楣了。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "關於煙緋·看法…",
      "text": "之後我們一直保持著聯絡，我還滿喜歡她那種機靈的感覺。她牢記規矩，但懂得變通，如果騎士團裡的某些人能學學她就好了。而且，憑她的本事，應該能幫我找到那個人。就當是她還上欠我的人情了。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "關於米卡·溝通",
      "text": "米卡被分來游擊小隊的時候，我以為他會像之前某些人一樣，沒做幾天就想走了。沒想到他不聲不響，任務卻完成得相當出色，還主動承擔了所有跑腿的任務，替我和其他人溝通。哼，一個兩個都想著照顧我，也不知道是誰教出來的。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "關於米卡·回歸",
      "text": "#這次米卡從遠征隊回來，性格沒什麼變化，實力倒是強勁了不少。看來大團長沒有怠慢對大家的訓練。嗯？{F#妳}{M#你}說他自己都沒發現？那是他遲鈍吧…或者說，謙虛。畢竟是我小隊的成員，這種事，看一眼就知道了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解優菈·其一",
      "text": "罪人的經歷，有什麼好瞭解的？反正不管說什麼做什麼，都會被敵視、被當成潛在的危險分子吧。現在還算好了，沒加入騎士團的時候，獵鹿人和蒙德百貨都不願意賣東西給我，吃飯都得去野外打獵生火自己做。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解優菈·其二",
      "text": "有人勸過我低聲下氣、謹言慎行，說這樣也許能獲得諒解，但他們會這麼想，只是因為他們沒當過真正的「罪人」。…「罪人」是不會輕易被原諒的，那還不如灑脫一點，上門復仇，堂堂正正地去較量。要是贏了我，我聽憑處置，但要是輸了，就得滿足我的要求。比如…唉，至少也要好好地把東西賣給我吧。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解優菈·其三",
      "text": "西風騎士團倒還挺像樣的，至少他們更看重一個人的「才能」而非「身分」。當年我和他們的精銳切磋過幾次，用實力折服了他們，所以收到了入團邀請。在騎士團內部工作，復仇更方便了，生活中的麻煩也減少了，何樂而不為呢？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解優菈·其四",
      "text": "勞倫斯家族是在墮落後才背負惡名的，在此之前，這個姓氏也曾滿載榮耀，可惜所有人都像是忘掉了那段歷史。大團長說我作為騎士，做得還算不錯，不說找回勞倫斯最初的榮光，至少是對片面觀點的迎頭痛擊。這個說法倒是挺合我意的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解優菈·其五",
      "text": "#如果家族裡的那些人一直執迷不悟，甚至繼續荼毒蒙德，那他們和勞倫斯這個姓氏，就該被我親手抹殺…這大概是我唯一想要履行的「家族責任」吧。在那之後，我就隨意改個姓氏，由{F#妳}{M#你}來取都沒問題！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "優菈的愛好…",
      "text": "#涼爽的事，我都很中意。比如，痛飲冰鎮後的酒和飲料、坐在峽谷山口享受狂風，或者跳進龍脊雪山山腳的湖裡泡澡。哈，說不定哪天{F#妳}{M#你}在湖邊晃盪，會被我拖進冰水裡哦。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "優菈的煩惱…",
      "text": "有的時候酒館生意太火爆，我被要求和人拼桌。聽說我是勞倫斯家的人，擺臉色的、挑釁的、明著暗著使絆子的，就從各種地方冒出來了，唉，還讓不讓人好好喝酒了？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我喜歡親手做點心，點心不一定都是甜品，比如冰鎮後的番茄肉凍蛋捲，就很適合搭配冰樹莓薄荷酒。重要的是，有些人吃到我做的點心，就會笑得很開心。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "濃郁的湯品，我實在不能接受。口感太厚重、飽腹感很強，影響運動和戰鬥，還不方便攜帶，簡直是我的天敵。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "喔？這是對我的挑戰嗎。我接受了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#馬馬虎虎嘛…{F#妳}{M#你}自己也嚐嚐？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#{F#妳}{M#你}這傢伙，是在報復我嗎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天是個值得紀念的日子，但{F#妳}{M#你}的成長不能只限於年齡。送{F#妳}{M#你}一個特製骨哨，跟我學學吹奏的方法吧。等到我向{F#妳}{M#你}報仇的那天，{F#妳}{M#你}可以試試，用這枚骨哨干擾我，拖延時間，掙扎得更有趣一些吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "戰技提升了不少，但還不值得沾沾自喜。騎士團裡也有不少傢伙格外勤奮，要想戰勝他們完成復仇，必須遠遠將他們甩在身後。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "不錯，以我現在的實力，哪怕和代理團長一較高下，也十拿九穩了！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "#奇怪…和{F#妳}{M#你}同行時，力量增長得格外迅猛呢。看來和{F#妳}{M#你}結仇是件走運的事，我得緊緊咬住{F#妳}{M#你}不放了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#很好！這股堅冰的力量已被我牢牢掌控。別說代理團長，大團長都沒辦法再阻擋我了！事不宜遲，我可以制訂計畫，發起總攻了。挫敗西風騎士團之後，下個目標就是{F#妳}{M#你}，{F#妳}{M#你}也別想逃，乖乖待在我身邊，見證這一切吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "求饒吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "結霜！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "粉化！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "判決！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "破碎！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "以眼還眼！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "冰浪怒濤！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "以霜還怨！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "堅冰，斷絕深仇！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "加快腳步。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "空中行動，視野更棒。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "有所發現。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "嗯，大多能派上用場。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "罪人也有這麼走運的時候啊…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "開戰不利…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "要正式接敵了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不賴嘛！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "退回去，都交給我！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "聽我指揮，拉開間距！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "狼狽的收場…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我還能…撐住…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "罪人的結局嗎…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "還不錯！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "難得啊！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "游擊騎士，率先行動。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "由我打前鋒。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "行動計畫敲定了嗎？"
    }
  ]
}