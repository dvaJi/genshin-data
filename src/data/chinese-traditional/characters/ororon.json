  "outfits": [
    {
      "id": 210500,
      "name": "服翼之眼",
      "description": "歐洛倫的裝扮款式。預見者應當懂得隱藏，連帽斗篷是他最好的武裝。",
      "isDefault": true,
      "characterName": "歐洛倫",
      "characterId": 10000105,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Olorun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，我是來自「煙謎主」的歐洛倫。我不是賣菜的，但是可以送{F#妳}{M#你}一些。\\n別擔心，沒什麼特別的原因，也沒有想從{F#妳}{M#你}這裡換取什麼。我只是好奇每顆種子最終會長成什麼樣子，所以越種越多。希望它們都能在中意它們的胃裡安度晚年。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·怪人",
      "text": "#{F#妳}{M#你}聽誰說煙謎主裡都是怪人的？我以為只有我一個。還有誰啊？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·目標",
      "text": "每個人都應該有一種自己最喜歡的動物，或者是蔬菜、或者是水果。這樣才能知道自己想要成為什麼樣的人。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·迷煙",
      "text": "不是所有的迷煙都能穿過。如果野心太大，就會被煙霧嗆到。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "跑起來泥水會濺到衣襬上，飛的話…浸水的披風又太重了。還是找個地方蹲一下吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "閃電很像蛇。不知道有沒有人利用它們的顏色和形狀占卜…說實話，有點擔心這些人的安全。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "…雪下面葬著某些東西。輕一點，不要驚醒它們。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "太陽是永燃之火，納塔人從不懼怕直視烈日。當然，實在受不了可以戴墨鏡。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "這地方…感覺很難種出東西來。我看還是走吧？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "抱歉，雖然睜著眼睛，但我還沒醒…正事可以晚點說嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "胃說時間到了，應該去吃點東西。但我想不出要吃什麼…也可能是腦子還沒醒。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#突然想喝肉龍掌氣泡咖啡，不加奶。{F#妳}{M#你}說太晚了？那…早安。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#一到這個時候大腦就會活躍起來。我很早就放棄強迫自己睡眠了，所以{F#妳}{M#你}先休息吧，我帶著夜燈去看看地裡的蘿蔔。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於歐洛倫自己·交流",
      "text": "#我知道自己說話有時很難懂。{F#妳}{M#你}如果有哪裡沒聽懂，請直接提問，我不介意的。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於歐洛倫自己·未解之謎",
      "text": "我不知道自己是從哪來的，但似乎也並不好奇…比起這個，我更想知道自己該往何處去。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·道歉",
      "text": "#抱歉…嗯…我是說，真的很抱歉。一上來就騙{F#妳}{M#你}，的確不是什麼好的開場。原因已經都告訴{F#妳}{M#你}了，絕無虛言。如果{F#妳}{M#你}不想接受也沒關係，那我會盡量不出現在{F#妳}{M#你}面前。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·謝禮",
      "text": "#這是「凌晨四點」的肉龍掌、「比頭大」的青蜜莓、「截至上週為止第一甜」的蜜…還有…哦，還有「咔庫庫免費問診券」。\\n怎麼露出疑惑的表情？這些是送給{F#妳}{M#你}的，請收下。{F#妳}{M#你}幫了我的忙，但看起來並不缺什麼，我只好按照自己的喜好準備了禮物。\\n咔庫庫是誰？咔庫庫是龍。有機會介紹{F#妳}{M#你}們認識。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "聽人說打雷有助於作物生長。我試了一下在菜地中央驅動「神之眼」，很遺憾，高麗菜和番茄都不太開心，所以就沒繼續了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "一個小竅門：不要當第一個提出建議的人。就像先長出來的果實容易被盯上，第一個出頭的人經常輸得很慘。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "#飛鼯其實並不總像牠們在高空滑翔時那樣目中無人。牠們會突然飛過來，巴在{F#妳}{M#你}身上不走。這種時候很難不給牠們點好處。從某種角度來看，算是一群狡猾的傢伙。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於希諾寧…",
      "text": "她好像很喜歡待在高處，尤其是樹上。我發現倒掛在樹枝上會比躺在上面更抒壓，有機會可以和她交流一下心得。欸，不好嗎？大家總說要換個角度看世界，像希諾寧這樣的發明家，應該很需要吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於基尼奇…",
      "text": "#那個阿喬很有意思。牠年紀很大，卻又年紀很小。基尼奇正好相反，他年紀很小，但年紀很大。{F#妳}{M#你}…{F#妳}{M#你}能明白我的意思對吧？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於恰斯卡…",
      "text": "恰斯卡很厲害，也很出名。只要她一來，人們就都不吵架了，開始和和氣氣地握手。最講理的傢伙原來叫「武力威懾」，是個不錯的名字。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於伊法…",
      "text": "別看伊法經常教訓病患，他和龍們的關係其實很好。閒下來他會在診所門口彈吉他，讓圍上來的龍一個一個跟著唱。\\n但其實就是嗚嗚叫啦。我如果碰到了也會加入。我是說加入龍。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於茜特菈莉…",
      "text": "#奶奶其實是個很直白的人，高興或者不高興都會直接表現出來，也不太擅長掩飾自己的情感。{F#妳}{M#你}看起來像是她的同輩，或者…甚至比她更大？\\n抱歉，這樣好像不太禮貌，我不多問了。但如果真的是這樣，就請{F#妳}{M#你}多和她聊聊天吧，奶奶大概受夠了身邊都是晚輩，見到{F#妳}{M#你}會很開心的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於伊安珊…",
      "text": "只能說，還好火神大人沒有派她來抓我。她是遠近聞名的運動教練，雖然我有身高優勢，但很可能跑不過她。障眼法？用多了就不管用了啊。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於瑪薇卡…",
      "text": "我之前並不認識火神大人。\\n我的意思是，我當然知道火神是誰，但並不是當面講過話的那種「認識」。在這之前，火神大人對我來說更像一種刻寫著力量的圖騰、一個象徵著掌控全局的標誌。這在我心中並不算確切的瞭解，所以我產生了疑問。\\n現在疑問消失了不少，我很開心，也有點心虛和羞愧…她似乎從不迷茫，知道火焰為何常燃，所以無論如何不能讓其熄滅。我希望…希望自己能成為幫得上納塔的人。\\n當然，關於她我還有一些思考…上次在宴會上看到她吃了很多很多綠葉蔬菜，我們還聊了這件事。她說她很喜歡營養均衡的感覺。總覺得，是比想像中更細膩的人。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於「隊長」…",
      "text": "#真是一段奇異又倉促的緣分。\\n都說煙謎主的人擅長預知未來，但我在路邊遇到「隊長」時，從沒想過事情會變得這樣複雜。在{F#妳}{M#你}看來，人情是可以簡單還清的嗎？如果是，我心中為何仍保留感激與虧欠？\\n又或許是我考慮得太多了…無論之前發生了什麼，他幫助拯救納塔岌岌可危的地脈，是一位值得尊敬的英雄。我會一直記得他的。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解歐洛倫·其一",
      "text": "#{F#妳}{M#你}好。要握手嗎？納塔人打招呼通常不會這麼正式，但{F#妳}{M#你}想要也可以。其實在遠處喊一聲就夠了，我聽力很好，會察覺到的。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解歐洛倫·其二",
      "text": "#{F#妳}{M#你}似乎總是很忙，我也希望像{F#妳}{M#你}一樣，一直有事可做。但有時，我又很喜歡清閒度日。人的心情真多變啊，我自己也控制不了，真為難。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解歐洛倫·其三",
      "text": "#納塔的白天很熱，所以除非必要，不然我比較喜歡晚上出門。{F#妳}{M#你}看過夜晚的水面嗎？月光讓水波閃著光，看起來十分清亮。但只有在陽光下{F#妳}{M#你}才能看清它是不是真的乾淨，所以，盡量不要觸碰夜晚漆黑的水。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解歐洛倫·其四",
      "text": "#我對靈魂的感知天生比其他人強一點。怎麼描述呢…人的靈魂有點像一團團莫測的能量，如果世界上有形態各異的小龍棉花糖，那大概就是靈魂的樣子吧。{F#妳}{M#你}的靈魂很溫暖，是烤過的那種。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解歐洛倫·其五",
      "text": "老實說，我自己對自己也不甚瞭解。我總是有很多疑問；已有的問題還沒得到解決，馬上又會有新的加入進來。\\n好像沒有什麼特別好的解決辦法…只能盡量往前走，對吧？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "歐洛倫的愛好…",
      "text": "除了種菜和觀察蜜蟲以外的愛好？有的…當然有，給我點時間，會想出來的。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "歐洛倫的煩惱…",
      "text": "有時，想要和做到之間的距離真的很難跨越。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "吃塔塔可時，在下面放一張空餅皮。只要吃得夠多，掉下來的食材就會變成一個新的塔塔可了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "軍用食品…尤其是壓縮餅乾。它們就像「隊長」的靈魂一樣沉重…品質很好，只是太硬了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "厲害，比我自己做的好吃。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "不多不少，恰到好處的味道。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "我不太明白…這是什麼藝術？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#在納塔，有種說法是，一個人的出生日期決定了他的命運。如果他的生日和某位大英雄是同一天，那他就會得到這位英雄的庇佑，擁有和他一樣的素質。\\n我想，和{F#妳}{M#你}共享生日的人一定很幸運。生日快樂。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#{F#妳}{M#你}剛剛拿給我的是什麼？能再讓我看一下嗎？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#我是不是應該叫{F#妳}{M#你}一聲老師？謝謝{F#妳}{M#你}，{M#爺爺}{F#奶奶}老師，我學到很多。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "身體很輕，看來可以一下子去到更高的地方了。但要控制好力道，因為磕到頭會很疼。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我還沒能力窺探死亡的界限，但{F#妳}{M#你}的幫助似乎將死亡推得更遠了一些。放心，我不會因此就去隨心所欲做壞事的，我保證。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "別跑太遠。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "再見囉。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "放生！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "去吧，你自由了。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "來，跟大家問好。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "幫我四處看看。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#{F#妳}{M#你}對寶箱的熱情正在威脅它們的生存環境。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "敲出來的聲音很清脆，應該是顆不錯的果實。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "小心哦，有些龍喜歡躲在箱子裡。可能是內向吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "跑不動了…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "小心…！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "壞兆頭。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "要帶你去看醫生嗎？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我先補上。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "先走一步…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "看不清楚了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "聽見了…不該存在的聲音…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "呃，跑慢了…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "這不對吧？"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "要我加入嗎？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "去哪？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "能不能先說，是好事還是壞事？"
    }
  ]
}