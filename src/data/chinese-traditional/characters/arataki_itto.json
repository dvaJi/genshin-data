  "outfits": [
    {
      "id": 205700,
      "name": "傾奇狂鬼",
      "description": "荒瀧一斗的裝扮款式。不僅大衣氣派非常，腰帶上的鬼面更是威嚴，連花見坂最頑皮的小孩也能嚇哭。",
      "isDefault": true,
      "characterName": "荒瀧一斗",
      "characterId": 10000057,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Itto_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#作為荒瀧派的大哥大，本大爺的名號早就威震四方了。「荒瀧天下獨尊一斗」、「荒瀧相撲鬼王一斗」、「荒瀧鬼族驕傲一斗」、「荒瀧鬼兜蟲角鬥士一斗」、「荒瀧卡牌遊戲王中王一斗」、「荒瀧可以輸但絕不認輸名副其實男子漢一斗」…這些都是我常用的名字，{F#妳}{M#你}可以挑個喜歡的隨便叫，不用客氣，哈哈哈哈。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·到此一遊",
      "text": "嘿嘿，荒瀧天下第一斗到此一遊！ 哈哈哈哈…咳…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·零食",
      "text": "輕易得到的東西哪有滋味？所以，零食我從來不會用摩拉買，都是堂堂正正地贏回來。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·鬥蟲",
      "text": "不要小瞧鬥蟲啊。在一次次拼搏中，用汗和淚澆灌出更強的自己，這就是人生啊！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "男子漢從不打傘…啊這雨也太大了吧，快，快，快開傘！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "喂！雷電將軍對吧？聽著，本大爺就是不服！有本事，劈我啊！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#喔吼…來滾雪球吧！{F#妳}{M#你}是贏不了我的！阿…阿嚏！…呼。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "天氣真好！該把我珍藏的鬼兜蟲拉出來訓練一番了！唔！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "風再大，髮型也不能亂，這是男人的底線。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早啊！…已經沒有摩拉了，但今天還是不想幹活。不如想想去哪裡玩吧？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "吃飽了去哪裡逛好呢？花見坂…都逛爛了，嗯，也不適合去天領奉行那鬧…嗯算了，去離島遛遛吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "噓！是誰在講話…？是鬼啊！哈哈哈…被嚇到了嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "累了就快睡吧，別逞強，我？哼，我睜著眼也能睡覺，嘿嘿。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於荒瀧一斗自己·不務正業",
      "text": "他們說我不務正業？哈哈哈哈！胡扯！本大爺是混混啊，混混的正業就是不務正業，有什麼問題嗎？咳，不好意思激動了些…哎呀，放心放心，我不偷不搶，快活不下去了，就去做點臨時工賺摩拉，搬貨送信都是小兒科，開業現場幫忙充場子也是常幹的事，只要摩拉日結就行了，嘿嘿！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於荒瀧一斗自己·鬼族",
      "text": "鬼族經歷了很多事情，才迎來了現在這個好時代，可以與人類共同生活。只可惜啊，時至今日還有許多人對鬼族心存芥蒂。嗯？怎麼辦？當然要改變啦。哼，但我不會刻意去討好他們，我要用自己的方式，贏得人類的尊重。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·合拍",
      "text": "#喂，我看{F#妳}{M#你}總是東奔西跑地替人辦事，圖的不止是摩拉吧？{F#妳}{M#你}一定也是個豪爽仗義的人！哈正好，本大爺最喜歡跟仗義的人打交道，我們絕對能成為超級合拍的搭檔！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·響應",
      "text": "#說實話，我很欣賞{F#妳}{M#你}，一直很欣賞{F#妳}{M#你}。當然希望{F#妳}{M#你}能留在荒瀧派啦，欸，連給{F#妳}{M#你}的稱號我都想好了，在{F#妳}{M#你}名字裡添上「天下第二」，我倆就是「數一數二」組合！哈哈哈。哎呀…玩笑歸玩笑，我知道{F#妳}{M#你}還有更重要的使命…去吧，去做{F#妳}{M#你}想做的事情。總之{F#妳}{M#你}記住，荒瀧派會無條件響應{F#妳}{M#你}。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "別問，說起這個我就火大。那群幕府軍奪走人們珍視的東西，罪大惡極，竟然還敢亂擺神之眼！欸，照理說，越強的人，神之眼就應該嵌在越上面才對吧，到底是哪個不識抬舉的將本大爺的神之眼嵌在最下面啊！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·希娜小姐",
      "text": "#{F#妳}{M#你}要是有什麼煩惱，可以試著給《閒事月刊》的問答欄目投稿，希娜小姐一定會給{F#妳}{M#你}一個溫暖人心的答案。啊…託她的福，我的靈魂已經不再迷茫了…對了，我還報名了希娜小姐的線下見面會，唉這日子怎麼就過得那麼慢呢。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什麼想要分享·雙角",
      "text": "我頭上的角，看久了會單調嗎？要不用塗料把它弄成彩虹色吧，再抓點螢火蟲綁在上面，走在街上炫彩奪目，想想就覺得很帥！本大爺果然是天才，我這就讓兄弟們行動起來！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "抓鬼兜蟲的唯一秘訣就是——抓之前一定要擦亮雙眼看清楚，尤其是在風亂吹雨亂下的雷雨天，一不小心就會把堇瓜和鬼兜蟲弄混。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於托馬…",
      "text": "聽弟兄們說，他是第一百顆神之眼狩眼儀式的主角？嗯？為什麼他會有專屬的儀式啊？欸，難道說第一百顆神之眼是比前九十九顆厲害嗎？嘶…不對，真是那樣的話，那應該是本大爺來當這第一百顆才對！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於神里綾人…",
      "text": "哈哈哈哈，我跟綾人兄可以說是相見恨晚啊！如果不是他提醒我「讓溫順的蟲子燃起鬥志」是我一生都該堅守的覺悟，也許早在第七百八十次戰敗時，我就放棄鬥蟲了…哈哈，果然只有男人最懂男人，哎呀，我和他之間無需多言，在打牌和鬥蟲時，默契就已經悉數體現了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於宵宮…",
      "text": "#那傢伙，仗著自己會做煙花和小玩具，哄起小孩來一套一套的…不行，不能讓她搶盡風頭，「孩子王」本大爺是當定了！{F#妳}{M#你}也要站我這邊…什麼？{F#妳}{M#你}不是孩子？呵，在我眼裡，比我矮的，全是孩子！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於楓原萬葉…",
      "text": "#聽說{F#妳}{M#你}從天守閣逃出來後，是他擋下了「無想的一刀」？帥啊！到底怎麼做到的。{F#妳}{M#你}想，他是沒落的貴族，我是沒落的鬼族…某種意義上，我和他旗鼓相當啊。哈哈哈哈，那麼，下一刀，本大爺替{F#妳}{M#你}擋了！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於雷電將軍…",
      "text": "搞眼狩令的時候，需要出動她得意的天狗才能制服我，說明本大爺一定讓她很頭痛吧？不過，既然她決定廢除眼狩令，也不算無可救藥。哼，她最好記住這次的教訓，別再有下次，不然，我一定會讓她更頭痛，哼。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於狐耳女人…",
      "text": "那場狐狸拉麵比賽，是我贏了，就算麵裡有油豆腐，她也別想贏我！那之後…那之後我躺了一個多月，但我至少守住了勝者的榮耀！而她，就要承受付清三十二碗麵錢的恥辱。哈哈哈哈…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於九條裟羅…",
      "text": "眼狩令那會我確實敗給她了，呵，這也沒什麼好羞恥的，輸了就堂堂正正投降，錯了就老老實實挨打，這才是真男人！反倒是她，堂堂天狗，不敢應我的復仇之約。哼，不過是在十字路口相撲而已，這就怕了？她要是再不來應戰我就不叫她九條天狗了，我要叫她——九條烏龜！"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於五郎…",
      "text": "哦，反抗軍的小狗大將嘛，身材小小但氣魄非凡，不錯不錯！而且，他身上散發著一種讓人內心溫暖的熟悉感…奇怪，明明沒見過他幾面…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於久岐忍…",
      "text": "荒瀧派的弟兄們一般都會順著我意，唯獨這個忍啊，老是跟我唱反調！本大爺辛辛苦苦贏來的戰利品，竟然被她一件件還了回去。哎呀，算了，看在她每次都會把我從牢房裡撈出來，還替我們收拾了不少爛攤子，就不計較了。畢竟惹怒了她，我也沒有好日子過…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於早柚…",
      "text": "不過是趁她不注意的時候，摸了摸她的頭而已，現在一見面就要跳起來打我。哈哈哈沒辦法，這麼可愛的小狸貓，誰見了都會忍不住想去摸摸頭吧？噢對了…喊她狸貓也會被揍。為什麼啊，那不就是狸貓嗎…？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解荒瀧一斗·其一",
      "text": "#{F#妳}{M#你}一定很想問，為什麼我只會鬥蟲和打牌，卻能穩坐荒瀧派老大的寶座？哼，的確，只會這些小兒科難以服眾。乾脆就一口氣告訴{F#妳}{M#你}吧！我還會倒立吃拉麵、睜著眼睡覺、用鼻孔吹口琴、用髮梢拍蒼蠅這類絕活。怎麼樣，消除{F#妳}{M#你}心中的疑惑了吧？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解荒瀧一斗·其二",
      "text": "稻妻人每逢過節、搬家、生病，都愛撒豆子，一邊撒還一邊唸唸叨叨，「福豆撒落，鬼怪敗挫」、「福來福來，鬼去鬼去」…我都聽出耳繭了。關鍵是豆子還經常撒出路面來，害我過敏…可惡啊！我一定要為鬼族正名，鬼啥也沒幹！別有事沒事就想著驅鬼驅魔的。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解荒瀧一斗·其三",
      "text": "為了消除人類對鬼族的偏見，有次我讓弟兄們把我溫柔和藹的形象用留影機拍成畫片，貼在稻妻城的留言板上。欸，結果有些人竟敢在畫片上亂塗亂畫！更可恨的是，天領奉行的蠢貨足輕說我引起社會治安恐慌，社奉行又說什麼敗壞風氣，連勘定奉行的走狗都要來要什麼廣告營業稅…嘶…真是不識好歹！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解荒瀧一斗·其四",
      "text": "#包容和理解這些有過不幸經歷的人，這才是我荒瀧派的「驕傲」。…{F#妳}{M#你}別聽外面的人說什麼怪不怪人的，在我眼裡，他們每一位都是我重要的家人。呵，這群小子也抱著和我一樣的想法，不管怎樣都會和荒瀧派同甘共苦。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解荒瀧一斗·其五",
      "text": "我很敬佩青鬼「犧牲自己換取赤鬼延續」的行為，但絕不認同他們的理念。「更好地活下去」絕不該靠犧牲同類換取，應該是「一起更好地活著」才對。自顧自地犧牲…獨自耍帥的行為算什麼嘛…唉…過去已經沒辦法改變了。但今後，在我荒瀧一斗的眼皮子底下，沒有人可以隨便犧牲自己。本大爺，要擋在你們前面！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "荒瀧一斗的愛好…",
      "text": "#鬥蟲、打牌、陀螺、劍玉、捉迷藏…總之{F#妳}{M#你}想得到的想不到的，我全都會！怎麼樣？要比什麼？做好全盤皆輸的準備吧！哈哈哈哈！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "荒瀧一斗的煩惱…",
      "text": "「鬼婆婆」不是鬼，她可是世界上對我最好的人類，只是因為收養了我才會被叫鬼婆婆的。我怎麼樣都無所謂，反正我也不在乎別人的看法…唉，但我不想她因為我而被別人指指點點…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#棒棒糖全身都是寶，不但糖好吃，棍子叼在嘴裡還很帥，為我增添了一絲不羈的氣質，來，{F#妳}{M#你}也試試吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我是鬼我是鬼啊！最討厭的當然是豆子啊！黃豆、綠豆通通不行，別說吃了，光是碰到身上都會過敏。唉，所以說，撒豆子這種陋習還是趕緊滅絕吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "哈哈哈哈哈哈——已經三年沒吃到那麼好吃的菜了！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#好！{F#妳}{M#你}今天孝敬本大爺的，我都記在帳上了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#喂，{F#妳}{M#你}…難不成…給我下毒了？！啊…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#今天是個重要的日子，我特意把弟兄們支開了，不然他們肯定要說我偏心。來，看看，我給{F#妳}{M#你}準備的生日禮物可是最高規格的！抓了三天三夜才抓到的特級鬼兜蟲一隻、大戰了三百回合贏來的絕版卡牌一張，哦還有本大爺親自演唱的生日歌一首——咳咳…祝{F#妳}{M#你}生日快樂…祝{F#妳}{M#你}生日快樂…"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "喔喔…就是這樣就是這樣！力氣更大了！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "好強的力量…勝率絕對會提升吧！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "這力氣，一拳砸碎岩石，應該不在話下吧？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#這樣一來，我就是名副其實的荒瀧天下第一斗了啊！{F#妳}{M#你}的功勞，本大爺不會忘。以後，就由本大爺來保護{F#妳}{M#你}了。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "鬥戰岩牛！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "給我砸！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "就是你了！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "鬼王遊巡，通通閃開！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "鬼蜮狂歡！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "哈哈，到我表演了！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "快看看有沒有新鮮玩意兒？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "本大爺果然運氣超凡！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這些夠我躺三天不幹活了吧？"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "衝刺開始·其一",
      "text": "追不上我！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "別太小看鬼族了！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "你以為我這就會認輸嗎？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "區區小傷，不用管不用管！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "站在本大爺身後！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我不允許你倒下！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "復仇之戰，未完待續…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "倒下的姿勢…得帥才行。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "辜負弟兄們的期待了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "膽子不小！"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "用點力！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "太用力了吧！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "偷襲可恥！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "都給本大爺讓道！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "救世主來囉！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "多大點事，看我來擺平！"
    }
  ]
}