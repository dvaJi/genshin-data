  "passives": [
    {
      "id": "vanguards_coordinated_tactics",
      "name": "尖兵協同戰法",
      "description": "隊伍中所有角色的元素類型均為<span style=\"color:#FF9999FF\">火元素</span>與<span style=\"color:#FFACFFFF\">雷元素</span>，並且至少有一名火元素角色、一名雷元素角色時：<br/>夏沃蕾將為隊伍中附近的角色施加「協同戰法」：角色觸發超載反應後，受本次反應影響的敵人的<span style=\"color:#FF9999FF\">火元素</span>與<span style=\"color:#FFACFFFF\">雷元素</span>抗性降低40%，持續6秒。<br/>當隊伍中角色的元素類型不滿足突破天賦的條件時，將移除已有的協同戰法效果。",
      "level": 1
    },
    {
      "id": "vertical_force_coordination",
      "name": "縱陣武力統籌",
      "description": "夏沃蕾發射<span style=\"color:#FFD780FF\">近迫式急促攔射</span>的「超量裝藥彈頭」後，基於夏沃蕾的生命值上限，每1000點生命值上限都將使隊伍中附近的所有<span style=\"color:#FF9999FF\">火元素</span>與<span style=\"color:#FFACFFFF\">雷元素</span>角色的攻擊力提升1%，持續30秒，至多依此方式提升40%攻擊力。",
      "level": 4
    },
    {
