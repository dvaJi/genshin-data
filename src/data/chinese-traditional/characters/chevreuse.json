  "outfits": [
    {
      "id": 209000,
      "name": "守正之槍",
      "description": "夏沃蕾的裝扮款式。設計師們保留了經典的黑白紅制服配色並增加了大量飾品，但因為實在太重，招致了夏沃蕾隊長的抗議。眾人最終看到的是去除了大量金屬扣飾的版本。",
      "isDefault": true,
      "characterName": "夏沃蕾",
      "characterId": 10000090,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Chevreuse_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "我是楓丹特巡隊隊長夏沃蕾，寒暄就免了，有什麼棘手的案件需要處理嗎？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·銃槍",
      "text": "銃槍是我最喜歡的武器，它具有強大的殺傷力和威震力。有些時候，後者甚至比前者更有用。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·巡邏",
      "text": "我們特巡隊並不參與楓丹廷的日常巡視工作，我們追捕的人也不可能在大街上露面。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·食物",
      "text": "「圈圈圓圓」這種零食方便攜帶，還可以搭配醬汁品嚐出不同風味…等著，我去買幾份回來。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "放心，即使是在雨裡，我的銃槍依舊能夠正常開火。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "有些罪犯會用雷鳴聲來掩蓋槍聲，但這騙不過我的耳朵。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "等等…我要維護一下銃槍，以免它的機關結構被凍住。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "天氣不錯，視野良好。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "這種風速…只怕連出膛的子彈也會被吹歪。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "廣闊的沙漠，很適合掩埋某些事物。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安，我正準備去做幾組體能訓練，要一起嗎？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "午安，要和我一起去特巡隊餐廳吃飯嗎？那裡的飯菜很適合填飽肚子。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今天的工作總算結束了，而且沒出什麼大亂子，我們去吃點宵夜吧，我來帶路。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。我稍後也會去休息，希望…今晚不要發生太多緊急的事。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於夏沃蕾自己·特巡隊",
      "text": "特巡隊專門應對各類危急凶案和惡劣罪犯，所以我們在執法時會相對…強硬一點。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於夏沃蕾自己·帽子",
      "text": "在特巡隊裡有一個不成文的規定——如果一個隊員犧牲了，那我們就會將那名隊員的帽子保存起來。如果他的後代也成為了特巡隊員，我們就會將這頂帽子授予其後代，這也算是一種「傳承」吧…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·興趣",
      "text": "我會在空閒時看一些「犯罪小說」。和推理小說不同的是，犯罪小說並不會去設計複雜的犯罪手法，而是著重在描寫圍繞案件發生的各色人情糾葛和情緒衝突，在我看來還滿有趣的。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·法理",
      "text": "#如果{F#妳}{M#你}對法理有什麼疑問，可以隨時來問我，或者說…當{F#妳}{M#你}的腦子裡出現「也許這件事並不算違法」的念頭時，必須第一時間來和我商量。\\n每年都有不少蠢貨因為僥幸心理而跨越紅線，我不願意看見{F#妳}{M#你}成為那種人。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "在我的工作中，「神之眼」的確是一種不可忽視的武力輔助。有了它之後，我的銃槍再也沒有發生過嚴重故障。\\n「同時持有神之眼和銃槍的特巡隊隊長」——這些名號加起來應該夠嚇倒一些膽小的嫌疑人了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#漢考特竟然真的逮捕了米莉絲…面對摯愛之人也可以下得了手，讓人欽佩——但是米莉絲做錯了什麼呢？她只是變賣了一件撿到的首飾而已，就變成了貴族口中十惡不赦的罪人…正義真讓人捉摸不透，{F#妳}{M#你}覺得呢？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·警衛機關",
      "text": "雖然我們隸屬於執律庭，但特巡隊執行任務時並不會大量使用警衛機關。至於為什麼…呵，那些笨重的機關，只會擋住我們射出的子彈。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於娜維婭…",
      "text": "我聽說過和娜維婭小姐父親有關的那件謀殺案，當時在執律庭也鬧得沸沸揚揚，不少人都因為這件案件而吵個不停…\\n好在如今案件已然昭雪，真正的凶犯也已經伏法…「正義」總算是正式入席了。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於林尼…",
      "text": "我認識這位大魔術師。有一次我們逮捕了一位涉嫌故意傷害、拐騙和謀殺的魔術師，卻一直弄不清他的犯罪手法。最後還是請來了林尼先生做顧問，才找到了關鍵物證順利將嫌疑人定罪。聽說有位小說家對這起案件很有興趣，寫了一本用魔術手法犯罪的推理小說。\\n不過…小說的細節描述實在太過詳細，現在還處於敏感時期，暫時是無法出版了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於菲米尼…",
      "text": "我有一次出門買零件的時候有遇過這位潛水員，那時我們都想要買下店裡剩下的唯一一個通用零件。我正想說把那枚零件讓給他，但他卻一下子縮回手，低著頭一路小跑步跑出店裡。說難聽一點，簡直像個犯人一樣…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "這位決鬥代理人在楓丹廷可是大名鼎鼎啊…我們兩人職務不同，我不會隨意評價她的工作，但我相信她接下那些代理決鬥的原因，都是發自她內心的「正義」。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "萊歐斯利先生的工作卓有成效——至少罪人們都清楚地知道，「梅洛彼得堡」並不是一個養老的好去處。這對我們的審訊工作提供了很大的幫助。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於艾梅莉埃…",
      "text": "我們的私交不錯，我有好幾次請她用專業的化學知識來幫我分析物證、追緝凶犯。她還能夠幫忙發現很多看不見的事情，像是犯人用了什麼香水、送過什麼花——甚至去過什麼地方、踩過什麼泥土…她從沒有出錯過。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於千織…",
      "text": "#千織處理糾紛的方式有些激進，但她憑藉自己的門路和人脈為特巡隊提供過很多次情報。作為回禮，我會在她把人丟出店門、或是掀翻惡性競爭對手的店鋪時睜一隻眼閉一隻眼。經過事後調查{F#妳}{M#你}會發現，千織總是有理的那一方——她只是懶得和人說廢話罷了。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "這是一位讓人頭痛的記者小姐。每次重案發生後，無論我們怎麼封鎖現場，她都有辦法第一時間出現在最近的地方…有次我的一名手下甚至把她列為了第一嫌疑人，羈押了足足半個月，但她還是在拘留室裡寫完了報導…我要找個時間，正式和她的主編談談了。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於希格雯…",
      "text": "特巡隊和美露莘的交情由來已久，我們經常和逐影庭裡的美露莘合作。她們善良、誠實又可靠，在處理某些重案時，還能發揮無可替代的作用…而我個人也和幾位美露莘關係不錯，希格雯護士長就是其中一位。\\n從過去到現在，美露莘都是我們不可或缺的同伴。如果…再有任何人膽敢用任何方式汙衊、中傷她們，那麼特巡隊的槍口，絕不會留情。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "眾所皆知，最高審判官大人在審判時全無私情。有人說他少了點人情味，但在我看來正義本就不該被人情干擾。違法者即有罪，僅此而已。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "關於芙寧娜…",
      "text": "芙寧娜大人…有段時間突然指定我們進行什麼…花槍表演訓練。她不僅要求我們全員裝配一種特製的「禮儀銃槍」，還要接受特殊的舞槍訓練…還好，因為她始終找不到喜歡的儀仗曲目，這件事就草草作罷了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解夏沃蕾·其一",
      "text": "#抱歉，我並不擅長和人交際，或者說…和正常人交際。如果{F#妳}{M#你}有什麼想問的，直接問就好。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解夏沃蕾·其二",
      "text": "特巡隊是隸屬於執律庭的多個執法部門之一。因為我們的行事風格和人員組成都非常大膽，我們在執律庭的某些先生嘴裡是「最不守規矩」的部門。\\n但是，我認為特巡隊的行事準則不應受外界影響，我們要對付的惡徒不是沫芒宮裡的好好先生，如果罪人的違法亂紀來得像暴雨一樣突然，那我們也絕不能慢他們半拍。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解夏沃蕾·其三",
      "text": "我接觸的犯罪者，並非全是窮凶惡極的歹徒或惡匪。\\n多數人最一開始都只是犯下了一個小錯，他們害怕為此負責就想要悄悄補救，卻在不自覺中陷入了謊言的漩渦，最後…在無數謊言的裹挾下，身不由己地走上了犯罪的歧途。\\n我最喜歡的那位劇作家曾經在一齣歌劇中寫道：「謊言是生發罪行的惡土」。\\n但是，他自己卻在幾年後因為剽竊罪而被捕…真是為那齣歌劇下了一個戲劇性的註解。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解夏沃蕾·其四",
      "text": "我的父親受過牢獄之災，我曾被稱作「罪人的女兒」，我還在灰河長大，見過不少太陽光照不到的角落。託這些經歷的福，討厭我的人不少，但我學會的東西更多。\\n執法者要相信自己心中的「正義」，並且將其付諸在自己的行動中…這是父親教導我的話。\\n我也深以為然。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解夏沃蕾·其五",
      "text": "實不相瞞，作為特巡隊隊長，我見過很多毫無道德底線可言的惡人胡作非為，也見過無辜與善良之人捲入事件受傷，甚至付出生命。我常常感到憤怒與無力。\\n我堅信「罪人」應當受到懲罰，但這並不意味著無盡的復仇循環。\\n如果我們蒙蔽雙眼，任由情感驅使自身的行為，遲早都會溺亡在冬天的海水中。\\n越是握有權力，就越該警惕這一點——堅定追尋自己心中的「正義」，但萬不可迷失在追尋它的路上。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "夏沃蕾的愛好…",
      "text": "訓練？射擊？非要說的話…看犯罪小說吧？對了，我要去拿最新一期的《謎案尋蹤》了。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "夏沃蕾的煩惱…",
      "text": "不要再讓我學習那些繁瑣的禮儀了，與其將時間浪費在這上面，我寧願去盯著凶犯。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "富含油脂和糖分的食物，可以在工作日為我提供充足的能量，還有好心情。休息日？休息日的話，它們就淪為了會增長體重的「罪惡食品」，而將此等「罪惡」消滅，同樣能帶給我一天的好心情。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我…不太能接受生冷食物。既然是要入口的東西，至少要全熟才可以…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "很不錯。不過…呵，就只是我不由自主地吃太多了，等會要加練了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "嗯，比特巡隊餐廳的飯菜味道好多了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "夠填飽肚子，也不會勾起額外的食慾…這道菜對我來說非常優秀。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂。嗯…立正！站直一點，不要屈膝。我要測量一下{F#妳}{M#你}的身形數值，幫{F#妳}{M#你}訂做一把方便攜帶的小型銃槍，還有快拔槍套…\\n好了，放鬆。在銃槍做好之前，我先帶著{F#妳}{M#你}用訓練銃槍打靶一段時間。現在就開始，跟我走。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "不錯，扶槍的手更穩了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "這樣的話，也許能夠狙擊到更遠的敵人…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "多謝，有了這樣的力量，追緝惡徒就更有效率了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#感謝{F#妳}{M#你}為我提供的所有幫助…雖然我不能承諾特巡隊隨時聽{F#妳}{M#你}差遣，但就我個人來說，只要{F#妳}{M#你}開口，我就會與{F#妳}{M#你}同行。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "不許動！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "放下武器！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "最後通牒！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "必要武力。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "繩之以法。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "束手就擒！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "不錯。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "希望裡面沒有贓物。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這不算是違法所得，放心吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "惡徒…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "目無法紀。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "你，無權申辯了。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "穩住隊列！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "保持陣型！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "正義…何在…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "罪人…尚未…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "這就是…結局嗎…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其一",
      "text": "無用頑抗…！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "出動吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "就當作是加練。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "我隨時都準備好了。"
    }
  ]
}