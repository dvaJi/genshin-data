  "outfits": [
    {
      "id": 206200,
      "name": "機動獵人",
      "description": "亞蘿伊的裝扮款式。適合林野生活的獵人裝束。",
      "isDefault": true,
      "characterName": "亞蘿伊",
      "characterId": 10000062,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aloy_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#我是亞蘿伊，雖然對這個世界還不太瞭解，但我的弓和箭隨時為{F#妳}{M#你}所用。如果{F#妳}{M#你}的隊伍需要我，我會傾力相助。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·動身",
      "text": "別閒站著了，該動身了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·幫助",
      "text": "現在不該停留，還有人需要我們幫助。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "雨，可以洗淨髒汙。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨過天晴…",
      "text": "雨停了，該把自己晾一晾了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "下雪時，似乎整個世界都靜下來了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起風的時候…",
      "text": "又起風了，在風中呼吸的感覺真不錯。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "風烈起來了，颳得臉上生疼。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安。世界又充滿了活力，我也一樣。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "日已過半，我們還有不少事要忙。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "太陽下山了，再過不久星星就要出來了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#晚安。該休息了，除非{F#妳}{M#你}想藉著星光繼續行動。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於亞蘿伊自己…",
      "text": "我從小就是個被逐者，那段日子很不好過。但在這裡，即便是對待我這樣的外人，大家也比我所降生的那個部族友好得多。感覺…很好。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·行動",
      "text": "#我的一切行動都是為了拯救生命，而非帶來死亡。這就是我與{F#妳}{M#你}並肩戰鬥的原因。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·誓約",
      "text": "#立誓什麼的，有點太循規蹈矩了。不過如果{F#妳}{M#你}想要我的誓約，那我的誓言與{F#妳}{M#你}同在。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "關於我們·前進",
      "text": "#我會盡全力與{F#妳}{M#你}一起前進，直到終點。我不會躊躇，也不會辜負。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "如果說有什麼可以分享的話，那一定是我的弓與箭，我只為扶助他人而使用。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "和我那邊的世界一樣，這片天地的過去也充滿了秘密。如果能有足夠的時間，我一定要把一切秘密都揭開。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解亞蘿伊·其一",
      "text": "我不太擅長談論自己的事情，眼下的任務才是重點。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解亞蘿伊·其二",
      "text": "我沒有父母，是一個叫羅斯特的男人撫養我長大的。他有點嚴厲，不過心腸很好，也很大方。他教了我很多東西，嗯…我很想他。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解亞蘿伊·其三",
      "text": "以前，我花了很多時間在尋找我的生母，卻沒有找到「她」。取而代之的是，我找到了一些遠古的留言，是我的…「複製母體」留下的。聽著那些留言，我覺得她似乎很瞭解我，也很會鼓勵我。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解亞蘿伊·其四",
      "text": "#在成長的過程中，我沒有什麼朋友。雖然後來在旅途中認識了一些人，但當我離開那個世界時，我和他們的關係還稱不上熟絡。所以，能和{F#妳}{M#你}一同度過這麼多時間，成為朋友，我真的很開心。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解亞蘿伊·其五",
      "text": "#我不會輕易信任他人，但我確定{F#妳}{M#你}是可以信任的。{F#妳}{M#你}是我真正的夥伴，我可不經常這樣評價別人。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "亞蘿伊的愛好…",
      "text": "我不太清楚自己有什麼愛好，「閱讀古物」算一個吧。嗯，那就…歷史？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "亞蘿伊的煩惱…",
      "text": "除了我自己的世界，現在又多了一個世界需要拯救。唔…時間總是不夠用。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "我不挑食。只要不餓著肚子旅行，吃什麼都行。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "我吃過一次「歐瑟蘭燉肉」，稠得都能當瀝青鋪路了，嘔。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#我從來不怎麼在意生日。在我出生的世界，大家都會紀念母親，沒人慶祝自己的生日。不過先不管那些。嗯…祝{F#妳}{M#你}生日快樂。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "很好，我們進展不錯。但可不能止步於此。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "有所成長，變得更強了，是件好事。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "無論現在是多精湛的獵人，總還能更進一步。不要因為自滿而止步，不要停止學習。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我們剛開始結伴旅行時，對我而言，{F#妳}{M#你}還只是一個陌生人，來自我所不熟悉的世界。但既然如今我們已經一同經歷了這麼多，我可以向{F#妳}{M#你}保證：我的弓永遠與{F#妳}{M#你}同在。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "這東西是會炸的。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "獵人的小玩具。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "見過這個嗎？"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "禁錮！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "一點新技巧。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "這裡是我的獵場！"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打開風之翼·其一",
      "text": "這東西用起來還不錯。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "嗯…算是些有用的東西。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "這些能吃…這些能用…"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "這些，到底是誰留在這的呢…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "棘手的獵物…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "弱點在哪…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "大意了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "當心！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "別太冒進！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "哪裡…出了錯…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "抱歉…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "失敗的狩獵…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "唔…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受擊·其二",
      "text": "小問題…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "呃！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "有點麻煩…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "這次要去哪晃晃？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "亞蘿伊，加入狩獵。"
    },
