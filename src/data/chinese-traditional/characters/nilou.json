  "outfits": [
    {
      "id": 207001,
      "name": "莎邦之息",
      "description": "妮露的典雅服飾，千花編織般的輕盈裙裝，如有黎明時東風捎來的淡香，承載著童話世界的美好祝福。",
      "isDefault": false,
      "characterName": "妮露",
      "characterId": 10000070,
      "source": [],
      "filename_card": "UI_AvatarIcon_NilouCostumeFairy_Card",
      "filename_icon": "UI_AvatarIcon_NilouCostumeFairy",
      "filename_iconCircle": "UI_AvatarIcon_NilouCostumeFairy_Circle",
      "filename_splash": "UI_Costume_NilouCostumeFairy",
      "filename_sideIcon": "UI_AvatarIcon_Side_NilouCostumeFairy"
    },
    {
      "id": 207000,
      "name": "非花非霧",
      "description": "妮露的裝扮款式。既非花也非霧，她身著舞衣飛旋時卻有如花開霧起。",
      "isDefault": true,
      "characterName": "妮露",
      "characterId": 10000070,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Nilou_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次見面…",
      "text": "#{F#妳}{M#你}好，我是來自祖拜爾劇場的妮露。今天上演的劇目是這一支舞。請{F#妳}{M#你}不要眨眼哦，要開始了——"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·練習",
      "text": "先這樣…下一個動作是…這樣吧，嗯…嗯！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·睏意",
      "text": "深呼吸，吹一個大大的氣球，把睏意放進氣球裡，呼——氣球飛走吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·休息",
      "text": "這樣清閒的日子倒也不錯嘛，悠哉悠哉。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "天氣和心情一樣，有時候會變得陰沉沉的，但是不用著急，雨後的天空會更加澄澈。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "#雷聲有點恐怖呢，{F#妳}{M#你}會害怕嗎？我可以跟{F#妳}{M#你}分享一個神奇的方法哦。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "#欸？哇——下雪了。{F#妳}{M#你}聽，下雪的簌簌聲，加上旋轉著的雪花，像不像自然的精靈在跳舞？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "陽光明媚的日子…曬得暖洋洋的。唔，會想睡覺…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "#{F#妳}{M#你}還好嗎？小心風沙哦。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#早上好哦。欸？{F#妳}{M#你}盯著我看是…哦頭、頭髮翹起來了嗎？啊，先別看我，唔，我馬上整理好。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "唔…嗯…中午吃餅好呢？還是吃飯呢…不如吃薯泥吧？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好，今晚我在祖拜爾劇場有演出。給{F#妳}{M#你}兩張劇票吧？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#睡前把煩惱全部都傾訴掉，會睡得比較香哦。如果{F#妳}{M#你}願意，我很樂意當{F#妳}{M#你}的聽眾。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於妮露自己·肢體語言",
      "text": "有時候，舞蹈比語言更能傳達出心情，不知道該說什麼好的時候，就跳舞吧。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於妮露自己·舞蹈與知識",
      "text": "探究知識需要很高很高的天賦，很多人拼了命地努力，結果勞累又沮喪…但跳舞就不一樣了，就算看不懂內涵，也能看個熱鬧。要是能從這份肢體動作中品味到藝術的美麗與價值，那我就更開心了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·緩解生氣",
      "text": "#{F#妳}{M#你}會生悶氣嗎？嗯，生悶氣是不好的。來，跟著我做。先在身前用右手畫一個大大的圓，然後，雙手把討厭的事都從胸口裡取出來，放在圓裡。接著，用力地推出去！怎麼樣，心情好起來了嗎？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·外出冒險",
      "text": "#雖然我之前沒離開過須彌城，但…我想和{F#妳}{M#你}一起去冒險。哦，到陌生的地方，我適應一下就好…唔，稻妻的沙灘下，真的不會有很大很大的沙蟲，突然鑽出來嗎？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "我的神之眼是第一次登臺跳舞時拿到的。我想，神明大人會成為我的觀眾，一定也認可了人類藝術的美麗之處吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "努力沒有結果，也是很正常的。就像我不管怎麼努力，也沒辦法理解明論派的知識。嗯，這個時候晃一晃腦袋，讓大腦轉個彎，換個方向就好了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·晶蝶之舞",
      "text": "#晶蝶有各種各樣的顏色，很漂亮。當{F#妳}{M#你}實在按捺不住好奇心，悄悄伸出手的時候，它們就會一下子跳起優美而迅疾的舞步，離{F#妳}{M#你}遠去。啊，我要是會飛的話，就能學會晶蝶之舞了。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感興趣的見聞·帕蒂沙蘭",
      "text": "花神大人跳舞的時候，真正的帕蒂沙蘭會在她踏足過的地上盛開。…啊，聽起來就非常美好，真想見一見這樣的場景。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於賽諾…",
      "text": "#教令院的人，我不太敢接觸，畢竟他們對歌舞藝術的印象都不好。我常常會想，那他們會透過什麼來打發時間呢？呃…{F#妳}{M#你}說賽諾的話，會玩「七聖召喚」？真是不可思議呢。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於提納里…",
      "text": "據說他是很厲害的植物學家。那他分辨蘑菇的本領一定很厲害，至少不會吃到毒蘑菇…好羡慕呀。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於柯萊…",
      "text": "她偶爾會來看我的演出，是一位很熱心的見習巡林員呢。她還提醒過我小心迷路，這是為什麼呢？我也沒有迷路過呀。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於卡維…",
      "text": "我聽說是他建造了華美的艾爾卡薩扎萊宮，能建造出那樣的作品，過程應該快樂又陶醉吧。就像我練舞的時候一樣，只要一想到能跳給大家看，就充滿了喜悅和動力呢。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於迪希雅…",
      "text": "最近發生了那麼多事情，總覺得很不可思議。我原本想為迪希雅和迪娜澤黛挑選一些適合的禮物。但我自己拿不定主意，嗯…要是把大巴扎朋友們推薦的品種全送去，又太多了。哎呀，到底該怎麼辦才好呢？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於多莉…",
      "text": "#出手闊綽的多莉大商人也曾看過我跳舞。我記得，有一次她和祖拜爾先生商量了什麼事情，之後就再也沒來過了。會是什麼事情呢？嗯…呃？{F#妳}{M#你}是說她可能想帶我進行一場提瓦特巡演？不會吧，祖拜爾先生一定幫忙拒絕了吧…應該拒絕了吧…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "大巴扎的大家都很喜歡小吉祥草王大人，好想聽聽她對我跳的花神之舞的評價呀…啊！不、不，還是算了算了。她真的來了，我絕對會緊張得不得了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解妮露·其一",
      "text": "#唔——啊！抱歉，我在想等一下去吃什麼好呢？有點分心了…{F#妳}{M#你}需要幫忙嗎？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解妮露·其二",
      "text": "我的老師教過我很多跳舞的要領，但她說，最重要的還是要把情感都投入到舞蹈裡，因為這樣才是最能打動人的。有所感，才能抒發。想要傳達美麗的話，我就要成為美麗本身吧。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解妮露·其三",
      "text": "有時候我會收到觀眾們的來信，他們說因為我的舞蹈打起了精神。我會和祖拜爾劇場的大家共同分享這份快樂。雖然在觀眾眼裡，我是在台前的那一個，但在我心中，這永遠是靠所有人的努力才能取得的成果。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解妮露·其四",
      "text": "大巴扎有時候會有一些雜技表演，比如說不停拋起球來又不停接住。以前我也試過這個，但是不知道怎麼回事就是接不住球，反而全掉頭上了。當時祖拜爾先生他們都笑了起來。嗯…好像在他們眼裡，我的身體協調能力應該非常強一樣…暴露短處了呢。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解妮露·其五",
      "text": "#以前有人說我就像是暖陽下的綠洲，讓人感到治癒與溫暖。我多多少少會高興一下，但我的追求、我試圖向大家呈現的價值不止在此。不過，跟{F#妳}{M#你}相處久了我才知道，被人照顧和關懷是這樣的感覺。現在…現在，我感覺那個比喻更適合{F#妳}{M#你}。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "妮露的愛好…",
      "text": "我的人生就是跳舞，跳舞就是我的人生…到底該說哪個才比較好呢？哎呀，我果然不適合思考這些太有邏輯的東西。總之，我會一直跳下去的。用我的表演，讓這份藝術之美被更多人看見。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "妮露的煩惱…",
      "text": "我還是分不清哪些蘑菇有毒，哪些又沒有…據說，顏色不管是鮮豔還是樸素的蘑菇，都有可能有毒。唔，好像明白了什麼，又好像什麼都沒明白…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "#甜食總能讓人心情愉快，須彌大多數人都喜歡甜食哦！欸，{F#妳}{M#你}要不要也試試看？我可以為{F#妳}{M#你}一一介紹。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "#我有點難以接受菌菇那一類，主要是害怕。不是那種見到了想逃走的害怕啦。我…我是小時候誤吃過毒蘑菇，在床上躺了好幾天…如果{F#妳}{M#你}想嚐一嚐須彌的菌菇美食，要記得確保是無毒蘑菇哦。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "原來美食在舌尖起舞，指的就是這樣的感覺…好神奇呀！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "#謝謝{F#妳}{M#你}。就像我不斷練習跳舞一樣，這道菜餚，一定也凝結著{F#妳}{M#你}的心血吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#抱歉，可能是我最近胃口不太好，{F#妳}{M#你}別介意。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#那個…生日快樂！我最近學會了一支新的舞蹈，想要跳給{F#妳}{M#你}看。呃，{F#妳}{M#你}問我緊張嗎？呼——被{F#妳}{M#你}看出來了呀。因為，想要融合心意與技巧，不知不覺編得越來越難…總之，希望美好與快樂能永遠留在{F#妳}{M#你}身邊。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "啊，這是什麼感覺？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "身體舒展開了，能比以往發揮得更出色吧。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "我就像躺在一隻大大的風史萊姆背上，好輕好輕。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#我喜歡和{F#妳}{M#你}待在一起。嗯…我也不知道為什麼，總感覺好像有蝴蝶要從胸腔飛出來一般…還是讓我跳一支舞給{F#妳}{M#你}看吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "來了喲。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "準備跳囉。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "全力以赴。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "和浪花共舞吧。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "請看好了哦。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "這支舞，獻給你。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "#都給{F#妳}{M#你}。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "我來幫忙一起收吧。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "哇，是意外之喜。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "唔，不用擔心我…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "真傷腦筋呀…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "得快點深呼吸…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "別急，我來了。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "請讓我來抵擋一陣！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "還沒來得及…謝幕…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "不能…繼續跳舞了嗎…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "美麗之物，不要遠去…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "啊，要穩住平衡。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "受重擊·其二",
      "text": "有點…痛。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "今天要去哪裡跳舞呢？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "有什麼我能幫忙的嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "啊…是叫我嗎？來啦。"
    }
  ]
}