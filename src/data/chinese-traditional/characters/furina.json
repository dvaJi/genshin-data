  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#愣在那裡做什麼？該不會是因為過於激動說不出話了吧？沒錯，站在{F#妳}{M#你}面前的就是楓丹人人皆知的大明星——芙寧娜哦！我的檔期可是很滿的，能約到我，看來{F#妳}{M#你}運氣不錯嘛！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·茶會",
      "text": "#茶會是淑女的必修課。如果{F#妳}{M#你}想學習茶會禮儀的話，我可以教{F#妳}{M#你}喔！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·樂子",
      "text": "好無聊啊！沒有什麼更有趣的事嗎？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·人氣",
      "text": "唉…人氣太高也是一種苦惱，誰叫我這麼受歡迎呢？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "好大的雨！等等…水應該不會淹上來吧？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的時候…",
      "text": "哇哦！這地方很適合映影取景。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "陽光很好…",
      "text": "這陽光的熱度，都快跟我平常用的影室燈一樣了。還好太陽只有一個。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "颳大風了…",
      "text": "#「聽…風中傳來不安的低語，那是被遺忘的海獸做噩夢時的夢囈。」{F#妳}{M#你}問為什麼是做噩夢？呃…因為…恐懼感是會向外傳遞的？"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "#真是一派荒蕪的景象，讓我賜予{F#妳}{M#你}們水的恩澤吧！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "早安…需要起這麼早嗎？再多睡一會也沒關係吧…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "#午安！我的蛋糕在哪裡？什麼什麼，{F#妳}{M#你}說早上剛吃過？那已經隔了好——久啦！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#晚上好。唉，謝貝蕾妲小姐最近總是嘀咕著減肥，還說要拉我一起。哼…比起上個月，我的肚子都瘦了不止一圈呢…我已經很努力在控制體態了。喂！{F#妳}{M#你}，看得出來嗎？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "呼…正好我也想睡了。明天見，記得準時叫我起來…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於芙寧娜自己·親友團",
      "text": "#{F#妳}{M#你}問我參加茶會的這幾個小傢伙？牠們都是我忠實的追隨者。咳…今天就破例為{F#妳}{M#你}介紹一下吧！這位是謝貝蕾妲小姐，最可愛的女僕，雖然有時會不小心剪壞我的衣服；這位是海薇瑪夫人，可靠的管理人，將我的生活打理得井井有條；最後這位喜歡說教的是烏瑟勳爵，負責一切禮儀相關的事情。呵呵…雖然我已允許{F#妳}{M#你}參加我的茶會，但想要得到牠們的認可，{F#妳}{M#你}還要多多努力才行！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於芙寧娜自己·歌唱",
      "text": "我對自己的歌唱能力還是很有自信的，不過值得我開口唱誦的段落並不多。希望那些劇團裡的創作者們努力一點，不要讓我等太久。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·關係",
      "text": "#咳…以我們之間的關係，{F#妳}{M#你}在我面前無需太過恭敬，可以更隨意一點。等等…{F#妳}{M#你}那是什麼表情，該不會是想說{F#妳}{M#你}從一開始就沒有「敬仰」過我吧？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·同行",
      "text": "「我」的故事已然落幕，接下來開場的是「我們」的故事了…這麼說的話…出場費是不是也該翻倍啦？好開心哦！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "當那古老的預言終結、一切落幕之後，我曾經陷入很長時間的消沉。站在舞臺上的人受到觀眾的追捧，同時也承受著更多的注視與期待。但我很清楚，他們期待的並不是我，而是我扮演的那位「神明」…在這個過程中，我真正得到的只有孤獨。所以我一度厭惡任何跟表演有關的事，把自己關在房間裡，直到再次站上舞臺、再次面對觀眾的時候，我才發現不知不覺我內心的不安已經消失了。現在的我可以坦然承受他們的目光，也許是因為…我終於開始「扮演」我自己了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享·歌劇",
      "text": "楓丹的歌劇經歷過幾次革新，每次革新都會有許多反對的聲音。在我印象裡，經常有很多人聚在歌劇院吵來吵去，吵得我耳朵嗡嗡響。於是我嚇唬他們說：「不准再爭論這些無關緊要的問題」，那維萊特也順勢敲了一下他的手杖，歌劇院立刻就安靜了。沒辦法，我總會不經意間表露出充滿威嚴的一面，希望他們能夠理解。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞·幽光星星",
      "text": "我很喜歡幽光星星，這種生物在無人注視的地方也能發出自己的光亮，是我心目中最真實的「明星」。如果有讓幽光星星當主角的歌劇就好了，我可以真情實意地在舞臺上演繹一隻可愛的離群海星。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於林尼與琳妮特…",
      "text": "林尼與琳妮特啊…我當然知道，以前我就經常光臨他們的演出。他們的人氣雖然高，但跟我比起來還是差了不少，有我出場的演出才是真正的座無虛席，連站票都賣得乾乾淨淨。至於現在…呃…現在我已經退隱了，人氣下滑也很正常嘛！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於那維萊特…",
      "text": "我很感謝那維萊特這幾百年間為楓丹的辛苦付出，他似乎也不打算追究我欺騙民眾的罪責。反正現在我們已經不需要對接什麼工作，我也很久沒去沫芒宮了，這對我們雙方來說都是一件好事吧？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於娜維婭·甜點",
      "text": "#{F#妳}{M#你}嚐過娜維婭烤的馬卡龍嗎？不得不承認，她對甜點的造詣已經非常深厚，完全不在我之下。口感和甜度暫且不提，她畫在馬卡龍上的圖案也太可愛了吧？簡直就是藝術品！她到底是怎麼做到的，難道真的只是天賦？我的內心中竟然會產生一種挫敗感…下次一定要向她好好打聽一下！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於娜維婭·內心",
      "text": "她是一個很堅強的人。堅強的人不管發生什麼都會很快振作起來，裝作沒事的樣子，這樣身邊的人就無需背負額外的壓力。我見證過卡雷斯與克洛琳德的決鬥，娜維婭她…在這方面越來越像自己的父親了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於「僕人」…",
      "text": "「僕人」？誰…誰呀？我已經忘掉了哦，把那麼可怕的身影留在腦海中，晚上睡覺都會做噩夢的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於夏洛蒂…",
      "text": "最近經常見到夏洛蒂忙碌的身影。她好像很想找我約一期獨家專訪。哪怕我多次拒絕，她也並不放棄。我本來有點生氣的，但是她很堅定地對我說——她希望民眾能夠瞭解一個更加真實的我，也相信民眾可以理解我的苦衷。我不知道該如何回應她的好意，也許她說得有道理，但我還沒有做好準備…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於萊歐斯利…",
      "text": "我跟他交流不多，那維萊特說他值得信賴，所以我想他大概是個好人吧！哦對了，以前還收到過他寄來的茶，味道不錯。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於克洛琳德…",
      "text": "在我的印象裡，克洛琳德平時不喜歡交談。但她幾次站在我的身旁，保護我的安全，我對她非常信任。嗯…我還真有一點想念她，不過現在沒什麼去見她的理由了。對了！下次邀請她來一起開茶會吧！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於愛可菲…",
      "text": "#哦？沒想到，{F#妳}{M#你}也認識我的「甜點大校」…多虧了愛可菲，我曾在限量的「德波大蛋糕」之外，獲得過許多精彩的選擇。可惜現在的我，已經支付不起沫芒宮開給她的那種薪水啦。嗯？別擔心，我們還有保持聯絡，我還是會用親手製作的菜餚回應她的…最近我就研究了一款「香辛果魚肉凍通心粉」…有興趣嗎？下次做給{F#妳}{M#你}嚐嚐。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解芙寧娜·其一",
      "text": "#對我的事感興趣？唉，真沒辦法，畢竟我曾經也是楓丹最受矚目的大明星嘛！每天都有無數記者挖空心思想要探聽我的隱私，我可是有將他們拒之門外的豐富經驗。當然，我並不打算將這些經驗用在{F#妳}{M#你}的身上，{F#妳}{M#你}可以用足夠好吃的點心來和我交換秘密。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解芙寧娜·其二",
      "text": "#最近有人向我推薦了「衝浪」這項運動，我也去體驗了一番。在驚濤駭浪中保持平衡並不是一件容易的事情，但我很快就掌握了技巧。也許是因為我有這方面的天賦？總之，在海天相接的地方近距離地感受風與浪是一件還不錯的事情，{F#妳}{M#你}也可以試一試。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解芙寧娜·其三",
      "text": "#有空的話，多和我講講旅行的見聞吧？我滿喜歡聽{F#妳}{M#你}講那些稀奇古怪的故事。怎麼說呢…我很容易對各種事物產生興趣，但不用多久就會感到無聊。或許「熱情」這種東西，越容易產生就越容易失去。跟{F#妳}{M#你}在一起時，我似乎能一直保持愉快的心情，真不可思議。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解芙寧娜·其四",
      "text": "最近我一直在想，過去我是不是有點虧待自己了？為了保持神明的矜持，我幾乎沒有享受過生活。所以最近我迷上了購物，買了好多新奇的東西。像什麼七色炫彩茶包、全自動伸縮刀叉、海馬專用馬鞍…最後發現大部分東西都用不到，我全部送去劇團當演出道具了。奇怪，付款前我明明覺得這些很有用的…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解芙寧娜·其五",
      "text": "人們很喜歡談論過去，為那些逝去的美好感到惋惜；也很喜歡談論未來，彷彿為了縹緲的明天可以犧牲一切。我並不認同他們的做法，但也感到非常羨慕：因為我曾經生活在既沒有過去、也沒有未來的世界裡。為了應對那種恐慌，我嘗試塑造並扮演了一個更堅強、更像神明的自己，幾百年的時間過去，我曾扮演的「形象」逐漸與真實的自己融為一體。如今連我也無法分辨…或許也沒有分辨的必要了，過去的種種經歷組成了現在的我，那場並不完美的演出也是我最重要的一部分啊！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "芙寧娜的愛好…",
      "text": "《王后的榮冠》還沒有出續作嗎？真遺憾，這種正義戰勝邪惡的經典作品總是讓人百看不厭。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "芙寧娜的煩惱…",
      "text": "今晚的通心粉選什麼醬好呢…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "每個人都不會討厭精緻的糕點，但想要做到讓我「喜歡」的程度，還需要多多努力才行。聽好了，甜品就像歌劇，從「選角」到「佈景」都需要花費心思，才能在最後的「演出」中大放異彩！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "簡單來說，我討厭大部分「創意菜」。這些年我品嚐過許多奇妙的料理，除了讓我留下心理陰影外毫無用處。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "#哦？香味濃郁、口感細膩…沒想到{F#妳}{M#你}對烹飪也有研究，很有品味嘛！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "太「普通」了！哼，這種缺乏特色的料理得不到我的認可！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "#{F#妳}{M#你}平常只吃這些嗎？唉，我的通心粉分{F#妳}{M#你}一點好了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！喏…作為生日禮物，這張票給{F#妳}{M#你}。這可是《歡樂日》的頭等座哦！記得過來看。{F#妳}{M#你}問我《歡樂日》是什麼？唉…本來還想留一點驚喜的…這是我親自排練的一場歌劇，內容嘛…是很多人聚集在一起，為某個重要的人慶賀。這麼說{F#妳}{M#你}應該明白了吧？一定要來啊！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "#神之眼用起來還真是不太習慣。{F#妳}{M#你}來教教我吧？呃…差點忘了，{F#妳}{M#你}也沒用過神之眼啊！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "靠自己鍛煉得到的力量果然很充實。哼哼…多謝了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "漸入佳境！不愧是我，在任何情況下都能展現出閃耀的一面。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#沒想到{F#妳}{M#你}會對我的事這麼用心，這是否意味著{F#妳}{M#你}仍然需要我的「力量」呢？然而如今的我…或許無法給{F#妳}{M#你}足夠的回報…{F#妳}{M#你}說看重的是我「本人」？既然這樣，就讓{F#妳}{M#你}我共同出演我們的未來吧！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "為我歌頌！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "亮相啦！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "噔噔！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素戰技·其四",
      "text": "開幕。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素戰技·其五",
      "text": "光芒啊…"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素戰技·其六",
      "text": "為你獻上。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "讓世界熱鬧起來吧…"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "閃耀時刻！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "歡唱，以我之名！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "意外之喜，就像蛋糕上的王冠。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "收下吧。咳…我准許了！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "有趣的東西當然是越多越好。"
    },
    {
      "id": "410001",
      "type": 2,
