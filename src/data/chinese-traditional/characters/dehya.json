  "outfits": [
    {
      "id": 207900,
      "name": "獅與赤陽",
      "description": "迪希雅的裝扮款式。據說當獅子怒吼起來，烈日也會為之震動。雖然她已經過了相信這些故事的年紀，但這不妨礙她看著沙原上的夕陽，回憶兒時的故事和說故事的人。",
      "isDefault": true,
      "characterName": "迪希雅",
      "characterId": 10000079,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Dehya_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次見面…",
      "text": "#我叫迪希雅，就是{F#妳}{M#你}想要雇傭的那位傭兵。{F#妳}{M#你}有什麼委託？打架？護送？無論是什麼事，只要開口就行。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "閒聊·傭兵",
      "text": "#{F#妳}{M#你}問傭兵的工作原則？嗯…很簡單，誰出的錢多，就為誰辦事。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "閒聊·沙漠",
      "text": "沙漠是個難相處的對手，但至少它足夠光明磊落，把所有艱險挑戰都放在檯面上給你看。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "閒聊·我們的人",
      "text": "我們的人已經習慣了沙漠…但我還是希望他們在某天能夠告別風沙，在某處綠洲更愉快地生活。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的時候…",
      "text": "聽傭兵團裡的老人說，沙漠裡偶爾也會下雨，而且雨勢比這猛烈得多。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的時候…",
      "text": "這雷鳴聲可真大…可以掩蓋住很多聲音。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的時候…",
      "text": "呼…這裡簡直比夜晚的沙漠還冷。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "陽光很好…",
      "text": "天氣很好，要是我的工作也能輕鬆點就好囉。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "颳大風了…",
      "text": "起風了，我們去下風處紮營比較安全。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的時候…",
      "text": "跟緊我，不要亂走，沙漠可不會對任何人留情。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早安…",
      "text": "#{F#妳}{M#你}看起來精神不錯，那我們等等就拔營出發吧。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "午安…",
      "text": "已經中午了…等我找到合適的位置，就可以生火做飯了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "#這麼晚了{F#妳}{M#你}還在工作？真是比我們傭兵都辛苦啊。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "#時間不早了，今夜的值守就交給我，{F#妳}{M#你}快去休息吧。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "關於迪希雅自己·鍍金旅團",
      "text": "鍍金旅團只是一個「頭銜」，任何須彌的傭兵都可以自稱為「鍍金旅團」的一員。有些傭兵就用這頭銜來蒙混外地人。哼，拜這幫人所賜，現在「鍍金旅團」的名號已經越來越惹人厭了。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "關於迪希雅自己·老爹",
      "text": "庫塞拉…他是個吊兒啷噹，喜歡裝模作樣的傭兵。是他從沙漠裡救了我，又用盡全力，將他一切能夠給予我的東西，都給了我。\\n但正是因為他，我才能成長為現在的我。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "關於我們·偉大事蹟",
      "text": "#{F#妳}{M#你}最近可是大顯身手啊，我所在的傭兵團裡都有不少人一直在講{F#妳}{M#你}的事蹟，甚至還有幾個人來問我，能不能向{F#妳}{M#你}引薦一下他們。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "關於我們·戰友",
      "text": "朋友？嗯…我們一起經歷了那麼多事，共同闖過了那麼多場戰鬥，用「朋友」來形容我們之間的關係，總感覺有點輕飄飄的。\\n我想想…不如，用「戰友」吧，這種感情只能從並肩的戰鬥中錘煉而出，是最不可動搖的東西。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "關於「神之眼」…",
      "text": "「神之眼」給我帶來了什麼？嗯…老實說，比起戰鬥時的便利，這顆「神之眼」更大的作用，是讓更多的傭兵慕名而來加入「熾光獵獸」。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什麼想要分享…",
      "text": "#{F#妳}{M#你}知道棗椰嗎？我小時候最喜歡吃這種果子。但老爹完全不知道拆棗椰的方法，就拿著刀胡亂地戳來戳去，把裡面的果肉都弄得亂七八糟，完全沒辦法吃下肚。最後只能把果肉都刮下來，混在牛奶裡，勉強給我當做粥來吃。\\n我有時候也會懷念這種粥的味道，還有那個拆棗椰都能拆得手忙腳亂的老爹。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感興趣的見聞…",
      "text": "在一些人眼裡，啃食殘骸的赤鷲是帶來死亡與災厄的生物。但在我看來，這些翱翔在沙海之上的鷲鳥，有著最熱烈的生命力。\\n不知道當牠們從天空往下俯瞰時，大赤沙海會是一個什麼模樣。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "關於提納里…",
      "text": "#哈哈哈，{F#妳}{M#你}別說，我還真的差點和這位巡林官做成過一筆生意。之前我經人介紹，要當他進沙漠考察時的嚮導。不過後來不知道為什麼這單生意取消了，我記得…好像是這位巡林官實在太怕熱，還是其他什麼原因來著。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "關於小吉祥草王…",
      "text": "哼，我之前還以為，教令院裡頂多是有一群自私自利的鬣狗在蠅營狗苟，結果…居然還有這麼幾匹餵不熟的白眼狼在作亂。依我看，那位小吉祥草王真是有點慈悲過頭了，對付這種劣獸，最好是連骨頭都錘碎掉！就這麼放他們進森林裡歇息，真是太便宜他們了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "關於坎蒂絲…",
      "text": "#{F#妳}{M#你}說坎蒂絲啊，她什麼都好，就是個性強得和馱獸一樣。我和她說了好多次，別老是繃著弦，偶爾也要給自己放個假，比如去須彌城裡逛逛，買點漂亮衣服首飾…但她總是說不放心村子，拒絕了我好多次。唉，實在不行，下次我幫她守村子，然後再拜託團裡的女孩們帶她進城玩玩好了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "關於艾爾海森…",
      "text": "他曾經邀請我過去教令院任職，但我過不慣那種死氣沉沉的生活，就拒絕了。不過這位書記官說話時那種七拐八繞，又夾槍帶棒的腔調，倒是很符合我對教令院學者的印象…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "關於賽諾…",
      "text": "那位「大風紀官」？是個雷厲風行的狠角色，處理某些事情的方法，也滿對我胃口的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "關於妮露…",
      "text": "解決了那件事之後，妮露也能更加自由地跳舞了吧。哦她上次還說，要把自己用的香粉帶一份給我，但我經常在外面奔波，就只能請她先送去坎蒂絲那裡。唔…我也該找個時間過去看看了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "關於多莉…",
      "text": "那個商人啊。據說她那裡什麼都有得賣，只是價錢貴了點？哈哈，那我還滿希望和她見幾面的，畢竟…有些傭兵需要的東西，在市場上真是拿錢都買不到啊。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "關於萊依拉…",
      "text": "那個成天迷迷糊糊的小女生啊，我有印象。之前我在沙漠邊緣的一個綠洲碰見過她，她好像是跟著教令院的什麼隊伍來觀察星象，不過我也沒有太留意。啥？坎蒂絲…星空的使者…什麼跟什麼？亂七八糟的，這女孩該不會還沒睡醒吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "關於賽索斯…",
      "text": "我也是最近才知道他來自緘默之殿。唉呀，不好意思，我對緘默之殿這類神秘組織的瞭解很少嘛。以前是有在沙漠裡見過他幾次，他人很好，我的傭兵兄弟在沙漠遇到麻煩，他還把飲用水分給他們過。是個不錯的人。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要瞭解迪希雅·其一",
      "text": "我從小就在傭兵團裡生活，玩具是木刀木劍，認識的人要嘛是傭兵，要嘛準備做傭兵，就連吃飯的木碗都是團裡的人拿刀削出來的木碗。在這種環境下長大，要是我不做傭兵反而有點奇怪，對吧？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要瞭解迪希雅·其二",
      "text": "我是哪裡人？這我可不知道，我從來都沒想過這方面的問題。但硬要說的話，我一直生活在沙漠裡，應該算是「沙漠這邊」的人吧。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要瞭解迪希雅·其三",
      "text": "傭兵的工作可不容易，先不說接受的委託難度如何，更讓人頭痛的是完成委託後如何讓客戶迅速地結清錢款。教令院結清最爽快，冒險家協會其次，付錢最不爽快的是那些做貨物貿易的商人，他們總是說自己的資金正在周轉，暫時拿不出多少現金，要我再等等。\\n呿，拿不出錢，那他們車上那麼多貨是怎麼來的？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要瞭解迪希雅·其四",
      "text": "在之前那件事過後，教令院對於我們的態度也有了改變，據說還推出了一大堆幫助沙漠子民的條款。呃，那一大堆文件我看不太懂，我只希望「防沙壁」從今往後只隔絕風沙，不要再阻斷希望。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要瞭解迪希雅·其五",
      "text": "大部分傭兵的抱負就是揚名立萬，他們不斷地接受高難度的委託，賺取財富和名聲。有的人幸運地活下來，成為了傳奇，有些人就在沙漠裡默默無聞地消失。\\n但我可沒有那麼「遠大」的抱負，我只想要保護周圍的人，讓他們能安心地生活，這就足夠了。要是能再賺點錢，那就更好了，哈哈。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "迪希雅的愛好…",
      "text": "#我有空的時候，最喜歡打理我的「妝匣」。裡面的香粉和粉刷可都是我花大錢收購來的，{F#妳}{M#你}看看這粉質，多細膩啊！不管是流了汗，還是淋了雨，妝都不會花。哼哼，真是一分錢一分貨。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "迪希雅的煩惱…",
      "text": "又有幾筆委託的錢款沒結清，還有幾個兄弟執行委託的時候闖了禍…唉，我明明不是團裡的一把手，為什麼還要操心這種事？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜歡的食物…",
      "text": "那當然是「棗椰蜜糖」了，既容易攜帶，又很好吃。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "討厭的食物…",
      "text": "拜託別讓我吃那種味道很苦的東西，我可受不了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到贈禮·其一",
      "text": "這道菜吃起來真不錯！再多吃幾口的話，我說不定以後就吃不下那些乾糧啦。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到贈禮·其二",
      "text": "唔，如果當做乾糧來看的話，吃起來還是不錯的。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到贈禮·其三",
      "text": "至少…至少能填飽肚子，能安全填飽肚子的食物就是好食物！哈哈…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快樂！摸摸{F#妳}{M#你}的口袋，禮物已經放在裡面了。怎麼做到的？一點傭兵的小把戲罷了。先別管這些了，我在蘭巴德酒館已經訂了一桌上好的酒席，我們趕快過去吧。嗯？放心，我沒有讓團裡的其他人過來，這幫人吵吵鬧鬧的只會起哄，好不容易過個生日，我來陪{F#妳}{M#你}就夠了，走吧走吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哦？力量真的在成長。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "感覺不錯啊，這樣揮起劍來也更有力了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·轉",
      "text": "這種力量…真想立刻去試試看，不然我們兩個直接來過幾招吧？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "#沒想到我居然還能有這樣的成長，這都多虧了{F#妳}{M#你}。接下來有什麼委託嗎？無論是什麼委託，只要{F#妳}{M#你}開口，我就會和{F#妳}{M#你}同行。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素戰技·其一",
      "text": "開打吧！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素戰技·其二",
      "text": "不用留情。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素戰技·其三",
      "text": "一起上！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆發·其一",
      "text": "你撐得住嗎？"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆發·其二",
      "text": "在這，打垮你！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆發·其三",
      "text": "把牙咬緊點！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打開寶箱·其一",
      "text": "居然還有意外收穫…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打開寶箱·其二",
      "text": "哈哈哈，這個不錯啊。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打開寶箱·其三",
      "text": "也許能賣個好價錢。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "哼…有點本事！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "該動真格的了！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "這不是正好？"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "穩住！別慌張！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "退後，讓我來！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "這下…糟了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "真是…大意了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "傭兵的…宿命…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受擊·其一",
      "text": "小花招！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "受重擊·其一",
      "text": "有兩下子…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入隊伍·其一",
      "text": "#{F#妳}{M#你}說了算。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入隊伍·其二",
      "text": "有什麼委託嗎？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入隊伍·其三",
      "text": "該開始幹活了。"
    }
  ]
}