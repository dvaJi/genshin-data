  "outfits": [
    {
      "id": 203500,
      "name": "차가운 여름의 꿈",
      "description": "치치의 코스튬. 부적이 붙어있어 치치를 안심시켜주는 약초 채집용 아동복이다",
      "isDefault": true,
      "characterName": "치치",
      "characterId": 10000035,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Qiqi_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "저는 치치, 강시예요. 아… 또 무슨 말을 하려고 했지?"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·혼잣말",
      "text": "응, 방금… 무슨 말하려고 했더라…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·더위에 약함",
      "text": "시원한 곳으로 가고 싶어"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·운동",
      "text": "일곱 둘 셋 넷, 일곱 둘 셋 넷… 다섯 여섯 일곱 일곱, 다섯 여섯 일곱 일곱…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "우산 가져오는 걸 또 깜빡했네"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "눈사람 만들고 싶은데… 같이 할래요?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "오늘은 밖에 나오면 안 됐는데"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "시원해서 기분 좋아"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "손 꽉 잡아…! 나, 날아가겠어…!"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "아침인가요? 오늘 할 일은… 메모 좀 봐야겠어요"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "…백 선생님의 약재를 분류하는 걸 깜박했어요"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "저녁이네. 오늘… 내가 뭘 했더라…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "먼저 가서 쉬세요. 전 유연 체조를 좀 해야겠어요. …훔쳐보면 안 돼요"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "치치 자신에 대해…",
      "text": "저한테 묻는 거예요…? 죄송해요, 기억이 잘 안 나요…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·기억력",
      "text": "기억 못하는 일이 많지만… 그렇다고 별로 나쁠 건 없어요"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·기억력 훈련",
      "text": "요새 기억력 훈련을 열심히 했거든요. 그러니 당신은 안 잊어버릴 거예요"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」은 시간을 멈출 수 없지만, 소중한 사람들을 지킬 힘을 줬어요"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "사실 제 몸 상태가 백 선생님보다 훨씬 좋아요…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "약재 오두막 근처에서 참새떼를 자주 볼 수 있어요. 엄청 작아요"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "백출에 대해…",
      "text": "백 선생님의 얼굴이 떠오르지 않지만, 별로 상관없어요…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "호두에 대해…",
      "text": "뜨거움, 가식적인 웃음… 죽음… 싫어"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "소에 대해·이름",
      "text": "음, 무슨 골동품 같은데…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "소에 대해·기억",
      "text": "치치가 그 사람을 만난 적이 있었나요…?"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "신염에 대해…",
      "text": "…누구지?"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "요요에 대해…",
      "text": "귀여워, 작은 참새 같아요"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "명이에 대해…",
      "text": "저녁에… 가끔 누가 치치랑 같이 체조를 하는 것 같은데… 착각인 걸까요?"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "프루네에 대해…",
      "text": "겉으론 딱딱해 보이지만… 손바닥이 부드러운 사람이에요. 좋아요"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "치치에 대해 알기·첫 번째",
      "text": "무슨 일이에요?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "치치에 대해 알기·두 번째",
      "text": "유연 체조를 하면 인간과 같은 몸 상태를 유지할 수 있어요. 하지만 안 하면 바로 돌아와요…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "치치에 대해 알기·세 번째",
      "text": "어떤 사람은 절 이용하려 하고, 어떤 사람은 절 무서워해요. 근데 당신은… 그들과 달라요"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "치치에 대해 알기·네 번째",
      "text": "처음 봤을 때부터 당신은 따듯한 느낌이었어요. 사람을 불편하게 만드는 뜨거움이 아니라 마음이 따듯해지는 느낌이에요. 고마워요… 정말 기뻐요. 단지 지금의 당신만 기억할 수 있어서 아쉬워요. 만약 치치가 당신을 잊는다면… 저흰… 아니, 당신을 기억하라고 저한테 「명령」할게요"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "치치에 대해 알기·다섯 번째",
      "text": "예전엔 아무 이유 없이 그냥 살아가려고 했어요. …하지만 이제는 알 것 같아요. 앞으론 당신과 함께 살아가고 싶어요. 당, 당신과… 영원히 함께해도 될까요? 정말요? 네! 치치가 당신을 지켜줄게요!"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "치치의 취미…",
      "text": "애완동물이 있었으면 좋겠어요… 작은 참새 같은 거요"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "치치의 고민…",
      "text": "잘 모르겠어요. 근데 온도가 높으면 몸이 괴로워요…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "전 코코넛 우유가 좋아요. 그런데… 맛은 안 느껴져요"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "죄송해요, 모르겠어요…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "차가워서 맘에 들어요. 아무 맛도 안 나지만…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "음…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "조금 뜨거워요…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해요. 자, 약초 향낭이에요. 놀랐죠? 저번에 알려줬을 때 종이에 적어놨어요. 매일 한 번씩 보면 앞으로도 안 까먹을 거예요…"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "아, 강해진 건가…? 강해진다는 게 뭐지?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "아, 알겠어요. 강해지면 힘을 제어하는 데 더 많은 에너지가 필요하군요"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "예전엔 더 강해진다는 의미를 잘 몰랐는데, 지금은… 더욱더 강해지고 싶어요"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "이 모든 건 다 당신 덕분이에요. 고마워요…제 소원 하나만 들어줄래요? 이제부턴 제가 당신을 지키게 해줘요"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "끝없는 순환"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "끝없는 번성"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "가라"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "일어나"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "지령 접수, 지령 수행"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "본명, 도액진군"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "옥첨, 선법개갑"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "더 빨리 가 볼까?"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "어?"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "예뻐"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "보물상자는… 어디에 쓰는 거지?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "안에는, 뭐가 들었지? 기억이 안 나…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "아파"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "아——"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "살아남아야 해…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "위험해요"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "저에게 맡기세요"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "또… 봉인 당하는 건가…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "추워…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "싫어…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "아무 느낌 없어…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "이럴 수가…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "이런…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "…저 왔어요"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "무슨 일이에요?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "노트도… 챙겨왔어요"
    }
  ]
}