  "outfits": [
    {
      "id": 214300,
      "name": "봄과 겨울",
      "description": "베스나의 코스튬. 겨울군 제복의 기본 디자인을 바탕으로 베스나가 직접 조금 손을 봤다. 멋진 건 사실이지만, 비싼 것도 사실이라 베스나가 올린 겨울군 전체 제복 교체 신청은 아직까지도 승인되지 않았다",
      "isDefault": true,
      "characterName": "베스나",
      "characterId": 10000143,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Vesna_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "안녕, 친구. 난 겨울군 사령관 베스나야. 잘 부탁할게. 예포와 의장대는 이미 준비를 마쳤어. 언제든 너를 위한 환영 연주를 들려줄 수 있지. 물론 요란한 걸 별로 좋아하지 않는다면, 좀 더 사적인 환영식도 준비해 뒀어. 어서 따라와~"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·협력",
      "text": "겨울군은 오직 여왕 폐하의 명령만 따르니까, 아무한테나 함부로 힘을 빌려줄 순 없지. 하지만 바람 요정 베스나는 가능해, 친구"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·즐거움",
      "text": "이 의상 예쁘지? 폐하께서 직접 하사하신 거야. 조금 더 봐도 돼"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·높은 효율",
      "text": "문서 작업? 진작 끝냈지. 오래 걸릴 일도 아니었고. 이제부터는 순찰 시간이야. 가자~"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "요정도 당연히 감기에 걸려. 젖으면 얼른 펄럭여서 말려야 해. 아, 날개 말이야"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "새하얀 눈밭에서 위장할 때 아주 작은 빈틈도 치명적일 수 있어. 발밑 조심해, 친구"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "알아, 알아. 햇빛 아래선 역시 내 날개가 제일 반짝이지"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "좋네. 바람 요정이 좋아하는 날씨야"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "그냥 물어보는 건데… 우리 스네즈나야엔 언제 돌아가?"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "새로운 하루! 안녕, 스네즈나야성!"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "가자, 옛뜰 식당으로! 물론 이번에도 내가 살게"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "코롤료프스키 극단에 새로운 공연이 올라왔어. 보댜니차 수석의 고음, 오데트의 춤사위… 그리고 몇몇 「새로운 친구」들도 있지"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "쉬잇, 쉬잇… 벌써 자려고? 산책하러 나갈래? 오로라가 떴어!"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "베스나 자신에 대해·「마법 무기」",
      "text": "내 주변을 날아다니는 「작은 녀석들」 봤어? 내가 만든 「마법 무기」야. 하나하나 다 원소력과 내 의식을 뒤섞어 만들어진 거라, 내 성격을 조금 닮았어. 그래서 널 붙잡고 같이 놀자고 조를 수도 있는데, 너무 신경 쓰진 마. 물론 가능하다면 거절하지도 말아 줬으면 좋겠지만? 헤헤!"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "베스나 자신에 대해·사령관",
      "text": "사령관의 「위엄」이라… 풋. 그런 건 분위기를 휘어잡지 못하는 사람들에게나 필요한 거야. 나한텐 필요 없어~ 이 점은 우리 둘 다 똑같지?"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·확인",
      "text": "알아, 알고말고. 넌 분명 나에 관한 소문 중 확인하고 싶은 게 잔뜩 있을 거야. 괜찮아. 시간은 많으니까. 대신 조건으로, 나도 너에 관한 모든 걸 하나하나 「확인」해 볼 거야"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·동행",
      "text": "난 「누군가의 곁을 지키며 걷는다」는 표현이 영 낯설어. 낭만적으로 들려도 가만히 생각해 보면… 한쪽을 주인공으로, 다른 한쪽을 들러리로 만드는 느낌이잖아.\\n하지만 걷는 건 내 두 발이고, 그 길에서 얻는 경험과 수확도 오롯이 내 몫인걸. 그러니까 난 「네 곁에 있어 줄게」 대신, 「너와 함께」 걸을 수 있어 기쁘다고 할래. 걷다가 문득 고개를 돌려보니… 하하, 참 우연이네! 마침 가는 길이 똑같잖아! 하는 기분으로 말이야"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「별의 쐐기」에 대해…",
      "text": "「별의 쐐기」는 모양이 정말 예뻐서 소장 가치가 높아. 그러고 보니 「달의 륜」도 꽤 괜찮더라, 나는 줄곧 끌렸어. 「신의 눈」은… 당분간 생각 없지만"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "내 손에 들린 이 「오랜 친구」 말이야? 예쁘지! 가문 대대로 전해져 내려온 거야. 나보다 훨씬, 훨씬 나이가 많지. 전당급 골동품이라고 해도 과언이 아니야. 어떨 때는 마법 지팡이로, 어떨 때는 회초리로, 또 어떨 때는 지휘봉으로 쓰고 있어… 어머, 은행 금고에 꽁꽁 넣어 두고 먼지만 쌓이게 하는 것보다, 이 나이에도 제 몫을 하게 해 주는 편이 조상님들도 칭찬해 주고 싶어 하지 않겠어?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "눈서리꽃은 아름답고도 강인해서, 혹독한 추위 속에서도 살아남을 수 있어. 무늬도 아주 독특하지. 난 눈을 반쯤 감고 고개를 흔들면서 그 꽃을 바라보는 걸 좋아해. 그러면 눈앞의 풍경이 만화경처럼 변해서 정말 몽환적이거든. 다만 이건 주변에 아무도 없을 때 시도하는 게 좋을 거야"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "「여왕」 폐하에 대해·충성",
      "text": "나는 제 잘난 맛에 빠져 폐하께 반기를 들려던 녀석들을 수도 없이 체포했어. 그 사람들이 입에 담던 원대한 포부니 대업이니 하는 것들은 전부 겉만 번지르르한 허세에 불과했지. 거사를 일으킬 계책도, 일을 성사시킬 능력도 없었어. 그런 이른바 야심가들과 비교하면… 아니, 이 말은 취소할게. 그 사람들은 폐하와 나란히 언급될 자격조차 없으니까.\\n간단히 말해서, 폐하께 충성을 바치는 건 바람 요정 일족의 책무이자, 내 개인의 선택이기도 해"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "「여왕」 폐하에 대해·자애",
      "text": "폐하께서 말씀하시는 「자애」엔 언제나 얼음 가시가 돋쳐 있어. 그건 천리가 신에게 강요한 저주일 뿐, 진정한 사랑은 아니라고 하셨지. 하지만 난 좀 다르게 생각해. 마수 토벌에서 돌아오면, 폐하께선 늘 명령서 끝에 「충분히 휴식을 취하도록」이라고 덧붙여 주셨거든. 생명의 집정관 능력이 회수된 후에도, 나름 꽁꽁 숨겼던 내 상실감을 헤아려 주시곤 미처 회수되지 않은 부분을 내게 돌려주셨지…\\n폐하의 신분으론 굳이 안 하셔도 될 일이었는데 말이야. 불경한 소리일지 몰라도, 난 신에게 「사랑」이 있는지는 전적으로 백성이 판단할 몫이라고 생각해! 그러니까 내 말도 맞는 거겠지?"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "다니카에 대해·어린 시절",
      "text": "우리 사랑스러운 다니카, 지금은 엄청 진지하고 어른스러워 보이지? 어릴 땐 나랑 같이 「스승님의 가면 벗기기」 같은 작전을 꾸미던 장난꾸러기였다니까. 심지어 스승님 어깨 위까지 올라갔다고! 비록 실패해서 얼음 호수에서 한참이나 벌을 섰지만… 아, 이런 창피한 얘기가 중요한 게 아니잖아! 중요한 건 그 기발한 작전을 먼저 꺼낸 게 다니카라는 거지. 노는 걸로 치면 걔도 나한테 절대 안 밀린다니까? 그런데 이제 와서 매일 날 꼬맹이 보듯 한심하게 쳐다보다니. 참 나, 내가 언니거든?"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "다니카에 대해·말다툼",
      "text": "믿을 만한 정보에 따르면, 용의자가 「말싸움 대회」라는 황당한 이벤트를 미끼로 사람들이 소란스러운 틈을 타 불법 거래를 완료하려 한대… 이건 내가 나서야겠어.\\n그래서 다니카를 대신 참가시켜 뒀지. 걔가 또 「정색하고 팩폭하기, 뼈 때리기」 장인이잖아? 말싸움으로 걜 이길 사람이 어딨겠어? 분명 시간을 제대로 벌어줄 거야.\\n파이팅, 다니카!"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "「카피타노」에 대해…",
      "text": "내 기억 속 스승님의 뒷모습은 늘 넓고 든든한, 묵직한 산 같았어. 언젠가 그 산이 무너질 거라곤, 적어도… 이렇게 빠를 줄은 몰랐어… 「진정한 전장에선 고별의 기회 따윈 없다」니, 그걸 몸소 증명하실 필요는 없었잖아. 내게 마지막 기회조차… 남겨주지 않으셨어.\\n정말 너무해, 스승님"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "「피에로」에 대해…",
      "text": "세상엔 내일을 기대하며 가뿐히 걷는 이들도 있지만, 피에로 님의 발걸음은 늘 묵직해. 난 종종 그분이 스승님과 닮았다고 느껴. 두 사람 다 상상하기 힘든 슬픔을 가면 뒤에 감추고, 뼈아픈 과거를 온전히 짊어지고 있어서일 거야"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "「풀치넬라」에 대해…",
      "text": "스네즈나야성 평의회에서 당당히 발언하시는 시장님의 그 넘치는 여유, 정말 위풍당당해 보여"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "「판탈로네」에 대해…",
      "text": "겨울군 사령관 월급이 적은 건 아니지만, 소장품도 맘껏 사고 밥도 쏘기엔 살짝 빠듯하긴 해… 아아, 오해하지 말고 끝까지 들어봐! 어릴 적부터 가문의 「여윳돈」을 북국은행에서 관리해 왔는데, 판탈로네 씨 덕분에 지금은 수익이 어마어마하게 불어났거든. 그러니까 난 전혀 부담 안 되니까 사양하지 마. 다음에도 내가 쏠게!"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "「산드로네」에 대해…",
      "text": "산드로네 님의 행동거지는 완벽한 숙녀의 기준에 부합하지만, 말투엔 엄청난 「공격성」이 묻어나. 게다가 논리도 빈틈없이 완벽하지… 정말 재밌어. 히히, 나도 잘 배워둬야지"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "미탸에 대해…",
      "text": "미탸는 나랑 늘 같이 노는 단짝이야. 매번 기가 막히게 군수궁을 빠져나오거든. 우리 셋이 뭉치면 진짜 신나게 놀아! 웬 셋이냐고? 나, 미탸, 그리고 그의 똑똑한 머플러 말이야"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "보댜니차에 대해…",
      "text": "보댜니차 씨의 노래는 전부 다 좋아. 난 현장에서 라이브로 듣는 걸 엄청 즐기거든. 다른 관객들처럼 나도 그 노랫소리에 울고 웃곤 하지. 가끔 공연이 끝난 뒤에 다 같이 남아서 떼창을 하기도 하는데, 마침 내 손에 지휘봉이 딱 있잖아? 더 기막힌 건, 사람들 틈에 몰래 섞인 보댜니차 씨를 몇 번이나 발견했다는 거야. 사복 차림에 모자를 푹 눌러쓰고 사람들을 위해 화성을 넣고 있더라니까"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "오데트에 대해…",
      "text": "솔직히 오데트가 조례에 참석할 때마다 자꾸 눈길이 간단 말이지. 우인단의 일원이기도 하지만, 신경 쓰일 수밖에 없는 「특별한」 신분이 또 있잖아… 당연히 코롤료프스키 극단 수석 발레리나 말이야. 아니면 뭐겠어?"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "알료샤에 대해…",
      "text": "이해해. 「포효」하는 광풍 속에서 예쁜 나비 쫓기를 마다할 강아지가 어딨겠어? 으으… 다니카의 아침밥을 슬쩍해서 투가린에게 주고, 알료샤한테 말 좀 잘해달라고 부탁해야겠어. 제발 만나자마자 날 쫓아다니지 좀 말라고…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "베스나에 대해 알기·첫 번째",
      "text": "히히, 날 어떻게 알아갈래? 설마 그냥 수다만 떨 건 아니지? 그건 시시하잖아… 「진실 게임」 같은 건 어때?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "베스나에 대해 알기·두 번째",
      "text": "겨울군은 여왕 폐하 직속 친위 부대야. 마수 토벌이나 참전 같은 군무만 하는 게 아니지. 여왕 폐하의 권위와 명예가 걸린 일이라면 무조건 명을 받들어 앞길의 모든 장애물을 싹 치워드려야 하거든.\\n하지만 천리에 맞서는 위대한 업적이 일단락되기 전까지는 폐하께서도 눈코 뜰 새 없이 바쁘시잖아. 그래서 개막식 테이프 커팅이나 만찬 참석 같은 좋은 일… 크흠! 기타 이런 자잘한 일들은 내가 아주 기꺼이 맡고 있지"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "베스나에 대해 알기·세 번째",
      "text": "내 소장품은 엄청 많아. 보석, 고서, 유화… 날 즐겁게 하는 물건이라면 뭐든 소장할 가치가 있지. 게다가 난 무조건 바로 손에 넣어야 해! 단 1초의 시간도 기다리기 싫거든. 「점심때가 되어야 숟가락이 귀한 줄 안다」는 말도 있잖아. 딱 꽂힌 그 순간을 놓치고 나중에 얻어봤자 다 김새버린다니까. 그러니까 지금 원하면, 지금 당장 가져야 해"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "베스나에 대해 알기·네 번째",
      "text": "모노마흐 왕이 전사한 후, 스네즈나야는 한동안 격동의 시기를 겪었지. 우리 선조들은 그때부터 굳건히 여왕 폐하의 편에 섰어. 우리의 영광은 단 한 번도 꺾인 적이 없지——그렇다면, 선조들의 어깨 위에 선 나는 과연 청출어람의 실력을 갖췄을까? 후훗, 네 마음속 의문을 내가 대신 말해버렸네. 그래, 과연 어떨까? 이제는 네가 내 마음속 답을 말해줄 차례야. 자, 어서~"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "베스나에 대해 알기·다섯 번째",
      "text": "죽음의 집정관에 맞서기 전날, 난 수많은 사람의 「생명의 인장」을 추출했어. 사람마다 아름다운 기억의 모습은 제각각이더라. 가족과 벽난로 곁에 둘러앉아 도란도란 잡담을 나누던 시간, 홀로 기차 창가에 앉아 밤하늘을 고요히 흐르는 오로라를 바라보던 순간, 그저 썰매를 끌고 얼음낚시를 가는 것만으로도 행복해하던 사람…\\n그 기억들은 마치 오색찬란한 비눗방울 같았어. 뜨겁고도 생생한 「생명력」을 품고 있어서 나도 모르게 감탄이 나왔지. ——아, 살아있다는 건 참 좋은 거구나!\\n하지만 이른바 하늘 위의 존재라는 것들은 그 비눗방울들을 너무나도 쉽게 터뜨려버리지. 일말의 설명조차 없이 말이야. 대체 무슨 권리로?\\n그때부터였어. 내게 천리에 맞선다는 건, 더 이상 단순히 폐하를 보좌하기 위함만이 아니게 된 거야"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "베스나의 취미…",
      "text": "어릴 땐 그림, 무용, 성악을, 좀 커서는 펜싱이랑 승마를 배웠어… 요즘은 오페라나 공연 관람, 소소한 수집에 푹 빠졌지… 아무튼 내 삶에 「지루함」이란 없어"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "베스나의 고민…",
      "text": "다니카가 하는 말은 믿지 마. 내 운전 실력 진짜 괜찮거든? 완전 열차랑 한 몸이라니까. 운전 금지령이 풀리면 내가 드라이브 시켜줄게!"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "이렇게 추운 날에는 다 같이 둘러앉아 뜨끈한 스튜를 먹는 것만큼 기분 좋은 일이 없지! 이렇게 하자, 내가 사람들을 모을 테니 너랑 페이몬은 아무 식자재나 적당히 챙겨 와~"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "히히! 먹기 싫은 야채는 다 다니카 접시로! 히잉——다시 돌아왔잖아…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "그럼 사양하지 않을게. 맛있는 건 전부 뱃속에 저장할래"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "음음… 창작 요리인가… 음음… 한 입만 더 먹어 볼게"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "배불러, 고마워! 이건 포장해서 다니카한테 줄게~"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "짜자잔, 시간 다 됐어! 어제 이 말을 참느라 얼마나 혼났는지 알아? 축복의 말을 미리 꺼냈다간 눈보라에 삼켜져 버리거든! 이제야 속 시원하게 말할 수 있겠네——생일 축하해, 내 친구. 자작나무처럼 굳세게, 어떤 눈보라도 거뜬히 이겨내길 바랄게.\\n자, 그럼 풍습대로 생일 주인공의 귀를 살짝 몇 번 잡아당겨 볼까——"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "신병 훈련 제1수칙: 모진 바람과 눈보라에도 꺾이지 않는 자만이 폐하 곁의 호위병이 될 자격이 있다"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "신병 훈련 제2수칙: 검을 쥔 손은 떨어서는 안 된다"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "신병 훈련 제3수칙: 적 앞에서 울어서는 안 된다"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "그리고 소중한 내 친구, 넌 내게 또 다른 걸 알려줬어: 작은 온기를 남겨, 눈바람이 멎은 뒤 기꺼이 검을 뽑아 수호할 이들을 품어주는 법을"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "정렬"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "경례"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "거검"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "비켜~"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "아직 안 끝났어"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "경의를 표할게"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "내가 상대해 줄게!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "조준——도망칠 수 없어!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "여왕 폐하를 위하여——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "후후, 새 소장품 입고!"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "너 하나, 나 하나, 폐하 하나, 나 하나. 다 나눴다! 다니카 몫은 없어"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "여기야, 여기. 여기 봐!"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "사령관은 당연히 전장에 남아야지"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "걱정 마, 피하면 되니까"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "콜록… 일시적인 열세일 뿐이야…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "철수! 여기부턴 겨울군이 맡는다"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "무리하지 마, 친구"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "이젠 날아오를 수가 없어…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "여왕 폐하께… 영원히 충성을…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "아프진 않아… 그저 분할 뿐이야…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "뭐지?"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "일반 피격·두 번째",
      "text": "하?"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "감히!"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "무례하네!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "순찰 시간이다~"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "어디 보자, 뭐 재밌는 거 없나?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "그럼 명령만 기다리면 되는 거지?"
    }
  ]
}