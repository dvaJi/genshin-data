  "passives": [
    {
      "id": "fourcausal_correction",
      "name": "4원인 시정",
      "description": "알하이탐의 강공격 또는 낙하 공격이 적에게 명중 시, 빛조각 1개를 생성한다. 해당 효과는 12초마다 최대 1회 발동된다",
      "level": 1
    },
    {
      "id": "mysteries_laid_bare",
      "name": "밝혀진 비밀",
      "description": "알하이탐의 원소 마스터리 1pt당 투사 피해와 <span style=\"color:#FFD780FF\">특수 영역·현상의 족쇄</span>가 주는 피해가 0.1% 증가한다.<br/>해당 방식으로 투사와 특수 영역·현상의 족쇄 피해는 최대 100%까지 증가한다",
      "level": 4
    },
    {
      "id": "law_of_reductive_overdetermination",
      "name": "과잉 결정 환원법",
      "description": "무기 돌파 소재 합성 시 10%의 확률로 생산량의 2배를 획득한다",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 781,
      "id": "intuition",
      "name": "직관",
      "description": "투사 공격이 적에게 명중 시 <span style=\"color:#FFD780FF\">보편성·이데아 모사</span>의 재사용 대기시간이 1.2초 감소한다. 해당 효과는 1초마다 최대 1회 발동된다",
      "level": 1
    },
    {
      "_id": 782,
      "id": "debate",
      "name": "논증",
      "description": "알하이탐이 빛조각을 생성 시, 1개당 알하이탐의 원소 마스터리가 50pt 증가한다. 지속 시간: 8초. 최대 중첩수: 4회. 스택마다 지속 시간은 독립적으로 계산된다. 빛조각 수량이 상한에 도달해도 해당 효과는 발동된다",
      "level": 2
    },
    {
      "_id": 783,
      "id": "negation",
      "name": "반례",
      "description": "<span style=\"color:#FFD780FF\">보편성·이데아 모사</span>의 스킬 레벨+3<br/>최대 Lv.15까지 상승",
      "level": 3
    },
    {
      "_id": 784,
      "id": "elucidation",
      "name": "해명",
      "description": "<span style=\"color:#FFD780FF\">특수 영역·현상의 족쇄</span> 발동 시, 이번에 소모 및 생성된 빛조각의 수에 따라 다음 효과가 발동한다:<br/>·소모된 빛조각 1개당 파티 내 주변 다른 캐릭터의 원소 마스터리가 30pt 증가한다. 지속 시간: 15초.<br/>·생성된 빛조각 1개당 알하이탐은 <span style=\"color:#99FF88FF\">풀 원소 피해 보너스</span>를 10% 획득한다. 지속 시간: 15초.<br/><br/>해당 효과 지속 시간 동안 중복으로 특수 영역·현상의 족쇄 발동 시, 기존 효과가 먼저 사라진다",
      "level": 4
    },
    {
      "_id": 785,
      "id": "sagacity",
      "name": "현명",
      "description": "<span style=\"color:#FFD780FF\">특수 영역·현상의 족쇄</span>의 스킬 레벨+3<br/>최대 Lv.15까지 상승",
      "level": 5
    },
    {
      "_id": 786,
      "id": "structuration",
      "name": "정리",
      "description": "알하이탐이 아래의 효과를 획득한다:<br/>·<span style=\"color:#FFD780FF\">특수 영역·현상의 족쇄</span> 발동 2초 후, 소모한 빛조각의 개수는 무시하고, 고정으로 빛조각 3개를 생성한다.<br/>·알하이탐이 빛조각 생성 시, 빛조각의 수가 이미 상한에 도달했으면, 알하이탐의 치명타 확률이 10%, 치명타 피해가 70% 증가한다. 지속 시간: 6초. 지속 시간 동안 해당 효과가 중복 발동 시, 남은 지속 시간이 6초 증가한다",
      "level": 6
    }
