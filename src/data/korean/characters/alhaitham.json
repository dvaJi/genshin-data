  "outfits": [
    {
      "id": 207800,
      "name": "합리주의자",
      "description": "알하이탐의 코스튬. 「별거 아닌 일로 서기관님을 귀찮게 하지 마세요. 그런 일을 피하고자 헤드폰을 끼고 계신 거니까요」\n——침묵의 신전 직원의 경험담",
      "isDefault": true,
      "characterName": "알하이탐",
      "characterId": 10000078,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Alhatham_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "난 아카데미아의 서기관 알하이탐이야. 문서를 조회하고 싶으면, 규정된 양식에 따라 작성한 신청서를 제출하면 돼. 아직 다 못 썼다고?\\n괜찮아. 내 업무 시간은 사무실 문밖에 붙여뒀으니까 다음 근무일에 다시 오면 돼"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·일",
      "text": "내가 서기관이 된 이유는 업무가 아주 간단하기 때문이야"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·독서",
      "text": "독서를 한다고 똑똑해지진 않지. 아카데미아 녀석들을 보면 알 수 있잖아?"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·생각",
      "text": "음… 요즘 쓸데없는 신청서가 너무 많군. 전부 기각해야겠어"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "비 오는 날 외출은 정말 귀찮아"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "자연 현상일 뿐이니 무서워할 것 없어. 아, 큰 나무 아래에서 비를 피하는 게 아니라면 말이지"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "춥다고? 난 버틸만해"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "오늘처럼 화창한 날에는 아무것도 하고 싶지 않군"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "이런, 신발 안에 모래가 들어갔어…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "아직 시간이 이른데, 가서 커피나 한잔해야겠어"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "볼일이 없으면, 방음 헤드폰을 끼고 눈 좀 붙일게"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "지금부터는 개인 시간이야. 다음에 봐"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "룸메이트가 한밤중에 시끄럽게 모형을 만들지 않았으면 좋겠어…. 아니, 집에 없으면 더 좋겠군. 자면서까지 헤드폰을 끼고 싶진 않거든"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "알하이탐 자신에 대해·사실",
      "text": "난 그럴듯한 수식어로 포장하는 것보단 사실만 말하는 걸 더 선호해"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "알하이탐 자신에 대해·소문",
      "text": "음? 내 성격에 대한 소문을 들었고 신경 쓰인다고?\\n네가 어떻게 생각하든 내 알 바 아니야. 문제만 일으키지 않는다면 됐어"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·인사",
      "text": "난 평소에 헤드폰 방음 기능을 켜고 다니니까, 길거리에서 인사할 때 아무런 반응이 없어도 너무 개의치 마"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·도움",
      "text": "넌 생활력이 뛰어난 데다 주변 동료들까지 챙겨 주잖아. 딱히 내가 충고할 건 없어. 물론 너도 내 도움이 필요하지 않을 거고"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "풀 원소 「신의 눈」은 연구에 딱히 도움이 되지 않지만, 원소의 힘을 갖게 된 뒤로 사람을 더 세게 때릴 수 있었지. 그래서 그런대로 쓸만한 것 같아"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "진리는 누구에게 봉사하기 위해 탄생한 것이 아니야. 인간은 지식의 매개체가 아니고, 지식 역시 인간의 목적이 아니지"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "이 세상에는 사람을 현혹하는 것이 많으니까, 자신의 눈을 너무 믿지 않는 게 좋아. 보이는 것이 다 진실이라면 생각이라는 게 필요 없겠지"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "작은 쿠사나리 화신에 대해…",
      "text": "신을 지나치게 얕보거나 경외할 필요 없어. 신에겐 신도가 필요하고, 신 또한 먹이사슬의 일부니까. 그래서 난 신을 구하는 일에 동참했다고 자부심을 느끼진 않아. 마찬가지로 작은 쿠사나리 화신도 날 크게 신경 쓰지 않았으면 좋겠어"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "카베에 대해·배려…",
      "text": "카베는 남을 지나치게 배려해. 성격이 너무 나약해서 그런가, 호들갑도 심하지"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "카베에 대해·사기…",
      "text": "카베는 자칭 자선 판매 노점에서 열쇠고리 열몇 개를 사 왔어. 열쇠고리 매출은 굶주리는 아이를 위해 사용된다나 뭐라나.\\n의료 서비스조차 무료로 제공하는 수메르에서…. 그만 말하자"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "타이나리에 대해…",
      "text": "사람들은 타이나리 성격이 안 좋다고들 하던데, 그건 너무 편협한 생각이야. 예전에 카베가 죽음의 땅에 집을 짓는 바람에 큰 말썽을 일으켰거든. 숲의 순찰대에도 적잖은 폐를 끼쳤지.\\n하지만 그 숲의 순찰관은 카베를 원망하기는커녕, 집에 초대해서 식사까지 대접했어…. 그렇게 착한 사람들이 있으니까 카베가 지금까지 살아남을 수 있었던 거겠지"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "도리에 대해…",
      "text": "영리하고 경각심이 강한 사람이야. 꿈을 현실로 이루어내고, 삶을 잘 꾸려나갈 줄 아는 똑똑한 사람이지. 두둔하려는 건 아냐, 입장이 달라도 삶에 대한 그녀의 태도만큼은 인정해"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "사이노에 대해…",
      "text": "「집단의식」 사건 때문에 풍기관의 업무량이 늘긴 했지만, 근본 원인은 나한테 있는 게 아니니까 양심의 가책을 느끼지는 않아. 사이노도 현명한 사람이라 그 일로 따지러 온 적 없지"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "닐루에 대해…",
      "text": "예술가는 장단점이 뚜렷한 직업이야. 닐루는 장점을 아주 잘 살려서 단순하면서도 행복한 삶을 살고 있지"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "데히야에 대해…",
      "text": "데히야가 도금 여단에 있는 건 재능 낭비야. 내 제안을 받고 아카데미아에 오면 우리 업무도 훨씬 편해질 텐데. 물론 안정적인 삶에 흥미를 느끼지 못하는 마음은 이해가 가. 어찌 됐든 아쉽게 됐어"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "알하이탐에 대해 알기·첫 번째",
      "text": "대부분 사람들은 내게 자발적으로 다가오지 않아. 날 두려워하는 걸 수도, 성격이 안 맞는 걸 수도 있겠지. 어쨌든 난 이런 상황에 정말 만족해"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "알하이탐에 대해 알기·두 번째",
      "text": "사교에는 전혀 관심 없어. 너도 알다시피 난 대부분 사람들보다 편안하게 지내고 있지. 사교가 삶의 필수가 아니라는 사실이 증명된 셈이야"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "알하이탐에 대해 알기·세 번째",
      "text": "사람은 자기주장을 견지하면서 깨어있어야 해. 안 그러면 이런저런 돌발상황이 발생할 때 휩쓸리거나 그릇된 길에 빠질 수 있지"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "알하이탐에 대해 알기·네 번째",
      "text": "질서가 무너지는 순간 여파는 신속하게 퍼지기 마련이지. 난 그런 상황이 싫어. 지금의 삶을 방해하잖아"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "알하이탐에 대해 알기·다섯 번째",
      "text": "퇴근하면 종종 술집에 들러 한잔하는 편이야.\\n그런 걸 알고 싶은 게 아니라고? 음, 난 여가를 공유하는 게 개인 관점을 공유하는 것보다 더 사적인 일이라고 생각하는데. 관점은 누구든 게시판에 당당하게 적고 다니잖아"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "알하이탐의 취미…",
      "text": "난해한 책을 읽으면서 골치 아파하는 사람을 구경하는 게 내 취미지.\\n농담이야. 난 타인의 고통으로 즐거움을 느끼지도 않을뿐더러, 내게 난해한 책이란 거의 없거든"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "알하이탐의 고민…",
      "text": "내 관찰에 따르면, 고민은 대부분 자초한 거야. 살면서 수많은 고민이 쌓일 텐데 스스로 더 추가할 필요는 없지"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "외형보단 맛이 중요하지. 간단한 요구잖아? 본말이 전도돼서는 안 돼"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "수프나 국물이 있는 요리는 독서하면서 먹기 힘들어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "음, 조미료 배합 비율이 완벽하군"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "요즘 유행하는 맛이야. 나쁘지는 않군"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "여기서 먹고 싶지는 않은데, 포장해 가도 될까?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해. 난 사람들이 생일에 너무 과한 열정을 쏟아붓고 있다고 생각해. 그 열정을 일상에 나눠서 사용하는 게 더 합리적일 텐데. 그 점에 있어서 넌 합격이야.\\n선물로 뭘 줄지 모르겠으니, 신청서 1회 프리패스 특권을 줄게"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "고마워"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "일회성이 아니었군"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "내가 강해졌는데, 어째 네가 더 기뻐하고 있군"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "아카데미아의 게으른 녀석들한테 내가 발전하고 있다는 걸 들키면 안 돼. 녀석들이 알게 된다면 갖은 수단을 써서 성가신 일을 나한테 떠넘길 거야. 물론, 들어주지 않겠지만 요청을 받는 것만으로도 시간 낭비니까"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "잘 받아"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "플리커"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "흥"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "스캐터링"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "스펙트로"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "이론 시뮬레이션"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "네가 잘 챙겨둬"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "보물이 굴러갈지도 모르니까, 어서 서둘러"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "오"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "성가시군"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "계획에 차질이 생겼어"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "좀 지체되겠는걸"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내가 해볼게"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "예상대로군"
    },
    {
      "id": "500001",
      "type": 2,
