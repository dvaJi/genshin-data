  "outfits": [
    {
      "id": 203701,
      "name": "흑옥에 핀 꽃",
      "description": "가벼우면서도 우아한 축제 의상. 자흑색과 옥청색 바탕에 청심처럼 화사한 머리 장식이 더해지자 감우가 가장 좋아하는 조합이 탄생했다",
      "isDefault": false,
      "characterName": "감우",
