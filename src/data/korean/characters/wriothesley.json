  "outfits": [
    {
      "id": 208600,
      "name": "시린 겨울밤의 포효",
      "description": "라이오슬리의 코스튬. 그의 위엄과 힘이 동시에 드러나는 복장으로, 거친 회색 늑대 사슬은 라이오슬리가 가진 메로피드 요새 통치권에 대한 상징이다",
      "isDefault": true,
      "characterName": "라이오슬리",
      "characterId": 10000086,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Wriothesley_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "안녕, 여기 온 이유를 최대한 간략히 설명해 줄래? 응? 공적인 이유가 아니라고? 그게 오히려 더 긴장되는걸.\\n앉아서 자세히 설명해 봐. 참, 난 「공작」이라고 불러줘. 다들 그렇게 불러서 익숙해졌거든"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·스티커",
      "text": "혹시 내 등에 멜뤼진이 그린 스티커가 붙어있으면 꼭 떼어줘"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·반려동물",
      "text": "사무실에 반려동물을 키울까 했는데, 강아지나 고양이가 햇빛도 못 보고 사는 건 너무 불쌍해서 관뒀어"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·충고",
      "text": "법을 어기지 마. 그리고 또 어떤 조언을 해줄까나? 아 그렇지, 법은 어기지 마"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "비가 온다고? 괜찮아. 메로피드 요새에 비가 새면 큰일이겠지만 말이야"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "마음이 떳떳한 자는 이런 날씨에도 평온히 잠드는 법이지"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "흠… 물의 차가움이랑은 또 다르네"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "태양 아래 새로운 건 없다지만, 그래도 피크닉 하긴 좋겠네"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침. 오늘 날씨 예보는 봤어?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "지금 특별 허가 식당엔 사람이 많으니까, 식사를 사무실로 보내달라고 할게"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "벌써 시간이 이렇게 됐나? 좀 전에 오후 티타임을 가진 것 같았는데"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "굿나잇. 나는 조금 있다가 잘게. 이렇게 조용할 때 계산 좀 하려고 말이야"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "라이오슬리 본인에 대해·오해",
      "text": "사람들은 나를 너무 무슨 신비로운 만능 인간으로 여겨. 나도 눈과 귀가 한 쌍뿐인데, 어떻게 메로피드 요새의 모든 곳을 관리하겠어?"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "라이오슬리 본인에 대해·휴식",
      "text": "나는 복역을 마친 자유로운 시민이니, 어디든 갈 수 있지.\\n걱정할 거 없어. 내가 물 아래에 있어야만 메로피드 요새가 잘 돌아가면, 그건 너무 불건전하잖아"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·수감",
      "text": "난 사람들의 첫인상이 수감 등록에서부터 시작되던데, 너도 예외는 아닌가 보군"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·출소",
      "text": "이익에 얽히지 않아야 친구가 될 수 있다더라. 우리도 지금 시작하면 되겠어"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "전에 일부 수감자들한테 화학 약품으로 원소를 사용하는 법을 배웠거든. 근데 「신의 눈」을 배부하는 기관이 어딘지, 이런 주제넘는 짓을 신경도 안 쓰는 것 같더라"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "경비대의 손에서 어떻게 쉽게 달아나는지 알아? 자신한테 길고 어려운 이름을 지어주는 거야. 그럼 「거기 아무개, 손 들어!」 할 때 버벅거리게 되거든"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "「일하지 않는 자, 먹지도 말라」\\n아주 오래 전부터 메로피드 요새 벽에 써있던 말이야. 누가 시작한 건진 모르지만 물 속에선 아주 유용하게 쓰이고 있지"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "느비예트에 대해…",
      "text": "한번은 느비예트 씨가 불러서 올라간 적이 있는데, 멜모니아궁 입구 길가에서 비를 맞고 있더라고. 그래서 우산을 씌워주려 했더니 말은 고맙다고 하는데, 표정이 썩 부자연스럽더라. 아마 내가 뭔가를 방해한 모양이야"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "푸리나에 대해…",
      "text": "그때 내가 너무 빨리 죄를 인정해서 그런지, 푸리나 님은 심판에 흥미를 잃고 자리를 훌쩍 떠나셨어. 물의 신님을 실망하게 하는 건 큰일이니, 앞으로도 좋은 찻잎을 잘 챙겨드려야겠지"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "시그윈에 대해…",
      "text": "수간호사 시그윈은 의료진으로서 갖춰야 하는 모든 미덕을 갖췄어. 동료들도 하나하나 챙겨주고 말이야.\\n하지만 내 나쁜 버릇도 좀 배운 모양이야. 예를 들어 멜뤼진 친구들이랑 누가 내 물건에 더 많은 스티커를 붙일 수 있을지 내기를 하곤 하지. 응? 아니, 난 전혀 난감하지 않아"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "클로린드에 대해…",
      "text": "클로린드 씨는 네가 찾을 수 있는 결투 대리인 중에 최고일 거야. 안 인정할 사람이 없을걸? 아, 난 단 한 번도 그 녀석이랑 겨뤄본 적 없어. 그럴 필요가 없지"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "리니에 대해…",
      "text": "인정해. 「벽난로의 집」의 밀정을 제거한 건 일종의 도발이었어. 근데 겨우 애들 몇을 내려보내서 되려 난감했다니까? 정말 희생돼도 괜찮다고 생각한 건지, 아니면 내가 애들에게 손을 쓰지 못할 거란 걸 알고 있었던 건지… 하아"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "나비아에 대해…",
      "text": "메로피드 요새와 가시 장미회는 물자적인 협력을 하긴 하지만, 그뿐이야. 나비아 씨를 못 믿는 게 아니라 오히려 완전 반대지만, 서로 간섭하지 않는 게 칼라스 씨와 약속한 규칙이거든. 약속은 지켜야지"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "에밀리에 대해…",
      "text": "메로피드 요새는 그녀의 서비스가 필요하지 않을 거야. 어떤 흔적은 「실패의 교훈」으로 남긴 거니까. …향기도 흔적 중 하나잖아, 안 그래?"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "슈브르즈에 대해…",
      "text": "특별 순찰대가 손봐준 수감자들은 대부분 온순하지. 여기 대장이 아주 큰 공을 세웠어"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "라이오슬리에 대해 알기·첫 번째",
      "text": "이론적으로, 나를 전혀 모르는 사람이 행복한 편이야"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "라이오슬리에 대해 알기·두 번째",
      "text": "내 몸의 흉터? 바다 괴물이 메로피드 요새를 점령하려고 들어서 그 괴물과 싸우다가 난 상처지. …당연히 가짜야, 뭘 믿고 그래"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "라이오슬리에 대해 알기·세 번째",
      "text": "그거 알아? 수갑은 모델이 비슷하면 같은 열쇠로 열 수 있다는 거. 다만 내 건 다르지"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "라이오슬리에 대해 알기·네 번째",
      "text": "내 개인 능력은 사실 아주 한정적이야. 봐봐, 난 병을 고칠 줄도, 무언가를 발명할 줄도 몰라. 큰 배를 만드는 건 더 말할 것도 없지. 난 그냥 이런 일을 해줄 사람을 어디서 찾을지 알고, 그들도 마침 내 체면을 챙겨주는 것뿐이야"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "라이오슬리에 대해 알기·다섯 번째",
      "text": "난 지금 생활도 괜찮다고 생각해. 하지만 내가 얻지 못한 것들, 예를 들어 평화롭고 행복한 어린 시절이나 쉽게 타인을 믿는 능력 같은 게 부러워. 이런 게 모순이라고 느끼는 사람도 있겠지만, 난 굳이 부정할 필요가 없다고 생각해. 자기 본심을 외면해서 뭐 하겠어?"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "라이오슬리의 취미…",
      "text": "복싱… 정도가 취미랄까? 사는 데 필요해서 배운 거지만. 넌 뭐 추천해 줄 만한 거 없어?"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "라이오슬리의 고민…",
      "text": "내가 폰타인 사람처럼 생기긴 했지만, 백 프로 확신할 순 없어. 역시 원시 모태 바다의 물에 뛰어들어 봐야 하나?"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "커피 마실 때 우유를 넣는 걸 좋아해. 차에는 설탕 두 조각을 넣고"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "수간호사가 만든 셰이크 마셔봤어? 거기선 「황폐」의 맛을… 느낄 수 있어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "간이 완벽하네. 난 이런 걸 잘 못하겠더라"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "맛있네. 다음엔 내가 사도록 하지"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "나 차 한 잔 좀 우려올게"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "폰타인의 아이들은 부모의 소원과 축복 속에 태어나지. 나는 이 세상에 모든 사람들이 그랬으면 좋겠어. 그거에 비하면 내 소원은 조금 보잘것없을지도 모르지.\\n아니, 네가 사고 치면 감형을 도와줄 순 없어. 그저 오늘 특별 메뉴를 준비해 줄 수 있을 뿐이지. 그러니 생일 기간에는 잠자코 있어. 그래야 물 위에서 축하해 줄 수 있으니까. 알았지?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "신뢰를 얻어서 영광이야"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "이번에 신세 진 건 꼭 갚을게"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "하, 어째 네가 나보다 더 의기양양해 보이냐?"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "난 힘과 희망의 신호가 좋아. 모든 게 잘될 거 같거든. 비관적인 게 아니라 사실을 말하는 거야. 현실은 늘 순조로울 수 없으니까. 그래도 좋은 소식은, 나쁜 일이 있을 때 우린 같은 편이라는 거야. 맞지?"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "시작하지"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "어딜 도망가"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "거기 잠깐 실례"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "잘 가라고"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "추위 조심해"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "네 죄를 마주해라"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "안 잠겨있어? 편리하네"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "일단 챙겨 둬. 어떻게든 쓰일 거야"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "주인 없는 물건은 공적 재산으로 회수해야겠지만… 여긴 아무것도 없잖아, 그치?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "침착해"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "지원 안 부르게? 그러던가"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "기회를 봐서 움직이라고"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "물러서"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "의무실에 가"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "미안, 지켜내지 못했어…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "모든 걸 건 결과가…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "난 이의 없어"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "겸손하기는"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "…나쁘지 않네"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "시작하지"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "외근 요청이야? 그것도 좋지"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "최선을 다할게. 이긴다는 보장은 없지만"
    }
  ]
}