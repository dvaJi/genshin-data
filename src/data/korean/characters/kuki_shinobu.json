  "outfits": [
    {
      "id": 206500,
      "name": "아라타키의 오니 조수",
      "description": "쿠키 시노부의 코스튬. 트레이드마크인 오니 복면은 아라타키파에서 그 누구보다도 위엄 있는 「오니 조수」를 상징한다",
      "isDefault": true,
      "characterName": "쿠키 시노부",
      "characterId": 10000065,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shinobu_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "안녕, 난 아라타키파의 이인자 쿠키 시노부야. 우린 물류 배송, 치안 유지, 자택 보수, 음악 공연 등 다양한 의뢰를 받고 있어. 필요하면 언제든지 연락해. 자, 이건 내 명함이니까 받아둬"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·성가신 일",
      "text": "성가신 일이 생기면 날 찾아와. 내가 해결해 줄게"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·자격증",
      "text": "자격증 시험은 다 정해진 평가 기준이 있어. 열심히 배우고 연습하면 무조건 합격할 수 있지. 어렵지 않아"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·아라타키파",
      "text": "아라타키파가 사고 쳤다면, 내가 직접 끌고 와서 사죄시킬게"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "우산은 됐어, 더 빨리 뛰면 돼"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "조심해. 이런 날씨에 벼락 맞고 싶은 사람은 없겠지?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "얼른 처리하고 가자. 시간 낭비하지 말자고"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "날씨는 좋은데 어쩐지 불길한 예감이 들어…. 괜한 걱정이었으면 좋겠군"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "음… 기분 좋은 바람이야"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침, 운동하러 가? 생각보다 부지런하네"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "뭐 먹고 싶어? 요새 돈 좀 모았거든. 점심은 내가 쏠게"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "어떤 의뢰는 밤에 움직이는 게 더 편해. 그 녀석들한테 맡기는 건 왠지 불안해서 보통 내가 직접 나서지"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "쉬어야 할 땐 가서 푹 쉬어. 내 걱정은 안 해도 돼"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "쿠키 시노부 자신에 대해·이인자",
      "text": "일을 찾거나 멤버들의 안정을 유지하는 게 내 할 일이야. 이 외에도——봉행소에서 사람을 빼내거나, 간식과 장난감을 돌려주거나, 의뢰를 받고도 농땡이 피우는 멤버를 잡아내는 등 일을 맡고 있지…. 이 추가 업무들은 아라타키파만의 특색이라고 할 수 있어. 원칙대로라면 다른 조직의 이인자들은 이런 일을 할 필요가 없지. 물론, 나처럼 해낼 수도 없을 테고"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "쿠키 시노부 자신에 대해·퇴로",
      "text": "아라타키파 해산? 그럴 일은 절대 없어. 그리고 정말 해산한다 해도 난 걱정 안 해. 내가 배를 곯을 리는 없으니까"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·노트",
      "text": "나중에 자격증이 따고 싶어지면 날 찾아와. 내 노트를 빌려줄게. 요점 정리는 물론, 보충 설명도 자세하게 적어놔서 이해하기 쉬울 거야"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·뒷수습",
      "text": "네가 아라타키파이든 아니든, 난 널 외부인으로 여기지 않아. 뒷수습은 나한테 맡기고 넌 앞으로 나아가면 돼. 걱정 마, 난 이쪽으로 프로니까 아무리 복잡한 일도 잘 해결할 수 있어. 내 안전이 걱정된다고? 하하, 그것도 걱정 마. 여태까지 겪은 고생이 헛된 건 아니니까"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "자격증과 마찬가지로 이것 또한 내 능력에 대한 인정이자 증명이지. 다른 점이 있다면, 지금까지도 그 심사 기준을 모르겠다는 거?"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기·복면",
      "text": "복면은 지인한테 들키기 싫어서 쓰는 거야. 특히 아라타키파와 함께 임무를 수행할 때 지인이 날 알아보고 수군거리기라도 한다면, 그 녀석들도 같이 야단법석을 떨 게 분명해…. 생각만 해도 짜증 나네. 그런 일, 두 번 다시 있어선 안 돼! 크흠, 아무것도 아냐"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "하고 싶은 이야기·아라타키파 법도",
      "text": "내가 아라타키파의 「법도」를 만든 이상 다들 법도에 따라 행동해야 돼. 응? 그들이 순순히 말을 듣는 이유가 뭐냐고? 그야 녀석들보다는 내가 훨씬 설득력 있으니까. 내 말과 주먹은 꽤 힘이 있는 편이거든"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "신사에 전해지는 설법에 따르면, 울림풀을 고리 모양으로 엮어 몸에 지니면 액운을 쫓고 행운이 온대. 넌 이 말 믿어? 난 울림풀의 마비 효과가 더 실용적이라고 생각하는데"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "라이덴 쇼군에 대해…",
      "text": "쇄국령이 풀리고 라이덴 쇼군은 각 업계의 발전을 지원하는 법령을 잇따라 반포했어. 이제 내가 쇄국령 기간에 땄던 자격증들도 쓸 수 있고, 아라타키파도 경제적으로 그렇게 쪼들리지 않게 됐어…. 인생사 새옹지마라더니, 결국 라이덴 쇼군한테 고마워하게 될 날이 올 줄이야"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "쿠죠 사라에 대해…",
      "text": "쿠죠 씨는 내 친구야. 응? 내가 쿠죠 씨랑 아는 사이인 게 그렇게 의외야? 아, 뭔가 오해했나 본데, 아라타키파에 들어오기 전부터 친분이 있었어. 우리 둘의 대결은 아직 승부가 안 났지"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "야에 미코에 대해…",
      "text": "나루카미 다이샤의 궁사님마저 부업을 소일거리로 삼을 정도니, 무녀가 얼마나 지루한 직업인지 대충 짐작이 갈 거야. 내가 다시 무녀가 되는 일은 절대 없어"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "아라타키 이토에 대해…",
      "text": "형님은 썩 유쾌하지 않은 과거를 겪었지만, 늘 밝고 유쾌한 모습을 유지하고 있어. 쉽지 않은 일이야. 우리한테도 무척 잘해주시지. 형님의 그런 순수함이 아라타키파의 모두를 감화시킨 거야. 물론, 그게 형님이 다른 사람에게 막무가내로 굴어도 된다는 구실이 될 순 없어. 그가 너한테 폐 끼치면 언제든지 알려줘. 너한테 무례하게 군 걸 후회하게 해줄 테니까"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "연비에 대해…",
      "text": "그땐 가족과 사이가 틀어져서 될수록 멀리 도망가려는 생각뿐이었어. 그래서 법을 배우러 리월에 갔고 덕분에 연비 선배를 알게 됐지. 선배는 법률 자문 쪽으로는 걸어 다니는 백과사전이나 다름없어. 나? 자격증은 땄지만, 이 직업도 제약이 이만저만이 아니라서 말이지…. 나한테 딱 맞는 직업은 아냐"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "시카노인 헤이조에 대해…",
      "text": "그는 평범한 텐료 봉행 도신 병사들과 달라. 그 사람이 순찰하거나 범인을 체포하는 걸 단 한 번도 본 적이 없거든. 가끔 나한테 정보를 사가곤 하는데, 정보를 주는 대신 봉행소에서 사람을 빼낼 때 잘 좀 말해달라고 부탁하면 흔쾌히 승낙하더라고. 꽤 괜찮은 거래야. 형제들한테 거리에서 정보를 수집하라고 하는 건 아주 쉽거든"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "쿠키 시노부에 대해 알기·첫 번째",
      "text": "난 다양한 일을 해봤고 관련 자격증도 적지 않게 가지고 있어. 관리 쪽으로는 작은 팀을 맡아서 인원 관리와 자원 조달을 담당한 적이 있고…. 어, 미안, 면접을 많이 보다 보니 또 버릇이 도졌네. 신경 쓰지 마"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "쿠키 시노부에 대해 알기·두 번째",
      "text": "우리 집은 대대로 무녀 가문이지만, 난 무녀에는 썩 어울리지 않아. 막 도망 나왔을 때 혼자서도 먹고 살 수 있게 많은 경험을 했어. 요리, 재봉, 격투, 법률 자문, 출판 편집 같은 것들을… 죄다 배웠었지. 막상 사회에 들어서고 보니 이 정도로도 충분하겠더라고"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "쿠키 시노부에 대해 알기·세 번째",
      "text": "내 사교성이 뛰어나다고? 하하… 오랫동안 밖에서 떠돌이 생활을 해와서인지 눈치 하나는 더럽게 빠르지. 게다가 손해 보는 건 대부분 우리거든. 그런 표정을 짓는 걸 싫어하진 않지만, 될 수 있으면 안 웃는 걸 택하겠어"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "쿠키 시노부에 대해 알기·네 번째",
      "text": "아라타키파에 막 들어왔을 때 형님이 나더러 부하들에게 싸우는 법을 가르치라고 했어. 그래서 내가 들어오고 나서 제일 처음 한 일이 바로 녀석들을 한 명씩 때려눕히는 거였지. 근데 다들 시퍼렇게 멍이 든 얼굴을 하고서도 눈을 동그랗게 뜨면서 날 「시노부 누님」이라고 부르더라고. 잘 부탁한다면서 말이야. 흥, 그때부터 이 녀석들이 답 없는 바보들이라는 걸 알았지. 하지만 괜찮아. 그 바보들이 내 발목을 잡을 일은 없어. 문제는 내가 다 해결하면 되니까"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "쿠키 시노부에 대해 알기·다섯 번째",
      "text": "아라타키파에 남기로 한 건 내 스스로 한 결정이야. 뒷수습하다 보면 종종 화가 치미는 건 사실이지만, 그들은 나한테 그 무엇과도 바꿀 수 없는 진심을 보여줬어…. 제일 좋은 물건은 나부터 준다든지, 절대 내 일에 초 치지 않는다든지, 결정 사항을 알리면 떠들썩하게 박수 치면서 휘파람을 불어준다든지…. 사람들이 아라타키파를 썩 좋게 보지 않는다는 건 알아. 멤버들은 별로 개의치 않지만, 난 노력해서 우리에 대한 사람들의 생각을 바꾸고 싶어. 「가족」이라는 게 나는 가끔 막 대해도 되지만, 남들이 뭐라 하는 꼴은 못 보는 법이잖아"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "쿠키 시노부의 취미…",
      "text": "평소에 아라타키파에 있으면서 할 일도 없고 하다 보니, 나도 모르게 책 한 권을 다 읽고 자격증을 따고 있더라고. 나름 괜찮지 않아? 가족들이 물어봐도 허송세월한 것도 아니고, 나가서 일할 밑천도 생기고. 뭐든 실력을 최우선으로 보는 이 세상에서 나처럼 자격증 가진 건달은 어딜 가든 배곯을 걱정은 안 해도 돼"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "쿠키 시노부의 고민",
      "text": "전에는 무녀로 잡혀가기 싫은 마음에 혼자 힘으로 자리 잡으려 했어. 적어도 지금까진 꽤 잘하고 있는 것 같아"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "라멘이나 교자처럼 든든한 음식을 먹어도 마지막은 쌀밥 한 그릇이 꼭 먹고 싶어져. 쌀밥 맛있잖아, 다른 이유는 없어. 뭐 문제 있어?"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "요리사 자격증을 딴 후로 리월에서 들은 이 말을 더욱 믿게 됐어. 세상에 맛없는 요리는 없다. 형편없는 요리사만 있을 뿐"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "제법이네. 크흠… 한 입만 더 먹을게"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "네가 만들었어? 음… 이 정도 실력이면 요리사 자격증도 충분히 따겠네"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "솔직히 물어볼게. 조미료 잘못 넣은 거 아니야?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해. 자, 이 특제 울림풀 표창 선물로 줄게. 조심해, 그래. 맞아, 그렇게 잡는 거야…. 던지기 전에 궤적 계산하는 거 잊지 말고…. 하하, 마음에 든다니 다행이네. 아, 장난감 취급하진 마. 위험한 건 사실이니까. 연습하고 싶다면 내가 도와줄게"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "기본기가 부족하면 다른 건 더 논할 필요도 없어. 그래서 초급 자격증이 필요한 거지"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "중급 자격증을 손에 넣으면 대부분 일을 순조롭게 처리할 수 있어. 내가 뭐 도와줄 일 없어?"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "고급 자격증은 쉽게 따낼 수 있는 게 아니야. 천부적인 재능과 실전을 통한 경험, 어느 것 하나 빼놓을 수 없지"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "자격증은 기술의 전문성을 따질 뿐, 거기에 쏟아부은 노력과 감정을 계량화할 수는 없어. 너와 내 친분도 고맙다는 말 한마디로 설명할 수 있는 게 아니니까, 행동으로 증명할게. 이건 내 특기지"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "울림풀 고리!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "액운 타파!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "똑바로 서야 할걸"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "얌전히 있으라고"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "번개의 힘으로… 정화한다!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "방해하지 마"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "음, 티끌 모아 태산이지"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "이번에도 수확이 좋아"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "이제 다 네 거야"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "거, 기, 서…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "사람 약올리네…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "흥, 이제 내 차례야…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "뒷수습은 내가 하지"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "됐어, 무리하지 말고 나한테 맡겨"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "이번에는… 정말 폐를 끼쳤군…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "아라타키파를 부탁해…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "이건… 나에 대한 모욕이야…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "더 해보시지"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "두고 봐!"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "맞고 싶어서 환장했어?"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "내가 신호 주면 움직여"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "이번에는 무슨 일인데?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "골치 아픈 일은 아니면 좋겠네"
    }
  ]
}