  "outfits": [
    {
      "id": 201501,
      "name": "펄럭이는 돛의 그림자",
      "description": "케이아가 무대에서 「단검 대도」를 연기할 때 입은 코스튬. 「이목」을 끌 수 있도록 화려하게 디자인됐다. 의외로 입기 편하며, 오히려 장식과 단검 관리에 시간이 가장 많이 들어간다",
      "isDefault": false,
      "characterName": "케이아",
      "characterId": 10000015,
      "source": [],
      "filename_card": "UI_AvatarIcon_KaeyaCostumeDancer_Card",
      "filename_icon": "UI_AvatarIcon_KaeyaCostumeDancer",
      "filename_iconCircle": "UI_AvatarIcon_KaeyaCostumeDancer_Circle",
      "filename_splash": "UI_Costume_KaeyaCostumeDancer",
      "filename_sideIcon": "UI_AvatarIcon_Side_KaeyaCostumeDancer"
    },
    {
      "id": 201500,
      "name": "얼음 위 깃털",
      "description": "케이아의 코스튬. 네이비 퍼로 옷깃을 장식한 시크한 복장이다",
      "isDefault": true,
      "characterName": "케이아",
      "characterId": 10000015,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Kaeya_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "페보니우스 기사단, 케이아, 너와 동행하게 해줘, 기사단에서 심부름하는 것보다 네 호위를 맡는 게 훨씬 재밌겠어"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·빈둥빈둥",
      "text": "너도 한가로움을 즐길 줄 몰랐어"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·기사단",
      "text": "기사단 전우들은 몹시 바쁘잖아, 흥흥"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·나태",
      "text": "한참 가만히 있었잖아? 이제 움직이지 않으면 몸에서 풀이 자랄지도 몰라"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "비가 오는 날엔 얼음의 힘이 더 강해지겠지. 재밌는데"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "눈이 올 때·일화",
      "text": "후… 눈이 오니 귀신이야기 해줄게"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때·추위",
      "text": "왜 그래~ 추워?"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "정말 평화롭군. 하지만 이게 얼마나 갈까?"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "오늘 하루를 즐기자고"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "오우, 함께 술집에 가지 않을래?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "어둠이 두려운 건 아니지? 그렇다면… 새로운 소재를 찾은 거네"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "이제 가야 하지? 그럼 다음에 또 봐. 날 너무 기다리게 하지 말아줘"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "케이아 자신에 대해…",
      "text": "요새 심연 교단에 괴롭힘을 당하고 있어? 고민 있으면 나한테 털어놔도 돼"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·고용 관계",
      "text": "내가 필요할 땐 날 써, 고용 관계 같은 소리는 하지 말고"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·실력",
      "text": "우리 사이의 고용 관계가 그리 마음에 걸린다면 날 더 부려줘, 보스? 흥, 내 진짜 실력에 놀라지나 마"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "신의 눈의 원리를 모르겠어? 음… 예를 들어줄게. 시선을 인도하는 기관은 눈이야. 원소의 힘을 인도하는 기관은 신의 눈이고. 이럼 간단하잖아?"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "술 좋아해? 민들레주는 아주 특별한 맛이 나. 아직 술 마실 수 있는 나이가 아니지? 그럼 몬드의 무알코올 사과주를 마셔봐. 제법 괜찮은 술집을 알고 있거든"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "드래곤 스파인의 올빼미 본 적 있어? 그와 눈이 마주치면 마치 널 꿰뚫어 보고 있는 느낌이 들어, 하지만 전혀 그 속을 모르겠고… 아주 매혹적인 녀석이야, 안 그래?"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "진에 대해…",
      "text": "어? 단장 대행님, 그녀를 많이 응원해줘"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "리사에 대해…",
      "text": "리사… 책을 꼭 제때 반납해야 해, 저번에 책을 연체해서 제대로 혼쭐이 났지, 지금까지 왼손이 저릿할 정도야"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "엠버에 대해…",
      "text": "정찰 기사는 영리하고 정의로운 기사야, 그러니 그녀 앞에서 절대 나쁜 짓을 하면 안 돼"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "다이루크에 대해…",
      "text": "다이루크? 어렸을 때는 꽤 귀여웠지, 하지만 지금은 자신만의 세계에서 살아…. 어쨌든 참 따분한 사람이야"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "클레에 대해…",
      "text": "클레, 단장 대행의 검사를 피하는 요령을 아직 터득하지 못했나 봐. 분명히 내가 일러주었는데… 하하하, 농담이야. 가서 고자질하지 말라고"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "알베도에 대해…",
      "text": "알베도 말이야. 차분하고 도도한 매력남에다 재치가 넘쳐 호감이 가는 스타일이지. 왜, 너도 심쿵했어?"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "디오나에 대해…",
      "text": "너도 디오나가 타준 칵테일 맛본 적 있어? 아~ 아직 술 마실 나이가 안 됐군. 아쉽네. 이런 즐거움을 함께할 수 없어서. 네가 빨리 어른이 되었으면 좋겠네"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "바르카에 대해…",
      "text": "안타깝게도 지금의 페보니우스 기사단에는 대단장의 스타일을 이어받은 사람이 없어. 아… 꽤나 마음에 들었는데"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "피슬에 대해…",
      "text": "뭐라고? 피슬의 한쪽 눈을 가린 신비로운 모습이 「단죄의 황녀」의 이미지에 어울린다고? 하하하, 그렇다면 난 적어도 마지막 황족의 후예여야지. 안 그래?"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "노엘에 대해…",
      "text": "나는 단장 대행님의 부탁을 받고 이 후배를 몰래 돌봤어. 그녀는 제 앞가림을 잘해서 내가 별로 신경 쓸 필요 없어. 정말 기특해"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "로자리아에 대해…",
      "text": "아하하, 로자리아 수녀의 비밀을 알고 싶어? 그건 말할 수 없어. 하지만 난 어떤 사람보다 그녀를 훨씬 좋게 보고 있어. 그녀는 자신에게 솔직하잖아. 귀찮은 일이면 귀찮은 일이고 열의가 없으면 열의가 없는 거지"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "설탕에 대해…",
      "text": "설탕이 조용하고 내향적인 것처럼 보여도 그녀의 실험실엔 엄청 특이한 물건들로 가득하다고 들었어. 자극적이고, 매우… 노골적인 것들 말이야. 응? 뭐…? 내가 여자애 방이나 훔쳐보는 사람 같아?"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "콜레이에 대해…",
      "text": "음, 콜레이? 정말 그리운 이름이네. 잘 찾아왔어! 내가 과거에 무슨 일이 있었는지 처음부터 알려줄게——어떤 꾸밈도 없는 그런 이야기가 될 거야!"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "미카에 대해…",
      "text": "미카와 알고 지낸 지 얼마 안 됐을 때 워낙 쉽게 긴장하는 성격 같아서 가벼운 장난을 좀 쳤는데, 어째 더 긴장한 것 같더라고. 웃는 게 어찌나 어색하던지…. 그래서 결국 사과 편지도 써줬잖아. 에휴, 그렇게 순진해서야, 설마 슈미트 가문의 유전인가?"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "달리아에 대해…",
      "text": "평소에 성당의 포도주를 자주 마시는가 봐? 주량이 굉장하더라고. 전에 술 마시기 대회에서 내가 지면서 알게 된 사이거든. 바람 신은 술을 사랑하고, 그의 대행자도 부지런히 술의 매력을 전파하고 있으니, 이게 바로 자유의 도시의 낭만 아니겠어!"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "로엔에 대해…",
      "text": "로엔 그 녀석, 나한테 서명 위조를 부탁하러 안 온 지가 꽤 됐네. 설마 기술을 익혀버린 건가? 그 비상한 머리로는 못 할 것도 없지만…. 얼마나 제대로 익혔나 확인해 보게, 나중에 대단장님의 필체로 편지를 보내봐야겠어"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "케이아에 대해 알기·첫 번째",
      "text": "기병대장 직함이 별로 대단한 건 아니야. 몬드성 기병은 대단장이 다 데리고 가버렸으니까, 하하"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "케이아에 대해 알기·두 번째",
      "text": "사실 페보니우스 기사단에는 총 10명의 대장이 있어. 하지만 모두가 대장급 실력을 지니고 있다는 건 아냐"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "케이아에 대해 알기·세 번째",
      "text": "내 눈? 멀쩡한데. 몸의 일부분을 가리는 건 일반적인 일이잖아? 옷도 그런 이유로 입는 거지"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "케이아에 대해 알기·네 번째",
      "text": "켄리아? 오~ 많은 걸 아는구나. 켄리아의 영광은 진작 사라졌지. 남은 사람들은 다 죄인이 되었어. 이제 와서 그들을 언급할 필요가 있을까?"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "케이아에 대해 알기·다섯 번째",
      "text": "우리가 만난 지 그렇게나 오래되었다니, 너와 함께하는 여행은 내 평생 가장 재미있는 일이 되었어, 앞으로도 실망시키지 말라구"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "케이아의 취미…",
      "text": "술을 음미하는 것은 예술이라고 할 수 있어, 몬드의 술은 바람의 신이 주신 선물이야. 제대로 음미할 수 있어야 이런 행운을 온전히 누릴 수 있어"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "케이아의 고민…",
      "text": "외롭냐고? 그럴 리가, 지금 옆에서 잔소리하는 사람이 있잖아"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "몬드 특제 스파클링 화이트 와인, 민들레주 3인분에 해당하지, 쓴맛이 완벽하게 중화되었어, 이 술은 「오후의 죽음」이야, 아주 맛있어"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "포도 주스를 바로 마시는 사람이 있네, 조금만 기다리면 훌륭한 술이 될 텐데…. 정말 낭만을 모르는군"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "오! 맛있는데? 이런 실력이 있는지 몰랐어"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "술이랑 같이 먹으면 더 맛있을 거야"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "먹는 게 좀 느려서 그렇지, 다 먹을 테니까 걱정 마"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "축하해야 할 날이야, 오늘을 진심으로 즐겼으면 좋겠어"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "오, 너도 꽤 하는구나!"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "계속 날 돌봐줬던 것 같네, 고마워"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "힘이 또 강해졌네. 너 눈빛이 왜 그래? 어째 나보다 더 흥분한 것 같아"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "동행만 했을 뿐이었는데 날 위해 이렇게까지 할 줄 몰랐어…. 나도 제대로 보답해야겠네. 우리의 여정을 계속하자, 친구. 진지해져야 할 때야"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "얌전히 있어!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "얼어붙어라!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "이건 어때?"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "감기 조심"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "미안"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "…이 순간을 영원하게 만들어주지"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "성격도 참 급해"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "대시 종료·첫 번째",
      "text": "후우~"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "바람이 불고 있어"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "운이 좋은데!"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "재밌군"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "하하, 신나는걸"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "진지해져야겠군"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "따분해졌어…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "성가신 녀석…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내가 도와주지, 너 나한테 빚진 거야"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "이봐, 죽으면 다 끝이라구"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "아직 충분히… 즐기지 못했어"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "흥, 예상 밖이야…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "너무 보기 흉해"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "제기랄…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "적당히 해"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "정말 기대되는군"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "재밌는 걸 찾으러 가볼까?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "준비는 벌써 끝났다고"
    }
  ]
