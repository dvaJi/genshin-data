    {
      "id": "glacial_heart",
      "name": "빙연의 마음",
      "description": "<span style=\"color:#FFD780FF\">서리 엄습</span>이 적을 <span style=\"color:#99FFFFFF\">빙결</span>시키면 얼어붙은 적은 원소 입자를 추가로 드랍한다.<br/>서리 엄습 1회로 최대 2개의 원소 입자가 추가로 드랍된다",
      "level": 4
    },
    {
      "id": "hidden_strength",
