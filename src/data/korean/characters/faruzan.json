  "outfits": [
    {
      "id": 207600,
      "name": "푸른 잎과 흰 꽃",
      "description": "파루잔의 코스튬. 백 년 전 아카데미아에서 유행했던 스타일이지만, 지금은 아무도 입지 않는다. 소박하고 우아한 스타일은 외부 세계에 흔들리지 않는 그녀의 순수함을 상징한다",
      "isDefault": true,
      "characterName": "파루잔",
      "characterId": 10000076,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Faruzan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "이건 왕년에 아카데미아에서 수여한 우수 학자상이고, 이건 수메르 수수께끼 협회에서 준 평생 공로상, 그리고 이건 유적 장치 연구회에서 줬지…. 어때? 내 밑으로 들어올 생각 없어? 크흠, 참고로 난 지론파 학자야. 날 찾으려면 하라바타트 학부로 와. 크샤흐레와르 학부가 아니니까 잘 기억해 둬"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·규칙",
      "text": "벌써 백 년이나 지났는데, 아카데미아의 멍청한 규칙은 하나도 안 변했네…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·선배",
      "text": "어——? 뭐라고? 나이가 들어서 잘 안 들려. 먼저 선배라고 불러봐"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·학문 연구",
      "text": "학문 연구는 유행을 따르는 게 아니야. 인기 비인기 학문 같은 건 없어"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "애도 아니고, 비 오는 날이 뭐가 기쁘다고"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "으앗?! 뭐, 뭐야? 나이 든 사람은 천둥번개도 무서워하면 안 돼?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "예쁘다… 푹 빠지겠어… 에취! 음… 감기도 걸리겠네…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "기분 좋다. 역시 공기가 잘 통하는 환경이 좋네"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "빙빙 돌아서 결국 또 여기로 왔잖아…?"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "젊은이, 아침이면 기운을 내야지! 다시 인사해 봐"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "조금 배고프네… 바자르로 가서 뭐 좀 먹을래? 난 편식 안 해. 너무 신세대 입맛만 아니면 돼"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "호들갑 떨지 마. 어느 시대의 학자든지 밤새우면서 연구하니까. 밤은 조용히 생각할 수 있는 귀한 시간이야"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "고대 문서 때문에 머리가 어질어질하네…. 오늘은 여기까지 해야겠어. 그럼 난 자러 갈게. 너도 일찍 쉬어. 잘 자"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "파루잔 자신에 대해·선배",
      "text": "궁금한 게 뭐야? 변형된 압력 장치? 원소 비석의 하층 설계? 음, 잠깐만… 방금 나한테 물어볼 때 선배라고 부르는 거 깜빡했지?"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "파루잔 자신에 대해·외톨이 지도 교수",
      "text": "내 학생이 진심으로 고대 문서 연구를 좋아했으면 좋겠어. 만약 그런 아이를 만나지 못하면 평생 학생을 아무도 안 들일 거야! 어, 어? 신입생한테 일 시키는 건 뭐냐고? 가끔 남는 시간에 선배를 돕는 건 당연하잖아? 나 때는 말이야, 다 그렇게 했어…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·학생 모집",
      "text": "진지하게 말하는 건데, 너 내 학생 하지 않을래? 내가 네 상황에 맞춰서 과제도 내주고, 강의도 누구보다 이해하기 쉽게 해줄게. 현대 장치 수수께끼를 중심으로 관련 문헌 해석까지 범위를 넓히는 게 좋겠어…. 내가 다 경험해 봤어. 이런 지식은 나중에 모험할 때 큰 도움이 될 거라고. 이래도 못 믿겠어?"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·수수께끼 시간",
      "text": "백 년 동안 끊임없이 수수께끼를 풀다 보니까 어느새 시간의 흐름에조차 점점 둔해졌어…. 지금은 괜찮아, 나 혼자 방황하지 않아도 되니까. 너랑 같이 비문 탁본을 뜨거나, 문자를 해독하고 장치를 해부하면서 연구하는 일분일초를 즐길 수 있어"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "내 학술 수준? 흥, 화려한 과거 이력을 얘기하지 않아도 신까지 인정하는 사실이지. 왜 학생이 안 모이냐고 묻는다면… 그건 내 문제가 아니야. 학문의 문제도 아니고. 아마 계기가 없어서겠지…. 내가 신의 눈을 특정 계기로 얻은 것처럼 말이야"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기·묘론파",
      "text": "「크샤흐레와르 학부는 향후에 장치 연구를 진행할 능력이 되는 유일한 학부가 될 것이다」라…. 흥, 현재 묘론파의 이 선언은 너무 거만한 게 아닌가? 내가 수메르에서 수수께끼를 풀고 있을 때 어디서 블록이나 가지고 놀았을 녀석들이"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "하고 싶은 이야기·지론파",
      "text": "지론파 녀석들은 아무도 관심이 없는 비인기 분야라는 이유로 내 연구비 허가를 안 내줘. 그게 판단 기준이면, 지론파는 지금까지도 인원이 제일 적은 학파니까 차라리 하라바타트 학부를 닫지 그래?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "난 수많은 유적에 가봤는데 한정적인 고대 문자와 그림으로 해독해 보면, 「유적 드레이크」는 정말 정교한 장치야. 음… 단순히 「장치」 두 글자로 설명할 수 없겠네. 고대부터 지금까지 남은 「생물」이라고 해도 과언이 아니야…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "작은 쿠사나리 화신에 대해…",
      "text": "지론파 연구가 묘론파에 사용되는 것처럼… 지식은 한정될 수 없는 거야. 모든 학자는 작은 쿠사나리 화신께 감사의 마음을 갖고 있어. 아카데미아, 아니, 지혜의 도시인 수메르가 사리사욕에서 벗어나 지식을 탐구하는 사람이 학문의 바다에 깊이 파고들어 연구할 수 있게 하셨으니까…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "타이나리에 대해…",
      "text": "우림 유적 연구는 제일 걱정 안 되는 프로젝트야. 아, 타이나리를 불러야겠다. 살아있는 《우림 생존 가이드》를 데리고 있으면 재밌잖아. 내가 나이는 많지만, 먹어본 버섯은 타이나리가 본 버섯보다 적으니까"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "콜레이에 대해…",
      "text": "콜레이는 어른들에게 예의 바른 데다 근면 성실하고 공부에 열정이 넘쳐서 아주 완벽한 학생이야! 이런 아이는 상냥하게 격려해야지. 타이나리는 꼭 그렇게 엄격하게 굴어야 하나? 거참… 무슨 수를 써서라도 콜레이를 빼와야 하는데… 크흠! 내 말은… 선배로서… 지금 젊은이들의 학업 환경을 개선할 방법을 찾아야 한다고…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "사이노에 대해…",
      "text": "사이노의 개그는 현대 문자와 언어로 구성되어 있는데도 문법과 의미에서 그 속뜻을 추리할 수가 없어…. 그냥 글자 그대로의 뜻에 말장난이라고? 정말…? 그러면 개그가 너무 지루한데…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "레일라에 대해…",
      "text": "레일라는 가끔 날 보면 고개를 숙이고 날 피해서 가는데, 밤에 우연히 마주치면 스스럼없이 인사하더라… 대체 뭐지? 뭐, 르타와히스트에 들어갈 수 있는 녀석들은 다 천재고, 천재는 다들 이상한 습관이 있으니까 신경 쓸 필요 없겠지"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "카베에 대해…",
      "text": "카베는 좋은 인재야. 장치 구조의 원리에 관해서 간단하게 얘기를 나눈 적이 있는데, 뭐랄까… 낭만주의와 예술 감각이 너무 과한 감이 있지만, 그래도 자기만의 생각이 있는 건 대단해. 요즘 주머니 사정이 빠듯하다고 들었는데, 언제 연구비 나오면 맛있는 거라도 사 먹여야지… 딱 기다리라고"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "닐루에 대해…",
      "text": "기억나. 예의 바른 애였지. 바자르에 몇 번 갔더니 날 기억하더라고. 다른 사람한테 나랑 싸우지 말라고 하더라. 그래, 요즘 젊은이들은 닐루에게 많이 배워야 돼"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "세토스에 대해…",
      "text": "응? 그 새로 온 녀석? 마침 잘 얘기했어! 어느 학부 소속인진 모르겠지만, 요즘 길거리며 상점이며 식당이며 여기저기 어슬렁거리더라니까…. 어딜 가도 보이길래 얘기를 좀 해봤는데, 계속 고개를 끄덕거리는 게 뭐랄까… 강아지 같달까? 말도 조리 있게 하는 게 제법 싹수가 보이던데, 혹시 아는 사이면 내 밑으로 들어오라고 잘 좀 말해줘. 이 선배가 절대로 손해 보지 않게 해줄 거라고 말이야"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "파루잔에 대해 알기·첫 번째",
      "text": "이 파루잔 선배의 이야기는 거의 시대를 넘나드는 문헌 수준이지. 백여 년 전부터 시작해야 하는데… 그래도 들을래? 아주 좋아. 적극적으로 배움을 청하는 태도는 학자의 필수 덕목이지. 입문 축하해"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "파루잔에 대해 알기·두 번째",
      "text": "옛날에는 장치 수수께끼를 풀려면 대량의 문헌 해독과 연구가 필요했어. 과장이 아니라, 네가 푼 수수께끼랑은 아예 레벨이 달라. 인정 안 한다고? 좋아, 네가 어렵다고 생각하는 걸 보여줘 봐. 30분 이상 고민하면 내가 진 걸로 할게"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "파루잔에 대해 알기·세 번째",
      "text": "적왕 유적에 실수로 들어가지만 않았으면 수메르에 더 많이 이바지했을 텐데…. 그래도 그전에 쓴 원고와 논문이 헛수고가 아니라서 다행이야. 오늘날 묘론파가 땡잡아서 장치학의 기초가 되었거든. 후후, 나도 「선배」 소리 들을 만해"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "파루잔에 대해 알기·네 번째",
      "text": "학자라면 실패를 덤덤하게 받아들이고 결과를 감당해야지…. 과거든 지금이든 다른 사람의 동정은 절대로 바라지 않아! 게다가 난 실력으로 마지막 수수께끼를 풀고 그 지긋지긋한 곳에서 벗어났다고… 날 동정하는 것보다 나에게서 동기부여와 깨우침을 얻어야 하는 거 아니야?"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "파루잔에 대해 알기·다섯 번째",
      "text": "내 연구 방향은 지위가 더 이상 예전 같지 않아. 지론파가 내 연구비 허가를 안 내주는 것도 한두 번이 아니고…. 묘론파에서는 날 지도 교수로 여러 번 초대했어. 조건이 정말 매력적이었지, 높은 연구비 한도, 더 많은 학생… 그래도 거절했어. 어찌 됐든 아무도 관심 가지지 않는 영역을 연구하고, 전 인류의 지혜를 추진하는 사람이 있어야 하니까"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "파루잔의 취미…",
      "text": "악덕 상인과 용병들이 종종 오르모스 항구에 섞여 들어서 어디서 가져온 건지 모르는 「골동품」을 고가에 판매하는데, 다 낡고 고장 난 쓰레기야! 흥, 내가 볼 때마다 폭로했지. 「골동품 감정」에서 「7명의 집정관」을 제외하면 난 누구한테도 안 밀릴 자신 있어"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "파루잔의 고민…",
      "text": "백 년 전에 가장 큰 고민은 유적 비문의 정보를 읽을 수 없다는 것뿐이었는데, 백 년 후인 지금은 연구비가 제일 고민이네… 어휴! 골치 아파…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "밀가루 반죽을 구우면 향기가 배로 폭발하지! 언제 기회 되면 우리 때에 즐겨먹던 레시피를 한번 대접할게. 바자르에서 아무리 찾아도 없는 「고대 요리 비법」이라구"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "뭐였더라… 파디사라 푸딩, 그건 누가 발명한 거야? 푸딩은 쌀밥으로 만드는 거 아니야? 요즘은 갈수록 요란하다니까. 아니… 고맙지만 난 관심 없어. 네가 만들었어도 사양할게"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "음… 으음… 웬만한 오래된 가게보다 맛있네. 미식계도 점점 발전하고 있는 건가?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "보기에도 좋고 맛도 좋네. 설마 너 요리책을 자주 보는 타입이야?"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "음? 이게 뭐지? 이해하기 힘든 음식이네. 내가 분석해 주길 원하는 거야?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해! 자, 장난감을 만들어봤어. 미니 기관 장치를 모은 거야. 여기에 버튼과 막대가 있고… 옆에 바퀴가 있어…. 마음대로 갖고 놀아. 망가지면 고쳐줄게. 왜 널 애 취급하냐고? 웃기는 소리. 어른이든 아이든 재미와 휴식은 필요하다고"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "훗, 젊은 사람이 아주 빠릿빠릿하구나? 재료 하나 아주 부리나케 찾네"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "음? 무슨 장치라도 풀었어? 힘이 끊임없이 몰려오는걸"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "후후, 열심히 하고 있구나…. 걱정하지 마. 지도와 보호는 선배의 책임이니 널 위험에 빠지게 하지 않을 거야"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "끝없는 지혜의 바다에서 백 년은 단지 일각의 파도를 짧게 볼 수 있는 시간에 불과해…. 아직 깊게 파고들지 않은 학문과 풀지 못한 수수께끼는 너와 내가 함께 노력해야겠네"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "후회해도 늦었어"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "감히 날 도발해?"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "두고 보자"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "광풍의 기어!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "자, 갖고 가서 놀아!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "진리는 돌고 도는 법"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "유물이 나왔다고? 아… 이거?"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "뭐라도 건졌네"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "네가 가져가서 써. 「선배님 고맙습니다」 해야지"
