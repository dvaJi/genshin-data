  "outfits": [
    {
      "id": 204101,
      "name": "별과 달의 약속",
      "description": "모나의 코스튬. 점성술 개념인 「운명이 정해진 순간」을 맞이해 특별히 구입한 옷이다. 천문 관측기 잔금 30% 할인 쿠폰에 감사를!",
      "isDefault": false,
      "characterName": "모나",
      "characterId": 10000041,
      "source": [],
      "filename_card": "UI_AvatarIcon_MonaCostumeWic_Card",
      "filename_icon": "UI_AvatarIcon_MonaCostumeWic",
      "filename_iconCircle": "UI_AvatarIcon_MonaCostumeWic_Circle",
      "filename_splash": "UI_Costume_MonaCostumeWic",
      "filename_sideIcon": "UI_AvatarIcon_Side_MonaCostumeWic"
    },
    {
      "id": 204100,
      "name": "흐르는 별점",
      "description": "모나의 코스튬. 원단 사용량을 줄여 저렴하면서도 편한 점성술사의 복장이다",
      "isDefault": true,
      "characterName": "모나",
      "characterId": 10000041,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Mona_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "내 이름은 아스트로지스트·모나·메기스토스, 「위대한 점성술사 모나」라는 뜻이야. 나한테 점괘를 보려면 내 이름쯤은 기억해 주는 게 기본적인 예의지… 그리고 막힘없이 한 번에 쭉 읊어야 해!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·점괘",
      "text": "정해진 운명을 정확히 보여주는 게 바로 점괘야. 지나친 수식은 오해를 살 뿐이지"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·삶",
      "text": "물욕을 억제하는 건 점성술사 수행의 일부야. 소박하게 살아야만 세상의 진리를 엿볼 수 있어"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·운명",
      "text": "바꿀 수 없고, 거스를 수 없고, 받아들일 수밖에 없어서 운명인 거지"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "이렇게 비가 많이 오면… 별빛도 안 보이고, 수점반도 흐릿해져"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "이 벼락은… 도대체 어느 별하늘에서 내리치는 걸까?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "깨끗한 눈이 녹으면 수점반에 물로 쓰기 딱 좋아"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "흐음~ 점을 치지 않아도 느낄 수 있는 좋은 날씨야"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "타이밍이 안 좋네, 새벽의 계명성이 방금 막 사라졌거든…. 아침밥? 버, 벌써 먹었지"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "벌써 점심이네. 뭐 좀 먹으러 가자, 응? 나… 난 샐러드면 돼. 소박한 삶은… 점성술사 수행의 일환이니까!"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "밤이 됐네. 이제 곧 점을 칠 수 있겠어…. 으음, 내가 어제 원고를 썼던가…?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "벌써 시간이 이렇게 됐는데 내일까지인 원고를 아직 시작도 안 했어…. 뭐? 자러 간다고? 힝… 나도 졸린데…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "모나 자신에 대해…",
      "text": "사람들이 직면하게 될 운명을 정확하게 알려주는 게 바로 점성술사의 일이야. 나 역시 그렇게 하고 있지만… 어떤 사람들은 그걸 받아들이려 하지 않아"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·업무",
      "text": "왜 점괘로 돈을 안 벌고 원고를 쓰는 거냐고?… 난 모라를 버는 것 따위에 「수점술」을 쓰지 않아… 그것 때문에 「수점술」을 배운 것도 아니고"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·나의 운명",
      "text": "나야 모르지. 부득이한 경우가 아니면 점성술사는 자신의 운명을 점치지 않아. 할망구가 이런 행동은 운명의 모순을 초래할 수도 있어서 무지 위험하다고 했어"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·너의 운명",
      "text": "넌 이 세계 사람이 아니라서 정확히 예언해 줄 수 없어. 다만 네가 가야 할 길이 아직 멀었다는 것만은 알려줄게"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해·단점",
      "text": "내가 막 「신의 눈」을 얻었을 때, 그 할망구는 능청스럽게도 「진실을 추구하는 마음이 영원하길」이라고 말했었지. 그런데 몸에 물만 잔뜩 튀고 「수점술」에 아무 쓸모도 없더라고…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "「신의 눈」에 대해·가치",
      "text": "그나저나 「신의 눈」을 장신구처럼 몸에 달고 다니는 건 딱히 상관없어. 이것도 그 쪼잔한 할망구가 나한테 처음으로 준 「교구」인 셈이니까"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "「운명의 자리」라고 들어봤어? 점성술사는 별하늘에 비친 「신의 눈」을 가진 자의 운명이 바로 「운명의 자리」라고 생각해. 과거와 현재, 미래의 모든 것이 그 안에 보이지"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "네 옆에 있는 이 녀석은 대체 어디서 온 거야? 어떤 방법을 써봐도 운명의 흔적조차 찾을 수가 없어… \\n아? 너도 모른다고?"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "진에 대해…",
      "text": "그 페보니우스 기사단의 단장 대행? 그녀의 「운명의 자리」는 「새끼사자자리」로 힘과 너무 일찍 떠맡은 책임을 상징해. 「수사자」는 일찍이 무리에서 떠났지만, 그녀는 사자떼의 영광을 물려받을 때까지 계속 성장할 거야"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "알베도에 대해…",
      "text": "알베도? 아…난 그가 부러워…자질구레한 일들에 신경 끄고 연구에만 몰두할 수 있잖아. 정말 멋진 삶이야. 그 할망구가 조금만 정상이었다면 나도 그런 생활을 할 수 있었을 텐데…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "클레에 대해…",
      "text": "앨리스 씨의 딸 말하는 거지? 그 애는 페보니우스 기사단에서 살면서 알베도의 보살핌도 받고 있지…글쎄, 역시 그녀의 「운명의 자리」답달까. 행운을 상징하는 「네 잎 클로버」거든. 부러워… \\n아, 나한테도 그런 행운이 있었다면 그 할망구를 만나지 않았겠지"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "다이루크에 대해…",
      "text": "다이루크·라겐펜더, 그의 「운명의 자리」는 「밤올빼미」야. 어두운 밤의 경계와 고독한 감시를 상징하지. 그가 인정하는 밝은 대낮이 오기 전까지 그는 계속 홀로 나아가게 될 거야.\\n잠깐, 「밤올빼미」가 부유함을 상징하던가?"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "케이아에 대해…",
      "text": "케이아·알베리히? 그의 「공작깃털자리」는 고귀함과 「화려한 기만」을 상징해. 그는 이미 과거를 끊어냈다고 생각하겠지만, 운명의 그날이 오면 반드시 자기만의 선택을 해야 할 거야"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "리사에 대해…",
      "text": "그녀의 「운명의 자리」는 「모래시계」로 지식, 시간 그리고 등가교환을 상징해. 모래알이 떨어지면 시간…혹은 생명이 한순간에 사라지지. 모래알이 흘러내리는 걸 멈추려면 모래시계를 눕혀서 영원히 멈추게 하는 수밖에 없어. 쉽게 말하면…온갖 방법을 써서 게으름을 피우는 거야"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "벤티에 대해…",
      "text": "벤티? 그 온종일 놀고먹는 음유시인? 그한테 뭐 재밌는 게 있겠어? 한번 점쳐볼게…\\n어? 수점반이 왜…아무것도 안 보여. 바, 바람이 불어서 눈을 못 뜨겠어! 내 모자! 오, 옷이 날아가겠어! 멈춰! 안 해! 안 한다고!"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "모나에 대해 알기·첫 번째",
      "text": "수다 떨고 싶다고? 으음, 난 이렇게 시간 낭비하는 걸 좋아하지 않아. 그리고 아직 써야 할 원고가 많이 남았는걸… 음, 하지만 말동무가 너라면 안될 것도 없지. 하핫, 그냥 기분전환이라고 생각하자!"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "모나에 대해 알기·두 번째",
      "text": "점괘로 벌어들이는 수입…? 감히 돈 같은 「그런」… 걸로! 점성술을 평가하려고 하다니, 잘 들어! 내 「수점술」은 이 티바트 대륙에서 진짜 운명을 엿볼 수 있는 유일한 점술이라구! 모라나 보석 따위론 「운명」의 가치를 잴 수 없어! 그러니까 이런 바보 같은 질문은 그만해!"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "모나에 대해 알기·세 번째",
      "text": "내 점술? 어차피 말해도 모를 걸? 흥, 하지만…설명 정도는 해줄 수 있지.\\n내가 사용하는 「수점술」이란 건 수면에 비친 별하늘의 환상을 보고 추론하는 점술이야. 물속의 환상으로 거짓된 하늘을 비추어 세상의 진실을 엿보는 거지. 이건 그 할망구가 제대로 낸 유일한 연구 성과야"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "모나에 대해 알기·네 번째",
      "text": "아스트로지스트·모나·메기스토스. 이건 전에 그 할망구랑 내가 함께 정한 이름이야. 그녀는 날 가끔 「메기」라고 불러. 자주 쓰는 「모나」와는 다르게 애칭 같은 느낌이랄까…야! 넌 그렇게 부르면 안 돼! 부끄럽단 말이야!…아, 괜히 알려줬어!"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "모나에 대해 알기·다섯 번째",
      "text": "점술가에겐 한 가지 금기사항이 있어, 점괘를 말할 땐 예언 외에 어떠한 조언도 하지 않는다. 내가 다른 사람의 「운명」에 빠지지 않기 위해서지. 하지만 네 점괘를 보는 거라면 이 「금기」는 지킬 필요 없어.\\n왜냐면 우리의 「운명」은 이미 얽혀 있거든"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "모나의 취미…",
      "text": "내 취미? 별하늘을 올려다보는 거야. 지나치게 현실적인 이 세상에선 모두 별하늘을 올려다볼 필요가 있어. 하물며 난 점성술사이기도 하잖아"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "모나의 고민…",
      "text": "도구 수선비에 예약한 천문관측기 잔금도 내야 하고, 학술지 구독비도 아직 안 냈는데, 다음달 집세까지…어떤 걸 먼저 내야 하지? 역시…천문관측기 잔금부터 내는 게 좋겠어. 안 그럼 완판될지도 몰라…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "샐러드, 샐러드는 이 세상 최고의 음식이야. 재료도 싸고, 만들기도 쉽고, 배도 부르고. 게다가 먹기도 편하잖아. 원고를 쓰거나 도구를 고칠 때 빨리 먹어 치울 수 있거든"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "음…비싸고 먹기 불편한 음식. 왜냐면, 으음…모라로 불필요한 식욕을 채우는 건 저속하고 위험하기 때문이야"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "아, 잘 먹었다——널 알게 된 게 이렇게 좋은 일일 줄이야"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "다시 한번 확인할게. 정말… 네가 사는 거지?"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "딱히 까다롭게 굴려는 건 아니야. 그냥… 음… 아직 배가 안 불러"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해. 이 주머니를 줄게. 이 안엔 어려운 고비를 극복하는 데 도움이 될만한 「조언」이 들어있어. 급하게 열려고 하지 마. 앞으로 1년 안에 이 주머니가 스스로 열릴 날이 올 거야"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "역시 이렇게 될 운명이었어. 난 진작 알고 있었다고"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "…조금만 더 가면 세상의 진실을 찾을 수 있을까?"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "거짓된 하늘, 별하늘 아래의 운명은 이미 정해져 있었어"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "물속의 그림자, 잔잔한 물결 속에 계명성이 솟아오르는 게 보여"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "수중 환원"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "…운명의 허영"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "운명이여 물에 비쳐라"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "운명이여 드러나거라"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "이걸로 운명은 정해졌다"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "천명은 거스를 수 없어!"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "이러면 별하늘을 더 잘 볼 수 있겠지…"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "앞으로도 계속 이렇게 좋은 일이 있었으면 좋겠네…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "방세랑 식비를 댈 수 있겠어!"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "우와… 보물을 찾아서 너무 좋아…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "판단할 수 없어…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "얄궂은 운명인 건가…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "여긴… 내 점괘 범위가 아닌데!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "더 버텼다간 쓰러질 거야"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "여긴 네 운명의 종착점이 아니야"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "별하늘이… 어두워…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "거역할 수 없는… 운명…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "추산은 끝났어…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "귀찮게 하네"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "나한테서… 떨어져!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "이건 운명이야"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "어쩔 수 없네"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "뭇별은 모두 내 손바닥 안에 있지…"
    }
  ]
}