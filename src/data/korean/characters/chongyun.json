  "outfits": [
    {
      "id": 203600,
      "name": "청정한 영혼",
      "description": "중운의 코스튬. 도사 일족에게 전해져 내려오는 퇴마 복장이다",
      "isDefault": true,
      "characterName": "중운",
      "characterId": 10000036,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Chongyun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "내 이름은 중운. 우리 가문은 리월에서 오랫동안 거주해 온 퇴마사 집안이야. 오늘 이렇게 우연히 당신과 만난 것도 인연이겠지. 자… 돈은 안 받아. 돈 안 받는다니까!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·퇴마의 방도",
      "text": "도사의 퇴마는 주술과 무예로 완성되지. 새로운 길을 개척해도 좋으나, 결코 올바른 길은 아니야"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·음식",
      "text": "차가운 걸 먹고 마시면 마음을 가라앉힐 수 있어…. 청심을 우려낸 물에 얼음을 넣어 마시는 게 몸에 가장 좋아"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·요어",
      "text": "요마를 몰아내니, 온 세상이 맑고 깨끗하구나. 아, 어… 이런, 다음 구절을 까먹었군"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "빗물은 땅에 닿기 전 하늘에서 떨어지는 가장 맑은 물이야. 요마를 몰아낼 때 아주 유용하게 쓰이지"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "이 벼락 기세가 엄청나네. 요마들도 무서워하겠어"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "기분 좋은 날씨네"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "이 좋은 아침을 헛되게 보낼 순 없어. 빨리 무예를 연마해야겠어!"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "정오가 되니 기운이 넘치네. 서둘러 무예를 연마해야겠어"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "밤은 집중이 가장 잘 되는 시간이야. 서둘러 무예를 연마해야겠어"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "휴, 하루 종일 힘들었을 텐데 너도 어서 가서 쉬어. 내일 귀신이 출몰한다는 그 집에 다시 가보자. 약속이야"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "중운 자신에 대해·도사",
      "text": "우리 도사 일파는 아주 먼 옛날부터 리월을 수호해왔어. 요마를 죽이는 것쯤은 식은 죽 먹기야"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "중운 자신에 대해·의뢰",
      "text": "아무것도 안 하고 흉가의 문만 들어섰을 뿐인데 해결되다니. 이 의뢰도 보수를 받아야 하나?"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·동행",
      "text": "실력이 좀 있어 보이네. 츄츄를… 에헴… 요마를 단숨에 제압하다니. 우리 같이 다니는 게 어때?"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·괴담",
      "text": "너도 이제 리월의 기이하고 흥미로운 일들은 이미 많이 봤겠지? 네가 리월 밖에서 봤다던 요괴들 말이야, 나… 나도 좀 보고 싶은데"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」이 강하긴 하지만, 맹목적으로 거기에만 의존해선 안 돼. 난 도술과 무예를 더 믿는 편이야. 부지런히 배우고 연마하면 실력은 널 배신하지 않아"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "리월 땅에 요마에 관한 소문이 많긴 하지만, 진짜와 가짜가 모두 섞여 있어. 어떤 의뢰들은… 사실 요괴와 아무런 상관이 없거든"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "호로산에 있는 호박엔 진기한 것들이 많이 봉인돼있다고 들었는데, 전해져 내려오는 전설 속의 요마도 있으려나? 정말 한번 보고 싶네"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "종려에 대해…",
      "text": "「왕생당」의 종려 선생? 뭔가 엄청난 분이신 것 같아. 범부는 악을 저지르며 살인을 하고, 우리 도사들은 퇴마를 하는데, 그는 선인의 장사를 지내잖아"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "행추에 대해…",
      "text": "나도 행추의 무예와 의협심은 존경해. 하지만 내가 미리 알려주는데, 걔도 그렇게 착한 것만은 아니야. 만약 진짜 무슨 일이라도 생기면, 꼭 나랑 피해자 동맹 맺자"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "소에 대해…",
      "text": "오래전부터 항마대성님은 어두운 곳에서, 우리 도사 일파는 밝은 곳에서 함께 리월을 수호해왔고, 난 그분을 아주 존경했지. 근데 그분이… 그분이 퇴마 도사는 너무 약해서 언급할 가치도 없다고 하셨어. 나, 난 절대 인정 못 해!"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "호두에 대해…",
      "text": "「왕생당」의 방법이라면 믿을 만하지. 하지만 마치 「너희 도사들은 신경 쓸 거 없어」라며 웃고 있는 얼굴을 생각하면 정말 짜증 나… 후, 진정하자, 진정해"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "치치에 대해…",
      "text": "강시 소녀처럼 보이던데. 도사의 직감으로… 그녀가 보통이 아니라는 걸 느낄 수 있어. 음… 이름도 보고문에서 본 적이 없는데, 대체 누구일까…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "신염에 대해…",
      "text": "신염이 공연하는 곳은 최대한 피해 다녀. 그렇게 열광적인 분위기에 무심코 휩쓸리기라도 한다면, 아무래도 그 영향을 받게 될 거야…. 그러니까, 뭔가 불편해진다고"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "향릉에 대해…",
      "text": "향릉의 요리 솜씨는 모두가 칭찬하지. 하지만 난 그녀가 만든 맵고 뜨거운 요리엔 절대 손도 대지 않아. 아, 아니야…. 아무것도 아니야. 이 슬라임 미끈미끈 버섯 무침 좀 봐. 이런 걸 먹을 수 있겠어?"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "신학에 대해…",
      "text": "집안 어른들이 그녀에 대해 말하는 걸 들은 적이 있어. 그녀의 가족이 겪은 일은… 참 안됐지. 이번에 분가의 먼 친척들이 돌아오실 줄 알았어. 그녀가 살아있단 소식을 듣고는 엄청 기뻐하셨거든. 선물을 준비해서 좋은 날을 골라 모이자고 하셨는데, 평소에 그녀를 전혀 만날 수가 없더라니까…. 잠깐, 항렬로 따지면, 설마 그녀를 「이모」라고 불러야 하나…?"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "야란에 대해…",
      "text": "처음 도사가 됐을 무렵 퇴마를 하러 의뢰인 집에 갔다 오는 길에 그 여자분을 만난 적이 있어. 내 이름을 작은 수첩에 적어놓더라고. 내가 수상한 짓을 했는지 확인하려던 걸지도 몰라…. 그때 이후로는 만난 적이 없어.\\n지금 생각해 보니까, 내가 평소 명상할 때 꼼짝도 안 해서 그랬던 것 같아. 누가 봐도 재미없어 보일 거야"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "중운에 대해 알기·첫 번째",
      "text": "열정만 있고 실력은 없다면 일을 그르칠 뿐이야. 이 점은 내가 잘 알지. 아, 내 경험이란 건 아니야. 어…리월에서 몇 년 동안 세상만사를 보면서 얻은 깨달음이랄까…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "중운에 대해 알기·두 번째",
      "text": "난 선천적으로 「양기가 넘치는 체질」이야. 천년에 한 번 나올까 말까 한데, 모든 요괴는 나만 보면 달아나 버리지. 휴… 사실 좋은 일은 아니야. 요괴를 만나지도 못하는 퇴마 도사라니"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "중운에 대해 알기·세 번째",
      "text": "「양기가 넘치는 체질」 때문에 항상 열기가 넘쳐서 망신을 당한 적이 한두 번이 아니야. 내가 맵고 뜨거운 음식을 먹지 않고, 외출할 때 항상 우산을 쓰고, 격동적인 음악을 피해 다니는 건 모두 양기를 억제하기 위해서지. 언제쯤 이 체질에 익숙해질 수 있을까?"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "중운에 대해 알기·네 번째",
      "text": "앉아서 요마가 나타나기만을 기다리는 건 소용없어. 직접 찾아다녀야지. 내가 리월 사람들을 위해 악한 존재를 물리치고 다니는 건, 사람들의 근심을 덜어줄 수도 있고 내 견문을 넓힐 수도 있기 때문이야. 만약 악령들이 널 괴롭힌다면, 내가 반드시 널 도와주러 올게"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "중운에 대해 알기·다섯 번째",
      "text": "천하의 모든 요마를 제거하는 게 바로 도사로서의 최종 목표야. 언젠가 이 목표를 이루고 온천이든… 절운고추든… 뜨겁고 자극적인 건 모두 다… 해보겠어! 에이… 안 되겠다. 상상만으로도 감정이 격해지는군…. 이러면 안 돼"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "중운의 취미...",
      "text": "나? 난 이야기 듣는 걸 제일 좋아해. 차 명인 유소 씨는 각종 기이한 이야기를 생생하게 전해주시지. 시간 나면 꼭 한번 들어봐"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "중운의 고민...",
      "text": "수소문해서 요괴가 나온다는 낡은 절 한 곳을 정말 어렵게 찾았는데, 나흘을 기다려도 요괴의 그림자조차 안 보였어. 어휴… 괜찮아, 자주 있는 일이야"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "매일 수행이 끝나고 이나즈마에서 온 신선하고 차가운 음식을 먹을 수 있다면 정말 좋을 텐데. 차갑고 상쾌한 식감은 내 모든 피로를 날려줘"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "난 뜨겁고 매운 음식은 절대 못 먹어. 절운고추가 들어간 요리라니, 으, 생각만 해도 무섭네"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "식감이 시원한 게 내 스타일이야! 조금 아껴뒀다가 수련이 끝나면 또 먹어야겠어"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "미안, 네가 정성 들여 만들어줬는데 식혀 먹을 수밖에 없어서…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "이런! 설마 이 맛은… 절운고추?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘은 네 생일이니까 이 얼음 결정으로 만든 꽃을 줄게. 내가 직접 조각해서 만든 거야. 요마를 만나면 이 얼음꽃을 던져봐. 그럼 내가 봉인한 주술의 효력이 자동으로 나타날 거야. 그리고, 생일 축하해"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "퇴마의 술법에도 이런 재료가 자주 쓰이는데, 영기를 높이는 데까지 쓰일 줄은 몰랐네"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "무예를 익히는 것도 술법과 같아. 모두 경지가 있지. 네 가르침 덕에 내 실력도 많이 향상된 것 같아"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "무예에 이러한 경지도 있었다니. 손과 눈이 서로 통하고, 사람과 검은 하나가 된다…. 이제 알 것 같아!"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "이 무예들을 익혔으니 「천하의 모든 요마 제거」라는 목표를 달성할 수 있을지도 몰라. 네가 준 도움은 항상 마음에 새겨둘게. 앞으로 네가 도움이 필요하면 언제든지 날 불러줘"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "검인연빙!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "나와라!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "급여사령"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "내 명을 받들라"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "물렀거라!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "보인환검!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "순순히 죽거라"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "나의 구름을 타는 재주를 보아라"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "이런 물건은 퇴마에 쓸 수 있어"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "같이 고생한 보람이 있네!"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "의외의 수확이야"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "별거 아니야"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "적을 얕봐선 안 돼"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "날뛰지 마라!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내가 도와줄게"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "조금만 버텨!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "역시 아직 부족한 건가…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "요마 제거… 실패…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "도사 일파의 명성에… 먹칠을 했어…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "어찌!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "나한테 맡겨"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "내겐 악귀를 퇴치하는 주문이 있어"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "무술 연습할 시간인가?"
    }
  ]
}