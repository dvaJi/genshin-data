    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "엮여라"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "날아올라라"
    },
    {
      "id": "200001",
