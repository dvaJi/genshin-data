  "outfits": [
    {
      "id": 202200,
      "name": "푸른 바람의 시",
      "description": "벤티의 코스튬. 자유롭고 캐주얼한 음유시인의 복장이다",
      "isDefault": true,
      "characterName": "벤티",
      "characterId": 10000022,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Venti_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "음냐… 잘 잤다, 엇, 안녕, 여행자, 또 만났네~ 날 기억 못하는 거야? 헤헤, 그럼 다시 네 여행에 동행할게. 네 시편은 세상에서 가장 뛰어난 음유시인인 내가 널리 부를 만해!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·하프 연주",
      "text": "계속 듣고 싶다면 내게 사과 하나 줘~"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·사과주",
      "text": "아름드리 나무에 앉아 영원히 줄지 않는 사과주를 즐기고 싶어~ 하아"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·시편",
      "text": "움직여, 여행자. 잃어버린 시편이 아직 우릴 기다리고 있어~"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "와서 물웅덩이를 밟아봐! 누가 물보라를 더 크게 일으키나 보자고!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "엇~ 이렇게 날이 개는 건가? 좀 더 놀고 싶은데"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "눈이 쌓이면… 눈싸움하자!"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "모처럼의 기회인데, 같이 날아볼까?"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "안녕, 새로운 모험을 시작하려고?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "배고파… 하지만 다운 와이너리에 빌붙으러 갈 수도 없고… 어, 너구나! 헤헤, 외출하려고? 나도 데리고 가"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "나 안 졸린데, 함께 산책해줄까?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "쉬려고? 헤헤, 잘 자"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "벤티 자신에 대해…",
      "text": "연습? 흥, 물론 필요없지, 이 티바트에서 내가 못하는 노래는 없어"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·신곡",
      "text": "널 가사에 넣고 싶어! 아, 왜 그런 표정을 짓는 거야? 비용이 걱정되는구나? 하하, 모라는 됐어… 네 이야기를 들려줘!"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·용사",
      "text": "#아… 아… 음…! 헤헤, 용자가 나타나 {M#왕자}{F#공주}를 구하면, 당장 전 대륙에 이 노래를 퍼트리겠어"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·사도",
      "text": "밤 바람 시원하구나, 신의 사도가 되기 딱 좋은 날씨야! 그럼 늦기 전에 빨리 내게 공양을 바쳐야지?"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "우리에 대해·부탁",
      "text": "엇, 바람의 신인 내가 더 노력해야 되나? 그럼 너도 성의를 보여봐, 간절하거나 열렬한 사랑, 아니면…"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "응? 내 신의 눈이 궁금해? 흠… 자, 받아. 마음에 들면 똑같은 걸 하나 만들어줄까? 헤헤헤"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "Olah! 헤헤, 이건 츄츄족 인사야, 이걸 배워서 뭐 하냐고? 와, 아는 게 많을수록 좋은 작품이 나오는 거야, 음, 그러고 보니 츄츄족 언어로 가사를 써본 적이 없구나…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "여행자, 세실리아를 본 적 있어? 조용한 절벽 꼭대기에 말 없이 피는 흰 야생화야, 내 생각엔 티바트에서 가장 아름다운 꽃인 것 같아"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "진에 대해…",
      "text": "기사단 단장 대행… 그녀가 어떤 사람이라고 생각해? 헤헤, 내 생각과 같네, 진지하고 용감하면서도 따스하지, 내 친구와 닮았어…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "다이루크에 대해…",
      "text": "다이루크 어르신과 좋은 관계가 되고 싶다고? 그 사람 집에는 술이 엄~청~나~게~ 많아! 헤헤헤, 난 술 마시면 안 된다고? 그럼… 가서 냄새만 맡아볼게! 너도 맡아봐, 맡기만 하는 건 괜찮아"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "바바라에 대해…",
      "text": "노래를 기막히게 하는 프리스트 소녀를 알아? …응, 아이돌? …음, 하이터치회? 올 live? …그렇구나, 음악은 정말 심오해"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "레이저에 대해…",
      "text": "그 늑대 영지의 백발 소년, 아아, 그래? 늑대에게 키워졌구나… 어쩐지, 그 아이의 체취가 그립더라니…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "모나에 대해…",
      "text": "아, 그 점성술사? 이렇게 말할게. 점술은 내 시와 마찬가지로 술값도 못 모으는 돈 안 되는 쓸모없는 기술이야. 점성술은 그래도 문화적인 전통이라 쓸모없는 것이 아니라고? 흥, 무례하잖아. 그러면 시도 마찬가지로 유용하다구"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "디오나에 대해…",
      "text": "명성이 자자한 캣테일 술집의 술. 하지만…. 으윽, 재, 재채기가. 엣츄! 아니면 가서 술 한잔 사 와. 후하게 사례할게. 정말이야"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "알베도에 대해…",
      "text": "흑토와 백악, 우주와 지층, 순결한 흙에서 나온 최초의 인간… 특징이 너무 뚜렷해서 차마 지나칠 수 없군. 이렇게 위험하고 오래된 기술이 만에 하나 통제 불능 상태가 된다면——휴우, 됐어, 몬드의 문제는 몬드 사람이 해결해야지"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "모락스에 대해…",
      "text": "너, 그 어르신을 만났어? 그는 요즘 어때? 「종려」라는 이름의 일반인이 됐다고? 그 꼰대에게 그건 엄청난 변화일걸. 위로의 의미로 바람이 시작되는 곳에 묻어둔 이 좋은 술을 가지고 만나러 가자. 아 참 그 사람 아직도 강해? 실력이 얼마 남았어? 이렇게 갔다가 얻어터지진 않겠지?"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "유라에 대해…",
      "text": "유라는 술에 대한 센스가 꽤 좋은 편이야. 여름 겨울 불문하고 차가운 걸 마시는 습관은 지금의 몬드에선 아주 드물거든. 헤헤, 그녀와 좋은 술친구가 될 수 있을 것 같아. 응? 내가 로렌스 가문에 대해 만든 노래가… 벌써 유라 귀에 들어갔다고? 하하, 뭐 어때, 같이 부르게 될지도 모르잖아"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "바알에 대해…",
      "text": "듣자니 너 그 안하무인인 라이덴 쇼군도 이겼다면서? 아… 그녀는 그림자 무사였을 때부터 극강의 무예를 추구했지. 이제 별 이상한 구실을 다 갖다 대면서 너한테 대련을 청할 거야. 음, 그녀의 약점을 귀띔해줄 테니 가까이 와봐——바로 「달달한 간식」이야!"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "부에르에 대해…",
      "text": "풀의 신이라… 풀의 신 하면 아무래도 「꿈」과 관련된 권능이 먼저 떠오르겠지? 내가 쓴 시처럼 풀의 신이 만든 꿈에도 낭만과 상상이 가득하거든. 나랑 여러모로 잘 맞는다니까"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "푸리나에 대해…",
      "text": "음유시인이 잘하는 건 연주와 노래에 그치지만, 연극 배우는 훨씬 더 많은 걸 해내야 하지…. 다음 윈드블룸 축제 때 푸리나를 데려와서 같이 공연하는 건 어떨까? 응? 푸리나가 폰타인을 구한 얘길 하자고? 에이, 굳이 그럴 필요가 있을까? 그런 뛰어난 예술가가 세상을 구하는 건 흔히 있는 일이지, 안 그래?"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "하보림에 대해…",
      "text": "한 사람 또 한 사람이 칠흑의 위협에 맞서다 불타 사라지는 장작이 되었어. 이 세계는 정말 매정하기 짝이 없다니까. 하지만 마비카의 지도 아래, 그들은 마신에 필적할 업적을 세웠어…. 헤헤, 「그녀」 때부터 나타 사람들은 전부 그랬던 것 같아. 참, 마비카는 술을 좋아한다며? 그럼 어디…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "달리아에 대해…",
      "text": "여행자, 바람의 소리를 듣고 바람의 인도를 받고 싶어? 그럼… 그 부제를 찾아가면 될 거야. 하하, 농담이고, 넌 언제든지 나와 술 한잔하면서 이야기를 나눌 수 있어! 내가 평소에 왜 달리아를 통해 소식을 전하는지는… 너도 알지? 달리아는 시끄러운 바람을 쫓는 데 열중하면서도 결코 자신의 방향을 잃지 않으니까 말이야"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "두린에 대해…",
      "text": "또 한 마녀의 아이가 몬드에 왔네. 몬드가 더 시끌벅적해졌어. 이 꼬마 친구가 내 커다란 친구랑 놀고 싶어 하는 것 같길래, 내가 소소하게 자리를 주선해 줬거든? 그랬더니 커다란 친구가 꼬마 친구보다 더 신나서는, 배를 두드리며 빙글빙글 돌더라. 아이쿠, 커다란 친구가 들어버렸나? 우리 얼른 나무 뒤로 숨자"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "벤티에 대해 알기·첫 번째",
      "text": "마침 잘 왔어, 여행자, 네 소원이 뭔지 들어보고 싶어"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "벤티에 대해 알기·두 번째",
      "text": "너와 함께하는 여행은 정말 재미난 일이야, 한 가지 흠이 있다면 네 곁의 그 쪼매난 녀석이지. 너무 잘 먹어~ 너희 식비 어마어마하지? 하하"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "벤티에 대해 알기·세 번째",
      "text": "불의 신은 제멋대로 날뛰는 전투광이야. 바위의 신은 사람 마음을 모르는 꽉 막힌 놈이고. 그런 걸 어떻게 아냐고? 하하, 서사시에 그들의 이야기가 다 나와있어. 그 시절의 이야기들이 전부"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "벤티에 대해 알기·네 번째",
      "text": "셀레스티아, 나도 그곳까지 날아갈 수 없을지 몰라. 게다가 거기에는 감로수가 없어서 맛난 과일이 열리지 않아, 그러니 술맛은 더욱 별로겠지? 헷, 초대를 해도 가고 싶지 않아"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "벤티에 대해 알기·다섯 번째",
      "text": "내 소원? 음, 예전엔 온 세상을 떠돌아다니는 거였어. 지금도 그런데 바람이 하나 더 생겼어. 너와 함께 떠돌고 싶어, 네가 있어야지만 완전해져. 기록하는 사람은 모험가와 함께해야만 완전해지는 법이지, 헤헤헤!"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "벤티의 취미…",
      "text": "나 술 좋아해! 바람도! 아, 바람으로 빚은 술이 있다면 좋겠네"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "벤티의 고민…",
      "text": "사실 고양이가 근처에 있으면 난 재채기를 참을 수 없어…. 에-에-에취! 으후…. 생각만 해도 재채기가 나오네…. 하, 이 병을 고칠 방법이 있을까?"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "너도 사과 하나 먹을래? 방금 땄어. 음, 아~ 사각사각하고 달아. 사과야말로 신의 선물이지!"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "뭐 맛난 거 만들고 있는 거야? 엇? 뜨거운 치즈 케이크! 이거… 안 돼. 뜨겁고 찐득찐득, 너무 느끼해…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "아, 대만족이야! 내일도 해줄 거지? 모레도 해줄 거지?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "후, 배불러라. 과일도 못 먹겠어…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "나조차도 먹기 힘든 음식이라니. 음… 이것 참 곤란한걸"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "예전에 친구가 생일에는 케이크를 먹어야 한다고 했는데…. 자, 사과 케이크! 숟가락 받아, 오븐에서 꺼낼 때 좀 무너져서 사과 파이처럼 보여. 아, 디저트는 역시 어렵군"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "우옷! 방금 무슨 일이 일어난 거지?!"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "수고했어. 음악 좀 들으며 쉴래? 기상곡이 좋아? 아니면 세레나데?"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "자, 여기 앉아. 내가 새로운 시를 썼다고~ 「여행자의 바람」이라는 시야"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "아…. 이 풍경들 질리도록 봤는데, 네가 옆에 있으니 또 다르네. 너 기이한 능력을 한 무더기 숨기고 있는 건 아니지…? 음, 그것도 괜찮네. 내가 사람 보는 눈이 정확하다는 거니까, 하하핫"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "와우——"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "여기야"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "발 밑을 조심해"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "함께 놀자"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "도망갈 생각 마!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "바람이 불고 있어!"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "나 빠르지?"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "휘이~"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "큼큼, 「보물상자의 노래」를 들어봐!"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "헤헤, 「바람 신의 가호」에 감사 인사를 올리지 않을래?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "수확이 엄청나. 술을 잔뜩 바꿀 수 있겠어~"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "잠깐, 이건 장난이 아니야!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "아야, 왜 나만 때리는 거야"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "너무한 거 아냐~"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내게 맡겨"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "아직 포기할 수 없어"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "잠깐 눈 좀 붙이자…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "아야, 줄이 끊어졌어…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "으악…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "아야…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "정말 거칠구나"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "조율 완료~"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "오래 기다렸지?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "몸 풀 준비는 됐어?"
    }
  ]
}