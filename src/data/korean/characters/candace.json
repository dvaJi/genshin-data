  "outfits": [
    {
      "id": 207200,
      "name": "사막과 밤",
      "description": "캔디스의 코스튬. 옷에 수놓은 황금빛 사막과 고향의 밤하늘은 어디를 가든 늘 캔디스와 함께한다",
      "isDefault": true,
      "characterName": "캔디스",
      "characterId": 10000072,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Candace_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "멀리서 온 여행자여, 사막 밤길은 험난하니 이곳에서 하룻밤 머물고 가. 내가 너의 꿈 없는 밤을 돌봐줄게"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·방패와 창",
      "text": "방패만으로는 소중한 것을 지킬 수 없어서 창을 들게 됐어"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·삶",
      "text": "모두가 평온한 삶을 유지할 수 있다면, 난 그걸로 만족해…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·소원",
      "text": "어떤 방법으로든 소중한 것을 수호해낼 거야. 그게… 과분한 소원이라 할지라도"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "감기 조심해"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "천둥소리가 무섭니?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "이 하얀 것들은, 정말 차갑네…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "사막에선 이런 바람이 모래폭풍을 일으키니 조심해야 해"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "내가 곁에 있으니까, 불안하면 내 손을 꼭 잡아"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침이야, 어젯밤은 잘 잤어?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "벌써 점심이네. 햇볕이 따가우니까 그늘진 곳에서 쉬는 게 좋겠어"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "밤이구나. 어둠 속에는 말 못 할 비밀이 얼마나 숨겨져 있을까…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "벌써 자야 할 시간이네. 먼저 자. 밤은 아름다운 만큼 치명적이니까 내가 불침번을 서 줄게"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "캔디스 자신에 대해·눈동자 색",
      "text": "이상해 보여? 호박색이나 푸른색이나, 다 흔한 색 아닌가…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "캔디스 자신에 대해·아루 마을",
      "text": "아루 마을에서 태어나 자란 나는, 어렸을 때부터 할아버지의 수호자 자리를 물려받기로 정해졌지… 하지만 지금은 내가 기꺼이 받아들인 천직이 됐어"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "캔디스 자신에 대해·부모님",
      "text": "아카데미아 학자였던 아버지는 연구를 위해 아루 마을에 왔다가 어머니와 만나셨지. 어머니에 대한 일은 다 아버지한테서 들은 거야…. 내가 태어난 날에 영원한 밤으로 떠나셨거든…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·귀한 손님",
      "text": "넌 아루 마을의 영원한 귀빈이야. 여행하면서 지치거나 힘들 땐 언제든지 쉬었다 가. 아루 마을과 난… 영원히 널 환영해"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·보물함",
      "text": "누구나 마음속에 소중한 것을 담은 보물함을 품고 있고, 평생 그것을 수호하지. 내 보물함 속에는 뭐가 들어있는지 맞혀볼래?"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "내가 「신의 눈」을 얻었을 때 마을 사람들은 모두 아흐마르의 은혜라고 했지…. 하지만 나에겐 별로 중요치 않은 사실이야. 난 신의 은혜가 있든 없든 「수호자」의 책임을 다할 거니까"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "난 아루 마을에서 지내는 게 좋아. 그리고 내 방심과 불찰이 지금의 삶을 파괴해버릴 수 있다는 사실에 경각심을 갖고 있지"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "대추야자를 본 적이 있어? 마을 사람들은 그걸 사탕으로 만들어 먹는데, 정말 달고 맛있어, 관심 있으면 너도 한번 먹어봐"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "작은 쿠사나리 화신에 대해…",
      "text": "아흐마르의 혈통을 이어받은 내가 이곳에서 살아남은 건, 그녀의 자비 덕분이겠지. 고맙지만, 어찌 됐든 난 사막의 딸이야…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "레일라에 대해…",
      "text": "「몽유병 걸린 이상한 소녀」라… 방사벽 근처에서 본 적이 있어. 이해할 수 없는 얘기를 하거나 서식을 작성하곤 했지…. 그러면 기분이 나아 보이던데, 어쩌면 그녀만의 스트레스 해소법일지도 모르겠네"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "알하이탐에 대해…",
      "text": "이상한 수메르 학자였어, 그의 생각과 견해는 독특하고 예리했지…. 그 예리함이 아루 마을에 해를 끼치지 않았으면 좋겠어"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "사이노에 대해…",
      "text": "아카데미아의 대풍기관은 방사벽 이쪽에 자주 오지 않는데, 요즘은 종종 보이더라고. 도금 여단에선 그에 대한 무서운 전설이 퍼지고 있어…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "데히야에 대해…",
      "text": "데히야는 아루 마을에 묵을 때마다 도금 여단 부하들을 잘 관리해서 내 수고를 덜어줬어. 사실 데히야씨는, 털털한 모습과는 달리 아주 귀여운 사람이야"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "세토스에 대해…",
      "text": "적왕의 백성은 긍지 높은 사람들이지. 세토스도 마찬가지야. 세토스 일은 들었어. 헤르마누비스의 영광이 능력 있는 자와 함께하게 됐네. 요즘 수메르성에서 활발하게 활동한다던데, 사이노네 친구들과 아루 마을에 놀러 가자는 얘기도 했대. 손님이 온다는 얘기라 기대하는 중이야"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "캔디스에 대해 알기·첫 번째",
      "text": "나에 대해 알고 싶어? 썩 좋은 이야기는 아니지만, 정 듣고 싶다면… 깊은 밤 모닥불 옆에서 얘기해줄게"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "캔디스에 대해 알기·두 번째",
      "text": "우리는 신의 가호를 잃은 일족이야. 거짓보단 어두운 미래야말로 우리의 진정한 적이지. 거짓을 품은 채로 가시밭길을 걷는 건… 이기적으로 진실을 품고 죽는 것보다 더 고상한 게 아닐까…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "캔디스에 대해 알기·세 번째",
      "text": "아직도 적왕이 부활할 것이라고 믿는 사람들이 있지만 그건 불가능해, 과거는 모래알과도 같아서 바람 따라 흩어지는 게 자연스럽지"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "캔디스에 대해 알기·네 번째",
      "text": "내 방패? 아, 마을 밖 사람들의 말에 의하면, 이 방패에는 「벤누」의 축복이 깃들어 있어서 사막의 모래 자갈과 모래폭풍을 원하는 대로 부릴 수 있다지…. 외지인들의 망상일 뿐이지만, 어쨌든 나한테는… 잘 맞는 편이야"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "캔디스에 대해 알기·다섯 번째",
      "text": "이 호박색 눈으로 네 미래를 보고 싶어…. 햇살 같기도 하고 황금 같기도 한 금색이겠지. 네 앞날이 순조롭기를 진심으로 축복할게"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "캔디스의 취미…",
      "text": "내 취미는 마을에서 산책하는 거야. 변함없는 마을을 보면 오늘이 항상 아름다웠던 과거처럼 느껴지거든"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "캔디스의 고민…",
      "text": "가끔 주제를 모르는 악당들이 아루 마을의 평화를 파괴할 때가 있어. 녀석들을 마수가 득실대는 골짜기로 쫓아내는 건 너무 관대했나? 혹시 더 좋은 방법 있어?"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "음식은 질보다 양이 더 중요해… 사막에서 지내려면 많은 에너지가 필요하거든. 지친 하루의 마무리로 배불리 먹는 건 정말 행복한 일이지"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "생선이 싫은 건 아니지만 먹기 까다로운 것 같아. 사막에선 생선 먹을 일이 별로 없다 보니 가시를 바르는 게 서툴러서 부끄러운 모습을 보였네"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "정말 맛있어. 이렇게 맛있는 음식을 준비하느라 고생 많았지?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "방랑하는 여행자의 음식에서 고향의 맛이 느껴지네"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "내 입맛이 너무 보수적인가 봐…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해! 너는 오늘 태어났지, 태어났다는 건 정말 굉장한 일이야. 생일 소원이라도 있어? 네가 험한 곳으로 가고 싶으면 호위가 되어주고, 쉬고 싶으면 아루 마을에서 최고의 고기구이와 음료를 대접해줄게"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "이 힘으로 더 많은 이들을 지킬 수 있다면…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "모든 걸 막는 방패와 모든 걸 뚫는 창이라… 걱정 마, 시도해보진 않을게"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "사람들은 「현재」에서 힘을 얻어 「미래」의 불안에 대해 대비하려 하지. 내가 창술과 방패를 익힌 것도 지금의 평화를 수호하기 위해서야"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "지금의 난 네 앞에 닥칠 그 어떤 위험도 막아낼 수 있어. 그러니까 날 믿으면 두 눈을 감고 적을 맡겨만 줘"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "부서져라!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "비켜!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "덤벼라!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "내리찍는다!"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "별거 없군!"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "허점 발견!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "결전의 기도!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "우리에게 축복을!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "수호를 위하여!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "다 필요한 물건들이야…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "어때, 마음에 드는 건 있어?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "도움이 되는 물건이 있기를"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "자비는 필요 없어"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "아직도 회개하지 않은 거야?"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "좀 꺼져줄래…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "푹 쉬어야겠어…"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "내 뒤에 서!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "수련이 부족했나…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "지켜주지 못해서 미안…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "방패가 깨지는구나…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "괜찮아"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "제법인걸"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "이깟 상처쯤이야…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "위험한 일이 생겼어?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "날 따라와"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "널 지켜줄게"
    }
  ]
}