  "outfits": [
    {
      "id": 202501,
      "name": "비에 물든 대나무",
      "description": "비운 상회에서 행추를 위해 준비한 연회 의상. 청아한 대나무 무늬와 완벽에 가까운 마름질도 훌륭하지만, 특히 행추의 마음에 드는 부분은 얇은 소설책 한 권을 넣을 수 있을 정도로 넉넉한 속주머니다",
      "isDefault": false,
      "characterName": "행추",
      "characterId": 10000025,
      "source": [],
      "filename_card": "UI_AvatarIcon_XingqiuCostumeBamboo_Card",
      "filename_icon": "UI_AvatarIcon_XingqiuCostumeBamboo",
      "filename_iconCircle": "UI_AvatarIcon_XingqiuCostumeBamboo_Circle",
      "filename_splash": "UI_Costume_XingqiuCostumeBamboo",
      "filename_sideIcon": "UI_AvatarIcon_Side_XingqiuCostumeBamboo"
    },
    {
      "id": 202500,
      "name": "남빛 비단",
      "description": "행추의 코스튬. 비운 상회에서 판매하는 고급 비단으로 짠 적삼이다",
      "isDefault": true,
      "characterName": "행추",
      "characterId": 10000025,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xingqiu_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "소생 행추라 하옵니다. 무수한 책의 바다를 헤매는 책벌레죠. 뛰어난 재능은 없으나, 최선을 다해 당신을 돕겠습니다. 모처럼 느끼한 대사를 해봤는데, 나쁘지 않군"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·아무도 없는 밤",
      "text": "「이따금 아무도 없는 달 밝은 밤에, 홀로 소담에서 악룡을 무찌르네」"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·문장",
      "text": "「옷자락에 문장을 담고, 홀로 글을 쓰는 재주를 익히겠다 말하네」"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·잠깐의 휴식",
      "text": "이른바 「어지러운 속세에서 잠시 동안 한적함을 얻는다」로군, 하하"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "잡담·독서",
      "text": "이러이러해서, 이렇게 됐구나…. 음? 다음 이야기가 궁금하다면, 다음 회를 보세요? 으…"
    },
    {
      "id": "1105",
      "type": 1,
      "title": "잡담·신간",
      "text": "「만문집사」에 새 소설 들어오는 날짜가 거의 다 됐군. 그럼… 가는 길에 한번 들러볼까?"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "그러고 보니, 우리 상회에서 만드는 금단 우산은 햇빛도 못 가리고 비도 못 막아. 유일한 용도는 벽에 걸어서 장식품으로 사용하는 것쯤이랄까"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "날이 맑아져서 다행이야. 안 그럼 내 책들에 곰팡이가 폈을지도 몰라"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "이런 날씨에는 서점보다 집이 더 좋은 것 같아. 집에선 따뜻하게 불을 지필 수 있지만 서점에선 책 때문에 불을 지필 수가 없잖아"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "무예를 연마하기… 아니, 책 읽기 딱 좋은 날이네. 내 얼굴에 뭐가 묻은 것도 아닌데 너무 그렇게 쳐다보지 마"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침. 이렇게 소중한 아침 시간엔 하고 싶은 일을 하는 게 제일 좋지"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "점심은 밥 말고 떡이나 과자 같은 간식이 먹고 싶네. 서재에서 먹으면 아버지랑 형이 모를 거야…. 응? 너도 같이 먹고 싶다고? 음… 책에 부스러기만 흘리지 마"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "반딧불이를 좀 훔쳐 와서 책을 읽을까? 음, 농담이야. 눈 나빠지니까 진짜로 하지는 마"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "내일도 같은 장소에 있을게. 길을 잃지만 않는다면 분명 날 찾을 수 있을 거야"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "행추 자신에 대해…",
      "text": "사람들 앞에서 예의 바르게 행동하는 건, 내가 비운 상회의 둘째이기 때문이야. 네 앞에서 이렇게 편안하게 있을 수 있는 건, 아마 너는 남들과 같은 눈으로 날 보지 않아서겠지"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·책벗",
      "text": "넌 나의 책동무잖아? 뭐? 싸움? 고화파? 전우? …윽! 무슨 소릴 하는 거야. 이건 우리끼리 비밀로 하기로 했잖아!"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "#우리에 대해·{F#의남매}{M#의형제}",
      "text": "너와 절운간 제단으로 가서 의를 맺어야겠어. 아니, 거절하면 안 돼. 넌 내 속사정도 알고 있고, 내가 계속 숨겨왔던 내 진짜 모습까지도 알아버렸어…. 절대 이 일에서 손 떼지 않겠다고 약속하면 모를까, 널 그냥 놓아줄 순 없어"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해·고서",
      "text": "「신의 눈」에 관한 기록은 거의 없지만, 내가 수집한 고서 중에 이를 특이하게 묘사한 내용이 있어, 이따 보여줄게"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "「신의 눈」에 대해·깨달음",
      "text": "난 책 속의 깨우침을 받고, 창술과 검술의 본질은 바로 동술이란 걸 깨달았어. 음, 설명하자면 복잡한데… 정말 알고 싶다면, 나랑 같이 「왕산청」에 가보자. 미리 말해두지만, 가보고 웃으면 안 돼"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "리월에서 꼭 가봐야 할 곳? 아, 어려운 문제군. 하지만 없어지면 가장 속상할 것 같은 곳이라면… 1위는 당연히 「만문집사」야. 「고화당」은 10위쯤 되려나"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "예전엔 토끼를 좋아했었는데, 지금은 사슴이 더 좋아. 나한테 「절체절명 속에서 의협심을 일깨울 수 있길」이라는 말은 모든 걸 버릴 수 있는 각오를 의미하거든. 사슴은 절망 속에서 새로운 생명을 얻는 희망을 상징해. 다시 한번 보고 싶네"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "북두에 대해…",
      "text": "북두 님을 정말 존경하지만, 나를 「녀석」이라고 부르거나 만날 때마다 머리카락을 쓰다듬는 건 안 하셨으면 좋겠어"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "응광에 대해…",
      "text": "「천권」 님은 내가 존경하지 않을 수 없는 분이야. 안 그러면 아버지와 형에게 폐를 끼치게 되거든. 응? 그분에 대해서? 글쎄, 음… 역시 그만둘래. 다른 사람을 험담하긴 싫어"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "중운에 대해…",
      "text": "휴, 중운 그 녀석도 내 진짜 모습을 알고 있긴 하지만 함께 임무에 나서는 건 신중히 생각해 봐야 해. 아직도 「무」예에만 집착하고 의「협」의 마음은 전혀 이해하지 못하고 있거든. 아직 훈련이 더 필요해. 특히… 매운 걸 먹는 훈련? 하하"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "운근에 대해…",
      "text": "운근은 맛있는 음료만 마시면 새로운 작품을 쓸 원동력이 생기나 봐. 그래서 난 운근이 작품 쓸 의욕이 없을 때 가져다줄 찻잎을 항상 침대 밑에 쟁여두지. 그럼 무협 소설 이야기를 원 없이 들을 수 있어!"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "호두에 대해…",
      "text": "그 소녀가 바로 현재 「왕생당」의 당주야. 어? 그녀의 성품이 어떻냐고? …거리에 떠도는 소문으로 성품을 판단할 순 없지. 누군가에 대해 알고 싶다면, 그 사람이 뭘 원하는지 보면 돼"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "치치에 대해…",
      "text": "항상 느끼는 거지만, 치치는 수수께끼투성이야. 백출 씨가 옆에 있으면 그 애와 대화 몇 마디 하기도 힘들지. 우리… 백출 씨가 진찰하러 나간 틈에 노려볼까?"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "향릉에 대해…",
      "text": "향릉의 표정은 항상 주의해야 해. 특히 식자재를 구하고 돌아온 향릉이 기쁘게 웃을수록 위험해. 새로운 메뉴를 먹어보라고 끈질기게 들러붙기라도 하면… 그런 상황이 오면 난 항상 중운에게 맡기지만 말이야"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "신염에 대해…",
      "text": "신염은 도대체 어디서 공연하는 거야? 그 엄청난 관통력을 지닌 소리를 피할 곳이 흘호암에서부터 옥경대까지 그 어디에도 없다고…. 휴, 조용히 책을 읽던 날들이 그립구나"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "알베도에 대해…",
      "text": "다음권, 다다음권, 다다다음권의 주요 장면에 들어갈 삽화를 전부 생각해뒀어! 아, 영감이 떠올랐을 때 빨리 기록해서 백악 선생님께 보내야겠다…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "종려에 대해…",
      "text": "아버지와 형이 그분을 극진히 대접하는 걸 본 적 있어. 예를 차려 인사한 거로 봤을 때… 아마 지위가 엄청 높으신 게 아닐까? 선인의 장례를 치른다고 들었는데, 엄청난 신분을 숨기고 있는 것 같아. 같이 그 비밀을 파헤치러 가지 않을래?"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "신학에 대해…",
      "text": "신학 씨가 날 보는 눈이 좀 험악한 것 같아서 쉽게 말을 못 걸겠어. 음, 이상해. 혹시 내가 무의식중에 신학 씨한테 실수라도 한 걸까? 아니면… 그 주위 사람에게 실수했나?"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "야란에 대해…",
      "text": "「천 가지 얼굴」을 가졌다는 말 들어봤어? 야란 씨를 보면 그런 느낌이 들어. 우리 집에 왔을 때 아버지와 형님이 예를 갖춰서 대하니 야란 씨도 그에 맞게 행동했어. 아주 상냥하고 점잖은 누나처럼. 근데 다른 곳에서 봤을 땐 전혀 다른 느낌이었지"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "가명에 대해…",
      "text": "가명이 하는 일은 꽤 협객스러워. 상상해 봐, 폭풍이 몰아치는 밤, 비범한 무예 실력을 가진 검은 옷의 소년이 전설 속 신수와 함께 도적과 악당들을 물리치는 모습을…. 가명이 좀 한가해지면 그가 호송원 일을 하며 겪은 일화를 들어보고 싶어. 너도 같이 들으러 갈래?"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "행추에 대해 알기·첫 번째",
      "text": "요새 어떻게 지내? 시간 있으면 「만문집사」에 와서 한번 둘러봐"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "행추에 대해 알기·두 번째",
      "text": "왜 맨날 혼자서 책을 읽냐고? 배움을 좋아하는 게… 나쁜 습관은 아니잖아. 특별한 이유는 없어. 음? 정말 없다니까"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "행추에 대해 알기·세 번째",
      "text": "오늘 시간 있다고? 좋아, 나도 언제든 출발할 수 있어. 책? 괜찮아, 책은 갔다 와서도 볼 수 있지만 우리의 도움이 필요한 사람을 오래 기다리게 할 순 없지"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "행추에 대해 알기·네 번째",
      "text": "너한테 좋은 생각이 있다고? 우리의 경험을 소재로 탐정과 무협 요소가 모두 가미된 소설 《만문집 사건부》를 쓰자고? 응? 아하하하… 좋은 생각이네. 하지만 무리야. 응, 절대 안 돼"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "행추에 대해 알기·다섯 번째",
      "text": "「끝없이 긴 시구를 엮어 비단을 만드네」 휴, 나도 이런 평가를 받고 싶군. 너한테만 알려주는 건데, 사실 나도 소설을 쓰고 있어. 지, 지금은 보여줄 수 없지만, 나중에… 나중에 서점에서 볼 수 있을 거야"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "행추의 취미…",
      "text": "내 취미는 당연히 독서지. 어떤 책이든 다 읽어. 응? 왜 그런 웃음을 짓고 있는 건데? 음, 이건 우리 둘만 알고 있자. 대놓고 이야기하긴 아직 좀 그래. 말해버리면 재미없지"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "행추의 고민…",
      "text": "고민이라, 음… 언젠가 형이 가업을 이어받게 되면, 난 어떻게 될까? 이런 근심 걱정 없는 생활도 곧… 아, 내 신분 같은 걸 말하는 게 아니야, 그런 건 별로 신경 안 써. 단지 우리 형이 좀 둔해서, 내가 없으면 안 되거든"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "난 다과류와 월 요리의 해산물을 좋아해. 우리 집은 항상 음식을 담백하게 먹거든"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "난 당근을 엄청 싫어해. 어렸을 때 어머니가 당근을 잘게 다져서… 역시 더 이상 말하는 건 무리야. 기억 속에서라도 그 맛은 정말…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "이렇게 맛있는 요리는 한 번 먹으면 평생 잊지 못할 거야"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "이 정도 솜씨면 거리에 식당 하나 차려도 될 것 같은데, 어때?"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "아냐, 난 괜찮으니까 사양 말고 어서 먹어"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일·축복",
      "text": "큼, 크흠. 생신을 축하합니다. 그대의 생신을 축하합니다~"
    },
    {
      "id": "7002",
      "type": 1,
      "title": "생일·풍습",
      "text": "기록에 의하면, 천성석교는 상고 전쟁 때 바위 신 모락스가 던진 석창이 무너지면서 생긴 거래. 생일날 다리를 건너 양쪽 바다에 모라를 던지면 일 년의 평안을 기원할 수 있다더군…. 생일은 일 년에 한 번뿐이니까, 가고 싶으면 어서 가봐…. 거짓말 아니야, 진짜야. 진짜라니까, 어서 가봐"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "능력이 부족하다면, 내 마음속에 있는 그 글자도 종잇장에만 머물게 되겠지"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "마음에 선과 악을 구분하는 기준이 없다면, 노력하는 방향이 잘못되기 마련이지. 중요한 것을 잃고 지엽적인 것만을 추구한다면, 폭력만을 쫓는 속인이 되고 말 거야"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "내가 추구하는 그 글자가 리월의 모든 곳에서 통하는 건 아니야. 지금까지 도를 행하면서 그 점은 일찌감치 깨닫고 있었어"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "네가 같이 있어 준 덕분에 무예든, 그 글자에 대한 이해든 나 스스로도 정말 만족스러웠어——에, 됐다. 나도 더 이상 「의협」에 대해 숨길 필요가 없겠군. 나의 「의협」에 대해선 아버지와 형도 의아해하지 않으실 거야. 다만, 드러내지 않고 겸손히 행동하는 습관은 지켜야겠지"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "빗줄기를 그리긴 어려운 법"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "베어라——!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "이 검을 알아보겠느냐!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "고화심비"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "직시성금"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "재우유홍"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "날 따라와"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "대시 시작·두 번째",
      "text": "서두르자"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "아주 좋아"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "보물찾기라니, 협객한테 딱 맞는 경험이네"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "잃어버린 고서도 몇 권 있다면 완벽할 텐데"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "계획에 차질이 생겼군…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "이제부터 봐주지 않을 겁니다"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "「절체절명 속에서 의협심을 일깨울 수 있길」"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "이리 와봐, 나한테 좋은 생각이 있어"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "신중히 행동하는 게 좋겠어"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "한 수… 배웠습니다…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "등불이 화려하면 쉽게 꺼지는 법이지…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "내 실수야…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "무방하다"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "방심했군"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "이런…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "준비가 완벽해야 일이 성사되는 법"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "천하의 영웅들에게 부끄럽지 않을지어다"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "악한 것을 벌하고 의를 행하리라"
    }
  ]
}