  "outfits": [
    {
      "id": 203800,
      "name": "신월의 별빛",
      "description": "알베도의 코스튬. 알베도가 실험할 때마다 입는 페보니우스 기사단의 연금술사 제복이다",
      "isDefault": true,
      "characterName": "알베도",
      "characterId": 10000038,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Albedo_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "난 페보니우스 기사단의 수석 연금술사, 알베도야. 네 몸에 있는 별바다의 기운을 가까이서 연구해보고 싶어. 앞으로 너랑 단둘이 자주 볼 것 같네"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·사생",
      "text": "경치 좋군~ 쉬어갈 겸 그림으로 남겨야겠어"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·탐구",
      "text": "「세계의 진실」은… 도대체 뭘까?"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·회고",
      "text": "두 발로 직접 땅을 측량해 「미지의 영역」을 알아가는… 그 느낌이 그립군"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "땅이 촉촉해서 폭탄열매 뿌리를 채집하기 좋겠어. 괜찮아, 내가 하면 돼"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "스승님…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "빛도 잘 들고 생물들의 움직임도 활발해. 흠, 그림 그리기 딱 좋군"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침, 고대 유물 찾으러 갈 준비 됐어?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "안녕, 네 발소리를 들었어. 공방 밖은 너무 시끌벅적하다니깐"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "밖이 드디어 조용해졌네, 후"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "잘자, 먼저 가서 쉬어. 난 마지막 실험도 끝내버리려고. 그렇게 궁금하면…내일 다시 왔을 때, 실험 결과에 대해 토론해보자"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "알베도 자신에 대해·천재",
      "text": "천재? 사람들이 날 그렇게 부르지만… 사실 난 그렇게 생각하지 않아"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "알베도 자신에 대해·인간관계",
      "text": "사람 사귀는 건… 귀찮아. 한번 맺은 관계는 꾸준히 신경 써야지 연락이라도 끊겼다간 다시 회복하는데 더 많은 시간이 걸린다고…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·실험",
      "text": "너… 나랑 실험하려는 거야? 영광인걸?\\n아, 긴장하지 마. 내 실험은 위험하지만 애꿎은 사람들은 보통 안 다쳐"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·조수",
      "text": "내 조수가 되어줄래? 옆에서 여러 번 지켜봤으니 분명 잘할 거야. 걱정 마, 처음이어도 내가 옆에 있으니까 괜찮을 거야. 내가 좀 잘 가르치거든, 물론 네 천부적인 재능도 믿어"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」? 비커랑 도가니와 다를 바 없는 그냥 실험 도구일 뿐이야. 단 하나, 흥미로운 점은 그 원리인데… 언젠가 연구해서 밝힐 거야. 그저 시간문제일 뿐이지~"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "네가 거절하면 속상할 것 같아서 말을 꺼내기 어려웠어…\\n음…네 옆에 날아다니는 그 녀석이 궁금한데 내가 연구 좀 해봐도 될까?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "석화 고목에 관한 걸 더 많이 알고 싶다고? 음… 인근 비경에서 네가 봤다던 나무는 사실 그리 오래된 게 아니야. 잘 여문 나무는 보통 2~3km까지 자랄 수 있고, 뿌리에 큰 거미가 모이지. 그 거미를 치자와 레몬그라스에 묶고 백두구를 발라 몇 시간 동안 훈연하면 그 향기는 정말이지…잊을 수가 없어"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "가족에 대해…",
      "text": "가족? 앨리스 아줌마는 내가 엄마라 부르길 바랐지만…. 흠, 가족을 생각했을 때 가장 먼저 떠오르는 분은 그래도 스승님이야. 내가 기억할 무렵부터 난 스승님과 함께 탐험했고, 스승님은 연금술과 무수한 세상의 지식을 가르쳐 주셨어. …「가족」 혹은 「스승님」이란 두 단어로는 내 마음을 다 표현할 수 없지"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "설탕에 대해·방향",
      "text": "설탕? 「생물 연금술」에 왜 그렇게 집착하는지 알 것 같아…. 아무튼 연구가 잘 돼가는 것 같아서 나도 기뻐"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "설탕에 대해·고집",
      "text": "학문적으로 협력하는 건 즐거웠지만 연구할 때 말고는 설탕도 고집이 엄청나. 난 우리가 또래니까 그냥 알베도라 부르라고 했지만 계속 존칭을 고집한다니깐. 휴, 어쩔 수 없지"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "리사에 대해…",
      "text": "리사? 그녀와 토론하면 항상 값진 의견을 얻게 돼. 그런 재주로 도서관 사서라는 직책에 만족하다니. 분명 그 재주와 맞먹는 엄청난 사연이 숨겨져 있을 거야"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "클레에 대해…",
      "text": "난 클레를 친동생처럼 생각해. 클레가 문제를 일으킬 때마다 그 파괴력이 앨리스 아줌마보다 약한 거로 위안을 삼을 수밖에 없어"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "진에 대해…",
      "text": "진? 그녀는 훌륭한 단장 대행이야. 단장님보다 더 믿음직스럽다니깐…. 아마 모두 그녀가 정식 단장이 되는 날을 고대하고 있을걸?"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "행추에 대해…",
      "text": "행추? 그의 소설은 정말 재밌어. 이나즈마의 「야에 출판사」는 계속 나보고 다른 저자와 집필하면 인세 수입이 더 오를 거라고 빙빙 돌려 설득하네. 흥, 그깟 돈이 대수야?"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "바바라에 대해…",
      "text": "그 진지한 바바라 부제? 예전에 우연한 기회로 스케치했던 적이 있어…. 그림이 어디 있냐고? 음… 엘버트 씨가 값을 불렀는데 거절하고 단장 대행님께 보냈어. 인맥관리는… 정말 힘들어"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "두린에 대해…",
      "text": "내 형제는 여러 새로운 것들을 탐구하고 있어. 머리도 좋고, 사색에도 잘 잠기지. 때로는 생각이 너무 많아서 인지적 오류에 빠지기도 하지만, 이게 이 세계를 향한 두린의 열정을 막지는 못해. 두린이 이 세상에 와줘서, 아니, 정확히는 가족으로서 내게 와준 덕분에 나도 인간관계에 대한 이해가 한층 깊어졌어. 나는 누구보다 가까운 동류가 생겼고, 집안에는 활기가 더해졌으니, 틀림없이 좋은 변화야"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "프루네에 대해…",
      "text": "프루네는 종종 나를 찾아와 「존재의 본질」에 대해 토론하곤 해. 그때마다 내가 몇 번 되물으면 토론이 금세 끝나버리지. 그래도 기쁜 점이라면, 다음번엔 해답을 가득 적은 노트를 들고 다시 찾아온다는 거야"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "알베도에 대해 알기·첫 번째",
      "text": "나한테 질문 있어? 말해봐. 아, 미안하지만 오래 걸리는 건 아니지? 지금 하고 있는 연구가 곧 막바지라…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "알베도에 대해 알기·두 번째",
      "text": "아, 그냥 하는 말인데, 황금은 인위적인 방법이 아니면 8배나 큰 태양을 갈라야지만 자연적으로 생성돼"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "알베도에 대해 알기·세 번째",
      "text": "인물화를 그리는 데 걸리는 시간은 기분에 따라 달라. 호프만 씨를 그릴 땐 반나절이 걸릴 수도 있고, 케이아 씨는 3획만으로 그릴 수도 있지. 이 동그란 얼굴, 이건 안대의 끈, 그리고 이건 안대야"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "알베도에 대해 알기·네 번째",
      "text": "그림 그리기랑 연구하는 것 말고는… 가끔 이나즈마와 리월의 소설을 봐. 재밌는 아이디어를 얻을 수 있고, 때로는 창작에 생각지도 못한 영감을 주기도 하거든"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "알베도에 대해 알기·다섯 번째",
      "text": "지금도 스승님이 가르쳐 주신 「흑토술」은 미스터리야. 스승님은 이걸로 대체 뭘 만들려 하신 걸까…? 아직 연구가 끝나려면 멀었어. 괜찮다면 나랑 함께 계속 탐구해줘"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "알베도의 취미…",
      "text": "음…연구 말고 내가 제일 하고 싶은 건 당연히 그림 그리기지. 처음엔 물체와 재료가 어떻게 이루어졌나 알아보려고 시작했는데 이젠 취미가 됐어. 음, 스트레스 해소에도 좋아"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "알베도의 고민…",
      "text": "시간이 정말 부족해. 번거로운 일들은 대부분 미뤄뒀는데도 시간이 부족할 것 같아"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "난 디저트를 좋아해. 뭐랄까… 체력과 정신이 고갈됐을 때, 고칼로리 음식은 원시적이지만 효과가 좋거든"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "싫어하는 음식이라… 식당에서 파는 양 많은 고기는 별로야. 난 입이 짧아서 「낭비」하거나 「입맛이 없어」지더라구. 그래서 지금은 아예 식당에 안 가. 그만큼 요리에 더 많은 시간을 쓴다는 뜻이기도 하지…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "맛에서 색채가 느껴져… 아마 금색 같아"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "이런 맛을 낼 수 있는 건, 네가 요리에 많은 시간을 할애해서 그런 거겠지?"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "양이 좀 많은데… 같이 먹을래?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해. 정말 기분 좋아 보는데 내가 솜씨 좀 발휘해도 될까? 사람의 기억력엔 한계가 있어. 하지만 그림을 그려두면 기억이 더 오래갈 수 있고, 나중에 그림을 보면 당시의 느낌을 되살릴 수 있지"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "「흑토」는 연금술의 어원이자 최초의 상태를 말해. 이 세상의 구성원으로서 난 반드시 의미를 찾아야 해"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "「백악」은 변화의 시작이야. 잡다한 생각은 버리고 지식을 받아들일 준비가 됐어. 나랑 같이 세계를 탐험해볼래?"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "연금술에서 「적성」은 감정의 정화를 의미해. 내 붉은색은 아마 너에게서 나온 것 같아"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "「황금」은 연금술의 마지막 단계야. 하찮던 것들이 마침내 제 의미를 찾고 황금으로 변화하는 거지. 나도 의미를 찾았어"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "피어나라"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "모조 태양꽃"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "생명 창조의 법칙"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "지금이 바로 탄생의 순간"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "명왕누대가 여기서 재현되리"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "위업을 지켜보거라"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "대지의 보물이군"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "무언의 서사야"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "「황금」 정도는 아니지만, 나름 가치 있어"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "계산 착오…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "다시 평가해야겠어…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "전략을 바꿔야겠어"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내게 맡겨"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "나랑 바꾸자, 너무 위험해"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "다 부질없군…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "실험이 실패한 건가?"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "내 연구는 끝났어…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "허용 범위 이내야…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "예측이 빗나갔어…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "오케이"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "과제 개척인가?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "같이 탐구하자"
    }
  ]
}