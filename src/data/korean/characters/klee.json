  "outfits": [
    {
      "id": 202901,
      "name": "크림꽃과 별빛 촛불",
      "description": "클레가 중요한 연극에 출연할 때 입은 정교한 코스튬. 화려한 색감이 마치 크림꽃과 붉은 촛불로 장식된 케이크 같아서, 모험의 발길이 닿은 모든 곳에 즐거움과 웃음을 퍼뜨린다",
      "isDefault": false,
      "characterName": "클레",
      "characterId": 10000029,
      "source": [],
      "filename_card": "UI_AvatarIcon_KleeCostumeWitch_Card",
      "filename_icon": "UI_AvatarIcon_KleeCostumeWitch",
