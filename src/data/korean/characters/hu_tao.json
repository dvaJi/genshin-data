  "outfits": [
    {
      "id": 204601,
      "name": "눈을 품은 복숭아꽃",
      "description": "호두의 코스튬. 왕생당의 어두운 예복과는 달리 비교적 밝은 색이다. 친구 향릉이 호두를 위해 특별히 준비한 선물로, 선글라스는 호두 본인의 소장품이다",
      "isDefault": false,
      "characterName": "호두",
      "characterId": 10000046,
      "source": [],
      "filename_card": "UI_AvatarIcon_HutaoCostumeWinter_Card",
      "filename_icon": "UI_AvatarIcon_HutaoCostumeWinter",
      "filename_iconCircle": "UI_AvatarIcon_HutaoCostumeWinter_Circle",
      "filename_splash": "UI_Costume_HutaoCostumeWinter",
      "filename_sideIcon": "UI_AvatarIcon_Side_HutaoCostumeWinter"
    },
    {
      "id": 204600,
      "name": "매화의 잔향",
      "description": "호두의 코스튬. 「왕생당」의 당주가 일할 때 입는 일상복이다",
      "isDefault": true,
      "characterName": "호두",
      "characterId": 10000046,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Hutao_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "안녕, 이 당주님한텐 무슨 볼 일이야? 응? 몰랐어? 왕생당의 77대 당주가 바로 나 호두라고! 하지만 혈색도 좋고 건강한 걸 보니 왕생당 일로 온 건 아닌가 보네, 그렇지?"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·왕생당",
      "text": "차나 한잔 하러 갈래? 헤헤~"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·고객",
      "text": "손님 하나, 손님 둘, 손님 셋…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·게으름",
      "text": "해가 뜨면 볕을 쬐고, 달이 뜨면 달을 쬐고~"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "에휴… 귀찮아라~"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "천둥이 쳤어, 일어나!"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "와아~ 눈이다!"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "휴~ 산뜻해"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "어? 모자가 날아가겠어"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "일찍 자고 일찍 일어나야 몸에 좋아~"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "여어! 안녕, 점심은 먹었어?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "히히, 달이 떴어~ 우리도 나가자!"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "어, 졸려? 그럼 편히 쉬어. 난 혼자 돌아다녀 볼게"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "호두 자신에 대해·이름",
      "text": "호두의 '호'는 호의호식의 '호', '두'는 두루치기의 '두'! …안, 안 웃겨?"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "호두 자신에 대해·장기",
      "text": "재밌는 거 보여줄게. 잘 봐…. 불! 그다음엔… 얍! 불나비! 호잇! 날아라——"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·호기심",
      "text": "넌 이곳저곳 여행했으니 분명 아는 것도 많겠지? 시간 나면 나한테도 들려줘"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·밤",
      "text": "낮엔 마음껏 돌아다녀도 되지만, 밤엔 조심해. 내가 없을 땐 특히 더"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "우리에 대해·조수",
      "text": "혹시… 도움이 필요해…? 내가 있잖아! 네가 도와달라고 하면 언제든 최선을 다할게"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "우리에 대해·전투",
      "text": "싸우는 건 귀찮아. 나한테 전투는 목적이 아니라 수단이야. 전투라는 수단을 통해 포기할 수 없는 것들을 지키는 거지. 이런 점에서 우린 닮은 것 같아"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」… 「신의 눈」? 음, 그건 그냥 운명에 맡기면 돼"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "부탁을 받았으면 성의를 다 해야 하지. 우리 왕생당은 특별히 두 배의 책임을 짊어져. 이승과 저승 사람 모두를 만족시켜야 하거든"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "어떤 화초는 음기 넘치고 달빛이 비치는 곳에서만 자라. 본 적 있어? 없다구? 그럼 다음에 한번 보여줄게"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "종려에 대해…",
      "text": "종려 씨는 생긴 건 젊은데 성격은 아재 같다니까. 아는 것도 많으면서 관심 있는 건 없나 봐…. 설마… 히히\\n뭐, 알아서 하겠지!"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "치치에 대해…",
      "text": "혹시 치치 못 봤니? 빨리 어디 있는지 말해줘. 치치를 숨겨야 한단 말이야. 흐흐!"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "백출에 대해…",
      "text": "백출? 흥, 귀찮은 사람이야"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "응광에 대해…",
      "text": "천권 응광은 최고의 갑부야. 아름답고 매력적인 데다가, 똑똑하고 수완도 좋다니까!"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "북두에 대해…",
      "text": "북두 언니는 리월의 유명 인사야. 언니는 날 모르지만 난 언니를 잘 안다고. 아~ 북두 언니랑 친구하고 싶다"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "행추에 대해…",
      "text": "행추 도령이 책을 쓰고 있다던데? 이야기책인가? 아니면 괴담? 내 시시콜콜한 경험담을 다 들려주고 싶네. 그걸 책으로 엮으면 재밌을 텐데"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "중운에 대해…",
      "text": "순수한 양의 체질로 음과 양이 하나가 되다니? 세상에 진짜 이런 체질이 있을 줄이야"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "소에 대해…",
      "text": "선인의 일을 내가 어떻게 알겠어? 어머머, 천기누설은 금물이라구! 나한테 묻지 마!"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "각청에 대해…",
      "text": "「옥형」각청… 친해지기 힘든 사람이야. 헤헤, 그 진지한 모습은 진짜 놀리고 싶다니까~ 설마 검으로 내 머릴 내려치진 않겠지? …그치?"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "향릉에 대해…",
      "text": "향릉은 정말 재밌어! 살짝 건드리기만 해도 깜짝깜짝 놀란다니까! 이쪽 사람들은 향릉 같은 애를 제일 좋아해~ 그래도 수위 조절은 필수야. 안 그럼 누룽지한테 혼나거든"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "운근에 대해…",
      "text": "운근은 정식적인 자리에서 되게 우아한데, 사적인 자리에선 정말 쉽게 친해질 수 있어! 전에 그녀와 내기를 했는데, 진 사람이 자기만의 창법으로 상대방이 적은 가사를 부르는 거였어. 후후, 연극 톤의 츄츄가는 꼭 한번 들어봐야 한다니까!"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "신학에 대해…",
      "text": "그녀는 참 재밌는 사람이야, 다른 사람들과는 다르지. 있지, 내가 지금부터 매일 선인초와 산 이슬을 먹고 마시면, 그녀처럼 속세에 물들지 않은 듯한 사람이 될 수 있을까? 헤헤…"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "남연에 대해…",
      "text": "남연은… 실력이 상당하지, 단순한 「겉핥기」 정도가 아니라니깐. 기문술은 참 대단해, 병의 기운과 죽음의 기운을 다 옮길 수 있다니. 어휴, 정말이지——세상이 좋아지고 건강한 사람들이 많아지니, 왕생당의 사업은 갈수록 어려워지겠네~"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "호두에 대해 알기·첫 번째",
      "text": "첫째 츄츄는 아프고, 둘째 츄츄는 병을 봐주네, 셋째 츄츄는 약초를 캐고, 넷째 츄츄는 달이네, 다섯째 츄츄는 죽고, 여섯째 츄츄는 들어 올렸네~\\n…헤헤"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "호두에 대해 알기·두 번째",
      "text": "골목에 숨어있는 어둠의 시인, 그게 바로 나야!"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "호두에 대해 알기·세 번째",
      "text": "나한테 「왕생당」 일은 별로 어렵지도, 무섭지도 않아. 그냥 좀 번거로울 뿐이지. 근데 사람들은 밤에 우리가 일하는 것만 봐도 벌벌 떨어대니. 휴~ 그 사람들은 뭘 몰라!"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "호두에 대해 알기·네 번째",
      "text": "난 「왕생당」의 77대 당주고 우리 할아버지는 75대 당주셨어. 내 첫 업무는 바로 할아버지의 장례를 치르는 거였지. 하하, 의외지? 이 일을 한 지도 꽤 됐네…. 시간 참 빨라"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "호두에 대해 알기·다섯 번째",
      "text": "음양은 질서 정연하고 운명은 수시로 변하지. 죽음은 예측할 수 없지만, 나름의 규칙이 있어. 언제 어디서나, 어떤 이유에서든 인간은 「죽음」을 경시해선 안 된다는 거 잊지 마. 죽음을 이해하고 존중해야지만 삶의 가치를 깨달을 수 있어"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "호두의 취미…",
      "text": "맑은 하늘, 광활한 바다, 밝은 달이 떠 있는 이 경치엔 시 한 수 읊기 딱이지!"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "호두의 고민…",
      "text": "휴, 뭐 재밌는 거 없나… 빈둥대는 건 죽는 것보다 더 끔찍해"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "♪라라라~ 생선전골이랑 새우만두지롱~"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "청심 슬라임 응축액 볶음… 우웩… 향릉이 나한테 복수하는 건가…?"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "좋아 좋아. 이 당주님이 이 요리를 위해 시를 한 수 지어주지——"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "정말 내가 안 도와줘도 돼? 하나 만들면 하나를 더 준다고~"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "으익… 이게 뭐야?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘 밤은 하늘에 별도 총총하고 달도 아름다운 게 좋은 날이 될 것 같아. 어디 보자… 음~ 알아, 네 생일이잖아! 이야, 정말 좋은 날이야~"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "어라? 어라라?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "응응, 좋아~ 고마워!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "이럴 수가! 호두 지금 힘이 막 샘솟는 것 같아. 자신감이 넘쳐!"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "힘이 최고치에 달하면 그때부턴 마음에 대한 시련이 시작되지. 네 덕분에 여기까지 올 수 있었어. 여기선 마음과 영혼이 구름이 돼서… 삶과 죽음, 그리고 천지 만물이 전부 우리 손에 있는 것만 같아"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "후우!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "일어나!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "흩어져!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "배도 채웠으니 편히 가렴!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "잘 가!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "접화요원!"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "훗——!"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "대시 시작·두 번째",
      "text": "가자~"
    },
    {
      "id": "700003",
      "type": 2,
      "title": "대시 시작·세 번째",
      "text": "야호~"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "바람 타고 슝~"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "럭키!"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "자자, 뭐가 있는지 한번 볼까"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "땅에 묻으면 보물상자가 더 많이 자라날 거야!"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "에구에구!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "으윽——!"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "안 돼!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "살살해!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "내가 할게!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "내 차롄가…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "복수… 할 거야…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "으악——"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "뭐야!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "응? 내가 나설 차롄가?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "너 안목 좋은걸!?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "전부 한 번에 보내줄게"
    }
  ]
}