  "outfits": [
    {
      "id": 203900,
      "name": "달콤한 양조법",
      "description": "디오나의 코스튬. 캣테일 술집의 인기 바텐더가 입는 일상복이다",
      "isDefault": true,
      "characterName": "디오나",
      "characterId": 10000039,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Diona_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "난 「캣테일 술집」의 간판 바텐더, 디오나야. 내 출장비는 엄청 비싸다고…. 응? 술 때문에 온 게 아니야? 흠, 그, 그렇다면 네 초대를… 받아주지"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·휴식",
      "text": "하~~ 기분 좋아. 몸이 더 유연해졌어"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·생각",
      "text": "도마뱀 꼬리, 후추, 별소라…. 또 뭘 넣어야 「머리가 깨질 정도로 맛없는 술」이 될까?"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·기다림",
      "text": "너, 너 기다린 거 아니야. 난 그냥, 쉬고 있었어!"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "비는 싫어… 안으로 들어가자. 윽, 옷이 젖을까 봐 그러는 거야! 물 같은 거 무섭지 않다구!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "어?! …떨고 있는 거 아냐! 아니라니까! 우으…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때·눈놀이",
      "text": "이 차가운 촉감. 와… 너무 좋아, 재밌다!"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "눈이 올 때·눈구경",
      "text": "새하얀 눈이 바람 속에서 춤추고 있어~ 정말 예쁘다. 내, 내 옆자리 비어있으니까 앉든지"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "일광욕하러 가자! 안 가면 나 혼자 간다… 음, 마지막 기회야! 갈 거야 말 거야~!"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침. 찬장에 있는 절인 미꾸라지 좀 줘봐——좋아, 이제 몬드 주류업을 망쳐볼까!"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사·이상한 소리",
      "text": "꼬르륵…응? 아냐! 넌 아무것도 못 들은 거야!"
    },
    {
      "id": "1005",
      "type": 1,
      "title": "점심 인사·통조림",
      "text": "…이 생선 통조림은 내가 아껴놓은 거야. 그, 그만 봐! 딱…딱 한입만이다?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "실패했어… 또 실패했다구… 다들 즐겁게 마시고 있잖아. 우으… 날 위로하지 마, 위로 따위 필요 없어…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "넌 고양이처럼 밤눈이 밝은 것도 아닐 텐데 밤길 돌아다닐 수 있겠어? 아니면 내가 데려다줘도… 에? 가로등이 있다고? …누, 누가 데려다준대! 빨리 가!"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "디오나 자신에 대해…",
      "text": "내 귀랑 꼬리는 장식품이 아니라 「캐츠라인 가문」 혈통의 상징이라구, 하여간 무식하기는. 소…손은 왜 뻗는 거야? 으, 이건… 알았어. 귀는 만지게 해줄게… 하지만 꼬, 꼬리는 절대 안 돼!"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·음료수",
      "text": "무알코올 음료가 마시고 싶다고? 어려운 건 아닌데, 그건 아무 의미 없잖아! 성공하든 실패하든 몬드 주류업을 망칠 수 없다구. 근데 내가 왜 해야 돼?"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·VIP 루트",
      "text": "자, 이건 「위대한 여름날의 몽환적이고 센티멘털한 산호 스파클링 티」야. 요즘 심심해서 한번 만들어봤어…. 줄 서서 마시는 인기 메뉴? 무슨 소리야, 난 못 들어 봤다구"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·대화 필요",
      "text": "으…음… 만, 만약 외로우면 언제든 나랑 이야기하러 와. 난 꽤 많은 걸 알고 있거든! 그 뭐였더라… 괜찮은 대화 상대라구. 그래, 그래! 자주 얘기하자…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "우리에 대해·호기심",
      "text": "뭐야 뭐야? 손에 든 게 뭐냐니까? 빨리 보여줘 봐! 설마 술에 넣으면 엄청 맛없어지는… 아, 뭐야, 그냥 이상하게 생긴 버섯이잖아. 재미없긴"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해·유전",
      "text": "내 「신의 눈」은 어디서 났냐고? 흥, 캐, 캐츠라인 가문의 내력이야…! 응? 우리 아빠는 신의 눈이 없다고? 헷——들켰네!!"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "「신의 눈」에 대해·내력",
      "text": "내가 왜 너한테 알려줘야 돼? 흥…됐어, 계속 그렇게 물어보니깐, 친구인 널 봐서 알려주긴 할게. 예전에 아빠가 사냥을 나가셨다가 큰일 날 뻔하셨어. 폭우가 쏟아지는데 내 머릿속은 온통 아빠를 찾아서 구해야 한단 생각뿐이었어… 자, 이제 됐지!"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "드래곤 스파인에 희귀한 식물이 있으려나? 「치명적인 쓴맛」이 있거나 「입에 조금만 닿아도 얼얼한」 그런 거 말이야. 엄청 많이 채집한 다음… 후후후…"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "나…난 나비를 되게 잘 잡아. 이봐, 아니라구! 나비를 잡는 건 술에 넣어서 이상한 맛을 내려는 거야! 날 고양이 취급하지 마! 냥!"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "다이루크에 대해…",
      "text": "그 다이루크는… 내가 제일 싫어하는 사람이야! 다이루크만 없으면 몬드 주류업도 없을 거고, 그럼 아빠가 술도 안 마실테고, 그럼… 아빠가 내 옆에 있어 줄 텐데, 흥"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "케이아에 대해…",
      "text": "대체 왜 내 「호위대장」까지 짜증 나게 술꾼인 거야! 말할 때마다 항상 실실거리는 그 녀석 말이야! 술만 마셨다 하면 끝도 없이 들이붓는다니까. 으휴!"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "벤티에 대해…",
      "text": "벤티? 잘 모르는 사람이야. 근데 음유시인이면, 술꾼들한테 노래 불러주며 흥을 돋우는 녀석들이잖아. 그럼 싫어! 싫어 싫어!"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "바바라에 대해…",
      "text": "바바라 씨의 팬은 다 언니 오빠들이지… 부럽다. 왜 내 팬들은 전부 아저씨들뿐이냐구! 으…너무해. 흥, 됐어!"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "진에 대해…",
      "text": "기사단의 단장 대행님? 흠… 술을 멀리하는 보기 드문 성숙한 어른이시지… 하지만 너무 진지해서 탈이야. 기사단 사람들 너무 날 과잉보호하는 거 아냐?"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "알베도에 대해…",
      "text": "그 수석 연금술사님? 음…맛있는 술만 만들어내는 내 체질도 해결해줄 수 있을까…?"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "리사에 대해…",
      "text": "리사 언니는 참 온화하고 상냥하지! 하지만! 그런 언니조차도 술을 자주 마신다니까! 흐윽…대체 왜 그러는 거야…. 몬드는 이제 틀렸어…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "향릉에 대해…",
      "text": "향릉한테 「같이 먹으면 최악인 음식 조합」 리스트를 달라고 한 적이 있어. 분명 직접 실험해본 거라 맛없을 거라고 했지만…아무 효과도 없었어. 「한잔 더」란 말만 못이 박히도록 들었다니까! 휴…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "클레에 대해…",
      "text": "클레가 놀러 오면 술집에서 멀리 떨어진 곳으로 갈 수밖에 없어. 술이랑 폭탄은… 너무 위험해! …몬드 주류업을 망치고 싶긴 해도 정정당당한 방식으로 할 거라구!"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "아버지에 대해…",
      "text": "아빠는 내가 제일 존경하는 분이셔! 그리고 세상에서 제일 대단하신 분이지! 근데…술을 마신 아빠는, 음…으——역시 하루빨리 몬드 주류업을 없애버려야겠어! 잡담할 시간이 없다구!"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "디오나에 대해 알기·첫 번째",
      "text": "「바텐더」는 엄청 바빠! 술집에서 일하지 않을 땐 시간 내서 레시피를 모아야 해. 그러니까 중요한 일 아니면 방해하지 마"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "디오나에 대해 알기·두 번째",
      "text": "너도…그 주정뱅이들처럼 나한테 고양이 흉내 내달라고 하는 건 아니지? 아니야, 절대 아닐 거야! 난 귀를 쫑긋거리면서 기지개나 켜는 애완동물이 아니란 말야! 나…난…「주류업 킬러」라고!"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "디오나에 대해 알기·세 번째",
      "text": "어쩌다 「주류업 킬러」에서 「캣테일 술집」의 간판 바텐더가 됐냐고…? 너, 너 날 비웃으려고 일부러 그런 질문 하는 거지! 으, 나빴어! 이제 너한테 음료수 안 만들어 줄 거야. 물도 안 줘!"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "디오나에 대해 알기·네 번째",
      "text": "더, 더 이상 날 건드리지 마. 내가 아무리 대인배여도 만만하진 않거든!? 경고하는데, 나 화나면 물어! 냥! 널 진짜로 물진 않겠지만…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "디오나에 대해 알기·다섯 번째",
      "text": "너랑 난…이제 친한 친구인 거지? 예전에도 이런 친구가 있던 게…어렴풋이 기억나. 그게 꿈인지 아닌지는 모르겠지만…\\n네 손 좀 줘봐. 앙, 음…따뜻해. 이제 됐어, 꿈이 돼서 떠나버리면 안 돼…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "디오나의 취미…",
      "text": "난 사냥을 좋아해. 사냥감을 쫓는 건 내 특기지! 근데 아빠가 순식간에 위험해지는 게 숲이라고 믿을만한 어른 없이는 절대 들어가지 말라고 하셨어. 너 정도면, 믿을만한 어른 맞지?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "디오나의 고민…",
      "text": "어떻게 해야 맛없는 술을 만들 수 있을까… 잔뜩 기대한 최악의 조합——「간장, 우유, 절운고추에 민들레 씨앗을 넣은 특제 술」조차 「실력이 더 늘었네, 디오나」라는 평가를 받았어, 흐엉… 절대 포기하지 않을 거야…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "난 생선이 좋아! 주식으로 먹는 생선도 좋고… 아빠가 만들어 준 생선도 좋아! 근데…안주로 만드는 건 절대 안 돼. 그건 생선에 대한 모독이야!"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "당근, 감자, 양파, 토마토… 이런 것들은 다 별로야. 난, 채식은 안 해!"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "맛있다…. 그, 그냥 물어보는 건데, 다음에도 해줄 수 있어?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "네가 맛있는 것 좀 줬다고 내가 애교부릴 거란 생각은 마…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "이봐… 너 지금 날 길고양이 취급하는 거야?!"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생선튀김에 내가 특별히 만든 소스도 곁들였어. 자, 받아.\\n…이상한 건 안 넣었어! 내가 공들여 만든 건데 맛없을 리 없잖아. 일단 먹어보고 얘기해!\\n흥… 그렇게 나와야지… 음, 저기, 생일 축하해"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "고양이의 눈은, 어둠 속의 사냥감을 모두 볼 수 있어!"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "고양이의 귀는, 미세한 발소리도 들을 수 있지…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "고양이의 다리는, 티바트에서 가장 높은 나무에 오를 수 있어!"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "고양이의 코는, 익숙하고 좋아하는 사람의 냄새를 맡… 앗?! 네가 잘못 들은 거야! 내가 그런 말을 할 리가 없잖아… 으…"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "히…얍!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "슈슉——"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "목표 확인!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "공수 겸비~"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "잡았다, 냥!"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "날 만만하게 보지 마!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "디오나 특제!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "술타령한 대가야…. 흥!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "반성하라구, 주정뱅이!"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "금방 갈게"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "대시 시작·두 번째",
      "text": "출발, 출발!"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "대시 종료·첫 번째",
      "text": "후우"
    },
    {
      "id": "710002",
      "type": 2,
      "title": "대시 종료·두 번째",
      "text": "아웅…"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "날아올랐어"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "술을 맛없게 하는 재료야, 나와라!"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "반짝반짝해… 다 내 거야!"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "보물상자에 뭐가 있는지 궁금해!"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "난 절대 항복하지 않아…!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "냐앙… 냐앙…!"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "승부는 아직이야!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "무리하지 마!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "가서 쉬고 있어!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "지독한… 술 냄새…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "샘물 요정…가지 마…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "눈이…안 떠져…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "못 피했어…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "어디서 튀어나온 거야?"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "사냥 시작!"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "역시 내가 나서야겠네!"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "훗, 나한테 맡기라구"
    }
  ]
}