  "outfits": [
    {
      "id": 209000,
      "name": "정의를 수호하는 총",
      "description": "슈브르즈의 코스튬. 디자이너들은 제복의 고전적인 검정색, 흰색, 빨간색 조합을 유지하면서 다양한 장식을 추가했는데 그 때문에 무게가 너무 무거워져 슈브르즈의 불만을 샀다. 대중들에게 공개된 최종본에서는 이런 금속 장식들이 대부분 제거되었다",
      "isDefault": true,
      "characterName": "슈브르즈",
      "characterId": 10000090,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Chevreuse_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "난 폰타인 특별 순찰대 대장 슈브르즈다. 인사말은 됐고, 내가 처리해야 할 까다로운 사건이라도 있나?"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·화승총",
      "text": "화승총은 내가 가장 좋아하는 무기야. 강력한 살상력과 위압감을 갖고 있지. 가끔은 후자가 전자보다 더 유용할 때도 있어"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·순찰",
      "text": "우리 특별 순찰대는 폰타인성의 일상 순찰 업무에 참여하지 않아. 우리가 체포하려는 녀석이 거리에 얼굴을 드러낼 일은 거의 없거든"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·음식",
      "text": "「동글동글」이라는 간식은 휴대하기도 편하고, 소스를 곁들이면 다양한 맛을 느낄 수 있어…. 기다려 봐, 가서 몇 개 더 사올게"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "안심해, 빗속에서도 내 화승총은 정상적으로 발사되니까"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "어떤 범죄자들은 천둥소리로 총성을 숨기기도 하지만, 내 귀를 속일 순 없지"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "…잠깐 기다려 봐. 화승총의 부품이 얼지 않게 관리해 줘야겠어"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "날씨도 좋고, 시야도 좋군"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "이 정도 풍속이라면… 바람 때문에 총알 궤도까지 휘겠어"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "광활한 사막은 어떤 사물들을 묻어두기에 아주 적합하지"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침이야. 마침 체력 훈련을 하려던 참이었는데, 같이 할래?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "안녕, 같이 특별 순찰대 식당에서 점심 먹을래? 허기를 채우기엔 딱이거든"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "오늘의 업무도 끝난 것 같네. 다행히 큰 소동은 없었어. 야식 먹으러 가자, 내가 안내할게"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "잘 자. 나도 곧 쉴 생각이야. 오늘 밤은… 돌발 상황이 너무 많지 않았으면 좋겠네"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "슈브르즈 자신에 대해·특별 순찰대",
      "text": "특별 순찰대는 각종 위험한 살인 사건과 강력 범죄자를 전문적으로 상대하기 때문에 법을 집행할 때 다소… 과격할 수 있어"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "슈브르즈 자신에 대해·모자",
      "text": "특별 순찰대에는 누군가가 희생되면 그 대원의 모자를 보관해 두는 전통이 있어. 나중에 그 대원의 자식이 특별 순찰대가 되면 모자를 수여해 주기 위해서거든…. 이것도 일종의 「전승」이라고 할 수 있겠지"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·관심사",
      "text": "한가할 땐 「범죄 소설」을 읽는 편이야. 추리 소설과는 달리, 범죄 소설은 복잡한 범행 수법보다 범죄를 둘러싼 다양한 인간적 갈등과 감정적 충돌에 치중하거든. 난 그게 꽤 재밌더라"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·법리",
      "text": "법에 대해 궁금한 점이 있다면 언제든지 물어봐. 아니면… 머릿속에 「이 일은 불법이 아닐지도 몰라」라는 생각이 떠오른다면, 가장 먼저 나한테 상의하도록 해.\\n요행 심리 때문에 선을 넘는 멍청이들이 해마다 있거든. 네가 그런 사람이 되는 걸 보고 싶지 않아"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "일할 때 「신의 눈」은 무시할 수 없는 무력 보조 역할을 해. 신의 눈이 생긴 후로 내 화승총은 심각하게 고장난 적이 단 한 번도 없었어. 「신의 눈과 총기를 지닌 특별 순찰대 대장」, 이 칭호라면 겁 많은 용의자들의 간담을 서늘하게 하기엔 충분하겠지"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "하코트가 정말 밀리스를 체포할 줄이야…. 사랑하는 사람에게조차 수갑을 채울 수 있다니 정말 놀라워. 근데 밀리스는 무슨 죄지? 그냥 길에서 주운 장신구를 팔았을 뿐인데 귀족들 입에 오르내리는 대역 죄인이 되다니… 정의란 정말 종잡을 수 없어. 넌 어떻게 생각해?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일·경비 장치",
      "text": "우리는 법률 집행청 소속이긴 하지만, 특별 순찰대는 임무를 수행할 때 대량의 경비 장치를 사용하진 않아. 왜냐하면… 하, 그 굼뜬 장치들은 우리가 총을 쏘는 데 방해만 되거든"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "나비아에 대해…",
      "text": "나비아 씨의 아버지와 관련된 살인 사건은 들어봤어. 당시 법률 집행청에서도 시끌벅적했지. 꽤 많은 사람이 그 사건을 두고 논쟁을 벌였어….\\n다행히 이젠 사건의 진실이 밝혀지고 진짜 범인도 법의 심판을 받았으니… 「정의」가 마침내 자릴 잡은 셈이겠지"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "리니에 대해…",
      "text": "그 마술사와는 아는 사이야. 한번은 상해, 유괴, 살인 혐의를 받고 있는 마술사를 체포했는데, 줄곧 범행 수법을 밝혀내지 못했거든. 결국 리니를 데리고 와서야 중요한 물증을 찾고 용의자에게 유죄 판결을 내릴 수 있었어. 이 사건에 관심을 가진 어느 소설가는 마술 트릭으로 범죄를 저지르는 추리 소설을 썼다고 해.\\n근데… 소설의 내용이 너무 디테일해서 여론이 잠잠해지기 전까지는 출판하기 어려울 것 같아"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "프레미네에 대해…",
      "text": "언젠가 부품을 사러 나갔다가 그 잠수원을 만났어. 당시 우리 둘 다 가게에 하나만 남은 범용 부품을 사려고 했지. 그래서 내가 막 그 부품을 양보하려는데, 그 잠수원이 갑자기 손을 움츠리고는 고개를 숙인 채 가게 밖으로 뛰쳐나가는 거야. 이렇게 말하면 좀 그렇지만, 꼭 용의자 같더라…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "클로린드에 대해…",
      "text": "그 결투 대리인은 폰타인성에서 아주 유명하지. 서로 직무가 다르니까 그녀의 일을 함부로 평가하고 싶진 않아. 하지만 그녀가 결투를 수락한 이유가 마음속의 「정의」에서 비롯됐다고 믿어"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "라이오슬리에 대해…",
      "text": "라이오슬리의 업무 능력은 탁월하고 효과적이야. 적어도 죄인들은 「메로피드 요새」가 노후를 보내기 적합한 장소가 아니라는 걸 똑똑히 알고 있으니까. 그건 우리의 심문에 큰 도움이 되거든"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "에밀리에 대해…",
      "text": "개인적으로 친분이 있어. 에밀리한테 전문적인 화학 지식으로 물증을 분석하거나 용의자를 추적하는 등 여러 차례 도움을 받았거든. 에밀리는 범인이 어떤 향수를 썼는지, 어떤 꽃을 선물했는지, 심지어 어떤 장소에 가고 어떤 흙을 밟았는지 같은 보이지 않는 정보까지 알아내더라고…. 한 번도 틀리지 않고 말이야"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "치오리에 대해…",
      "text": "치오리가 분쟁을 처리하는 방식이 다소 과격하긴 해. 하지만 치오리는 연줄과 인맥으로 특별 순찰대에 많은 정보를 제공했거든. 그 답례로 난 치오리가 사람을 가게 밖으로 내던지거나, 악성 라이벌의 가게를 난장판으로 만드는 걸 눈감아 줬고. 또 나중에 조사해보면 매번 일리 있는 쪽은 치오리라는 걸 알게 됐지. 치오리는 단지 쓸데없는 말로 시간 낭비하는 게 싫은 것뿐이야"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "샤를로트에 대해…",
      "text": "골치 아픈 기자 아가씨야. 중대 사안이 발생하면 우리가 아무리 현장을 봉쇄해도 가장 먼저 현장과 제일 가까운 곳에 나타나거든…. 한번은 내 부하가 샤를로트 씨를 가장 유력한 용의자로 지목하고 보름 동안이나 구금한 적이 있어. 근데 유치장에서 보도 기사를 다 썼더라고…. 언제 시간 내서 거기 편집장과 정식으로 이야기를 해봐야겠어"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "시그윈에 대해…",
      "text": "특별 순찰대와 멜뤼진 사이에 친분이 있는 지는 꽤 오래됐어. 우린 종종 그림자 수사청의 멜뤼진들과 협력하거든. 멜뤼진들은 착하고 성실하고 믿음직해. 중요한 사건을 처리할 땐 대체할 수 없는 역할도 하고 말이야…. 개인적으로도 몇몇 멜뤼진과 친분이 있어. 수간호사 시그윈도 그중 한 명이야.\\n예전부터 지금까지 멜뤼진은 우리에게 없어서는 안 될 동료야. 만약 누군가가… 다시 어떤 방식으로든 멜뤼진을 모욕한다면, 특별 순찰대의 총구에 자비란 없을 거야"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "느비예트에 대해…",
      "text": "모두가 알다시피 최고 심판관님은 재판할 때 사심을 전혀 섞지 않아. 인정미가 없다고 하는 사람도 있지만, 내가 볼 때 정의는 사사로운 감정에 방해를 받아서는 안 돼. 법을 어긴 자는 유죄다, 그게 다야"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "푸리나에 대해…",
      "text": "푸리나 님은… 예전에 우리한테 갑자기 무슨… 화승총 공연 훈련을 시키신 적이 있어. 순찰대 전원에게 특수 제작된 「의례 화승총」을 소지하게 하셨고. 특수한 화승총 춤 훈련까지 시키셨지…. 마음에 드는 의장곡을 찾지 못해 흐지부지 끝나서 정말 다행이었어"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "슈브르즈에 대해 알기·첫 번째",
      "text": "미안, 난 사람과 교류하는 게… 아니, 정상적인 사람과 교류하는 게 서툴러. 궁금한 게 있으면 그냥 물어봐"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "슈브르즈에 대해 알기·두 번째",
      "text": "특별 순찰대는 법률 집행청에 소속된 사법 부서 중 하나야. 우리의 작전 스타일과 인원 구성이 지나치게 대담해서 법률 집행청의 일부 어르신들은 우릴 「규칙을 제일 안 지키는」 부서라고 부르기도 해.\\n하지만 난 특별 순찰대의 행동 준칙이 외부의 영향을 받아서는 안 된다고 생각해. 우리가 상대해야 할 악당은 멜모니아궁의 무골호인이 아니니까. 죄인의 위법 행위가 폭우처럼 들이닥칠 때 우리도 결코 뒤처져서는 안 되지"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "슈브르즈에 대해 알기·세 번째",
      "text": "내가 겪은 범죄자들이 전부 극악무도한 악당이었던 건 아냐.\\n처음에는 작은 실수로 시작했다가 그 책임이 두려워서, 자기도 모르게 거짓말이 거짓말을 낳는 소용돌이에 빠져들고, 결국… 수없는 거짓말에 둘러싸여 범죄의 기로에 들어선 사람들이 대다수지.\\n내가 가장 좋아하는 극작가는 어느 오페라에서 「거짓말은 죄를 낳는 악의 토양이다」라는 문장을 노래했어.\\n그런데 그 극작가는 몇 년 후 표절죄로 체포됐지. 정말이지… 그 오페라에 극적인 주석을 단 셈이랄까?"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "슈브르즈에 대해 알기·네 번째",
      "text": "아버지는 전에 감옥에 갇히셨어. 그래서 난 한때 「죄인의 딸」이라고 불리기도 했지. 잿빛의 강에서 자라면서 햇빛이 비추지 않는 이면을 적잖게 봤어. 이런 경험 덕분에 날 싫어하는 사람도 많지만, 그걸 통해 배운 게 더 많아.\\n법의 집행자는 마음속의 「정의」를 믿고 그걸 행동 속에 담아야 해. 아버지께서 가르쳐 주신 말씀이지.\\n나도 그 말에 깊이 공감하고 있어"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "슈브르즈에 대해 알기·다섯 번째",
      "text": "솔직히 특별 순찰대 대장으로서 난 도덕성이라곤 털끝만큼도 없는 악당들의 만행을 수도 없이 봐 왔고, 죄 없고 선량한 사람들이 사건에 휘말려 다치거나 목숨까지 잃는 상황도 봤었지. 그럴 때면 난 종종 분노와 무력감을 느껴.\\n난 「죄인」이 처벌을 받아야 한다고 굳게 믿지만, 그렇다고 그게 끝없는 복수의 순환을 의미하는 건 아냐.\\n만약 우리가 스스로의 눈을 가리고 감정에 이끌려 자신의 행동을 방임한다면, 조만간 모두가 겨울 바다에 빠져 죽게 되겠지.\\n권력을 손에 쥐고 있을수록 그걸 경계해야 해. 마음속의 「정의」를 확고히 추구하되, 정의를 추구하는 과정에서 길을 잃으면 안 돼"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "슈브르즈의 취미…",
      "text": "훈련? 사격? 굳이 말하자면… 범죄 소설 읽기야. 아 참, 《미스터리 추적》 최신호를 가지러 가야겠네"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "슈브르즈의 고민…",
      "text": "번거로운 예절은 그만 좀 배웠으면 좋겠어. 그런 일에 시간을 낭비할 바엔 차라리 강력범을 감시하는 게 낫지"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "지방과 당분이 풍부한 음식은 근무일에 충분한 에너지와 상쾌한 기분을 제공해 줘. 휴일? 휴일이면 그 음식들은 내 체중을 늘리는 「죄악의 정크푸드」로 전락하지. 하지만 그 「죄악」을 처단하는 것도 내가 하루 종일 좋은 기분을 갖게 해줘"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "난… 날것은 받아들이기 힘들어. 이왕 입에 넣는 거면, 적어도 익혀서 먹어야지…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "꽤 괜찮군. 하지만… 훗, 나도 모르게 너무 많이 먹어서 이따 추가 훈련을 해야겠어"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "음, 특별 순찰대 식당의 요리보다 훨씬 맛있어"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "허기는 채워지지만 식욕은 돋지 않는군…. 나한테 아주 훌륭한 요리야"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해. 음… 차렷! 무릎 굽히지 말고, 똑바로 서. 휴대용 소형 화승총과 출납이 빠른 홀스터까지 주문하려면 네 신체 데이터를 측정해야 하거든….\\n자, 긴장 풀어. 화승총이 제작되기 전까지 훈련용 화승총으로 한동안 연습해 봐. 지금 바로 시작할게. 따라와"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "훌륭해. 총을 든 자세가 더 안정적이야"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "이제 더 먼 곳의 적을 저격할 수 있겠어…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "고마워, 이 힘 덕분에 더 효율적으로 악당을 체포할 수 있을 것 같아"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "그동안의 도움에 진심으로 감사할게. 특별 순찰대가 언제든지 네 부름에 답한다고 약속할 수는 없지만, 개인적으로는 네가 말만 하면 무슨 일이든 너와 함께할게"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "움직이지 마!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "무기를 버려!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "최후통첩이다!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "이건 필요한 무력이다"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "널 체포하겠다"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "순순히 항복해라!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "그래"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "장물은 없었으면 좋겠군"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "불법적인 소득은 아니니 걱정 마"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "이 악당…!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "무법자로군"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "넌, 해명할 권리가 없다"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "대열을 바로잡아!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "진형을 유지해!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "정의는… 어디에…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "죄인을… 아직…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "이게… 결말인가…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "쓸데없는 저항이다...!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "출동하지"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "추가 훈련이라고 생각할게"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "난 언제든 준비되어 있어"
    }
  ]
}