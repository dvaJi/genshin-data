  "outfits": [
    {
      "id": 202600,
      "name": "천년의 세월",
      "description": "소의 코스튬. 천 년 동안 요마를 물리쳐온 옛 전투복이다",
      "isDefault": true,
      "characterName": "소",
      "characterId": 10000026,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xiao_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "광야에서 길을 잃거나, 길에서 각종 악인이나 흉수를 만났을 때, 전쟁과 마주쳤을 때 내 이름을 부르거라. 「삼안오현 선인」——「소」, 부름을 받아 지켜주러 왔다"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·느긋함",
      "text": "내가 언제부터 이렇게 한가해 진 거지? 우습군"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·떠도는 영혼",
      "text": "황야의 고독한 영혼, 날 해칠 생각은 버려"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·잠식",
      "text": "…으윽…흠, 유쾌하지 않은 일들이 생각났어"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "마물은 비가 온다고 쉬지 않아, 움직이자"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "날이 갰네? 하지만 난 날씨에는 관심이 없어"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "평범한 사람들은 천둥을 무서워해. 흔한 일인데 이해가 안 돼"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "눈이 쌓이고 나면, 파먹을 수 있어"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "시간이 꽤 됐네, 출발하자"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "점심 식사… 망서 객잔으로 돌아가자"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "밤에는 불길한 것들이 판을 치니까, 밖에 나가지 마"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "가봐, 난 여기서 널 기다릴게"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "소 자신에 대해·사람이 아닌 존재",
      "text": "난 인간이 아니라서, 인간의 감정을 이해하기 힘들어"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "소 자신에 대해·리월",
      "text": "요새 리월이 너무 빨리 변하고 있어…아, 됐다, 적응할 마음도 없는데"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·경고",
      "text": "너마저 어둠에 빠지게 되는 날이 온다면, 그땐 내가——"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·믿음",
      "text": "오염되지 마, 그럼 안 봐줄 거야.\\n…그러니까 내 말은 의지가 굳은 「너」라면 끝까지 흔들리지 않을 거야"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·졸음",
      "text": "누, 누구냐!? 음? …내가 서서 잤다고? 선인에게 건방지군!"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "우리에 대해·해등절",
      "text": "해등절? 또 인간들이 바다에 빛나는 쓰레기를 쏟아부을 때가 됐군. 왜 이리 유치한 짓을 하는지.\\n근데, 네가 심심하다면 같이 가 줄게"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해·욕망",
      "text": "「신의 눈」, 욕망? 인간의 기준으로 선인을 짐작하지 마. 난 욕망이 없어"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "「신의 눈」에 대해·이유",
      "text": "일부러 감추려는 게 아니야, 내 욕망은 다른 사람에게는 말할 수 없어.\\n인간 세상에는 소원을 말하는 순간 무효라는 규칙이 있잖아. 어…? 그 뜻이 아니라고?"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "살육은 내 특기지. 네가 못 하겠다면 날 불러"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "적화주, 예전엔 황무지였어.\\n벌써 몇 년 전… 아니, 몇백 년 전의 일이지"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "종려에 대해…",
      "text": "흠… 뭘 좀 묻지. 종려 님은 평소에 어떤 일을…? 새장을 들고 산책? 꽃구경? 골동품 감정?\\n… 종려 님은 무슨 뜻으로 그런 걸 하시는 거지…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "북두에 대해…",
      "text": "북두? 난 그녀와 친분이 없어. 하지만 바다 괴수를 쓰러뜨린 건 사실이야. 인간이 「해산」을 처치하다니, 실력은 인정할 만해"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "백출에 대해…",
      "text": "너… 백출에게 내 고통을 줄여줄 약물을 만들어 달라고 부탁했어? 흠… 마음은 고맙게 받지. 하지만 평범한 인간들의 약물은 선인에게 전혀 듣지 않아"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "호두에 대해…",
      "text": "호두? 그 아이는 골치 아플 정도로 활발해. 그래도 재미있는 구석이 있으니까 따분한 인간으로 자랄 걱정은 없어"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "벤티에 대해…",
      "text": "벤티…? 이름이 벤티였구나, 그가 연주하는 곡은… 아니, 아무것도 아니야"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "감우에 대해…",
      "text": "감우는 신수도 아니고 범인도 아닌, 선인과 인간의 경계에 걸쳐진 존재야. 책임감으로 자신을 지탱하고 있으니, 혼란스럽겠지. …내가? 살육과 생존의 길밖에 모르는 야차한테, 상서로운 신수를 인도하라니, 말도 안 되는 소리야"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "신학에 대해…",
      "text": "신학은 널 굉장히 신뢰하는 것 같더군. 하긴 세상에 너처럼 착하고 열정적인 사람이 얼마나 있겠어"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "야란에 대해…",
      "text": "전에 층암거연에서 천암군과 관련된 흔적을 조사했다고 들었어. 그곳에 혼자 비밀을 찾으러 가다니, 보통내기가 아니군"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "소에 대해 알기·첫 번째",
      "text": "널 지키는 호법이 되어줄게.\\n하지만… 내게 가까이 오거나 날 방해하진 마. 그럼 후회하게 될 거야"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "소에 대해 알기·두 번째",
      "text": "천년 동안, 난 셀 수 없이 많은 원혼을 죽였어. 곤란한 일을 당하지 않으려면 내게서 멀리 떨어져. 날 그냥 「도구」로 여겨"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "소에 대해 알기·세 번째",
      "text": "귓가에 자꾸… 「그들」의 목소리가 들려. 포효, 울부짖는 소리… 살육이라고 울부짖지…\\n이건 내 선택의 대가야. 너와는 상관없어"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "소에 대해 알기·네 번째",
      "text": "모락스? 이 이름에 대해 얼마나 알고 있지?\\n그분은 내게 「소」라는 이름을 지어주고, 날 기나긴 고통에서 해방시켜 주셨어.\\n그분께 불경하게 군다면 너라도 용서할 수 없어"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "소에 대해 알기·다섯 번째",
      "text": "이미 늦었어, 우리 사이엔 얽힌 게 너무 많아. 네가 포기하려 해도 늦었어. 음? 포기를 생각해 본 적 없다고?\\n…「나자의 춤」, 내 전투는 멈추지 않아.\\n하지만 너에 대해서 더 많이 알고 싶어"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "소의 취미…",
      "text": "너 정말 겁이 없구나, 내 취미를 물어볼 용기도 있고.\\n그럼 싸워보자. 네 몸으로 내 공격을 몇 수나 버틸 수 있을까?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "소의 고민…",
      "text": "번뇌? 그런 질문은 선인에게 무의미해. 천년 동안 지속되는 번뇌는 존재하지 않으니까"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식·행인두부",
      "text": "인간의 음식엔 흥미 없어. 과정이 복잡하고 시간이 너무 오래 걸려. 그나마 행인두부는 먹을 만하지"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "좋아하는 음식·추억",
      "text": "행인두부의 맛은, 그때 그 「꿈」과 아주 비슷하군"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "나보고 직접 밀가루 전병에 고기를 싸라고? 그리고… 함께 먹으라고? 하… 귀찮아. 요즘 인간 세상은 상식이 너무나도 부족하군"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "음, 나쁘지 않아…. 왜 그렇게 쳐다봐?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "난 괜찮으니까 신경 써줄 필요 없어"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "다음엔 다른 걸 만들어 봐"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일이라… 인간의 이런 기념일은 정말 쓸데없어. 크흠… 기다려봐. 오동나무 잎으로 나비를 접어주지.\\n됐으니까 가져가. 이건 선법이라 액운을 막아줄 수 있어"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "이 정도로 괜히 놀라지 마"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "새로운 힘? 이 힘은 참살에나 쓰일 뿐이야"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "힘의 끝은 자아의 파멸이지, 대답해. 어째서 그렇게 집착하는지"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "내 창은 이미 무수한 영혼을 도륙했어. 나 자신도 어둠에 잠식되었고. ——그런데 넌 이런 날 움직이고…「동료」로 삼았어.\\n…날 구하고 싶은 건가? 넌… 정말 이해하기 힘든 생명체군"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "흥"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "지루해"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "소용없어"
    },
    {
      "id": "110001",
      "type": 2,
      "title": "낙하 공격·첫 번째",
      "text": "여기다!"
    },
    {
      "id": "110002",
      "type": 2,
      "title": "낙하 공격·두 번째",
      "text": "무능하군"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "사라져라"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "나자의 춤"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "비명을 지르거라"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "너한테 쓸모가 있다면 됐어"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "이 물건들의 용도는… 아니다, 관심 없어"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "음… 품질은 나쁘지 않군"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "다물어"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "어리석군"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "좋아"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "…나약하군"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "살고 싶으면 물러나"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "이게… 업보인가"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "이날이… 왔구나"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "말도 안 돼…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "너 따위가?"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "날 방해하지 마"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "부름을 듣고 왔다"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "악령이여 물러가라"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "항마는 내 소임이야"
    }
  ]
}