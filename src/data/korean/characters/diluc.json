  "outfits": [
    {
      "id": 201601,
      "name": "진홍빛 종야",
      "description": "다이루크가 은밀한 행동을 할 때 착용하는 코스튬 중 하나. 그림자 속에서 활활 타오르는 불꽃과도 같다. 적의 시야 끝에 진홍빛 잔흔을 남겨서 영원히 잊지 못할 악몽을 선사한다",
      "isDefault": false,
      "characterName": "다이루크",
      "characterId": 10000016,
      "source": [],
      "filename_card": "UI_AvatarIcon_DilucCostumeFlamme_Card",
      "filename_icon": "UI_AvatarIcon_DilucCostumeFlamme",
      "filename_iconCircle": "UI_AvatarIcon_DilucCostumeFlamme_Circle",
      "filename_splash": "UI_Costume_DilucCostumeFlamme",
      "filename_sideIcon": "UI_AvatarIcon_Side_DilucCostumeFlamme"
    },
    {
      "id": 201600,
      "name": "어둠 속 불꽃",
      "description": "다이루크의 코스튬. 화려하지 않지만 기품을 살려주는 귀족 복장이다",
      "isDefault": true,
      "characterName": "다이루크",
      "characterId": 10000016,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Diluc_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "몬드성의 다이루크, 약속을 지키러 왔다. 잡담엔 낄 생각 없어. 큰일을 해볼 생각이라면 구미가 좀 당기는군"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·휴식",
      "text": "가끔 여유를 부리는 것도 괜찮지"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·기사단",
      "text": "기사단 녀석들에게 같이 있어 달라고 해"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·협회",
      "text": "협회에 할 일이 많으니까 자넨 여기서 쉬어. 난 돌아가 볼게"
    },
    {
      "id": "1106",
      "type": 1,
      "title": "잡담·준비",
      "text": "미리 준비해서 상대보다 먼저 공격하자고"
    },
    {
      "id": "1107",
      "type": 1,
      "title": "잡담·계획",
      "text": "휴식을 취할 때 앞으로의 계획을 고민해 볼 수 있어"
    },
    {
      "id": "1108",
      "type": 1,
      "title": "잡담·당부",
      "text": "모든 행동에는 위험이 뒤따르는 법. 반드시 조심해야 해"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때·우산",
      "text": "난 우산 필요 없어. 자넨 편할 대로 해"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 올 때·청소",
      "text": "비는 안타깝지만 더러워진 마음을 씻어내진 못하지"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "자신이 가야 할 길을 굳게 믿으면, 날씨 따윈 상관없어"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "울부짖는 바람 소리는 범죄의 흔적을 가리는 데 이용되지"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "인사치레는 관두고, 어젯밤 무사히 보냈으면 됐어"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "히든 메뉴, 한번 마셔 보겠나?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "밤이 됐네"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "음, 다음에 보자고. 네가 안전히 떠나는 걸 지켜볼게"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "다이루크 자신에 대해…",
      "text": "「다크 히어로」 전설? 재미있는 전설이지"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·필요",
      "text": "필요한 게 있으면 바로 말해. 비용 처리는 엘저를 찾아가"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·증명",
      "text": "넌 이미 결심을 증명해 보였어, 그럼 이제 내 의지를 증명하지"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "앞길이 잘 보이지 않는 사람에게 「신의 눈」은 신이 내린 등불일 수도 있지. 하지만 신념을 가진 사람에겐 그저 있으나 마나 한 표창일 뿐이야"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "난 가끔 「천사의 몫」에서 직접 술을 만들어, 술집은 정보가 거래되는 곳이기 때문이지"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "…부엉이야. 어둠 속에서 사냥감을 관찰하는 새, 최적의 타이밍에만 움직이고 빈틈이 전혀 없어"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "케이아에 대해…",
      "text": "케이아… 그자가 하는 말은 반밖에 못 믿겠어"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "리사에 대해…",
      "text": "리사, 기사단에서 가장 의지할 수 있는 일원이 될 수 있지. 그녀가 원한다면"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "진에 대해·적",
      "text": "무의미한 잡일은 진의 가장 큰 적이야"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "진에 대해·의무",
      "text": "그녀는 과한 책임감 때문에 자신의 진정한 직책을 제대로 모르고 있어"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "모나에 대해…",
      "text": "몬드의 땅은 바람 신의 은총이 넘쳐서 점성술사를 동원해 수확을 예측할 필요가 없겠지"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "디오나에 대해…",
      "text": "디오나가 퉁명하게 굴어서 말 붙일 기회를 잡지 못했어. 가족의 원한이 걸린 거라면…. 음, 아냐? 그냥 술이 싫은 거라고? 몬드에서 술을 싫어하는 바텐더가 있을 줄이야"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "바르카에 대해…",
      "text": "바르카 대단장, 나는 그의 입장을 이해할 수 있지만, 그의 방식은 인정할 수 없어. 흠… 내가 실언했네. 난 이젠 페보니우스 기사단의 기사가 아니니 내가 한 말은 잊어버려"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "유라에 대해…",
      "text": "그녀에 대해 들어본 적 있어. 자기만의 이념이 확고하더군. 가문의 속박에서부터 벗어나려는 기세도 인정할만해. 그런데… 그 페보니우스 기사단에 들어갔다니"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "다이루크에 대해 알기·첫 번째",
      "text": "무슨 일이야?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "다이루크에 대해 알기·두 번째",
      "text": "응, 기사단? 흥… 별로 할 말이 없어. 가려는 길이 다른 것뿐이야"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "다이루크에 대해 알기·세 번째",
      "text": "집사 말고 다른 사람과 대국을 하는 건 오랜만이군. 모처럼 한가한데, 한 판 하지"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "다이루크에 대해 알기·네 번째",
      "text": "체크메이트, 날 이렇게 몰아붙이다니, 제법이군"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "다이루크에 대해 알기·다섯 번째",
      "text": "자네 꽤 실력 있군. 체스도 그렇고, 함께하는 전투도 아주 믿음직해. 아니… 이런 협력관계는 나한테도 신기해…. 그럼 앞으로도 함께하지, 「친구」"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "다이루크의 취미…",
      "text": "와이너리의 그 예술품? 그건 내 것이 아니야. 선친께서 수집하신 것들이지"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "다이루크의 고민…",
      "text": "정말로 쓰러뜨려야 할 적, 죄악으로 뒤덮인 「어둠」은 검이 아닌 다른 수단으로 절단해야 하지…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "잔에 든 게 무슨 술이냐고? 포도 주스일세, 보통 이걸 마시지"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "난 술을 좋아하지 않아. 그냥… 술맛이 싫어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "정교한 요리군. 계속 생각날 맛이야"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "요리사의 노력이 느껴져. 나쁘지 않아"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "…고마워"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해. 오늘은 너의 소중한 날이야. 네 소원을 말해봐. 내가 할 수 있는 일이라면 한번 생각해보지"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "목표 달성을 위해 힘은 반드시 필요해"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "나아가는 길에 뭐가 있냐고? 그런 건 별로 신경쓰지 않아.\\n누가 앞을 가로막고 있다 해도 난 전진해야 돼"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "힘이 강해졌어…. 아직 부족하지만, 전방을 향한 탐색은 멈출 수 없어.\\n「여명」이 오기 전 「어둠」을 조금이라도 밝힐 사람이 있어야 해"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "난 악을 소탕하려면 기나긴 밤을 홀로 걸어야 한다고 생각했어.\\n하지만 네 의지에 내가 틀렸다는 걸 또 한 번 깨달았지. 「동료」, 고마워"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "흠"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "핫"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "찻!——"
    },
    {
      "id": "100010",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "하앗!"
    },
    {
      "id": "100011",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "하"
    },
    {
      "id": "100012",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "촤앗!——"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "지금——선고한다!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "불꽃이여——타올라라"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "심판한다!"
    },
    {
      "id": "200010",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "이곳에서——청산한다!"
    },
    {
      "id": "200011",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "화염이여——불살라라!"
    },
    {
      "id": "200012",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "여명이여——강림하라!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "흠, 티끌 모아 태산이라고 생각하지"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "나쁘지 않군"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "조금씩 저축하지"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "이 정도로는…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "젠장…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "반드시 대가를 치르게 해주마"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "…조심해"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "컨디션이 별로면 가서 쉬어도 돼"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "잘못… 계산한 건가…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "패자는… 말이 없지…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "소멸하는 건가…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "망할"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "출발하지"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "이번 임무의 목표는…"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "어서 해치워버리자고"
    }
  ]
}