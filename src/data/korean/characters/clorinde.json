  "outfits": [
    {
      "id": 209800,
      "name": "영광의 검",
      "description": "클로린드의 코스튬. 힘이 받쳐주지 않는다면 법률의 존엄성과 정의를 기반으로 한 질서는 유지되기 어렵다. 그리고 제복을 입은 클로린드는 그 무엇보다도 강력한 억제력이다",
      "isDefault": true,
      "characterName": "클로린드",
      "characterId": 10000098,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Clorinde_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "폰타인의 결투 대리인 클로린드라고 한다. 날 결투 대리인으로 고용하려면 먼저 어떤 상황에 처한 건지 설명하도록 해…. 감정 같은 건 덧붙일 필요 없어. 나와는 무관한 일이니까"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·상대",
      "text": "결투 중에 많은 상대를 만났어. 대부분은 나에게 졌고, 나머지는 스스로 항복했지…. 내가 진 적이 있냐고? 아니"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·결투 대리인",
      "text": "결투 대리인은 내 직업이야. 내가 어떻게 생각하든 중요하지 않지. 검을 손에 쥐는 순간, 나는 폰타인의 율법과 규칙의 대리인이니까"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·필승의 법칙",
      "text": "결투는 의지의 싸움이고, 검은 결투인의 마음의 연장선이지. 만일 네 마음이 움츠러든다면, 검도 칼집에 숨은 것처럼 누구도 베어낼 수 없게 될 거야"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "사냥감은 비가 올 때 쉬더라도, 사냥꾼은 그럴 수 없어"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "바람과 구름의 싸움이 승부가 난 모양이네"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "세상에 악인이 한 명이라도 줄어들었길"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "신기하네. 쓸쓸하기도 하고"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "…폰타인이 이렇게 그리운 건 처음이야"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침. 커피 마시러 가는 길인데, 같이 갈래? 커피잔도 따로 챙겼는데, 필요하면 하나 빌려줄게"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "미안, 아직 업무 시간이라서. 샌드위치 줄 테니까 배부터 채우고 있어"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "미안, 술을 음미하는 방법에 대해선 나눌 수가 없네. 대신 독특하고 유명하지 않은 식당을 몇 군데 알려 줄게"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "잘 자. 나도 무기 정비를 마치면 쉴 거야"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "클로린드 자신에 대해·신문 기사",
      "text": "신문에는 늘 공정하거나 정의롭다고 할 수 없는 기사가 섞여 있어. 그걸 쓴 사람들은 정과 모라에게 휘둘린 거야.\\n무언가의 진실을 알 수 있는 가장 좋은 방법은 그 사건과 관련된 사람을 찾아내서 직접 묻고, 마음으로 이해하는 거지.\\n적어도 남의 혀가 네 머리를 지배하게 하지는 마"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "클로린드 자신에 대해·총과 장검",
      "text": "내 무기 장비는 그림자 사냥꾼의 전통 방식을 따른 거야. 화승총으로 사냥감을 몰고, 장검으로 치명타를 날리지.\\n물론 대리 결투 중에는 장검만 쓰는 편이야. 결투장의 상대는 도망칠 곳이 없으니, 구석으로 몰 필요도 없으니까"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·의식",
      "text": "결투를 시작하기 전에 난 특제 약물에 담근 천으로 무기를 닦아. 관리를 위해서기도 하지만, 냉정함을 유지하고 잡념을 없앨 수 있거든.\\n너도 검을 쥔 사람인 만큼 너만의 의식이 있겠지?"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·사람과 그림자",
      "text": "내 많은 습관은 전부 그림자 사냥꾼의 전통에서 비롯됐어. 차이라면 그림자 사냥꾼은 사악한 마물을 상대하고, 난 범죄자를 상대하지. 다만 마물은 사악하게 태어난 존재들이라 그게 본능이라지만, 타락한 자들은 선하게 살 능력과 기회가 있었는데도 왜 스스로 악을 택한 걸까….\\n너는? 네가 검을 쥐는 이유는 뭐야?"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」을 얻은 뒤로, 결투 중에 항복하는 사람이 눈에 띄게 늘었어. 어떤 대리인은 이 「신의 눈」이 내가 결투할 때 쓰는 「위협 수단」이라고 하더라.\\n나는 패배한 적 없는 내 결투 전적이야말로 「위협 수단」이라고 여겼는데, 앞으로의 결투에서 더욱 많은 걸 보여줘야 할까 봐"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "가끔은 황당한 분쟁도 있어. 사소한 갈등을 당사자가 감정적으로 곱씹어, 인간의 존엄이 달린 물러설 수 없는 치욕이 되고, 심판청에 서거나 심지어 결투로까지 이어지는 거지.\\n결투 대리인으로서 나는 결투로 명예를 지키는 걸 반대하지 않아. 하지만 뭐랄까… 한 명의 폰타인 시민으로서는, 커피에 마코트 풀을 넣을지 말지 때문에 굳이 검까지 뽑아야 하나 싶어…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "퐁퐁나무 본 적 있지? 날아다니는 속도와 위치를 예측하기 어려워서 사격 연습에 제격이야. 하지만 야외에서 퐁퐁나무를 찾기가 쉽지 않더라. 누가 퐁퐁나무를 재배하면 좋을 텐데…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "샤를로트에 대해…",
      "text": "샤를로트 씨는 눈치 빠른 기자지. 나쁜 감정은 없어.\\n샤를로트 씨는 출근길을 막고 사진을 찍거나, 카페까지 따라와서 내가 오늘 무슨 커피를 마셨나 기록하지 않거든. 무엇보다 내가 인터뷰 요청을 받지 않는다는 걸 알아서 먼저 말을 걸지도 않는다는 게 가장 마음에 들어"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "푸리나에 대해…",
      "text": "전에는 푸리나 씨의 티타임에 참여할 때마다 늘 검을 쥐고 그분 뒤에 서 있었는데, 지금은 긴 테이블에 마주 앉아 함께 티타임을 즐기게 됐어.\\n위치가 바뀌고 나니까, 푸리나 씨가 왜 늘 「몸매 관리」를 중얼거리셨는지 알겠더라"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "나비아에 대해…",
      "text": "나비아가 요즘 기분이 좋더라. 하루가 멀다하고 날 「테이블 극단」으로 데려가 새로운 대본을 플레이하고 있어.\\n소재는 정말 다양해. 대본 진행자도 몇 번 해봤고, 플레이어로서 함께 모험한 적도 있지. 다만 심판청 관련 캐릭터는 최대한 피하는 편이야. 분위기가 너무 엄숙해질까 봐…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "느비예트에 대해…",
      "text": "최고 심판관님의 권위를 믿어 의심치 않아. 늘 가장 공정한 판결을 내리시니까. 필요할 땐 나도 검으로 판결의 공정성을 바로 세울 거야"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "슈브르즈에 대해…",
      "text": "슈브르즈 대장에 대해선 들어 봤어. 범인을 너무 강압적으로 잡은 탓에 몇 번 기소당했거든. 심판에서조차 성질을 굽히지 않고 반박으로 상대의 말문을 막아버렸다지. 정말 훌륭해"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "리니에 대해…",
      "text": "그 대마술사의 실력은 정말 훌륭해. 시간 되면 관중으로서 마술을 감상해야겠어"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "프레미네에 대해…",
      "text": "어제 미니 기계 장난감과 감사 카드가 담긴 소포를 받았어. 정말 정교한 장난감이라 다음에 기회가 되면 프레미네 씨에게 직접 감사 인사를 전하고 싶어…. 직접 만나진 않는 게 좋다고? 알았어, 그럼 나도 카드를 쓸 테니까, 네가 대신 전해줘"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "치오리에 대해…",
      "text": "그 사람 가게에서 옷을 사본 적이 있는데, 질이 좋더라. 다만 평소엔 이 제복을 입는 편이야. 내 신분을 간편하게 설명할 수도 있고, 내가 또 익숙한 걸 좋아하는 편이기도 하거든. 이 제복은 내 검과 비슷해. 익숙하고 편하니 바꿀 필요가 없지"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "라이오슬리에 대해…",
      "text": "메로피드 요새는 관리하기 쉬운 곳이 아니야. 그런 곳을 상대적으로 안정되게 유지하는 걸 보면 라이오슬리의 수완은 의심의 여지가 없어.\\n물론 그중엔 겉으로 드러낼 수 없는 수단도 있겠지만, 그건 우리가 알 도리가 없지"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "시그윈에 대해…",
      "text": "시그윈 씨는 훌륭한 간호사야. 의술만 뛰어난 게 아니라, 사람의 마음을 보듬는 법도 잘 알고 있어. 메로피드 요새의 악질 범죄자들도 분명 그녀의 성품과 마음에 감동받아 선의가 다시 솟아났을 거야.\\n그리고 그 선의는 그들을 다시 올바른 길로 인도할 계기가 될 테지"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "에밀리에 대해…",
      "text": "그 조향사 얘기는 들어봤어. 그녀의 진짜 직업에 대해서도 들었고. 한 번은 따뜻한 미소를 지으며 길가의 강아지를 쓰다듬는 걸 우연히 봤어. 우리는 서로 고개를 끄덕이곤 작별했지"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "클로린드에 대해 알기·첫 번째",
      "text": "결투 대리인의 일은 복잡하지 않아. 심지어 아주 간단하다고 할 수 있지. 심판청의 요구에 따라 상대를 꺾기만 하면 돼. 다른 건 생각할 필요도 없어.\\n…그래서 몇몇 사람들은 나를 「사형 집행인」이라고 부르나 봐"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "클로린드에 대해 알기·두 번째",
      "text": "결투 대리를 할 땐 최대한 상대와 공평하게 겨루도록 노력해. 시각 장애가 있는 상대라면 나도 눈을 가리고, 다리가 불편한 상대라면 스스로 이동 범위를 제한하기도 하지. 어찌 됐든 나는 반드시 공정한 결투를 해야만 해"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "클로린드에 대해 알기·세 번째",
      "text": "결투를 앞두고 항복하는 사람이 정말 많아. 무기를 뽑을 용기도 없으면서 원통하다느니 명예 훼손이니 하는 건 전부 자기만의 이기적인 주장일 뿐이지.\\n그런 사람들은 모두 자기 자신에게 진 거야. 내가 손을 쓸 필요도 없이 스스로 마음의 죄수를 자처하는 거지"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "클로린드에 대해 알기·네 번째",
      "text": "심판청의 죄인을 본 적 있어? 내가 겪은 심판에서 죄인들은 늘 좋은 사람인 척 우기곤 했어. 그들은 폭력을 의로운 행위로, 범죄를 정의로 포장했지…. 하지만 변명의 끝은 모두 같았어. 자기가 잠깐 실수한 건 맞지만 이런 죄는 누구나 저지를 수 있으니, 질책해선 안 된다는 거였지.\\n그들은 더러운 자신의 모습을 감추기 위해 온 샘물을 오염시키는 자들이야.\\n그리고 난 그 죄인들의 거짓말을 무너뜨리고 정의의 샘물을 정화하기 위해 결투 대리인이 된 거고"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "클로린드에 대해 알기·다섯 번째",
      "text": "심판청에선 인정에 호소하는 사람도 많았어. 그 심정은 존중하지만, 장소 선택이 잘못됐다고 생각해.\\n심판청은 공평과 정의를 선포하는 곳이고, 정의는 항상… 냉정하지. 아니면 이어질 수 없거든.\\n정의에 인정이 섞이면, 간혹 오해와 왜곡에 의해 공정해야 할 「심판」이 정에 휘둘리는 「사적인 판단」이 되어버려. 그리고 심판청의 「사적인 판단」은 위법적이고 흉악한 폭행과 다를 바 없지"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "클로린드의 취미…",
      "text": "결투 대리와 다르게, 「테이블 극단」 진행자라는 신분은 내가 이야기나 정에 휘둘리지 않고, 한 발짝 뒤에서 내가 주도하는 세상 속 사람들의 다양한 반응을 살필 수 있어. 응? 꼭 우리 속에 갇힌 사냥감 같다고? 일리 있는 말이야…. 그렇게 생각해 보지 못했어. 다만 난 플레이어를 곤란하게 하지 않아. 최대한 재미있게 이야기를 즐길 수 있도록 최선을 다하지. 그런 면에서 사냥과는 전혀 달라"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "클로린드의 고민…",
      "text": "기자들이 커피를 마시거나, 꽃을 사거나 책을 읽는 걸 그만 방해했으면 좋겠어. 안 그러면 몇 명을 잡아다가 심판청에 기소하고 말 거야. 대리 결투를 신청한다면 카메라를 들고 오라고 해야지. 물론, 공정을 위해 나도 카메라만 들고 가겠어"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "고기로 만든 요리는 다 좋지만, 무조건 신선해야 해. 방금 잡은 고기에 소금 간을 간단히 하고 구운 뒤, 새콤한 과일을 옆에 곁들이면 분명 맛있을 거야. 다음에 기회가 되면 내가 사냥 가는 걸 따라와. 한번 맛보게 해 줄게"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "생선은 내 입에 안 맞아. 가시가 너무 많고, 비린내도 나서…. 어릴 때 너무 많이 먹은 모양이야"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "완벽해, 내 입에 안성맞춤이야. 기자나 미식가한테 들키진 마. 그 사람들은 카메라와 신문으로만 요리를 즐기니까"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "음, 괜찮네. 천천히 음미할 가치가 있어"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "…식당에서 만든 요리가 아니라 다행이야. 식당이었다면 요리사와 손님 사이에 분쟁이 있었겠지"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해. 선물로 이 단검 모양의 목걸이를 만들어 봤어.\\n그림자 사냥꾼의 전통에 따르면, 새 멤버의 첫 번째 생일엔 지도 교관이 새 멤버의 이름을 새긴 단검 목걸이를 만들어서 선물해. 그리고 항상 걸고 다니라고 당부하지. 마음을 가리키는 칼날로 자신이 악에 물든 게 아닌지, 한눈팔지 않았는지, 악을 물리칠 결심이 충분한지 항상 물어보라는 뜻이야.\\n넌 그림자 사냥꾼이 아니지만, 우리처럼 선을 위해 악을 벌할 결심이 있다고 믿어.\\n왜 화승총 모양이 아니냐고? 화승총은 불발할 수도 있는데, 마음을 가리키는 수단이 너무 극단적인 건 별로니까"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "그렇군. 확실히 발전했어"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "검을 휘두르는 감이 더 좋아졌네, 완전 적응했어"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "눈썰미가 좋아진 건가? 저 낙엽을 한 번 맞혀봐야겠어"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "내 무력이 필요할 것 같진 않지만, 내 힘을 빌리고 싶다면 언제든 최선을 다해 도울게"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "준비"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "장전"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "그림자 사냥!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "악을 쏜다!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "자백할 시간이다"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "그림자 속에서 악을 꿰뚫으리!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "운이 좋네, 훌륭해"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "주인 없는 물건은 분쟁의 여지가 없지"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "선착순인가, 합리적이군"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "…빨리 승부를 내야겠군"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "거만하게 굴지 마…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "…우습군"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "일단 퇴각해!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "내가 맡을 테니 물러서"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "승패는… 정해졌어…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "패자는… 이렇게…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "네 명예는 증명됐다…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "제법 정확하군"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "거기까지다!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "네 초대에 응할게"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "결투 대리인으로 나서 줄까?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "내 칼날은 그림자를 겨누지"
    }
  ]
}