    },
    {
      "id": 202100,
      "name": "「만점 정찰 기사」",
      "description": "엠버의 코스튬. 정찰 기사에 알맞은 기동성이 뛰어난 복장이다",
      "isDefault": true,
      "characterName": "엠버",
      "characterId": 10000021,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Ambor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "정찰 기사 엠버, 대령이오! 앞으로 도움이 필요하면 말만 해!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·관심사",
      "text": "달리기 좀 하고 싶네"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·근심",
      "text": "게으름 피우는 걸 진이 본다면, 언짢아할 거야"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·새로운 발견",
      "text": "저쪽에 뭔가 이상한 게 있는 것 같아…. 가보지 않을래?"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때·걱정",
      "text": "비가 오네…. 나비 리본이 젖겠어…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 올 때·주의",
      "text": "비가 오네…. 시야 확보가 어렵겠어. 조심해야지"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "우와~ 날씨 좋다"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "음… 바람이 조금만 더 강하면 좋겠는데"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "바람이 불 때·만족",
      "text": "진짜 상쾌하다…"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "바람이 불 때·휴식",
      "text": "이런 날씨 정말 좋아. 아, 좋다~"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침! 같이 조깅할까?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "나와 같이 점심 먹을래?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "날이 저물었어. 횃불에 불을 붙여줄까?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "맞아, 휴식도 중요하지! 그럼 약속한 거다. 내일 봐!"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "엠버 자신에 대해…",
      "text": "몬드성의 비행 챔피언, 그게 바로 나야!"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·시합",
      "text": "아무리 너라도 시합에서는 안 봐줘!"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·비행",
      "text": "네 가르침 덕분에 실력이 빨리 늘었어. 아, 나, 나도 바보는 아니야. 그 정도는 안다고! 엥, 왜 웃어? 좋아, 시합하자고, 지금 당장!"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "신의 눈, 신이 날 인정했다는 거겠지. 그래, 난 최고의 정찰 기사가 될 거야!"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "가자~ 대성당 종탑에 가자, 경치 죽인다니까!"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "봐, 저기 비둘기가 있어! 비둘기와 함께 날고 싶어"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "진에 대해·도움",
      "text": "어… 진 단장이야. 진을 도울 일이 있는지 가볼게"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "진에 대해·친절",
      "text": "진 단장은 아직 일하는 중이야…? 가자, 가서 진과 커피 한잔하자"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "리사에 대해·이야기 듣기",
      "text": "한가해지면 같이 리사한테 가보자! 전에 드래곤 스파인에 있는 보물 이야기를 듣다가 말았거든, 으… 다음 내용이 궁금해!"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "리사에 대해·감탄",
      "text": "리사는 잠자는 시간 외엔 책만 보는 것 같아! 정말 대단해. 난 그렇게 엉덩이가 무겁지 않아"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "케이아에 대해·우려",
      "text": "…뭔가 불안한 느낌! 방금 케이아 선배와 함께 있었지? 케이아 선배가 귀찮게 굴지 않았어?"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "케이아에 대해·원흉",
      "text": "화단의 민들레가 시들시들해 보이네. 흠… 분명 그 녀석 짓이야!"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "베넷에 대해…",
      "text": "응? 베넷이라…. 어디서 들어본 것 같은데... 아! 모험가 길드의 그 열정적인 남자애. 응, 비경 근처에서 가끔 만난 적 있어. 보물찾기에 아주 열성이더라구"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "클레에 대해…",
      "text": "클레는 장난이 종종 심하지만, 기사단 사람들은 모두 클레를 좋아해. 음… 또 진에게 잡혀 갇히는 일이 없도록 잘 지켜봐야겠어"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "알베도에 대해…",
      "text": "알베도는 대부분 공방에 틀어박혀서 뭔가 대단한 것들을 연구하지. 하지만 볼 때마다 뭘 생각하고 있는지 통 모르겠어. 흠, 도저히 짐작이 안 돼…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "노엘에 대해…",
      "text": "노엘? 노엘은 근성이 정말 강하지. 네가 선배니까 그 애를 좀 잘 돌봐줘"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "유라에 대해…",
      "text": "유라는 내 좋은 친구야! 유라의 농담에 적응하면 친해지기 쉽다는 걸 알 수 있어. 유라는 가문의 성씨 때문에 항상 사람들한테 오해받거든. 어떻게 해야 사람들이 걔를 이해해줄까…?"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "콜레이에 대해…",
      "text": "콜레이가 편지로 「비늘병」이 완치되었다고 알려줬어…. 정말 다행이야! 지금 당장 날아가서 꽉 껴안아 주고 싶어. 몬드에 있는 우리가 많이 보고 싶나 봐. 홀로서기 할 수 있는 날이 오면 와서 직접 성장 스토리를 들려주겠대…. 아, 다음 하르파스툼 축제 때 만날 수 있었으면 좋겠다. 벌써 기대돼!"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "미카에 대해…",
      "text": "아! 미카는 유라의 오랜 대원이야. 처음에는 나와 유라가 친해서 그런지 나한테도 대장님이라고 불렀어. 내 정찰 노하우를 알려준 뒤부터는 계속 선배라고 부르는데… 어찌나 쑥스럽던지. 맡고 있는 분야가 다른데 선후배가 어디 있어. 지도를 그리는 건 미카가 전문가라 난 아무리 해도 따라잡을 수 없는걸"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "엠버에 대해 알기·첫 번째",
      "text": "나도 사냥 잘해! 어때, 내 솜씨 좀 볼래? 아니면… 사냥 시합 한판 할까?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "엠버에 대해 알기·두 번째",
      "text": "어떻게 비행 챔피언이 됐는지 알려줄게! 가장 중요한 건 용기야!"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "엠버에 대해 알기·세 번째",
      "text": "사실 난 수수께끼 잘 못 맞혀, 하르파스툼 축제에서 수수께끼 맞히기 코너는 항상 돌아서 가지…. 넌 안 그래?"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "엠버에 대해 알기·네 번째",
      "text": "난 할아버지 때문에 기사단에 가입했어. 그리고 진 단장 때문에 기사단에 남았지. 이제 너와 함께 몬드 이외의 세상을 구경하게 돼서 기뻐"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "엠버에 대해 알기·다섯 번째",
      "text": "난 더 멀리 나가고 싶어. 하늘의 끝을 보고 싶다고! 너도 계속 나와 함께할 거지?"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "엠버의 취미…",
      "text": "내 취미는 토끼 백작을 꾸미는 거야"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "엠버의 고민…",
      "text": "음… 어떻게 해야 맛있는 달빛파이를 만들 수 있는지 알아?"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "진 단장이 탄 커피는 향이 최고야! 너도 언제 한번 마셔봐"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "고리고리 주스만 아니라면… 다 견딜 수 있어!"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "와, 너무 맛있어. 넌 역시 대단해!"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "나도 이런 솜씨가 있으면 참 좋을 텐데…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "이런 맛은 좀 생소하네, 미안! 네 잘못 아니야!"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "헤헤헤, 생일 축하해! 자, 받아, 내가 직접 바느질한 「토끼 백작 특제품」이야…. 걱정 마! 특제품이라고, 폭발하지 않아!"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "와! 순풍을 탄 것 마냥 가벼운데~"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "지금의 속도라면 누구도 따라올 수 없겠지!?"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "몬드의 하늘이 작아진 것 같아…. 아니면 내 시야가 넓어진 건가?"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "지금의 난 처음 만났을 때보다 훨씬 강해졌지? 헤헤, 진짜 고마워! 내가 허니캐럿그릴을 대접할게. 날 따라와! 얼른~"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "너만 믿을게~"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "나와라~ 토끼 백작!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "♪딴따딴~ 따딴~"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "백발백중!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "화살… 비!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "퇴로는 없어!"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "시합해보자~"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "대시 시작·두 번째",
      "text": "날 따라잡을 수 있겠어?"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "대시 종료·첫 번째",
      "text": "날 앞지를 수 없다고 했잖아"
    },
    {
      "id": "710002",
      "type": 2,
      "title": "대시 종료·두 번째",
      "text": "바로 이 느낌이야!"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "내가 비행 챔피언이야!"
    },
    {
      "id": "800002",
      "type": 2,
      "title": "바람의 날개 사용·두 번째",
      "text": "내게 맡겨!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "보물상자를 열 때가 제일 신나!"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "정찰 기사, 목표 발견!"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "우와, 좋은 것만 있네!"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "…난 절대 지지 않아!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "아야… 저 녀석…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "날 얕보지 마!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "조심해!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "너… 괜찮아? 도와줄까?"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "너무 달렸더니 힘들어…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "훈련이… 아직도 부족한가?…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "이번엔… 내가 졌네…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "진짜 성가셔!"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "아야!"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "반칙이야!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "나한테 맡겨!"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "준비 완료!"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "정찰 기사 등장!"
    }
  ]
}