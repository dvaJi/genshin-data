  "outfits": [
    {
      "id": 202000,
      "name": "들판 질주",
      "description": "레이저의 코스튬. 야외에서 뛰어다니기 편한 복장이다",
      "isDefault": true,
      "characterName": "레이저",
      "characterId": 10000020,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "너한테 좋은 냄새가 나. 같이 사냥하자!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·냄새",
      "text": "음~ 토끼의 냄새…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·배고픔",
      "text": "안 가? 배고파"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·바람맞이",
      "text": "바람 좀 쐬고 올게. 출발할 때 불러"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "번개가 칠 때·일깨움",
      "text": "무서우면 숨어 있어도 돼"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "번개가 칠 때·안내",
      "text": "나무에서 물러나. 나만 따라와!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "바람… 음… 좋다"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "바람… 음… 따끔따끔하니 살짝 아픈데"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "해가 떴어. 같이 사냥하러 갈래?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "고기 덩어리, 좋아!"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "넌 얼른 자. 난 달을 볼 거야"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "넌 얼른 자, 내가 지키고 있을게. 내일 같이 사냥하자"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "레이저 자신에 대해…",
      "text": "나는 늑대. 인간 아빠와 엄마는… 없어"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·친구",
      "text": "넌 내 친구. 나랑 같이 사냥하자"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·무기",
      "text": "난 강철 발톱과 번개의 이빨을 가지고 있어. 내가 널 지켜줄게"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」, 사부가 도와줬어. 번개야 싸우자. 「루피카」를 지켜"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "밤하늘의 별들은 정말 아름다워. 하늘뿐만 아니라 호수에도 별들이 가득 차있어.\\n밤에는 도시에도 많은 별들이 있어"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "나의 「루피카」인 늑대. 그들은 내 가족이야."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "리사에 대해…",
      "text": "사부의 번개, 하늘이 어두워질 거야. 엄청 무섭고 엄청 쎄"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "바바라에 대해…",
      "text": "바바라는 반짝반짝 빛나는 소녀야. 엄청 착해"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "다이루크에 대해…",
      "text": "다이루크는 빨갛고 까맣고… 그리고 차갑고 뜨거워"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "벤티에 대해…",
      "text": "시가… 음 몰라. 잘 모르지만 「루피카」 좋아해"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "베넷에 대해…",
      "text": "베넷, 말이 많아. 그와 함께라면 배불리 먹을 수 없어"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "클레에 대해…",
      "text": "클레, 친구! 친구지만 골치 아파"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "바르카에 대해·낯섦",
      "text": "바르카? 몰라…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "바르카에 대해·추억",
      "text": "아… 바르카는 이름이야. 그 남자는 숭고하고 위대해. 레이저라는 이름, 강철 발톱, 그가 줬어. 음… 그 사람이 보고 싶어"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "레이저에 대해 알기·첫 번째",
      "text": "네 냄새, 착한 냄새. 고기 좋아해?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "레이저에 대해 알기·두 번째",
      "text": "넌 강해. 늑대처럼! 너랑 사냥하면 수확이 많아서 좋아"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "레이저에 대해 알기·세 번째",
      "text": "루피카는 「늑대의 집」이… 아냐! 「늑대의 가족」. 내 루피카는 숲속에 있어. 그들은 날 지켜주면서 나한테 루피카라고 했어"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "레이저에 대해 알기·네 번째",
      "text": "난 루피카밖에 없어.\\n하지만 루피카라고 해도 난 다리가 2개밖에 없어서 진짜 늑대가 될 수 없어. 때때로 마음이 괴로워…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "레이저에 대해 알기·다섯 번째",
      "text": "너랑 같이 달리면 즐거워. 너랑 같이 사냥하면 즐거워. 너랑 같이 있으면, 내가 늑대이든, 사람이든, 전혀 상관없어.\\n넌 내 친구, 넌 내 「루피카」야. 너도 즐거우면 좋겠어"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "레이저의 취미…",
      "text": "루피카가 좋아. 그리고 숲이랑 친구도 좋아. 뛰어다니는 것도 좋아"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "레이저의 고민…",
      "text": "말하기 힘들고 어렵지만 안 할 순 없어"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "고기 좋아. 감자 좋아"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "채소는 싫어! 내가 먹는 고기들이 채소를 먹어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "향도 좋고, 맛도 좋아. 마음에 들어"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "먹으니까 기운 나. 행복해"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "먹는 것도 싫고, 안 먹는 것도 싫어. 좀 슬퍼졌어"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘은 네가… 그러니까 아주아주 오래전 오늘 태어났잖아. 너랑 같이 놀고 싶어. 오늘 같이 고기 먹자"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "팔뚝이 더 두꺼워졌네…?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "발톱과 이빨을 갈고 더 강해져야 해!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "달리고, 사냥. 부족해, 안 돼! 난 더 강해져야 해"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "이빨, 발톱, 다리. 더 강하고 힘이 있어야 널 지켜!"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "비켜!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "이얍!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "오우!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "오지 마!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "아우——"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "Blitz!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "흐아——"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "원소폭발·네 번째",
      "text": "이얍——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "쓸모 있는 물건들 같아"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "상자는 다 쓰면 물건을 담을 수 있어"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "보물의 냄새, 이상해"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "아파"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "아우——"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "죽여버리겠어!…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "안 돼"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "살아남아!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "으… 숨을 쉴 수가 없어…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "돌아가고 싶어…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "나의… 루피카…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "입안이… 짜…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "내가 앞장설게"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "어디 가는 거야?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "뒤는 내게 맡겨"
    }
  ]
}