  "outfits": [
    {
      "id": 203000,
      "name": "속세 생활",
      "description": "종려의 코스튬. 「왕생당」 객경인 종려 선생이 요즘 가장 선호하는 일상복이다",
      "isDefault": true,
      "characterName": "종려",
      "characterId": 10000030,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Zhongli_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "새로운 「계약」? 좋아… 아직 휴가 기간이지만 함께 가주지. 계약서에 무슨 이름으로 서명해야 하지? 이름이 여러 개인데. 휴가 기간이라면… 난 「종려」야. 넌 여행자? 넌 무슨 이름으로 서명할 건가?"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·여정",
      "text": "여정은 언젠가 끝나게 돼. 그러니 서두를 필요 없어"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·유람",
      "text": "이제 어디 가고 싶어? 리월의 명승 고지를 둘러보고 싶다면 괜찮은 방법이 있어"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·리월",
      "text": "「유통」을 위해 지은 배는 항구에 정박하지. 그러니 리월은 모든 재물이 「모이는」 곳이야"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "잡담·회고",
      "text": "계화꽃을 사서 좋은 술을 가지고 옛 친구와 함께 뱃놀이를 가고 싶으나…. 옛 친구는 언제 다시 만날 수 있으려나?"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "「유리주머니」 같은 식물은 습한 환경을 좋아해서 비가 온 후 따는 게 좋아. 찾아낸다면 적당히 저장해 둬"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "어디 가서 눈을 피하지. 난 괜찮은데, 넌 감기 걸릴지도 모르니"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "휴가를 보내기엔 좋지 않은 날씨군. 가서 경극이나 감상하자고"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "오늘도 경치가 근사하면 좋겠군"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "기운이 나는 걸 먹고 싶어? 음… 흘호암에 괜찮은 식당이 있어"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "운 선생의 경극을 놓쳤지만, 밤의 리월에는 가볼 만한 곳이 많아"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "시장은 문을 닫았고 떠들썩한 부두도 깊은 잠에 빠졌구나. 가서 쉬어"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "종려 자신에 대해…",
      "text": "규칙이 없다면 일을 이룰 수 없어. 평범한 사람이나 선인이나 각자의 임무를 다해야 리월이 계속 평화롭지"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·황금",
      "text": "황금은 리월의 재물이자 리월의 심장을 뛰게 하는 피야. 네가 황금처럼 빛나는 마음이 있는지 기대해 보겠어"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·계약",
      "text": "너와 나와 「계약」으로 맺어진 벗——그럼 계약 범위 안의 일이라면 나와 상의할 수 있어"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·공평",
      "text": "「계약」 밖의 일을 상의해도 돼. 이 땅에서 이렇게 오래 살았으니 웬만한 일은 대략 알지. 물론 네가 날 위해 해주었으면 하는 일이 있긴 해. 그래야 「공평」한 셈이니까"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "우리에 대해·곤혹",
      "text": "「계약」은 「우정」과 「정」을 구분하고 측정할 수 없어. 그럼 대체 어떻게 해야 우리 우정의 무게를 잴 수 있을까? 「친구」, 너는 답을 아는가?"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」… 역시 일종의 「계약」이야. 모든 힘에는 대가가 따른다는 걸 알아야 해. 천 개의 권력에는 천 개의 책임이 따라"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "「거래」의 규칙은 「계약」이고 준칙은 「공평」이지. 「계약」을 맺고 준수하는 자는 절대 잊어선 안 돼. 공평함을 잃게 되면 계약은 기만의 근거가 되지"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "「절운간」에 가면 「청심」을 한 묶음 따다 줘. 한 묶음이면 돼. 여비는… 아, 잊을 뻔했네, 「계약」 기간에 여비는 네가 대신 지불해. 그럼 수고하도록"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "소에 대해…",
      "text": "귀리 평원의 어린 선인…. 아… 지금까지 그는 자신의 직책을 이행하고 있어…. 이 「열리진심산」을 그에게 전해줘. 맞다, 페이몬이 훔쳐 먹지 못하게 해. 이것의 약효는… 아무나 감당할 수 있는 게 아니야"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "벤티에 대해…",
      "text": "으… 진한 술 냄새. 그 시인이 방금 왔었군, 고상한 구석은 하나도 없는 주정뱅이 시인 같으니라고! 자네… 으, 그의 유혹에 넘어가 진탕 마셨군. 말도 제대로 못하고… 기다려 내가 「정신 드는 차」를 끓여오지. 6시간이면 되니 잠깐 기다려…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "응광에 대해…",
      "text": "매일 처리하는 일이 아무리 많아도 그녀는 진취적인 마음을 잃지 않아. 정말 대단하지. 그 당시 그녀가 맨발로 요광 해안에서 남쪽 마을로 향하며 물건을 팔던 생각이 나는군. 시간은 평범한 사람에겐 너무 잔혹해…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "호두에 대해…",
      "text": "지금의 당주? 크흠… 나 그 아이는 상대 못 해"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "타르탈리아에 대해·침착",
      "text": "스네즈나야에서 온 그 무사는 아직도 리월에 있는 건가? 흐흠, 괜찮아, 만약 그가 널 해코지하면 날 불러"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "타르탈리아에 대해·술상",
      "text": "우인단 내에서 「타르탈리아」의 소문이 또 안 좋아진 모양이야. 하지만 그와 같은 자라면 분명 자신에 대한 불만을 없애버리기 위해 적극적으로 나서겠지. 흠… 다음번 술자리에서 또 재밌는 얘기를 많이 들을 수 있겠군. 여행자, 너도 올래?"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "감우에 대해…",
      "text": "리월의 번영은 절대 「암왕제군」의 신탁에 의해서만 완성된 게 아니다. 「계약」에 응답한 무수한 바위 신의 백성들이 있었기에 가능했지. 그중에서도 감우는 취임한 지 가장 오래됐어. 그녀의 과거라면… 그녀가 날 원망할 수도 있으니, 가서 직접 물어보게"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "각청에 대해…",
      "text": "그녀는 현재 칠성 중에서 가장 「신을 공경하지 않는 사람」이야. 하지만 난 이런 사람이 꽤 마음에 들어. 「자신이 맞다고 생각하는 걸 과감히 이야기하고 행동으로 옮기는 것」——리월에 이런 사람이 있기에 나도 은퇴를 생각할 수 있었지"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "연비에 대해…",
      "text": "그녀는 나와 「계약」을 맺지 않았지만, 자신만의 방식으로 리월 각 분야의 규칙을 지키며 편파적인 관념을 바로잡고 있어. 언젠가 그녀의 아버지가 먼 여행에서 돌아오면 나보다 더 뿌듯해하겠지"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "바알에 대해…",
      "text": "시간은 모든 의지를 단련해. 그리고 그녀는 신념을 위해 모든 걸 내던질 사람이고. 어쩌면 그래서 여기까지 왔는지도 모르지. 기회 되면 나도 그녀가 모든 걸 바쳐서 이루고자 하는 「영원」을 보고 싶군"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "부에르에 대해…",
      "text": "지혜의 신 부에르, 그녀는 수메르를 통치하는 것 외에도 세계수를 수호하는 일도 책임지고 있어. 그 위대한 지혜가 아니었다면 분명 해내기 어려웠을 거야. 특히 세계수를 구해낸 일은 티바트의 모든 생명이 감사해야 할 일이지"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "푸리나에 대해…",
      "text": "나라를 구하기 위해 「자기 자신」과 계약하고 500년 동안 그 계약을 지키며 천리의 눈을 속여왔다라…. 난 스스로 행해야 하는 모든 「정의」를 존중한다네. 신성은 사라지고 신좌 또한 더는 존재하지 않지만, 폰타인의 역사로 봤을 때 푸리나는 여전히 인정받아 마땅한 정의의 신일세"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "한운에 대해…",
      "text": "여러 상인에게서 「한운」에 관한 일화를 들었다네. 겉으론 거만하고 과묵한 것처럼 보이지만, 실제로 대화를 나누면 솔직하고 올곧은 성격이라 좋은 친구가 될 만한 자라고 하더군. 실로 기쁜 일이지. 다만 「통이 크다」는 평가는… 흠… 나도 많이 들어본 말인데 말이지…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "하보림에 대해…",
      "text": "나타는 유구한 항쟁의 역사를 시로 엮어, 대대로 무수한 전사를 격려했고, 이제는 심연과 숙명의 위협을 뛰어넘어 새로운 미래를 창조했네. 그런 그들을 이끈 건 시간과 역사를 무기로 삼은 인간 전사였지. 그녀는 가히 신과 어깨를 나란히 할 실력을 지닌 자일세. 실로 감탄스러울 따름이군"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "백마 선인에 대해…",
      "text": "백마, 백마라… 그 선인 또한 오랫동안 못 본 옛 친구지. 봄날의 밤은 짧고, 가을의 낮은 빠르니, 세월은 마치 문틈을 스치는 준마와 촛불을 스치는 바람 같구나"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "종려에 대해 알기·첫 번째",
      "text": "간만에 시간이 났는데 쉬지 않고 왜 날 찾았나? 내 이야기가 듣고 싶은 겐가?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "종려에 대해 알기·두 번째",
      "text": "「흑암 공장」의 기원에 대해 들어봤어?\\n옛날에 사람들은 천형산에서 광맥을 캐면서 안에 공장 시설을 지었어. 그러다 점점 동대륙 최대의 공장이 되었지. 산속의 비밀 통로는 거미줄처럼 퍼져있어서 땅속 깊은 곳의 고대 유적과도 연결돼. 그 통로를 다 알고 있는 사람은 아마 없을 거야"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "종려에 대해 알기·세 번째",
      "text": "「해등절」의 기원에 대해 들어봤어?\\n아주 오래전 전쟁에서 리월 사람은 전사들이 집에 오는 길을 헤매지 않고 마음을 잃지 않도록 밤에 빛나는 등을 물에 띄웠다고 해. 이런 일을 기억하는 사람은 이제 없겠지만"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "종려에 대해 알기·네 번째",
      "text": "「계약의 신」의 일에 대해 들어봤어?\\n그는 기억력이 뛰어나. 라이벌의 이름, 리월항 선박 부처가 세워지고 나서 건조한 선박의 기항 일자를 잊은 적이 없어. 어쨌든 기억력이 그렇게 좋으니 모든 「계약」을 기억할 수 있지.\\n하지만 기억력이 좋다는 건 때론 불쾌한 일이기도 해"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "종려에 대해 알기·다섯 번째",
      "text": "너무 오래 산 사람은 기억 속에서만 옛 전우, 과거의 풍경을 찾을 수 있어.\\n그렇다고 해도 난 너와 만난 걸 후회하지 않아 「친구」. 이별하는 날이 온다고 해도 자넨 내 기억 속에 황금처럼 반짝일 거야"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "종려의 취미…",
      "text": "짬이 날 때 성안을 산책하면 마음이 많이 진정돼. 어… 언제부터 이런 기분이 들었더라?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "종려의 고민…",
      "text": "사람들이 「계약」을 준수하고 계약의 규칙에 따라 행동하는 것은 「공평」하길 원해서야. 다만 이 점을 의식하지 못할 뿐이지"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "오래전에 친구와 함께 마신 술이라고 할 수 있겠지. 기후가 변해서 그런가? 흐흠, 그때의 운치를 다시 느낄 순 없을 것 같군"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "난 해산물이 싫어. 해산물을 보기만 해도 어떻게 말해야 하나…. 미끌미끌한 촉감, 지워지지 않는 비린내가 떠올라. 이유는…\\n아, 말하자면 길어. 그냥 내 기억력이 너무 좋아서 기억하고 있다고 생각하라고"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "재료도 신경 써서 골랐고 조리법도 제대로야. 대단하군"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "요리는 아주 재밌는 일이야. 너도 그렇게 느낄 테지"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "시간도 많은데, 정원에서 내 이야기나 듣지 않겠나?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해. 이건 네가 태어날 때 핀 「유리백합」을 말린 거야.\\n아주 오래전 리월 사람들은 이 꽃이 대지의 아름다운 기억과 기원을 담아 피웠다고 말했어. 네가 태어난 것도 이 꽃과 마찬가지라고 믿고 싶어"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "힘이 점점 돌아오는 것 같군. 많지는 않지만, 쓸모 있어"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "힘이 커지니 몸의 부담도 급격히 증가하는군. 난 괜찮아. 내 몸의 구조는 일반인과 다르니 걱정할 것 없어"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "신의 눈으로 원소의 힘을 쓰는 것은 평범한 사람에게는 대단한 일이었군. 그랬어, 그때 그들이 이런 각오로 내 옆에 섰던 거였어"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "신의 심장을 내려놓고 나서도 이런 경치를 볼 수 있을지는 몰랐네, 고마워 「친구」…. 참, 내게 새로운 계약이 있는데 같이 보겠나?"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "벽립천인"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "경천동지"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "미견불최"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "구수병축"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "안여반석"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "난공불락"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "하늘의 이치가 진군한다"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "이게 하늘의 이치다"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "하늘은 만물을 움직인다"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "누군가에게 버려진 진귀한 보물…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "우연히 얻은 물건도 나름 운치가 있지"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "헛걸음은 아니군"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "네 실력을 인정해주지"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "아하, 재미있군"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "위기 대처에는 자신 없어"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "섣불리 진공하면 안 돼"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "여긴 내게 맡기고 가서 쉬어"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "하아… 좀 피곤하군"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
