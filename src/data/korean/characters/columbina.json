  "outfits": [
    {
      "id": 212500,
      "name": "달빛 비단",
      "description": "콜롬비나의 코스튬. 월령들은 「서리달 아이」가 바친 직물에 달빛을 더해, 콜롬비나를 위한 가볍고 우아한 옷을 만들었다. 그 사실을 몰랐던 「서리달 아이」들은 이 옷 역시 「쿠타르」의 기적이라 여겼다. 그래서 콜롬비나는 이후 종종 「쿠타르님, 당신 같은 손재주를 내려주세요」라는 소원을 듣게 되었다",
      "isDefault": true,
      "characterName": "콜롬비나",
      "characterId": 10000125,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Columbina_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "콜롬비나, 쿠타르, 달의 신… 원하는 대로 불러도 돼. 나는 이름이 여럿이던 시절에 익숙하거든. 원한다면, 달의 축복을 내려줄게"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·노래",
      "text": "내 노래는 누군가를 위한 건 아니야. 그래도 걸음을 멈추고 들어주는 이가 있다면, 그 사람이 잠시라도 평온을 느꼈으면 해"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·달",
      "text": "달구경 할래? 내 흔들의자에 앉아서 편한 각도를 찾아봐. 아니면 나랑 같이 달로 가서 티바트를 구경하는 것도 좋아"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·산책",
      "text": "내가 네 걸음에 뒤처질까 봐 걱정 안 해도 돼. 매일 달빛 정원을 오래도록 거닐었거든"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "빗방울이 땅에 떨어지는 소리를 듣고 있으면, 「집」에 있는 듯한 안정감이 들어"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "날이 갰어. 오늘 밤엔 달이 보이려나?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "으…! 번개가 안 보이면… 천둥에 잘 놀라게 돼…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "나는 눈이 좋아. 예쁘고 조용하고, 월령이랑 눈싸움도 할 수 있거든. 지금 같이 놀래?"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "눈이 안 떠지면 내 손을 잡아. 내가 이끌어줄게"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "밤의 모래를 밟으면 시원해서 기분 좋아. 근데 낮에는 너무 뜨거워져…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침… 내 머리끈 못 봤어? 응? 머리가 헝클어졌다고…? 어디? 빗겨줘"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "후… 달이 아직 안 떴네. 월령들을 안고 낮잠 잘래"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "밤의 장막이 내린다… 이런 표현, 재밌지 않아? 꼭 「밤」이 달에 걸려 넘어져서 떨어지는 것 같아"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "잠이 안 와? 음… 월령들도 가끔 그래. 그럴 땐 내가 노래를 불러주거나, 이야기를 들려줘. 너도 해줄까?"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "콜롬비나 자신에 대해·안대",
      "text": "나는 달의 힘으로 세상을 「느끼는」 데 익숙해. 그편이 「보는」 것보다 사물의 본질이 더 잘 보여. 음, 그래도 가끔은 호기심이 생겨서 살짝 눈을 뜰 때도 있어. 내 안대는 사실 속이 비치거든"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "콜롬비나 자신에 대해·집",
      "text": "예전의 나는 계속 떠돌아다니는 몸이고, 오직 달만이 「집」이라고 생각했어. 하지만 이제는 「집」이 더 많아지고, 더 가까워졌지"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·업적",
      "text": "네 얘기는 오래전부터 들었어. 「우인단」에 있을 때 다른 집행관들이 네 이야기를 했거든. 근데 이름 앞에 붙이는 수식어가 너무 많아서, 이름을 듣기도 전에 잠들어버렸어"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·여행",
      "text": "여행할 때 알아야 하는 게 있을까? 다른 나라 사람이랑 이야기하는 법이라든가. 응…? 불 피우는 법이랑 사냥하는 법… 이동 방법 같은 게 더 중요하다고? 그런 건… 달의 힘으로 해결되잖아?"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「하나된 달」에 대해…",
      "text": "세 여신이 자신들의 권능을 나에게 맡겼어. 세 힘이 얽혀, 눈부시면서도 따스하게 빛났지. 그 안에서 나는 세 여신이 이 세계에 보내는 사랑과, 생의 끝에 남기는 소망과 축복을 느꼈어. 나는 그 달빛을 이어받아, 달 아래의 세계, 우리 모두의 「집」을 밝게 비출 거야"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "스네즈나야에서 「우인단」 집행관 서열 3위였을 땐 편한 게 많았어. 기차를 탈 땐 표가 필요 없고, 코롤료프스키 극단에 갈 땐 줄을 설 필요가 없었지…. 아, 식당에서 밥을 먹을 땐… 「비용 청구」? 를 하면 된댔는데, 난 복잡해서 잘 모르겠더라고. 그래서 매번 산드로네나 아를레키노랑 같이 먹으러 갔어"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "달의 풍경은 내가 상상했던 것보다 훨씬 아름다웠어. 고요히 흐르는 달의 힘이 푸른 바다처럼 끝없이 펼쳐져 있었지. 예쁜 해파리가 달빛 바다 위를 유유히 떠다녔고, 어디 사는지 알 수 없는 분홍빛 서리 돌고래랑, 엄청 커다란 월령도 있었어…. 나중에 달의 「집」을 다 정리하면, 친구들을 초대할 거야"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "라우마에 대해…",
      "text": "라우마의 머리 위로 달빛을 비추면, 뿔이 더 높고 크게 자라나. 각도를 잘 맞추면, 높은 곳에 있는 열매를 한 번에 찌를 수 있지…. 그다음엔 어떻게 됐냐고? 음… 혼났어"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "니콜에 대해…",
      "text": "얼마 전까지 계속 연락을 주고받았어. 월령들한테 읽어줄 책을 추천해 달라고 했더니, 재밌는 책을 한가득 보내주면서, 각 이야기의 탄생 유래나 설정도 들려줬지. 그래서 「니콜 씨가 직접 쓴 책은 언제쯤 읽을 수 있어?」라고 물었더니, 갑자기 사라져 버렸어. 음… 아마 책 쓰러 갔을 거야"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "느비예트에 대해…",
      "text": "폰타인에서 최고 심판관을 맡고 있는 물의 용? 음… 사람을 감옥에 집어넣는 용은, 굳이 만나고 싶지 않아"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "7명의 집정관에 대해…",
      "text": "여행하다 마주치면 인사할래"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "「얼음의 여왕」에 대해…",
      "text": "처음으로 얼음 궁전의 화원에서 노래를 불렀을 때, 「여왕」이 마침 거길 지나갔어. 그녀는 미처 표정을 새기지 못한 조각상처럼 조용히 거기에 서 있었지. 어느 순간에는 나한테 뭔가 말하고 싶은 것처럼 느껴졌지만, 끝내 아무 말도 하지 않았어.\\n「여왕」은 두꺼운 얼음 아래 감정을 봉인하고, 여왕으로서의 일면만을 세상에 보이고 있어. 나의 답이 달에 남았었다면, 그녀의 답은 빙산 아래 묻혀 있는 거지"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "「피에로」에 대해…",
      "text": "「피에로」는 코드 네임이랑 정반대야. 이름은 「어릿광대」인데, 맨날 진지한 말투로 알 수 없는 말만 해. 세상을 비웃는 가면을 쓰고 있으면서, 정작 본인은 한 번도 웃지 않아"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "「카피타노」에 대해…",
      "text": "「카피타노」를 존경하는 사람도 많지만, 두려워하는 사람도 많아. 어… 이해하기 어렵다고? 어둠 속에 살아가는 존재는 빛에 다가가지 않아. 빛은 위험하거든. 그들의 그림자를 더 길게 늘일 뿐이니까 말이야"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "「도토레」에 대해…",
      "text": "한때 「도토레」가 나한테 되게 잘해줬어. 나를 자기 동생 같다고 했지.\\n하지만 나중에 깨달았어, 「도토레」는 친해진 사람일수록 마음대로 이용한다는 걸. 「가족이라면 따라 줘야지?」 걘 진심으로 이렇게 생각하는 것 같았지만, 나는 그러기 싫었어. 그런 건, 내가 첫 번째 「집」에서 받았던 탐욕스러운 시선을 떠올리게 했거든"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "아를레키노에 대해…",
      "text": "벽난로의 집은 아이들이 많아서 조금 시끄러워. 다들 아를레키노를 「아버지」라고 부르길래, 난 그게 벽난로의 집에 있을 때 꼭 지켜야 하는 규칙인 줄 알았어. 그래서 아를레키노가 지나갈 때 나도 그렇게 불러봤지. 벽난로의 집이 그렇게 조용해질 수도 있다는 걸, 그때 처음 알았어"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "「풀치넬라」에 대해…",
      "text": "「풀치넬라」의 말투를 따라 하는 법 알려줄까? 「돈」, 「빌어먹을 판탈로네」, 「보장」 이 세 개만 쓰면 돼. 「돈은? 빌어먹을 판탈로네. 내가 보장했단 말이다」, 「그 빌어먹을 판탈로네가 돈을 토하게 만들겠다고 보장하지」. 어때, 신기하지?"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "산드로네에 대해·태엽",
      "text": "등 뒤의 태엽은 계속 돌아가는 건가? 항상 같은 방향으로 도나? 잘 때는 태엽을 빼고 자려나? 그냥 자다가 뒤척이면 어떡하지? 산드로네를 처음 봤을 때부터 이런 게 궁금했어. 하지만 그땐 아직 친하지 않아서, 직접 만져보기 어려웠지. 그래서 태엽이 도는 규칙을 찾아내려고 기회만 생기면 계속 뒤를 따라다녔어. 그러다가 어느 날, 산드로네가 휙 돌아보더니 왜 자꾸 따라오냐고 화내는 거야. 내가 솔직하게 대답하니까, 「그렇게 궁금하면 네 등에도 하나 달아보든가」라고 하더라. 이후 며칠간 등에 태엽을 달고 살아봤는데, 음… 되게 불편했어. 산드로네가 엄청 힘들겠더라. 그때부터 산드로네를 좀 더 신경 쓰게 됐어"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "산드로네에 대해·태엽 두 번째",
      "text": "인형에게 무엇이 「죽음」인지는 잘 모르겠지만… 산드로네는 정말로 멈춰버렸어. 더는 산드로네의 「운행」이 느껴지지 않고, 태엽도 움직이지 않아. 그 「술식」을 위해서, 나를 여기로 데려오기 위해서, 그렇게 되어버렸지…. 이 모든 게 산드로네가 날 놀래키려고 친 장난이었으면 좋겠어. 나한테 복수하겠다던 말을 지킨 거였으면 좋겠어…"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "산드로네에 대해·태엽 세 번째",
      "text": "산드로네가 돌아왔어. 정말 기뻐. 예전에는 일정한 속도로만 돌던 산드로네의 태엽이, 이제는 가끔 빠르게 돌아가. 산드로네 말로는 자기 마음속의 감정을 받아들여서, 예전과 다른 자신이 됐기 때문이래. 하지만 무슨 옷을 입든, 태엽이 어떻게 돌든, 산드로네는 여전히 산드로네고, 내 가장 소중한 친구야. 예전 모습도 지금 모습도 다 좋아. 내가 이렇게 말하니까, 산드로네의 태엽이 더 빨리 돌아가더라. 왜인지는 모르겠지만, 재미있었어"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "「판탈로네」에 대해…",
      "text": "「판탈로네」의 눈에 비치는 세상에선, 사물이든 사람이든 다 가격표가 붙어 있어. 그는 가격의 규칙을 쥐고 칩을 굴려서, 자기만의 부의 제국을 넓혀나가지. 하지만 거긴 너무 지루해서 놀러 가고 싶지 않아.\\n음… 아마 「판탈로네」가 지금의 날 본다면, 전보다 더 깊은 혐오를 숨긴 미소를 지을 거야. 그리고 나한테 이렇게 말하겠지. 「축하합니다, 콜롬비나 씨. 값이 많이 오르셨군요」"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "로잘린에 대해…",
      "text": "고치를 깨봤자 날개를 펴고 불길을 향해 날아들 뿐이라면, 고치로 남는 게 오히려 생명을 부지하기에 나은 선택이 아닐까? 로잘린은 그런 선택지가 있다는 것조차 생각하지 않았던 것 같아. 아니면 처음부터 자신의 결말을 정해뒀는지도 모르지. 로잘린은 있는 힘껏 사랑하고, 있는 힘껏 미워하고, 있는 힘껏 춤췄어…. 그러곤 슬픔의 노래를 다른 이들에게 남겨두고 갔지"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "「타르탈리아」에 대해…",
      "text": "가족들이랑 사이가 좋아서, 휴가를 받으면 온 가족이 함께 호숫가에서 캠핑도 하고 바비큐도 한대. 산드로네는 그 사람을 보고 집행관 중에 제일 평범한 사람답게 사는 인물이라고 했어. 평범한 사람이 어떤 건지는 잘 모르지만, 그런 삶은 좋다고 생각해"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "콜롬비나에 대해 알기·첫 번째",
      "text": "어…? 내 이야기? 음… 좀 길어질지도 몰라. 응? 차랑 디저트를 준비했다고? 좋아, 그럼 보답으로 조금 더 길게 이야기해 줄게"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "콜롬비나에 대해 알기·두 번째",
      "text": "난 오랜 시간에 걸쳐서, 사람을 사귀는 법이랑 이 세계와 어울리는 법을 배웠어. 지금 돌이켜보면, 옛날 「서리달 아이」와 「우인단」에서의 경험은 별로 좋은 예시가 아니었던 것 같아. 덕분에 오랫동안, 관계와 교류를 이익을 위해 대가를 지불하는 거래로만 여겼으니까"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "콜롬비나에 대해 알기·세 번째",
      "text": "난 월령들한테 이야기를 들려주는 거랑 노래 부르는 걸 좋아해. 내가 태어나기 전부터 내 삶에는 한 조각의 공백이 있었어. 그건 평생 지워지지 않는 자국이었지. 자신의 이야기가 처음부터 불완전하다면, 다른 이야기로 그 공백을 채워야 하잖아? 그래서 나는 말로 윤곽을 그리고, 노래로 색을 입히려 한 거야"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "콜롬비나에 대해 알기·네 번째",
      "text": "기도의 밤에, 나는 콜롬비나·하이포셀레니아라는 이름을 얻었어. 예전의 나라면 이름은 하나의 호칭일 뿐, 나 자신과는 별개의 무언가라고 생각했을 거야. 하지만 그날 밤에 깨달았어. 이름은 나와 이 세계를 이어주는 연결고리라는 걸. 이름엔 친구들의 마음이 담겨 있고, 친구들 마음속의 내가 담겨 있어. 나, 이 이름을 소중히 간직할 거야"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "콜롬비나에 대해 알기·다섯 번째",
      "text": "내 이야기는 거꾸로 재생되는 오페라 같아. 결말을 먼저 알고, 그 원인을 찾는 여정을 떠나야 했지. 하지만 누가 나한테 다른 이야기로 다시 시작하겠냐고 묻는다면, 난 지금 이대로가 좋다고 할 거야. 이 여정이 없었으면 난 노드크라이에 태어난 게 나 자신의 선택이었다는 것도 몰랐을 거고, 친구들의 도움 아래 진짜 「가족」과 어울리는 법도 배우지 못했을 테니까. 그리고, 네가 그날 밤 루오노타르를 따라 달빛 정원에 발을 들일 일도 없었겠지. 그러면 내 이야기엔 또 다른 공백이 생겼을 거야. 난 그런 건 싫어"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "콜롬비나의 취미…",
      "text": "난 가끔 달로 돌아가서, 눈을 뜨고 조용히 티바트의 운행을 지켜봐. 그러면 마음이 무척 편안해져"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "콜롬비나의 고민…",
      "text": "평범한 사람처럼 나샤 마을을 산책하고 싶은데… 매번 들켜. 옷이라도 바꿔 입어야 하나? 아니면 혹시 평범한 사람들은 마을에 있는 월령이랑 대화 못 해?"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "신선한 과일이랑 채소, 고소한 밀 향이 나는 빵… 응? 너무 소박하다고? 이게 익숙해서 그런가 봐. 내가 처음 노드크라이에 태어났을 때 「서리달 아이」한테 받은 게 그런 거였거든. 동물들도 종종 와서 자기들이 주운 열매를 나눠줬고. 난 음식이 본연의 모습일 때가 좋아. 그 안에 이 세계 태초의 모습이 담겨 있잖아"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "「불의 물」 같은 독한 술들. 스네즈나야엔 그런 음료가 많아. 거기서 오래 지냈지만, 그 맛에는 도무지 익숙해지질 못했어. 몸이 불타고 세상이 빙글빙글 도는 그 감각을 사람들은 왜 좋아하는 걸까? 다들 달 위로 날아가고 싶은 걸까?"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "더 먹고 싶어. 어…? 더 없다고? 알겠어, 다음엔 아껴 먹을게"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "마음에 들어. 달빛이랑 같이 천천히 즐길래"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "음… 산드로네도 내가 화나게 하면 이런 비슷한 걸 먹였는데…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "넌 생일이 매년 같아? 기억하기 편하네. 음… 나는 기도의 밤이 열리는 날짜가 매년 조금씩 달라져서, 달을 감지해서 생일을 짐작할 수밖에 없어. 그래도 「생일」이란 건 즐거운 날인 것 같아. 모두 함께 모여 춤추고, 주인공을 위해 맛있는 공물을 만들어 주잖아. 어…? 평범한 사람의 생일은 그런 게 아니라고? 선물, 케이크, 친구…? 응, 좋아. 그럼 친구들을 불러서 네 생일을 같이 축하하자. 내가 노래를 불러줄게. 말라우스한테 그림도 한 장 그려달라고 하고"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "조석은 영원달로 인해 솟구쳐"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "추운 밤은 서리달로 인해 빛나지"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "유명은 무지개달로 인해 깊어져"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "운명의 실타래가 내 손에 쥐어졌어. 이제부터, 새로운 달이 이 세계를 바라보며 비출 거야"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "흘러라"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "차올라라"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "드리워라"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "새로운 달이 떴어"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "세 달이 빛나는 순간"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "달빛이 내리는 밤을 선물할게"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "「깜짝선물」… 맞지?"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "얘네도 가출한 거야?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "난 이제 공물 필요 없어. 너 가져"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "어지러워…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "하늘이 어두워지고 있어…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "나 아파…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "안 어지럽니? 너 되게 나풀나풀해"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "안 쉬어?"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "밤하늘이… 다시 어두워졌어…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "달이… 떨어졌어…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "집을 떠난… 대가…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "난 괜찮아…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "아파…!"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "날 왜…?"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "달빛 한 줄기 빌려줄까?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "오래 나가야 돼?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "응, 너랑 갈래"
    }
  ]
}