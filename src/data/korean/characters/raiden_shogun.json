  "outfits": [
    {
      "id": 205200,
      "name": "위대하신 나루카미 쇼군의 의식",
      "description": "라이덴 쇼군의 코스튬. 「번개의 삼파문」 문양으로 최고 위상을 얻은 위대한 기모노이다",
      "isDefault": true,
      "characterName": "라이덴 쇼군",
      "characterId": 10000052,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shougun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "예의 차릴 것 없다. 내가 존귀한 몸이긴 하나, 이건 백성들을 살피기 위한 미복잠행이니라. 네 실력이 마음에 드니 널 내 측근 호위로 임명하겠다. 허나 걱정 말거라, 위험한 상황이 닥치면 이 몸이 직접 나설 테니"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·공연함",
      "text": "할 일도 없이 괜히 벼루만 쳐다보고 있네, 흠"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·속세",
      "text": "속세의 풍경은 항상 그대로인데, 인간의 일생은 이슬처럼 덧없구나"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·아름다운 자연",
      "text": "함께 하는 이 없이는 이 아름다운 자연의 운치도 날 돋보이게 하는 배경에 불과하다"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "고작 빗방울로 호들갑은, 아직 번개도 치지 않았는데"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "흐음, 설마 겁먹은 거야? 이상하네, 세상에서 가장 뛰어나고 무시무시한 뇌정의 화신이 지금 네 곁에 있다고"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "동장군도 왔군"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "날이 맑을 때…",
      "text": "하늘이 맑다고 번개는 숨길 수 없고, 비가 내리지 않아도 신의 번개를 내릴 수 있다. 저 나무가 보이느냐? 알겠으니 그만하라고? 흠, 그래"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "문안 인사가 끝나자마자 하품이라니, 기강이 해이해졌군. 이번 한 번만 봐주지. 좋은 아침이구나"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "아, 디저트가 먹고 싶어. 응? 안 된다고? 「이 시간에 디저트를 먹는 사람이 어디 있어요」라니, 그게 무슨 소리야? 저번엔 내가 쇼군이라서 아무도 얘기 못 했던 거라고? 흠, 그랬구나"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "유성의 실체에 대해 알고 있어? 하하, 실은 아득한 찰나의 빛일 뿐이야. 음? 그게 실은 너라고? 그럼 너도 텐구였던 건가?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "천하의 뇌명을 잠재울 터이니 오늘 밤 편히 자길"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "라이덴 쇼군 자신에 대해·찰나",
      "text": "뇌명과 번개는 찰나에 사라지지. 그래서 「영원함」을 취하고 싶구나. 아니, 「영원함」을 반드시 손에 넣어야만 해"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "라이덴 쇼군 자신에 대해·영원함",
      "text": "「마모」는 실로 두려운 일이야. 이 몸이 탄생한 이유는 바로 마모를 감내하기 위해서다. 어쩌면 「내적」으로 영원함에 닿을 수 있을지도 모르지"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·오쿠즈메",
      "text": "너는 지금 내 측근이다. 달리 말하면, 이 몸이 너를 막부에 도움이 될, 나에게 충성을 다할 사람이라고 판단했다는 뜻이다"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·호위꾼",
      "text": "네가 이번 미복잠행의 호위라고는 하나, 위험한 상황에서 굳이 대신 나설 필요는 없어. 쇼군의 몸은 꽤 단단하고 망가지면 교체할 수도 있고. 그러니까 위험한 상황이 닥치면 쇼군을 앞세우면 돼"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·계승",
      "text": "이나즈마의 치도술, 검술 그리고 단조 기법 중 대부분은 내가 직접 전수한 거야. 그 후 개인의 자질에 따라 갈래가 나뉘어 제각기 성과를 맺었지.\\n어때, 내 공격을 한 번 더 받아 볼래? 그러고도 무사하다면, 이나즈마에서 새로운 유파를 창설해도 좋아. 아아, 무예를 갈고닦는 수련은 정말 짜릿하고 황홀해"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "바깥 세계에 그렇게 오랫동안 번개 원소 신의 눈이 나타나지 않았다고? 제약 때문에 깊게 설명해줄 순 없지만… 신의 눈을 하사하는 건 내 의지로 가능한 일이 아니야. 중요한 건 인간의 「갈망」, 그리고…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "나에 대해서 할 얘기 있냐고? 없다. 너야말로 신의 눈도 없이 어찌 원소의 힘을 다룰 수 있는 건지 소상히 설명해 봐라"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "비록 몸과 꿈은 사라졌어도, 그녀는 결국 신성한 벚나무가 되었다. 그것도 「영원함」이지"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "야에 미코에 대해…",
      "text": "그 녀석? 처음엔 유부 하나에도 홀랑 넘어가는 녀석이었는데, 지금은 이렇게 뛰어난 지략을 갖추게 되었다니, 기특하지. 다만 이 몸이 한 수 당한 건 좀 괘씸해. 나를 위해서라곤 하나, 다음에 만나면 분명 비웃을 거란 말이지…. 흠, 그럼 차라리 먼저 베어버려야겠다. 어차피 녀석도 피할 테니"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "카미사토 아야토에 대해…",
      "text": "카미사토 일가는 명실상부한 이나즈마의 명문가야. 전에 삼봉행 업무에 관련해서 아야토가 술수를 꽤나 부리긴 했지만, 그 충심이 가상해서 과거의 잘못은 더 이상 추궁하지 않겠다"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "카미사토 아야카에 대해…",
      "text": "카미사토 일가는 명실상부한 이나즈마의 명문가지. 음, 나와 쇼군의 평가가 같단 말이지. 흠, 아야카는 검술도 뛰어난 편이야"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "쿠죠 사라에 대해…",
      "text": "무예가 뛰어난 충신이자, 「호걸」이라는 호칭에 걸맞는 인물이지. 이토록 뛰어난 인물이 있으니 쿠죠 가문의 미래가 밝겠어"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "요이미야에 대해…",
      "text": "누구라고? 아, 그 폭죽 장인. 찰나의 환상을 만들어내는 자, 한 여름날 밤의 환각에 취해 살아가는 자. 허나 그렇다 한들 모두 이 몸의 백성인 것을.\\n응, 텐료 봉행 영지에서 폭죽놀이를 한다고? 누가, 그 여인이?"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "토마에 대해…",
      "text": "그의 신의 눈을 빼앗을 뻔한 일은 사실 내게도 어느 정도의 책임이 있어. 하지만 사과는 쇼군이 하는 게 좋지 않을까…? 알겠어. 나도 반성할게"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "산고노미야 코코미에 대해…",
      "text": "이 몸이 오로바스를 베어버린 건 사실이다. 하지만 그와 동시에 산호궁 백성들이 와타츠미 신의 이름으로 그의 희생을 기리는 제사를 지내는 걸 허락해주었지. 현재 산고노미야는 나루카미 분샤를 파괴하고 막부에 반기를 들고 있어. 와타츠미 신의 아라히토가미 무녀로서 그녀는 반드시 책임을 져야만 해"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "쿠니쿠즈시에 대해…",
      "text": "녀석은 쇼군을 만들 때 나온 부산물이야. 그 녀석을 제멋대로 날뛰게 내버려두는 건 미안한 마음이 들어서랄까"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "아라타키 이토에 대해…",
      "text": "누구?"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "모락스에 대해…",
      "text": "전에 그와 잔을 기울일 때까지만 해도 나는 신들의 말석에 자리한 일개 그림자 무사에 불과했어. 그가 그러한 선택을 했단 말이지. 허나, 다음 세대에서도 그는 분명 계속해서 많은 사람을 만나게 되겠군"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "벤티에 대해…",
      "text": "바람 신의 화신은 아직도 그 이름으로 불리고 있는 건가? 솔직히, 처음 만났을 때부터 어쩐지 나와는 절대 맞지 않을 것 같은 느낌이 들더란 말이지. 그리고 확실히 술을 잘 마시더라고"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "부에르에 대해…",
      "text": "난 그 겸손함을 존경해. 겸손도 지혜의 미덕이긴 하지만. 그 권능으로 상상을 초월하는 일을 할 수 있을 텐데도, 부에르는 그걸 「바로잡음과 수호」에만 쓰니까… 정말 온유한 신이지"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "푸리나에 대해…",
      "text": "「라이덴 쇼군」은 나의 의지가 흔들리지 않았음을 확인하기 위해 나와 의식 속에서 수백 년을 싸웠지. 네가 말한 푸리나라는 자는 인간의 몸으로 500년 동안 연기를 해왔고, 그건 매 순간 정신적인 「실전」을 치른 것과 다름없어. 난 그자를 인정해. 그 정도 의지라면 이미 신의 경지에 올랐다 할 수 있지"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "하보림에 대해…",
      "text": "500년 전 켄리아에 도착했을 때, 전장에서 무상도의 협곡만큼 넓게 초토화된 땅을 봤어. 불의 신이 분노했던 흔적이라고 하더라. 근데 오늘날에도 이런 인간을 만날 기회가 생기다니… 나를 추천해 주지 않을래? 「무인」으로서 적당한 공터를 찾아 자웅을 겨뤄보고 싶거든"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "유메미즈키 미즈키에 대해…",
      "text": "미즈키는 미코의 오랜 지인이야. 하지만 둘의 관계는 잘 모르겠어…. 둘도 없는 친구인데, 서로에게 감정을 드러내길 원치 않는다니. 계획을 위해 대치하며 승부를 내려 하고 말이야…. 그래도 그 계획은 전부 백성들의 윤택한 삶을 위한 거니까, 딱히 뭐라 할 생각은 없어"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "라이덴 쇼군에 대해 알기·첫 번째",
      "text": "무슨 일이냐, 말해 봐라"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "라이덴 쇼군에 대해 알기·두 번째",
      "text": "민간에서는 뇌우가 내리는 날 「쿠와바라 쿠와바라」라는 주문을 외우면 폭풍우에도 무사하다고 굳게 믿고 있지. 내 변덕으로 인한 뇌폭이라면 절대 너를 해치지 않을 것이다. 하지만 자연적으로 생성된 뇌우라면 얘기가 달라"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "에이(影)에 대해 알기·세 번째",
      "text": "《진설》이라는 책에 쓰인 건 대부분 사실이야. 그때 그녀는 섬의 일로 눈코 뜰 새 없이 바빴고 그림자 무사로서 난 그녀의 이름으로 와타츠미를 평정하는 진영에 나타났었어. 하지만 그 후의 스토리는 사람들이 멋대로 지어낸 거야. 본디 나는 검술에 심취한 무인일 뿐, 백성을 감화시키는 덕행은 행한 적이 없어"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "에이(影)에 대해 알기·네 번째",
      "text": "「영원함」을 좇는 건 어쩌면 일종의 도피일지도 몰라. 결국 내가 택한 것도 목을 잔뜩 움츠린 겁쟁이 거북이 같은 방법이지. 하지만 거북이는 본디 장수의 상징, 영원함을 좇는다는 건 점점 이렇게 되어가는 게 아닐까"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "에이(影)에 대해 알기·다섯 번째",
      "text": "내가 두려운 이유는 500년 전 그녀의 소멸과 「그것」을 직접 목격했기 때문이야. 하지만 만약… 만약 너였다면, 분명 모두 구할 수 있었을 거야. 만약 너였다면, 분명 세상을 구해낼 수 있었겠지. 내가 이나즈마의 모든 걸 전부 기억하는 것처럼, 네가 나를 기억해준다면 난 영원히 살아있을 수 있어"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "라이덴 쇼군의 취미…",
      "text": "어리석은 질문이군. 반드시 해야 할 일과 절대 해서는 안 될 일, 두 가지뿐이야"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "에이(影)의 고민…",
      "text": "요리해달란 말만 하지 마. 난 뭐든 해낼 수 있지만, 요리는 영 아니라서"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "쇼군 말 안 들어도 돼. 제일 좋아하는 건 화과자! 이가 썩으면 갈면 될 거 아냐. 화과자가 영원함을 좇는 일에 방해가 될 리 없어"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "의미 없는 질문이군. 인체의 영양소를 유지하기 위해 반드시 섭취해야 하는 것과 인체에 해로운 것만 있을 뿐이지"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "익숙한 맛이야. 나쁘지 않군"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "이곳에 둬, 먹어볼게"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "신체 기능이 저하 되니, 도로 가져가도록 해"
    },
    {
      "id": "6010",
      "type": 1,
      "title": "선물 획득·네 번째",
      "text": "맛있네. 기분도 많이 좋아졌어, 고마워"
    },
    {
      "id": "6011",
      "type": 1,
      "title": "선물 획득·다섯 번째",
      "text": "괜찮아 보이네, 어떻게 만든 거야?"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "선물 획득·여섯 번째",
      "text": "미안, 사양할게"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘이 네 생일인가? 같이 성으로 가자꾸나, 전인원을 소집해 축사를 읽어줄 테니. 「부끄러우니 그러지 말라」고? …알겠어"
    },
    {
      "id": "7002",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해! 그럼 오늘은 같이 네 생일을 축하하자. 일 년 중 가장 기억에 남는 날로 만들어야지. 그리고 내년 오늘이 되면 또 계속해서 축하하자고. 그런 게 「영원함」의 즐거움을 얻는 거잖아"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "이 몸의 유파 중, 「초전(初傳)」의 자리는 태도의 아홉 가지 검의 길과 기본적인 치도술을 배울 수 있다. 다른 유파와 별다른 점이 없지. 다른 유파가 내 유파와 별다른 점이 없다고 해야 하나"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "이 몸의 유파 중, 「중전(中傳)」의 자리에서 태도술은 각종 「구조」와 변화를 연마해야 하고, 치도술은 「절」과 「반」의 이치를 터득해야 해"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "이 몸의 유파 중, 「개전(皆傳)」의 자리에서는 여러 오의를 부단히 연마해야 한다. 허나 아쉽게도 그중 대부분은 원소의 힘을 필요로 하는지라 평범한 사람에게는 무척이나 어려운 일이야. 세간의 유파 중 거의 대부분은 이 경지에 다다르지 못하지"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "오의 중의 오의, 그러니까 「무상」과 무쌍이 어우러진 일격을 뜻하는 말이야. 네가 대련 상대가 되어주니 어쩐지 검이 더 빨라질 것 같은 느낌인데?"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "징벌의 빛!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "도망칠 수 없다!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "포영 간파!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "무념, 단절!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "지금이, 적멸의 시간!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "번개는 영원히 빛나리!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "내겐 쓸모없는 물건이니 받거라"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "…단지 찰나의 꿈일 뿐이다"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "음?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "…족쇄는 풀어야 하지"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "…모든 악을 베겠노라"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "…방해는 전부 숙청한다"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내 뒤에서 대기하도록"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "물러나라"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "속세는 한바탕 덧없는 꿈…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "무념, 무상…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "뇌명이 곧 그치리…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "무례하군…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "터무니없군…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "무슨 일이지?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "내 곁을 따르거라"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "출정할 시간이다"
    }
  ]
}