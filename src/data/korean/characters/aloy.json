  "outfits": [
    {
      "id": 206200,
      "name": "기동 사냥꾼",
      "description": "에일로이의 코스튬. 임야 생활을 하는 사냥꾼에게 적합한 복장이다",
      "isDefault": true,
      "characterName": "에일로이",
      "characterId": 10000062,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aloy_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "난 에일로이. 이 세상에 대해 잘 모르지만, 내 활과 화살은 언제나 널 위해 대기하고 있어. 내가 필요하다면 최선을 다해 도울게"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·몸풀기",
      "text": "멍하니 서 있지 말고 움직여"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·도움",
      "text": "여기서 멈출 수 없어. 우리 도움이 필요한 사람이 있다고"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "비는 더러움을 씻겨주지"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "비가 멎었군. 몸을 말려야겠어"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "눈이 올 땐 세상이 고요해지는 것 같아"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "또 바람이 부네. 바람을 맞으며 숨 쉬는 건 정말 상쾌해"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "바람이 세졌어. 얼굴 베일 것 같아"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침이야. 세상이 다시 활기차졌군. 나도 그렇고"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "반나절이나 지났어. 아직 할 일이 많은데"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "해가 저물었네. 곧 별이 뜰 거야"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "밤이네, 이제 자야지. 별빛을 빌려 움직일 게 아니라면"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "에일로이 자신에 대해…",
      "text": "난 어릴 때부터 추방된 신세라서 그동안 많이 힘들었지. 하지만 여긴 나 같은 외지인에게도 잘해줘. 내가 태어났던 곳보다 훨씬 친절해서… 좋아"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·행동",
      "text": "난 생명을 죽이기 위해서가 아니라 살리기 위해서 움직여. 그래서 너와 함께 싸우는 거야"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·서약",
      "text": "맹세 같은 건 좀 촌스럽잖아. 그래도 네가 원한다면 너와 함께하겠다고 맹세할게"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·전진",
      "text": "난 내 전부를 걸고 너와 끝까지 함께 가겠어. 주저하거나 널 저버리는 일은 없을 거야"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "공유할 만한 게 있다면, 그건 내 활과 화살이지. 난 누군가를 돕기 위해서만 이걸 사용해"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "내가 살던 세계처럼 이곳의 과거에도 비밀이 많구나. 시간이 충분하다면 이 비밀들을 전부 밝혀내겠어"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "에일로이에 대해 알기·첫 번째",
      "text": "난 사적인 이야기는 서툴러. 눈앞의 임무가 중점이야"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "에일로이에 대해 알기·두 번째",
      "text": "난 부모가 없어. 로스트라는 분이 날 키워주셨지. 엄격하지만 마음은 따뜻한 사람이야, 시원시원하고. 그는 내게 많은 걸 가르쳐줬어…. 정말 그립네"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "에일로이에 대해 알기·세 번째",
      "text": "예전에 난 꽤 오랫동안 생모를 찾았지만, 결국 찾지 못했어. 대신 아주 오래된 메시지를 찾았지. 내… 「클론 모체」가 남긴 거였어. 그 메시지를 들어보니 그녀는 날 아주 잘 아는 것 같았지. 날 격려해주는 느낌도 들었고"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "에일로이에 대해 알기·네 번째",
      "text": "난 친구 없이 컸어. 나중에 여행하다 많은 사람을 만났지만, 그 세계를 떠날 때도 그들과 친밀한 사이는 아니었어. 그래서 너와 이렇게 오랜 시간을 보내며 친구가 될 수 있어서 정말 기뻐"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "에일로이에 대해 알기·다섯 번째",
      "text": "난 사람을 쉽게 믿지 않지만 넌 믿을 수 있어. 넌 내 진정한 파트너야. 내가 남을 이렇게 평가하는 건 드문 일이라고"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "에일로이의 취미…",
      "text": "내 취미가 뭔지 잘 모르겠어. 「고전 읽기」 정도? 음… 그러니까 역사 같은 거"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "에일로이의 고민…",
      "text": "내 자신의 세계 말고 구해야 할 세계가 또 늘어서… 시간이 늘 부족해"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "난 있는 대로 먹어. 굶지만 않는다면 뭐든 상관없어"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "전에 「오세람 고기스튜」를 한번 먹어 봤는데, 너무 걸쭉하더라고… 웩"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "난 생일을 챙긴 적이 없는 것 같아. 내가 태어난 세계에서는 어머니를 기리지 자신의 생일을 축하하진 않거든. 하지만 어쨌든, 응… 생일 축하해"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "좋아, 진전이 제법 있어. 하지만 여기서 멈출 순 없지"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "성장하고 더 강해지는 건 좋은 일이야"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "아무리 뛰어난 사냥꾼이라도 더 발전할 수 있어. 지금에 만족해서 배움을 멈추면 안 돼"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "너와 막 여행을 시작했을 때, 넌 내가 모르는 세계에서 온 낯선 사람일 뿐이었어. 하지만 지금은 많은 걸 함께 한 친구지. 약속할게. 내 활과 화살은 언제나 너와 함께할 거야"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "폭발할지도 몰라"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "사냥꾼의 장난감이지"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "이거 본 적 있어?"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "속박한다!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "새로운 스킬이군"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "여기가 내 사냥터야!"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "이거 제법 괜찮잖아"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "음… 꽤 쓸 만한 물건이야"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "이건 먹을 거고… 이건 쓸 만한 것들이네…"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "대체 누가 여기 둔 거지…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "까다로운 사냥감이군…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "약점이 어디지…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "방심했어…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "조심해!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "무모한 짓은 그만둬!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "뭐가… 잘못된 거지…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "미안해…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "사냥 실패…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "윽…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "일반 피격·두 번째",
      "text": "이쯤이야…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "윽!"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "좀 성가시군…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "이번에는 어딜 가 볼까?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "에일로이, 사냥에 참가하지"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "도움이 필요해?"
    }
  ]
}