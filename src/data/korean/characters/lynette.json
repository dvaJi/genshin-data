  "outfits": [
    {
      "id": 208300,
      "name": "환영 고양이",
      "description": "리넷의 코스튬. 고양이는 그림자 속에 숨어있다가 자신이 모습을 드러내고 싶을 때만 나타난다. 마치 한 마술 조수처럼 도무지 종잡을 수 없다",
      "isDefault": true,
      "characterName": "리넷",
      "characterId": 10000083,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Linette_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "안녕, 난 리니의 마술 조수야. 업무 관련은 리니에게, 공연은 매표소에 문의해 줘. 날 찾아왔다고? …용건만 간단히 해줘"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·티타임",
      "text": "차를 우렸으니 이제 조금 쉴 수 있겠어"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·오빠",
      "text": "리니 오빠가 또 이상한 말을 하는 모양이네…. 안심할 수 없다니까"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·멍때리기",
      "text": "대기 모드 진입…. 아무도 방해하지 않았으면 좋겠어"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "비 오는 날은 멍하니 있기 좋아…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "벌써 하늘이 개었어. 아쉽네"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "윽… 귀가 아파"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "춥다…. 널 모자 안에 숨겨줄게"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "태양 아래 새로운 것은 없다라… 정말 그럴까?"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "바람에 섞인 숨결이… 아니, 아무것도 아니야"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침이야…. 충전이 끝나지 않아 다시 수면 모드에 들어갑니다"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "난 일하기 전에 차를 마셔. 기분 전환도 되고 머리가 맑아지지"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "해가 지면 사람 마음속에는 숨겨둔 욕망이 드러나…. 그러니까 저녁 공연이 재밌을 거라는 뜻이야. 표를 남겨줄까?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "어서 자. 난 낮에 못 끝낸 일을 처리해야 해… (망가진 청소기도 고쳐야 하고)"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "리넷 자신에 대해·마술",
      "text": "공연할 때 난 오빠의 조수를 담당해. 말도 표정도 없어서 마술 인형인 줄 아는 사람도 있지만… 이런 오해로 불필요한 교류를 피할 수 있는 건 좋아"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "리넷 자신에 대해·정보",
      "text": "침묵하면 집중해서 정보를 파악하기 좋아. 한번은 공연을 보러 왔던 어느 귀빈이 아내의 것이 아닌 손수건을 꺼낸 적이 있는데… 정보의 구체적인 용도는, 음… 그 사람 본인에게 달렸지"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·경청",
      "text": "난 적극적인 표현은 잘 못하지만, 청중으로선 괜찮다고 생각해. 고민이 있다면 날 찾아와. 비밀은 지켜줄게"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·관심사",
      "text": "금빛의 「태양」과 어두운 「그림자」는 서로 이해할 수 없다고 생각했었어. 하지만 네 특이한 복잡성은 불필요한 호기심을 유발해…. 앞으로도 계속 관찰하게 해줘"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "난 무력보다 내 눈으로 지금 상황을 파악하고 적합한 해결책을 찾는 게 좋아. 하지만 힘이 있는 건 더 많은 패가 있는 거니 위험한 상황에서 소중한 사람을 지킬 수 있겠지"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "차를 우리는 건 쉬워 보여도 까다로운 일이야. 찻잎의 품질, 물의 온도, 우려내는 횟수, 모든 변수를 알맞게 통제해야 가장 순수한 차를 우려낼 수 있지. 그런 의미에서 한잔할래?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "동물도 감정을 표현할 줄 알아. 귀를 기울이면 그들의 상태를 알 수 있지. 고양이는 「냥냥냥」보다 「야옹~」이 더 기분이 좋은 거야. 그럴 때는 아무리 만져도 도망치지 않지"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "리니에 대해·파트너",
      "text": "나랑 리니 오빠는 줄곧 함께였어. 말을 하지 않아도 서로의 생각을 알 수 있지. 그래서 단둘이 있을 때 오빠는 평소보다 조용해. 오빠의 말 중에 뭐가 진실이고 뭐가 거짓이냐고? 사실 난 다 알고 있지만 그건 최고 기밀 사항이야"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "리니에 대해·고민",
      "text": "오빠는 평소에도 자신감이 넘치고 여유로워. 아니, 모두가 그렇게 생각하도록 만들었다고 할 수 있지. 그래서 문제가 생기면 늘 혼자 완벽하게 해결하려고 해…. 그러니까 그런 상황이 생기면 오빠를 잘 챙겨줬으면 좋겠어"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "프레미네에 대해…",
      "text": "섬세하고 다정한 아이지만 자신을 하찮게 여겨…. 아마 과거에 겪은 일이랑 관련이 있겠지. 가끔 프레미네는 오빠와 정반대로 느껴지기도 하지만… 둘 다 가족이니까 의견이 충돌할 때는 내가 중재를 담당하지"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "「아버지」에 대해…",
      "text": "「아버지」가 사랑을 표현하는 방식은… 모두가 받아들일 수 있는 건 아니지만, 「아버지」가 있어서 집이… 집다운 집이 될 수 있었어"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "느비예트에 대해…",
      "text": "최고 심판관은 이상하게 거리감이 느껴져. 말투랑 행동은 상냥하지만 말이야…. 심판관도 사람과 교류하는 걸 별로 안 좋아하는 걸까? 근데 멜뤼진들과 대화할 때는 엄청 친절하더라"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "푸리나에 대해…",
      "text": "푸리나 님의 행동은 이해하기 어려워. 유용한 정보도 발견할 수 없고. 왠지 일거수일투족이 다른 사람을 연기하는 것 같아…. 역시 신은 평범한 사람의 관점에서 추측할 수 없나 봐"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "나비아에 대해…",
      "text": "「가시 장미회」의 새로운 회장이라지만, 오지랖 넓은 옆집 언니 같아. 「집」에 이런 언니가 있으면 좋을 텐데…. 아, 이런 말은 부적절하겠지…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "클로린드에 대해…",
      "text": "명령에 따라 클로린드의 결투를 관전한 적이 있어. 옆에서 관찰하기만 했는데도 무서운 한기가 느껴졌지…. 결투장에서 만나면 어떤 느낌일지 모르겠는데… 음, 그 느낌은 평생 몰랐으면 좋겠어"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "치오리에 대해…",
      "text": "나랑 오빠의 공연 의상을 제작한 사람이야. 오빠가 작은 칼로 마술 공연을 하다가 실수로 소매를 자른 적이 있는데, 한참 동안 잔소리를 들어야 했어…. 정말 무서웠지. 가게에 갈 때마다 오빠 뒤에 숨어있을 수 있어서 다행이라고 생각해"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "샤를로트에 대해…",
      "text": "아… 나도 몇 번 붙잡혀서 인터뷰한 적이 있어. 오빠가 그렇게 거절했는데, 끈기는 정말 칭찬할 만해…. 나한테도 질문을 많이 했는데 난 하나도 대답하지 않았어"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "에밀리에 대해…",
      "text": "이 조향사의 작품은 인기가 너무 많아서 새벽부터 줄이 설 정도야. 하지만 난 향수 냄새에 민감해서, 재채기라도 하면 실례니까… 길을 돌아서 가야 해"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "에스코피에에 대해…",
      "text": "음… 오늘 에스코피에의 꼬리를 보니… 만족스러운 디저트를 개발한 것 같아. 다음 다과회가 기대돼"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "리넷에 대해 알기·첫 번째",
      "text": "마술을 설명해 주면 공연을 관람하는 재미가 없듯이 인간관계도 같아. 날 알고 싶다면 정보를 조금씩 수집해서 직접 답안을 맞춰봐"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "리넷에 대해 알기·두 번째",
      "text": "인간은 아주 복잡한 생물이야. 고의적인 기만은 아니지만 자기도 모르게 진짜 모습을 숨기지. 내 눈엔 「쓸데없는」 디테일이 자꾸 들어오지만, 필요한 상황이 아니면 남의 위장을 폭로하진 않아"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "리넷에 대해 알기·세 번째",
      "text": "마술은 오빠와 나의 생계 수단이었어. 지금은 편리한 사회적 신분에 더 가깝고. 마술 공연 명의로 이 도시에 녹아들어 집의 「눈」이 될 수 있거든"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "리넷에 대해 알기·네 번째",
      "text": "오빠랑 나는 새집에 오기 전까지 떠돌이 생활을 하면서 험난하고 위험한 상황을 많이 겪었어. 그때부터 늘 모든 위험한 기색을 살피고, 타인의 생각을 읽는 법도 배워갔지. 다행히 지금은 안식처가 생겼지만 말이야"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "리넷에 대해 알기·다섯 번째",
      "text": "인간관계를 만드는 건 일종의 도박이야. 아무리 많은 정보를 파악해도 사람의 변심은 예측하기 어려우니까. 난 안전거리를 유지하는 게 익숙해. 하지만 너라면… 그 위험을 무릅쓰고 싶어"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "리넷의 취미…",
      "text": "사람의 정신은 활시위 같아. 너무 팽팽하면 끊어질 수도 있지. 그래서 난 업무 외의 시간에 긴장을 푸는 일을 해. 차를 우리거나 고양이에게 먹이를 주거나 멍을 때리지. 평소에 마음이 평온할수록 앞으로의 위험에 더 잘 대처할 수 있거든"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "리넷의 고민…",
      "text": "난 기계 조작이 서툴러서 방심하면 뜻밖의 상황이 일어나. 한번은 비 오는 날에 건조기를 망가트렸는데… 프레미네가 기계 수리를 잘해서 다행이었어"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "조개껍데기를 까서 싱싱한 조갯살에 레몬즙을 조금 뿌리면 접시도 필요 없어. 완벽하지"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "간이 센 음식은 안 돼. 식재료는 본연의 맛을 보존하는 게 좋아"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "맛있네. 레시피는 이미 기억했어"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "잘 먹었어"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "조미료의 비율을 더 고민해 보는 게 어때?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해! 자, 여기 카드. 축하 카드가 아니니까 아무 내용도 없어. 거기에 원하는 선물을 적어서 내 모자에 넣어. 그게 뭐든지 다 준비해 줄게"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "감각이 더 예리해졌어"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "사고 속도가… 계속 증가하고 있어"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "승리의 조건을 봤어"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "내가 이런 힘을 얻다니…. 이제 나도 네 앞에 설 수 있겠네"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "잔재주일 뿐이야"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "여기 있어"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "서프라이즈"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "마술쇼 시작"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "조명 부탁해"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "이쪽을 봐"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "보물의 숨결이 느껴져"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "예상대로네"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "식은 죽 먹기지"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "침착하자"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "집중해야 해"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "응전 모드 가동…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "뒤로 물러서"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "내가 적을 유인할게"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "내가… 뭔갈 놓친 걸까…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "마술이 실패했어…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "오빠…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "이 정도는"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "아, 못 피했어"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "마술이 시작되는 걸까?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "애프터눈 티 시간이야"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "앞장서"
    }
  ]
}