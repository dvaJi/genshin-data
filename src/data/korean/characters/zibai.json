    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "빛으로 지킬지어다"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "지혜로 율령을 밝히리"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "구름이 걷히고, 달이 빛나네"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "하늘이 내린 선물이구나. 기쁘게 받으면 된다"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "주인 없는 물건이니, 거둬도 괜찮을 테지"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "지니고 있으면 도움이 될 게다"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "…준비가 부족했나"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
