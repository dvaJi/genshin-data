  "outfits": [
    {
      "id": 214800,
      "name": "설원 사냥꾼",
      "description": "알료샤의 코스튬. 튼튼한 사냥복에는 두툼한 안감과 털장식이 달린 모자가 있어, 알료샤가 원하는 사냥감을 잡을 때까지 눈밭에서 오랜 시간 잠복할 수 있게 해준다. 모자가 강아지 얼굴 모양인 이유는 귀엽고, 투가린도 무척 좋아하기 때문이다",
      "isDefault": true,
      "characterName": "알료샤",
      "characterId": 10000148,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Alyosha_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "안녕. 난 알료샤, 평범한 사냥꾼이야. 물론 도적 놈들에게 수소문하면 나의 또 다른 신분을 알게 되겠지만——그건 우리만의 비밀로 해두자"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·사격 실력",
      "text": "표적 맞히기로 연습한 사격 실력과 사냥으로 익힌 사격 실력은 차원이 달라. 전쟁에서 갈고닦는 경우도 있지만… 음, 이 얘긴 넘어가자"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·입양",
      "text": "혹시 강아지 입양할 생각 있어? 생각 있으면 나한테 얘기해, 어떤 종류든 다 있으니까. 너라면 믿고 맡길 수 있어"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·계산",
      "text": "이만큼은 집으로 보내고, 이만큼은 포효단 사람들이 약을 사게 줘야겠다. 그럼 엽총을 정비하는 데 쓸 모라는… 이번에는 어떤 도적단이 걸려들려나"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "후드가 다 젖겠네…. 투가린, 몸 털지 마!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "동굴에 숨어 있던 녀석들이 나올 때군"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "매복하기 좋은 날씨야. 천둥소리에 총성을 숨길 수 있거든"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "흠, 사냥감의 흔적이 다 지워지겠어"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "이런 날씨엔 모자를 쓸 수가 없어…"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "나도 털갈이를 하면 좋을 텐데…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "아침이 되면 숲속에서 새들이 짹짹거려… 가서 몇 마리 잡아볼까?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "난 보통 야외에서 점심을 먹지만, 딱히 추천하진 않아"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "밤이 됐네. 희귀한 사냥감들은 대개 이 시간부터 활동을 시작해"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "먼저 쉬어. 난 밤에만 할 수 있는 일이 좀 남았거든"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "알료샤 자신에 대해·투가린",
      "text": "투가린을 처음 만났을 때, 녀석은 눈밭에 버려진 채 웅크리고 있었어. 제대로 일어나지도 못했지. 그래도 목숨 하나는 질겨서, 소시지 두 개를 먹여 주니까 금세 내 주위를 빙글빙글 돌더라. 동물을 키울 만큼 식량이 넉넉한 건 아니지만, 사냥꾼한테 사냥개가 없어선 안 되지. 안 그래?"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "알료샤 자신에 대해·엽총",
      "text": "이 엽총은 아버지한테 물려받은 건데, 내가 전체적으로 다 개조했어. 목숨을 맡겨야 하는 이상, 무기는 주운 거든 뺏은 거든 산 거든 다 믿을 게 못 돼. 같이 생사를 넘나들 동료이니, 부품 하나까지 다 꿰고 있어야지. 근데 총기 정비랑 개조 비용이 만만치 않아서, 가끔은 돈을 메꾸기 위해 몇 끼를 굶어야 할 때도 있어…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·사냥꾼과 모험가",
      "text": "전에도 말했듯이, 미지의 황야 앞에서 사냥꾼은 사냥감만 잡으면 발길을 돌리지만, 모험가는 언제나 더 먼 곳으로 나아가고 싶어 해. 그래서 세상을 뒤흔드는 큰일은 나 같은 사냥꾼과 얽힐 일이 거의 없지. 그래도 가끔 너 같은 모험가한테 스릴 넘치는 모험담을 듣는 건, 꽤 흥미로운 일이야"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·이상",
      "text": "넌 스네즈나야가 어떤 나라가 될 것 같아? 훗… 누군가와 이런 이야기를 나누는 건 처음이네. 당장 다음 끼니를 걱정하는 마을 주민이나, 지나가는 행인을 노리는 도적은 이런 문제를 논할 여유가 없으니까. 너는 이런 대화를 나누기 적합한 상대라고 생각해. 물론 지금 당장 답을 교환할 필요는 없어. 나도 더 신중하게 생각해 보고 싶거든. 이 질문의 답이, 우리가 흔히 말하는 「이상」일 테니까"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」은 한 사람의 소원을 상징한대. 하지만 「소원」이라는 말은 너무 막연하다고 생각해. 난 이게 얼마나 실질적인 도움이 되는지가 중요할 뿐이야. 내 특수 능력을 강화해 준다는 사실을 몰랐으면, 아마 진작에 모라로 바꿔버렸을걸"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "스네즈나야의 설원에선 은어를 할 줄 아는 게 도움이 돼. 요정 갱단이나 도적을 만났을 때, 말이 통하면 귀찮은 일을 피할 수 있거든. 참, 입에 「닭고기」를 달고 사는 무리를 만나면 마음껏 털어버려. 「닭고기」는 푼돈을 들고 다니는 약한 행인을 뜻하거든. 만만한 「닭고기」만 건드리는 녀석은 도적 중에서도 쓰레기야. 너와 내 실력이면 순식간에 처리할 수 있지. 맞아, 악당이 악당을 터는 셈이야. 그 녀석들도 감히 겨울군에 신고하진 못할 테니, 억울해도 지네가 어쩌겠어?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "몬드성에 캣테일 술집이라는 곳이 있다던데, 티바트 각지의 일곱 성인의 소환 고수들이 거기 모여 카드 실력을 겨룬다고 들었어. 언젠가 다른 나라에 갈 기회가 생긴다면, 난 무조건 거기부터 갈 거야. 유일한 단점은, 몬드가 여기서 너무 멀다는 거지…. 휴, 왜 스네즈나야에는 그런 술집이 없는 걸까?"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "「여왕」 폐하에 대해…",
      "text": "나에게 여왕 폐하는 이 땅에 내리는 눈 같은 존재야. 우리에게 뼛속까지 스며드는 추위를 견디게 하지만, 동시에 성가신 더러움을 덮어주시지. 그분은 언제쯤 자비를 베풀어, 나 같은 설국의 아이들에게 눈이 녹아내린 스네즈나야를 보여주실까"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "오데트에 대해…",
      "text": "오데트가 포효단의 멤버라는 걸 처음 알았을 땐 깜짝 놀랐어. 우인단 단원 중에도 포효단의 이념에 공감하는 자가 있을 줄이야. 하지만 그렇다면, 이상을 실현하는 게 생각보단 어렵진 않겠어. 이 나라의 미래도 아직은 기대해 볼 만해"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "보댜니차에 대해…",
      "text": "보댜니차는 포효단의 핵심 정보원이야. 나도 이런저런 걸 물어보러 자주 찾아가는데, 보댜니차가 주는 정보는 큰 도움이 돼. 하지만 공적인 이야기를 하지 않을 때는 그 애가 무슨 생각을 하는지 도통 모르겠어. 오데트와는 훨씬 자연스럽게 대화를 나누던데… 여자들끼리만 통하는 은어라도 있는 걸까?"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "발레리에 대해…",
      "text": "발레리를 처음 만났을 때, 그는 내 앞을 가로막더니, 규정 몇 조 몇 항에 따라 군수궁에 접근할 수 없다면서 날 쫓아냈어. 보통 엽총을 메고 군수궁 근처에 잠입한 놈을 발견하면, 그 자리에서 바로 체포해야 정상 아닌가? 난 싸울 준비까지 끝냈었는데 말이야. 뭐, 결국 싸움은 안 났고, 군수궁에 아는 사람만 한 명 늘었지. 그는 어떤 부분에선 나와 생각이 잘 맞아. 우린 서로에게 명확한 선을 그어뒀어. 그 선만 넘지 않는다면, 앞으로도 꽤 유쾌하게 지낼 수 있을 거야"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "미탸에 대해…",
      "text": "난 학교를 제대로 다닌 적이 없어서, 미탸 같은 사람과는 어울리기 힘들 줄 알았어. 하지만 그 녀석이 먼저 내 총을 몇 번 개조해 준 뒤로는, 정말 쓸데없는 걱정이었다는 걸 깨달았지. 미탸는 어울리기 쉬운 사람이야. 그냥 동네 친구처럼 대하면 돼. 딱 하나 주의해야 할 점이 있다면, 걔가 「과학 은어」를 중얼거릴 때는 방해하면 안 된다는 거야"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "알료샤에 대해 알기·첫 번째",
      "text": "내 비밀을 알고 싶다고? 지금 알려줄 수 있는 건, 「사냥꾼」이라는 신분이 꽤 편리한 위장이 되어 준다는 거야"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "알료샤에 대해 알기·두 번째",
      "text": "예전에 누가 나한테, 동물을 겨눌 때와 사람을 겨눌 때의 차이가 뭐냐고 물은 적이 있어. 난 그때 대답하지 않았지. 난 둘 사이에 분명한 차이가 있다고 믿지만, 총을 쏘는 횟수가 늘어날수록, 방아쇠를 당기는 내 동작이 대상에 따라 달라지지 않는다는 걸 깨달았거든…. 그래서 난 사람에게 총구를 겨누는 걸 좋아하지 않아. 언젠가 내 마음속에서 그 차이가 사라져 버릴까 봐 두려워"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "알료샤에 대해 알기·세 번째",
      "text": "어릴 때 도적단에게 우리 집의 전 재산을 털린 적이 있어. 부모님은 별일 아니라며 날 달랬지만, 그 재산을 잃는 게 우리 가족에게 어떤 의미인지 나는 알고 있었지. 그래서 난 내 능력을 이용해 도적단을 추적했어. 그렇게 나는 처음으로 동물이 아닌 대상을 사냥했고, 내 손에 피를 묻혔지…. 후회는 없었어. 그 도적들은 극악무도했고, 마땅한 대가를 치러야 했으니까. 하지만 그들 역시 가난에 찌든 자들이었다는 걸 깨달으면서, 나는 이 나라의 가장 큰 문제가 도적이 아니라는 사실을 이해하게 됐어. 이 나라의 진정한 문제를 찾아내지 못한다면, 내 손에 묻은 피는 아무 의미도 없을 거야"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "알료샤에 대해 알기·네 번째",
      "text": "내가 포효단에 들어가기로 결심한 건, 그곳의 이념이 지금의 스네즈나야와 잘 맞는다고 생각했기 때문이야. 하지만 이런 이념도 언젠가는 스네즈나야에 어울리지 않는 날이 오겠지. 우리가 투쟁해 온 모든 게 결실을 맺고 나면, 많은 것들이 달라질 테니까. 진정한 시련은 그때부터 시작일 거야"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "알료샤에 대해 알기·다섯 번째",
      "text": "내가 보기에 「현실주의자」는 세상에서 제일 속물적인 사람들이야. 늘 돈과 권력, 그리고 마음속에 있는 더러운 일들에 눈독을 들이거든. 반대로 「이상주의자」는 세상에서 가장 고고한 사람들이지. 도둑질과 기만을 경멸하고, 티끌만 한 부정조차 용납하지 못하니까. 사실 또 다른 부류도 있는데, 바로 「현실적 이상주의자」야. 이들은 그 둘 사이에 끼어서 매일같이 내적 갈등에 시달리며 살아가지"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "알료샤의 취미…",
      "text": "개조, 정비, 사격 연습… 처음엔 총이 전투에 필요해서 관심을 갖게 된 거라고 생각했어. 하지만 매번 필요 이상으로 시간과 모라를 쏟아붓는 나를 발견한 후론, 이게 내 취미가 되어버렸다는 걸 인정할 수밖에 없었지"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "알료샤의 고민…",
      "text": "개조에 드는 모라, 정비에 드는 모라, 사격 연습에 드는 모라… 제대로 계산해 보면, 가장 좋아하는 취미가 가장 큰 고민이 될 수도 있다는 사실을 깨닫게 돼"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "잘 절인 고기, 오래 보관할 수 있는 빵, 불에 올리면 바로 녹아내리는 치즈… 이런 훌륭한 재료가 있다면, 얼음과 눈으로 뒤덮인 곳에서도 불만 가지고 푸짐한 식사를 차릴 수 있어"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "껍데기가 있는 건 싫어해. 게나 랍스터 같은 거. 그 많은 모라와 힘을 들여서 집게나 가시와 씨름하는 게, 고작 쥐꼬리만한 살점 때문이라니? 가성비도 안 맞고, 성에도 안 차"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "고마워, 맛있네…. 혹시 이 음식, 나중에 먹을 수 있게 보관하는 방법도 알아?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "음… 희귀한 야생 고기를 몇 가지 추천해 줄까? 더 좋은 재료를 넣으면 훨씬 맛있어질 거야"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "…음식을 낭비할 순 없지. 설원에 있는 마을엔 나보다 이걸 더 필요로 하는 사람이 있을 거야"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘은 네 생일이지? 생일 축하해. 내가 아주 어렸을 때부터 어른들은 「생일 챙기는」 걸 사치로 여겼어. 귀한 밀가루와 크림으로 케이크를 만들고, 시장에서 자취를 감춘 지 오래인 정교한 물건을 찾아 선물을 마련해야 했으니까. 하지만 난 아이들에겐 잘못이 없다고 생각해. 생일이란 원래 그런 거잖아. 언젠간 스네즈나야의 모든 아이가 그런 생일을 보낼 수 있게 되면 좋겠어. 그래서 나도 정성을 담아 선물을 준비하고, 축하 글을 적어봤지. 소중한 친구에게 즐거운 하루를 선물하는 것, 어쩌면 그게 이상을 향한 괜찮은 첫걸음 아닐까?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "좋아, 조준이 훨씬 정확해졌어"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "투가린이랑 호흡이 더 잘 맞게 됐어. 이 녀석도 성장하고 있네"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "명중 횟수가 늘었어…. 이건 과연 좋은 일일까, 나쁜 일일까"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "나의 이상에 닿으려면, 앞으로 얼마나 더 걸어가야 할까?"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "총이 더 빨라!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "명중!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "쓰러져라!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "다 숨었나?"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "사냥감 포착"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "잡았다"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "잘 받아, 투가린!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "투가린, 마음껏 놀아!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "사냥개보다 빨리 뛸 수 있겠어?"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "뭐 빠트리지 않도록 잘 봐"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "모라로 바꿀 만한 거 있어?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "다 챙겼으면 가자. 나쁜 놈들 눈에 띄기 전에"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
