  "outfits": [
    {
      "id": 207300,
      "name": "진리의 한 마디",
      "description": "나히다의 코스튬. 오직 참된 지식을 서술하는 참언과 묘언만이 지혜의 신을 꾸밀 수 있으므로, 신도들은 그녀의 모든 옷과 장신구를 일종의 신탁으로 여겼다",
      "isDefault": true,
      "characterName": "나히다",
      "characterId": 10000073,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Nahida_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "첫 만남? 난 널 아주 오래전부터 주시해왔어. 내 이름은 나히다, 아이처럼 보이지만 그 어떤 어른보다도 이 세상을 잘 알고 있지. 그럼 내 지식으로 네 여행 이야기를 교환할 수 있을까?"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·초대",
      "text": "뭘 할지 모르겠으면, 나랑 한 바퀴 둘러볼까?"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·고민",
      "text": "또 고민거리가 생긴 거야? 내가 같이 고민해 줄게"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·느낌",
      "text": "역시 직접 봐야만 세상의 아름다움을 느낄 수 있어"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "어서 비를 피하지 않으면 머리에 버섯이 자랄 거야"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "그거 알아? 뇌명은 생명의 서곡이야. 이 대지에 생기를 불어넣어 주거든"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "들리니? 하늘이 만물에게 「이제 잠들 시간」이라고 속삭이고 있어"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "날씨가 참 포근하네. 우리 주변도 곧 시끌벅적해지겠어"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "궁전 안에는 바람이 불지 않아… 아, 미안, 너에게는 너무 당연한 지식이겠구나"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침이야, 어서 출발하자. 이 세상에는 「때가 지나면 기다리지 않는 것」들이 너무 많거든"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "점심시간이네, 라즈베리 민트 주스를 마시고 싶은데, 태양에 관한 이야기 두 개로 교환할 수 있을까?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "태양이 저물었으니 야행하는 친구들한테 무대를 양보해주자"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "달콤한 꿈을 준비해뒀으니까 걱정하지 말고 푹 자"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "나히다 자신에 대해·견문",
      "text": "잿더미 바다라. 당연히 알지, 거기엔 아무것도 없어. 텅텅 빈 버섯 돼지 머릿속처럼 말이야. 응? 내… 내가 직접 가본 적은 없어. 거기는 내가 닿을 수 없는 곳이니까"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "나히다 자신에 대해·몰입",
      "text": "신은 인간에게 배를 채우는 지식만을 알려주었지만, 인간은 그걸 토대로 도구를 제작하고 문자를 만들어서 도시와 국가를 발전시켰어. 오늘날에는 별과 심연까지 바라보고 있지….인간은 매 순간 새로운 「지식」을 만들어내고 있어서 도저히 눈을 뗄 수가 없는걸"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·이야기 마당",
      "text": "네가 여행하면서 보고 들은 이야기가 내가 배운 지식보다 훨씬 더 흥미로워. 게다가 질문을 통해 사소한 것까지 다 알아낼 수 있어서… 정말 만족스러워. 자, 시간 낭비하지 말고 계속 가자"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·여행",
      "text": "난 오래전부터 청중으로 있기보단 항상 밖으로 나가고 싶었어. 넌 모험 경험이 풍부하니 내 가이드가 되어줄 수 있을까? 네가 겪을 모든 이야기를 직접 느껴보고 싶어"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "하늘의 눈은 대지의 아름다움을 지켜보기 위해 생겼지. 그런데 이미 눈을 가진 인간들은 어째서 「신의 눈」으로 세상을 관찰하려 할까? 이 문제의 답은, 똑똑한 너라면 알 수 있겠지?"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "때로는 직접 뼈에 사무치는 고통을 받기 전까지 자신의 게으름과 우매함 그리고 무모함과 오만함을 마주할 수 없어. 하지만 후회할 필요는 없지. 우리는 모든 가능성을 다 예측할 수 없기 때문에 이렇게 무모하고 어리석어 보이는 방식으로 지식을 얻는 거야. 수업료를 냈다고 생각하면 이상할 것 없잖아"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일·처음 보는 꽃",
      "text": "수메르의 사막은 우림보다 생기가 없어 보이지만 사막도 나름의 오래된 문명과 안정적인 생태 환경을 낳았어. 사막이 우림과 더 이상 싸우지 않는 날이 온다면 분명 내가 처음 보는 꽃이 피어나겠지?"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "사이노에 대해·농담",
      "text": "사이노의 농담은 심오하면서도 재밌어. 응? 못 알아들었다고? 그럼 내가 설명해 줄게"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "사이노에 대해·직책",
      "text": "질서와 정의가 충돌할 때 모든 「대풍기관」이 확고한 해답을 내릴 수 있는 건 아니야. 사이노는 타협은 곧 궁지로 직결된다는 것을 가장 잘 알고 있어서, 자신이 있어야 할 위치로 돌아올 수 있었지. 수메르에게는 잘된 일이야"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "타이나리에 대해…",
      "text": "우림이 「죽음의 땅」의 침식에 대항하고 오늘날까지 생기발랄한 모습을 유지할 수 있는 건 숲의 순찰관의 역할이 컸어. 타이나리는 그중에서도 특출났지. 다만… 성격이 조금 더 온화해졌으면 좋겠어. 그래야 숲의 순찰자 지원자가 더 많이 생길 거야"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "콜레이에 대해…",
      "text": "콜레이에 대해 들어본 적 있어. 콜레이의 의지는 보석처럼 단단하고 눈부시다고 해. 많은 시련을 겪은 그 아이가 평범하고 건강하게 자랄 수 있게, 수메르의 초목의 가호가 함께하기를"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "알하이탐에 대해…",
      "text": "알하이탐은 시대를 앞서가는 지식 체계를 가지고 있으며 항상 사고를 유지하지, 세상에서 알하이탐을 속일 수 있는 건 없을 거야. 하지만 지혜로운 자는 일반인의 평범함을 타고난 잘못이라고 생각하는 걸까? 그건 「우리」에게 있어서 떼어낼 수 없는 부분인데 말이야"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "닐루에 대해…",
      "text": "다른 사람의 몸을 빌려 닐루에게 물어본 적이 있어. 자신의 공연에 작은 쿠사나리 화신을 초대하고 싶은지 말이야…. 물론 난 몰래 공연을 몇 번 봤지만, 그래도 직접 가는 게 「화신(꽃의 신) 탄신 축제」 공연에 대한 예의잖아. 하지만 결국 거절당했어… 음, 좀 가슴 아프네"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "도리에 대해…",
      "text": "도리는 날 처음 보자마자 「궁전이 마음에 드는데 얼마에 팔 거야?」라고 물었어. 정선궁을 팔 생각은 없었지만, 질문에는 답할 수 없었지. 아무리 생각해봐도 정선궁의 가치를 모라로 매길 수 없었거든…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "카베에 대해…",
      "text": "수메르가 지식을 전파하는 것에 대한 카베의 이해는 거의 본질에 가깝지만 아쉽게도 그가 파악한 진실은 이 나라의 주류가 될 수 없어. 뭐? 카베가 알하이탐의 룸메이트라고? 세상에 이런 일이…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "파루잔에 대해…",
      "text": "파루잔의 몸은 적왕의 유적에 있는 잔재의 힘의 영향을 받아, 시간이라는 거북이의 등에서 떨어지고 영원히 잊혀졌지. 관심이 있다면 그녀를 통해 과거 수메르의 일각을 엿볼 수 있을 거야"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "7명의 집정관에 대해·소개",
      "text": "아주 아주 오래전에 7명의 집정관은 정기적으로 연락을 주고받았지만, 나는 상황이 좀 특수해서 그때의 기억이 없어…. 수메르의 혼란이 어느 정도 마무리되었으니 다시 만나보고 싶은데, 네가 잘 아는 신들을 나에게 소개 좀 해줄 수 있을까?"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "7명의 집정관에 대해·게임",
      "text": "게임을 하면 서로 금방 친해질 수 있다고 들었는데, 신들도 마찬가지일 거야. 다들 모였을 때 「사방치기」를 제안해 보는 건 어떨까…? 아니다 내가 끼면 사각형을 작게 만들어야 해서 나한테 너무 유리할 거야"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "스카라무슈에 대해…",
      "text": "오랫동안 추구해왔던 염원이 이루어졌을 때 그는 만족했을까, 아니면 더 공허해졌을까? 우리는 날지 못하기 때문에 하늘을 날고 싶어 하지… 그가 텅 빈 하늘을 가지고 난 다음 다시 생각해 보라고 하자"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "푸리나에 대해…",
      "text": "지혜란 무엇을 아는가가 아닌, 무엇을 바꿀 수 있는가를 가리킨다고 사람들은 말해. 그 「예언」은 이미 오래전에 세계수에 새겨졌을 거야…. 아무것도 변하지 않은 것 같지만, 또 모든 게 변한 것 같기도 하네. 너와 나 모두 알다시피 푸리나는 세계의 운명을 바꿀 정도로 똑똑한 사람이야"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "하보림에 대해…",
      "text": "심연은 가장 치명적인 형태로 티바트에 나타나. 수메르에서는 「금단의 지식」이었고, 나타에서는 마물이었지. 그래서 수메르의 수많은 경험으로도 그녀를 도울 수 없어서 죄책감이 들었었어. 그래도 위기가 해결돼서 정말 다행이야. 마비카가 나타 사람들이 수메르에 놀러 올 거라고 하던데, 그들을 열렬히 환영해 주려고. 준비도 모두 끝내뒀어"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "나히다에 대해 알기·첫 번째",
      "text": "내 과거는 엄청 단조로워, 듣다 보면 지루해서 대포 복어처럼 하품할걸? 하지만 호기심은 아주 소중하므로 낭비하고 싶지 않아… 그럼 내가 꿨던 꿈들을 공유해 줄게"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "나히다에 대해 알기·두 번째",
      "text": "내 꿈엔 항상 화분이 나타나는데, 매번 물을 주고 비료를 뿌리면 같은 꽃이 피어나지. 너라면 결과가 확정된 꽃을 키우는 과정을 즐길 수 있을까? 후후, 난 적어도 매번 꽃이 피고 나면 날아오는 나비의 색이 다르다는 걸로 만족해, 가끔은 벌도 날아온다구"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "나히다에 대해 알기·세 번째",
      "text": "내 꿈에선 항상 모래시계가 나타나는데, 난 그 안에 물을 넣고 섞은 다음 다 내려가는 데 얼마나 걸리는지, 저번과 얼마나 차이 나는지 관찰하는 걸 좋아해. 규칙도 없고 의미도 없지만 머릿속 피로가 사라지거든, 「아무 의미 없는 것」이라서 더 재밌어"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "나히다에 대해 알기·네 번째",
      "text": "내 꿈에선 항상 공터가 나타나는데, 주변 풍경이 어떻게 변하든, 그 공터는 가장 중요한 위치를 차지하고 있어. 정말 이상하지? 이곳에 무언가가 존재했을 거라고 생각을 하지만 꿈의 권능을 사용해 봐도 전혀 알아낼 수가 없었어. 음, 꿈에서 내가 제어할 수 없는 것이 존재하다니…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "나히다에 대해 알기·다섯 번째",
      "text": "내 꿈에는 없는 게 없지만 유일하게 부족한 건 오가는 사람들이야. 하지만 너와 만나고 나서 이곳도 점차 활기를 띠고 있어. 네가 꿈에서 「가이드」 역할을 해준 덕에 꿈에 인간미가 생겼지. 네가 날 우리 안에서 꺼내준 거야. 후후, 가자, 앞으로의 여정도 잘 부탁할게"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "나히다의 취미…",
      "text": "이렇게 널 바라보는 것도 취미라고 할 수 있을까? 너의 행동 하나하나가 모두 다 궁금하거든. 세상을 누비는 여행자가 어디서 왔고 어디로 가는지, 어떤 사람을 만나고 어떤 어려움을 극복해나가는지, 이 모든 게 내가 알고 싶은 답이야. 신경 쓰지 말고 그냥 계속 관찰하게 해줘"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "나히다의 고민…",
      "text": "난 내가 질문과 답변을 잘한다고 생각했어. 그런데 사람들은 알면서도 모르는 척하거나, 답을 알려줘도 도움이 되지 않는다는 것을 점차 깨달았지. 사람은 나이가 들면 답을 마주할 용기가 없어지는 걸까…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "당연히 대추야자 사탕이지. 하나만 먹어도 머리 회전이 빨라져서 해결 못하는 문제가 없거든. 주의할 점은, 절대 사탕 항아리를 쉽게 손닿는 곳에 두어서는 안 된다는 거야"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "해산물은 내가 모르는 깊고 어두운 바닷속에서 자랐을 텐데, 그걸 먹으라는 것은 나보고 더러운 먹구름을 먹으라는 것과 다름없어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "이렇게 훌륭한 맛은 세상에 영원히 기록되어야 해. 정말 고마워"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "후후, 마음은 잘 받았어, 맛도 아주 훌륭해"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "…뭐라고 해야 할까? 예를 들면 강아지한테 야채 주스를 먹일 순 없잖아?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생각해 봤는데 네 생일을 축하하려면 적어도 화신 탄신 축제만큼 성대해야 할 것 같아…. 음? 너무 과하다고? 하지만 이미 준비하라고 시켰는걸. 어서 가자. 이번 한 번만은 기대해도 좋을 거야!"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "더 똑똑해졌어~"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "하늘과 바다도 집어넣을 수 있을 정도로 생각이 트였어"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "마치 달 연꽃이 연잎을 만나고 산호 진주가 조개를 만난 듯한 느낌이 들어"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "날 동료로 받아주고 새로운 지식을 가르쳐줘서 정말 고마워. 지혜의 신의 이름으로 앞으로 있을 여정에 그 어떠한 어려움도 널 막지 못하도록 축복해 줄게"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "기억했어"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "퍼져라"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "이따가 조금 아플 거야"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "헤이!"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "손에 손잡고~"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "전부 다 보인다구"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "우리 집에 놀러 와~"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "지식을 너와 공유할게"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "이곳이 바로 지혜의 전당이야"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "호기심의 포상이야"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "누가 남긴 선물일까?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "원하는 게 들어 있어?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "전략을 바꿔보자"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "그만 때려!"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "현명하지 못하네…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내가 방법을 생각해 볼게"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "무리하지 마"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "생명은… 끝나기 마련이지…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "시드는 순간…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "이… 이해할 수 없어…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "아프잖아"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "어지러워…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "널 한참 기다렸어"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "아직 안 가 본 곳이 엄청 많아"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "또 견문을 넓힐 수 있겠어"
    }
  ]
}