  "outfits": [
    {
      "id": 202701,
      "name": "비단 속 난초",
      "description": "응광의 예복 코스튬. 군청색의 긴 치마는 우아하고 아름다운 곡선을 그리고, 복사뼈에 달린 나비 날개는 경쾌한 느낌을 더해준다",
      "isDefault": false,
      "characterName": "응광",
      "characterId": 10000027,
      "source": [],
      "filename_card": "UI_AvatarIcon_NingguangCostumeFloral_Card",
