  "outfits": [
    {
      "id": 200601,
      "name": "잎새에 숨겨진 이름",
      "description": "리사가 수메르를 다시 방문했을 때 주문 제작한 코스튬. 우아하면서도 세련된 이 옷은 리사의 학창 시절 교복과도 닮았다",
      "isDefault": false,
      "characterName": "리사",
