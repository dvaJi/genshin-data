      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Lisa_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "귀염둥이 안녕, 새로 온 조수인가? 어? 마법사? 그건 아주 오래전 일이야. 지금의 난 도서관 사서일 뿐이라구. 걱정 마, 잘 돌봐줄게, 그럼…"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·티타임",
      "text": "애프터눈 티 시간인데"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·임무",
      "text": "임무는 끝나질 않네. 그러지 말고 나랑 수다 떨자~"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·외출 삼가",
      "text": "오늘은 외출하기가 좀 그래…. 내가 어제도 이렇게 말했나?"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "이런 날씨에 차 한 잔 하며 비오는 구경이나 하면 참 좋겠네"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "천둥이 치고 비가 오는 날의 훈련은 효과가 2배라구~ 하하, 뻥·이·야~"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "날씨 참 좋네. 누워서 잠을 보충할 수 있다면 더 좋을 텐데"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "하암… 좋은 아침이야, 진. 어라? 미안, 내가 잘못 봤네"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "점심시간이 됐구나…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "아직 안 자? 난 벌써 졸린데…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "네가 애쓰는 모습 다 봤어. 네게 무슨 상을 줘야 할까…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "리사 자신에 대해…",
      "text": "이건 게으름을 피우는 게 아니야. 모두 가장 효율적으로 목표를 달성하길 원하잖아?"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·관계",
      "text": "날 선생님, 선배, 친구 중에 뭐로 여길래? 난 다 상관없어"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·역량",
      "text": "어머나, 진짜 실력을 보이지 않으면 그동안의 노력이 허탈하겠는데. 후후, 괜찮아"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·의식",
      "text": "좀 더 기다려, 속죄의 입맞춤을 제자의 이마에…. 됐다, 그럼 의식 완료~ 앞으로 넌 나 리사의 수제자야"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "신의 눈은 말이지… 그건 원소의 힘을 인도하는 필수 장치잖아. 네 몸에서만은 예외지만. 음… 대체 무슨 원리일까? 아 그래 너, 이 누님과 함께 실험하지 않을래?"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "도서관 위의 연금술 공방은 편히 사용해도 돼. 하지만 들어가기 전 노크를 잊지 마. 보지 말아야 할 걸 보면 곤란해지니까"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "통통 연꽃은 해독 작용이 있는 약초야. 그것만 있으면 마법 포션의 부작용을 걱정하지 않아도 돼"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "진에 대해…",
      "text": "진은 본분을 다하는 좋은 단장이야. 그녀가 열심히 일하는 모습을 보면 돕고 싶은 마음이 절로 생겨"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "엠버에 대해…",
      "text": "엠버가 기사단에 막 들어왔을 때가 기억나네. 눈 깜짝할 사이에 능력 있는 기사가 다 됐어. 아, 몇 년 더 지나면 어떤 모습이 되어 있을까?"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "바바라에 대해…",
      "text": "바바라의 노래를 들어본 적 있어? 흥흥, 그녀의 멜로디에 치유의 마력이 존재한다던데. 내 마법약과 그 노래 중에 뭐가 더 네 입맛에 맞을까?"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "다이루크에 대해…",
      "text": "음, 다이루크의 이야기를 듣고 싶어? 하하, 그럼 더 좋은 대화 상대를 알려줄게"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "레이저에 대해…",
      "text": "어린 늑대야, 이리 오렴. 오늘 임시로 실전 연습을 하자. 상대는 찾아놨어. 어라? 왜 도망치지? 이거 참…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "클레에 대해…",
      "text": "저번에 클레가 실험한다고 공방을 빌려달라고 했는데 거절해서 온종일 삐져있었어. 응? 다음날? 다음날엔 당연히 아무 일도 없다는 듯이 밖에 나가 놀았지"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "모나에 대해…",
      "text": "모나? 아주 훌륭한 마법사 아가씨인 것 같아. 하지만 난 「마녀회」 멤버가 아니라고. 고목 조사, 다과회 운영. 휴~ 듣기만 해도 귀찮은 일이잖아"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "알베도에 대해…",
      "text": "난 알베도가 아주 훌륭한 연금술사라고 생각해. 그와 두세 마디만 해도 괜찮은 결론이 나오지. 얼굴도 잘생기고. 내 귀염둥이랑 많이 닮았잖아. 응"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "피슬에 대해…",
      "text": "피슬… 아, 항상 도서관에 와서 판타지 소설을 빌리는 그 여자애. 매번 3일 먼저 책을 반납하고 책을 아끼는 좋은 아이야"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "노엘에 대해…",
      "text": "노엘에게 책꽂이 청소를 부탁했는데, 그 아이는 힘들수록 신나하는 것 같았어. 흠… 대체 무슨 영문일까?"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "설탕에 대해…",
      "text": "별일 없으면 괜히 설탕을 방해하지 마, 그녀가 놀랄 수도 있으니까. 그녀는 온갖 생물을 다루는 데엔 능숙하지만, 유독 사람들과는 잘 어울리지 못하는 것 같아"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "사이노에 대해…",
      "text": "수메르를 떠난 뒤로 은사님과 의례적으로 연락을 주고받은 것 말고는 더 이상 아카데미아와 교류가 없어. 다행히 신임받던 제자들이 모두 나처럼 나태한 건 아닌 모양이야…. 사이노라는 후배가 엄청난 활약을 하고 있다고 들었어"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "콜레이에 대해…",
      "text": "꼬마 콜레이는 편지를 쓸 때마다 다양한 표현 방법을 시도하기 위해 항상 새로운 단어를 사용하곤 해. 후후, 그래서 실력이 빨리 느는 거겠지. 콜레이 본인이 노력한 공도 크지만, 착하고 열정적인 그 아이의 스승도 분명 많은 도움을 줬을 거야"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "미카에 대해…",
      "text": "호프만 씨에겐 사람을 잘 보살피는 동생이 있어서 정말 부러워. 일상생활뿐만 아니라 숙취 케어까지 해주다니. 나도 아무런 걱정 없이 온종일 축 늘어져 있고 싶은데…. 음? 지금도 다를 바 없는 것 같다고? 귀염둥이, 요즘 들어 대담해졌네"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "프루네에 대해…",
      "text": "우리 꼬마 프루네는… 늘 어렵고 난해한 책을 빌려 가. 내가 살짝 다가가거나 웃어주기만 해도 유리 구피처럼 허둥대는데, 후후, 그 모습이 어찌나 귀여운지. 내가 그 아이가 찾는 「마녀」가 아니라서 천만다행이야. 안 그랬으면 진지한 꼬마 사냥꾼한테 찍혀서, 아주 곤란해질 뻔했지 뭐야~"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "리사에 대해 알기·첫 번째",
      "text": "그럼 오늘은 어떤 원소 마법 지식을 배우고 싶니?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "리사에 대해 알기·두 번째",
      "text": "내 과거? 응? 날 더 많이 알고 싶다고? 안타깝게도 오늘은 내가 좀 피곤해. 하지만 그런 생각을 하다니 기특한데"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "리사에 대해 알기·세 번째",
      "text": "레이저에게 원소의 힘을 가르쳤을 때, 그 녀석이 그렇게 빨리 배우리라고는 생각 못 했어. 곰곰이 따져보면, 너도 꽤 자질이 있는 것 같아. 귀염둥이"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "리사에 대해 알기·네 번째",
      "text": "뭐라고? 수메르 마법을 배우고 싶다고? 지금 너한텐 좀 무리일 텐데…. 음, 최소한 입문 지식은 익히고 싶다고? 그럼 먼저 이 《서론》을 봐, 800페이지밖에 안 돼"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "리사에 대해 알기·다섯 번째",
      "text": "언젠가 이 「눈」의 힘이 모든 걸 파괴하겠지…. 그때에도 네가 있다면… 아, 아무것도 아니야"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "리사의 취미…",
      "text": "귀염둥이, 신기한 포션을 하나 골라볼래? 마시기 전에는 무슨 효과가 있는지 전혀 알 수 없어"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "리사의 고민…",
      "text": "2층 심문실을 2년째 방치하고 있어…. 내가 원소 공방으로 썼으면 그렇게 황폐해지진 않았을 텐데. 헤르타 아가씨도 진짜 고집불통이야"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "나 야채수프 좋아해. 모든 야채를 전~부 큰솥에 넣고 긴 국자로 저으면… 아, 맛있냐고? 한 입 먹어봐——"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "난 호박 공포증이 있어, 매년 가을 수확제 때마다 너무 힘들어. 아, 아예 호박을 멸종시켜 버릴까?"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "신경 많이 썼구나, 귀염둥이. 아주 만족해"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "후후, 이런 거에 완전 소질 있구나"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "이야… 이건 정말…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "자, 받아. 호신부야. 네 생일 선물이지. 만드느라 시간 꽤 걸렸어…. 잃어버리면 안 돼~"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "나보고 야근하라는 건 아니겠지…? 그럼 안 되는데~"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "단련할 기회는 새내기에게 많이 줘야지. 안 그래?"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "내가 전성기 상태를 회복한다면 무슨 대단한 일이 벌어질지도 모르지"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "온갖 방법을 다해 널 설득했잖아. 참 대단한 아이야, 귀염둥이. 이렇게 됐는데도 무관심한 척하면 츄츄족도 내가 거짓말한 줄 알겠다. 그럼 네게 장미 마녀의 진실을 보여주지"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "흥흥~"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "전기 맛 좀 볼래"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "도망치지 말라구~"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "…Blitz!"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "이건… 벌이야!"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "…호호~"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "찌릿찌릿할 거야~"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "어서 항복하는 게 어때~"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "푹 빠지면 안 돼~"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "노력한 보람이 있네"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "나도 기분이 업되는 걸"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "귀염둥이가 좋아할까?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "제법이네"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "좀 실력이 무뎌졌네…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "이런, 장갑이 구멍나겠어"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "센 척은 안 좋아~"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "내가 도와줄까?"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "외출은 힘들어…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "내가 방심한 것 같아…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "역시 밖으로 나오는 게 아니었어…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "아…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "그렇게 난폭하게 굴지 마"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "내가 도와줄게"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "널 지켜볼 거야"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "외출할 시간인가?"
    }
  ]
}