  "outfits": [
    {
      "id": 206400,
      "name": "무대의 연기구름",
      "description": "운근의 예복 코스튬. 비운 상회의 솜씨 좋은 재봉사가 제작한 치마. 운근의 마음을 첫눈에 사로잡은 이 스커트는, 그날 이후 운근이 가장 즐겨 입는 의상이 되었다고 한다",
      "isDefault": true,
      "characterName": "운근",
      "characterId": 10000064,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Yunjin_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "누군가를 알아갈 때 소문으로 듣는 것보단 직접 만나는 게 낫다고 하죠. 이렇게 만나게 돼서 정말 기뻐요. 제 성은 '운'이고 이름은 '근'이에요. 아직 부족하지만 현재 운한사를 주관하고 있죠. 최근 저희 극단은 화유다관에서 공연하고 있어요. 나중에 많이 보러 와줘요"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·민감한 주제",
      "text": "요즘 허리가 좀 끼는데, 설마… 살쪘나?"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·편안함",
      "text": "오늘은 머리도 세게 안 묶고, 분장도 안 하니까 편하네요"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·무반주 노래",
      "text": "구름에 걸린 달빛이 꽃에도 걸리니, 산과 물에 운치가 가득하네 (노래)"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "…으아, 천, 천둥소리 들었어요? 깜짝 놀랐어요"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "흐유, 추워 죽는 줄 알았군"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "날씨가 포근하니 좋네요"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침이에요. 아침 이슬은 차를 달이기 딱이죠. 차 한잔 마시고 출발할까요?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "점심 먹고 나면 잠이 몰려와요… 하암… 당신은 안 졸린가요?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "저녁엔 이야기꾼의 강담을 들으러 갈까요? 유소 씨가 들려주는 《비를 베는 소리》는 아주 일품이거든요"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "밤엔 꽤 쌀쌀하니 일찍 쉬어요. 잘 자요"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "운근 자신에 대해·글 깨우치기",
      "text": "전 글을 일찍 깨우쳤어요. 아주 어렸을 때부터 아버지가 글을 가르쳐주셨거든요. 아버지의 능력이 10이라면 전 그중 3할만 깨우쳤죠. 극본을 쓰기엔 충분하지만, 박식한 사람과 비교하면 한참 멀었답니다"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "운근 자신에 대해·연극 훈련",
      "text": "어머니는 젊으셨을 때 리월항의 유명한 배우셨어요. 제가 하는 연극도 다 어머니가 가르쳐주신 거죠. 당신은 그분이 얼마나 엄한지 모를 거예요. 예전에 같이 연극 배웠던 시절을 떠올리면… 아니 아니, 안 떠올릴래요"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·임시 극단",
      "text": "최근에 좀 큰 연극이 여럿 있는데, 칼춤 실력이 뛰어난 배우가 필요해요. 당신이 여러 방면으로 적합한 것 같은데, 어때요? 한번 해볼래요? 쉴 때 같이 차도 마시고요"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·로큰롤",
      "text": "응? 당신도 로큰롤을 듣나요? 잘 됐네요. 다음 콘서트 때 같이 가면 되겠어요. 돌아오면, 당신을 만나고 왔다고 할 거예요. 그럼 극단 어르신들도 잔소리할 구실이 없을 테니까요"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "신의 눈이라… 암왕제군도 연극을 좋아하시는 거 아닐까요? 공연을 보고 마음에 드셔서 저한테 신의 눈을 선물로 주신 걸지도 몰라요, 하하"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기·음료",
      "text": "전 다양한 음료를 마셔보는 게 좋아요. 윗 세대분들이 발명한 전통 차 중에 '소나무 이슬'이나 '매화에 앉은 눈' 같은 건 다 마셔봤죠. 새로운 음료를 찾고 있는데, 추천할 만한 거 있나요?"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "하고 싶은 이야기·소원",
      "text": "저도 가끔은 무대 의상을 벗고, 밖으로 나가서 더 큰 세계를 보고 싶어요. 이 소원을 이루려면 더 노력해야겠네요"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "매일 새벽에 해가 뜨면 되새가 지저귀는 소리가 들려서 기분 좋아요"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "신염에 대해…",
      "text": "극단 어르신들은 맨날 로큰롤을 많이 들으면 삐뚤어진다고 신염의 콘서트에 못 가게 하셔요. 말로는 절 위해서라는데, 흥, 그냥 신문물을 못 받아들이시는 거겠죠. 그렇다고 순순히 안 갈 제가 아니죠. 신염의 콘서트는 매주 갈 거예요"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "호두에 대해…",
      "text": "호두는 표정이 다양하고 두뇌 회전이 빨라요. 일상적인 얘기를 해도 항상 「재치 있게 받아치죠」. 정말 부러워요. 이런 친구랑 같이 있으면 뭘 하든 재밌다니까요"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "종려에 대해…",
      "text": "이 업계의 규칙은 대대로 전해져 내려오는 거라 지켜야 할 게 많아요. 어떤 일은 저도 겉만 알고 깊게는 잘 몰라요. 근데 종려 선생님은 훤히 꿰뚫고 있더라구요. 그렇게 전문적인 관중을 싫어할 사람이 어디 있겠어요?"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "응광에 대해…",
      "text": "천권성은 통이 커서 저희 극단을 많이 후원해 줬어요. 그녀가 저희에게 준 것이 있으니 저희도 최고의 공연으로 보답해야죠"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "행추에 대해…",
      "text": "당신도 행추를 아는군요. 하하, 행추는 머리가 좋잖아요. 짓궂어서 맨날 사람 놀릴 생각만 한다니까요. 당하지 않게 조심해요"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "신학에 대해…",
      "text": "《사원을 가른 신녀》의 각본은 달달 외울 정도로 읽었는데, 그 「신녀」가 실존한다는 걸 이제야 알았어요. 인연이란 신기하네요. 이젠 더 이상 쓸쓸하지 않게 항상 그녀 곁에 좋은 친구가 있었으면 좋겠어요"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "각청에 대해…",
      "text": "옥형성이 연극을 보러 온 적은 없었던 것 같아요. 길에서 우연히 만날 때마다 바쁜 모습이었죠"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "카에데하라 카즈하에 대해…",
      "text": "연극을 좋아하는 외국인도 많답니다. 카에데하라 카즈하 씨도 그중 하나죠. 관현악 부분이든 타악기 부분이든 조용히 경청하는 좋은 관중이에요"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "운근에 대해 알기·첫 번째",
      "text": "저희 극단에선 제가 극단을 이어받은 후에 새로 쓴 극본도 꽤 많이 공연해요. 제가 극본을 쓰기도 하고 직접 부르기도 해서 그런지 리월항에서 꽤 유명한 편이랍니다"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "운근에 대해 알기·두 번째",
      "text": "전통에 따르면 배우가 무대에 오르기 전엔 머리를 꽉 묶고, 분장도 하고, 무대 의상도 입어야 해요. 그리고 다른 준비 작업도 많죠. 이렇게 「완전무장」을 하면 보기엔 더 좋지만, 체력적으로 힘들어서 가능하면 무반주로 편하게 공연하는 편이에요. 그럼 분장이나 복장을 전부 갖추지 않아도 되거든요. 정 필요할 땐 최대한 가벼운 분장을 한답니다.\\n저희 극단과 오랫동안 함께한 화유다관이 느슨한 편이라 다행이에요. 아니면 진짜 힘들었을 거예요"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "운근에 대해 알기·세 번째",
      "text": "무대에 오른 지 얼마 안 됐을 때, 관객분들의 사랑으로 콧대가 높아졌던 시기가 있었어요. 각본이 마음에 안 든다고 노래를 안 하고, 무대가 작다고 안 하고, 관중이 적어도 안 했죠. 지금 생각해 보면 그땐 진짜… 너무 오만했어요… 다시는 그러면 안 되겠어요"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "운근에 대해 알기·네 번째",
      "text": "생각해 보니, 운한사를 물려받은 지도 좀 됐네요. 전 원래 대본만 쓰고 노래만 부를 줄 알았어요. 경영하고 사람 대하는 일엔 관심이 아예 없었는데, 극단 주인이 되고 나니까 어쩔 수 없이 이런 걸 신경 쓰게 되더라구요. 그러면서 세상의 달고 쓴맛을 모두 보게 됐죠….\\n그러다 깨달았답니다. 인생이 한바탕 연극 같고, 연극이 인생 같다는 걸"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "운근에 대해 알기·다섯 번째",
      "text": "리월의 대부분 전설은 마신과 선인에 관한 이야기예요. 그래서 리월극엔 신선극이 가장 많죠. 최근 새로 공연 중인 《사원을 가른 신녀》처럼요. 나이가 있으신 분들이 이런 이야기를 좋아하지만, 지금은 인간들의 시대잖아요. 저도 제 분야에 변화를 가져오고 싶어요. 제가 연기하고 싶은 건 세상 사람들의 삶과 마음이거든요.\\n이런 생각은 아무한테도 말한 적이 없는데, 묵묵히 들어줘서 고마워요. 마음을 알아주는 친구가 있는 전 정말 행운아예요"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "운근의 취미…",
      "text": "취미? 그야 당연히 연극이죠. 전 이 일을 평생 할 생각이에요"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "운근의 고민…",
      "text": "고민이라… 음, 체형을 유지하기 위해 평소에 먹는 양을 조절하는 편이에요. 살면서 맛있는 음식도 마음껏 못 먹는다니, 슬프네요"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "천추육, 삶은 검정 농어, 훈제고기 볶음… 전부 다 먹고 싶어요. 근데 평소엔 못 먹죠. 저기… 그냥 물어보는 건데… 혹시 제가 말한 음식들 만들 줄 알아요?"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "매일 새우살 볶음만 먹어요. 하루도 빠짐없이…. 어떻게 조리하든 다 같은 맛이에요. 진짜 질렸어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "맛있는 요리를 먹으면 정말 행복해요…. 과식하면 안 되니까, 아쉽지만 그만 먹어야겠어요"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "정말 푸짐하군요! 마실 걸 가져올 테니, 요리랑 같이 즐겨요"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "죄송하지만… 이 음식은 많이 못 먹겠어요"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘이 생일이었어요? 잔치를 벌일 재주는 없으니 노래 한 곡 불러줄게요. 당신만을 위한 노래요. 뭐 듣고 싶어요? 당신이 정해주세요"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "이런 속담이 있죠. 「배움은 근면함으로 인해 정진하고, 노는 것 때문에 황폐해진다」"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "지금까지 성실하게 노력해온 성과예요"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "처음엔 무대를 위해 창술을 배웠지만, 나중엔 무예를 익히려고 배웠어요. 지금은 두 가지 목표를 다 이뤘네요"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "창술은 변화무쌍하고 오묘해요. 연습할 때 당신이 옆에 있어 줘서 다행이에요. 이미 요령을 알았으니 앞으로 대련할 땐 조심해야 할 거예요"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "닿아라!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "무너져!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "흩날리는 깃발!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "구름의 기치!"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "내 창을 보아라!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "내 호령을 들어라!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "일심동체!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "이 기세를 몰아가자!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "어디 보자"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "여행하면서 쓸만한 물건인가요?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "사양 말고 받으세요"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "치마가 찢어지겠어요…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "재정비가 필요해요"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "흥, 클라이맥스는 이제부터예요"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "먼저 퇴장하세요"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "제가 수습할게요"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "곡이 끝나자… 모두 흩어지네…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "어쩔 수 없지…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "더는… 노래를 부를 수 없어…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "진정하자…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "꼴이 말이 아니네요…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "정도란 게 없는 겁니까…?"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "가——자——꾸——나——"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "오늘은 어떤 곡을 불러볼까요?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "당신이 날 불렀으니 당연히 와야죠"
    }
  ]
}