  "outfits": [
    {
      "id": 205100,
      "name": "드높은 파도의 춤",
      "description": "유라의 코스튬. 단정함과 우아한 자태를 돋보이게 하는 기사 복장이다",
      "isDefault": true,
      "characterName": "유라",
      "characterId": 10000051,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Eula_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "페보니우스 기사단의 유격대 대장, 「파도 기사」 유라·로렌스. 당신에게 인사드립니다…. 그래, 맞아, 로렌스. 보다시피 난 죄인의 후예, 기사단의 스파이야. 그들에게 복수를 하고 있지"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·예절",
      "text": "기사와 귀족의 예절은 일맥상통해. 기사의 예절은 허례허식을 간소화했을 뿐이지"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·검술",
      "text": "페보니우스 검술? 나한테 배우고 싶어? 네가 다 익힌 다음 너한테 복수하는 것도 재밌겠네"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·규칙",
      "text": "귀족들의 진부한 규칙…? 그냥 듣고 흘려. 난 몇백 개씩 외우도록 강요당했는데도 별로 신경 안 쓰거든"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "빨리 우산 안으로 들어와, 다 젖겠어. 네가 병들면 난 누구한테 복수하라고?"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "진짜 성가신 날씨야. 천둥소리가 청각을 방해해서 주변 상황을 쉽게 감지할 수 없게 된다고"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "시야가 딱 좋네! 높은 곳에 오르면 주변의 적들이 한눈에 다 보이지"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "일어날 시간이야. 일출 두 시간 전은 밤새 보초 선 병사가 가장 피곤할 때니까 우리가 움직이기 딱 좋은 시간이라고!"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "점심엔 탄수화물 대신 고기를 많이 먹어야 식곤증이 안 와. 밥 먹고 졸다가 당할 수도 있다고"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "「부드러운 바람이 당신의 밤을 평안하게 지켜주길」…. 옛 귀족의 인사말에 모처럼 이런 좋은 말이 있네"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "골피리 자장가 한번 들어볼래? 들으면 영영 깨어나지 못할 거야…. 하지만 이런 식으로 복수하는 건 너무 시시하잖아"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "유라 자신에 대해·기사",
      "text": "적 내부에 침투하면 복수가 훨씬 수월해지잖아? 그래서 기사단에 가입했어"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "유라 자신에 대해·태도",
      "text": "페보니우스 기사가 된 이상 기본적인 업무엔 최선을 다해야지. 아니면 그저 그런 사람들과 다를 게 뭐야. 아무리 죄인이어도 그렇게 살면 안 되지"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "유라 자신에 대해·유격",
      "text": "자유롭게 적군을 사냥하거나 전장의 측면에서 적을 제압하는 게 바로 유격 기사가 할 일이야. 규율이 별로 없어서 완전 내 스타일이지"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "유라 자신에 대해·춤",
      "text": "로렌스 가문의 전통도 다 쓸모없는 건 아니야. 순결하고 고아한 「제례의 춤」은 내 마음에 평온과 위안을 가져다줘. 몇 년이 지났는데도 나한테 아주 소중해. 몸이 모든 스텝을 기억하지…. 그러니까 나만의 「페보니우스 검술」을 배우고 싶다면 일단 이 춤부터 배워야 할 거야"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "우리에 대해·공통점",
      "text": "사실 우리 둘은 꽤 비슷한 것 같아. 몬드에서 우린 둘 다 「외부인」이잖아. 다만 넌 모두의 사랑을 받지만, 난 항상 견제를 받는 경계대상이지"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "우리에 대해·복수",
      "text": "앞으로 우린 계속 원한이 쌓일 테니까 나중에 한꺼번에 청산하자고. 그래야 더 편할걸? 10년 후가 될지, 20년 후가 될지…. 걱정 마, 난 절대 잊지 않아. 그러니까 그전까지 무사해야 돼"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「죄인의 후예」. 이 호칭은 정말 별로야. 나만의 방식으로 복수를 해나가야만 이 호칭에서 완전히 벗어날 수 있어. 복수를 하려면 힘이 필요해. 그러니 「신의 눈」을 얻은 건 어쩌면 당연한 일이겠지"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기·골피리",
      "text": "내 골피리는 다양한 소리로 적을 미혹시킬 수 있어. 아주 유용하지. 이걸로 항상 파도 소리를 연주해서 「파도 기사」란 호칭을 얻게 된 거야. 근데 골피리가 리월에서 비롯됐다는 사실에 관심을 두는 사람은 아무도 없어. 몬드에 배척당한 죄인이 모두에게 잊혀진 리월 사람을 스승으로 모신 거에 대해서도 신경 안 쓰고"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "하고 싶은 이야기·술",
      "text": "일반적으로 오래 묵은 민들레주는 은잔에 마셔야 해. 12분 동안 디캔팅을 한 뒤에 얼음을 넣는데, 술은 얼음이 6할 정도 잠기게 넣는 게 좋아. 근데 너무 복잡하잖아, 난 별로야"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "난 서리꽃이 좋아. 근데 왜 이렇게 희귀한 건지. 서리꽃 가루는 골피리 소리를 더 맑게 만드는 효과가 있어"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "엠버에 대해…",
      "text": "엠버는 늘 제멋대로야. 내가 기사단에 들어온 첫날, 숙소를 청소해주고 여기저기 구경시켜준 다음, 귀찮은 일들까지 다 처리해주더라고. 날 꼭 동생 취급하는 것 같았다니까! 그게 말이 돼?! 이 원한은 절대 잊지 않겠어!"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "진에 대해…",
      "text": "단장 대행? 그쪽 가문과 내 가문은 숙적이야. 근데 개인적으론 공사가 분명한 분이지. 내 실력을 알아보고 날 기사단에 가입시켰지. 이런저런 기회도 많이 줬고. 그래서 복수할 때 좀 봐줄까 해"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "리사에 대해…",
      "text": "정말 성가신 여자야. 머릿속에 수천 권의 책이 들어 있을걸? 아니, 수만 권일지도. 그녀는 로렌스 가문의 흑역사를 줄줄이 꿰고 있고 사건의 날짜까지 정확히 기억해. 그녀라면 내가 찾고 있는 사람의 행방을 추적할 수 있겠지만, 나도 자존심이 있지"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "바바라에 대해…",
      "text": "대체 무슨 비결이 있길래 사람들이 그녀를 그렇게 좋아할까? 나도 좀 배울 수 있으면… 아냐, 됐어. 「아이돌」이랑 「죄인의 후예」는 누가 봐도 안 어울리잖아"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "바르카에 대해…",
      "text": "대단장 말인가? 그는 성격이 시원시원하고 사소한 일이나 소문 따위를 신경 쓰지 않아. 전반적으로 좋은 사람이지. 그와의 대결에서 비긴 적이 있는데, 그 여유로운 표정과 산만한 태도는 분명 일부러 봐준 게 틀림없어! 이런 모욕을 주다니! 이 원한, 절대 잊지 않겠어!"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "벤티에 대해…",
      "text": "그 음유시인은 로렌스 가문의 이야기를 경쾌한 노래로 만들어서 듣도 보도 못한 말투로 막 조롱하더라니까. 나까지 웃음이 터졌지 뭐야…. 이 원한, 기억해두겠어"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "레이저에 대해…",
      "text": "예절을 지키거나 다른 사람의 시선을 신경 쓸 필요도 없고, 짊어져야 할 가문의 책임도 없으니…. 그의 삶은 꽤나 편하겠어"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "설탕에 대해…",
      "text": "그 연금술사가 심연 교단 영지에 잠입할 때 유용할 거라면서 어떤 장치를 준 적이 있어. 근데 그게 큰 소리를 내며 터져버리는 바람에 츄츄 폭도 30마리한테 둘러싸였지…. 나중에 따지러 갔더니 너무 당황하고 미안해하기에 결국 별말 못했어. 벽에 실패 기록 같은 것도 붙어 있더라고…. 다친 덴 없었지만 먼지를 뒤집어써서 좀 민망했을 뿐이야"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "다이루크에 대해…",
      "text": "내가 기사단의 몇몇 사람이랑 안 맞는 것처럼, 그도 기사단을 싫어하니까 따져보면 우린 같은 편이야. 근데 사람을 거들떠보지도 않는 그의 태도는 단장 대행보다도 성가실 것 같아서 별로 친하게 지내고 싶진 않아"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "디오나에 대해…",
      "text": "정말 신기한 바텐더야. 나랑 좀 잘 통하는 것 같아. 그녀는 몬드 주류업을 망치기 위해 술집에서 일하고, 난 기사단에 복수하기 위해 기사가 됐잖아. 세상에 이런 우연이"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "연비에 대해·만남…",
      "text": "말하자면 길어…. 예전에 심연 교단의 위험 물품을 추적할 때 우연히 연비를 구해줬거든. 그 당시 교단의 위험 물품은 일반 화물로 위장된 채로 돈만 항구에서 리월항으로 옮겨가던 중이었어. 마침 화물선의 고문이었던 연비는 뭔가 잘못됐다는 걸 알아채고 멋대로 조사를 진행하다가 화를 자초한 거지. 우리가 조금이라도 늦게 도착했다면 큰일 날 뻔했어"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "연비에 대해·관점…",
      "text": "그 뒤로도 우린 서로 연락하면서 지내. 똑똑하고 영리한 성격이 꽤 맘에 들더라고. 그녀는 규칙을 잘 지키지만, 융통성도 있는 편이야. 기사단의 몇몇 사람들이 좀 배웠으면 좋겠어. 게다가 연비의 실력이라면 그 사람을 찾아줄 수 있을 거야. 나한테 신세 진 걸 갚는 셈인 거지"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "미카에 대해·소통",
      "text": "미카가 유격대에 처음 왔을 땐 그전에 있던 몇몇 사람들처럼 얼마 못 버티고 나갈 줄 알았어. 그런데 묵묵히 버티면서 임무를 아주 훌륭하게 완수했지. 게다가 자진해서 심부름 같은 잡일까지 도맡아서 하고 나와 다른 사람들이 소통하는 것도 도와줬어. 흥, 자꾸 날 챙겨주려 하다니… 대체 누굴 보고 배운 건지"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "미카에 대해·복귀",
      "text": "미카가 원정대에서 돌아왔어. 성격은 그대론데 전보다 많이 강해졌더라고. 대단장이 단원들 훈련을 소홀히 하지 않은 모양이야. 음? 미카 본인은 모르는 것 같다고? 그야 워낙 둔하니까… 아니면 겸손하다고 하는 게 맞나? 내 대원이니, 그런 건 딱 봐도 알 수 있거든"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "유라에 대해 알기·첫 번째",
      "text": "죄인의 일생이 궁금할 게 뭐 있어? 어차피 무슨 말이나 행동을 해도 잠재적인 위험인물로 볼 건데. 그래도 지금은 좀 나은 편이야. 기사단에 들어오기 전엔 디어 헌터랑 몬드 잡화점 모두 날 손님으로 안 받아줬어. 야외에서 사냥하고 불을 피워 끼니를 해결했다고"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "유라에 대해 알기·두 번째",
      "text": "나한테 굽신거리고 언행을 조심하면 용서받을 수 있을지도 모른다고 말했던 자들이 있어. 하지만 그렇게 말할 수 있는 건 그들이 진짜 「죄인」이 아니기 때문이지. 「죄인」은 쉽게 용서받을 수 없어. 그러니 차라리 시원하게 복수하고 정정당당하게 싸우는 게 나아. 나한테 이기면 시키는 대로 하겠지만, 나한테 지면 내 요구를 들어주는 거야. 예를 들어… 음, 적어도 나한테 물건은 팔아줘야지?"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "유라에 대해 알기·세 번째",
      "text": "페보니우스 기사단은 생각보다 괜찮은 곳이더라고. 적어도 사람을 볼 때 「신분」보단 「재능」을 중시하니까. 예전에 기사단 정예들과 겨뤘을 때 실력으로 그들을 제압했더니 입단 초청을 받았어. 기사단 내부에서 일하면 복수하기도 편하고 살기도 훨씬 편해지는데 마다할 이유가 없잖아?"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "유라에 대해 알기·네 번째",
      "text": "로렌스 가문이 오명을 뒤집어쓴 건 타락한 이후야. 그전에는 아주 명예로운 가문이었지. 근데 아쉽게도 그때의 역사는 전부 잊혀졌어. 대단장은 내가 기사로서 잘하고 있다면서 과거 로렌스 영광을 되찾은 건 아니지만, 최소한 단편적인 관점을 깨트렸다고 했어. 나도 같은 생각이야"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "유라에 대해 알기·다섯 번째",
      "text": "만약 가문 사람들이 잘못을 깨우치지 못하고 심지어 몬드를 계속 해롭게 한다면, 난 그들과 로렌스라는 성을 직접 없애버리겠지…. 아마 이게 내가 유일하게 이행하고 싶은 「가문의 책임」이겠지. 그리고 성을 다른 걸로 바꾸지 뭐. 네가 지어줘도 되고!"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "유라의 취미…",
      "text": "시원한 건 다 좋아. 차가운 술과 음료를 맘껏 마신 뒤 협곡 입구에 앉아 광풍을 느끼거나, 드래곤 스파인 밑의 호수에 뛰어들어 목욕하는 것들 말이야. 호숫가에 있으면 내가 얼음물 속으로 끌어당길지도 몰라~"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "유라의 고민…",
      "text": "가끔 술집에 사람이 많아서 자리가 없을 때 합석하라고 하는데, 내가 로렌스 가문 사람이라는 걸 알고는 허세 부리거나 도발하고 은근슬쩍 딴지를 거는 놈들이 하나둘씩 나타난다니까. 이봐, 조용히 술 좀 마시자고"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "난 간식 만드는 걸 좋아해. 간식이라고 꼭 달달한 디저트는 아니야. 차갑게 만든 토마토 고기 오믈렛은 아이스 라즈베리 민트주랑 아주 잘 어울려. 중요한 건 내가 만든 간식을 먹고 행복해하는 사람이 있다는 거지"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "걸쭉한 수프는 진짜 내 취향이 아니야. 식감이 텁텁하고 포만감이 심해서 운동과 전투에 방해되거든. 게다가 싸가지고 다니기도 불편하고. 그야말로 내 천적이지"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "음? 나한테 도전하는 거야? 받아들이지"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "그럭저럭 먹을 만 해… 너도 먹어보지 그래?"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "이봐 너, 나한테 복수하는 거야?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘은 기념할 만한 날이네? 하지만 넌 나이만 성장한 게 아니야. 특제 골피리를 줄 테니까 나한테 연주하는 법을 배워 봐. 내가 너한테 복수하게 될 그 날, 이 골피리로 날 방해하고 시간을 끌면서 발악해. 그럼 더 재미있겠지"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "전투 기술이 많이 늘었어, 근데 아직 좋아하긴 일러. 기사단엔 부지런한 놈들이 많으니까. 그들을 물리치고 복수를 마치려면, 그들의 실력을 초월해야 돼"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "좋아. 지금의 내 실력이면 단장 대행과 겨뤄도 문제없겠어!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "이상하네…? 너와 동행할 땐 힘이 특히 더 빨리 강해지는 것 같아. 너와 원수가 된 건 좋은 선택이었던 것 같아. 네 옆에 딱 달라붙어서 놓아주지 말아야겠어"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "좋아! 이제 이 견고한 얼음의 힘을 완전히 지배했어. 단장 대행이 아니라 대단장조차도 날 못 막을걸! 시간이 없어. 이제 작전을 짜고 총공격을 할 수 있겠군. 페보니우스 기사단 다음은 바로 너니까 도망칠 생각 말고 얌전히 내 옆에서 지켜보기나 하라고"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "용서를 빌어라"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "얼어붙은 서리!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "가루가 되어라!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "판결한다!"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "부서져라!"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "눈에는 눈!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "요동치는 얼음 파도!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "원한은 서리로 갚겠다!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "견고한 얼음은 원한을 끊어내지!"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "서둘러"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "하늘에서의 시야는 더 끝내주지"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "새로운 발견이야"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "음, 다 쓸만한 것들이네"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "죄인도 운이 좋을 때가 있구나…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "불리하군…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "이제부터 시작이야…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "제법인데!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "나한테 맡기고 물러서!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "내 말대로 어서 멀리 떨어져!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "처참하군…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "아직… 버틸 수 있어…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "죄인의 결말인가…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "나쁘지 않군!"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "꽤 하는데?"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "유격대가 먼저 움직이도록"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "내가 선봉에 설게"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "작전 계획은 다 정해졌어?"
    }
  ]
}