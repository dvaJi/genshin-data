  "voices": [
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "불꽃놀이가 보고 싶어?"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "기폭제 점화!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "불조심해~"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "축제 재현!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "금붕어가 왔어!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "폭죽이 왔다구!"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "바람의 날개 사용·첫 번째",
      "text": "높이 올라가라——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "폭죽 재료가 있을까?"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "안에 뭐가 있을까?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "내가 열래!"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "느낌이 안 좋아!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "망신이 따로 없네…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "조심해야겠어"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내가 지원할게!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "걱정하지 마. 내가 있잖아"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "방심했다가 그만…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "좀 심했네…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "축제는… 끝났어"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "살살해"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "이건 무효야!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "축제를 열고 싶니?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "같이 놀자!"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "같이 다닐 파트너가 늘었어!"
    },
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "「나가노하라」에 온 걸 환영해! 난 요이미야라고해. 필요한 게 있으면 나한테 말해!\\n음… 「튀김 꼬치」랑 「새알말이」… 아니, 아니! 여긴 식당이 아니라 폭죽가게라고! 반짝반짝하고 팡팡 터지는 폭죽 말이야~"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·폭죽",
      "text": "폭죽이 터지는 건 찰나지만, 마음은 오래가지~"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·이야기",
      "text": "심심하면 내가 이야기 들려줄게!"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·금붕어",
      "text": "금붕어 키워 본 적 있어? 말도 잘 듣고 귀여워"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "으악, 폭죽 다 젖겠다! 피할 곳을 찾아야 해. 아, 어, 이러다 늦겠어!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "하하, 내가 만든 눈덩이를 봐. 슈욱——"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "몸이 따끈따끈해서 편안해. 날아오를 것 같아"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "바람이 너무 세—— 소리가 바람에 되돌아와——!"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "음… 하아—— 좋은 아침. 역시 아침 공기가 가장 상쾌하지. 몇 번 들이마시면 똑똑해진다구"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "점심 먹을 시간이야. 어… 오늘은 달걀이 쌍란이네. 헤헤, 운이 좋은걸"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "지금이 딱 폭죽을 시험하기 좋은 때야. 하늘에서든 땅에서든 예쁘게 터지거든… 헤헤, 농담이야. 조심할게"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "퀴즈 타임——! 종일 불꽃놀이를 하고 난 다음에 해야 할 일은? 헤헤, 정답은 당연히 꿈에서 불꽃을 터트려야지! 잘 자고 내일 봐!"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "요이미야 자신에 대해·가정사",
      "text": "우리 아버지는 귀가 안 좋으셔서, 내가 어렸을 때 무슨 말을 해도 웃고 계셨어. 그래서 난 내 말이 맞는 줄 알고 계속 말했거든. 난 계속 말하고, 아버지는 계속 웃으시고. 나중에서야 알았어. 귀가 안 좋으셔서 그랬다는걸. 그래도… 아버지가 즐거우시다면 난 얘기를 계속할 거야"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "요이미야 자신에 대해·대화",
      "text": "난 「입은 재앙의 근원」 같은 말은 걱정하지 않아. 말에 담긴 감정은 거짓이 아니니까. 말실수로 오해를 받아도, 더 많은 말로 오해를 풀면 돼. 아무 말도 하지 않으면 상대는 내 마음을 모르잖아. 친해질 수도 없고"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·가위바위보",
      "text": "가위바위보 하자! 자, 가위, 바위, 보! 좋았어. 내가 이겼다! 내가 이겼어! …응? 아닌데, 안 바꿨는데. 바꿀 리가 없잖아"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·동행",
      "text": "무슨 일을 하는지는 상관없어. 내가 신경 쓰는 건 같이 일할 사람이야. 예를 들어 너랑 함께라면 경치를 봐도, 제기를 차도 즐거워. 너랑은 아무리 얘기해도 질리지 않거든"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "이건 너한테만 알려주는 건데, 처음 「신의 눈」을 손에 넣었을 때, 이걸 부싯돌로 썼어. 폭죽에 불도 붙이고 물도 끓였지. 집에 오면 창고에 팽개쳐놨어. 결국 아버지께서 이건 아주 중요한 물건이니 잘 보관해야 한다고 말해주시더라고. 하하, 신이 다시 가져가지 않아서 다행이야"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기·해등절",
      "text": "그거 알아? 리월 해등절에 쓰는 폭죽은 대부분 우리 집에서 만든 거야. 주문대로 제작해서 북두 언니가 배편으로 리월에 배달하지. 쇄국령 때문에 위법이긴 한데… 폭죽 없는 축제는 팥소 없는 찐빵이잖아"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "하고 싶은 이야기·순환",
      "text": "「폭죽은 하늘에 빛을 남기고 사라져. 그 빛은 빗방울과 눈송이로 변해서 다시 땅을 적시고 사람들을 키워내지. 언젠가 하늘로 올라가 또 한 번 화려하게 터지는 순간을 위해서 말이야.」 이게 아버지가 들려준 그 많은 이야기 중 내가 가장 좋아하는 거야"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "하고 싶은 이야기·빛나는 반점",
      "text": "어렸을 때 바닥에 비치는 빛을 밟아본 적 있어? 나뭇잎 사이로 바닥에 내리쬐는 빛 말이야. 밟으면 없어질 줄 알았는데, 발을 비추더라. 그래서 계속 밟으면서 없애려고 했는데 실패했어… 그땐 분해서 돌 위에 앉아 투덜거렸지. 「어휴. 세상에는 밟을 수 없는 것도 있구나…」하고"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "어느 여름 축제 때, 애들 옆에서 금붕어 잡는 걸 구경했었어. 그러다가 생각했지. 물속에서 터지는 폭죽을 만들 수 없을까? 그래서 「금붕어 폭죽」이 탄생한 거야! 물에서 이리저리 헤엄치면서 다채로운 빛을 내고, 방울도 내뿜어. 신기하지! 나도 성공할 줄 몰랐는데, 세상엔 신기한 일이 많더라구"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "북두에 대해…",
      "text": "이나즈마를 쇄국한 후로, 폭죽은 다 북두 언니가 대신 운반해. 언니를 위해서 서프라이즈로 거대한 선박형 폭죽을 준비했어. 「남십자함대」가 떠나려고 준비할 때 폭죽이 선원들 앞에서 튀어나가 하늘로 솟구쳤지. 다들 깜짝 놀랐는데, 북두 언니는 서프라이즈는 놀래야 제맛이라고 하면서 좋은 아이디어라고 했어. 하하하"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "라이덴 쇼군에 대해…",
      "text": "폭죽은 쇼군님이 추구하는 「영원」과 거리가 가장 먼 것이야. 찰나의 빛은 이나즈마에 무의미하다고 여기실 거야. 휴. 「영원」을 관장하는 사람은 이해하기 어렵겠지. 우린 모두 「찰나의 사람」이니까 순간의 아름다움을 기념할 필요가 있어"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "카미사토 아야카에 대해·진지",
      "text": "일 때문에 그녀는 우리 집과 자주 협업하곤 해. 다른 두 봉행과는 다르게 그녀는 내 말에 귀찮아하는 기색 없이 끝까지 들어주고 진지하게 대답해줘. 「대갓집 규수」라는 단어는 그녀를 위해 만들어진 게 아닐까"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "카미사토 아야카에 대해·탕",
      "text": "한 번은 여름 축제 일로 늦게까지 얘기를 나눠서 우리 둘 다 지친 상태였어. 그래서 탕에서 피로를 푸는 게 어떠냐고 권했는데, 「탕」이 많은 사람과 함께 들어가는 탕이라는 걸 알고 얼굴이 빨개지더라. 그제야 알았어. 부잣집 아가씨는 대중탕을 이용할 수 없다는 걸"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "토마에 대해…",
      "text": "그는 말솜씨가 좋아. 그의 말에는 주관이 있어. 아무 관련 없는 말처럼 보이지만, 돌고 돌아서 교묘하게 자신이 원하는 대로 이끌더라니까. 음… 어쨌든 나랑은 완전히 다른 스타일이지만, 해결할 수 없는 사건이 생기면 난 그 사람한테 부탁해"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "야에 미코에 대해…",
      "text": "신사 축제 때 아야카가 궁사님을 위해서 폭죽을 준비해줄 수 있냐고 했어. 근데… 궁사님은 축제에 나가서 처음부터 끝까지 신사에 앉아 계시잖아? 그래서 축제 때 대체 어떻게 폭죽을 터트리나 하고 계속 바라봤어. 기다리고 기다리던 끝에 아야카가 왔는데, 궁사님이 아주 만족하셨다는 거야… 엥? 이미 터트렸나? 설마 안에 앉아있는 사람은 궁사님이 아닌가?"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "아라타키 이토에 대해·대결",
      "text": "아. 걘 무섭게 생겼는데도 애들한테 인기 좋아. 근데 승부욕이 강해서 같이 애들이랑 놀다 보면 어느새 우리 둘이 대결하고 있더라니까. 라멘 국물 원샷이나 무표정으로 매실장아찌 먹기 같은 거 말야. 애들은 누가 이길지 내기도 하고 응원도 해줘. 아, 그럼 질 수 없잖아. 안 그래?"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "아라타키 이토에 대해·파벌",
      "text": "「아라타키파」? 엥?! 한가한 백수 아니었어?"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "카에데하라 카즈하에 대해…",
      "text": "나처럼 걱정거리 없는 사람은 할 말 있으면 대놓고 말해. 근데 걱정거리가 있는 사람들은 종종 고시나 경치, 그러니까 꽃이랑 새, 바람과 달로 비유해 말하지. 눈앞의 현실은 말하지 않아. 그도 사연이 있는 사람이겠지. 이해해"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "쿠죠 사라에 대해…",
      "text": "치안이랑 소방 문제 때문에 텐료 봉행의 영지에 잡혀가서 교육을 받았어. 그중에서 아마 쿠죠 사라가 제일 말이 통하는 사람일 거야. 적어도 그녀는 모든 정황을 파악하기 전까지는 지레짐작하지 않거든. 만약 내가 옳다면 그녀도 내 생각을 인정해 줄 거고, 내가 틀렸다면… 헤헤. 그럼 토마한테 사과해달라고 부탁해야겠지!"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "사유에 대해…",
      "text": "만약 그녀를 보면 나한테 꼭 알려줘야 해! 축제에 데려가서 친구들을 많이 소개해주고 싶거든. 평소에 기운 없어 보이던데, 같이 놀 사람이 생기면 점점 나아지겠지?"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "클레에 대해…",
      "text": "몬드에 폭탄 제조를 잘하는 아이가 있다고? 사실 폭탄이랑 폭죽은 별 차이 없어. 그러니까, 이쪽 분야의 천재라는 거네? 한번 보고 싶다. 휴, 근데… 애들한테 폭탄은 위험하지 않아? 몬드 사람은 걱정도 안 하나?"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "키라라에 대해…",
      "text": "「코마니야」의 그 배달부 말이구나? 손발이 참 빠른 사람이야. 폭죽 만들 때 색깔을 결정하는 재료는 금방 다 쓰는데 그 사람이 항상 물건을 빠르게 가져다줘서 다행이야. 한번은 고맙단 의미로 폭죽을 줬는데, 쓰질 못하더라고. 폭죽 소리에 깜짝 놀란 적이 있다던가? 하하, 그래서 멀리 떨어져 있으라고 하고 내가 터뜨렸지"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "요이미야에 대해 알기·첫 번째",
      "text": "내 이야기가 듣고 싶다고? 좋아 좋아. 이쪽으로 앉아. 제일 자랑스러운 「나가노하라」 일가 이야기를 들려줄게! 모처럼 진지한 이야기라구?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "요이미야에 대해 알기·두 번째",
      "text": "우리 집에는 유구한 전통이 있어. 바로 폭죽을 주문하는 손님에게 쪽지를 하나 드리는 거야. 쪽지에는 우리 가족만 알아볼 수 있게 폭죽 제조법이 자세하게 적혀있어. 십 년 뒤든 백 년 뒤든, 손님이 쪽지를 가져오기만 한다면 그때와 똑같은 폭죽을 만들 수 있어"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "요이미야에 대해 알기·세 번째",
      "text": "가장 아름다운 순간을 가장 아름다운 폭죽으로 기리는 거지. 그 순간의 감정을 폭죽이라는 매개체로 남기는 거야. 쪽지는 열쇠와 같아서, 과거를 기념하고 싶은 사람이 문을 열어주길 기다려. 「나가노하라」의 폭죽 장인의 일은 바로 사람들을 위해 문을 지키는 거야"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "요이미야에 대해 알기·네 번째",
      "text": "여름 축제에선 매순간마다 감동적인 이야기가 탄생해. 불꽃놀이에서 만난 사람들은 점점 성장하고 성숙해지고, 늙어가. 그때와 같은 폭죽을 터트린다면, 하늘에는 그때의 하늘이 떠오르는 거야… 폭죽은 영원하지 않지. 하지만 폭죽 뒤에 숨겨진 아름다운 감정들은, 이나즈마와 함께 영원을 향해 간다고 생각해"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "요이미야에 대해 알기·다섯 번째",
      "text": "마지막 이야기는 하지 않을게. 너랑 같이 조용히 폭죽을 보면서, 오늘 밤의 아름다운 경치랑 네가 하고 싶은 얘기를 다 기록하고 싶어. 오해하지 마. 끝이란 뜻이 아니야. 우리의 「이야기」는 지금부터 시작이야"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "요이미야의 취미·놀기",
      "text": "폭죽! 아, 이건 포함 안 되나? 그럼, 음… 어려운 질문이네. 난 이웃이랑 수다 떠는 것도, 아이들이랑 여름 축제를 거니는 것도, 수영도 야생 열매를 따는 것도 다 좋은데. 특별히 하나만 고르라고 하면… 아, 알겠다! 내가 제일 좋아하는 건 사람들이랑 같이 노는 거야!"
    },
    {
      "id": "6006",
      "type": 1,
      "title": "요이미야의 취미·흉내",
      "text": "꼬륵 꼬륵 꼬르륵. 헤헤! 페이몬이 사라지는 걸 따라 했어!"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "요이미야의 고민…",
      "text": "오랫동안 봤던 연재소설이 드디어 완결이야. 근데 여주인공이 기억을 잃어서 결혼식도 못 했어… 너무 슬프다. 어떻게 이럴 수가 있지…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "난 밥보단 디저트가 좋아. 축제 때마다 가게를 돌면서 목 끝까지 차오를 만큼 먹거든. 아, 혹시 디저트 잘 만들어? 내가 만든 경단이랑 바꾸자. 큰 거 다 너 줄게"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "우유야. 우유를 먹으면 뱃속에서 폭죽이 터지는 것처럼 난리야. 하지만 우유를 넣은 음식이나 디저트는 괜찮아. 왠지는 나도 모르겠네… 뱃속 선령의 입맛이 좀 까다로운가?"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "와! 너 디저트 만드는 솜씨가 보통이 아니구나! 축제에서 팔면 분명 제일 인기 많을 거야!"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "맛있는 걸 먹으면 기운이 나고, 기운이 나면 얘기하고 싶어지지. 응, 내가 이야기 하나 들려줄게!"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "이런, 떠도는 정령이 배 속을 마구 돌아다니는 것 같아… 대체 왜지…?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일은 혼자만의 날이 아니야. 너에게 케이크를 선물하고, 촛불을 붙여주고, 박수를 쳐주면서 축하하는 사람은 네가 세상에 태어나줘서 진심으로 고맙다고 생각해. 그러니까 시끌벅적하게 보내는 게 좋다구. 모든 사람이 너의 탄생을 감사할 수 있게! 그럼, 생일 축하해! 준비됐어? 폭죽 터트린다!"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "더욱 높게 올려서, 더욱 크게 터트리기!"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "후후, 잘 봐! 화살로 폭죽을 쏘아 올릴 테니까!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "너한테 전투 기술을 이렇게 많이 배웠으니까, 폭죽 장인도 하고 알바로 모험가도 해볼까… 아니면 「영웅」도 나쁘지 않은데?"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "「『영웅 모드』의 요이미야 등장! 악령은 물렀거라! 정의는 반드시 승리한다!」\\n네가 가르쳐준 새로운 힘을 애들한테 이렇게 소개했어. 괜찮지? 멋지지? 헤헤. 만약 누가 괴롭히면 말해. 요이미야가 혼내줄 테니까!"
    }
