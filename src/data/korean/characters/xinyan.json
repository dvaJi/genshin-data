  "outfits": [
    {
      "id": 204400,
      "name": "열렬한 영혼",
      "description": "신염의 코스튬. 스터드 장식이 특징인 로커의 복장이다",
      "isDefault": true,
      "characterName": "신염",
      "characterId": 10000044,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xinyan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "난 신염이야. 리월항의 유일한 로커지. 요즘 순회공연 좀 다녀볼까 하는데, 목적지는…. 넌 여러 곳을 돌아다니는 여행자지? 어디든 좋으니 나도 좀 끼워줘라!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·기세",
      "text": "로큰롤에 열정은 필수야——이봐, 뭘 멍하니 있는 거야, 움직이라고!"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·신곡",
      "text": "아니면 내가 새로 쓴 곡 연주해줄까?"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·주목",
      "text": "저길 봐! 엄청 로큰롤한 게 있어!"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "비가 많이 오네…. 내 악기가 젖으면 안 되는데"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "당분간 비가 계속 내릴 것 같아…. 흠, 그래도 공연을 미룰 순 없지!"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "흐음… 이런 날씨엔 관중들을 어떻게 모으지? 그래! 「눈보라 속 극한의 인내심으로 로큰롤에 도전」 같은 건 어때?!"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "으악, 빨리 피해야겠어. 안 그럼 헤어 스타일이 다 망가질 거야!"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침, 방금 목 좀 풀어봤는데 오늘도 상태가 좋아"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "끝났다, 끝났어. 하암——별일 없으면 잠깐 좀 잘래…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "곧 공연 시작이야. 너도 같이 놀아볼래?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "알겠어. 먼저 가서 자. 나? 난 악기도 관리해야 하고 편곡도 하고 싶은데. 헤헤, 막 무대에서 내려오면 피곤해도 잠이 안 와"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "신염 자신에 대해·흉악",
      "text": "넌 내가 무섭지 않다고? 허, 어떤 사람들은 내 눈빛이 날카롭고, 옷과 말투도 단정치 못하다면서 날 보면 멀찌감치 도망가버려. 휴…스타일이 다른 것뿐이지, 내가 무슨 괴물도 아닌데 말이야…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "신염 자신에 대해·록",
      "text": "로큰롤은 폰타인에서 건너온 신문물이야. 음, 하지만 리월에선 인기가 없어. 보통 시끄럽다고 싫어하더라구. 그래서 내 노랠 들으러 와주는 팬들이 더 고마워. 하하"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·관람",
      "text": "내 공연 보러 온 거야? 하하, 앞으로 와! 앞쪽이 더 좋아. 흠흠, 그럼 지금부터 리월항의 하나뿐인 로큰롤 공연을 시작합니다!"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·의기투합",
      "text": "너랑은 왜 이렇게 말이 잘 통하나 했더니 넌 이 세계 사람이 아니었구나. 그래서 이 세계의 규율을 신경 쓸 필요가 없었던 거야——인생이 그래야지! 허례허식 따위 개나 주라고 해. 구속 없이, 자유롭게!"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "우리에 대해·초대",
      "text": "난 내 로큰롤을 더 풍부하게 만들고 싶어. 너 리듬감 좋던데, 드럼 좀 쳐볼래? 안 해봤다고? 에이, 주눅들 필요 없어. 자신감이 제일 중요해! 한번 해봐, 분명 재능 있을 거야!"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」의 불을 로큰롤 반주로 사용하는 사람은 아마 티바트 대륙에서 나밖에 없을 거야. 존귀한 힘을 이런 데 썼다고 비난하는 사람들도 있지만…신이 나한테 「신의 눈」을 주셨다는 건, 내가 사용하는 방법을 인정해주신 거 아닐까?"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기·이름 짓기",
      "text": "이 악기는 내가 직접 만든 거야. 원래는 폰타인의 록 악기를 따라 만든 건데, 만들다 보니 완전 다른 게 됐지 뭐야. 듣기 좋으면서도 기억하기 쉬운 이름을 지어주고 싶어. 「염금」, 「쇄옥」, 「정산」? 뭔가 입에 착 안 붙는데…. 혹시 좋은 아이디어 없어?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "하고 싶은 이야기·연악",
      "text": "「연악」이라고 들어봤어? 돈 많은 사람들이 연회에서 듣는 음악인데, 이 사람이 얼마나 대단한지 또 저 사람이 얼마나 위대한지에 대해 노래해…. 음악을 그렇게 사용하다니, 쳇, 전혀 로큰롤하지 않다고"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "내가 제일 좋아하는 무대의상은 내가 직접 「예상꽃」으로 짠 거야. 너도 그 꽃 본 적 있지? 빨갛고 정열적이잖아! 게다가 내 로큰롤하고도 잘 어울린다구!"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "향릉에 대해…",
      "text": "난 「만민당」에 자주 야식을 먹으러 가. 향릉이 바쁘지 않으면 밤늦게까지 수다를 떨어. 응? 뭘 시키냐고? 음… 사실 향릉이 만드는 건 다 먹어, 하하. 매번 달라. 맛도 천차만별이고. 향릉은 요리계의 「로큰롤 스타」라고 할 수 있지!"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "종려에 대해…",
      "text": "아무도 내 로큰롤을 들어주지 않던 어느 날, 그가 날 찾아와서 그가 있는 곳에서 연주해보지 않겠냐는 거야. 합이 맞으면 전속 가수가 될 수 있다면서 말이지. 드디어 내 음악을 알아주는 사람이 있다는 생각에 설레더라구! 바로 오케이하고 따라갔는데, 그제서야 그 사람이 「왕생당」의 객경이란 걸 알았어…. 너무 안 어울리잖아. 정말 괴짜 같은 사람이야"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "응광에 대해…",
      "text": "천암군 알지? 예전에 그 녀석들이 날 엄청 방해했었어. 여기에 무대를 세우면 안 된다, 저기도 안 된다. 귀찮아 죽는 줄 알았다니깐! 흠흠, 그러다 내가 총무부에 신고하니까 그 「천권성」이 리월의 그…뭐더라, 아무튼 무슨 규율을 개정했는데 공연 전용 장소를 정했다더라고. 허가도 받아야 된다던데. 휴…여전히 귀찮긴 하지만 그래도 예전처럼 이리저리 쫓겨나지 않아도 되니깐"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "백출에 대해…",
      "text": "백출 선생의 목 관리 처방전은 효과가 최고야. 한번은 고마워서 즉흥적으로 로큰롤을 불렀는데…백출 선생이 기르던 그 뱀이 기절해 버리더라고. 그때부터 그 뱀은 나만 보면 백출 선생 옷깃으로 숨어. 하하하, 뱀이 진동에 예민한 동물이란 걸 그때 알았어"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "북두에 대해…",
      "text": "아, 그녀는 시원시원하고 통이 커서 말이 잘 통해. 「사조성」호에서 겪은 이야기들은 너무 멋있어서 내 로큰롤에 지대한 영감을 주지! 헤헤, 그들을 위해 노래도 따로 만들어줬어. 이제 내가 첫 소절만 불러도 선원들이 다 따라 부른다니까. 이러다 그냥 뱃노래가 되겠어!"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "중운에 대해…",
      "text": "걘 얌전하고 내성적인 것 같지만 진짜 재밌어! 한번은 공연하는데 친구한테 불려 나온 것 같더라고. 나한테 무슨 말을 하려던 거 같았는데, 무대 소리가 너무 커서 제대로 듣지도 못했어. 근데 어느샌가 쏜살같이 무대로 올라오더니 나랑 같이 노랠 부르는 거야. 그것도 엄청 로큰롤답게. 역시 「사람은 외모로 판단하면 안 된다」니까!"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "호두에 대해…",
      "text": "호두는 왕생당의 당주인데도 언제나 즐거워 보여. 무슨 생각을 하는 건지 도통 모르겠다니까. 거리에서 마주치면 나한테 거리낌 없이 인사하면서 「불장난을 좋아하는 사람은 장사에 도움이 돼」라나 뭐라나. 음… 조, 좀 이상해"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "운근에 대해…",
      "text": "이건 비밀이니까 여기저기 말하고 다니면 안 돼. 그 사람은 로큰롤을 엄청 좋아해. 아무리 바빠도 일주일에 세 번 이상은 내 노랠 들으러 온다니까. 「화유다관」 극단 최고의 배우는 취미도 고상할 줄 알았는데, 평소에 쌓인 게 많았나 봐, 하하하"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "가명에 대해…",
      "text": "그 애가 처음 나 보고 「로큰롤 피버」라고 했을 때 난 내 이마를 짚어보곤 아니라고 했어. 근데 계속 「무조건 맞다」는 거야! 그래서 한참 동안 실랑이를 벌였는데, 알고 보니 오해였더라구. 「피버」가 「마니아」라는 뜻으로 쓰인다나? 하하하, 정말 재밌는 친구야. 이 단어를 노래 가사에 넣어야겠어!"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "신염에 대해 알기·첫 번째",
      "text": "나에 대해 알고 싶어? 하하, 사람들은 보통 날 보면 멀찌감치 피하던데 넌 참 이상해. 좋아, 그럼…내 로큰롤부터 알아가 볼래?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "신염에 대해 알기·두 번째",
      "text": "어릴 때, 어른들은 다들 나한테 얌전하게 이거 배워라 저거 배워라 했지만, 성격상 잘 안 되더라고. 항상 꾸중만 들었지. 하지만 로큰롤은 달라. 누가 가르쳐주지 않았는데도 잘했거든. 어른들은 「여자애답지 않다」라고 하는데…. 휴, 이런 걸 고정 관념이라고 하지"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "신염에 대해 알기·세 번째",
      "text": "나 오늘 좀 달라진 거 없어? 사실 널 만나려고 얼굴 마사지도 하고 눈이랑 입 좀 풀어주면서 거울 보고 30분 동안이나 웃는 연습을 했어. 어때? 덜 사나워 보이지?…예전보다 더 사나워 보인다고? 으…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "신염에 대해 알기·네 번째",
      "text": "나랑 같이 악기 연습하느라 수고했어! 곧 점심시간이니까 밥 먹자. 네 몫도 준비했어! 토마토랑 소시지, 계란후라이도 있어…. 뭐? 난 이런 거 못 하게 생겼다고? 야, 얕잡아보지 마! 요리하고 귀여운 포즈를 잡는 것쯤이야, 못, 못할 것도 없지!"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "신염에 대해 알기·다섯 번째",
      "text": "난 로큰롤의 반항 정신이 맘에 들어. 그렇다고 내가 개성 강한 것만 좋아하는 건 아니야. 나도 평범한 생활을 할 줄 안다고. 바느질도 하고, 꽃이나 물고기도 키우고, 아기자기하게 요리도 하고, 뭐든, 그리고…누구든 좋아할 수 있는 거잖아. 안 그래?"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "신염의 취미…",
      "text": "취미는 당연히 로큰롤이지! 뭔가에 완전히 빠져든 적 있어? 가장 좋아하는 것과 하나가 될 땐, 시간이나 공간 따윈 중요치 않아. 맘껏 즐기고 발산하는 거지——맞아맞아! 그런 느낌은 수백 번, 수천 번 느껴도 모자라!"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "신염의 고민…",
      "text": "어린애들이 길에서 나랑 눈이 마주치면 항상 놀라서 울어. 휴, 덜 사납게 보이는 법 어디 없을까? 생각나는 방법은 다 써봤는데 아무런 소용도 없었어…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "리월항 선박 관리국의 점심은 정말 맛있어! 기름기도 적당하고, 고기도 넉넉해. 종류가 다양하진 않지만 아무리 먹어도 질리질 않아! 그러니까 점심 한 끼 먹자고 관리국에서 온종일 일하는 것도 손해는 아니라니까!"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "딱히 편식하는 건 없지만 멀겋고 싱거운 요리는 별로 안 좋아해. 음식은 짜고 매워야 먹을 맛이 나지! 「진주비취백옥탕」 만들 재료밖에 없다면 찍어 먹을 고춧가루라도 준비하겠어!"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "몸이 저절로 리듬 타게 돼. 진짜 멋진데!"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "맛은 괜찮은데 반짝하는 「스파크」가 부족해…. 내가 플레이팅 좀 도와줄까?"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "혹시 내가 소스 좀 만들어서 먹어도 돼?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일 축하해! 봐, 내가 특별히 만든 자수야. 폰타인의 인형 모양을 참고해서 우리 둘을 위에 새겼어. 너무 귀엽지? …왜 그렇게 쳐다봐? 내, 내가 자수 놓는 게 그렇게 이상한 일이야?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "응! 바로 이 리듬이지!"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "열기가 엄청난걸! 다음 공연도 기대해줘!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "이렇게 강력한 힘을 손에 넣었으니 독창적인 로큰롤을 만들어 낼 수 있겠어! 고마워, 신곡은 절대 널 실망시키지 않을 거야!"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "멋져! 네 「열정」이 느껴져! 그럼 내가 너만을 위한 로큰롤을 만들어서 연주해 줄게!"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "리듬을 따라올 수 있겠어?"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "열정이 부족해!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "불꽃 좀 터뜨려볼까!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "로큰롤 타임!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "반항을 위한 노래!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "내 최강음을 들어라!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "축하할 겸 노래 한 곡 연주해볼까!"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "「로큰롤」하네?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "분위기가 달아올랐어!"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "아직 전주밖에 못 했는데…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "음감이 별로야"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "이 정도는 적응됐어"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내 로큰롤로 널 도와줄게"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "이건 로큰롤 하지 않아!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "리듬이… 엉망이야"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "아직… 클라이맥스가 아닌데…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "삑사리를 내면… 안 됐었어"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "이건 로큰롤이 아니야"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "아, 내 악기!"
    },
    {
      "id": "600001",
