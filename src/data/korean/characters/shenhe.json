  "outfits": [
    {
      "id": 206301,
      "name": "차가운 꽃이슬",
      "description": "신학이 받은 해등절 선물. 스승인 류운차풍진군의 주문으로 맞춤 제작된 우아한 예복이다. 양팔의 붉은 끈은 여전하지만, 신학의 마음속 매서운 추위는 이미 옅어지고 있었다",
      "isDefault": false,
      "characterName": "신학",
      "characterId": 10000063,
      "source": [],
      "filename_card": "UI_AvatarIcon_ShenheCostumeDai_Card",
      "filename_icon": "UI_AvatarIcon_ShenheCostumeDai",
      "filename_iconCircle": "UI_AvatarIcon_ShenheCostumeDai_Circle",
      "filename_splash": "UI_Costume_ShenheCostumeDai",
      "filename_sideIcon": "UI_AvatarIcon_Side_ShenheCostumeDai"
    },
    {
      "id": 206300,
      "name": "속세의 굴레",
      "description": "신학의 예복 코스튬. 다년간 신학과 수행을 함께 한 의상이기도 하다. 몸을 둘러싼 붉은 끈은 굴레이자 가호다",
      "isDefault": true,
      "characterName": "신학",
      "characterId": 10000063,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shenhe_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "내 이름은 신학. 고독한 팔자를 타고나 주변 사람을 해치기 쉽지. 선인께선 붉은 끈으로 영혼을 묶어 살심을 다스려야 한다고 당부하셨어. 나와 함께 가는 게 두렵지 않다면… 좋아, 손을 내밀어 봐"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·돌아갈 곳",
      "text": "인간 세상으로 돌아가는 건 사치야. 난 자연에서 동물들과 지내는 게 더 편해"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·비결",
      "text": "올바른 길로 돌아와, 목숨을 보존하리…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·통제불능",
      "text": "무기를 들면 자신을 제어할 수 없고, 붉은 끈의 힘도 한계가 있지. 그래서 사람 많은 곳은 별로야"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "평범한 인간이라면 이럴 때… 우산을 펼치던가?"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "날씨가 좋아지니 나도 기분이 좋군. 아무도 방해하지 않았으면 해…. 방해하는 자가 있다면 전부 없애주지"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "마물을 제자리에 얼어붙게 하면 낙뢰로 순식간에 처리할 수 있어. 옷에 먼지도 안 묻고"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "음… 스승님은 경운봉에서 부는 바람을 가장 좋아하시지"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침, 아침 이슬이 달아. 너도 마실래?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "점심 먹고 졸릴 땐, 가부좌를 틀고 앉아서 명상을 해봐. 효과가 좋아"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "넌 속세의 불빛이 좋아, 아님 산속의 달빛이 좋아?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "안심하고 푹 쉬어. 난 깊게 자는 편이 아니니 기척이 있으면 대신 봐줄게"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "신학 자신에 대해·본능",
      "text": "자신을 갈고닦고 도술을 수련하는 건 모두 나 자신을 지키고자 하는 본능이야. 중생을 구제할 마음은 없다고. 악인을 처벌하는 건 겸사겸사하는 일이니까 고마워할 거 없어"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "신학 자신에 대해·이류",
      "text": "내게 은혜를 입은 사람은 날 선인이라 부르고, 징벌을 받은 사람은 날 마녀라 부르곤 해. 하… 선인이든 마녀든, 평범한 사람이 아닌 이류일 뿐이야…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·태도",
      "text": "난 산에서 잘 안 내려와. 사람들 대하는 법을 잘 모르거든. 마찰이 생기면 무조건 내 방식대로 처리해. 하지만 네가 보기에 부적절하면 알려 줘. 이해가 안 돼도 네 말은 들을게"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·붉은 끈",
      "text": "스승님은 마음을 다스려야 한다고 내게 붉은 끈을 주셨어. 근데 요즘 너랑 같이 수련하면서 비로소 진짜 비결을 깨달았지. 힘도 더 자유자재로 다룰 수 있게 됐고…. 네가 바로 날 붙잡아줄 붉은 끈이야. 이런 내 마음이 느껴진다면, 내 곁에 있어 줘"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "이 반짝이는 돌멩이가 「신의 눈」이라고? 흠… 인연이 있으면 얻는 법이고, 없으면 잃는 법이야. 나중에 인연이 흩어지면 이것도 소멸하겠지"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "악령 퇴치는 쉽지만, 심마를 없애긴 어려워. 본인이 집념을 내려놓지 않는 이상, 선법과 술식으로도 해결할 수 없지"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "왜 「첫눈은 낭만적이다」라고 하는 거지? 저 산봉우리는 항상 눈이 내리는데, 언제가 첫눈인 걸까? 난 잘 모르겠으니, 네가 알려줘"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "응광에 대해…",
      "text": "사람들이 말하는 부와 재산은 내게 아무 소용도 없어. 하지만 그게 응광 손에 들어가면, 칼과 창으로도 처리할 수 없는 문제들이 잘 해결돼. 그녀는 속세의 규칙을 잘 알고 사람의 마음을 꿰뚫어 보지…. 이건 선인도 할 수 없는 일이라고 스승님이 그러셨어. 그래서 응광이 존경스러워"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "북두에 대해…",
      "text": "북두와 있을 땐 예절을 따지지 않아도 되고, 말할 때 숨은 뜻을 파악하지 않아도 돼서 마음이 훨씬 편해. 근데… 늘 옆에 사람들이 있더라고, 배에도 선원이 많다고 들었어…. 사람이 많은 장소는 네가 필요해"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "운근에 대해…",
      "text": "운근이 부르는 건… 「리월극」이란 거지? 꽤 마음에 드는 형식이야. 굳이 만나지 않아도 타인의 업적이나 삶을 알 수 있으니까. 만약 운근이 너에 대한 연극을 한다면, 아주 재밌는 이야기가 될 거야. 기대돼"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "감우에 대해…",
      "text": "그 사람에 대한 건 스승님한테서 많이 들었어…. 생각했던 이미지랑 많이 다른 것 같아. 다른 사람한텐 말 안 할 테니 걱정 마. 그나저나 리월항에서 일하는 게 그렇게 바쁠 줄이야…. 인간 세상에 적응하려면 대가가 필요한가 보군"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "중운에 대해…",
      "text": "이 세상에… 아직 「혈연」이 남아있는 줄은 몰랐어. 그가 수행하는 데 어려움이 있다면 얼마든지 답해줄 수 있어. 대신 그가 직접 산으로 와야 해. 그의 가족은 너무 정이 넘쳐서 어떻게 거절해야 예의에 어긋나지 않는지 모르겠어…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "행추에 대해…",
      "text": "전에 그가 네 귓가에 뭐라고 하는 걸 봤어. 만약 널 위협했다면, 내가… 응? 친구끼리 장난친 거라고? 정말이야…?"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "종려에 대해…",
      "text": "그분은 자기가 평범한 인간이라고 하지만, 선인인 스승님과 아주 친한 모양이야. 그가 선인 거처 앞의 돌의자에서 술잔을 기울이는 걸 보게 되면, 방해하지 말고 혼자 조용히 있게 해달라고 스승님이 그러셔서 그렇게 했어"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "백출에 대해…",
      "text": "그의 약초는 품질이 좋아. 사람도 온화하고 세심하지. 그에 비해 목에 있는 뱀은 말하는 게 거침없더라고…. 걱정 마. 때리진 않았어. 뱀에게 쩨쩨하게 굴 정돈 아니야"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "호두에 대해…",
      "text": "그 애는 근처 숲을 돌아다니면서 종종 이상한 노래를 불러. 그러다 보니 그 노래들을 쭉 다 들어 봤는데, 몇 번을 들어도 이상하더라. 근데 싫진 않아"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "소에 대해…",
      "text": "내 기억에 그는 늘 웃지 않는 엄숙한 모습이었어. 최근에 봤을 때도 여전히 과묵했지만… 전보단 많이 편안해진 느낌이야. 좋은 사람을 만난 걸지도 모르겠네"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "한운에 대해…",
      "text": "저번에 스승님이 수옥을 데리고 만민당에 식사하러 오셨는데, 수옥에게서 벌써 스승님의 모습이 느껴지더라…. 나도 스승님의 보살핌을 받으며 자랐는데, 나에게도 스승님의 모습이 녹아 있으려나…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "신학에 대해 알기·첫 번째",
      "text": "사람들이 날 뭐라고 부르든 신경 쓸 것 없어. 난 선인도 아니고 신통력이 있는 것도 아니니까. 퇴마사 집안의 방계 가문에서 태어나, 리월항과 멀리 떨어진 산에서 자랐어. 따지자면 선인의 제자일 뿐이야"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "신학에 대해 알기·두 번째",
      "text": "악의를 품고 말썽을 일으키는 사람이 있으면 다들 설교하려고 하는데, 난 이해가 안 돼. 방해만 되는 악인들을 뿌리 뽑을 수 있는데, 왜 귀찮은 방법으로 해결하려 하지?"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "신학에 대해 알기·세 번째",
      "text": "난 여러 선인 밑에서 수련을 해왔어. 수행의 경지가 높아질수록 그분들은 내게 새로운 술식 대신 살심을 다스리는 법을 가르쳐주셨지. 긴장하지 마… 평지에 굴을 파거나 나무를 뽑는 것 같은 일은 인적 드문 산에서만 하고 무고한 생명은 해치지 않았어. 게다가 지금은 나도 나 자신을 제어할 수 있다고"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "신학에 대해 알기·네 번째",
      "text": "아버지는 내 육신으로 어머니를 되살리려 했어. 날 동굴에 버린 아버지가 다시 구하러 올 거라고 믿었던 때가 있었지. 하루, 이틀, 사흘… 온 힘을 다해 마물과 싸웠지만, 쓰러질 때까지도 아버지는 오지 않았어. 내가 고독한 팔자를 타고나서 버려진 걸까, 명이 기구해서 살기가 생긴 걸까? 도통 모르겠군"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "신학에 대해 알기·다섯 번째",
      "text": "하루는 스승님 몰래 마을에 내려갔는데, 원래 마을은 황폐해졌고, 아버지는 이미 돌아가셨단 걸 알게 됐어. 그때 깨달았지. 혈족과의 인연이 완전히 끊어졌단 걸. 마음에 걸리는 과거는 영원히 끝을 맺은 거야. 그날부터 속세와 연을 거의 끊었어… 널 만나기 전까진"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "신학의 취미…",
      "text": "가부좌를 틀 때 중요한 건 「고요함」이야. 잡념을 버리고 몸으로 주변의 기를 느끼면, 빠르게 진정한 자신을 찾을 수 있지. 수행이 일정 경지에 오르면, 가부좌의 자세에 연연하지 않아도 된다고 스승님이 그러셨어. 선인들은 서서도 명상할 수 있다던데… 난 아직 멀었어"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "신학의 고민…",
      "text": "소중한 사람을 잃을까 두려워 하면서도 그를 구하고 싶은 마음이… 심장을 꽉 휘어잡아. 이런 느낌은 처음이야. 이건 고민이자… 바람이기도 해"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "하산했을 때 많은 음식을 먹었지만 맛은 기억이 잘 안 나. 근데 유독 옛날에 집에서 먹던 국수만큼은 영원히 잊히지 않네… 왜 아직까지 생각나지… 안 되는데…"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "약초를 오래 씹으면 쓴맛과 떫은맛만 남아…. 수행을 오래 하다 보니 이런 계율은 이미 익숙해. 선인들은 어떻냐고? 「선인은 속세의 것에 수행을 방해받지 않으니 음식을 맘껏 먹을 수 있다」… 라고 스승님이 그러셨어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "이 맛을… 내가 즐겨도 되는 걸까?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "네가 만든 음식은 정말 맛있어. 차마 포기할 수가 없네"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "괜찮아, 이런 맛은 익숙하거든"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생일은 기념할 만한 날이라 생일을 맞는 사람에게 선물을 주며 축하하는 거라고 들었어. 물질적인 건 잘 모르지만, 밤하늘은 내가 산에서 본 것 중 가장 아름다워. 호수를 얼려서 거울 삼아 구름과 별을 비춰 네 생일을 축하할게…. 네 마음에 들었으면 좋겠네"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "내가 제어할 수 있는 힘이… 점점 커지고 있어"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "스승님이 알게 되면 붉은 끈을 더 묶으라고 하겠지…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "요새 폐관 수련하는 시간이 줄었는데, 수행의 경지는 올랐네…. 음, 너랑 같이 있어서 가능한 일이야"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "예전엔 「잡념이 없어야 초연할 수 있다」고 생각했어. 하지만 많은 걸 겪은 후, 마음에 미련이 있어야 지키려는 욕망이 깨어나고, 힘은… 비로소 의미를 얻게 된다는 걸 깨달았지"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "명을 들어라!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "나타나!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "영혼 소환!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "기와 정신을 하나로!"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "의식의 얼음 분신!"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "참모습을 부여하리!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "하늘의 칙명!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "차가운 얼음의 화신!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "계율에 따라 행하리!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "이게 바로 인간 세상의 보물인가?"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "선인의 보물과 무슨 차이지?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "이건… 다 어디에 쓰는 물건이지?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "절대 안 봐줘…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "분하군…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "반드시… 멸하리!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "무리할 필요 없어"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "내가 끝내지"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "숙명을… 거스를 순 없는 법…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "죽음은 정해져 있었어…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "겁살은 화를 부를지니…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "아직 부족하군"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "감히!"
    },
