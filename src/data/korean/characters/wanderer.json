  "outfits": [
    {
      "id": 207500,
      "name": "공허한 정적과 분노",
      "description": "{REALNAME[ID(1)]}의 코스튬. 수행자의 일상복으로 삿갓은 방랑자에게 잠시 비를 피할 공간이 되어주지만, 마음속에 휘몰아치는 번개 폭풍 앞에서는 아무 소용이 없다",
      "isDefault": true,
      "characterName": "방랑자",
      "characterId": 10000075,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Wanderer_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "내 이름? 세간에서 나는 여러 이름으로 불리지. 모두 다 일반인이 평생을 노력해도 얻을 수 없는 명성을 가진 이름이지만, 이제는 과거일 뿐이야.\\n네가 부르고 싶은 대로 불러도 좋아. 이 기회에 네 품격을 확인해보고 싶으니까, 실망시키지 마"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·바람",
      "text": "바람도 언젠간 막다른 곳에 막히듯이 세상에 순수한 자유란 없어"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·대화방식",
      "text": "내가 너무 쌀쌀맞다고? 난 사실을 있는 그대로 말할 뿐이야. 받아들이지 못하는 사람이 문제겠지"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·인사말",
      "text": "겉치레는 됐어. 억지로 대화를 이어 나가는 것도 우스꽝스러우니까"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "내 삿갓으로 비를 막고 싶다고? 뻔뻔하긴"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "햇빛 좀 봤다고 신나기는, 어린아이도 아니고"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "칫… 짜증 나네"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "비나 눈이나 다를 것도 없는데, 사람들은 눈을 더 좋아하는 걸 보면… 다 자기 팔자라는 게 있나 봐"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "이 정도 바람은 너도 일으킬 수 있겠지?"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "「얼른 일어나. 해가 중천이야」… 라고 말하며 깨워줄 거라고 기대하는 건 아니겠지?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "난 식사가 필요 없으니, 너랑 옆에 있는 쪼그만 것이나 같이 잘 챙겨 먹어. 내가 신경 쓰지 않게 말이야"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "드디어 시시한 하루가 끝나가네"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "내가 옆에 있으니까 잠이 안 오는 거야?"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "#{REALNAME[ID(1)]} 자신에 대해·인형",
      "text": "불살라진 인형은 재를 남기지. 그럼 잿더미에선 뭐가 태어날까…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "#{REALNAME[ID(1)]} 자신에 대해·심장",
      "text": "그건 아무래도 상관없어. 내 것이 될 수 없는 것에 집착해봤자 시간 낭비일 뿐이니까. 지금 난 더 중요한 할 일이 있어"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·적수",
      "text": "우리가 서로 적대하던 시절을 아직도 마음에 담아두고 있다고? 오, 그래서 어쩔 건데? 천천히 생각해 봐. 난 급할 거 없으니까"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·동료",
      "text": "난 「정의」에 귀의하지는 않겠지만 은혜를 갚겠다는 약속은 꼭 지킬 거야.\\n그나저나 나와 함께한다면 곤란해질 텐데 괜찮겠어? 다른 사람들이 너를 죄인과 「결탁」하는 악당 취급해도 난 책임 안 진다"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 주시」라는 건 상당히 불쾌하지만 쓸 수 있는 힘을 굳이 따지고 거를 필요는 없지. 넌 「바람 원소」에 깊은 의미가 담겨 있다고 생각한다고? 훗, 어째서 그렇게 생각하지? 신이란 제멋대로인 존재야. 내가 보여줬잖아"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "없어. 궁금한 게 있으면 물어봐도 좋아. 기분이 좋으면 알려줄게"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "저기 봐. 새는 깃털을 뽐내고 다람쥐는 도토리를 모으며 인간은 먹고살기 위해 온종일 일하지. 생각이 단순한 생물일수록 살기 편하다니까"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "작은 쿠사나리 화신에 대해…",
      "text": "그녀는 이용 가치가 있다는 이유만으로 날 살려둔 건 아닐 거야. 현명하고 자비로운 마음 때문일 수도 있고, 아니면 내 고독한 그림자를 보고… 내가 악의적인 추측을 하고 있다고? 하, 당연하잖아! 난 착한 사람이 아니니까"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "라이덴 쇼군에 대해…",
      "text": "자신의 창조물을 나 몰라라 했으면서, 차마 간섭할 수 없었다고 미화했지…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "「여왕」에 대해…",
      "text": "사람들은 그녀의 자애를 찬양하지만, 「사랑」도 「죄」가 될 수 있단 건 모르지. 보상 심리에 빠진다고 할까나?"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "「피에로」에 대해…",
      "text": "「피에로」가 켄리아의 유민이란 사실을 제외하면 나도 딱히 아는 게 없어. 제대로 된 대화를 해봤어야 알지. 하지만 나한테 바라는 건 있는지, 꽤 중요한 임무를 여러 번 맡기더라고. 「심연」으로 향하는 것도 그중 하나였어"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "「카피타노」에 대해…",
      "text": "「강직하고 청렴한 『카피타노』」, 「정직하고 과감한 『카피타노』」, 「수많은 공을 세운 『카피타노』」…. 우인단에서 도는 말들을 얼마나 많이 들었는지 귀에 딱지가 앉을 지경이야. 하지만 절대적인 「올곧음」만큼 위험한 게 있을까? 더구나 「카피타노」는 절대적인 실력까지 갖추고 있지"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "「도토레」에 대해…",
      "text": "안타깝게도 「도토레」가 작은 쿠사나리 화신의 말에 따라 수많은 조각을 소멸시키는 바람에, 그 자식을 한 조각씩 없애는 즐거움이 사라졌어"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "「콜롬비나」에 대해…",
      "text": "너라면 「언제나」 멍하며, 「뭘 하든」 무덤덤한 「콜롬비나」를 만나면 어떻게 할 거야? 난 일단 한번 싸워볼 거고, 넌… 착한 게 탈이니까 피하는 게 좋을 거야"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "「아를레키노」에 대해…",
      "text": "「아를레키노」는 위선자야. 「우아」하고 「친절」하게 사람을 대하는 건 그들을 더 쉽게 「통제」하기 위함이지. 그녀의 광기를 마주한 사람들은 이미 다… 후~"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "「풀치넬라」에 대해…",
      "text": "「풀치넬라」가 진심으로 아무런 대가 없이 자기 가족을 돌봐주고 있다고 생각하는 건 「타르탈리아」밖에 없어. 실제로 「풀치넬라」가 많이 도와주긴 했지만 그건 「네 가족은 내 손에 있다」는 경고나 다름없겠지?"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "「산드로네」에 대해…",
      "text": "「산드로네」는 연구에만 몰두하는 괴짜야. 하지만 그런 극단적인 행보에도 불구하고 만들어내는 건 쓰레기뿐이지. 집행관 서열도 나보다 한 단계 낮았고 말이야. 정말 불쌍한걸"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "「판탈로네」에 대해…",
      "text": "그 서열 9위 말하는 거구나. 「판탈로네」는 「공정 거래」에 너무 집착한 나머지 신과 인간의 타고 난 불평등까지 뒤집어엎을 생각을 하고 있어. 뭐 평범한 인간이 과분한 망상을 하는 건 특이한 게 아니지. 「판탈로네」는 능력만큼이나 안목도 평범해서 「도토레」와 손잡고 있어. 흥, 결과는 안 봐도 뻔해"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "「타르탈리아」에 대해…",
      "text": "머리가 나쁘면 몸이라도 좋아야 하는데 「타르탈리아」는 둘 다 엉망이야. 집행관 말석조차 과분해서 우인단의 수준을 떨어뜨리고 있지. 우인단을 나와서 정말 다행이야"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "「시뇨라」에 대해…",
      "text": "「시뇨라」의 재에는 아무것도 없지. 난 미래를 잃은 사람에게는 관심 없어"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "야에 미코에 대해…",
      "text": "입만 산 요괴야. 신의 총애를 등에 업고 인간을 위하는 척하면서 자신의 즐거움만을 좇고 있지"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "카에데하라 카즈하에 대해…",
      "text": "네가 말하는 카에데하라 가문의 후손은 혹시…. 뭐? 그 녀석도 바람 원소의 「신의 눈」을 가지고 있으며, 라이덴 쇼군의 검을 막아냈다고? 후후후… 하하하하하하하하!"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "세토스에 대해…",
      "text": "내가 왜 그 녀석을 알 거라고 생각해? 맨날 내 뒤꽁무니나 쫓아다니면서 모자를 보여달라고 해서? 딱히 얘길 나눠본 적은 없어. 처음 보자마자 나한테 「모자」 아니냐고 묻던데, 사람을 겉모습으로 판단하는 녀석 따위와 무슨 얘길 해? 흥, 「모자」라니, 이 이름이 이렇게까지 퍼질 줄이야…"
    },
    {
      "id": "4017",
      "type": 1,
      "title": "두린에 대해…",
      "text": "그 녀석은 책에서 나올 때부터 문제가 많았어. 인간이 되고 나선 더 많아졌지. 매번 무슨 편지를 그렇게 길게 쓰고, 글씨는 왜 또 그렇게 삐뚤빼뚤한지 원.\\n할 일 없으면 가서 걔 호기심이나 채워줘. 그 녀석이 잘못된 길로 들지 않게"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}에 대해 알기·첫 번째",
      "text": "나에 대해 알고 싶어 할 줄이야. 하지만 알게 되면 귀찮은 일이 생길걸?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}에 대해 알기·두 번째",
      "text": "아, 과거를 청산하려고 날 찾아오는 사람이 많을 거야. 난 오는 사람 막지 않는 주의라 상관없어. 오히려 기대되는걸"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}에 대해 알기·세 번째",
      "text": "신이 되면 쓸데없는 감정은 다 버릴 수 있을 줄 알았는데, 지금은 생각이 바뀌었어. 적어도 「분노」만큼은 참 편리한 도구인 것 같아. 어디서 비롯됐든 말이야.\\n세상에 화 한 번 안 낸 인간이 있다고? 놀랍군, 정말 성깔이 하나도 없는 걸까?"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}에 대해 알기·네 번째",
      "text": "세계수에 들어간 순간, 난 차라리 내가 이 세상에 존재하지 않았으면 좋겠다는 생각을 했어.\\n그리고 세계수는 내 소원을 들어주었지. 하지만 내가 원하는 결과를 주진 않았어. 이 땅의 운명은 앞으로도 계속 이 땅을 밟고 살아가는 죄인을 농락할 거야"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}에 대해 알기·다섯 번째",
      "text": "너와 나 사이에 접점이 있는 건 사실이지만 언젠가는 다른 길을 걷게 될 거야. 그때 무슨 일이 생길지는, 때가 되면 알 수 있겠지?"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}의 취미…",
      "text": "취미? 그런 건 한가한 사람들한테나 있는 거잖아. 내가 그리 한가한 것 같아?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}의 고민…",
      "text": "어떻게 해야 널 따돌리고 한바탕 날뛸 수 있을까…. 농담이야. 그걸 정말 믿냐?"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "차 있어? 쓸수록 좋아. 그래야 끝맛이 깊거든"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "달짝지근한 음식은 이에 달라붙어서 싫어. 그런 건 너나 먹어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "굼벵이도 구르는 재주는 있다더니 괜찮네"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "나쁘지 않네. 적어도 먹을 순 있으니"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "날 독살할 생각이야? 멍청하긴, 내가 어떤 존재인지 잊은 건 아니겠지?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "손 내밀어봐. …훗, 왜 긴장하는 거야. 높은 곳에서 공기나 쐬러 가자.\\n어때? 대단한 경치지? 감사는 귀찮으니까 됐어"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "…애쓴 게 보이네"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "바람이 불어오잖아…. 너 무슨 짓을 한 거야?"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "나한테 힘을 주다니, 뒷감당할 자신은 있어? …알았어"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "네 힘이 되어줄 순 있지만 날 동료로 여기는 건 위험한 생각이야. 네가 마주하고 있는 게 무엇인지 다시 생각해 봐. 그래도 두렵지 않으면 내 뒤에 서도 좋아"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "바람이여!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "속세를 내려볼지니!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "분노의 바람!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "벌레 주제에 무엄하구나!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "비천한 것!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "더 크게 울부짖어라!"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "원소폭발·네 번째",
      "text": "고개를 숙여라!"
    },
    {
      "id": "200005",
      "type": 2,
      "title": "원소폭발·다섯 번째",
      "text": "네 주제를 파악하도록!"
    },
    {
      "id": "200006",
      "type": 2,
      "title": "원소폭발·여섯 번째",
      "text": "감히 나랑 눈을 마주쳐?"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "대시 시작·첫 번째",
      "text": "바람 질주!"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "대시 시작·두 번째",
      "text": "질풍을 따라!"
    },
    {
      "id": "700004",
      "type": 2,
      "title": "대시 시작·세 번째",
      "text": "…느려"
    },
    {
      "id": "700005",
      "type": 2,
      "title": "대시 시작·네 번째",
      "text": "따라오라고 한 적 없어"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "쓸모없군"
    },
    {
