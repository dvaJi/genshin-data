  "outfits": [
    {
      "id": 202400,
      "name": "요동치는 파도",
      "description": "북두의 코스튬. 북두의 기백이 묻어나는 가벼운 스커트 복장이다",
      "isDefault": true,
      "characterName": "북두",
      "characterId": 10000024,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Beidou_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "내 이름은 북두, 「남십자」 함대라고 들어 봤어? 너도 모험을 즐긴다면 날 따라와. 내가 돌봐주지"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·연마",
      "text": "겨뤄보고 싶다면 언제든 환영이다"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·통음",
      "text": "아——일 끝나고 마시는 술 한잔은 정말 상쾌해"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·육지",
      "text": "육지에 이렇게 오래 머무는 건 간만인데, 좀 어색하네"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "무인도에 갇혔을 때 빗물은 귀중한 수원이야. 물론 지금은 필요없지만"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "이봐, 그냥 천둥일 뿐이야. 바다에서는 두려워할 필요없어. 육지에서는 더 그렇고"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "바람이 불 때…",
      "text": "이 날씨, 출항하기 딱 좋군"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "모래 바람 조심해. 눈 비비지 말고"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "여, 좋은 아침. 난 출발하려는데. 같이 갈래?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "향릉에게 가서 점심 먹자. 그 커다란 솥으로 볶아 낸 건 바다에서의 생선 구이, 절인 고기와는 확실히 달라"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "좋아. 술 마시러 가자고! 하하하, 평소에 술 사주는 사람이 없나봐? 그럼——"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "벌써 시간이 이렇게 됐네. 하하하하, 가봐~ 편히 쉬라구"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "북두 자신에 대해…",
      "text": "제군들, 항해 준비. 각자 위치로! 새로운 모험이 시작된다!"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·호칭",
      "text": "난 대장이고, 넌 내 형제. 괜찮지? 뭐? 너무 촌스럽다고? 좋아, 그럼 네가 원하는 대로 불러"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·사람을 보는 눈",
      "text": "난 사람 보는 안목이 뛰어나. 넓은 바다를 보다 보면 사람 얼굴의 작은 물보라는 쉽게 읽히지. 하하, 그래서 내가 널 한눈에 알아봤잖아"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·선택",
      "text": "넌 내가 선택한 선원이자 형제라고. 이것만으로도 난 자부심을 느껴"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」이 없는 녀석들은 신의 인정을 받은 「신의 눈」 소유자를 본받고 싶어 해. 그러니까 본받을 만한 사람이 되자. 난 그렇게 날 채찍질해"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "난관에 부딪혔어? 어디로 나아갈지 모르겠으면 일단 발을 내딛고 봐. 그 후의 길은 자연히 열릴 테니까"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "원양 항해를 마치고 돌아올 때 솔개가 보이면 집에 다 왔다는 거지. 바다 풍경은 단조롭잖아. 그에 비해 거칠긴 하지만, 솔개가 자유롭게 날아다니는 모습은 어쩐지 친근하고 사랑스러워"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "응광에 대해·리월 칠성",
      "text": "응광이라, 「리월칠성」이라는 면에서 보면 훌륭하다 할 수 있지. 다만 내가 책임감을 느끼는 대상은 「리월칠성」이 아닌, 내 함선과 형제들이라서 말이야"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "응광에 대해·태도",
      "text": "응광은 솔직하지 않은 편이지만 예전엔 아주 노골적으로 날 못마땅해했어. 하하, 좋든 싫든 그건 그녀 마음이지. 난 신경 안 써"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "향릉에 대해·뛰어난 요리 실력",
      "text": "먼바다에 있을 땐, 향릉의 맛있는 음식이 그리워. 힘이 달릴 때 입안 가득했던 절운고추 볶음을 떠올리면 기운이 번쩍 들지"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "향릉에 대해·시식",
      "text": "향릉은 가끔 별 이상한 재료로 대단한 요리를 만들어내지. 뭐, 그런 도전 정신이 없다면 진보도 없는 거 아니겠어? 난 그녀의 음식을 시식하는 게 즐거워"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "종려에 대해…",
      "text": "「왕생당」의 그 선생 말하는 거야? 형제들이 가끔 그에 대한 소문을 이야기하지. 아주 재미있는 사람 같은데. 음, 기회가 있으면 교류해봐야겠어"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "소에 대해…",
      "text": "해등절 전날, 함대가 귀항하다가 폭풍을 만난 적이 있었어. 어찌어찌 서둘러 밤이 되어서야 리월항에 도착했고, 등불도 다 꺼져있는데 고운각 방향 하늘에 소년 모습의 선인이 보이는 거야. 역시 소문처럼 사람들이 보지 못하는 곳에서도 이 리월항을 지키고 있는 누군가가 있는 거지"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "감우에 대해…",
      "text": "감우 그 애랑은 사이가 좋아! 근데 너도 알다시피, 걘 「리월 칠성」의 비서야. 「칠성」이 날 싫어하는 게 하루 이틀도 아니고. 하하, 난 상관없는데, 그 애까지 피해 보게 할 순 없잖아. 음, 역시 다른 사람들에겐 비밀로 하는 게 좋겠어"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "신염에 대해…",
      "text": "재밌는 애야! 우리 배에 있는 형제들 모두 그녀의 「로큰롤」을 좋아하지. 음… 난 어떻냐고? 뭐랄까, 그 애와 어떤 면에선 공통적인 화제가 있지만, 내 음악적 취향은 그 애와 전혀 달라서…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "요요에 대해…",
      "text": "요요 그 녀석은 자꾸 우리 배에서 놀려고 해. 하지만 그 호기심 넘치는 반짝이는 눈을 보면, 차마 그 애를 쫓아낼 수가 없어. 에휴, 하마터면 출항 계획이 모두 엉망이 될 뻔했다고"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "카에데하라 카즈하에 대해…",
      "text": "카즈하 녀석이 천수각 밖에서 라이덴 쇼군의 일격을 막아냈다던데, 제법이군! 전쟁이 끝나고 그는 우리 남십자함대로 돌아와서 우리랑 한동안 더 동행하고 싶다고 했어. 나야 환영이지. 만약 어느 날 카즈하가 혼자 다음 여정을 떠나기로 결정한다면, 아주 좋은 술로 배웅할 거야, 흐흠"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "북두에 대해 알기·첫 번째",
      "text": "내 「사조성」호에 오르고 싶다면 이 질문부터 대답해. 바다엔 위험으로 가득한데 어째서 내 배에 오르려는 거지?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "북두에 대해 알기·두 번째",
      "text": "나에 대한 이야기들? 하하하, 그건 형제들이 날 치켜세우느라 그런 거지. 그렇지만 내게 항해 중 마물과 부딪치는 게 두렵냐고 묻는다면, 물론 그건 아니야"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "북두에 대해 알기·세 번째",
      "text": "평민을 돕는 의도가 뭐냐고? 하, 그런 일에 무슨 의도가 있겠어. 누구나 다 어려운 시절이 있는 거야. 내겐 약소한 선의지만 그들에겐 죽느냐 사느냐의 문제일 수도 있어"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "북두에 대해 알기·네 번째",
      "text": "난 고통스러운 시간을 보냈어. 어릴 때 먹을 걸 살 모라도 없어서 남의 집 과일을 훔쳐 먹으며 버텼지. 내 함대가 생겼어도 거만한 상인들에게 배척당했어. 하지만 이제 그런 일들을 안줏거리 삼아 얘기할 수 있으니 됐어. 절대 너는 그런 일을 겪게 하지 않을 거고"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "북두에 대해 알기·다섯 번째",
      "text": "날 따르는 형제들은 아주 많아. 그들 모두에게 이 배에 오른 이유를 물어봤지. 넌 특별해. 니가 아직 해야 할 일이 있다는 걸 아니까 따로 직무나 직함을 주진 않을게. 하지만 네가 어디에 있든 「사조성」호엔 영원히 네 자리가 남아있을 거야"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "북두의 취미…",
      "text": "취미라… 생각 좀 해볼게. 모험, 조타, 친구 사귀기, 술 마시기, 맛있는 거 먹기…. 흠, 한 손으로는 다 못 세겠네"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "북두의 고민…",
      "text": "해결할 수 있는 일은 고민할 필요 없고, 해결할 수 없는 일은 고민해도 의미 없어. 난 그렇게 생각해. 만약 안 풀리는 일이 있으면 날 찾아와. 같이 해결해 줄게"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "난 맛이 강한 요리를 좋아해! 편육 볶음이라든가, 마파두부라든가, 다 좋아. 배도 채우고 모두 둘러앉아 먹으면 분위기가 후끈해지잖아. 하, 말하다 보니 또 먹고 싶어지네"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "난 냉채는 별로야. 그렇게 느긋하게 전채 요리를 즐길 시간에 생선이나 몇 마리 더 굽겠어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "맛있어, 내가 좋아하는 맛이야! 밥 있어? 두 그릇만 더 줄래?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "솜씨가 훌륭한데? 먹으면 기분이 좋아질 정도야"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "재료는 좋네, 그럼 됐어"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "자, 배에 타. 이미 형제들과 시간 비워놓기로 약속했지. 먹을 것과 마실 것도 다 준비됐어. 오늘은 네 생일이니 네가 대장이야. 하하! 음, 어디 가고 싶어?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "통쾌하군! 또 많이 강해졌어"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "만선으로 돌아가는 기분이라, 축배를 들자고!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "훌륭해. 너같이 유능한 형제가 있다니 이 북두의 영광이야! 나도 뒤처질 순 없지"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "이 훈련들로 무예가 정점을 찍은 것 같아. 고마워…. 맞다, 몇 수 더 겨룰까?"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "비켜!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "하!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "전부 돌려주지!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "받아 봐!"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "——하아!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "이게 「해산」을 멸하는 힘이다!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "눈 크게 뜨고 잘 봐!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "잿더미가 되어라!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "이야, 기분 좋네"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "나쁘지 않아. 새로운 수확이군!"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "보물을 찾았으니 축배를 들자고!"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "아직 안 끝났어!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "흥, 나 정신 들었어"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "난 절대 굴복하지 않아"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "내 뒤로 와!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "물러서! 오기 부리지 말고"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "완전 엉망이야"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "제군들… 일단… 철수다…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "전원… 귀항한다…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "별것 아냐"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "승패는 아직 몰라"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "제법이군"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "좋아, 출발!"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "날 따라와"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "난 널 믿어"
    }
  ]
}