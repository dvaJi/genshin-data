  "outfits": [
    {
      "id": 211900,
      "name": "푸른 숲과 순수한 달",
      "description": "라우마의 코스튬. 달의 제사장 라우마는 사슴과 인간의 형태 사이를 오간다. 하지만 그녀의 모습과 무관하게, 변하지 않는 것은 모든 생명체를 향한 그녀의 헌신과 사랑이다",
      "isDefault": true,
      "characterName": "라우마",
      "characterId": 10000119,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Lauma_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "눈을 뜨세요. 제 이름은 라우마, 이곳은 서리달빛이 내리쬐는 고요한 숲입니다. 이곳에선 어디를 가든 하늘의 시선 아래 있죠. 자, 눈을 감으세요. 이제 더는 길을 잃지 않을 거예요"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·달빛",
      "text": "밤이 아니더라도, 하늘이 보이지 않아도… 달빛은 결코 사라지지 않아요"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·동물",
      "text": "노드크라이에서 동물의 행동이 이해되지 않을 땐, 저를 찾아오세요"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·여정",
      "text": "갈 곳을 정하셨나요? 아니면 풀밭에서 잠깐 쉬어가는 건 어떠세요?"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "곧 초목이 무성해지는 계절이 오겠군요…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "찰나의 반짝임은, 달빛보다 잡기 어렵네요…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "이렇게 새하얀 것을 오래 바라보면 안 좋다던데, 정말인가요? 저는 참 좋아하는데…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "사막에 있을 때…",
      "text": "네페르에게 이런 곳이 있다고 듣긴 했는데… 이런 모습이었군요"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침입니다. 달의 신의 가호가 밤낮으로 따르기를"
    },
    {
      "id": "1005",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침입니다. 달빛이 밤낮으로 우리를 이어 주기를"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "…아, 제가 졸고 있었나요? 죄송합니다. 필요한 게 있으면 말씀하세요"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "오늘 밤은 달빛이 참 고요하네요. 같이 숲을 거닐지 않으실래요?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "별들이 서로 인사를 마쳤어요. 이제 우리 차례예요"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "라우마 자신에 대해·책임",
      "text": "법 없는 규율은 속임수에 지나지 않고, 마음 없는 지도자는 거짓 신에 불과합니다. 사람이 모이는 곳에는 응당 질서가 필요해요. 「서리달 아이」처럼 공통된 신앙을 공유하는 곳에서도, 규칙은 필요하죠"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "라우마 자신에 대해·고민 해소",
      "text": "신의 사자로서 신도의 고민을 듣고 걱정을 덜어주는 게 제 역할이지만… 어쩐지 동물의 재잘거림에 귀 기울이는 시간이 더 많은 것 같아요…. 후후…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·물줄기",
      "text": "숲의 물줄기가 바다를 향해 흐르듯, 우리의 만남도 정해진 운명이 아니었을까요?"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·초목",
      "text": "초목은 흙에 뿌리를 내리고, 위로도 아래로도 자라나죠. 별과 심연에 끝이 없듯… 우리의 미래도 그러하길 바라요"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「달의 륜」에 대해…",
      "text": "달의 륜은 신의 자비예요. 한 사람의 염원을 나타내는 척도라는 설도 있어요.\\n왜 「설」이냐고요? 음… 그야 확인할 길이 없으니까요"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "달 아래 물을 떠 놓고, 기쁨과 걱정을 털어놓아 보세요. 달의 그림자가 수면에 떠오른다면… 당신은 달빛의 축복을 받은 거랍니다"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "동물들이 당신을 어떻게 평가하는지 듣고 싶으신가요? 후후… 달이 한두 번 뜨고 지는 사이에는 다 말씀드리기 어려워요"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "이네파에 대해…",
      "text": "노드크라이에는 몸을 개조한 사람이 많지만, 전신이 기계로 이루어진 건 또 다른 이야기죠…. 하지만 악한 마음을 품은 자들과 비교하면, 온화하고 친절하며 순수한 호기심을 가진 그녀가 더 인간답게 느껴지기도 해요"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "아이노에 대해…",
      "text": "아주 총명하지만, 험난한 운명을 가진 아이죠. 아이노의 발명품은 많은 이들에게 도움이 되고 있어요. 노드크라이가 이런 보물을 가진 걸 자랑스럽게 여겨야 할 정도로요. 아이노가 서리달 마을에서 지내길 원한다면, 영양가 있는 식사와 맑은 샘물, 신선한 채소는 제가 책임질게요"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "플린스에 대해…",
      "text": "예의 바르고 격식 있는 분처럼 보이지만, 동물들은 그분을 두려워하는 것 같아요. 저도 경계를 풀지는 않겠지만, 증거도 없이 섣불리 판단해서는 안 되겠죠. 그분이 서리달 마을을 지나실 때마다, 저는 항상 오늘의 수확을 나눠 드리고 있어요.\\n이름이 좀 길 뿐, 나쁜 사람은 아니라고요? 음… 그런가요?"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "네페르에 대해…",
      "text": "행동 양식은 많이 다르지만, 어울릴 수 없는 사이는 아니라고 생각해요.\\n어쨌든… 그녀에게도 달빛의 가호가 따를 거예요"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "야호다에 대해…",
      "text": "실험설계국에 함께 잠입하기 전까진, 「비밀의 집」 소속이자 네페르가 신뢰하는 직원이라는 것 정도만 알고 있었어요. 네페르와 여러 의뢰인 사이에 끼어 일하는 건 고단한 일일 테죠. 언제 한번 꼭 대접하고 싶네요…. 후후, 네페르가 그분 앞에서는 저를 뭐라고 불렀을지도 조금 궁금하고요"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "바르카에 대해…",
      "text": "노드크라이에는 다양한 사람들이 모여들지만… 그분만큼 잘 녹아든 외지인은 드물어요. 그 천부적인 친화력은 귀한 자질이죠. 처음 만났을 때 「서리달 아이」에서 나눠주는 음식이 맛있었다며 칭찬하셨는데… 정작 전 그분께 음식을 드린 기억이 없었어요. 그런데 이상하게도, 그분의 진실함이 의심되지는 않더군요"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "「쿠타르」에 대해…",
      "text": "갓 태어난 신이 신도와 어울리는 법을 배울 곳은 없어요. 예전의 그녀는 분명 힘들었겠죠….\\n이런 관계를 조율할 방법을 찾고자, 저는 신께 무례에 가까운 부탁을 드렸어요. 그분은 혼자 지내는 게 더 좋다고 하셨지만, 저는 희망의 끈을 놓지 않고 있죠. 언젠가 「쿠타르」와 「서리달 아이」, 밝은 달과 그 달을 우러러보는 사람들이 같은 하늘 아래에서 함께 잔을 들 수 있기를 바라요"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "라우마에 대해 알기·첫 번째",
      "text": "달을 보세요. 달은 언제나 소리 없이 그 자리에 있답니다"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "라우마에 대해 알기·두 번째",
      "text": "깨진 달은 많은 곳에서 액운의 징조로 여겨져요.\\n하지만 그 모습은 달이 원한 게 아니라… 운명의 요동이 빚어낸 결과일 뿐이죠"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "라우마에 대해 알기·세 번째",
      "text": "때때로 신의 대변인은 신보다 더 「신성함」을 보여야 해요. 그래야만 사람들의 기대에 부응할 수 있죠. 신도들은 신의 변덕에는 상식을 초월하는 관용을 베풀지만, 사자에게는 그렇지 않아요"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "라우마에 대해 알기·네 번째",
      "text": "과일은 조금만 오래 두면 술로 발효되는 냄새가 나기 시작해요. 전 술을 마시지 않지만, 그 향을 맡고 있으면 왜인지 몸에 힘이 풀리더군요…. 술이 안 맞는 거겠죠?"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "라우마에 대해 알기·다섯 번째",
      "text": "「서리달 아이」의 아이들은 흰 천을 머리 위로 들고 뛰어다니길 좋아해요. 흰 천을 두르는 건 달빛을 두르는 것과 같아서 액운이 달아난다고 어른들이 그러거든요. 하지만 어느 정도 나이가 들면, 그런 장난 대신 밤하늘의 창백한 달빛을 향해 기도를 드리죠.\\n저도 그랬냐고요? 그럼요. 누구에게나 어린 시절이 있는 법이랍니다"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "라우마의 취미…",
      "text": "저는 칠흑 같은 밤, 홀로 보내는 시간을 좋아해요. 새와 동물도 이야기를 멈추고, 들려오는 건 나뭇잎을 스치는 바람 소리뿐… 아주 고요하죠"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "라우마의 고민…",
      "text": "머리가… 조금 무겁네요"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "계율이나 신앙과는 별개로, 담백한 음식이 제 입맛에 잘 맞더군요"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "기름지거나 수분이 부족한 음식은… 잘 맞지 않아요"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "신선한 식재료군요, 감사합니다. 서리달 아이에 전달할게요. …네? 저한테만 주는 선물이라고요?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "감사합니다. 같이 나눠 먹죠"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "저보다 더 필요한 사람이 있을 거예요. 제가 한번 살펴볼게요"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "이 축복이 담긴 비수는 달빛과 고요한 숲의 총애를 받은 귀한 손님께만 드리는 거예요. 비수가 꼭 흉기인 건 아니에요. 가끔은 기도 의식의 도구로 사용되기도 하거든요.\\n물론, 이걸 어떻게 쓰실지는… 당신의 자유예요"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "지름길을 탐해서는 안 돼요…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "힘을 탐해서도 안 되죠…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "이 모든 것이 「진실」을 마주하기 위한 여정이라면——"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "저는 기꺼이 구도자의 피와 눈물을 바치겠습니다"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "숲의 수호"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "길 잃은 자여…"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "가렴"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "달빛처럼 피어나라"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "숲바람의 노래"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "원소전투 스킬·여섯 번째",
      "text": "축복을 담아"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "서리달이 변하지 않기를"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "숲과 들이 처음과 같기를"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "모두를 위해 기도하리"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "수고한 이에게 주어지는 선물이군요"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "세상이 당신을 반기고 있네요"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "어쩌면 오랫동안 당신을 기다려 왔을지도 몰라요"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "후우…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "제게 내려진 시련인가요…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "반성해야겠어요"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "숲의 그림자가 당신을 지켜줄 거예요"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "서리달의 품으로 돌아오세요"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "숲이여, 이 부러진 뿔을 거둬주기를…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "조석의 움직임이… 멈춰버렸어…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "달 없는 밤이… 오고 말았어…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "그만하세요…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "…만행을 삼가시죠"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "가죠, 부드러운 달빛이 있는 곳으로"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "빛이 없더라도, 성자는 바른길을 걷습니다"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "두려워 마세요, 제가 곁에 있을 테니"
    }
  ]
}