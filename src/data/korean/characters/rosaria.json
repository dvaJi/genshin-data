  "outfits": [
    {
      "id": 204501,
      "name": "성당의 자유인에게",
      "description": "로자리아의 코스튬. 성당에서 그녀를 위해 특별 제작한 선물인 듯하다",
      "isDefault": false,
      "characterName": "로자리아",
      "characterId": 10000045,
      "source": [],
      "filename_card": "UI_AvatarIcon_RosariaCostumeWic_Card",
      "filename_icon": "UI_AvatarIcon_RosariaCostumeWic",
      "filename_iconCircle": "UI_AvatarIcon_RosariaCostumeWic_Circle",
      "filename_splash": "UI_Costume_RosariaCostumeWic",
      "filename_sideIcon": "UI_AvatarIcon_Side_RosariaCostumeWic"
    },
    {
      "id": 204500,
      "name": "처형의 가시",
      "description": "로자리아의 코스튬. 로자리아가 직접 리폼한 페보니우스 기사단의 수녀 제복이다",
      "isDefault": true,
      "characterName": "로자리아",
      "characterId": 10000045,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Rosaria_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "가여운 신도여, 골칫거리가 있다면 날 찾아와. 근데 기도가 하고 싶은 거라면, 다른 수녀를 찾아가 봐.\\n…응? 넌 신도가 아니라고?"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·무료함",
      "text": "아직 안 갔어?"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·잔업",
      "text": "뭐든 말 해봐. 잔업은 빼고"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·몬드 생활",
      "text": "열심히 일해서 하루하루 잘 사는 게 몬드의 생활이잖아?"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "효율만 떨어져"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "하, 귀찮군"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "눈 오는 날엔 조심히 움직이는 게 좋아"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "바람의 신 바르스토바의 가호인가? 잠깐, 바르토바스였나…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침, 하암… 벌써 아침 기도가 시작된 거야? 너무 이르잖아"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "오후의 햇살은 숙면에 좋대. 너도 한번 느껴봐"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "저녁이네. 저녁 기도라면 난 빠질래. 이유는 없어"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "가서 쉬어. 나머지 일은 내가 처리할 테니 안심해"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "로자리아 자신에 대해·수녀",
      "text": "나? 난 그냥 재미없는 사람이야. 보다시피 성당도, 일하는 것도 싫어하지"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "로자리아 자신에 대해·귀찮음",
      "text": "그 수녀들 정말 귀찮아 죽겠다니까. 사람 잡아두고 기도해라, 찬양해라. 나 여기 있다는 거 절대 말하지 마"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·신앙",
      "text": "신이 모든 인간을 포용할 수 있다지만 다 돌봐주진 않을걸? 안 그럼 인간의 고난이 무의미해질 거 아냐"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "우리에 대해·기도",
      "text": "기도하자. 신이나 다른 사람을 위해서가 아닌 자신을 위해서 말이야"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "우리에 대해·전투",
      "text": "무리하지 말고 도움이 필요하면 날 불러"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "「신의 눈」은 실력의 증명이자 살아남았다는 훈장이기도 해…. 글쎄? 좋은 건 항상 양면성이 있기 마련이지. 「신의 눈」이 뭔지 단정 짓지 않을 거야. 나와는 서로를 증명하는 관계일 뿐이니까"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "기분 좋아지는 얘기… 아, 만일일 뿐이지만 언젠가 해결할 수 없는 난관에 부딪히게 돼도 그게 인생의 끝이라고 생각하지 마. 누군가 널 그 곤경에서 꺼내줄지도 모르잖아?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "풀떼기 같은 거엔 관심 없어. 아, 민들레만 빼고. 아주 맛있는 민들레주를 만들 수 있거든. 휴식 시간에 마시는 한잔은 늦잠보다 달콤하지"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "다이루크에 대해…",
      "text": "딱 보면 알잖아? 그 부잣집 도련님은 보통 내기가 아니야. 자신을 드러내지 않고, 자신감 넘치면서… 위험한 기운이 맴돌지"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "케이아에 대해…",
      "text": "케이아는 술에 취해야만 본 모습이 드러나. 말만 번지르르한 건 그의 보호색인 셈이지. 하, 아무리 연기해도 다 보여. 너도 그가 취한 모습을 한번 봐야 해"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "벤티에 대해…",
      "text": "그 음유시인한텐 아주 특별한 기운이 있어…. 아직 단정 지을 순 없지만, 다른 시민들과는 뭔가 다른 것 같아"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "바바라에 대해…",
      "text": "바바라는 계속 내 옆에 붙어서 예배드리고 성가대에 서라고 안달이야. 설마 빅토리아가 보낸 건가?"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "진에 대해…",
      "text": "본인의 일 말고도 남의 뒤치다꺼리까지 하다니. 존경스러운 여자야"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "알베도에 대해…",
      "text": "그는 마치 낡은 방에 걸려 있는 유화 그림 같아…. 무게감 있고, 신비롭고, 속을 들여다볼 수 없지. 사연 있는 사람을 싫어하진 않아"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "리사에 대해…",
      "text": "근무 중에 게으름 피우는 사람은 싫어. 하지만 정시 퇴근하고 싶어하는 그녀의 마음은 이해가 돼"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "클레에 대해…",
      "text": "사건 사고를 몰고 다니는 아이야. 귀여운 사고뭉치긴 하지만"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "바르카에 대해…",
      "text": "좋은 뜻인 건 알지만, 영감처럼 잔소리가 심해. 그 녀석, 자기 사람들은 엄청 챙긴다니까"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "아버지에 대해…",
      "text": "아버지? 정말 괴리감이 느껴지는 단어네. 나한텐 없다고 할 수도, 한 명이 아니라고 할 수도 있지. 음? 그렇게 놀랄 일인가?"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "달리아에 대해…",
      "text": "나서서 한턱내는 습관이 있는 훌륭한 친구지. 게다가 술자리에서도 정도를 알아. 뭘 물어봐야 할지, 뭘 물어보면 안 될지 잘 알고 있지. 서로의 패를 잘 아니까 과하게 경계할 필요도 없고, 똑똑한 사람과 사귀는 건 언제나 즐겁다니까"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "로자리아에 대해 알기·첫 번째",
      "text": "일하러 온 거니까 인사치레는 됐어. 감당 안 되는 문제는 나한테 넘겨"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "로자리아에 대해 알기·두 번째",
      "text": "신을 안 믿는다고 이상한 수녀는 아니야. 세상엔 돼지고기를 싫어하는 사냥꾼, 생선을 싫어하는 어부도 있잖아? 좋아하는 것만 할 수도, 싫어하는 걸 안 할 수도 없는게 바로 일이지"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "로자리아에 대해 알기·세 번째",
      "text": "한잔할래? 이건 올해 만든 민들레주야. 맛이 아주 좋아"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "로자리아에 대해 알기·네 번째",
      "text": "몬드는 오래됐지만 어린 하얀 야수야. 누군가 보호해 줘야 할 만큼 오래됐지만, 아직 어려서 홀로서기는 할 수 없지. 오직 이런 곳만이 날 필요로 해. 이곳에선 다른 수녀들이 시민을 보살피는 것처럼 나도 몬드를 자유롭고 평안하게 보살필 수 있거든. 왜 하얀색이냐고? …내가 검은색이니까"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "로자리아에 대해 알기·다섯 번째",
      "text": "난 가끔 지난날들의 내가 존재하고 있음을 느껴…. 또 나 자신에게 기대해왔다는 것도… 너도 이런 느낌을 받은 적이 있을 거야. 그러니까 오늘날의 네가 전혀 다른 길을 가고 있더라도 절대 과거의 자신을 부정하지 마. 예전의 네가 오늘의 널 만든 거니까. 과거를 두려워 말고 용감하게 맞서봐"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "로자리아의 취미…",
      "text": "술은 적당히 마시면 기분 좋아져. 가끔 알코올로만 해결되는 근심거리가 있지. 난 절대 취할 일 없겠지만"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "로자리아의 고민…",
      "text": "휴… 다음 달 합창 행사엔 정말 나가기 싫은데 빅토리아가 직접 호명했어…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "와인에 조린 짐승고기 먹어봤어? 알코올과 고깃덩어리가 한 접시에 담겨있는 자태라니, 얼마나 근사한지 몰라"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "가, 감자전을 과일잼에 찍어 먹는다고? 말도 안 돼!"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "우린 입맛이 비슷한 거 같네"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "배는 채울 수 있겠어"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "너 이런 음식에 관심 있어?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘이 네 생일이네. 처리할 사람이나 일 같은 거 없어? 내가 도와줄게. 다른 사람한텐 비밀이야"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "음, 나쁘지 않네"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "뭐 도와줄까? 지금 한가한데"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "그래. 실력이 늘면 효율이 높아지니까"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "전투와 살육에 능숙한 나도 이렇게 강한 힘은 처음이야…. 고마워"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "흐앗!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "심판한다!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "도망칠 생각 마!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "처단한다!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "두려움에 떨어라!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "잘 자…"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "…괜찮은 것도 있네"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "뭐, 그렇게 귀찮진 않아"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "기분 좋군"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "의외로군…. 흥"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "잔업 좀 해야겠는걸"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "제법인데!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "물러서!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "넌 할 만큼 했어!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "이걸로 됐어…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "이게… 운명일지도…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "윽… 여기까진가…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "별것도 아니네"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "쳇, 귀찮아 죽겠네!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "또 일거리가 생긴 건가?"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "같이 잘해보자고"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "후… 최대한 빨리 끝내야지"
    }
  ]
}