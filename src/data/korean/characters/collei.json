  "outfits": [
    {
      "id": 206700,
      "name": "돋아난 신엽",
      "description": "콜레이의 코스튬. 이제 더 이상 무거운 망토 아래에서 움츠리고 있을 필요 없다. 새로 자라는 잎사귀처럼 기지개를 활짝 켜고 새로운 아침을 맞이하자",
      "isDefault": true,
      "characterName": "콜레이",
      "characterId": 10000067,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Collei_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "숲의 견습 순찰자 콜레이, 대령이오! 숲에 있는 동안 너의 안전을 책임져줄게——휴우, 드디어 이 등장 대사를 말할 기회가 생겼네. 잘못 말하진 않았겠지…"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·숲 순찰 루트",
      "text": "오늘의 숲 순찰 루트는… 먼저 여기로 갔다가 저기로 간 다음… 흠, 글자가 참 많네…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·컨디션",
      "text": "후, 오늘따라 컨디션이 좋은걸. 이참에 일을 많이 해야겠어"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·회상",
      "text": "아무것도 안 하면 별생각을 다 하게 돼——음, 말하자마자 안 좋은 일이 생각났어…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 그친 후…",
      "text": "비는 그쳤지만 물웅덩이를 조심하는 게 좋을 거야. 마치 계속 기억에 남는 과거와도 같으니까… 크흠!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "번개가 칠 때는 큰 나무를 피하는 것이 좋아. 숲의 순찰자는 산불 예방을 위한 현장 점검을 각별히 주의해야 돼"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "날씨 참 좋네. 햇볕을 쬐면 건강에 좋아"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "응, 바람이 딱 적당해. 엠버라면 이런 날 자신의 한계에 도전하겠지?"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침! 하암… 미안, 어제저녁에 또 보충 수업받느라…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "숲을 순찰하는 노선이 길면 점심에 못 돌아오는 게 당연해. 「포켓 피타」를 좀 넉넉히 챙겨왔는데, 먹을래?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "날이 어두워지고 있으니, 숲을 지날 때 더욱 조심해야 돼"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "이제 쉬려고? 모닥불을 피워놓았어. 내가 불침번을 설게"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "콜레이 자신에 대해·숲 순찰",
      "text": "수메르에 오기 전에 야외에서 떠돌이 생활을 했었어. 먹을 수 있든 없든 몇 번이고 입에 넣어 봐서 야외 생활은 익숙한 편이야. 그래서 이곳에 온 뒤로 숲을 순찰하게 된 거지. 「야외 생존」 과목이 있다면 합격할 자신 있어… 음, 필기시험만 없다면 말이야"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "콜레이 자신에 대해·보충 수업",
      "text": "어? 매일 무슨 공부를 하냐고? 훌륭한 스승님 밑에서 엄청 심오한 지식을 배우는 건 아니냐고…? 어… 내가 배우고 있는 건… 《티바트 글자 첫걸음》이야…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·옛 친구",
      "text": "엠버의 편지를 통해 네 이야기를 많이 들었지만, 몬드에서 그렇게 많은 일이 있었을 줄이야. 띄엄띄엄 읽는 바람에 놓친 부분이 많거든… 음, 네가 다시 들려줄 수 있을까?"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·새로운 친구",
      "text": "「친구」 같은 건 나랑 상관없는 이야기라 생각했어. 몬드에 가기 전까지는 말이지…. 나중에 수메르에서 스승님을 만났고, 지금은 널 만났잖아. 역시 난 행운아야"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "하아… 나도 신의 눈을 얻게 될 날이 올 줄이야. 신은 날 때부터 사랑받아온 사람만을 눈여겨볼 거라고 생각했었는데… 음, 내… 내가 편견이 심했다는 건 인정할게. 내가 틀렸었어"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기·기술 이름",
      "text": "스승님이 가장 효과적인 공부는 실천이라고 하셔서 더 많은 글자를 익히기 위해 라이트 노벨을 읽곤 해…. 스승님의 논문보다는 잘 읽히거든. 최근에 읽은 책이 있는데 주인공 능력이 어찌나 많은지. 능력 이름이 죄다 내가 모르는 단어야…. 음? 책 이름? …《귀무도》였을걸? 너도 읽어봤어?"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "하고 싶은 이야기·봉인의 힘",
      "text": "으아… 「봉인된 힘이 들끓고 있어」라든지… 「나한테서 멀리 떨어지는 게 좋을 거야」라든지… 이나즈마 사람은 어떻게 이런 말을 아무렇지 않게 할 수 있지? 민망하지도 않나? 아… 안 되겠어, 더는 못 읽겠어!"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "화초와 동물…? 식용 가능 여부를 제외하면 큰 차이는 없는 것 같아. 쉿, 스승님이 들으면 안 돼. 나 같은 경우에는 구멍이 있는 나무를 좋아해. 특히 「어디에 들어가 있고」 싶을 때 말이야…. 누구나 그럴 때 있잖아? 안 그래?"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "타이나리에 대해…",
      "text": "스승님이 평소에 엄하시고 독버섯 먹는 모험가를 비난하시긴 해도 사실 자상한 분이야. 정성껏 보충 수업도 해주시고 몬드에서 온 편지도 읽어주시거든. 스승님께 정말 감사해!"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "도리에 대해…",
      "text": "어느 날 숲을 순찰하다 만났는데 내가 목마른 걸 알고 있다는 듯이 주머니에서 맛있어 보이는 주스를 꺼내는 거야…. 스승님이 옆에서 그 사람을 막아서 다행이지 하마터면 여태껏 힘들게 모은 모라를 다 써버릴 뻔했어…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "작은 쿠사나리 화신에 대해…",
      "text": "풀의 신…? 어릴 때 신에게 큰소리로 묻고 싶었어. 왜 나에게 그런 시련을 준 거냐고. 휴, 어쩌면 신도 속수무책인 일들을 겪고 있을지도 몰라"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "사이노에 대해…",
      "text": "아… 그분 얘기는 안 하면 안 돼? 아니, 대풍기관은 나쁜 사람이 아니야. 그가 날 몬드에서 수메르로 데려온 덕분에 안식처가 생긴 거니까. 다만 수메르로 돌아오기 전의 그 「봉인」 과정만 생각하면… 윽… 목덜미가 찌릿해져…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "카베에 대해…",
      "text": "대풍기관이 그를 데려와서 같이 식사한 적이 있어. 식전 과일이 나오자마자 인정사정없고 고집불통인 룸메이트 얘기를 하기 시작하는데 끼어들 틈도 없더라니까. 식사 내내 웃음을 꾹 참고 고개만 끄덕였어. 휴, 정말 힘들었지"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "닐루에 대해…",
      "text": "그 사람은 항상 몽롱해 보여. 간다르바 성곽 인근에 공연하러 온다면 숲에서 길을 잃게 될 것만 같아…. 숲의 견습 순찰자로서 잘 지켜봐야겠어"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "엠버에 대해…",
      "text": "엠버는 정말 대단해. 열정적이고 활발한 데다, 용감하고 정의롭기까지…. 내가 가장 존경하는 사람이야! 항상 불처럼 다른 사람을 밝혀주거든. 엠버가 아니었다면 지금의 난 없었을 거야…. 시간이 많이 흐른 지금, 더 성숙해지고 멋있어졌겠지? 언제쯤 엠버를 따라잡을 수 있을까?"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "케이아에 대해…",
      "text": "몬드 사람들은 다들 괜찮을까? 그때 내가 말썽을 참 많이 일으켰거든. 언제 찾아가서 사과해야 하나…. 음, 내가 나타나면 기병대장이 놀려댈 것 같아…. 좀 더 기다려보자, 응…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "리사에 대해…",
      "text": "오랜 시간이 지났는데도 리사는 편지에서 여전히 날 「꼬마 콜레이」라고 불러. 뭔가 좀… 응? 너한테도 귀염둥이라고 한다고? 풉… 미안. 웃으려고 한 건 아닌데… 기분이 훨씬 좋아졌어"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "피슬에 대해…",
      "text": "…「단죄의 황녀」? 미안, 몬드에 머문 시간이 길지 않아서 그런 사람은 들어본 적 없어. 근데 이 이름… 스읍… 크흠, 아니야"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "파루잔에 대해…",
      "text": "어… 솔직히 난 그분을 대하는 게 좀 어려워…. 나한테 자꾸 공부 열심히 한다고 칭찬해 주시는데, 그건 내가 배우는 게 느리니까 어쩔 수 없이 보충하는 거란 말이야! 게다가 한번은 그분의 연구 노트를 슬쩍 보게 됐는데, 세상에, 그건 수메르에서 가장 무시무시한 책이었어! 온통 고대 문자로 가득해서 글자 하나 못 알아보겠더라니까"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "콜레이에 대해 알기·첫 번째",
      "text": "내 이야기? 수메르에 오기 전의 일을 듣고 싶다면… 음, 그냥… 엠버에게 편지로 물어볼래? 아, 안 돼. 케이아에게 걸리면 끝장이야…. 아니, 분명 어떻게든 알게 될 거야! 그, 그냥 내가 말할게. 후——미안해! 며칠만 더 마음의 준비를 하게 해줘…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "콜레이에 대해 알기·두 번째",
      "text": "유랑하던 중 몬드에 가게 됐을 때 엠버 일행에게 해서는 안 될 말을 많이 했어. 지금 돌이켜보면 정말 부끄러워…. 나도 참, 날 도우려던 사람에게 어떻게 그런 말을 한 거지? 그들이 날 어떻게 생각했을까? 생각만 해도… 윽, 미안해. 오늘은 여기까지만 하면 안 될까? 아니면 내일… 방금 한 말을 또 후회할 거야"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "콜레이에 대해 알기·세 번째",
      "text": "「비늘병」 때문에 「도토레」에게 보내져서 치료받은 적이 있어…. 아니, 치료가 아니라 「실험」이었지. 그런 환경에 오래 있다 보니 내가 대체 뭘 잘못한 건지, 왜 아무도 날 구하러 오지 않는지 궁금해지더라고…. 그렇게 점점 「우인단」 외의 사람들도 미워졌어. 지금 생각해보면… 참 유치하지"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "콜레이에 대해 알기·네 번째",
      "text": "「비늘병」이 사라진 건 다 너희 덕분이야. 전에는 상상도 못 했던 기적이지. 응… 완치는 기대도 안 했어. 몸을 쓸 수 없게 되기 전에 더 많은 일을 하고 싶은 생각뿐이었지. 복수에서 시작해 숲의 순찰자가 되었고… 이제 마침내 자유로워졌어"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "콜레이에 대해 알기·다섯 번째",
      "text": "넌 계속 여행할 거야? 나도 힘을 보탤 수 있게 열심히 배울게…. 글공부, 의술 공부, 전투, 위험 조사… 거기에 가로등 점검 같은 소소한 일까지! 나처럼 더 많은 사람이 도움받았으면 좋겠어——네가 날 구해준 것처럼"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "콜레이의 취미…",
      "text": "내 취미는… 바느질, 비행 연습, 그리고 타인을 돕는 거야! 응? 어디서 들어본 말 같다고? 왜냐하면… 나도 「타인을 밝혀주는 사람」이 되고 싶거든!"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "콜레이의 고민…",
      "text": "「현재… 농작물 품종의… 단일화… 현상을 막고… 장기간의 균류 섭취를 막기 위한… 수입 조치는…」 이게 다 무슨 소리야? 왜 아카데미아 논문은 「버섯 먹기 싫다」는 말을 이렇게 복잡하게 하는 거냐고!"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "「포켓 피타」는 휴대가 간편하고 포만감을 줘. 아마 내가 제일 자주 먹는 음식일걸? 배 채울 걱정 안 해도 된다면, 내가 제일 좋아하는 음식은… 음, 「무완자 튀김」이야"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "떠돌이 생활할 때 배고프면 고리고리 열매를 쪼개서 먹을 정도였으니 특별히 싫어하는 음식은 없어. 굳이 꼽자면, 손대지 않는 건 버섯뿐이려나? 맛 때문이 아니라 스승님한테 비난받는 당사자가 되고 싶지 않거든…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "음——진짜 맛있다! 나도 가르쳐주면 안 돼?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "이 정도 실력이면 밖에서 떠돌이 생활을 해도 굶을 일은 없겠어"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "미안, 스승님이 이상한 음식은 먹지 말랬어"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "생, 생일 축하해! 내가 준비한 케이크야. 이건 여분의 양초고… 엠버가 편지에서 이렇게 준비하면 된댔는데… 아, 그, 그리고 이건 네 선물이야!\\n…미안해, 생일파티를 해본 경험이 없어서 마음에 들지 모르겠네…. 너무 허술하지? 마음에 안 드는 게 있으면 말해줘. 내년에 더 잘해줄게!"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "내가 발전하고 있는 건가?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "이제… 더 이상 예전의 내가 아닌 것 같아"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "죽음의 문턱까지 가더라도 더는 「그것들」의 힘에 의지하지 않아"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "지금의 난 봉인된 힘을 풀어도 자유롭게 조종할 수 있지 않을까? 핫!\\n——농담이야. 너랑 고생하며 모험한 경험이야말로 지금 내가 가진 힘이지"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "가라"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "날아봐"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "이얍"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "부탁할게, 콜린엔바!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "이, 이거나 먹어!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "춤추자!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "야외에서는 항상 보급에 신경 써야 돼"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "정말 운이 좋네"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "음… 상자에 독버섯이 자란 건 아니겠지"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "아직… 버틸 수 있어!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "이 정도 고통은 끄떡없지!"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "빨리… 치료해야 돼…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "안전이 우선이야!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "이 상태로 가다간 큰일 나"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "훌륭한… 숲의 순찰자가 돼야 해"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "여기서… 쓰러지다니…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "결국… 이날이 왔군…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "어째서…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·두 번째",
      "text": "나한테 손대지 마!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "파티 가입·첫 번째",
      "text": "내가 지켜줄게"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "파티 가입·두 번째",
      "text": "준비 완료, 출발하자!"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "파티 가입·세 번째",
      "text": "숲의 견습 순찰자 등장!"
    }
  ]
}