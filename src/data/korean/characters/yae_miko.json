  "outfits": [
    {
      "id": 205800,
      "name": "미코의 말씀",
      "description": "야에 미코의 코스튬. 나루카미 다이샤의 고귀한 무녀의 신분을 나타낸다. 순백의 의복 위에 그려진 영원히 시들지 않는 신성한 벚나무의 꽃처럼 그녀의 아름다움도 영원하길",
      "isDefault": true,
      "characterName": "야에 미코",
      "characterId": 10000058,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Yae_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "첫 만남…",
      "text": "난 나루카미 다이샤의 궁사야. 네 일거수일투족을 확인하고자 방문했지. 이는 다이샤의 명이니… 훗, 그렇게 긴장할 거 없어. 겉치레 말일 뿐이니까. 그래야 쉴 수 있는 정당한 명분이 생기지. 자, 어서 나한테 재밌는 일을 보여줘"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·창의적 글쓰기",
      "text": "최근 야에 출판사에 이세계 전이물이 너무 많아. 흥, 자기들이 속한 세계에 그렇게 불만이 많은 건가?"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·이야기",
      "text": "대다수 사람들의 일생은 글로 적어도 겨우 몇 줄이야. 따분한 이야기들뿐이지"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·속세",
      "text": "난 변하지 않는 것도 일종의 아름다움이라고 생각해. 휴, 하지만 속세에 변하지 않는 게 있을까?"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "비가 내린 후엔 온몸의 털이 다 축축해져…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "천둥을 무서워하는 사람이 많지. 하지만 난 천둥소리가 아주 친근하게 느껴져"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "아직 지혜가 없는 여우는 눈밭에 머리를 묻고 먹이를 찾지… 나의 그런 모습을 보고 싶다고? 훗"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "좋은 아침. 기운이 없어 보이네. 어제 잘 못 잤어? 어머, 설마 간밤에 나쁜 짓이라도 하러 갔다 왔니?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "음~ 고민이야. 점심에 뭐 먹지? 유부는 질렸고 담백한 게 먹고 싶은데. 그러고 보니 야시로 봉행의 아가씨를 못 본 지도 꽤 됐네. 그 애가 만든 디저트를 먹으러 가자"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "오늘처럼 달빛이 청아한 날을 그냥 보내긴 아깝지. 나랑 같이 달밤의 산책이라도 갈래? 거절은 거절할게"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "잠에 들 시간이야. 하, 밤에 천둥소리가 안 들리면 잠도 편하게 못 잔다니까"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "야에 미코 자신에 대해·영원함",
      "text": "영원이란 건 지금 갖고 있는 걸 잃지 않는 거야. 다른 관점으로 보면, 더 많은 걸 손에 넣을 가능성도 포기하는 셈이지. 하지만 세상일이 다 그렇듯이, 모든 걸 손에 넣을 순 없어"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "야에 미코 자신에 대해·취미",
      "text": "인간은 재밌어. 그래서 난 인간이 좋아. 짧은 생을 살지만 한낮의 태양처럼 환한 빛을 내잖아. 어떤 빛은 오랜 시간이 흘러도 꺼지지 않지. 그런 인생을 읽는 건 즐거운 일이야"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·작가",
      "text": "재미없어. 이 책도 따분하기 그지없군. 휴, 이 사람들은 대체 왜 작가가 된 거야? 참, 네 경험을 써서 야에 출판사에 투고해 볼래? 나도 재미 좀 볼… 분명 잘 팔리겠지"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·마모",
      "text": "자신을 가두면 더 빠르게 「마모」될지도 몰라. 거울로 삼을 수 있는 사람 하나 없이 혼자만 있는 세계가 얼마나 끔찍한데… 우리가 함께 있을 때 서로를 비춰주는 건 아주 중요한 일이야"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "내가 「신의 눈」을 착용하는 방식이 맘에 든다고? 보는 눈 있구나. 그럼… 한번 만져볼래?"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "기름이 8할 정도 열이 오르면 두부를 넣고 약한 불로 줄여. 그리고 황금빛으로 튀겨질 때까지 기다렸다가 건져내면 돼. 이 세상에 따끈따끈한 유부보다 맛있는 건 없을 거야. 음? 만드는 법은 다 가르쳐줬는데 왜 아직도 멍하니 있어?"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "나루카미 다이샤에선 고개를 들면 언제나 보이니까, 가끔 지겨울 때도 있지. 그 신성한 벚나무는 나와 운명으로 엮였으니 어쩔 수 없어"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "라이덴 쇼군에 대해…",
      "text": "나오고 싶으면서 자기 자신을 일심정토에 가두는 건 고문이나 마찬가지지…. 다른 관점에서 보면 나름 귀엽기도 하지만"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "카미사토 아야토에 대해…",
      "text": "야시로 봉행 가문의 그 녀석은 어렸을 때부터 얌전하지 않았어. 겉으론 친절한 미소를 띠고 있지만, 속으론 무슨 생각을 하는지 모르겠다니까. 정말 짜증 나…. 흥, 우리가 같은 부류라니? 동족 혐오란 말은 당치도 않아"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "카미사토 아야카에 대해…",
      "text": "난 야시로 봉행의 그 소녀가 참 마음에 들어. 무슨 일이든 똑 부러지게 처리하잖아. 근데 야시로 봉행은 항상 고생만 하고 좋은 소리는 못 듣는 일만 해. 가엽기도 하지. 카미사토 가문 사람이 아니었으면 진작 야에 출판사로 데려왔을 텐데"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "쿠죠 사라에 대해…",
      "text": "그 어리석은 텐구는 아버지에 비하면 너무 아둔해… 뭐랄까, 무뚝뚝하고 솔직한 것도 나름의 장점이 있지만… 아무튼 앞으론 신사에서 날 가로막고 에이에 대해 캐묻지 않았으면 좋겠어"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "요이미야에 대해…",
      "text": "나가노하라의 폭죽은 일상 속에서 그나마 매년 기대되는 거라고 할 수 있어. 며칠 전에 그 애가 텐료 봉행 부지에서 폭죽을 터트리며 난리를 쳤다지. 후후, 쿠죠 가문 사람은 얼굴이 새빨개질 정도로 화났을 거야. 그 장면을 직접 못 봐서 너무 아쉽네"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "감우에 대해…",
      "text": "그러고 보니 감우 언니를 안 본 지도 오래됐네. 이나즈마에 쇄국령이 실시되기 전에 리월과 이나즈마 사이의 교류는 전부 나랑 감우 언니가 만나서 의논하곤 했는데, 어찌나 믿음직하던지. 다음에 리월에 갈 기회가 생기면 신선한 바다 불로초를 더 가져다줘야겠어"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "산고노미야 코코미에 대해…",
      "text": "지금의 무녀들은 하나같이 귀엽다니까. 그 아이가 태평 신악의 춤을 추면 어떤 모습이려나. 물고기들도 같이 춤출지도 몰라. 미코 언니라고 불러준다면, 후후… 내 노하우를 공유해줄 텐데"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "쿠니쿠즈시에 대해…",
      "text": "그때부터 그게 골치 아프다고 생각했어. 하지만 그녀는 자기가 만든 것이니 건드리고 싶지 않다고 했지. 이렇게 될 줄 알았다면 그때 몰래 처리해버릴걸. 지금? 하하… 지금은 너무 늦었어"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "아라타키 이토에 대해…",
      "text": "아~ 오니족의 그 이상한 녀석? 하, 쿠죠 가문에 말썽을 많이 피웠다고 들었어. 텐료 봉행이 풍기를 해친다는 이유로 그가 거리에 적은 글을 지우려고 했지만, 내가 사람을 시켜서 남겨뒀어. 후후, 그렇게 재밌는 녀석은 요즘 보기 드물잖아"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "고로에 대해…",
      "text": "고로의 꼬리는 빛깔이 아주 예뻐. 하지만… 내 꼬리가 더 부드럽단다, 후후…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "사유에 대해…",
      "text": "키 작은 꼬마가 요리조리 잘도 숨던데? 그 아이를 찾는 데 너무 오래 걸려서 소설 볼 시간이 줄었다고 카노 나나가 종종 불평했어. 글쎄, 누가 몰래 사유를 도와주는 게 아닐까?"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "쿠키 시노부에 대해…",
      "text": "미유키한테 개성 넘치는 여동생이 있다고 들었어. 무녀 가문에서 태어났지만, 신사를 떠나 다양한 기술을 배워서 리월에 유학도 갔다가 결국 아라타키파에 들어갔다지…. 이렇게 재밌는 아이는 꼭 미유키한테 소개해달라고 해야지. 응, 미유키는 거절하지 않을 거야"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "키라라에 대해…",
      "text": "요즘 인간 사회에 관심을 갖는 요괴들이 늘어나고 있어. 좋은 변화라고 해야 할까? 내 생각은 어떠냐고? 후후, 그야 즐길 수 있을 때 즐기라고 해야지. 게다가 순순히 한턱내겠다는 후배를 누가 싫어할 수 있겠어?"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "유메미즈키 미즈키에 대해·사업 경쟁",
      "text": "「마음이 지친 사람은 소설이 눈에 안 들어온다」고? 휴, 우리 「야에 출판사」는 글렀어. 소설의 재미가 부족하니까 여태 미즈키의 인정을 못 받은 거야. 우리 편집자랑 작가에게 조금만 더 시간을 줘. 앞으로의 작품도 인정을 받지 못한다면, 무능한 편집장으로서 직접 미즈키를 위한 소설을 쓰는 수밖에. 제목은… 음, 「바쿠의 꿈」이라고 할래"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "유메미즈키 미즈키에 대해·재회",
      "text": "미즈키가 이나즈마에 막 돌아왔을 땐, 늘 근심이 가득해 보였어. 길에서 날 봐도 일부러 시선을 피하고… 나? 나도 당연히 먼저 말 안 걸었지. 그 삐딱한 모습을 좀 더 보고 싶었거든. 내 생각이 맞다면, 우리가 엇갈린 다음에 미즈키는 고개를 돌려 날 흘겨봤을 거야…. 그때 나도 돌아봤으면 미즈키는 깜짝 놀라서 도망쳤을걸. 원래 모습으로 변해서 귀를 이렇게 부여잡고 말이야.\\n근데 요즘은… 가십 월간지의 독자 사연란에서 날 비꼬기까지 하더라. 바쿠는 참 빨리 큰다니깐"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "야에 미코에 대해 알기·첫 번째",
      "text": "나에 대해 더 많이 알고 싶다고? 안 될 건 없지만, 오는 게 있으면 가는 것도 있어야지. 나에 대해 알고 싶다면, 너의 이야기로 교환하는 게 어때?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "야에 미코에 대해 알기·두 번째",
      "text": "호재궁님은 어디 멀리 좀 다녀오신다면서 다시는 돌아오지 않으셨지. 휴, 그땐 나루카미 다이샤의 귀찮은 일을 넘겨받고 싶지 않았는데, 신사의 궁사가 되면 유부를 마음껏 먹을 수 있다고 하셨어. 그런 이유로 설득당할 리 없잖아. 시끄럽고 골치 아픈 여자라니까…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "야에 미코에 대해 알기·세 번째",
      "text": "처음 야에 출판사를 세운 이유는 재밌는 소설을 보기 위해서였어. 나중엔 소설가들이 아등바등하는 걸 지켜보는 재미로 변했지만…. 넌 그들이 원고를 미룰 때 어떤 변명을 하는지 상상도 못 할 거야. 자기들이 쓰는 소설보다 재밌다니까?"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "야에 미코에 대해 알기·네 번째",
      "text": "마신도 언젠가는 사라져. 시간이 흘러 그들의 이야기도 함께 사라져서 아무도 기억을 못 하면 너무 안타깝잖아. 뛰어난 구상과 필력을 가진 자만이 그들의 이야기를 쓸 자격이 있어…. 세상에 그런 사람이 없다면… 그 이야기들을 쓸 수 있는 작가를 키워내야지"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "야에 미코에 대해 알기·다섯 번째",
      "text": "그러고 보니 다른 사람의 소설은 많이 봤지만, 정작 내가 써본 적은 없네. 소설 쓰는 건 꽤 성가신 일이잖아. 그래도 언젠가 네 모험이 끝났을 때 네 이야기를 기록할 사람이 필요한데 마침 내가 시간이 된다면…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "야에 미코의 취미…",
      "text": "내가 제일 좋아하는 건 다른 사람들의 이야기고, 두 번째로 좋아하는 건 타인이 고뇌하는 모습을 보는 거야. 둘을 합치면, 하하, 그 재미는 배가 돼"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "야에 미코의 고민…",
      "text": "평화로운 일상은 너무 따분한 것 같아…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "「키츠네 우동」이라고 알아? 사실 그냥 유부를 넣은 우동이야. 어때, 유부를 넣은 우동이라니, 듣기만 해도 맛있을 것 같지?"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "아니, 절인 음식은 싫어. 절인 구피든 키비악이든 참을 수 없는 악취가 나지 않니? 나루카미 다이샤의 궁사로서 그런 부정한 걸 입에 넣을 순 없어"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "어머, 꼬마야, 내 취향을 잘 알고 있네?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "네가 직접 만든 거니까 한번 먹어봐야겠어, 후후…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "흠… 꼬마야, 좀 더 분발해야겠는걸?"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘이 네 생일이구나…\\n「그대의 탄생을 축복하며 명하나니, 그대가 구하는 것을 얻고 원하는 것을 이루리라. 올곧은 마음을 가진 자에겐 신의 가호가 있을지니.」 됐어, 올해는 모든 일이 잘 풀리고 원하는 걸 얻길 바라"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "무녀의 수행 단계는 수련을 졸업하고 제사의 구절을 정확하게 낭송할 수 있으면 「직계」 단계라고 해. 인간에겐 쉽지만 여우족에겐 가장 어려운 단계지… 그야 여우니까"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "궁사 대행, 그러니까 「정계」의 수행은 아주 힘들어. 많은 규율을 지켜야 하거든. 수행의 비결은 오직 하나, 밤에 몰래 뭘 먹을 때 들키지 않는 거야"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "「명계」로 올라가면 천지를 살필 수 있는 경지에 올라 세상만사를 꿰뚫어 볼 수 있어야 돼. 이 경지에 오르면 보통 신의 눈을 받게 되고, 평범한 여우족보다 훨씬 긴 수명을 얻지"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "나루카미 다이샤의 「청계」는 예로부터 나루카미 다이샤의 궁사 단 한 명만 얻을 수 있었어. 사실 그냥 명예직 같은 거야. 실력과는 별 상관없어. 하지만 내가 실력이 가장 뛰어난 「청계」라고 해도 안 될 건 없지"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "율령"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "주술"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "칙명!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "원소전투 스킬·네 번째",
      "text": "나타나라"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "원소전투 스킬·다섯 번째",
      "text": "형상을 남기리"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "원소폭발·첫 번째",
      "text": "진실의 눈동자!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "원소폭발·두 번째",
      "text": "고요한 뇌정!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "원소폭발·세 번째",
      "text": "뇌광이 애처롭구나"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "보물상자 오픈·첫 번째",
      "text": "재미있는 물건이라도 있어?"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "보물상자 오픈·두 번째",
      "text": "이게 다인가…?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "보물상자 오픈·세 번째",
      "text": "어서 열어봐"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP 부족·첫 번째",
      "text": "이러면 곤란한데"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP 부족·두 번째",
      "text": "장난은 여기까지"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP 부족·세 번째",
      "text": "좀 진지해져야겠는걸?"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "동료 HP 감소·첫 번째",
      "text": "무리하지 마"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "동료 HP 감소·두 번째",
      "text": "나한테 맡겨"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "전투 불능·첫 번째",
      "text": "아, 장난이 좀 과했네…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "전투 불능·두 번째",
      "text": "처참한 결과야…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "전투 불능·세 번째",
      "text": "여기서 멈추면 영원을 논할 자격이 없지…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "일반 피격·첫 번째",
      "text": "이게 다야?"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "강공격 피격·첫 번째",
      "text": "귀찮아 죽겠네…"
    },
    {
      "id": "600001",
      "type": 2,
