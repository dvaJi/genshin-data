  "outfits": [
    {
      "id": 207701,
      "name": "비와 대나무의 노래",
      "description": "요요의 코스튬. 드리워진 새순의 그림자가 책상을 두드리네. 바람인가 하고 보니, 손님이구나",
      "isDefault": false,
      "characterName": "요요",
      "characterId": 10000077,
      "source": [],
      "filename_card": "UI_AvatarIcon_YaoyaoCostumeWinter_Card",
      "filename_icon": "UI_AvatarIcon_YaoyaoCostumeWinter",
      "filename_iconCircle": "UI_AvatarIcon_YaoyaoCostumeWinter_Circle",
      "filename_splash": "UI_Costume_YaoyaoCostumeWinter",
      "filename_sideIcon": "UI_AvatarIcon_Side_YaoyaoCostumeWinter"
    },
    {
      "id": 207700,
      "name": "밤톨과 계화꽃",
      "description": "요요의 코스튬. 요요의 부모님이 만들어준 짧은 웃옷으로, 요요는 사부님이 선물한 선인의 방울과 함께 착용하고, 경책 산장과 리월항 사이를 오간다",
      "isDefault": true,
      "characterName": "요요",
      "characterId": 10000077,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Yaoyao_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "첫 만남…",
      "text": "잘 부탁해, 난 요요야. 운 좋게 사부님을 만나 가진낭시진군님의 제자가 되었어. 여행하다 힘든 게 있으면 날 불러줘! 참, 나한테 무완자 튀김이 있는데 좀 먹어봐! 하지만 많이 먹으면 안 돼. 기름진 걸 많이 먹으면 몸에 부담이 되니까. 혹시 모자라면 깨끗하게 씻은 무랑 식초도 챙겼으니까 무채무침을 해줄게"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "잡담·도리",
      "text": "「반복되는 내일, 내일은 얼마나 많이 있는가…」 아무튼 빨리 움직이자"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "잡담·참견",
      "text": "저기서 뭔가 움직이는 것 같은데, 몰래 보고 오면 괜찮겠지!"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "잡담·선인의 도",
      "text": "이상하네. 왜 다들 자꾸 선인에 관해 묻는 거야? 선인은 어디에나 있잖아?"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "비가 올 때…",
      "text": "들어봐, 개구리 우는 소리가 꼭 빗소리에 반주를 넣는 것 같지 않아? 개굴개굴개굴~"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "번개가 칠 때…",
      "text": "으, 으악! 내, 내가 귀를 막아줄게. 무서우면 내 손을 꼭 잡아"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "눈이 올 때…",
      "text": "눈이 온다~! 우선 털외투, 두꺼운 모자랑 목도리를 입어. 자, 장갑도 잘 챙겼으면 이제 가서 눈사람 만들자!"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "햇살이 좋을 때…",
      "text": "날씨가 좋네. 우리 리월항 부두로 가보자"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "강풍이 불 때…",
      "text": "바람에 날아가지 않게 조심해"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "아침 인사…",
      "text": "일어날 시간이야~ 아침 다 차렸으니까 서두르… 어, 어? 좀 더 잔다고? 그래, 그럼 5분만 더 자는 거야? 5분 뒤에 다시 깨워줄게~ 에고, 이럴 줄 알았으면 일찍 자라고 할걸…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "점심 인사…",
      "text": "명심해~ 점심 먹은 뒤에는 바로 누워서 낮잠 자지 마. 바로 일어나서 모험하는 것도 안 돼. 다 소화에 안 좋거든"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "저녁 인사…",
      "text": "어? 이렇게 늦은 시간에 나가려고? 음… 언제 돌아올 거야? 늦었으니까 조심해야 해~"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "굿나잇…",
      "text": "잠자리 동화가… 저번에… 어, 어디까지 했더라…. 옛날부터… 삼안오현 선인이, 리월을 지키고 있었는데, 그, 그중… 쿨쿨…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "요요 자신에 대해·리월 부두",
      "text": "그거 알아? 리월항의 부두에는 항상 사람이 넘쳐서 시끌벅적해! 나뭇잎 떨어지는 소리도 들리는 우리 집이랑은 차원이 다르다니까! 그래서 난 시간 날 때마다 부두로 가. 새로 온 배, 따끈따끈한 소식… 그리고 새로운 장난감도 있거든!"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "요요 자신에 대해·풍족한 의식주",
      "text": "「재산이 풍족해야 예절을 알고, 먹고 입는 걱정이 없어야 영광과 치욕을 안다」라는 건, 밖에서도 밥을 잘 챙겨 먹고, 옷도 따뜻하게 입고… 어, 어? 그런 뜻이 아니라고? 그럼 무슨 뜻이야?"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "우리에 대해·창 연습",
      "text": "내가 게으른 게 아니라, 창이 너무 길고 무거워서 연습이 힘든 거야…. 그래도 사부님이 엄격하지 않아서 다행이지, 헤헤"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "우리에 대해·걱정",
      "text": "밥은 제때 챙겨 먹고 있어? 날이 추운데 옷은 따뜻하게 입었어? 모험할 땐 위험하지 않았어? 다치진 않았고? 아니다, 그냥 날 데려가. 야외에서 먹고 잔다니까 마음이 안 놓여"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「신의 눈」에 대해…",
      "text": "내 사부님은 삼안오현 선인이야! 사부님은 신의 눈이 신의 인정을 받은 거라는데, 난 아무것도 안 했거든? 그래서 신님한테 이유를 묻고 싶어!"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "하고 싶은 이야기…",
      "text": "오셀? 바닷속에 있는 엄청 큰 운래 문어 말하는 거야? 아니! 내가 먹고 싶다는 게 아니라, 그냥… 먹으려면 꼭 잘 구워서 먹으라구…. 그! 꼭 구우라는 건 아닌데, 단지… 단지 구워 먹으면 맛있을 것 같아서…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "흥미있는 일…",
      "text": "난 참새가 좋아. 치치한테 놀러 갈 때마다 보곤 하는데, 난 참새랑도 인사하거든! 짹짹짹♪~ 맞았어, 정말 똑똑하구나? 좋은 아침이란 뜻 맞아"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "향릉에 대해…",
      "text": "선배가 요즘… 이상한 식자재를 찾으러 가진 않았어? 저번에 운래 문어를 생으로 먹겠다고 해서 걱정했거든. 배탈 나면 어떡해? 백 선생님의 약도 안 먹으면서… 사부님이랑 겨우 말리긴 했지만, 또 다른 위험한 식자재를 눈독 들일까 걱정이야, 어휴…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "치치에 대해·좋은 친구",
      "text": "치치는 최고의 친구야! 가끔 날 잊어버리기도 하지만, 고의가 아니란 걸 알아. 메모를 보라고 하면 금방 떠올리거든"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "치치에 대해·평생",
      "text": "실은 나도 몰래 백 선생님께 치치를 치료할 수 있냐고 물어봤는데…. 응… 괜찮아. 평생 떠올려줘야 한다고 해도 난 좋아"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "백출에 대해…",
      "text": "백 선생님의 처방은 정말 효과가 좋아. 쓰긴 쓴데 이게 「입에 쓴 약이 병에는 좋다」겠지! 이해해! 엇, 넌 쓴 거 싫어해? 걱정하지 마, 여기 대추 꿀 절임이 있으니까 약 먹고 하나 먹으면 돼"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "감우에 대해…",
      "text": "감우 언니는 언제나 일이 많아. 저번에는 피곤해서 풀밭에 엎드려 잠들었다고 들었는데, 너무 걱정돼! 아니면… 「돌발 검사」를 해볼까? 언니가 몸을 제대로 챙기는지 확인하는 거야! 아… 잠깐만, 우선 감우 언니가 좋아하는 풀이랑 꽃부터 챙길게…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "각청에 대해…",
      "text": "각청 언니는 세심하고 꼼꼼해. 명절 때마다 사부님께 인사하러 오는데, 이게 바로 「스승의 그림자도 밟지 않는다」겠지? 아니면 「박문약례」가 어울리려나? …아무튼 나도 각청 언니를 본받아야지!"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "운근에 대해…",
      "text": "운근 언니는 창술이 정말 뛰어나. 게다가 리월극도 인기가 많아서 사부님이랑 종종 보러 가기도 하지. 운근 언니가 무대에 오르면 관중석이 꽉꽉 차서 정말 문전성시라니까…. 근, 근데… 언니가 부르는 가사는 무슨 뜻일까?"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "북두에 대해…",
      "text": "북두 언니의 배는 멋있어~ 감우 언니랑 배에 오르지 않기로 약속해서 그렇지, 벌써 어디에 잠자리를 꾸릴지까지 생각해 놨다구"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "신학에 대해…",
      "text": "신학 언니는 몇 년 동안 속세를 멀리했다가 모처럼 리월항으로 돌아온 거라 적응이 어려운 부분이 많을 거야. 나도 감우 언니를 도와서 같이 챙겨주고 싶은데… 어떻게 말해야 편안해할까?"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "연비에 대해…",
      "text": "연비 언니한테는 두꺼운 법전 한 권이 있는데, 휴가 때 사부님을 뵈러 올 때도 늘 챙겨오더라니까~ 그 무겁고 어려운 걸 계속 가지고 다니면서 읽는다니, 정말 대단해…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "한운에 대해…",
      "text": "전에 스승님을 찾아갔을 때 스승님이 엄청 우아하고 고상한 언니랑 수다 떨고 계셨어. 그분은 날 놀리시려고 본인을 「한운」이라고 소개하셨지만, 난 한눈에 류운 아줌마라는 걸 알아봤지! 스승님이 서먹한 느낌도 없이 엄청 즐거워 보이셨으니까, 오랜 친구인 게 분명하잖아!"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "프루네에 대해…",
      "text": "저번에 프루네가 나무 아래서 책을 읽다가 금방 잠들어 버렸어. 근데 잘 때 미간을 잔뜩 찌푸린 걸 보니, 꿈속에서 누구랑 싸우는 것 같더라. 사부님이 그러셨어. 「누구나 남에게 보이고 싶지 않은 약한 부분이 있다. 친구가 지쳤을 땐, 기댈 수 있는 어깨 하나만 빌려주면 된다」. 그래서 프루네 옆에 기대앉았더니, 한결 편하게 자더라"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "요요에 대해 알기·첫 번째",
      "text": "내 출신? 우리 부모님은 산에 은거하셔. 음, 따지자면 난 경책 산장 사람이겠지"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "요요에 대해 알기·두 번째",
      "text": "우리 집은 귀한 약초를 재배하면서 생활하는데, 부모님은 바쁘실 때 집안일이나 식사도 잊어버리실 때가 있어…. 어휴, 그래서야 되겠냐구! 그러니 내가 잘 챙겨야 해"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "요요에 대해 알기·세 번째",
      "text": "어렸을 때부터 산에서 자라서 동식물하고는 다 친해! 아, 참새랑 얘기하고 싶지 않아? 내가 대신 말도 전해줄 수 있어. 같이 가자, 재밌을 거야~ 우선 참새에게 줄 선물로 쌀부터 준비하면 돼!"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "요요에 대해 알기·네 번째",
      "text": "리월은 어디든 다 선인이야. 내가 다 봤는걸! 류운 아줌마, 리수 아저씨…. 난 류운 아줌마가 제일 좋아! 재밌는 선인의 물건을 선물해 주시면서 사용법도 자세히 알려주시거든!"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "요요에 대해 알기·다섯 번째",
      "text": "사부님을 만났을 때, 나에게 선연이 있다면서 제자로 거둬주셨어. 사실 선연이 뭔지 아직도 모르겠거든? 다만 모두랑 함께 지내면서, 사부님이 들려주시는 이야기를 듣고, 선배랑 게으름도 피우고… 그리고 리월항 사람들에게 도움이 될 수 있어서 난 만족해!"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "요요의 취미…",
      "text": "좋은 시간은 짧고, 아름다운 건 만나기 힘들구나! 재밌는 일이 있다면 꼭 가봐야겠지…. 내가 도울 수 있는 일이 있을지도 모르니까. 그치?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "요요의 고민…",
      "text": "아이고 아이고… 창술 연습은 정말 따분하다니까…. 월계랑 놀면서 잠깐 쉬어야겠다…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "좋아하는 음식…",
      "text": "경책 가정식이나 흥얼채, 생선전골… 이런 리월 현지의 요리는 맛도 좋고 따뜻한 분위기도 느낄 수 있어. 응? 너도 좋아한다고? 잘됐다. 그럼 다음에 우리 집에 와서 먹어, 내가 실력 발휘해줄게! 걱정 마. 선배의 요리도 도운 적 있는 훌륭한 「후기지수」니까!"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "싫어하는 음식…",
      "text": "한번은 신학 언니가 청심을 너무 많이 먹어서 며칠 동안 몸이 허해진 거야! 요요는 건강을 생각해서 청심을 생으로 먹지 않는데 말이야. 응? 그걸 어떻게 알았냐고? 류운 아줌마가 알려줬지!"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "선물 획득·첫 번째",
      "text": "너무 맛있어! 선배의 요리 솜씨랑 「막역지간」인데? 아니지, 「막상막하」였지! 이런 실수를 하다니, 정말 「유구무언」이야, 헤헤"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "선물 획득·두 번째",
      "text": "맛있네! 다음에 요리할 땐 나도 불러줘, 내가 도와줄게"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "선물 획득·세 번째",
      "text": "…으, 평소에 이런 걸 먹는 거야? 그냥 내가 해줄게! 밥을 제대로 먹어야 모험도 잘하지. 그러다 몸이 축나면 어쩌려고…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "생일…",
      "text": "오늘은 네 생일이니까, 풍습에 따라 장수면을 먹어야 해. 선배한테 배운 끊어지지 않는 긴 면에 아주 아주 둥근 달걀도 넣었어! 헤헤, 어서 따라와, 따뜻할 때 먹어야지. 새해에도 네가 건강하고 행복했으면 좋겠어"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "돌파의 느낌·기",
      "text": "어라? 창이 왜 가벼워졌지? 이참에 좀 더 짧아지면 더 좋을 텐데…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "돌파의 느낌·승",
      "text": "와, 이젠 선배의 창을 들 수 있을지도 모르겠어! 이 소식을 당장 사부님께 알리고 싶다~"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "돌파의 느낌·전",
      "text": "사람들이 말하는 「근면성실」이 이런 느낌이겠지? 응? 왜 그런 눈으로 보는 거야…?"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "돌파의 느낌·결",
      "text": "누가 챙겨준다는 게 이런 느낌이구나. 음… 오늘 내가 이렇게 성장할 수 있었던 건 다 네 덕분이야! 오는 정이 있으면 가는 정도 있는 법. 안심해, 내가 널 안전하게 지켜줄게!"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "원소전투 스킬·첫 번째",
      "text": "가라, 월계!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "원소전투 스킬·두 번째",
      "text": "맘대로 움직이면 안 돼!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "원소전투 스킬·세 번째",
      "text": "괜찮아, 괜찮아~"
    },
    {
      "id": "200001",
      "type": 2,
