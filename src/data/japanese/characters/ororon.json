  "outfits": [
    {
      "id": 210500,
      "name": "蝠翼の眼",
      "description": "オロルンの衣装。身の隠し方を熟知すべき予言者にとって、マントとフードは最高の武装だ。",
      "isDefault": true,
      "characterName": "オロルン",
      "characterId": 10000105,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Olorun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初めまして…",
      "text": "こんにちは。僕は「謎煙の主」のオロルンだ。野菜はいるか？野菜売りじゃないが、少し分けてあげてもいい。\\n心配しないでくれ。何か意図があるわけじゃないし、君から何か得ようとしているわけでもない。種が育ってどんな姿になるのかが知りたくて植えたら、どんどん増えてしまってな。喜んで食べてくれる人の胃袋の中で最期を迎えられたら、野菜たちも幸せだろう？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話・変人",
      "text": "謎煙の主は変人ばかりだと？僕一人だけだと思っていたんだが…他にもいるのか？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話・目標",
      "text": "誰もが好きな動物や野菜、あるいは果物を持つべきだと思う。そうすることで、自分がどんな人になりたいかが見えてくるんだ。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話・迷煙",
      "text": "すべての「迷煙」を通り抜けられるとは限らない。欲張りすぎると、かえって煙にむせてしまうことになる。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "走ると泥水がはねて裾が汚れるし、飛ぶと…雨に濡れたマントが重たくて仕方がない。とりあえず、どこかで雨宿りしよう。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "雷は蛇にも見える。その色と形から占いをする人もいるんだろうか…だとすれば、身の安全が心配だが。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "…雪の下に何かがいる。しーっ、驚かせないように。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "晴れの日…",
      "text": "太陽は永遠に燃え続ける炎の塊だ。ナタの人はそれを直視することを恐れない。もちろん、耐えられないならサングラスをかけてもいい。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "砂漠にいる時…",
      "text": "こんなところに種を植えても…育たないだろうな。他の場所にしよう。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "うぅん…起きはしたけど、まだ目は覚めきっていないんだ…用があるなら、後でもいいか？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "食事の時間だと胃袋が知らせているけど、食べたいものは思いつかない…まだ脳が眠っているんだろう。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "サウリアンサキュレント入りコーヒーソーダが飲みたいな。ミルクなしで。この時間にコーヒーかって？なら…おはよう。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "この時間になると脳が冴えてくるんだ。だから、無理に眠ろうとも思わなくなった。先に休んでいてくれ。僕はライトを持って畑の大根を見てくる。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "オロルン自身について・交流",
      "text": "僕の話は時々分かりにくかったりするから、もしそういうことがあったら、言ってくれ。遠慮はいらない。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "オロルン自身について・解明されていない謎",
      "text": "自分がどこから来たのかは分からないし、別に知りたいとも思わない…それより、どこに向かうべきかのほうが気になる。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "謝罪について…",
      "text": "すまなかった…本当に…心から申し訳ないと思っている。初めて会った人に騙されるなんて、いい気分じゃなかっただろう。そんなことをした理由は君に話した通りだ…嘘はない。それでも許してくれないのであれば、できるだけ君の前には姿を現さないようにしよう。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "お礼について…",
      "text": "これは「朝四時」に採れたサウリアンサキュレント、「頭より大きい」ケネパベリー、「先週まで甘さ一位」だったミツ…ああ、あとこれは「カクーク無料相談券」だ。\\n顔にハテナがいっぱい浮かんでいるな。全部君へのお礼だ。受け取ってほしい。僕を助けてくれたお礼に何かあげたいけど、君に何が必要なのか分からなかったから、自分の好みで用意した。\\nカクークは誰かって？そいつは竜だ、今度紹介しよう。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「神の目」について…",
      "text": "雷は作物の成長にいいと聞いたから、畑の真ん中で「神の目」の力を使ってみたんだ。だが残念ながら、キャベツもトマトもあまり好きじゃないみたいだった。その栽培法はそれっきり使っていない。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "僕から一つアドバイスするなら——最初に意見を述べるな、ってことかな。最初に実った果実が狙われやすいのと同じように、先に頭角を現した人は憂き目に遭うのがオチだ。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "空を飛んでいるときのフライングモモンガには孤高なイメージを抱く。けど、ふとした瞬間に降りてきて、人の身体にすり寄っては離れなくなることがあるんだ。そんなとき、ついついあの子たちの欲しいものをあげてしまう。まあ、ある意味ずる賢い連中だ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "シロネンについて…",
      "text": "彼女は高いところが好きらしい。特に木の上で寝そべるのが好きみたいだが、僕の場合は、枝から逆さまにぶら下がっているほうが気持ちよかった。機会があれば、ぜひ彼女と感想を話し合ってみたい。ん？やめたほうがいいのか？違う角度から世界を見ることも大事だと思うけど。特にシロネンほどの発明家なら、なおさらだろう？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "キィニチについて…",
      "text": "あのアハウってやつは本当に面白い。それなりの年のはずだけど、まるで子供みたいだ。キィニチはその反対で、年は若いのに大人びている。僕が言いたいこと…伝わるかな？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "チャスカについて…",
      "text": "チャスカの実力は皆もよく知っている。彼女が姿を現した途端、喧嘩がピタッと止まり、握手して和解する流れになるんだからな。なるほど、最も説得力があるのは「武力交渉」ってやつか。うん、かっこいい名前だ。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "イファについて…",
      "text": "イファが竜の患者を叱っているところをよく見かけるけど、実際は竜たちと仲がいいんだ。暇な時、あいつが診療所の入り口でギターを弾いていると、竜たちが寄ってきて歌い始める。\\nま、キューキューって叫ぶだけだけど。僕も見かけたら仲間に入るよ——竜のほうにな。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "シトラリについて…",
      "text": "ばあちゃんは感情を隠すのが苦手な人だから、嬉しい時も不機嫌な時も丸わかりだ。君はばあちゃんと同世代…いや、もっと年上か？\\nあ、失礼な言い方だったかもな。これ以上聞かないほうがよさそうだ。でも、もし僕の推測が合っているなら、ばあちゃんの話し相手になってあげてほしいんだ。ばあちゃんの周りは年下ばかりだから、もし君が声をかけてくれたらきっと喜ぶと思う。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "イアンサについて…",
      "text": "僕を捕まえるために、炎神様が彼女を送ってこなくてよかった。身長こそ勝るけど、有名なスポーツトレーナーとの駆けっこで勝てるはずがないからな。目くらましの術？いや、何度も使うと効き目がなくなるんだ。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "マーヴィカについて…",
      "text": "以前は炎神様を知らなかった。\\nいや、炎神様が誰かはもちろん知っていたけど、言葉を交わすような「知り合い」ではなかった、という意味だ。僕から見た炎神様は、すべてを掌握し、無限の力を秘めたトーテムのような存在だった。だが、それはあやふやな理解でしかなく、あの方についてはほぼ何も知らなかったんだ。\\n今は少しあの方のことを知ることができて、嬉しいと思う反面、自分が情けないとも思っている…炎神様は炎が燃え続ける理由をよく知っていて、その炎を絶やすまいという意志に一切の迷いがない。僕も…ナタの力になれたらいいなと思う。\\nそうだ、こんなこともあった…この前のパーティーで、炎神様が緑の野菜をたくさん取っていたから、話しかけてみたんだ。そしたら、栄養バランスのとれた食事が好きだと話してくれた。なんというか、意外と繊細な一面もある方だった。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "「隊長」について…",
      "text": "彼は突然訪れた、実に奇妙な縁だった。\\n謎煙の主は未来を予知する術に長けているって言われるけど、当時道端で「隊長」と会ったときは、これほど事態が複雑になるとは想像もしていなかった。人への貸し借りというのは、きれいに「清算」できるものなのだろうか？そうだとすれば、僕の中に未だに感謝と申し訳なさが残っているのはなぜだろう？\\n…ま、僕の考えすぎかもしれないな。過去に何があったとしても、ナタを窮地から救ってくれた彼は、尊敬すべき英雄だと思う。彼のことはこれからもずっと記憶に残るだろう。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "オロルンを知る・1",
      "text": "こんにちは。ん？握手？ナタではそういうかしこまった挨拶はあまりしないけど、君が望むなら。むしろ遠くから声をかけてくれるだけでいいんだ。僕は耳がいいからな。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "オロルンを知る・2",
      "text": "君はいつも忙しくしているな。君みたいに、僕もずっとやることがあるといいんだけど。でも、のんびり過ごすのも好きだ。人間の気分はころころ変わるものだし、言うことを聞いてくれなくて困っている。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "オロルンを知る・3",
      "text": "日中のナタは暑いから、必要がない限りは夜に出かけるのを好んでいる。夜の水面を見たことあるか？月明りに照らされ、キラキラと光るところを見ているのは気持ちがいいんだ。でも、水がきれいかどうかは太陽光の下でしか分からない。夜の水には触れないほうがいいだろう。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "オロルンを知る・4",
      "text": "僕は生まれつき、魂への感知能力が人一倍高いんだ。どう説明すればいいかな…人の魂は予測不能なエネルギーの塊みたいなもので…もし形の様々な「ちび竜わたあめ」ってものが存在するなら、魂の形はそれに似ているだろう。君の魂は、とても暖かい。まるで炎に当たっているみたいだ。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "オロルンを知る・5",
      "text": "正直、僕も自分のことがよく分からない。僕の中には常にたくさんの疑問がある。前の疑問がまだ解決しないうちに、また新しい疑問が生まれるんだ。\\nこれといった解決策もないみたいだから…前へ進むしかない。そうだろう？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "オロルンの趣味…",
      "text": "野菜の栽培とミツムシの観察のほかに、趣味はあるかって？もちろんあるさ…少し時間をくれ、すぐ思いつくから。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "オロルンの悩み…",
      "text": "時々、こう思うことがあるんだ——「やりたい」と「やり遂げる」の間には、越えがたい距離があるって。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "タタコスを食べるときは、下に生地を一枚敷いて食べるといい。頬張るときにこぼれた具材で、タタコスがもう一個作れるぞ。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "軍用携帯食…特に乾パンはどうも苦手だ。「隊長」の魂みたいにずっしりしていて…素晴らしい食べ物だと思うが、とにかく硬すぎるんだ。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る・1",
      "text": "大した腕だ。僕よりうまいな。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る・2",
      "text": "味の加減がちょうどいい。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る・3",
      "text": "これは…僕の知らないアートか？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "ナタには、生まれた日によってその人の運命が決まるという考え方もある。大英雄と誕生日が同じ人は、その英雄の加護を受け、同じような資質の持ち主になるとかな。\\n君と同じ誕生日の人は、きっと運に恵まれた人だろう。誕生日おめでとう。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想・起",
      "text": "さっき渡してくれたのは何だ？もう一回見せてくれ。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想・承",
      "text": "#「先生」と呼んだほうがいいかな？ありがとう、{M#じいちゃん}{F#ばあちゃん}先生。勉強になった。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想・転",
      "text": "身体が軽くなった。もっと高いところにも簡単に行けそうな気がする。でも力の出し方を工夫しないとな。頭をぶつけると痛いから。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想・結",
      "text": "僕にはまだ、死の境を窺う能力がない。だが君の手によって、僕の死はさらに遠ざかった。安心してくれ、だからといって、タガを外して悪事に手を染めたりはしないから。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル・1",
      "text": "あまり遠くに行くなよ。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル・2",
      "text": "じゃあな。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル・3",
      "text": "自由になれ！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発・1",
      "text": "行け、もう自由だ。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発・2",
      "text": "さ、みんなに挨拶だ。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発・3",
      "text": "周りを見張っててくれ。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける・1",
      "text": "君の宝箱への情熱が、こいつらの生存環境を脅かしている。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける・2",
      "text": "叩くといい音がする。いい品かもしれない。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける・3",
      "text": "箱に隠れるのが好きな竜もいるから気をつけろ。たぶん内気な性格なんだろう。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下・1",
      "text": "もう走れそうにない…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下・2",
      "text": "気を引き締めないと…！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下・3",
      "text": "悪い兆しだ。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下・1",
      "text": "医者に連れて行こうか？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下・2",
      "text": "僕がカバーする。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能・1",
      "text": "先にいってる…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能・2",
      "text": "見えなくなった…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能・3",
      "text": "聞こえるはずのない…声が…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける・1",
      "text": "くっ、一歩遅れた…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける・2",
      "text": "こんなはずじゃ…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入・1",
      "text": "呼んだか？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入・2",
      "text": "目的地は？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入・3",
      "text": "まず、いいことか悪いことか教えてくれ。"
