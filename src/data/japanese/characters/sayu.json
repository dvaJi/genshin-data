  "outfits": [
    {
      "id": 205300,
      "name": "子貉服",
      "description": "早柚の衣装。神秘的生物——「貉」をモチーフにして設計した不思議な服装。",
      "isDefault": true,
      "characterName": "早柚",
      "characterId": 10000053,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sayu_Circle"
    }
  ],
  "voices": [
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "行くぞ。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "さらば。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "ドロン。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "遁走の極意！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル·5",
      "text": "捕まらないぞ。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル·6",
      "text": "風向きに従え。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "分身の術。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "出てこい。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "ドドーン！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "ダッシュ開始·1",
      "text": "疾風の如く。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "この箱…中で寝れるかも。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "お手柄だ！じゃあ寝てもいいか？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "背が伸びる品はあるか？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "逃げる時は、えーっと…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "頭がフラフラ…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "ふぐぅ、しんどい。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "拙が援護する。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "一旦下がるんだ。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "逃げられ…なかった…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "おや…すみ…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "サボらなければよかった…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "ダメージを受ける·1",
      "text": "いた。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "避けれない。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける·2",
      "text": "ぐうっ、倒れそうだ。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "ねむい…"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "寝てもいいか？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "うっ、見つかってしまった…"
    },
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "「終末番」早柚、参上。\\nふぅ～、やる事なかったら、拙は先に寝る。言っておくが、こっそりと拙の頭を撫でるんじゃないぞ。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·寝る",
      "text": "ふぁ～…ぐーぐー…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·仕事",
      "text": "仕事なんかよりお昼寝だ。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·背伸びる",
      "text": "いつになったら背が伸びるんだ。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "はやく雨宿りを。雨に打たれると背が伸びなくなる！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "凄まじい音だ。だが、布団にこもってしまえば安心して眠れる。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "雪の日は身を隠しやすい。例えば「雪降りの術」は、吹きつける雪の力を借りることで自分の身を隠す、他の者が気づく頃には降りしきる雪しか残ってない。ちなみにこのことは、巫女姉さんに教えてはいけないぞ。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "晴れの日…",
      "text": "気持ちいい天気、ふぁ～ねむい。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "風の日…",
      "text": "風吹く時は逃げる時。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "暴風の日…",
      "text": "風が強すぎて目を開けられない。いっそのこと、そのまま目を閉じて寝てしまおうか。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "ん…もうあさなのか？あと10分、10分だけ…え、じゃあ5分でもいいから…ふみゃ…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "ね…ねむい。お昼寝の時間はまだ？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "確認完了、周囲に巫女姉さんの姿はないな。今夜はぐっすり眠れるぞ。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "やっと…寝れる…おや…すみ…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "早柚自身について·終末番",
      "text": "拙は「終末番」に所属しているが、与えられた仕事は情報収集だの、盗みだのといった細かい事ばかり。別に…拙がやらなくても問題ないと思う。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "早柚自身について·サボる",
      "text": "「終末番」の仕事なんか端から意味がない。サボったって、もっと適任の人がやってくれる。だが寝ることは大事だ。長く眠れば、いつか背が伸びるかもしれない。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "見張りについて…",
      "text": "巫女姉さんが来る時は必ず伝えてくれ。拙はちょっと昼寝…いや、しばらく休むことにする。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "頭を撫でることについて…",
      "text": "頭を撫でたい？うっ、主ならよかろう。だが、ちょっとだけだぞ。背が伸びなくなるのは御免だ！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "両手剣は本当に重たい。忍術だけに頼っていては、持ち上げることすらできない。しかし「神の目」があれば話は別。拙にとって「神の目」は欠かせないものなのだ。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "師匠は拙が最後の世代だとおっしゃってたし、なにせ戦いに向いていない流派だ。逃げたり身を隠したりする術しか学んでいなかったのも、仕方のないこと…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "ムジナは知ってるか？タヌキよりもずっとかわいい生き物だ。今度見に行く時、一緒に連れてってやってもいいぞ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "神里綾華について…",
      "text": "神里家のお嬢様は、優雅で威厳のあるお方だが、拙が怠けないように、特別に巫女姉さんを監視役として任命した…どうして、こんなことになったのだ…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "神里綾人について…",
      "text": "木の上で休んでいると、よく巫女姉さんたちがあのお方の噂をしているのが聞こえる。どうやら仕事で忙しいお方のようだが、理解できぬ。仕事なんかサボってしまえばいいのに…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "トーマについて…",
      "text": "神の目を持ってるくせに、やつは毎回のように忍術を学びたいとしつこく懇願してくる。理解できぬ。睡眠時間を削ってまで教えるなんて…時間がもったいない。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "宵宮について…",
      "text": "彼女は会うたびに「タヌキちゃん、お祭りで遊ばへん？」だのと言ってくるが、拙はタヌキなどではない。お祭りにも興味ない。行くことになったとしても、彼女の花火に合わせて忍術を披露するだけ。これが「終末番」の仕事とどう関係すると言うのだ！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "雷電将軍について…",
      "text": "あのお方は…拙が会えるような御仁ではない。知りたいことがあれば、綾華お嬢様に聞いた方が早い。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "八重神子について…",
      "text": "彼女はいつも拙の頭を撫でたがる。対して拙は手を噛む勇気も、反抗する勇気もない。断れば大惨事になりかねないと感じる。しかし、このまま撫でられ続けたら、本当に背が伸びなくなるのでは？ど…どうすればいいのだ…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "荒瀧一斗について…",
      "text": "なぜあんなにやかましい者がいるのだ。しかもあんなに背が高いのはなぜだ！"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "久岐忍について…",
      "text": "ピンとこない名前だな…待て、荒瀧一斗の子分なのか？ならやつも睡眠を妨害してくるに違いない。何せ同じ穴のムジナ、いや、同じ穴のタヌキっていう言葉があるくらいだからな！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "綺良々について…",
      "text": "前に昼寝から目が覚めた時、なんだか背中がポカポカして、振り返ってみたら猫が丸まって寝てた。しかも、ふわふわなしっぽが二本もあったぞ！拙、びっくりして木の上から落っこちそうになったんだ。こ、これも、変化の術なのか？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "夢見月瑞希について…",
      "text": "変な紫の妖怪…見つめられると、食べられるんじゃないかと思う…うぅっ！怖い、やっぱり逃げるのが吉！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "プルーネについて…",
      "text": "プルーネから、『栄養学概論』という分厚い本をもらった。なんでも、寝ているだけでは不十分で、これに書かれた通りに食べないと背は伸びないらしい。でも、その知識がある割には拙と同じくらいの背格好のような…彼女は背を伸ばしたくないのか？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "早柚を知る·1",
      "text": "ふみゃ…ふみゃ…ふみゃ…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "早柚を知る·2",
      "text": "ええっと、忍術流派の名前か？…あれ…思い出せない、まだ目が覚めきってないから、もう一眠りしたら思い出せるかもしれない。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "早柚を知る·3",
      "text": "主になら教えてもいいぞ。だが、まず笑わないと約束してくれ。でないと、二度と口をききたくなくなるからな。拙の流派は…「嗚呼流」という。\\n拙たちの忍術は敵をもてあそぶことに長けているゆえ、こう名づけられた。だが、しかし、うう…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "早柚を知る·4",
      "text": "木登りはできるか？拙は非常に得意だ、主に教えてやってもいいぞ。それと、神社にある木は特にサボり…いや、特に昼寝に適しているのだ。今度、昼寝をしたい時は、拙のところに来るがいい。一緒に登って昼寝するぞ。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "早柚を知る·5",
      "text": "この服は師匠からいただいた物。ムジナを原型に作られており、逃げる時に役立つのだとか…もう一人前だから自分の身は自分で守らなければならないと言われたあと、この服を残し、師匠は去っていった。拙のような身長で、本当に一人前になれたのか？\\n主はこの先も傍にいてくれるか？本当に拙を見捨てないか？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "早柚の趣味…",
      "text": "帽子を被ると巫女姉さんに見つかる心配をしなくていい。そして一日中ぐっすり眠れる、この世で一番幸せなことだ。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "早柚の悩み·勘違い",
      "text": "初対面の者は拙を見ると「タヌキだ」と騒ぐ。だが、早柚は早柚だ、タヌキなどではない。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "早柚の悩み·身長",
      "text": "いつになったら背が伸びるのだろうか？同年代の者たちは、すでに拙の倍くらい身長がある…このままではいけない、もっと寝れば必ず背が伸びる！というわけだから、寝るぞ、おやすみ。"
    },
    {
      "id": "6006",
      "type": 1,
      "title": "早柚の悩み·悪循環",
      "text": "悩み事が多いと身長が伸びなくなると聞いた…はぁ、一体どうすればいいのだ…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "一度にたくさんの活力をまかなえる食べ物、例えばおにぎりだ。起きた後に1つ食べれば、頭がフラフラしなくなり、また寝ることができる。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "身長を伸ばしたければ、食べ物の好き嫌いをしてはいけない。そういえば、最近身長に変化がないような…食べる野菜の量が減ったからなのか…だがサラダはお腹いっぱいにならないし、苦いし、うぅ…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "お腹いっぱい。これで安心して眠れる。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "食べているうちに…眠くなってきちゃった。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "何とかして…逃げないと。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "学びたい忍術があるのか？教えてやってもいいが、拙ができるものだけだぞ。ん？なぜ今日は寝てないのかって？あぁ…まだ眠くないのだ。しかも今日は特別な日、寝てしまっては勿体ない。誕生日おめでとうと、拙自身の口から言いたかったのだ。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "少しは背が伸びたか？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "よし、逃げ足が速くなった、もう捕まらないぞ。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "拙ひとりだったら…途中で寝てしまっていたかもしれない…材料集めを手伝ってくれて感謝いたすぞ。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "師匠が言ってた通り、拙は一人前になったみたいだ。身長は…そんなこと今はもういい、大事なのは…主が拙のそばにいることだ。"
    }
  ]
}