      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Rosaria_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "そこの信徒、何か困っていることがあれば私を頼るといいわ。祈祷がしたいだけなら、他のシスターに…\\nうん？信徒じゃない？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·退屈",
      "text": "まだ行かないの？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·残業",
      "text": "なんでもいいわ、残業以外ならね。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·モンドの生活",
      "text": "しっかり働いて、まじめに生きる。モンドってそういうところでしょ？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "仕事に響くわ。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "ちっ、面倒ね。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "雪の中は、足元に気を付けなさい。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "暴風の日…",
      "text": "風神ブットバースの加護か？いや待って、バルバトスか…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "おはよう、ふあ～もう朝のお祈りが始まってるの？勘弁してほしいわ。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "午後の日光は睡眠の質を上げるの。君もためしてみたら。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "こんばんは。晩祷なら参加しないわ。理由はどうだっていいでしょ。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "もう休んでおきなさい。心配しなくても、後のことは私がやっておくから。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "ロサリア自身について·仕事",
      "text": "私？ただのつまらない人間よ。見ての通り、教会も仕事も好きじゃないし。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "ロサリア自身について·面倒",
      "text": "あのシスターたち本当に鬱陶しいわね。隙あらば私を捕まえてお祈りだの合唱だの…私がここにいること絶対に教えないでよ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "信仰について…",
      "text": "神は全ての人に加護を与えることができるかもしれない。けど、絶対にそれをすることはないわ。だって、そんなことしたら人の苦難なんて笑い話になるでしょ。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "祈りについて…",
      "text": "祈りなさい。神や他の誰かのためでなく、自分のために。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "戦いについて…",
      "text": "無理しないで、困っていることがあれば私を頼るといいわ。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「神の目」は実力を示す証であり、生き残ったことへの勲章でもある…なんてね。本当にいいものには常に裏があるの。私には「神の目」を定義することはできない。ただお互いに、証明し合う関係なだけ。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "私が嬉しく感じることは何かって…もし仮に、どんなに頑張ろうと解決できない問題に君がぶつかっても、この世の終わりだなんて思わないこと。だって、他の誰かが君を助けにくるかもしれないでしょ。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "花にはまったく興味がないの。でも、蒲公英だけは例外。すごく美味しい蒲公英酒が造れるからね。休憩時間に一杯飲めば、朝の二度寝より気持ちいいわ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "ディルックについて…",
      "text": "一目で分かるでしょ？あのお金持ちの坊ちゃんはただ者じゃないって。慎み深い上に、自信にも満ち溢れている…それと少し、危険な香りもね。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ガイアについて…",
      "text": "人は酒に酔った時、本性を現すもの。ガイアの口がよく回るのは、その本性を隠すためよ。ふふっ、分かりやすいカモフラージュね。彼が酔っぱらった姿を君にも見せてあげたいわ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "ウェンティについて…",
      "text": "あの吟遊詩人からはとても特別な気配がするわ…それが何なのかはまだ分からないけど、他の一般市民とは明確に違うってことだけは確かね。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "バーバラについて…",
      "text": "バーバラはいつも私に張り付いて、やれ礼拝だのやれ合唱だの言ってくるわ。もしかして、私がちゃんと仕事をしているか見張るために、ヴィクトリアが寄越した監視役じゃないわよね？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "ジンについて…",
      "text": "自分の本職だけでなく、他人の後始末までする。称賛に値する女性ね。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "アルベドについて…",
      "text": "彼は、古びた屋敷に飾られた絵画のように…重みがあって、神秘的で、一目じゃ見透かすことのできない人物よ。人生経験が豊富な人は嫌いじゃないわ。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "リサについて…",
      "text": "仕事をさぼる人は好きじゃないけど、定時で帰りたい気持ちは、とても分かるわ。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "クレーについて…",
      "text": "面倒くさい、とにかく面倒くさい。まあ、可愛い意味でね。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "ファルカについて…",
      "text": "ファルカは他人の世話を焼いてばっかの、ジジ臭くて面倒な人よ。悪気はないんだろうけど。周りの人を気にかけるのが好きなのよ、あいつ。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "父について…",
      "text": "父親？私には縁遠い言葉ね。私にとってはないに等しいもの、もしくはたくさんあるものとも言える。どう？おどろいたかしら？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "ダリアについて…",
      "text": "自分から奢るっていうのはいい習慣よ。それに、彼は酒の席でも節度をわきまえてるわ。聞いていいことと、踏み込むべきじゃないこと、その線引きがちゃんとできてる。お互いの腹の内が分かれば、余計な警戒もしなくて済むし、賢い人と付き合うのは気楽でいいわね。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "ロサリアを知る·1",
      "text": "あいさつはいらないわ。私がここに来たのは仕事を全うするため、君にできないことは私がやるわ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "ロサリアを知る·2",
      "text": "神を信仰しないシスターは何も珍しいものじゃないわ、肉が好きじゃない狩人もいるし、魚が嫌いな漁師だっている。何かをするのに好きになる必要はないの。かといって、嫌いなものから離れる必要もない。仕事ってそういうものよ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "ロサリアを知る·3",
      "text": "一杯どう？今年の蒲公英酒は格段に美味しいわよ。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "ロサリアを知る·4",
      "text": "モンドは、人々の介護が必要なほど老いぼれているのに、独立して生存もできないほど若くて未熟。そんな矛盾を持った真っ白な獣よ。こんな場所だからこそ、私みたいな人が必要とされるの。他のシスターたちが人々を手伝うように、私もモンドを手伝っている。モンドが自由に向かって突き進んでいけるためにね。なんで白なのかって？…黒っていうのは…私みたいな人を言うからよ。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "ロサリアを知る·5",
      "text": "様々な過去の自分が今の自分の隣にいて、すがる思いで何かを託してくる、たまにそんなことを感じるの。きっと君も経験があるでしょ。だから、これから君が違う道を歩んでも、昔の自分を否定しないで。昔の君は、今の君の礎。過去に怯えず、向き合うことを恐れないでね。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "ロサリアの趣味…",
      "text": "一杯飲めば、嫌なことも消えてなくなるわ。とはいっても、酔ったことないけど。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "ロサリアの悩み…",
      "text": "はぁ…来月の合唱コンクール、参加したくなかったのにヴィクトリアに名指しで指名されたわ…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "獣肉のワイン煮込みは食べたことある？お酒と大きなお肉を一つの皿でいただけるの、最高の一品よ。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "ハ…ハッシュドポテトにジャム？信じられない！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "どうやら、私たちって好みが合うみたいね。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "少なくとも、お腹は満たせるわね。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "君、こういう食べ物に興味があるの？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "今日は君の誕生日ね、何か片付けてほしい人や用事はある？手伝ってあげてもいいわ、もちろん内緒でね。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "うん、いい感じね。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "何か手伝ってほしいことはある？今ちょうど手が空いてるの。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "能力が高くなれば、仕事の効率も上がるわね。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "戦闘と殺戮に長けている私でも、これほどの力を持ったことはないわね…祝福してくれてありがとう。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "はっ！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "許さない！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "あきらめて！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "ヴァーディクト！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "震えなさい！"
    },
    {
      "id": "200003",
      "type": 2,
