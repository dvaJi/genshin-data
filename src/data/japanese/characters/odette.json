  "outfits": [
    {
      "id": 215000,
      "name": "雪鳥の舞",
      "description": "オデットの衣装。雪鳥をモチーフにした精巧なバレエの衣装で、勤勉なバレリーナと共に無数の夜を過ごしてきた。あしらわれた宝石は舞台の照明の下で常に静かで優雅な輝光を放ち、まるで透明感あふれる彼女本人のようである。",
      "isDefault": true,
      "characterName": "オデット",
      "characterId": 10000150,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Odette_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初めまして…",
      "text": "…応援ありがとうございます。サインの横にはどんなイラストをご希望ですか？羽でいいかしら？…あら、ファンの方ではありませんでしたのね。それでは、改めて自己紹介を——私はオデット、スネージナヤコロレフスキー劇団のバレリーナです…応援、感謝いたします。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話・多忙",
      "text": "他に用がなければ、バレエの稽古に行ってまいります。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話・簡単",
      "text": "簡単に返せる質問に、長々と時間を割く必要はありませんわ。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話・時間",
      "text": "時間が倍…いえ、三倍あればいいのに。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "しとしとと降り注ぐ雨の音は、静かな気持ちにさせてくれます。こんな日は、一人でバレエの練習をするのに最適ですわ。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨上がり…",
      "text": "美しく平穏な時は、一瞬のうちに過ぎ去ってしまうものです。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "雪の日…",
      "text": "スネージナヤの雪は骨を刺すように冷たく、永遠に降りやむことがありません。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "暴風の日…",
      "text": "髪が…後で整え直しましょう。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "砂漠にいる時…",
      "text": "…ファンとの交流会がこういう場所で開かれることがなくてよかったですわ。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "いつでも動けます。ウォーミングアップは終わっていますから。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "お昼寝は結構ですわ。トレーニングに向かない午後は台本に目を通すようにしておりますの。この便箋ですか？ヴォジャニーツァが私に押し付けてきたファンレターです…しっかり最後まで読むようにと言われております。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "夕食の時間ですの？どうせすぐに開幕ですから、ゆで卵でも食べれば十分です。公演がすべて終わったら、適当に何かいただきますわ。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "…任務完了。トレーニングのノルマは達成したし、新しいバレエの練習も終わったけど…まだ表情のコントロールが不十分だわ。もう少し鏡の前で調整しなければ…あら、もうこんな時間でしたの？先に休んでいてください。まだやるべきことがありますので。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "オデット自身について・ロコット",
      "text": "厳冬計画が始まってからというもの、劇場まで足を運んでくださる観客は少しずつ減り…困窮する人々から搾取しようとする輩まで現れています。もう、黙って見過ごすことなどできませんわ。私の力だけではどうにもできないことは百も承知ですけれど、できることをしてみたいのです。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "オデット自身について・記憶力",
      "text": "昔の記憶は、烙印のようにこの胸に刻まれています。そして皆が寝静まった夜、映影のように繰り返し再生されるのです…記憶力が良すぎるのも、考えものですね。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "希望を託すについて…",
      "text": "他人の庇護など、張ったばかりの薄氷のように脆いものです。私は他人に希望を託したりなどいたしません。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "かさぶたについて…",
      "text": "私は痛覚にとても鈍感で、怪我に気づいた頃には、すでにかさぶたになっておりますの。おかげでバレエの練習にしても、ファデュイの訓練にしても、体のことでスケジュールに支障をきたさずすみます。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「星の楔」について…",
      "text": "以前、とある訓練で足に凍傷を負い、感覚すら失った時——「星の楔」が放つ光の中で意識を取り戻しました。けれど、「星の楔」が人を呼び起こせるなどという話は、聞いたことがありません。あの時目覚めたのは…私が本能的に生きたいと願ったから…？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "リハーサルとは、本番の公演と同じように真剣に臨むものです。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "甘みの少ないアイススグリには、塩を少し振ると美味しくなりますのよ。塩気で甘みが際立つとか。とあるファンの方が教えてくれましたの。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "ロザリンについて・かつて",
      "text": "ロザリン様には恩もありますが…憎んだこともあります。ロザリン様はとても厳しくて、訓練を受けていた時期は、凍えたり、過労で倒れたり、怪我や体調不良に見舞われたりは日常茶飯事でした。かつての私は無邪気にも、一人で舞台に立ち、バレエで母を養えるようになった暁には、ファデュイを抜けてロザリン様を見返してやろうだなんて思っておりましたけれど。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ロザリン・燃珀について",
      "text": "伝える対象がいなくなれば、多くの言葉は行き場を失います。燃珀はあっけなく割れました…皮肉なものですね。かつてはあれだけ傷つき、誤解し合っていたというのに…いまさら、あの人のことが理解できるなんて。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "「女皇」陛下について…",
      "text": "「女皇」陛下はスネージナヤの信仰そのもの。ご多忙のため、めったにお姿を見せられず、私もお目にかかれた回数はごくわずかですが…とても威厳のある方で、その眼差しは万年雪のように冷たく、揺るぎありません。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "「少女」様について…",
      "text": "彼女の歩く姿は、まるで羽がふわりと舞い踊るかのようですわ。その軽やかさは、全バレリーナの憧れです。そのうえ、透き通るような歌声もお持ちとは——いつだったか、ヴォジャニーツァが高く評価していましたわ。しかし、そうして私たちが羨んでいるのは、すべて彼女の表の姿。彼女が人知れず苦しみを抱えていないとは言い切れません。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "「召使」様について…",
      "text": "壁炉の家の子供たちは皆、「召使」様を「お父様」と見なしています。父親に守られる子供たちは、成長の道のりで氷雪や風雨に晒されることがいくらか少なくなるものです。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "「傀儡」様について…",
      "text": "「傀儡」様のお茶会があった日は、ロザリン様の機嫌が良かったものです——厳しさは相変わらずでも、誰が見ても明らかなほど、口調が優しくなるのです。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "ヴォジャニーツァについて・笑顔",
      "text": "初めて「女皇」陛下にコロレフスキー劇団の公演をご覧いただけることになった際、私はヴォジャニーツァからその報せを受けました。私は「わかりました」と答えましたわ。すると彼女は人差し指で私の口角を無理やりつり上げて笑顔を作らせ、一緒に「やったー！」と喜ぶよう求めてきました。\\n私は今でも、「女皇」陛下があのような笑顔を気に入るとは思えませんわ。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "ヴォジャニーツァについて・診察",
      "text": "ヴォジャニーツァは体調不良の時、いつも私にまとわりついて、一緒にいてほしいとせがむんですの…万が一注射をされたり、苦い薬を飲むことになったりしたら怖いので、私の腕をぎゅっと掴んでいたいそうですわ。私は痛覚が鈍いので、もちろん彼女を振り払ったりはいたしませんけれど。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "アリョーシャについて…",
      "text": "生計を立てるだけなら、ハンターとしての収入で十分なはずなのに、彼は苦しんでいる人々を助けるため、頻繁に劇場でアルバイトをしていました…彼がロコットの一員というのも、納得です。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "ミティヤについて…",
      "text": "その「ファン」の方は…よく劇場へ私とヴォジャニーツァの舞台を観に来てくださいますわ。しかし毎回いざ舞台が始まると、うつむいて何かを書き始めるのです。他の観客は皆、舞台を見つめているものですから余計に目立ちますのよ。もしかすると、彼よりも彼のマフラーのほうが、公演の楽しみ方を分かっているかもしれませんわね。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "バレリーについて…",
      "text": "バレリー少将は時間に厳しいファデュイの将校だとか。常に冷静かつ恐ろしい態度で皆に仕事を割り振るのだそうです。ですが、私は所属が違うので接点はほとんどありませんし…そもそも私は何をすべきかなど、人に指図されずとも結構ですわ。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "ヴェスナについて…",
      "text": "羽根があるからと言って、彼女を美しく無害な蝶だと思ってはいけません。皆に愛されていても、彼女が冬契軍の総司令であり、吹雪のハンターであることに変わりはないのです。人当たりのいい笑みに騙されませんよう。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "オデットを知る・1",
      "text": "スケジュールに余裕がなく…この後も訓練ですの。申し訳ないけれど、お話なら、手短にお願いしたいわ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "オデットを知る・2",
      "text": "私の母はバレエの名家の出身で、父はファデュイに所属しておりました。二人はとある公演をきっかけに結ばれたのですが…それがまた、聞く人すべてを笑顔にするような、ロマンチックな話ですのよ。幼い頃、母は私と軽やかに踊ってくれて、父は私に新品の可愛らしいチュチュを買ってくれました。唯一の悩みは、毎日キャンディ瓶からどのキャンディを選ぶかということだけでしたわ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "オデットを知る・3",
      "text": "父が殉職したという報せが届き…母は悲しみのあまり、公演中に足を骨折してしまいました。キャンディはすべてこぼれ落ちて…空っぽの瓶は、私を閉じ込める檻となりました。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "オデットを知る・4",
      "text": "その後のことは、あなたも知っての通りですわ。何度も繰り返し振り返ってきましたから、いまさら傷つくことはありません。そうした運命に抗ってきたからこそ、私なりの力を得たのです。このことは、決して忘れません。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "オデットを知る・5",
      "text": "どれも、ファンには言えないことばかり…あなたがファンでなくてよかったですわ。私には多くの「顔」があり、そのすべてに純粋に身を投じ続けなくてはならない…これからも、私の思う「完璧」に向かって舞い続けるのみです。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "オデットの趣味…",
      "text": "生まれてから今まで、バレエよりも好きなことはありません。舞台上で私の出せる最高のパフォーマンスを観客の皆さまに届けられるよう、全力を尽くしますわ。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "オデットの悩み…",
      "text": "正直なところ、私はあまり動物に好かれていないと思います。劇場の近くにはよく子猫が出るので、ヴォジャニーツァに引っ張られて餌をやりに行くことがあるのですが、私が近づくと子猫が爪を研ぎ始めるのです…えっ？あれは歓迎しているという意味でしたの？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "レストランの閉店間際になると、サラダが半額になるのでよく食べていましたわ。時間が経ったサラダの味はもちろん新鮮なものには敵いませんけれど、馴染み深い食感に、かえって安心しますの。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "個人的な好みの話であれば、どうしても食べられないような食べ物はありませんわ。しかし、バレリーナとしては食事を制限する必要がありますから、日々の食事計画にない非推奨の食べ物は食べないようにしています。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る・1",
      "text": "ここ数日は公演が多いから、もっと…いえ、なんでもありません。すごく、美味しいです。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る・2",
      "text": "一品というより…一日分の量ですわね。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る・3",
      "text": "申し訳ありませんが、体重管理をしていますの。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "誕生日おめでとう。誕生日プレゼントは何がいいですか？私はいつも花やダンスシューズ、オルゴールばかりいただきますけれど、あなたはもっと別のものがいいですわよね。この際、願いを教えてください。私が実現できる願いなら、叶えて差し上げますわ。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想・起",
      "text": "何か足りない…もう少し練習量を増やさないと。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想・承",
      "text": "動作がさらに正確になった実感があります…この練習量のままいきましょう。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想・転",
      "text": "今ならフェッテを完璧にこなせそうです。それでも、稽古時間を減らすわけにはいきません。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想・結",
      "text": "「感情もバレエには欠かせない要素の一つ」——今なら、この言葉の意味がわかります。いつもそばで応援してくださり、ありがとうございます。今日の公演のチケットを差し上げますわ。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル・1",
      "text": "行きますわよ。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル・2",
      "text": "氷に映るは雪の影。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル・3",
      "text": "さん、はい——"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル・4",
      "text": "踊りましょう。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル・5",
      "text": "ピルエット。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル・6",
      "text": "ふっ…"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発・1",
      "text": "凍てつく旋律を。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発・2",
      "text": "氷上に舞い描く——"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発・3",
      "text": "雪鳥の礼賛をご覧なさい。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける・1",
      "text": "持って行ってください。私は結構ですので。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける・2",
      "text": "旅も修練…一歩一歩に意味があるのですわ。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける・3",
      "text": "努力の成果ですね。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下・1",
      "text": "気にすることはないわ。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下・2",
      "text": "かすり傷よ。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下・3",
      "text": "まだいける。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下・1",
      "text": "大丈夫かしら？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下・2",
      "text": "代わりましょう。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能・1",
      "text": "努力が…足りなかった…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能・2",
      "text": "いけない、立ち上がらないと…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能・3",
      "text": "まだ…痛みを感じられるのね…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "ダメージを受ける・1",
      "text": "へえ。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "ダメージを受ける・2",
      "text": "それで？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける・1",
      "text": "それで終わり？"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける・2",
      "text": "きかないわ。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入・1",
      "text": "準備できましたわ。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入・2",
      "text": "特別公演ですの？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入・3",
      "text": "今回はどちらへ？"
    }
  ]
}