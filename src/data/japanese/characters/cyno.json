  "passives": [
    {
      "id": "featherfall_judgment",
      "name": "落羽の裁決",
      "description": "<span style=\"color:#FFD780FF\">聖儀·狼駆憑走</span>の啓途誓使状態にある時、セノは一定間隔で「末路真眼」状態に入る。この状態で<span style=\"color:#FFD780FF\">秘儀·律淵渡魂</span>を発動すると「裁定」効果が起こり、その時の秘儀·律淵渡魂の与えるダメージ+35%。同時に前方に向けて渡荒の雷を3本放ち、セノの攻撃力100%分の<span style=\"color:#FFACFFFF\">雷元素ダメージ</span>を与える。<br/>渡荒の雷によるダメージは元素スキルダメージと見なされる。",
      "level": 1
    },
    {
      "id": "authority_over_the_nine_bows",
      "name": "九弓の権能",
      "description": "セノの元素熟知を基準に、自身の下記攻撃のダメージが増加する。<br/>・啓途誓使状態での通常攻撃のダメージが元素熟知の150%分アップする。<br/>・固有天賦「落羽の裁決」の「渡荒の雷」のダメージが元素熟知の250%分アップする。",
      "level": 4
    },
    {
      "id": "the_gift_of_silence",
      "name": "沈黙の恵賜",
      "description": "スメールで20時間かかる探索任務を完了した時、獲得する報酬+25%。",
      "level": 0
    }
  ],
