    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "よかった！素材がたくさん！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "これくらいの誤差なら、まだ大丈夫…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "ちょっと予想を、超えてるかも…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "痛くない痛くない、全然痛くない…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "早く戻って、薬剤を持ってるから！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "気をつけて、狙い通りに！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "研究…また失敗しちゃった。"
