  "outfits": [
    {
      "id": 203500,
      "name": "夏氷の夢",
      "description": "七七の衣装。呪符がたくさん貼られているため、七七の安心感が倍増する薬採りの子供服。",
      "isDefault": true,
      "characterName": "七七",
      "characterId": 10000035,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Qiqi_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "七七、キョンシーだ。…ん？あと何だっけ。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·独り言",
      "text": "ん、今…何を話そうとしたっけ…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·暑さが苦手",
      "text": "涼しい場所に行きたい。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·鍛錬",
      "text": "七二三四、七二三四…五六七七、五六七七…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "また傘忘れた。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雪の日…",
      "text": "雪だるま作りたい…付き合ってくれる？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "晴れの日…",
      "text": "今日は出かけるべきじゃない。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "風の日…",
      "text": "涼しい、気持ちいい。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "暴風の日…",
      "text": "手…手をつないで！ふ、吹き飛ばされる…！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "もう朝？今日は何を…ちょっとノートを確認する。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "…白先生の薬剤の仕分けを忘れた。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "こんばんは。今日は…何をしたっけ…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "おやすみなさい。柔軟体操してくる。…盗み見禁止。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "七七自身について…",
      "text": "七七のこと…？ごめん、よく思い出せない…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "記憶力について…",
      "text": "思い出せないことがたくさんあるけど…別に悪くない。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "記憶力鍛錬について…",
      "text": "最近記憶力の鍛錬を頑張ったから、あなたを忘れる心配はない。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「神の目」は時間を止められないけど、大事な人を守る力をくれた。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "実は七七の体調は白先生よりもいいよ…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "薬舗の周りにたまにヤマガラがいる、小さくて丸い。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "白朮について…",
      "text": "白先生の顔、思い出せない。でも問題はない…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "胡桃について…",
      "text": "高温、嘘の笑顔と…死、嫌い。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "魈について·名前",
      "text": "むっ、骨董品みたいな名前…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "魈について·記憶",
      "text": "会ったことあるの…？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "辛炎について…",
      "text": "…誰？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "ヨォーヨについて…",
      "text": "かわいい…ヤマガラみたい。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "冥ちゃんについて…",
      "text": "夜…たまに一緒に体操する人がいる気がする…気のせい？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "プルーネについて…",
      "text": "怖そうな女の子…でも、手のひらは柔らかい。すき。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "七七を知る·1",
      "text": "なにか？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "七七を知る·2",
      "text": "柔軟体操すると、体を人間みたいな状態に保つことができる。でも気を抜くと、また元に戻る…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "七七を知る·3",
      "text": "七七を利用しようとする人もいれば、七七を怖がる人もいる。でもあなたは…違う。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "七七を知る·4",
      "text": "初めて会った時から、あなたから暖かさを感じた。嫌いな熱とは違う、心が温かくなった。ありがとう…嬉しい。今のあなたしか知らないのが残念だ。もし忘れたら…ううん、あなたを覚えるように自分に「命令」するから。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "七七を知る·5",
      "text": "昔は生きることだけ考えてた、生きる理由も分からなかったけど…今はあなたと生きていきたいと思う。ず、ずっと…一緒にいてくれる？本当に？うん、あなたは七七が守るから！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "七七の趣味…",
      "text": "ペットがほしい…ヤマガラみたいな。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "七七の悩み…",
      "text": "よく分からない。でも、温度が高いと体はきつい…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "ココナッツミルクが好き。でも…味は分からない。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "ごめん、分からない…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "冷たい、好き。味、わからないけど…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "えっと…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "ちょっと、熱い…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "誕生日おめでとう。はい、薬草の匂い袋。驚いてる？前に言われた時にメモしておいた。毎日見れば、これからも忘れないよ…"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "ああ、強くなったの…？強くなるって何？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "ああ、理解した。強くなったら、力をコントロールするのにより精力がいる。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "昔は強さになんとも思わなかったけど、今は…もっと強くなりたい。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "あなたがいてくれたおかげだ、ありがとう…もうひとつ願いを叶えてくれる？これからは七七に守らせてほしいけど、いいかな？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "諸行無常。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "生生流転。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "行け。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "戻れ。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "聞き給え、ここにて命ずる。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "我が名は度厄真君なり。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "仙法開け、顕現せよ。"
    },
    {
      "id": "700001",
      "type": 2,
