  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "「蒲公英騎士」·ジン、入隊させていただきたい。これから先、私の栄誉と忠誠は貴方と共にある！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·行動",
      "text": "行動するのだ。ここに留まっているわけにはいかない。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·騎士団",
      "text": "騎士団の皆は…真面目にやっているのだろうか？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·目標",
      "text": "行こう、次の目的地へ！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "雨が降ろうと、私の行く手を遮ることはできぬ。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨上がり…",
      "text": "こういう天気こそ行動に適しているのだ。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "雪だ。ブーツの手入れを念入りにな。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "風の日…",
      "text": "気持ちのいい天気だ。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "暴風の日…",
      "text": "聞くところでは、あの日も珍しく強い風が吹いていたらしい…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "「一日の計は早朝にあり」。今日も頑張ろう。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "よし、今から任務を始めよう。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "どうやら、コーヒーに耐性がついたようだな。他の代替品があればいいのだが……リサに聞いてみよう。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "今日の訓練はここまでにしよう。よくやった。ご苦労様。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "ジン自身について…",
      "text": "今日は人々を守るためとは言え、五つの遺跡守衛を叩き切って、八つ裂きにしてしまった。あ…私はまだ自分を磨き続けなければいけない。あれは貴重な文化遺産なので、今度は素手で倒してみるべきだ。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "信念について…",
      "text": "全力で君を助けよう。もちろん、君の進む道が正義からかけ離れた時、私は迷わず指摘させてもらう。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "誓いについて…",
      "text": "この剣に誓おう。必ず勝利を君に捧げると。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "任務について…",
      "text": "任務は勝手に終わるものではない。だが、適度な息抜きも悪くはない。今日は特別に数分の昼休みをとろう。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「モンドを守る」、それはグンヒルド家の家訓だ。「神の目」を使う度に、私は母上様、そしてモンドの人々の期待を思い出す。モンドのため、自由のために戦うことに、私は躊躇ったりしない。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "西風騎士団を代表して、君がモンドのためにしてくれた全てのことに感謝する。どうか無理をせず、適度に…急に笑い出してどうしたのだ？私が何かおかしなことを言ったか？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "「蒲公英、蒲公英、風と共に遠くへ行くがいい。」蒲公英は、風に乗って天空の島まで行けるのかもしれないな。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "バーバラについて…",
      "text": "バーバラはとても頑張っている。ただ、時々無理しすぎだ…ん？どうしてそんなによく知っているかって？西風教会も騎士団の管轄だからだ。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "リサについて…",
      "text": "リサ、彼女がいれば何かと安心だ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "アンバーについて…",
      "text": "アンバーはこのところ着実に成長している。いつの日か、彼女の功績も吟遊詩人によって歌われるといいのだが。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "ガイアについて…",
      "text": "そうか…ガイアも君にアドバイスをしたのか。彼は優れた西風騎士。それは間違いない。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "クレーについて…",
      "text": "遊ぶことが子供の仕事と言うが、クレーが気に入るおもちゃは危険な物ばかりだ。なかなかに安心できない。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "アルベドについて…",
      "text": "「天才」という言葉は、アルベドのような人のためにあるのかもしれない。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "ファルカについて…",
      "text": "ファルカ大団長、彼は西風騎士団の生きた伝説だ。彼が帰ってきたら、話を聞いてみるといい。きっと勉強になると思う。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "ノエルについて…",
      "text": "ノエル、ああ…あの西風騎士になりたがっている少女のことか。彼女の心にはまだ迷いがある。今の彼女が外の危険に触れるのは、まだ早いかもしれないな。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "ロサリアについて…",
      "text": "ロサリアさんはいつも「面倒」と口にするが、実はかなり頼りになる存在だ。この前彼女に「面倒なら私も手伝うが」と言ったら、「そっちのがもっと面倒よ」って言われた。うん…やはり私もまだまだだな。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "ディルックについて·申し訳なさ",
      "text": "ディルック先輩の騎士団への態度には理由がある。申し訳ないと感じつつも結果は変えられない…私の努力で、少しでも騎士団を見直してくれたらいいのだが…ああ、これは私が成すべき責務だ。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "ディルックについて·尊敬",
      "text": "ディルックは…尊敬に値する先輩だ。選んだ道は違うが、モンドを守りたいという気持ちはちゃんと伝わってくる。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "スクロースについて…",
      "text": "錬金術師として、彼女も優れた才能の持ち主だ。それにアルベドがついているから、心配はないと思う。ただ…いや、なんでもない、自分の世界に入り込むのは悪いことではないはずだ。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "エウルアについて…",
      "text": "エウルア？コホン…彼女の生まれについては気にしないであげてくれ。西風騎士団は一人一人を平等に評価する。エウルアは物事の善悪をはっきりと理解していて、才能にも恵まれている。時に危険な発言をするのは彼女の性格からくるものだ。だから、どれほど私に挑戦的な態度を取ろうと、私は気にしない。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "ミカについて…",
      "text": "大団長がミカを遠征隊の斥候の要として選んだのは、任務の必要性だけでなく、彼の地道で勤勉な態度を見込んでのことだ。私の個人的な意見だが、このような仲間と共に仕事ができることをとても光栄に思う。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "ジンを知る·1",
      "text": "私の肩には西風騎士団の信頼、そしてモンドの民の期待がかかっている。だから、気を緩めるわけにはいかないのだ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "ジンを知る·2",
      "text": "ヴァネッサの「蒲公英騎士」の名は現在にまで受け継がれている。かつて、数々の偉大な騎士たちがこの栄誉を授けられてきた。私がこの名を汚すわけにはいかぬのだ。だから、決して気を緩めてはいけない。人々を守るための盾と剣にならなくては。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "ジンを知る·3",
      "text": "伝説の物語にしろ、歴史書にしろ、偉大な騎士はその功績しか記されていない。彼らは一度も道を見失わなかったというのか……？\\n風よ、我が進むべき道を示してくれ。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "ジンを知る·4",
      "text": "仕事に全力を尽くす時、悩みも時間も忘れてしまう。そんな時、ファルカ大団長はこう言った「君はこういうことに最もふさわしい人だ。」と。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "ジンを知る·5",
      "text": "君と行動を共にして、進むべき道がこれ以上なくはっきりした。まるで、ついに頼れる人が見つかったようだ。これは一体……\\nいや、きっとまだ私の努力が足りないのだ。絶対に気を緩めてはならない。西風騎士団とモンドの期待に背くわけにはいかないのだから。……だが、ありがとう。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "ジンの趣味…",
      "text": "君とは書物に記されている英雄たちの伝記について語り合えるかもしれないな。カーンルイア英雄王の物語を聞いたことは？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "ジンの悩み…",
      "text": "もし何か不思議な薬があって、それを飲んだら寝なくても済むとしたら…うん、明日リサに聞いてみるか？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "キャッツテールのピザ……長いこと食べてないな。団長室まで出前をしてくれればいいのに。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "優れた騎士は好き嫌いなどしないのだ。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "味だけでなく、健康にまで気を配ってあるのだな。気遣いありがとう。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "うん、実に晴れやかな気分だ。感謝する。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "ふぅ…とりあえず、ご苦労だった。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "今日はめでたい日だ。なぜなら、風の加護を受けた君の誕生日だからだ。誕生日なんだから、ゆっくり休むといい。\\nオホン…♪ハッピーバースデー、トゥーユー♪…\\nあっ、失礼を許してくれ。このプレゼント、気に入ってくれたかな？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "よしっ、次の目標まで一気に行くぞ。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "風が止まない限り、私は足を止めたりしない。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "一時的に平静を取り戻したとしても、油断は禁物だ。代理団長として、万が一に備えて万全に準備しておくべきだ。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "私はまだまだだ。君と出会ってからずっと君に助けられてきた。この感謝は…\\n風よ、どうか私情を許してくれ。代理団長ではなく、ただの「ジン」として、私の剣は君と共にあることを、ここに誓おう。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "いざ…勝負！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "…ハァ！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "…セァ！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "風よ、私に応えるのだ。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "剣に誓う！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "風の神よ、我らを導きたまえ。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "思ってもない収穫だ。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "うん、実に幸運な一日だ。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "皆も宝が手に入るといいな。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "私は、大丈夫だ…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "仲間を…守らなくては…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "まだ諦めるわけには…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "怪我をしているではないか…一時退却を！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "私に任せろ。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "モンド…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "個人の力には限界がある…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "私には…まだ荷が重い…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "この程度の傷！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "いつでも出発できる。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "準備は万端だ。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "風の導きのままに。"
    }
  ]
}