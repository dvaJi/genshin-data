  "passives": [
    {
      "id": "the_last_djeguako_songstress",
      "name": "最後の詩詠者",
      "description": "元素スキル<span style=\"color:#FFD780FF\">流れる朝のレチタティーヴォ</span>発動時、フィールド上の星の嵐を「流星の嵐」へ変化させる。また、付近にいるチーム内キャラクターが<color=#FFD780FF><b>悠久の歌</b></color>効果の継続期間中に星拡散反応を起こすと、星の嵐の代わりに流星の嵐を生成する。<br/>流星の嵐を生成または起爆させた時、付近の敵の<span style=\"color:#80FFD7FF\">風元素耐性</span>-35%、継続時間6秒。<br/>さらに、<span style=\"color:#FFD780FF\">悠久の歌</span>の継続期間中、付近にいるチーム内キャラクターが<span style=\"color:#FFD780FF\">輝映・星拡散</span>状態に入った時、<span style=\"color:#FFD780FF\">輝映・星拡散</span>の継続時間が4秒延長される。",
      "level": 1
    },
    {
      "id": "dirge_of_the_fandyr",
      "name": "十二弦の涙唄",
      "description": "元素スキル<span style=\"color:#FFD780FF\">流れる朝のレチタティーヴォ</span>発動時、ヴォジャニーツァは25層の<b><span style=\"color:#FFD780FF\">「メロディ」</span></b>と10層の<b><span style=\"color:#FFD780FF\">「コーラス」</span></b>を獲得する。<br/>上記の2種類の効果はそれぞれ継続時間30秒、元素スキル発動時に層数が更新される。",
      "level": 4
    },
    {
      "id": "echoes_over_the_frozen_lake",
      "name": "氷湖を巡る余韻",
      "description": "非戦闘状態の時、元素スキルを長押しすると、ヴォジャニーツァは水の精としての本来の姿を現し、スタミナを消費する代わりに、最大10秒間の遊泳を行う。水の精であるため、水面の移動も可能。再び元素スキルを発動する、継続時間が終了する、あるいはスタミナが尽きた時、ヴォジャニーツァは水の精の姿を解除する。<br/>また、ヴォジャニーツァの泳ぐ速度がアップし、スタミナの消費量も増える。",
      "level": 0
    },
    {
      "id": "heartless_siren_song",
      "name": "無弦の誘い歌",
      "description": "ヴォジャニーツァはコロレフスキー劇団のプリマドンナとして、楽器を演奏する代わりに、自らの歌声を披露する。",
      "level": 0
    }
  ],
