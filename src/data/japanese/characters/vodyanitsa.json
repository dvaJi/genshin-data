  "outfits": [
    {
      "id": 214000,
      "name": "遡行する波間の歌声",
      "description": "ヴォジャニーツァの衣装。デザインは「水の精」にまつわる様々な伝統文化に由来するとのことだが、詳細はヴォジャニーツァに直接訊ねるといいだろう。\nもちろん、その場合は、彼女の公演が一段落して少し余裕ができた頃合いを見計らう必要がある。",
      "isDefault": true,
      "characterName": "ヴォジャニーツァ",
      "characterId": 10000140,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Vodyanitsa_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初めまして…",
      "text": "こんにちは。コロレフスキー劇団のプリマドンナ、ヴォジャニーツァよ。見ての通り…あっ、耳のことよ。普通とちょっと違うでしょう？あたしは「水の精」なのよ。でも、そんなことはどうでもいいの。コロレフスキー劇団の中で一番歌が上手いのはあたし——それだけ覚えておいてくれればいいわ。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話・聴こえる…",
      "text": "…あら？しーっ。誰かが内緒話をしているみたい。うふふ、じっくり聞いてみましょうっと…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話・練習",
      "text": "退屈だし、ここで練習でもしようかしら？…やっぱりやめ。近所迷惑になるかもしれないし、動物たちを困らせたくないものね…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話・休息の取り方",
      "text": "ふう…また陸でこんなに長く過ごしちゃった…もうお肌がカサカサよ。早く水中に戻って休まなくちゃ…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "ええ、いいお天気ね。水底に寝そべって休むのにぴったりだわ。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨上がり…",
      "text": "もう止んだの？つまらないわ…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "あたり一面真っ白…綺麗なものね。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "砂漠にいる時…",
      "text": "暑ーい、カラッカラ…水の中に戻りたい…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "おはよう。あたしもちょうど発声練習が終わったところよ。聞こえてた？無理もないわね。あたしの歌声はよく通るから。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "さあ、お昼にしましょう。午前中ずっと働きづめで、喉が裂けてしまいそう。オデットも呼んで軽く食べましょうか。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "んーっ、やっと一日が終わったのだわ。後でまた湖に浸かりに行こうかしら…あなたも来る？何を怖がっているのよ、あたしは人を引きずり込んで溺れさせるような水の精じゃないわよ。試したいなら、やってあげないこともないけど。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "おやすみなさい。早く寝てね、明日の朝もいつも通り発声練習よ。もちろん、リクエストがあれば別の曲に変えてあげてもいいわ。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "ヴォジャニーツァ自身について・歌声の魅力",
      "text": "残念だけど、あたしの歌声には人を狂わせるような特別な魔力なんてないのだわ。みんながあたしの歌を聴いてくれるのは、ただ単純にあたしの歌がいいからよ。あ、でもそういえば…小さき者についてのジョークがあって…ぷっ…あー、やめやめ、やっぱりナシ。またオデットに睨まれちゃうものね。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "ヴォジャニーツァ自身について・視線",
      "text": "役者もそれ以外も、世間に「見られたい」と望む以上は、世間の「視線」も受け入れなければいけないの。何の代償もなしに、いい思いだけできるなんてうまい話はこの世に存在しないのだから。たとえあったとしても…ふふっ、それは運命が値札を暗がりに隠しているだけよ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "尾びれについて…",
      "text": "陸を歩きやすくするために、尾びれを両脚に変えたのよ。代償？別に何もないわ。ふん、水の精のあたしが水から離れて暮らすんだから、それだけで十分すぎる代償でしょう？これ以上どうしろって言うのよ。これからは美味しいお水の代わりに、ジュースかフォンタしか飲めなくなるとか…？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "お出かけについて…",
      "text": "ずっとスネージナヤにいるのもなんだから、たまに水源をたどってあちこち泳ぎ回って、他のところの歌手がどんな風に歌っているのか見に行くの。これまでに璃月とフォンテーヌと、稲妻、それからスメールへ行ったわ…えっ？誰かに見つからないのかって？そりゃ見つかることもあるわよ、ふふっ。だから世界各地に「人魚」や「鮫人」、それに「魚人」の伝説が伝わっているのね。でもナタだけはちょっと…うーん、とにかく暑いってイメージだから。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「神の目」について…",
      "text": "これ？すごく綺麗だし、装飾品にはぴったりよね。でも歌う時にはいらないし、「神に見つめられる」なんて…ふんっ。そんなものよりもあたしは、観客のみんなに見つめられたいわ。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "フォンテーヌって本当に水質がいいのよ。この前、公演を見に行った時、思わず水底に潜って、ゴクゴク飲んじゃったわ。そしたら、あたしが騒がしすぎたのか、岸辺で訓練していた特巡隊隊員に見つかっちゃって。その子、大声で叫びながら飛び込んできたの…あたしが溺れてると思って、助けにきてくれたのね。でも、あたしは…尾びれをパッと振って、逃げちゃったわ。ふふふっ。それで遠巻きに、立ち泳ぎしながらキョトンと辺りを見回す彼女を眺めてたの。彼女が無事に岸へ戻るのを見届けた後は、また水底に戻ってたらふく飲んだわ。ねえ、今度一緒に飲みに行かない？本当に美味しいんだから。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "「フロストフィンイルカ」って知ってる？あの子たちは普通の人には理解できない…というか、聞こえさえしない「鯨の歌」でコミュニケーションをとるんだけど、あたしたち「水の精」はその歌声がわかるし、覚えられるの。すごく穏やかなフロストフィンイルカがいるのよ。シトワって子なんだけど、前に世界中を旅してた時は、いつもその子の背中に乗せてもらっていたわ。機会があったらあなたにも紹介させてちょうだい。きっと喜んであたしたちを乗せて、遊びに連れて行ってくれるから。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "オデットについて…",
      "text": "オデットが舞台でリハーサルをする時、あたしはいつも舞台裏で彼女のステップの音に耳を傾けているのだわ。着地して、跳んで、回転して…また着地する音…動きに無駄がなくて、リズムも完璧で、見なくたって間違いなく素晴らしい踊りだって分かるわ。どうして表に回って見ないのかって？だって、舞台裏に隠れて彼女をびっくりさせたいんだもの。今まで一度も成功していないけど、それでもやめないわよ。そのためにずっと隠れてきたんだから。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ミティヤについて…",
      "text": "聡明なのは分かるけど、劇場の客席で研究するのは遠慮してほしいわ。うちの劇場は超特大の書斎でも、仕事から逃げるための避難所でもないのだから、きちんと公演を楽しんでほしいものね。さもないと…はぁ、こんなこと言ったって、あたしにはどうすることもできないのよね。だって、観劇マナーを破ってるわけじゃないんだもの。ふんっ、次はもっと派手な曲にしてやるわ。それでも平気な顔して研究を続けられるか…見ものだわ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "アリョーシャについて…",
      "text": "ずっと考えていたのだけど、アリョーシャの子犬たちってあたしの歌がわかるのかしら？きっとわからないはずよね？だってあたしたちも子犬の歌なんてわからないし、そもそも歌うかどうかさえ知らないんだから…でもね、あたしが歌う子守唄はあの子たちに効果てきめんで、いつも出だしを歌っただけで、みんな一斉に眠っちゃうの。はぁ、これってあたしの歌がいいからなのか、そういうわけでもないのか…どっちなんでしょうね。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "ヴェスナについて…",
      "text": "あの人のおかげで、劇場のチケットを転売するダフ屋たちもあまり好き勝手できなくなったみたい。近いうちに、あたしを招いてチケット詐欺防止に関する小規模なシンポジウムを開いてくれるのよ。締めくくりとして、一曲歌うことになっているわ。でも、詐欺を風刺できるような曲なんて一曲も知らないのよね。あ、でも…戦いにおける欺瞞作戦も、一種の詐欺って言えるわよね？そ、それなら…戦いに関する歌でも歌おうかしら？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "ダニカについて…",
      "text": "ダニカさんとはそこまで親しいわけじゃないけど、名声については聞いているわ。それにしても、大変そうよね。女皇陛下の傍に仕えながら、ヴェスナのお目付け役まで務めなきゃいけないなんて…コホン、何でもないわ。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "女皇陛下について…",
      "text": "もし女皇陛下が劇場へいらっしゃったら、陛下のために水の精たちの「古い歌」を歌いたいわ。どれくらい古いかって？うーん…女皇陛下しか聞いたことがない…というほど古くはないけど、それでも小さな記憶の砂塵を舞い上がらせるには十分でしょうね。舞い上がった砂塵が目に入って、みんなの涙腺が崩壊してしまわないといいけど。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "コロンビーナについて…",
      "text": "コロンビーナさんはもう執行官ではなくなってしまったの？残念だわ…あたしずっと彼女の歌声が好きだったのよ。彼女が口ずさむ歌はまるで月光みたいに柔らかくて、軽やかで、ひんやりとしていて——すぐ目の前にあるのに、手が届かない…そんな感じだったのだわ。ふふ、新たな地で、素敵な居場所と、あの歌声を分かってくれる友達を見つけられるといいわね。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "タルタリヤについて…",
      "text": "タルタリヤさんはよくご家族を連れて劇場へ公演を見にいらっしゃるの。タダで入場できるのは執行官だけで、ご家族はチケットを手に入れないと観られないのだけれど、タルタリヤさんはいつもちゃんとご家族の分を手配できているみたい。トーニャのことはあなたも知っているでしょう？あの子、公演がすっごく好きみたいだし…大人になったら本当にうちの劇場の一員になってくれたりしてね。そうなったら、タルタリヤさんが劇場に来る回数もさらに増えそうだわ。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "アルレッキーノについて…",
      "text": "アルレッキーノさんは時々、何人かの子供たちを連れて公演を見に来るの。その中に猫耳の子が一人いるんだけど…確か、リネットって子。その子とリネって子はマジックがとても得意で、うちの年末公演でマジックを披露してくれたこともあるのよ。でも、「山と雀」の演目の時は毎回、アルレッキーノさんはほとんどお一人でいらっしゃるの…もしかすると、あの公演はお一人で楽しみたいのかもしれないわ。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "サンドローネについて…",
      "text": "サンドローネさんって、公演を見に来る時は、いつもそわそわしているのよ。歯を食いしばって宙をにらんでいたり、無表情のまま手に持っている原稿用紙をくしゃくしゃに丸めていたり…誰かに無理やり「招待」でもされているのかしらね？一体誰が彼女を連れてくるのか、推測する気はないけど…ふふっ、少なくとも毎回公演が終わる頃には、和やかな表情になっているから…どうやら来た甲斐はあったみたいだわ。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "「隊長」について…",
      "text": "「隊長」様？彼とはそんなに話したことがないのよね。せいぜい公演が終わった後に偶然会って、少し言葉を交わす程度で…でも、とても厳しくて誠実な人だということは伝わってくるわ。観客席にいる時でさえ、背筋をピンと伸ばして座っていて、まるでフラッグポールか石柱みたい。どんなに恐ろしい嵐も、彼をへし折ったり吹き飛ばしたりすることはできないんじゃないかと思うわ。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "ヴォジャニーツァを知る・1",
      "text": "気になることがあるなら、何でも聞いて。でも、あなたが一つ聞くたびに、あたしからも一つ聞かせてもらうわ。そのほうが公平でしょ？安心して、答えに詰まるようなことは聞かないから。ただ…あたしがまだ聞かせてもらっていないことを聞くだけよ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "ヴォジャニーツァを知る・2",
      "text": "幻想を壊してしまって悪いけれど、スネージナヤの「水の精」は伝説にあるような、歌声で船乗りを狂わせたり、大きな代償を払って陸に上がったり、誓いを破ると泡になっちゃったりするような不思議な生き物じゃないわ。あたしたちはただ普通にスネージナヤで暮らしているだけで、他のみんなと変わらないの。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "ヴォジャニーツァを知る・3",
      "text": "あの出来事があってから、水の精たちはほとんど、スネージナヤ・グラードを去ってしまった…きょうだいのように仲のよかった仲間たちもここを離れようと誘ってくれたけど、断ったわ。もしスネージナヤの市民たちが急に水の精の歌声を聴けなくなったら、きっと悲しむでしょうし、水の精の歌声がスネージナヤに忘れ去られてしまったら、あたしや他の水の精たちだって悲しむもの。だから、どっちも悲しまずに済むように、あたしは残って歌い続けることにしたの。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "ヴォジャニーツァを知る・4",
      "text": "…時とともに、スネージナヤは大きく変わった。あたしの歌声もより多くのものを背負わされて、複雑になって、それが重苦しくて…でも、自分でもどうにもならなくなってきて…そういうのって嫌だから、一つルールを決めたのだわ。家に帰りたくなった時は、スネージナヤで十人見つけて、その人たちが心からあたしの歌声を好きかどうかを確かめるのよ。もし十人の中に一人でも心からあたしの歌を好きでいてくれる人がいれば、あたしはここに残る。もしそんな人が十人の中に一人もいなければ、仲間たちの元へ帰るの。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "ヴォジャニーツァを知る・5",
      "text": "ふっ、幸か不幸か、今まであたしはいつもその「十人」の中に、心からあたしの歌を聴きたいと思ってくれる人を見つけてこられたわ。彼らの中には、大人になったばかりの人もいれば、胸を張って懸命に頑張っていた人もいて…人生の最後の道を平然と歩み終えようとしている人もいたわ…そんな観客たちのためにも、あたしは劇場に魂を残した仲間たちと共に歌い続けていかないといけないの。どう？あなたはあたしの歌が好き？水の精の耳はとっても敏感だから、もし嘘をついたら、あなたの乱れた鼓動だって聞こえちゃうわよ。さあ、三つ数えるから、ちゃんと答えてね。三、二——"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "ヴォジャニーツァの趣味…",
      "text": "気分がいい時、それか、すごく悪い時…あたしはいつも水に飛び込んで、目を閉じて、水の流れに身をまかせるの。そうして漂いながら、波が運んでくるいろんな音に耳を傾けるのだわ。魚たちが集まってウロコがサラサラと擦れ合う音、鯨が遠くの仲間を呼ぶ低くて長い声、水底の泡が浮かび上がって弾ける音…たまに街の近くまで流れ着くと、漁師たちが網を使う掛け声や、水中に飛び込む子供たちの笑い声、これから出航する船や帰港した船がギシギシと軋む音が聞こえてくるの…こうやって世界の声を聴くのって、すごく不思議な感覚よ。あなたもどう？今度一緒に連れて行ってあげるわ。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "ヴォジャニーツァの悩み…",
      "text": "あまりに多くの意味を与えられた声や音は好きじゃないわ。歌声はただの歌声で、波が運んでくるさざめきや、枯れた葉っぱが地面に落ちる乾いた音、誰かの走る足音と同じなの…背負うものが多くなるほど、わかりにくくなって、聞き苦しくなるのだわ。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "甘いものなら何でもいいわ。できれば冷たくて、少し甘くて瑞々しい…あ、考えてみると、これってアイスクリームのことかも。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "水分が全くない物は、どうしても飲み込めないの。無理に飲み込もうとすると、喉が裂けてしまうかもって錯覚に陥るのだわ。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る・1",
      "text": "すごく美味しいわ。もしかして、この前あたしが好みの味について話したから？よく覚えていたわね。今度はあたしがあなたの好みに合うものを作ってあげる。好きな味なんて言ったことないですって？大丈夫、もう知っているから。独自の調査法があるのよ。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る・2",
      "text": "ありがとう。この間、あたしの一番好きな味付けの話をしたこと、覚えているかしら？…ふーん、記憶力がいいのね。じゃあ次はもっと難しいこと言っちゃおうかしら、ふふふ。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る・3",
      "text": "…次は、好みの味をちゃんと教えてあげるのだわ。それか、美味しいものの作り方を教えてあげる。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "お誕生日おめでとう！プレゼントはそこに置いておいたから、後で開けてみてちょうだい。まあ、ちょっとしたアクセサリーとか、おもちゃみたいなものだけど…いいえ、そんなことはどうでもいいの。今、暇よね？さあさあ、あたしの「反響室」へ行きましょう！この前、ツテでナタから「熱狂ターンテーブル」を一台仕入れたのよ。他にも奇抜だけどすごく面白い楽器がたくさんあってね。スネージナヤで最高の音楽パーティーを開こうと思って、準備しているところなの。誰が最初の招待客だと思う？——そう、あなたよ！今日は夜通し歌い明かしましょう！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想・起",
      "text": "こほんっ——いい声が出そうなのだわ。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想・承",
      "text": "もっと高い声が出せそうかも。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想・転",
      "text": "喉の調子がさらに良くなったわ。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想・結",
      "text": "さあ！夜通し歌い明かしましょう！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル・1",
      "text": "耳を澄まして。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル・2",
      "text": "まずは発声練習からね。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル・3",
      "text": "舞台に上がる時間よ。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル・4",
      "text": "こうでなくっちゃ。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル・5",
      "text": "見て見て、あたしの「しっぽ」。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル・6",
      "text": "はあっ！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発・1",
      "text": "これは、塵に還った者への挽歌。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発・2",
      "text": "往日の頌歌を捧げるわ。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発・3",
      "text": "みんな、歌いましょう！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける・1",
      "text": "あら！なんて素敵な宝物なの。早くしまっちゃいましょう。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける・2",
      "text": "見た目はまあまあだし、遊び道具にはなりそうね。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける・3",
      "text": "中身はこれだけ？ふーん…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下・1",
      "text": "ふふ…ふ…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下・2",
      "text": "遊びは終わりよ。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下・3",
      "text": "…ばかばかしいっ。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下・1",
      "text": "ちょっと！何してるの！？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下・2",
      "text": "早くこっちに来なさい！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能・1",
      "text": "ふっ…来たのね…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能・2",
      "text": "波よ…あたしを…故郷へ…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能・3",
      "text": "終幕…？それも悪くないのだわ…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "ダメージを受ける・1",
      "text": "足が滑って…！"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "ダメージを受ける・2",
      "text": "ふん！まだまだ…！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける・1",
      "text": "水中でもそれ、できるかしら？"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける・2",
      "text": "陸地って、ほんっとに不便…！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入・1",
      "text": "呼んだ？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入・2",
      "text": "来たわよ、何の用？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入・3",
      "text": "コホン…喉の調子は悪くないのだわ。"
    }
  ]
