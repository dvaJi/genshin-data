    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "私が、私がいただきますわ！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "私からモラを奪えるとお思いですの？"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "強盗ですの！助けてくださいまし！"
    },
    {
      "id": "410003",
      "type": 2,
