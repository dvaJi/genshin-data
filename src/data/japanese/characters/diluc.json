    },
    {
      "id": 201600,
      "name": "闇夜の灯火",
      "description": "ディルックの衣装。品格を持ち合わせながらも、控えめで気取らない貴族の装い。",
      "isDefault": true,
      "characterName": "ディルック",
      "characterId": 10000016,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Diluc_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "モンドのディルック、約束通り参上。無駄話ならご遠慮願いたい。何か大事をなそうとしているなら興味はある。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·リラックス",
      "text": "たまにはノンビリするのも悪くないな。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·騎士団",
      "text": "騎士団のやつらに相手をさせるべきだな。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·仕事",
      "text": "組合会には、まだ仕事が残っているんだ。君は休むといい。僕は仕事に戻ろう。"
    },
    {
      "id": "1106",
      "type": 1,
      "title": "世間話·準備",
      "text": "事前に準備をし、先んじて攻撃をしかけるべきだ。"
    },
    {
      "id": "1107",
      "type": 1,
      "title": "世間話·計画",
      "text": "休息時に、次の計画を練ろう。"
    },
    {
      "id": "1108",
      "type": 1,
      "title": "世間話·注意",
      "text": "如何なる行動にもリスクはつきものだ。君も気を付けたほうがいい。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日·傘",
      "text": "僕に傘は不要だ。君は好きにすればいい。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨の日·浄化",
      "text": "雨か。残念ながらあの者たちの穢れた心までは綺麗にできないだろうな。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "晴れの日…",
      "text": "自分の道を信じてさえいれば、天気が晴れか雨かなんてどうでもいいんだよ。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "暴風の日…",
      "text": "吹きすさぶ風の音は犯罪の痕跡を隠すのに使われるだろう。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "挨拶はよそう。昨夜は無事でよかった。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "裏メニューを試してみたいのか？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "夜が来た。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "うん、また今度。最後まで見送らせてもらうよ。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "ディルック自身について…",
      "text": "「闇夜の英雄」の伝説？面白い噂だね。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "需要について…",
      "text": "用があるなら言えよ。費用精算についてはエルザーに聞いてくれ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "証明について…",
      "text": "君はもう自分の決意を証明してくれたよ。じゃあ、今度は僕の意志を見てもらおう。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "目の前の道が見えない人にとって、「神の目」は神へのしるべになる。だが、信仰心を抱く者にとって、それは単なる飾りに過ぎない。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "僕は時々「エンジェルズシェア」に行って自分でカクテルを作るんだ。酒場は…情報が集まる場所だからね。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "……フクロウだよ。暗闇の中で目を輝かせ、周りを観察する猛禽。最善のタイミングでのみ行動を起こし、絶対に失敗をしない。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "ガイアについて…",
      "text": "ガイアか……。あの男の言うことは半分しか信用できないんだ。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "リサについて…",
      "text": "リサは騎士団で最も頼りになる人物の一人だよ。彼女がその気になればの話だけどね。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "ジンについて·敵",
      "text": "無意味な雑事はジンの最大の敵だ。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "ジンについて·責任",
      "text": "彼女の誰にも勝る責任感は、かえって彼女自身の本当の役割を分からなくさせている。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "モナについて…",
      "text": "モンドの土地には風神の恵みがある。だから、占星術師による収穫予想はいらないと思うが。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "ディオナについて…",
      "text": "ディオナは僕に堅い態度を取る、それに僕自身も彼女と交流する機会に恵まれてこなかった。家族の恨みが…ん？違う？単に酒が嫌いだと？このモンドに酒の嫌いなバーテンダーがいるとはな。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "ファルカについて…",
      "text": "大団長ファルカ、彼の立場は理解できるが、彼のやり方は認められない。いや…言い過ぎたな、僕はとうに西風騎士団ではない。忘れてくれ。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "エウルアについて…",
      "text": "彼女のことは話に聞いたことがある。独自の理念を貫き、そして一族の束縛から抜け出そうとする彼女は称賛に値する人物だと僕は思う。それなのに…西風騎士団に入ってしまうとは。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "ディルックを知る·1",
      "text": "何かご用かな？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "ディルックを知る·2",
      "text": "うん、騎士団のことか？フン…言うことはないな、目指す先が違うだけだ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "ディルックを知る·3",
      "text": "執事以外の人とチェスをする機会はそうそうないんだ。せっかく時間があるんだ、一局どうかな。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "ディルックを知る·4",
      "text": "チェックメイト。……だけど、僕をここまで追い詰めるなんて、大したものだよ。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "ディルックを知る·5",
      "text": "君、なかなかやるな。チェスでも戦闘でも、いつも僕に驚きをもたらしてくれる。…うん…こんな協力関係は僕にとって新鮮で珍しい…では、今後も共に行こう、「我が友」よ。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "ディルックの趣味…",
      "text": "ウチの別邸にある芸術品？あれは僕の物じゃない。亡き父が趣味で集めていた物さ。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "ディルックの悩み…",
      "text": "本当に倒すべき敵、罪を育む「闇」自身は、剣以外の方法で断ち切らなければいけない……"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "僕のグラスの中身が何の酒かって？ただのブドウジュースだよ。僕はいつもこれを飲むんだ。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "僕はお酒が嫌いなんだ。いや…はぁ、酒の味が好きじゃないんだ。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "とてもよくできている。忘れられない味だ。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "調理した者のこだわりを感じる。悪くない一品だ。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "…ありがとう。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "誕生日おめでとう。今日は君の大事な日だね。君の願いを聞かせてくれ、僕にできることなら、考えよう。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "目標を達成するために、力が必要だ。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "この先に何があるかなんて、あまり考えないんだ。\\nたとえ、誰が僕の前に立ちはだかろうとも、僕は前へ進まなければならないから。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "力が強くなった…だがまだ足りない、これだけでは力の探求に過ぎない。\\n「黎明」が訪れる前に、「暗闇」を照らす人が必要なんだ…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "罪を消すために、僕はひとりで長い夜を歩かなければならないと思っていた。\\nしかし君のおかげで、僕はまた間違っていたと気付けた。礼を言うよ、「我が友」よ。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "フン。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "はっ！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "はあー！"
    },
    {
      "id": "100010",
      "type": 2,
      "title": "元素スキル·1",
      "text": "ふっ！"
    },
    {
      "id": "100011",
      "type": 2,
      "title": "元素スキル·2",
      "text": "はぁっ！"
    },
    {
      "id": "100012",
      "type": 2,
      "title": "元素スキル·3",
      "text": "てあっ！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "判決を、下す！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "火炎よ、燃やし尽くせ。"
    },
    {
      "id": "200003",
      "type": 2,
