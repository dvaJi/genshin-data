  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "私は刻晴、璃月七星の「玉衡」よ。変革の時は来た、千年続いてきた秩序はついに終わる。この歴史的瞬間を、私と共に見届けるわよね？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·手遅れ",
      "text": "無駄な時間を過ごしてると、仕事が終わらないわよ。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·リラックス",
      "text": "休むことも大事だけど、気を抜きすぎてはダメよ。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·機会",
      "text": "冒険も商売も、チャンスは一瞬なの。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "すごい大雨…困ったわね。そもそも、昨日終わるはずだった仕事を、どうしてあの人たちは今日まで引き伸ばしたのかしら？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "雷は怖いものだけど、璃月港の避雷と防火対策は一流だから心配無用よ。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "大丈夫、旅を続けましょう。この程度の雪、気にする必要ないわ。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "晴れの日…",
      "text": "良い天気ね、仕事も一段落したし…買い物にでも行こうかしら？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "おはよう、朝の状態は一日の良し悪しを左右するわ。だから眠くても元気出して起きるのよ！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "私にはお昼休みの習慣がないの。でも、もし疲れてるなら休んでもいいわよ。三分後に起こすから。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "夜が訪れ、灯火がともる。うーん、今日も穏やかな一日だったわね。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "おやすみ、いい夢を。私？…えっと、あと10件仕事が終わったら休めるわね。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "刻晴自身について·理念",
      "text": "自分が正しいと思ったことなら、声を大にして、思い切りやるの——これが私が今まで貫いてきた人生の理念よ。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "刻晴自身について·本職",
      "text": "私の本職は土地管理と建設よ。璃月は人が多くて、領土が広く資源も豊富だけど、計画性に欠いた事業で目先の利益に飛びついていたら、手痛いしっぺ返しをくらうことになるわ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "刻晴自身について·質問",
      "text": "千年の歴史がある璃月にとって、一番重要なのは何だと思う？\\n帝君？…いいえ、私はそう思わない。だって、我々人類は自分の力で今まで生きてきたのよ。なのに、彼は偉ぶって色んなことに口出しする。はあ、言い方が悪いかもしれないけど、彼って本当に何でも知ってるの？"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "刻晴自身について·反省",
      "text": "璃月の様々な事務に携わってから、初めて帝君の苦労を痛感したわ。最近、問題にぶつかるたびに「帝君なら、どうするかな？」って考えるようになったの。もしかしたら、本当に彼は何でも知っているのかもしれない。ああ、私ったらまだまだ甘いわね…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "追求について…",
      "text": "君のことは気に入ってるわ。神のことを100%信じることなく、盲従もしない。自分なりの考えを持ち、問題を提起して、答えが出るまで模索し続ける姿勢が素敵よ。ふふっ、恥ずかしがることないわ、それこそ正しい生き様だもの。だって、神が過ちを犯さないなんてこと誰も証明できないでしょ？"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "試みについて…",
      "text": "そう難しくないから、試しにやってみれば分かるわよ。それでもダメな場合…？ううん、君は私の期待を裏切ったことないから絶対行けるはずよ。"
    },
    {
      "id": "2007",
      "type": 1,
      "title": "励みについて…",
      "text": "私が甘かったわ。帝君みたいになるなんて、私に…できるかしら？えっ？うん…確かにそうね…他のことには自信が持てるのに、こんなことで悩んでいられない。悩むよりも行動するのみ！努力し続ければ、いつか彼にだって追いつけるはずよ！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について·質問",
      "text": "神の目は神に認められた証だってみんな言うけど、そんな物いらない。まるで今まで私がやってきた成果が神のおかげだって言われてるみたいじゃない。ああっ、もうムカつく！自分が努力した結果であって、神とは関係ないっていうのに！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "「神の目」について·反省",
      "text": "帝君は私に…常人を超えた力でみんなを導いて欲しかったのね。ふん、たとえ神に認められていなくても、私は仕事を全うできるのに！ま…待ってなさいよ！彼の期待に応えてみせるんだから！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "シェアしたいこと·提案",
      "text": "「璃月七星」の仕事以外に私は公益活動もしてるの。ほとんどの活動でいい反響をもらったけど、「毎日の勤務時間を2時間増やす」っていう活動だけは大勢の人に反対されたわ。時代を追い越すような提案だったのかな…今度は1時間にしよう。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "シェアしたいこと·グッズ",
      "text": "帝君のグッズ？私の部屋にそんなものがいっぱいあるとでも？私はもう子供じゃないのよ！た、確かに最近、新しい帝君の土偶を買ったけど、あれは自分自身を律するためであって、崇拝とか憧れとかじゃないんだから！"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "興味のあること…",
      "text": "勇気があったから鳥が空を飛べるようになった、というモンドの物語を聞いたことあるわ。でも、果てしない空への憧憬があったからこそ、彼らの翼を羽ばたかせ、勇気が生まれたんだと思う。私にとって、璃月はその果てしない空と一緒なのよ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "鍾離について…",
      "text": "あの「往生堂」の先生、確かに博学多才で、尊敬に値するわ。それに彼の考え方は帝君に似ている気がするの…もし彼がもっと自分なりの見解を持ってくれたら、きっと私の力になるはず。そうなったら、彼をそばに置くのも悪くないわね。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "北斗について…",
      "text": "あの船長はいつもルールを無視するし、豪快な性格にも頭を悩まされるわ。でも彼女の「南十字」武装船隊は璃月にとって欠かせない存在なの。ルールと利益、その均衡を保つすべは正に芸術ね。あっ、ただ法を担当する「天権」にとっては悩みの種でしょうけど。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "凝光について·矛盾",
      "text": "彼女とは同僚よ、でも「そり」が合わないの。彼女にとって璃月は所詮ただの商売の場所。金儲けのためなら彼女は何でもするわ。本当に理念のない人よ。うん…それとも、それが彼女の理念なのかしら？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "凝光について·協力",
      "text": "帝君がいなくなって以来、私たちは色々と共通の念を持つようになったわ、珍しくね。以前の私は、彼女を偏った目で見て評価していた。でも、この時世になって、根本的な理念が違っていても、彼女とは戦友になることができたわ。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "凝光について·些細な事",
      "text": "とは言え！明星斎の「琉璃新月」は私が3ヶ月も前に予約してたのに！実際にお店へ行ったら、彼女が二倍の値段でここ数ヶ月分の「琉璃新月」を買い占めてたの！やっぱり彼女とは「そり」が合わないわ！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "辛炎について…",
      "text": "私も彼女の「ロック」には興味があるの。伝統文化と比べたら確かにちょっとうるさいかもしれないけど、私は別に気にしてないわ。いい音楽はいい音楽だもの、もっと広まるべきよ。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "白朮について…",
      "text": "白朮先生の医術は住民から信頼されてるわ。もし難病に罹ったら、彼に診てもらえば間違いないわよ。うん？変な噂？一つだけ知ってるわね。白朮先生が処方する薬は本当に苦いの。子供に限らず、私にもその覚えがあるわ。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "香菱について…",
      "text": "「万民堂」の若いシェフね。彼女の才能は認めてるけど、腕前はまだ不安定よね。以前、彼女に宴会料理を作ってもらおうとしたんだけど、トカゲとスライムの料理を試食して私はその考えを捨てたわ。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "行秋について…",
      "text": "話には聞いたことがあるわ。名家の出なのに、彼は一族の事業よりも義侠を重んじるって。素敵な人だと思う。一族の縛りを捨てて、自分が正しいと思うことを貫く人は滅多にいないもの。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "魈について…",
      "text": "伝説の少年仙人ね、人が世を治めるようになって、彼も肩の荷が下りたことでしょう。人類はもう護ってもらう必要がない。たとえ厄介な事件が起きたとしても、私たち人類は自分たちの力でなんとかできるから。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "甘雨について·質問",
      "text": "いったい帝君が何をしたのか知らないけど、甘雨があんなにも忠誠を尽くす理由が分からないわ。けど、自分の考えを持たない人にもいいところってあるのよ——例えば不満があったとしても、何も言わず指示に従うとことか。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "甘雨について·反省",
      "text": "最近、私ひとりじゃ決断できないことがあったら、彼女の意見を聞きに行くの。彼女は璃月で最も帝君に詳しい人だからね。はぁ、昔、彼女の目の前で帝君の悪口を散々言ってしまったことを思うと何だか申し訳ないわ。幸い、彼女は特に気にしてないみたいだけど…"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "雲菫について…",
      "text": "もし和裕茶館の前を通るときに大勢の人が集まっていたら、それは雲菫が演出する舞台がやっている証拠よ。雲菫のためだけに茶館を買収しようと考える商人も少なくないの。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "風の神について…",
      "text": "帝君がいなくなって以来、璃月港の未来をどう描いていくべきかずっと考えてるの。帝君がこれまでにしてきたことや、別の神々の統治の手段も調べたわ。でも、隣国のモンドはちょっと変わってるわね…あの風神のやり方で、本当にモンドはこの先も繁栄できるのかしら？"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "煙緋について…",
      "text": "私にとって法律は、過去に起きた「正しい出来事」の要約ね。けど、時効という欠点も持ち合わせているから、まだまだ改善の余地があるわ。璃月が変革を遂げようとしている今、法律に詳しい人材はいくらいても足りない。もし煙緋が私の助手になってくれたら、厄介な案件をたくさん解決できると思うわ。"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "夜蘭について…",
      "text": "夜蘭の先祖は七星に仕えていたわ。私の祖父も、彼女の家族とは学術的な付き合いがあったの。彼女のことをまとめると、物事をそつなくこなし、堅実で頼れる人ってところかしら。あと、総務司に重要な情報を提供してくれることもあるわ。ただ、夜蘭が一体どこから情報を仕入れているのか、私にも分からないけど。"
    },
    {
      "id": "4017",
      "type": 1,
      "title": "藍硯について…",
      "text": "藍硯は確かな腕前を持つ、謙虚な人よ。今後、総務司が民間工芸を広めるための企画をやるとなったら、彼女のような手工芸の達人に助けてもらわないといけないでしょうね。えっ…仕事の話は置いといて？もちろん仕事抜きでも、ぜひ璃月港に遊びに来てほしいわ。彼女とは話が合いそうだもの。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "刻晴を知る·1",
      "text": "私のことを知りたいの？いいわよ、じゃあまず「玉衡」の仕事に関する理念を教えるわね。この100以上に及ぶ重要項目を覚えたら、きっと私の理想を知り尽くすことができるわよ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "刻晴を知る·2",
      "text": "全ての物事は一つ一つ繋がっている。もし一つのことがダメになったら、それに関連する全てのことがダメになるわ。だから「今日のことは今日中に終わらす」っていうのは、私がせっかちだからじゃなくて、遅れることで物事が台無しになるからなの。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "刻晴を知る·3",
      "text": "礼儀に拘る必要はないわよ。「玉衡」と言ってもただの肩書きに過ぎないもの。私の身分なんて気にせず本音を言ってちょうだい——物事をはっきりと言うところが君の唯一無二のところで、そして私が一番気に入ってるところなんだから。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "刻晴を知る·4",
      "text": "君と一緒に冒険して、結構な時間が経ったわね。君こそが私の理想の人だとますます思えるようになってきたわ——えっ？そんなに驚くこと？私が理想とする璃月を築くには、君は欠かせない存在よ？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "刻晴を知る·5",
      "text": "「帝君の土地に、人類が生きた証を残すこと」は…やっぱり簡単なことじゃない。でもね、君と約束したいの——新時代の璃月港が生まれた時、私に会いに来て。見せてあげたい。君との時間と君の支えがあったからこそできたことだろうから。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "刻晴の趣味…",
      "text": "デザインも生地も商品の種類も、多種多様…それが「買い物」よ。ん～この魅力はたまらないわね。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "刻晴の悩み…",
      "text": "確かに、璃月の人の生活水準はどんどん良くなってるわ。でも怠け者も増えてるの。ああッ、もう「璃月七星」が頑張って暮らしを改善しているのは、この怠け者たちを養うためじゃないのに！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "食べ物にはあまり執着しない方なんだけど、あのエビのポテト包み揚げだけは…忘れられないわ。たった一つ食べただけで、口の中が幸せで満たされて、溜まりに溜まったストレスが一気にふっ飛ぶの。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "どんな料理にも理想的な味があると思うの。だからそれ以外の味を私は一切認めない。例えば塩味の杏仁豆腐とか、甘口のハスの実入り茶碗蒸しとか…食べ物を粗末にしないで欲しいわ！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "ええ、私の好物だわ。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "味は普通だけど、君の努力は認めるわ。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "理想の味とは少し違うわね…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "お誕生日おめでとう！君に特別なプレゼントを用意したわ。普通の灯りに見えるけど、雷元素をちょっと加えれば長時間光るのよ。明かりが必要な時に使ってね。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "目標を定めて日々努力を重ねれば、いずれ成長するのよ。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "良かった、これで臨機応変な対応が必要になった時の選択肢が1つ増えたわ。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "「昨日の経験は明日の力になる」、この全ては君と共に手に入れたものよ。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "君と共に旅をして、色々と勉強させてもらったわ。もしね、いつか私が理想の終着点に辿り着いた時…その時は、君も私の傍にいてくれるかな？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "行けっ！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "迅影の如く！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "瞬くまに。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "ほあっ——！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル·5",
      "text": "へいっ！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル·6",
      "text": "はっ！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "逃さない！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "我が剣よ！影に従え——"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "剣光よ、世の乱れを斬り尽くせ！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "努力に見合う収穫ね。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "悪くないお宝だわ。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "拾ったら、出発よ。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "後退するのも作戦のひとつ…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "油断したっ。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "作戦を立て直す必要があるわ。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "下がって、ここは私が！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "ぼーっとしてたらダメ！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "勝機を…間違えたわ。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "く…悔しい…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "期待に…応えられなかった。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "ダメージを受ける·1",
      "text": "くっ…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "ダメージを受ける·2",
      "text": "大した傷じゃない。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "たまたまよ…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "行こう、時間は有限よ。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "急を要する案件？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "速戦即決！"
    }
  ]
}