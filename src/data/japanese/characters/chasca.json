  "outfits": [
    {
      "id": 210400,
      "name": "トラロカンの夜霊",
      "description": "チャスカの衣装。その血には闘争の意志が流れ、瞳には不屈の意志が映っている。死がもたらす痛みも乗り越える——それがトラロカンの英雄の誇り。",
      "isDefault": true,
      "characterName": "チャスカ",
      "characterId": 10000104,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Chasca_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初めまして…",
      "text": "「花翼の集」、チャスカだ。調停が必要な争い事でもあったか？状況によっては金や酒も使うし、恩を売ることもある…銃弾を何発か使ってもいいぞ。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話・俯瞰",
      "text": "方向を見失った時は、高いところに行ってみるといい。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話・声",
      "text": "アビスの声に身を委ねていたなら、私はとっくに私ではなくなっていただろう。本能に抗うことは、生き残るよりも難しい。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話・調停",
      "text": "ちょっとなまってきたな…んー…どこかに調停人の出番はないか？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "雨か…髪と羽根が濡れるな。帰ったらちゃんと手入れをしないと。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "へえ。こんな天気の日に飛ぶとは、雷と競争でもするつもりか？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "風の日…",
      "text": "獲物の匂いが風に乗ってきた…準備に取り掛かろう。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "暴風の日…",
      "text": "風向きは悪くないな——このまま突き進もう！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "「早起きのクク竜は肉を得られる。」と言うだろう？だから、朝食を用意した。任務があるなら、お腹を膨らませてから考えたほうがいい。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "すごい陽射しだな。少し休んでもいいだろう。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "夕飯はどうするつもりだ？「花翼の集」に来るか？強者を歓待するための酒と肉なら、いつでも用意してあるぞ。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "休むのか？確かに、一日中飛んでいたからな…私も銃のメンテナンスをしないと。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "チャスカ自身について・自信",
      "text": "「花翼の集」はかつて、ナタ全域を巡回して警護する責務を担っていた。飛行隊には、ナタで最も優秀な精鋭とも言える戦士たちが集まっていたんだ。\\n今でも多くのクク竜戦士は、馴れ合わず誇り高いところがある…ん？私？私はそういうつもりはない。ただ、自信があるだけだ。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "チャスカ自身について・花翼の集",
      "text": "…初めて「花翼の集」に来た時は、人の世にまったく馴染めなくてな。まるで、突然人間たちの中に放り込まれた異種のようだった…でも、クイクとクイクの…いや、私たちの両親は、あの頃の私を受け入れてくれた。\\n彼らと出会えたことは、この一生で本当に幸運なことだった。だから、私も一生をかけて…彼らの愛する「花翼の集」を守り抜くつもりだ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "面倒事の片付けについて…",
      "text": "それだけの腕前があれば、ナタでお前に手出しできるやつなんかいないと思うが…何事にも万が一ということはある。片づけにくい面倒事に巻き込まれた時は、私のところに来てくれ。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "家族について…",
      "text": "コヤの件は…本当にありがとう。あの時お前がいなかったら、どう片をつけるべきか分からなかったと思う。\\n姉さんはもうそれほど人間に敵対心を持たなくなったけど、長年の習慣を変えるには、もうしばらくかかるだろうな。\\nチメは「花翼の集」に遊びに来るのが好きで、今はヤトランたちとも仲良くしてるみたいだ…ふふっ、あいつらを見てると、幼かった頃の私と姉さんを思い出す。\\n厄介なのは母さんだ…最近、姉さんを見習って早く巣を作れだの、周りにふさわしい候補がいないか探してみろだの、うるさいんだ。一体何が言いたいんだか…ん？なぜ笑ってる？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「神の目」について…",
      "text": "私にとってこの「神の目」は、アビスと戦う上でとても意義深いものだ。もしあのタイミングでこれが現れてくれていなければ、今頃どうなっていたことやら…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "子供の頃に犯した間違いに触れるのを躊躇う者は多い…どうしてだろう？人間もクク竜も、過去の過ちを認識してこそ成長できるものなんじゃないか？\\nだから私は、子供の頃、頭で考えるより先に手が出ていた事実を忘れたふりなどしない。今でも銃を抜く前に数秒…あるいはコンマ数秒、考えるようにしている。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "ナタには背の高い樹が多い。木の上に立つと、視野が広くなって、より高い地点から飛び立てるんだ。お前も試してみるか？安心しろ。本当に落ちた時は、私が受け止めてやる。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "カチーナについて…",
      "text": "「クク竜も空飛ぶ前に崖から落ちる」という言葉がある。カチーナの勝利も、一朝一夕に訪れた奇跡ではなく、長きに渡る努力の結果だ。彼女のような戦士は、もっと尊敬され、栄誉を授かってしかるべきだと思う。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ムアラニについて…",
      "text": "ムアラニが言うには、小さい頃におもちゃを取り合って喧嘩したことがあるそうだ。私はあまり覚えていないんだがな。\\nうーん…子供の頃に喧嘩しすぎたせいか？それか、欲しかったのは「おもちゃ」じゃなかったとか…サーフボードの水上での狩猟性能にでも興味を持ったのだろうか…\\nまあ、理由がなんであれ、ムアラニとの喧嘩を翌日に持ち越すことはない。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "シロネンについて…",
      "text": "シロネンはいつもやる気がなさそうに見えるが、本気を出せば誰よりも真剣だ。\\n彼女に銃の製作を依頼した時は、私もそんなに深く考えていなくて、最低限の条件を言い渡しただけだった。だが実際に製作が始まると、一日中質問攻めにされたな。普段飛ぶときの習慣や求める使用感を問いただされて、図面と廃案で足の踏み場もなくなった…まさか、私があいつよりも早く眠る日が来るとは思わなかったよ。\\nその後は、シロネンが書いた『銃器メンテナンスマニュアル』を無理やり暗記させられた。今後、いちいち手間をかけさせるなと言われたが…実際は安全に気を付けて、慎重に飛ぶようにと伝えたかったんだろう。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "マーヴィカについて…",
      "text": "私の「帰火聖夜の巡礼」での勝率が高いからって、私と炎神様を比較する人がいる。でも、それはあまりにも偏った見方だ。私が木の梢の先に止まっている鷲だとしたら、炎神様は空にある太陽だ。強くなればなるほど、炎神様の計り知れない強さが分かる。私はいくつかの試合に勝っただけだが、炎神様は…この時代の頂点に立つ存在だ。\\n——だからこそ、私は自分がどこへ向かって飛んでいくべきか、はっきりと見えるんだ。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "キィニチについて…",
      "text": "初めてアハウに会った時は、キィニチと家族のように親しいのかと思ったが、全くの見当違いだった…まさか、あんな関係の人と竜が存在するとはな。\\nただ…人間の言葉を解するのは羨ましい。もし「母さん」が言葉を話せたら、私たちもジェスチャーや推測で会話をせずに済んだのにな。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "シトラリについて…",
      "text": "昔、父さんたちは私の身体に残ったアビスの影響を抑える方法について、ナタで一番知識が豊富な方々に教えを乞いに行ったらしい。だが、各々が自分の意見を主張して争い続け、議論は一向にまとまらなかった。そんな状況で、シトラリは黙って部屋から出て行った。そして、戻ってきたと思ったら、酒と料理を自分の前に置いて一人で食べ始めたらしい。その場は一瞬で静まり返ったと父さんが言ってたよ。\\n見た目からは、みんなが恐れ入るような年長者だなんて本当に分からないのにな。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "イファについて…",
      "text": "クイクと父さんはよくイファのところで、医術について議論していた。空中工房から戻った後、私はすぐにイファに姉さんを診てもらった。でも、彼は姉さんを一目見ただけで、「大した問題じゃない。クスコに任せるといい」と言って、すぐに他の患者のところに行ってしまった…はぁ、彼の目は鋭い。私が焦るあまり冷静さを欠いていたんだ。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "イアンサについて…",
      "text": "「自分を鍛える」ことと「他人を鍛える」ことは、全くの別の才能だと思っている。この二つの才能を併せ持つ者は非常に少ないが、イアンサはそういう人物だ。\\n実際、私には教え方がよく分からない。飛行隊のメンバーに手本を見せる時は、簡単で退屈な技術についても長々と説明してしまうし、「それのどこが分かりやすいんだ？」とよく聞かれてしまう。\\nもしイアンサが来てくれれば、「花翼の集」の飛行試練に合格する人は爆増するだろうに…彼女のトレーニングプログラムに飛行という項目がないのが残念だ。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "チャスカを知る・1",
      "text": "調停人として、武力ですべての争い事を解決できるわけではないということは重々分かっている。だが、武力を持っていて初めて話を聞いてもらえるという場合もある。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "チャスカを知る・2",
      "text": "花翼の集の戦士も誇り高いが、クク竜はもっと誇り高い。たとえ私のように幼い頃からクク竜と一緒に育っていようと、竜の背で戦う騎士になるには、厳しい訓練を経て、竜の承認を得なければならない。実力不足の者が竜に乗って空へ飛び立つのは、竜に対しても人に対しても無責任なことだ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "チャスカを知る・3",
      "text": "飛行試練で失敗し続け、クク竜に認められなかった者は、最後にはやる気を失い、挑戦を諦めてしまう。「花翼の集」では、そういう者を「失翼者」と呼ぶ。だが、飛行試練に挑戦しようと思うような者たちはその時点で既に優秀な戦士であることが多い。一時は戦意を失っても、いつか再び燃え上がる日が来るだろう。私たちは失翼者たちを静かに見守っている——クク竜が、まだ飛べない仔竜を見守るように。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "チャスカを知る・4",
      "text": "生まれた時から、私には普通の子供のような幼年時代が与えられなかった…でも「母さん」は私が死に瀕した時、新たな命を与えてくれた。クイクは私が迷って前に進めずにいた時、新たな信念を与えてくれた…私の後ろには、二つの家族——人間の家族と竜の家族がいる。そして、ナタ中の家族と、数えきれないほどの命も背負っている。「アビス」だろうと「苦難」だろうと…全て乗り越えてみせる！"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "チャスカを知る・5",
      "text": "クイクは…私に「英雄」になってほしいと願っていた。だから、進むのをやめたり、弱気になったりするわけにはいかない…\\nでも「遺物」が爆発して、姉さんが私の前に飛び込んできた時、私は…家族を失った恐怖を思い出してしまった…\\n——すまない。こんな話、誰にしていいかずっとわからなくて…ずっと心の奥にしまい込んでいたんだ…でも、おかげで少し楽になった。\\nこの恐怖を忘れられないなら…心に抱いたまま…乗り越えるしかない。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "チャスカの趣味…",
      "text": "「争い事」が好きなやつは、自分から争いを起こしてしまうものだが——「争いの調停」を好きでいれば、「争い事」の方から私のところに来てくれる…ふふっ、冗談だ。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "チャスカの悩み…",
      "text": "アビスの力——今の私になにか影響を及ぼすわけではないんだが、こいつのせいで周りの人に必要以上に心配されてしまう。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "子供の頃は海辺に住んでいたから、よく生魚を食べていた。「花翼の集」に来てからは、強火で焼いた肉が一番好きになった…人間とクク竜の食事はかなり違うが、どっちの食事も楽しめる。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "アルコール度数の高いもの…かな。酒が嫌いなわけじゃないが、飛行前は飲み過ぎないように気を付けてる。でも中にはアルコールの匂いが別の香りでかき消されている美味しそうな食べ物もあって…口に入れてから気づくこともある。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る・1",
      "text": "この料理を肴に酒を酌み交わせば、調停の成功率も三割は上がるのではないだろうか？ふっ、美味い飯と酒は人を楽しくさせてくれるものだ。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る・2",
      "text": "悪くない、ありがとう。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る・3",
      "text": "ん…？クク竜にあげる餌か？…クク竜の口には合わなそうだが。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "この銃には六発の弾が入ってるんだが、そのうち一発は特別な弾だ。広い場所で撃ってみてくれ——空に飛んでから撃つのがいいだろう。\\nん？一発目で特製の礼砲が出るとは、本当に運がいいんだな…お前の誕生を祝うために私が作ったんだ！\\nん？残りの五発は何かって？もちろん全部礼砲だ。ただ、さっきのとは違う色で、完璧とは言えない…来年は全部、最上級のものにする。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想・起",
      "text": "ん？新しい弾か？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想・承",
      "text": "何を調停してほしいんだ？部族間の争いか？それとも大規模な戦いか？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想・転",
      "text": "心と血は「争い」を強く欲しているが…今は、この強い気持ちを力に変えられる。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想・結",
      "text": "「恩と善意には必ず報いるべし。」——これはクク竜の社会においても、人間の社会においても、変わることのない道理だ。これから先、どこへ行こうと、私の「翼」と「銃」はいつでもお前に従う。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル・1",
      "text": "飛ぶか。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル・2",
      "text": "はっ！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル・3",
      "text": "風が立つぞ。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発・1",
      "text": "全弾…発射！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発・2",
      "text": "散れ！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発・3",
      "text": "消え失せろ。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける・1",
      "text": "平等に分配しないことは争いに繋がるものだが…私はいらないから、持っていくといい。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける・2",
      "text": "金で解決できるなら簡単だ——だから、金は沢山あったほうがいい。そう思わないか？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける・3",
      "text": "ああ…キラキラで…美しいな。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下・1",
      "text": "いい勝負だな…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下・2",
      "text": "本気で行かせてもらう。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下・3",
      "text": "戦いたければ…掛かってこい！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下・1",
      "text": "…死ぬな！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下・2",
      "text": "私の後ろに。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能・1",
      "text": "母…さん…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能・2",
      "text": "超えられ…なかった…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能・3",
      "text": "私も…墜ちてしまったのか…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける・1",
      "text": "面倒だな。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける・2",
      "text": "…もう一回！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入・1",
      "text": "今度は誰が騒いでる？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入・2",
      "text": "今日は風が騒がしいな。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入・3",
      "text": "行こう、弾は装填した。"
    }
  ]
}