  "outfits": [
    {
      "id": 203800,
      "name": "新月の星芒",
      "description": "アルベドの衣装。アルベドが実験する時に身に着ける西風騎士団錬金術師の制服。",
      "isDefault": true,
      "characterName": "アルベド",
      "characterId": 10000038,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Albedo_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "ボクはアルベド、西風騎士団の首席錬金術師だ。キミから感じる星海の気配に興味があってね、近くで観察したいと思ったんだ。きっとこれから一緒に行動する機会が増えると思うよ。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·写生",
      "text": "いい景色だね。休憩中にこの景色を絵にしようか。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·探究",
      "text": "「世界の真相」とは…一体何なんだろう？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·過去を懐かしむ",
      "text": "自分の両足で土地を測り、「未知」を知識に変えていく。この感じ、懐かしいなぁ。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "土が潤っている、ボムボムウリの根の採集に相応しいね。大丈夫、ボクに任せて。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雪の日…",
      "text": "師匠…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "晴れの日…",
      "text": "光が十分、生物活動も活発、うん、スケッチに向いてるね。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "おはよう、古代遺物を探しに出かけるのかい？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "こんにちは、キミの足音が聞こえたんだ。工房の外は賑やかだね。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "外はやっと静かになったね、ふう。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "おやすみ、先に休んでていいよ。ボクは最後の実験を終わらせたいんだ。そんなに興味があるなら…明日会う時、実験結果について一緒に話し合おう。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "アルベド自身について·天才",
      "text": "天才？ボクをそう呼ぶ人は多いけど…ボクはそうとは思わないんだ。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "アルベド自身について·人付き合い",
      "text": "人付き合いは…面倒だよ。始めると維持が必要だし、繋がりが途絶えると再び紡ぐのにもっと時間がかかる…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "実験について…",
      "text": "キミ…ボクの実験に付き合ってくれるのかい？光栄だね。\\nああ、緊張しないで。ボクの実験は危険だけど、無実の人を傷つけたりしないから。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "助手について…",
      "text": "ボクの助手になってくれないかい？何度もボクのそばで見てきたから、もう覚えてるよね。安心して、ボクがついてる。たとえ実験をするのが初めてだとしても、問題はないさ。ボクはボクの指導力に自信があるし、何よりもキミの才能を信じてるからね。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「神の目」？所詮実験用の道具だよ、ビーカーやるつぼと変わらないさ。唯一興味があるのはその原理だ…いつかボクが解明してみせる、時間の問題だよ。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "キミに拒否されたら落ち込むから少し言いにくいけど…\\nうーん…キミの周りを飛んでるちびっ子に興味があるんだ、少し貸してもらえないかな？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "石化古樹のことをもっと知りたい？うーん…キミが近くの秘境で見たあれはそれほど古くないものだ。より古い木だと2、3000メートルくらいの高さがあるからね。その根元には大きな蜘蛛が集まってる。その蜘蛛をクチナシとオガルカヤでくくって、カルダモンを塗り、数時間焼いた後の香りは…本当に忘れられないよ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "家族について…",
      "text": "…家族のこと？お母さんって呼んでほしいとアリスさんには言われてるけど…ボクにとっての家族はやはり師匠かな。物心がついた頃から師匠と一緒に探検してたし、錬金術も世の中の知識も彼女が教えてくれたんだ。…ボクにとって彼女は、「家族」や「師匠」って言葉だけでは表現しきれないかもしれない。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "スクロースについて·方向性",
      "text": "スクロースかい？彼女が「生物錬金」に夢中になってる理由は理解できると思うよ…ともあれ、彼女の研究が順調に進んでるのを見ると、ボクも嬉しくなるんだ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "スクロースについて·こだわり",
      "text": "学術的な面に関しては仲良くやってるけど、研究課題以外のことに関しては、こだわりが強すぎるきらいがあるんだ。たとえば、同世代なんだからボクのことは呼び捨てでいいよって言っても、彼女は先生と呼んでくる。はぁ、彼女の好きなようにさせるしかないね。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "リサについて…",
      "text": "リサかい？彼女との話し合いはいつも価値のある結果をもたらしてくれるんだ。あんなに才能があるのに図書館司書の肩書きで満足するとは、きっとその才能に関わる因縁深い理由があるんだと思う。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "クレーについて…",
      "text": "クレーのことは実の妹のように思ってるよ。だから彼女が何かトラブルを起こしても、アリスさんに比べたらその破壊力はかわいいものだって自分に言い聞かせるようにしてるんだ。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "ジンについて…",
      "text": "ジン？彼女は真面目な代理団長で、あの大団長よりも頼もしいと言える…みんなも、彼女が正式に団長となる日を密かに期待してるんじゃないかな。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "行秋について…",
      "text": "行秋かい？彼の書いた小説は面白いよ。ただ、稲妻の「八重堂」がいつも他の作者とコラボしてほしいと言ってくるんだ、そうすれば印税の収入も多くなるってさ。フン、ボクは別にお金に困ってないのに。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "バーバラについて…",
      "text": "バーバラかい？彼女は真面目な牧師だよ。そういえば昔、彼女のクロッキーを描いたことがあってね…絵はどうしたかって？うん…アルバートの購入希望を断って、代理団長にプレゼントしたよ。…人付き合いって、本当に大変だね。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "ドゥリンについて…",
      "text": "ボクの兄弟は今、新しい物事を色々探求しているみたいだ。頭がいいし、考えることも好きらしいね。時々、考えすぎてしまうせいで袋小路に迷い込むこともあるけど、それでもこの世界に対する情熱を捨てないでいてくれている。彼がこの世界にやってきて…というより、家族としてボクのもとに来てくれたおかげで、ボクも人間関係に対する理解が深まった。一番近しい同類がいてくれることで、家も賑やかになったよ。これは間違いなく良い変化だ。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "プルーネについて…",
      "text": "彼女はいつも、「存在の本質」についてボクと議論したがるんだ。でも、ボクがいくつか問い返すと、議論はそこで終わってしまう。それでも嬉しいことに、彼女は次に会う時、答えをびっしりと書いたノートを持ってきてくれるんだけどね。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "アルベドを知る·1",
      "text": "ボクに聞きたいことがあるのかい？何かな。あっ、その前にひとつ聞きたいんだけど、その質問はそんなに時間かからないよね？いま進めている研究がもうすぐ最終段階に入るんだ…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "アルベドを知る·2",
      "text": "ああ、これは余談なんだけど、人の介入がない限り、8倍の大きさの太陽が消滅しないと黄金は自然生成されないんだ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "アルベドを知る·3",
      "text": "人物画の作業時間は主に気分次第だ。ホフマンを描く時は半日もかかったりするけど、ガイアを描く時はちょんちょんで終わるよ——この丸は顔、これが眼帯の紐でこっちが眼帯って具合にね。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "アルベドを知る·4",
      "text": "絵と研究以外では…たまに稲妻と璃月の小説を読んだりしているよ。面白い考えをたくさん見られるし、時には予想もつかないインスピレーションを得られるんだ。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "アルベドを知る·5",
      "text": "今でも、師匠に教わった「黒土の術」は謎だらけだ、師匠は一体この技術で何を作り出そうとしていたんだろう…研究はまだまだ終わらない、キミにも一緒に探索をしてもらわないとね。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "アルベドの趣味…",
      "text": "うーん…研究以外で一番時間をかけたいのは絵を描くことかな。最初は物体や材料の構造を理解し、それを研究に応用するために始めたんだけど、気付いたら趣味になっていた。うん、いいリラックスになってると思うよ。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "アルベドの悩み…",
      "text": "時間が足りないことかな。面倒なことを他の人に任せても、やっぱり時間は足りないって思ってしまうよ。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "スイーツは好きだよ。なんというか…スイーツを食べると、カロリーを一気に補給出来て、集中力や効率が上がるんだ。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "嫌いな食べ物…レストランに出てくる大量の肉かな。ボクは小食だから、「もったいない」上に「美味しくなくなる」。だからいっそのこと、ボクはレストランに行くことをやめたんだ。そのせいで、料理に費やす時間が増えてしまったけどね…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "味覚が色をまるで反射しているようだ…ふむ、これは黄金色だね。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "キミは料理を作ることに時間をかけるようだ。だから、このような味が作れるのだろう。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "量が少し多いようだ…キミも一緒に食べないかい？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "誕生日おめでとう。嬉しそうだね。そんなキミを絵に描いてもいいかい？人の脳の容量は限られてるから、つい忘れてしまうんだ。でも絵にすれば、それは記憶の延長になる。将来、絵をもう一度目にすることで、当時の気持ちを思い出すことができるんだ。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "「黒土」は錬金術の語源でもあり、最初の状態のことだよ。この世界に生きてる限り、ボクたちは存在する意味を探さないといけない。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "「白亜」、それは変化の始まり。不純物が取り除かれ、あらゆる知識を受け入れる準備ができた。ボクと共に世界を探索してみないかい？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "「赤化」、錬金術では感情の精錬を意味するんだ。ボクの赤はキミが原因らしい。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "「黄金」、錬金術の最後の段階。無価値のものは存在する意味を見つけ、黄金になった。ボクも、ちゃんと意味を見つけたよ。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "咲け。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "擬似陽華。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "創生の術。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "今こそ、誕生の時。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "冥王、顕生へ。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "偉業を見届けよ。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "大地の秘宝か。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "無言なる叙述。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "「黄金」の比ではないが、価値がある。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "計算ミス…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "再評価が必要だ…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "策を変えないと。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "ボクに任せて。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "変わって、キミには無理だよ。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "灰は灰に、塵は塵に…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "実験が失敗したのか？"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "ボクの研究も、終わりか…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "ダメージを受ける·1",
      "text": "しきい値内だ…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "ミスしたか…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "了解。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "課外活動かな？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "一緒に探索しよう。"
    }
  ]
}