  "outfits": [
    {
      "id": 205100,
      "name": "高らかな波の舞い",
      "description": "エウルアの衣装。鋭さの中にもエレガントさを感じさせる騎士の服装。",
      "isDefault": true,
      "characterName": "エウルア",
      "characterId": 10000051,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Eula_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "西風騎士団遊撃小隊隊長、「波花騎士」エウルア·ローレンスよ…そう、ローレンス。私は罪人の末裔、いずれ騎士団を裏切る者。今、彼らへの復讐の計画を立てている最中なの。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·騎士の仕来たり",
      "text": "騎士と貴族の仕来たりは似ているわ。ただ、騎士は小難しいところが簡略化されているの。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·剣技",
      "text": "私と西風剣術について学びたい？一人前になった君に復讐するのも、悪くないわね。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·貴族の仕来たり",
      "text": "貴族たちの古い仕来たりなんて…聞き流してちょうだい。いつか私みたいに、何百条もの仕来たりを暗記させられても、本気にしてなくていいから。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "早く傘の下に入りなさい！君が病気になって体を壊したら、復讐する相手がいなくなっちゃうじゃない。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "厄介な天気ね。雷の音は感知能力に影響を与えるわ。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "晴れの日…",
      "text": "良い眺めね！高い所に登れば、敵の位置が一目瞭然だわ。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "起きなさい！日の出前の2時間は、徹夜した哨兵が一番疲れている時間帯よ、絶好のチャンスなんだから！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "眠くなったところを襲われないためにも、お昼は穀物よりも肉類ね。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "「柔らかな風と共に、夜を過ごさんことを」…旧貴族の挨拶の中では珍しく耳触りのいい言葉よ。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "骨笛の子守唄が聞きたい？永遠に目が覚めなくなるけど…こういう復讐の仕方はつまらないわ。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "エウルア自身について·騎士",
      "text": "敵の内部に潜入すれば、簡単に復讐ができるでしょ？だから騎士団に入ったの。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "エウルア自身について·態度",
      "text": "西風騎士団に入ったからには、基本の職務くらい全うするわ。じゃないと、毎日ダラダラと過ごしている人以下になっちゃうじゃない。たとえ罪人でも、そんな恥はかけないわ！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "エウルア自身について·遊撃",
      "text": "遊撃騎士の役目は、自由に攻撃を仕掛けたり、敵の側面から攻撃して牽制したりすること。ルールが少なくて、私にぴったり！"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "エウルア自身について·舞踊",
      "text": "ローレンス家の伝統は、なにもすべてが無駄という訳ではないの。少なくとも「祭礼の舞」は、純潔と高貴で私の心を落ち着かせ、数々の慰めをくれた…この何年もの間、私はそれを忘れず、すべてのステップを体に刻み込んだ…だから、私だけの「西風剣術」を学びたいのなら、まずはこの舞から始めないといけないってことよ！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "共通性について…",
      "text": "私たちって、実は少し似ていると思わない？\\nほら、モンドからすれば二人とも「外来者」でしょ。ただ、君は私と違って皆に歓迎されているけど、私はいつも警戒されて、敵意を向けられる…"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "復讐について…",
      "text": "君と私はこれからも因縁深いかたき同士になっていくと思う。面倒だから、いつの日かまとめて清算しない？10年後か、20年後か…安心して、私がちゃんと覚えておくから。でもそれまで、無事でいてよね。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「罪人の末裔」、この称号は決していいものじゃない。だから、私自身のやり方で復讐を続けないと、そこから脱出することはできないの。そして、復讐するためには力が必要、「神の目」を手に入れたのも、必然だったというわけね。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと·骨笛",
      "text": "私の骨笛には色んな音色があるの。敵を惑わせることもできて、とても実用的でね。よくこれを使って波の音を奏でているから、「波花騎士」の称号もこれが由来ってわけ。でも、骨笛が璃月のものだということは誰も気にしていないみたい。それもそのはずよね、モンドから忌み嫌われている罪人が、人々に忘れ去られた璃月人の教えを受けていることなんて、誰も探究する気が起きないもの…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "シェアしたいこと·酒の飲み方",
      "text": "本来はね、熟成した蒲公英酒には銀の盃を使うべきなの。12分間冷ました後に氷を入れて、氷の6分目のところにお酒がくるように調整する。でもそんな面倒な事、私は御免だわ。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "興味のあること…",
      "text": "霧氷花よ。その花から作られる粉末は、骨笛の音色をより透き通るようにする効果があるの。どうして霧氷花は数が少ないのかしら…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "アンバーについて…",
      "text": "アンバーはいつも自分勝手なのよ。私が騎士団に入った日も、私の宿舎を掃除してくれたり、私を連れて色んな所に見学に行ったり…まるで私が妹に世話をされている姉みたいで。そんなのみっともないじゃない！この恨み、全部覚えておくから！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ジンについて…",
      "text": "代理団長か、彼女と私の一族は宿敵同士なの。でも彼女は、仕事とプライベートを分けられる人で、私の実力を認めている。私を騎士団に誘って、チャンスもたくさんくれた。だから彼女への復讐には、見苦しくない敗北を与えようと考えているわ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "リサについて…",
      "text": "面倒な女、彼女の頭脳には何千…いえ、何万冊もの本が詰まっている。彼女はローレンス家の悪しき歴史を、日付まではっきりと暗記しているわ。彼女なら、あの人の行方が分かるかもしれないけど、そんなことを頼むのは気が引けるわね…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "バーバラについて…",
      "text": "一体どんな秘訣があれば、あんなに人から好かれるのかしら。もし彼女から何か学べたら…いや、やっぱりなし。「アイドル」と「罪人の末裔」なんて、どう考えても噛み合わないもの。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "ファルカについて…",
      "text": "大団長、チッ…彼はとても真っ直ぐな性格をしていて、つまらないことや噂も気にしない。まっ、典型的な良い人ではあるわ。彼とは一度剣を交わしたことがあるけど、引き分けに終わった。けど、あの気楽な表情におちゃらけた態度、きっと手を抜いていたんだわ…私を軽く見ていたのよ！この恨み、絶対に忘れないわ！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "ウェンティについて…",
      "text": "あの吟遊詩人が歌っているのを聞いたことがあるわ。ローレンス家のことを今まで聞いたこともないような口調で面白おかしく語っていた。私ですら笑いを堪えきれなかったの…この恨み、絶対に忘れない！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "レザーについて…",
      "text": "礼儀にこだわる必要もなく、他人の目も気にせず、一族の責任なんてものもない…彼の生き方は、楽でいいと思う。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "スクロースについて…",
      "text": "あの錬金術師…前にアビス教団の拠点に潜入できる装置をくれたことがあるの。でも結局爆発しちゃって、その場で13体ものヒルチャール暴徒に囲まれたわ…後から彼女に落とし前をつけに行ったんだけど、申し訳なさそうに慌てていたし、壁にはずらりと並んだ失敗記録も貼ってあって…何も言えなかった。まあ体が汚れてみっともなかっただけで、傷を負わなかったからいいけど。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "ディルックについて…",
      "text": "私には気が合わない人が騎士団に何人かいる、そして彼も騎士団のことが気に食わない。理論上、私たちは同じ立場にいる。でも彼のそっけない感じ、なんだか代理団長よりも面倒な人みたい。私は関わり合いたくないわ。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "ディオナについて…",
      "text": "彼女のこと？不思議なバーテンダーよね、この私と気が合うなんて。彼女はモンドの酒造業を潰すためにバーで働いていて、私は騎士団に復讐するために騎士団にいる。こんな奇妙な縁があるのね…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "煙緋について·出会い",
      "text": "話せば長くなるけど…ある日、アビス教団の危険物を追跡していたら、たまたま彼女を救出したの。当時、教団の危険物は一般の貨物を装って、ドーンマンポートから璃月港まで運ばれていた。彼女はその商船の顧問を担当していて、貨物に問題があることに気付いて、独自に調査していたらしいけど、結局危険な状態に陥ってしまった。私たちの到着があと数分遅れていたら、大変なことになっていたわね。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "煙緋について·見解",
      "text": "それ以来ずっと連絡を取っているの。彼女の賢いところ、結構好きなのよ。規則を大切にはしているけど、融通も利いてね、騎士団の人たちも彼女から学んだらいいのに…それに彼女なら、私が探しているあの人を見つけられるかも…私への恩返しとしてね。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "ミカについて·交流",
      "text": "ミカが遊撃小隊に配属された時、彼も他と同じように何日もしないで辞めていくものだと思っていたわ。けれど、彼は何も言わずに任務を完璧にこなした。それどころか、使い走りの任務をすべて自分から引き受け、他の人とコミュニケーションが必要になることは、私の代わりにしてくれたの…ふんっ、どうしてみんな私の世話をしたがるのよ。まったく、いったい誰から学んだのかしら…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "ミカについて·帰還",
      "text": "今回ミカが遠征隊から戻ってきたけど、性格に変化はなかったわ。でも、実力のほうは格段に増していた。どうやら大団長はきちんとみんなを鍛えていたようね…ん？彼自身もそれに気付いていない？それは彼が鈍いからでしょ…それか、謙虚なのよ。私の小隊の一員なんだから、成長したことなんて一目でわかったわ。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "エウルアを知る·1",
      "text": "罪人の経歴なんて、知っても得しないわよ？どうせ何をやったって敵視されるし、危険人物と見なされてしまう。これでも今は大分ましになったのよ、騎士団に入っていなかった頃は、鹿狩りもモンドショップも私に物を売ってくれなかった。だから、野外で狩りをしては、食料を自分で調達していたの。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "エウルアを知る·2",
      "text": "腰を低くして、謙虚でいれば許されるかもしれないって、そう人から勧められたけど、それって「罪人」になったことがないから言えるのよ。「罪人」は簡単に許される存在じゃない。だったら、正々堂々と正面から復讐した方が格好がつくでしょ。私が負けたら、きちんと言うことを聞く。逆に私が勝ったら、私の要求を満たしてもらう…例えば、うん、ちゃんと物を売ってくれるとか。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "エウルアを知る·3",
      "text": "西風騎士団は結構まともね、少なくとも個人の「身分」よりも「才能」を重視するもの。\\n過去に何度か騎士団の精鋭たちと勝負をしたことがあるんだけど、実力でねじ伏せたわ。そしたら、入団の誘いが来たというわけ。騎士団で仕事ができれば、復讐も簡単にできるし、生活も改善される、こんないいことってないでしょ？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "エウルアを知る·4",
      "text": "ローレンス家は没落してから汚名を背負うことになったの。それまでは栄光に満ち溢れていたけど、そんなことは皆忘れてしまったかのよう。大団長からは、騎士として上手くやっているし、ローレンス家の栄光を取り戻すとまではいかなくても、偏見に対し正面から立ち向かえているって言われたわ。この言い方、結構私好みなのよね。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "エウルアを知る·5",
      "text": "もし一族の人がまだそんなことに捉われていて、モンドに手を出そうとしているのなら…彼らとローレンス家の名は、この私が直々に抹殺する——これが私が唯一行いたいと思う、「一族の役目」かな。そのあとは、適当に苗字を変えるわ。そうだ、君が付けてもいいわよ！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "エウルアの趣味…",
      "text": "涼しくなるようなことが好きね。キンキンに冷えたお酒とかドリンクを飲んだり、峡谷の峠に座って風にあたったり、ドラゴンスパインの湖に飛び込んで浸かったり。湖のそばを歩いていたら、私に氷水の中に引きずり込まれる、なんてこともあるかもね。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "エウルアの悩み…",
      "text": "酒場の客が多くて、相席をする時かな。ローレンス家の人だと知った途端、威張ってくる人や挑発する人、意地悪をする人があちこちからやってくるの。もう、そんなんじゃお酒も飲めなくなるじゃない。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "手作りのお菓子を作るのが好きよ。と言っても甘いものじゃなくて、トマトアスピック入りエッグロールを冷やしたものね。冷えたラズベリーのミントカクテルにとても合うの。でもやっぱり、私のお菓子を食べて笑顔になってくれることが一番嬉しいかな。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "濃厚なスープは受け付けないわ。重い口当たりと、満腹感があるから運動と戦闘に影響が出るし、持ち運ぶのも面倒。私の天敵ね！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "へぇ？これって私への挑戦かしら。受けて立つわ。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "まあまあね…君も食べてみたら？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "まったく君って人は…私への復讐かしら？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "今日は記念すべき日ね。君の成長は年齢だけに限らない。特製の骨笛を君にあげるわ、私の吹き方を学んでちょうだい。私が君に復讐する時が来たら、その骨笛を吹いてね。そうしたら私を足止めできて、時間稼ぎにもなるし、面白くなると思うわ。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "戦闘スキルが大幅に向上したわね…でも、まだ満足してはいけない。騎士団には非常に勤勉な人がたくさんいる。彼らを倒して復讐を果たしたいのなら、よりもっと前に進まないと！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "中々悪くないわね。今の私の実力なら、代理団長にも勝てる気がする！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "おかしいわ…君と一緒にいると、力の成長がとても速い…どうやら君とかたき同士になったのは幸運なことらしいね、これからもついていくわ…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "よし！この堅氷の力はもうコントロールできる。代理団長どころか、大団長ですら私を止められないわ！さっそく計画を立てて、進撃開始よ。西風騎士団を倒した後は、君だからね。逃がさないから、おとなしく私のそばにいて、すべてを見届けなさい。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "喚きなさい。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "結霜せよ。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "粉々よ。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "ジャッジメント！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル·5",
      "text": "砕け散れ！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル·6",
      "text": "目には目を。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "氷浪のように唸れ——"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "霜降の怨！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "堅氷、怨を絶つ！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "ダッシュ開始·1",
      "text": "早く。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "風の翼を広げる·1",
      "text": "視界が開けたわね。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "新たな発見ね。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "だいたい役に立ちそうね。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "罪人にも幸運な時ってあるのね…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "不利な状況ね…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "迎え撃つわ…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "やるわね。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "私に任せなさい！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "距離を取りなさい！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "情けない最後ね…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "まだ…やれる…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "これが、罪人の末路…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "中々。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける·2",
      "text": "やるね。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "遊撃騎士、行動に移る。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "先鋒は私が。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "計画は立てたの？"
    }
  ]
}