      "title": "HP低下·3",
      "text": "慎重に。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "援軍の到着です！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "後方へお下がりください。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "策に…問題が…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "策を見誤りました…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "二度とこのような過ちは…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "失策です。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける·2",
      "text": "手強いですね…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "そうですね、今回の作戦は…"
    },
    {
      "id": "600002",
