  "outfits": [
    {
      "id": 211300,
      "name": "軽やかな飛翔",
      "description": "イファの衣装。他の帽子を被っているところは見たことがないと思うかもしれないが、イファは頻繁に帽子を変えている。ただ、どれも同じデザインなだけだ。「きょうだい、帽子を被るときは必ず紐を結べよ。風に吹き飛ばされたり、通りすがりの竜に引ったくられたりするからな。」——彼は帽子のつばを持ち上げて、ため息混じりにそう言った。",
      "isDefault": true,
      "characterName": "イファ",
      "characterId": 10000113,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Ifa_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初めまして…",
      "text": "<color=#37FFFF>イファ：</color>よう。「花翼の集」の竜医、イファだ。他のやつから俺のことを聞いてるかもしれないが、先入観はなしで頼む。どんな印象だろうと、ゼロから友達になりたいんだ。\\n<color=#37FFFF>イファ：</color>そうだ、こっちも紹介しておこう…こいつは助手のカクーク。竜でありながら医者でもあるんだ。仲良くしてやってくれ。\\n<color=#37FFFF>カクーク：</color>よう、きょうだい！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話・休憩",
      "text": "世の中、いつまでものんびりしちゃいられない。休憩は終わりだ。そろそろ動くとするか。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話・おやつ",
      "text": "暇になると、つい何か食べたくなるんだよな…飴に果物、それとジャーキーもあるんだが、食うか？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話・鳴き声",
      "text": "動物の鳴き声がしたよな？…うーん、俺の勘違いか…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "おっと気をつけろよ、カクークが身体をブルブルさせて水を払うかもしれないからな。まあでも、もう雨に濡れてるわけだし、避ける意味あんのかって話だけど。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "知ってるか？雷を怖がる竜も結構いるんだ。毎回なだめるのに時間がかかるんだが、それはそれでなかなか面白いんだよな。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "おっと、風が冷たすぎて目も開けてられないな…こりゃ、しばらく飛ぶのはナシか。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "暴風の日…",
      "text": "帽子が吹き飛ばされるか、首紐で絞められるか、どっちを選ぶかだな。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "おはようさん。別に早起きしたかったわけじゃないが、これ以上寝てたら、診療所にいる患者たちが腹を空かせて騒ぎ出しちまう。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "ちょうど昼メシを食べに行こうと思ってたところだ。一緒にどうだ？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "夜はなるべく家にいるようにしてんだ、急患が来てもすぐ対応できるようにな。まあ何事もなけりゃ、ゆっくり休むが。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "おやすみ。きっと明日も何かしらで忙しくなるだろう。今のうちにちゃんと休んでおかないとな。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "イファ自身について・友達",
      "text": "友達は結構多いほうだな。手のかかるやつもいれば、逆に癒してくれるやつもいる。その中間を行ったり来たりするやつもいる。でもまあ、みんないいやつらだよ。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "イファ自身について・満足",
      "text": "他のやつがどうかは知らないが、俺は誰かに必要とされると少しだけ満たされた気分になるんだ。人間ってのは、そうやって少しずつ埋まっていくもんなのかもな。みんなそれぞれ、自分を満たせるものを見つけられるといいんだが。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "確認したいことについて…",
      "text": "<color=#37FFFF>イファ：</color>次の旅程はちゃんと決めたか？体調は？必要なものは全部持ったよな？\\n<color=#37FFFF>イファ：</color>…よし、見たところ元気そうだし、パイモンも腹いっぱいみたいだ。しっかり準備できてるようだな…だがちょっと待った。やっぱ最後にもう一回チェックさせてくれ…\\n<color=#37FFFF>カクーク：</color>きょうだい、マジかよ！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "確認について…",
      "text": "付き合いもそこそこ長くなってきたが、たまに口うるさいとか、世話焼きすぎだって思うことはないか？…え、ない？ちょうどいいくらいだって？ふぅ…ならよかった。普段喋れない生き物ばかり相手にしてるせいか、なんにおいても繰り返し確認しないと落ち着かないタチでな。あんたが気にしないってんならそれでいい。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「神の目」について…",
      "text": "これ、結構便利でな。竜が飛び疲れたときに風でちょっと支えてやったりするんだ。こっそり、バレないようにな。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "エサで動物を「釣る」って手は確かに便利だが、やりすぎると調子に乗るし、しまいにはラクする癖がついちまう。だから話が通じるんなら、できるだけ道理を教えるようにしてるんだ。罠にかかればケガするし、むやみに物を口にしたら毒に当たるってことくらいはな。\\n手間はかかるが、やる価値はあると思う。それに動物は人より賢いときもあるしな。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "よーく観察さえすりゃ、この世界には面白いもんが山ほどあるって気付く。時間さえあれば、一日中でも自然を眺めてられるんだけどな。ま、残念なことに仕事ってのは向こうから勝手にやってくるもんさ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "カチーナについて…",
      "text": "カチーナが竜好きなのは見てりゃ分かる。もし本気で学べば、きっといい竜医になれるだろう。だがあの子はもう立派な戦士だ。わざわざ俺の生徒になる必要はないな。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "シロネンについて…",
      "text": "シロネンと話すのは結構好きなんだ。いつもすごいアイデアを思いつくからな。たまに機能を重視しすぎて、とんでもない見た目の道具を作るが、俺に言わせりゃ「見た目のインパクト」も立派な機能のひとつだ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "キィニチについて…",
      "text": "真面目な話、アハウって本当に生き物なのか？\\n前に診察に来たとき、いくら調べても異常が見当たらなくってな。で、キィニチに「こいつの頭が正常になるまで叩いてみろ」って言ったんだ。\\nそしたらアハウのやつ、すぐ元気になってな。どう思う？これって偶然か？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "チャスカについて…",
      "text": "調停者ってのは大事な役目だ。俺が治せない「病」も、彼女なら治せるんだからな。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "オロルンについて・深く考えるな",
      "text": "あいつの考え方はかなり変わっててな。深く考えたところで、どうせ理解できないから悩むだけムダだ。\\nでもまあ、悪いやつじゃない。長く付き合えば、独特なやり方で周りの友達を気にかけてるって、そのうち分かるだろう。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "オロルンについて・知りたいこと",
      "text": "もう慣れたっつってもな…たまにあいつの頭ん中に入って、何考えてんのかじっくり見てみたくなることもある。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "シトラリについて…",
      "text": "ばあちゃんか…ばあちゃんはすごい人だぜ。パジャマの柄もやたらバリエーション豊かだしな、ははっ…\\n余計なトラブルには巻き込まれたくないんで、黒曜石の老婆の伝言はそのままオロルンに伝えるようにしてる。一言一句、違えずにな。余計な探りは入れないほうが身のためだ。じゃないと、孫と一緒にデコピンを食らう羽目になる。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "マーヴィカについて…",
      "text": "前に急患が出たとき、炎神様が俺を乗せて運んでくれたことがあるんだ。ほんとやばかったぜ、きょうだい。目ん玉ぐるんぐるんな状態で竜を治療する羽目になってな…でも、あの時初めて自分がそんな状況でもやれるんだって知ったよ。こうやって人の潜在能力っつうのは引き出されるもんなんだな。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "ヌヴィレットについて…",
      "text": "もしその人が体調を崩したら、俺に診てほしいって？うーん、それは俺の管轄外じゃないか？\\nまあ…カクークの新しいきょうだいってんなら…やれるだけやってみるが。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "イファを知る・1",
      "text": "<color=#37FFFF>イファ：</color>診療所の看板は俺が描いたんじゃない。本当だ、信じてくれ。\\n<color=#37FFFF>カクーク：</color>ハハッ！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "イファを知る・2",
      "text": "実は俺も、カクークが初めて人の言葉を喋ったのがいつだったか覚えてないんだ。ただ、ある日の明け方に「太陽が出てるぞ、きょうだい！」って叫ぶのを聞いたのはハッキリ覚えてる…それで朝五時に目が覚めたからな。どんだけ驚いたことか。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "イファを知る・3",
      "text": "飛行試練ならとっくにクリアしてる。一応どのクク竜も呼べるんだが、カクークが来てからは、俺が他の竜を呼ぶのを嫌がってな。カクークはまだ小さいが…ま、あいつが出来ると思ってんなら俺も信じてやるさ。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "イファを知る・4",
      "text": "もしできるなら、俺はみんなに安心感を与えられる存在でありたい。信頼されるってのは簡単じゃないし、誰にでもできることじゃないからな。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "イファを知る・5",
      "text": "竜医ってのはいい仕事だよ。別れはつきもんだが、それでもこの道を選んだことに後悔はない。動物って子供みたいなもんで、話は通じにくいし、すぐトラブルも起こすが…俺にとっちゃ、どいつも守る価値のある未来なんだ。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "イファの趣味…",
      "text": "花翼の集には歌好きなやつが結構いてな。俺もたまに歌詞を書いたり、楽器を弾いたりするんだ。いい気分転換になるんだぜ。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "イファの悩み…",
      "text": "<color=#37FFFF>イファ：</color>今のところ、すぐ解決しなきゃならないような深刻な悩みはないな…しいて言うなら、カクークがもうちょいマシな言葉を覚えてくれると助かるくらいか。\\n<color=#37FFFF>カクーク：</color>なにデタラメ言ってんだ？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "やっぱ新鮮な果物が一番だな。腹も満たせるし、喉も潤せる。小さく切ったもんなら、カクークにやるのにちょうどいいしな。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "新鮮な果物はいいんだが、料理に入れるのはちょっとな…そのまま食べちゃ駄目か？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る・1",
      "text": "<color=#37FFFF>カクーク：</color>俺にもくれよ、きょうだい！\\n<color=#37FFFF>イファ：</color>こういう時だけちゃっかりしてるんだよな。はいはい、半分やるよ。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る・2",
      "text": "美味いな。ジュースを持ってこよう。何が飲みたい？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る・3",
      "text": "<color=#37FFFF>カクーク：</color>ほんとかよ？きょうだい、なんだこれ…\\n<color=#37FFFF>イファ：</color>いやいや、食べられるだけ十分だ。ありがとな、きょうだい。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "誕生日おめでとさん！いつまでも健康で、ずっと若々しくいられますように。\\n時間の流れは止められないが、心の若さは保てるはずだ。何より、気分が落ち込んでると身体にもよくないからな。今日は悩みなんて忘れて、ぱーっと楽しいことでもしよう。\\nそうだ、好きな音楽はあるか？俺が弾いてやるよ。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想・起",
      "text": "ウォーミングアップってか？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想・承",
      "text": "自分が健康じゃなきゃ、他人の面倒なんて見てられない。そうだろ？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想・転",
      "text": "あんま使わない銃ほど、しっかりメンテしとかないと…って俺は何言ってんだろうな、きょうだい。俺は医者だし、よっぽどのことがなきゃ銃なんて使わないさ。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想・結",
      "text": "<color=#37FFFF>イファ：</color>ありがとな、きょうだい！遠慮は無用だ。何かあったらいつでも呼んでくれ！\\n<color=#37FFFF>カクーク：</color>いつでも呼んでくれ、きょうだい！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル・1",
      "text": "さ、行くぞ！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル・2",
      "text": "風向きに気を付けろ！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル・3",
      "text": "<color=#37FFFF>カクーク：</color>飛ぶぞ！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル・4",
      "text": "<color=#37FFFF>カクーク：</color>ぬぬぬ、んぐっ！\\n<color=#37FFFF>イファ：</color>がんばれ！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発・1",
      "text": "気を付けたほうがいいぞ！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発・2",
      "text": "恨みっこなしだぞ！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発・3",
      "text": "おっと、逃がすかよ！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける・1",
      "text": "これを見つけるなんて、さすがだな。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける・2",
      "text": "今日はツイてるな。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける・3",
      "text": "もし持ちきれないなら、カクークに手伝わせるぞ。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下・1",
      "text": "息が苦しい…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下・2",
      "text": "もう少し粘るつもりだ…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下・3",
      "text": "<color=#37FFFF>カクーク：</color>イファ、イファ！\\n<color=#37FFFF>イファ：</color>分かった分かった…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下・1",
      "text": "来たぜ。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下・2",
      "text": "応急手当をしないとな。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能・1",
      "text": "戦いはまだ終わっちゃいない…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能・2",
      "text": "わりぃ、役に立てなかった…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能・3",
      "text": "医者の心残りだぜ…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "ダメージを受ける・1",
      "text": "よせっての…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける・1",
      "text": "きょうだい、マジかよ！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける・2",
      "text": "おいおい…もうちょい優しくしてくれよ？"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入・1",
      "text": "出かけるのか？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入・2",
      "text": "救急キットはバッチリだ。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入・3",
      "text": "いい旅になるといいな。"
    }
  ]
}