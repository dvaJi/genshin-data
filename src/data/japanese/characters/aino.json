      "type": 2,
      "title": "宝箱を開ける・1",
      "text": "どれどれ…中にパーツはあるかな？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける・2",
      "text": "わぁ、いっぱい入ってる！イネファがいてくれたらよかったのに。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける・3",
      "text": "わっ！…もっと散らかっちゃった…ごめんなさい！わざとじゃないよ。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下・1",
      "text": "え、ええっと…おかしいなぁ…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下・2",
      "text": "全然面白くないよぉ！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下・3",
      "text": "ずるいずるい！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下・1",
      "text": "言うこと聞いてよぉ！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下・2",
      "text": "大丈夫、アイノに任せて！"
    },
    {
