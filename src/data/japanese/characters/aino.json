  "constellations": [
    {
      "_id": 1211,
      "id": "the_theory_of_ashfield_equilibrium",
      "name": "灰と力場のバランス理論",
      "description": "アイノが元素スキル<color=#FFD780FF><b>アイデアキャッチャー</b></color>または元素爆発<color=#FFD780FF><b>お水ひえひえ装置</b></color>を発動すると、アイノ自身と周囲のフィールド上の他のキャラクターの元素熟知+80、継続時間15秒。<br/><br/>この命ノ星座による元素熟知のアップ効果は重ね掛けできない。",
      "level": 1
    },
    {
      "_id": 1212,
      "id": "the_principle_of_transference_in_gear_differentials",
      "name": "歯車差分の進数原理",
      "description": "元素爆発<color=#FFD780FF><b>お水ひえひえ装置</b></color>の<span style=\"color:#FFD780FF\">びしょぬれゾーン</span>の継続時間中、アイノが待機中の場合、フィールドにいる自身のチーム内キャラクターの攻撃が近くの敵に命中した時、<span style=\"color:#FFD780FF\">「落ち着いた方がいいカモ？」</span>はその敵に対して追加で水弾を1発発射し、アイノの攻撃力25%と元素熟知100%を基にした<span style=\"color:#80C0FFFF\">水元素範囲ダメージ</span>を与える。この効果は5秒毎に1回のみ発動可能。また、与えたダメージは元素爆発ダメージと見なされる。",
      "level": 2
    },
    {
      "_id": 1213,
