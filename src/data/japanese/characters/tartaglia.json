  "outfits": [
    {
      "id": 203300,
      "name": "栄光の刃",
      "description": "タルタリヤの衣装。ファトゥス第十一位「公子」の身分を表した輝かしい服装。",
      "isDefault": true,
      "characterName": "タルタリヤ",
      "characterId": 10000033,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Tartaglia_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "俺はファデュイ執行官第十一位、「公子」タルタリヤだ。そして君は——争いを招く者だね、実に愉快だ。きっと相性がいいと思うよ。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·暇",
      "text": "ここに立ってても、相手はやってこないよ。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·手合わせ",
      "text": "んーー、この辺りに戦い甲斐のある強敵はいないんだろうか？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·ファデュイ",
      "text": "他の執行官たちは何してるんだろうね。まあ、どうせ訳の分からない「壮大な計画」とやらを進めてるんだろうけど。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "世間話·故郷の雪原",
      "text": "俺の故郷の雪原でこんな風に立ってたら凍死してしまうよ、ハハハッ。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨上がり…",
      "text": "雨が水面を打つ音は魚を驚かしてしまう。それに比べ、雨上がりは釣りをするのに絶好の時間だ。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雪の日·異国",
      "text": "ハハッ、故郷の方でも今は雪が降っているのかな？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日·スネージナヤ",
      "text": "素晴らしい雪だね！天地が月光のように綺麗だ。こんな舞台で流れる鮮血はより際立つだろうね。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "風の日…",
      "text": "ほう、風から争いの気配を感じる。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "暴風の日·異国",
      "text": "清々しい風だ！"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "暴風の日·スネージナヤ",
      "text": "頭も体も、この身を通り抜ける風に洗われたようだ。気持ちいいね。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "やあ、相棒！今日は元気そうだね。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "調子よさそうだ、俺と手合わせしてみるか？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "ぷはーーッ、食った食った。体を動かしてこよう。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "楽しい一日だった。また明日だ、相棒！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "タルタリヤ自身について…",
      "text": "戦士たる者、常に挑む心を刃の先に留めなければならない。勝とうが負けようが、それによりかけがえのない貴重な経験を得られるんだ。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "同僚について…",
      "text": "君と同行してることは、他の執行官の間でとうに広まってるだろうね。あいつらの顔を見てみたいもんだよ、ハハハッ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "武器について…",
      "text": "実は弓が一番苦手な武器なんだ。だからこそ、使ってるよ。手強い相手ほど、征服し甲斐がある。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "生存について…",
      "text": "神の目を持たない君がこれほどの力を持つとは、実に楽しみだ…君が自身の限界に達する前に、すべてを捨てて俺と命を賭けた戦いをしよう、それまで絶対に倒れるなよ！死ぬなんてもってのほかだからね。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "誘いについて…",
      "text": "相棒、ファデュイに入ってみないか？…いや、やっぱ今のはなし。今の君の立場だからこそ、一緒にいる俺に他の執行官と殺し合う理由ができるんだから。こんなチャンス、そう易々と捨てられるわけがないよね。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "ハハッ、強くなれるなら、「神の目」でも「邪眼」でも、アビスの罪人から学ぶことさえも厭わないさ…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "果てしない雪原では、命はいつだって骨を砕くような一面の純白と隣り合わせで、足跡さえもそこには残せない。そう、俺たちは毎日見えない敵と戦っていたんだ。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "かつて俺は世界の深淵で巨大な魔獣とにらみ合った。いつの日か、あの骨さえも凍るような強大な怪物を正々堂々と倒してみせる。その時は、君に見届けてほしいんだ、相棒！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "スカークについて…",
      "text": "もう何年師匠に会ってないんだろうな。次に彼女と手合わせする時は、少なくとも両手を使わせてやりたいよ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "鍾離について·推量",
      "text": "あいつは只者じゃないね、真の実力はどんなものだろうか…期待してしまうよ。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "鍾離について·挑戦",
      "text": "鍾離先生は最近どうしてる？うん…順調？どうやら「凡人」の生活にも慣れ始めたみたいだね。はぁ…いろいろあったけど、鍾離先生とも一回戦って見たいものだな。\\n何…俺は勝てない？ハハッ…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "「女皇」について…",
      "text": "女皇様は実に優しい人だよ。優しすぎるからこそ、冷酷にならなければならない。平和を夢見ているからこそ、世界に宣戦布告した。それに、彼女が世界の敵になったからこそ、俺たちは出会えたのさ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "ファルカについて…",
      "text": "ファルカかい？いつか西風騎士団の頂点、伝説の「北風騎士」と戦えると思うと、興奮して震えてしまうよ。生きるって素晴らしいね。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "「道化」について…",
      "text": "彼はファデュイ最初の執行官で、今の執行官たちのリーダーでもある。ただ、重要な場面でしか姿を見せないんだ。彼の功績については…正直、興味がない。俺が忠誠を誓うのは女皇様だからね。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "「隊長」について…",
      "text": "昔、戦場で彼の戦いを見たことがある。その姿はあまりに勇猛なものだったよ。ただ俺の席は後ろすぎる、たぶん彼は俺のことに気付いていなかっただろう。けど、たとえ今日見向きされなくても、明日こそは、俺の実力を彼に見せてやりたい。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "「博士」について…",
      "text": "彼は年齢別に自分の義体を作って、様々な任務を担当させているらしい。しょうがないさ、俺の同僚はみんな変わり者ばかりだからね。でも、逆に考えよう、仮に俺が自分の義体と出会ったら…ハハッ、きっと生き残るほうを決めるために、そいつと戦うことになるよね。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "「少女」について…",
      "text": "ファトゥスの席は実力によって決まる。けど、なんであの子が「第三位」にいるのかはよく分からないんだ。もし機会があったら、俺より前にいる執行官たちと一度戦ってみたいね。ただ、どうしてか彼女とはあまり戦う気が起きないんだ…とにかく、君も気を付けたほうがいい。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "「召使」について…",
      "text": "打算的な人は別に嫌いじゃない。何しろ、俺がファデュイに入ったのだって、戦う機会がもっと欲しいからだ。けど、俺はどうしてもこいつのことが気に入らない。裏切ることで利益を手にできるのなら、彼女は躊躇なく女皇様に刃を向けるだろう。彼女の目には、狂気しかないからね。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "「雄鶏」について…",
      "text": "俺は義理や人情といったものがよく分からない。けど、彼が本当に俺のことを助けたいと思っているのは知っている。俺を見る時の彼の眼差しは、まるで家族を見るもののようだよ。ああ、そういえば、トーニャとテウセルからの手紙には、彼がうちに送ってくれたパイやプレゼントのことがよく書いてある。どうやら、俺が冬国を離れている間、彼は約束通り、俺の家族の面倒をよく見てくれているみたいだ。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "「傀儡」について…",
      "text": "研究に没頭している人らしい。ということは、あれらの機械も彼女と何か関係があるんだろうか。とにかく、彼女と会ったのはたった数回だけだというのに、いつも俺を殺したそうな目で見てくる。彼女を怒らせるようなことをした覚えは、まったくないんだけどね。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "「富者」について…",
      "text": "ああ、「壮大な計画」ばかり考えているあの野心家のことか。彼の理論はまったくもって頭に入ってこないよ。とにかく、不測の事態に備えた資本が十分にあるならそれでいい。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "「淑女」について…",
      "text": "君も知っていると思うけど、俺は彼女と馬が合わないんだ。それに、今となっては、彼女のことを語る必要もないだろう。ファトゥスにとって、死期は自分で決められるようなものじゃない…でも安心してくれ、何があろうとも、俺は全力で生きていくから。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "「散兵」について…",
      "text": "彼は「神の心」を手に入れた後、俺たちとの連絡を断ってしまってね。だから、その心を取り戻すために行動を開始した。俺は色んな場所を回るのは別に構わない。もしかすると、偶然どこかで君に会うかもしれないね。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "タルタリヤを知る·1",
      "text": "覚えておいてくれ、相棒、俺こそがいつか世界を征服する者だ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "タルタリヤを知る·2",
      "text": "戦う相手が神でもアビスの魔獣でも、形さえあれば勝てる可能性がある。けど執行官の中には、権謀術数や陰謀とか…「見えない手段」に熱心な輩がいる。俺はそういったつまらないヤツらは性に合わないんだよ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "タルタリヤを知る·3",
      "text": "ここの空と故郷の空は繋がっている。顔を上げて雪のような月光を見ると、故郷の人々も同じ月を見ているのかと思いを馳せてしまう。弟や妹は…優れた戦士になれているだろうか？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "タルタリヤを知る·4",
      "text": "相棒、これだけは忘れるなよ。殺し合う時、「燃えてきた」なんて馬鹿な言葉で自分を奮い立たせるな。燃え尽きれば、灰以外何も残らない。何があっても、生き抜くんだ。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "タルタリヤを知る·5",
      "text": "時間が経つのは早いものだ。いつか君に、俺が世界を征服して、神の王座を踏みつける姿を見せてあげるよ。それまで、絶対に倒れるなよ、相棒！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "タルタリヤの趣味…",
      "text": "氷上の穴釣りと決闘には通ずるものがある、その心は我慢強さと決断だよ。そういえば、これは人生においてあらゆる局面で使えると思わないかい？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "タルタリヤの悩み…",
      "text": "ん？悩み…君と一緒にいると、いつも挑戦し甲斐のある強敵に出会えるから、悩みなんてつまらないことを考える暇もないよ。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "この世界は美味しい料理と心躍る戦闘に満ち溢れている。生きるって素晴らしい！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "食べ物と武器は同じだ。真の戦士は武器の好き嫌いがないし、食べ物の好き嫌いもない。君も好き嫌いするなよ。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "美味しいものを食べると、気分まで晴れやかになるね。…さて、君にどうお返ししたらいいかな？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "料理の腕がだいぶ上がったようだね。腕っぷしも強くなってるのかな？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "想像をしてなかった口当たりだけど。うん…もう少し食べてみよう。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "やあ、相棒、誕生日おめでとう！むちゃくちゃ殴りたい相手とかいる？いたら遠慮なく俺に言ってくれ！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "おっ！少し強くなったみたいだ。誰で試してみようかな…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "「戦士の力は円のようだ。その円が大きいほど、戦える相手が多い。」これって誰の言葉だったっけ…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "悪くない！相棒、君のおかげでまた「世界征服」という目標に一歩近づいた。きっと女皇様も、俺がここまで成長することを予想してなかっただろうね。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "相棒、君もちゃんと腕を磨いておいてくれよ！でないと、俺が世界の頂点に立った時、命を賭けて殺し合える相手がいなくなっちゃうだろ？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "行くぞ！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "ハーッ！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "狂瀾怒濤！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "来い！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル·5",
      "text": "さーて。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル·6",
      "text": "ふう——"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "止水の矢！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "逃げられるかな！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "隙を見せるのは、ほんの一瞬だ！"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆発·4",
      "text": "痛いから我慢しろよ。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "ダッシュ開始·1",
      "text": "兵貴神速。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "風の翼を広げる·1",
      "text": "ハッ、悪くないね。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "よし！もっとお宝を見つけに行こう！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "ああ、最高だ！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "あはは、ワクワクするね！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "ハッ、面白い。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "やるじゃないか！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "瀬戸際だろ、俺の得意分野さ。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "君たち、最近運動不足なんじゃないか？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "退け！ここは俺がやる！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "そんな馬鹿な…せっかく手に入れたのに…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "やっちまった…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "なかなか…やるな…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "チッ、油断した。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "あはっ、強いやつはどこかな？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "しっかり見ててくれよな！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "待ちくたびれてたところだ！"
    }
  ]
}