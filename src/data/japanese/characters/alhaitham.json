  "outfits": [
    {
      "id": 207800,
      "name": "理を崇める者",
      "description": "アルハイゼンの衣装。「つまらない雑用で書記官様の手を煩わせないでくれ。ヘッドホンを付けているのは、そのような状況を避けるためだ。」\n——沈黙の殿にいる従業員の経験談。",
      "isDefault": true,
      "characterName": "アルハイゼン",
      "characterId": 10000078,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Alhatham_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初めまして…",
      "text": "俺は教令院の書記官、アルハイゼンだ。資料を閲覧したいのなら、規定の書式に則って申請書を記入してくれ。\\nなに、まだ整理し終わっていない？ならいい。俺の勤務時間は執務室の外に貼り出してある、次に出勤している日にまた来るといい。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·仕事",
      "text": "書記官の仕事はとても簡単だ。だからこそ、この職位にいる。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·勉学",
      "text": "勉学に励んでも、頭が良くなるとは限らない。教令院にいる者たちを見れば分かることだが。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·思考",
      "text": "ふむ…近頃はごちゃごちゃした申請が多いな。すべて却下しておくとしよう。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "雨の日の外出ほど面倒なものはない。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "恐れずとも、ただの自然現象に過ぎない。大きな木の下に隠れなければ問題ない。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "寒いのか？俺は大丈夫だが。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "晴れの日…",
      "text": "これほど天気のいい日には、何もしないに限る。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "砂漠にいる時…",
      "text": "はぁ、靴の中に砂が入った…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "まだ早いな、コーヒーを飲んでこよう。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "何も用がないのなら、俺は遮音ヘッドホンをつけて仮眠をとる。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "ここからはプライベートの時間だ。それでは。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "ルームメイトが夜な夜な模型を叩き回さないことを願おう…いや、違うな。そもそもあいつが家にいないことがベストなんだ。自分の家で眠る時まで、ヘッドホンをつけていたくはない。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "アルハイゼン自身について·事実",
      "text": "飾り立てた言葉で取り繕うより、俺は包み隠さず事実を言うほうが好きだ。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "アルハイゼン自身について·噂",
      "text": "ほう、俺の品性について様々な噂を聞いたことがある？そんなに気になるか？\\nふむ、気にする必要はない。なぜなら、余計な問題を起こさない限り、君がそれらを信じようが信じまいが、どうでもいいからだ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "声掛けについて…",
      "text": "街中で俺に声を掛けても反応がない時があると思うが、気にすることはない。ヘッドホンの遮音機能をオンにしているだけだからな。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "助け合いについて…",
      "text": "君は極めて自立した人間だ、身の回りにいる仲間の面倒も見られる程にな。故に、特に君へアドバイスすることはない。君も俺からの助けなどいらないはずだ。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "正直、草元素の「神の目」は俺の研究にあまり役に立たない。だが元素力を手に入れたことで、より相手を叩きのめしやすくなったのは確かだ。まあまあ使えると言ったところだな。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "真理は誰かに仕えるために生まれたわけじゃない。人間は知識の担い手ではないし、知識も人間の目的ではないんだ。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "この世には人の目を引くものが数多くある。だが自分の目を過度に信じるべきじゃない。見えるものが真実だと言うのなら、人は考える必要すらなくなるはずだからな。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "クラクサナリデビについて…",
      "text": "過度なまでに神を見下したり、崇めたりすることは得策じゃない。神には信徒が必要だが、神もまた生態系の一環だ。だから俺は、神を救ったことを誇りになど思っていないし、クラクサナリデビ様がそのことを気にする必要もない。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "カーヴェについて·思いやり",
      "text": "あいつはすべての人や物事に対して、行き過ぎた思いやりの心を持っているんだ。彼自身があまりにひ弱なせいか、朝から晩まで、何でもないことで大騒ぎする日々を送っている。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "カーヴェについて·詐欺",
      "text": "道端の出店で、主人が言った。手作りのキーホルダーが一つ売れるたびに、貧しい子供が一人、満足のゆくまで食事ができると。…カーヴェはそれを十個以上買ってきた。\\nスメールでは、医療や福祉ですら無償で提供されるんだが…はぁ、これ以上は言わなくても分かるな。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "ティナリについて…",
      "text": "彼のことを気性が荒いと思う者も多くいるようだが、それは偏見だ。昔、カーヴェが死域に建物を造り、収拾のつけられない面倒を引き起こしたことがある。レンジャー隊は多大な迷惑を被ったにも関わらず、あのレンジャー長はカーヴェを恨むどころか、家まで食事に招待したそうだ…彼のような善人が世にいるからこそ、カーヴェは生存していられるのかもしれない。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "ドリーについて…",
      "text": "彼女は聡明で抜け目なく、どうすれば自分の夢を実現できるかを知っている。実に強かだ。彼女のやり方を肯定するつもりはないし、俺たちの立場は明確に違う、それでも彼女のたくましさは認めざるを得ない。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "セノについて…",
      "text": "「ハイブマインド」の一件以来、マハマトラたちの仕事は増えた。だが、俺はそのことに負い目は感じていない。結局のところ、あの事件の根本的な原因は俺ではなかったんだからな。セノは物分かりのいいやつだから、あれからあの一件のために俺を訪ねてくることもなかった。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "ニィロウについて…",
      "text": "芸術家の長所と短所は目に見えるほど明白なものだ。ニィロウは長所を伸ばすことで、短所をカバーできている。だからこそ、素朴で幸福な暮らしが送れるのだろう。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "ディシアについて…",
      "text": "極めて有能で、エルマイト旅団に置いておくには惜しい人物だ。彼女が俺の申し出を受け入れてくれたらよかったんだが。教令院に彼女のような助っ人がいれば、俺たちの仕事はもっと楽になる。だが、彼女は安穏とした生活には興味がないらしい。それは俺も理解できる、とはいえ残念だ。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "アルハイゼンを知る·1",
      "text": "ほとんどの者は、自ら進んで俺と接点を持とうとはしない。おおかた畏縮しているか、性格が合わないんだろう。俺もそんな現状に満足している。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "アルハイゼンを知る·2",
      "text": "俺は人付き合いに興味がない。見ての通り、俺は大半の者より楽しく暮らしている。これは、人付き合いが生活の必需品でないことの何よりの証左だ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "アルハイゼンを知る·3",
      "text": "誰しも常に自分の主張を持ち、はっきりとした信念に基づいて行動するべきだ。さもなければ、突発的なトラブルに見舞われたり、容易に道を踏み外したりしてしまいかねない。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "アルハイゼンを知る·4",
      "text": "ひとたび秩序が破られれば、その影響は瞬く間に広がる。そうなるのは好ましいことじゃない。今の暮らしの妨げになるからな。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "アルハイゼンを知る·5",
      "text": "仕事終わりに、酒場に一杯飲みに行くことがある。\\nうん？それを知りたいわけじゃなかった？ふむ、余暇の使い方を共有するのは、個人的な意見を共有するより、遙かにプライベートなことだと思っていたんだが。何せ、ただの意見交換など、皆掲示板でもやっていることだからな。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "アルハイゼンの趣味…",
      "text": "奥深く難解な本を読むことと、同じ本を他人が読んで、頭を抱えている姿を見ることくらいだ。\\n…冗談だ。他人の苦しみから愉悦を得ることはないし、理解できない本に出会うこともめったにない。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "アルハイゼンの悩み…",
      "text": "俺の観察によると、悩める者のほとんどは自らそれを生み出してしまっているケースが多い。ただでさえ生きていくのは大変なんだ、これ以上悩みを増やしてどうする。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "見た目の美しさより、味だ。簡単だろう？でないと、本末転倒だからな。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "スープや汁気のある料理だ。本を読みながら食べるのに適していないからな。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "ふむ、調味料の配合を正確に把握しているようだな。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "流行りの味だ、嫌いじゃない。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "今ここでは食べないでおく。持ち帰っていいか？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "誕生日おめでとう。俺は常々、人々は生まれた日を祝うことに不必要な情熱を注ぎすぎだと考えている。それに費やすエネルギーを、日々の生活をよりよくするために使う方が現実的だと思うんだ。君はその点、まあまあよくやっている。\\nどんなプレゼントが適切か分からなかったから、特別ルートで申請書を通すチャンスを一回あげるよ。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "感謝する。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "こんなことは、一度限りだと思っていた。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "精進することにおいて、君は俺よりも熱心らしい。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "俺がこうして日々進歩していることを、怠惰な教令院の連中に知られるわけにはいかない。もし彼らの耳に入れば、何としても俺に面倒を押しつけようとしてくるだろう。もちろん引き受けはしないが、話し合いというのは往々にして時間がかかる。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "もらった。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "鏡閃。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "ふんっ。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "散乱。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "分光。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "理論の演繹。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "君が受け取れ。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "早く拾うといい。遠くに転がったら面倒だ。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "ほう。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "面倒だ。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "計画が変わった。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "手間がかかる。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "俺がやろう。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "想定内だ。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "想定外だ…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "失策だ。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "誤算だったか。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "チッ、誰だ。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける·2",
      "text": "ぐっ…いいだろう。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "何か用か？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "公務に私情は挟まない。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "時間のかかることじゃないだろうな？"
    }
  ]
}