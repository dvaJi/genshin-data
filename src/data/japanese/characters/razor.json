  "outfits": [
    {
      "id": 202000,
      "name": "荒野に駆ける",
      "description": "レザーの衣装。野外で走るのに便利な服装。",
      "isDefault": true,
      "characterName": "レザー",
      "characterId": 10000020,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "お前の匂い…いい匂い。一緒に狩りをしよう！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·匂い",
      "text": "う、ウサギの匂い…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·空腹",
      "text": "行くか、腹減った。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·見張り",
      "text": "オレは見張りをする。行くならオレを呼べ。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雷の日·注意",
      "text": "怖いなら早く隠れろ。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "雷の日·道案内",
      "text": "木から離れろ、ついて来い！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "風の日…",
      "text": "風…うん、気持ちいい。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "暴風の日…",
      "text": "風…うぅ…チクチクして、ちょっと痛い。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "太陽が出た。一緒に狩りに行くか？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "肉の塊食える、嬉しい！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "お前は寝ろ。オレは月を見る。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "お前寝る。オレ見張る。明日、一緒に狩りする。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "レザー自身について…",
      "text": "オレは狼。人間のパパ、ママ、いない。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "友達について…",
      "text": "お前、友達。オレとお前、一緒に狩りする。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "武器について…",
      "text": "オレ、鉄の爪と雷の牙ある。お前を守る。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「神の目」、師匠のおかげ。雷の牙で戦う、「ルピカ」守る。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "夜、星きれい。空、湖、どこも星いっぱい。\\n夜、街の中も、星いっぱい。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "オレの「ルピカ」は狼。彼らは家族。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "リサについて…",
      "text": "師匠の雷、空黒くなる。怖い、強い。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "バーバラについて…",
      "text": "バーバラ、キラキラの女の子。優しい。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "ディルックについて…",
      "text": "ディルック、赤い、黒い。冷たくて、熱い。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "ウェンティについて…",
      "text": "詩…うっ、よく分からない。よく分からないけど、「ルピカ」は気に入ってる。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "ベネットについて…",
      "text": "ベネット、口数が多い、一緒にいると、腹いっぱいにならない。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "クレーについて…",
      "text": "クレー、友達！友達だけど、困る。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "ファルカについて·知らない",
      "text": "ファルカ？知らない…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "ファルカについて·思い出",
      "text": "うん…ファルカは、名前だ。あの男、高く大きい。レザーの名前、鉄の爪、彼にもらった。ううっ…会いたい。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "レザーを知る·1",
      "text": "お前の匂い、優しい匂い。肉好きか？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "レザーを知る·2",
      "text": "お前強い。狼と同じくらい強い。お前と狩りするの好き。収穫多い。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "レザーを知る·3",
      "text": "「ルピカ」は「狼の家」。違う、「狼の家族」。オレのルピカは森の中。彼ら、オレを守る。オレをルピカだと言った。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "レザーを知る·4",
      "text": "オレにはルピカしかない。\\nでもルピカ、オレには4本の足がない。本物の狼じゃない。時々、悲しい。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "レザーを知る·5",
      "text": "お前と一緒に走るの楽しい、お前と一緒に狩りするの楽しい。お前と一緒にいる。オレは狼、オレは人間、関係ない。\\nお前は友達、お前はオレの「ルピカ」。オレ、お前も嬉しくあってほしい。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "レザーの趣味…",
      "text": "ルピカ好き。森好き。友達好き。走るの好き。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "レザーの悩み…",
      "text": "話すの疲れる。難しい。でも、話さないはダメ。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "肉好き。イモ好き。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "野菜だめ。オレが食ってる肉たちは野菜を食う。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "匂いがいい、味もいい。好き。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "食うと、力が出る、嬉しい。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "食う、よくない。食わない、よくない。少し悲しい。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "今日はお前の……ずっとずっと前の今日に、お前生まれた。お前と一緒に楽しみたい。今日一緒に肉食う。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "腕、太くなった…？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "ガルルル…爪研ぎ、牙を研ぐ、もっと強く！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "走る、狩る。足りない、だめ！もっと…強くなる！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "牙、爪、足。もっと強く、もっと力を…お前を守る！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "どけ！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "ア——！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "ガオー！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "来るなッ！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "ガルルルー！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "貫け…！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "んあ！"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆発·4",
      "text": "グルルルー！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
