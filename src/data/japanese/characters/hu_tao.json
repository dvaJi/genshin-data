  "outfits": [
    {
      "id": 204601,
      "name": "残雪に咲く紅",
      "description": "胡桃の衣装。暗い色を基調とした往生堂の服とは異なり、明るい色のワンピース。服は友人の香菱が胡桃のために用意してくれたプレゼントで、サングラスは胡桃の自前である。",
      "isDefault": false,
      "characterName": "胡桃",
      "characterId": 10000046,
      "source": [],
      "filename_card": "UI_AvatarIcon_HutaoCostumeWinter_Card",
      "filename_icon": "UI_AvatarIcon_HutaoCostumeWinter",
      "filename_iconCircle": "UI_AvatarIcon_HutaoCostumeWinter_Circle",
      "filename_splash": "UI_Costume_HutaoCostumeWinter",
      "filename_sideIcon": "UI_AvatarIcon_Side_HutaoCostumeWinter"
    },
    {
      "id": 204600,
      "name": "梅の残り香",
      "description": "胡桃の衣装。「往生堂」堂主が仕事する時に身に着ける日常的な服装。",
      "isDefault": true,
      "characterName": "胡桃",
      "characterId": 10000046,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Hutao_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "堂主の私に何か用かな？あれ、知らなかった？私が往生堂七十七代目堂主、胡桃だよ！でもあなた、ツヤのある髪に健康そうな体してる…そっか！仕事以外で私に用があるってことだね？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·往生堂",
      "text": "私とお茶しない？えへへ～"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·お客さん",
      "text": "お客さんが一人、二人、三人…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·怠ける",
      "text": "お日様が出たら日光浴、お月様が出たら月光浴～"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "うう…めんどくさいな～"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "雷だよ！気をつけて！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "わぁ！雪だ！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "風の日…",
      "text": "ふぅ～気持ちいい～"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "暴風の日…",
      "text": "帽子が飛んじゃうよ！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "早寝早起きは体に良いね～"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "よっ！お昼だね、ご飯食べた？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "へへへ、お月様が出てきたよ～外で見よう！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "眠いの？じゃあ先に休んで、私はもう少し起きてるから。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "胡桃について·名前",
      "text": "胡桃の「ふ」はおふざけの「ふ」、胡桃の「た」はぐーたらの「た」！\\n…え、面白くない？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "胡桃について·特技",
      "text": "ほら見てて…火の玉！そして～ほい！火の蝶々！やった！飛んでる～"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "好奇心について…",
      "text": "色んな所を旅してきたんでしょ。時間があったら私に色々聞かせて。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "夜について…",
      "text": "昼間はどこに行っても大丈夫だけど、夜になったら気を付けて。と·く·に、私がいない時。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "手伝うことについて…",
      "text": "手伝ってほしい？私が必要？了解！あなたが困ってるなら、どこにいても全力で駆け付けるよ！"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "戦いについて…",
      "text": "私にとって、戦いは目的じゃなくて手段。戦いという手段で大切なものを守るのが目的なの。この点に関しては、あなたと一緒だね。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「神の目」？「神の目」…うーん、その辺は縁次第ってところかな。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "私たち往生堂には、二つの世界の人を満足させる責任がある。だから、依頼を受けたら必ず最後までやり遂げるの。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "陰気な場所に月光が差し込むことで生える花があるの。見たことない？じゃあ、今度見せてあげるね。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "鍾離について…",
      "text": "鍾離さんはあんなに若いのに、性格は老人だね。何でも知ってるけど何に対しても興味がない…\\nもしかして彼…ふふ、何でもない！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "七七について…",
      "text": "七七ちゃんを見かけた？どこにいるか教えて！あの子をどこかに隠してそれから……えへへへへ！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "白朮について…",
      "text": "白朮？…ふん、やっかいな奴。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "凝光について…",
      "text": "「天権」凝光、地位と富の頂点にいながら、美しく賢く、万物を見据えている。すっっっごくかっこいいよ！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "北斗について…",
      "text": "北斗姉は璃月の有名人よ。彼女は私を知らないけど、私は彼女を知ってる。あ～友達になりたいな。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "行秋について…",
      "text": "行秋坊ちゃまは本を書いてるらしいよ。どんな内容なんだろう？周りであった事を教えたら、面白い物語を書いてくれるかな。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "重雲について…",
      "text": "純陽の体…まさかこんな体質の人がこの世にいるなんてね。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "魈について…",
      "text": "仙人のこと？し、知らないよ？あわわ、お願いだから何も聞かないで！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "刻晴について…",
      "text": "「玉衡」刻晴…だいぶ話しづらい人ね。ほら、あの生真面目な感じ、からかったらどうなるのかな…まさか剣で叩かれないよね…ね！？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "香菱について…",
      "text": "香菱ったら面白いんだよ！ちょっと触っただけでビックリして飛び跳ねるの！ああいう子大好きよ！でもやりすぎに注意しなきゃね、グゥオパァーに怒られちゃう…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "雲菫について…",
      "text": "雲菫は正式な場ではとても優雅だけど、私生活ではすごく親しみやすいよ！この前彼女と賭けをしたの。負けた人が自分の得意とする歌い方で相手の書いた歌詞を歌うんだ。璃月劇版のヒルチャー夢、んもぉ～あなたも絶対聞いた方がいいって！"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "申鶴について…",
      "text": "彼女は本当に面白い人だよ。他の誰とも違うの。ねぇ、私もこれから毎日、仙草を食べて山露を飲めば、彼女のように浮世離れした人になれるかな？えへへ…"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "藍硯について…",
      "text": "藍硯ちゃんね…あの子は只者じゃないよ。「触り程度」なんて言ってるけど、そんなもんじゃない。奇門秘術って本当にすごいんだよ、病や死気も全部祓っちゃうんだから。まったく、世の中はますます良くなって、みんな強くなっていくよね～。うちの商売がやりづらくなっちゃうよ。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "胡桃を知る·1",
      "text": "ヒルチャールのお兄さんが病気になった♪…ヒルチャールのお姉さんが看病して♪…ヒルチャールのお兄さんが薬を飲んでも治らない♪…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "胡桃を知る·2",
      "text": "路地裏に潜む漆黒の詩人とは、私のことよ！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "胡桃を知る·3",
      "text": "「往生堂」の仕事は別に難しくも怖くもない、少し面倒なだけ。私たちを見かけたら怖がる人がいるから、何だか悲しいな。もう～そんなんじゃないのに！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "胡桃を知る·4",
      "text": "私は「往生堂」七十七代目堂主、おじいちゃんが七十五代目よ。私が初めて引き受けた仕事は、おじいちゃんの葬儀だったの。うん？意外だった？知らないうちに何年もやってきた…時間が経つのって早いね。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "胡桃を知る·5",
      "text": "陰陽は整然、運命は無常。死は予測できないけど、規則はある。覚えておいて、いつどんな時も、死を軽く扱っちゃだめ。死を理解し尊重してこそ、生きる価値を理解できるのよ。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "胡桃の趣味…",
      "text": "雲一つない空と、月光に満ちた夜空！こんな絶景、詩を作るにはぴったりね！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "胡桃の悩み…",
      "text": "はぁ、何か面白いことないかな…何もすることがないのって、死より恐ろしいことだよ。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "ららら～♪水煮魚にエビ蒸し餃子～♪"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "清心とスライムの液体炒め…おぇ…香菱…私に対する復讐…？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "よしよし。堂主である私が、この料理に詩を一編書いてあげる——"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "手伝わなくていいの？一皿作ったら、私がもう一皿おまけで作ってあげるよ！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "うぇ…これ何？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "今宵は満天の星に華麗な月、さーぞかしいい日だろうね。うーん？うふふ…うん！知ってるよ、誕生日でしょ！もう、本当にいい日だね。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "おや？おやおや？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "うんうん、良い気持ち、ありがと！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "力に満ち溢れてる、こんなの初めて！何でもできる自信があるよ！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "力が限界に達した後に試されるのは心。あなたのおかげで、こんなにも素晴らしい境地にまでこれた。ここは心と魂が交じり合い…生から死、天地から万物、全ての理が集う場所だね。"
    },
