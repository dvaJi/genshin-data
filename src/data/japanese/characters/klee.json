  "outfits": [
    {
      "id": 202901,
      "name": "星燭に揺れる爛花",
      "description": "クレーが特定の演劇に出演する際に着る丁寧な作りの衣装。鮮やかな色をしており、まるでクリームの花と真紅のロウソクで飾られたケーキのように、「ハッピー」と「スマイル」を冒険の至るところに振りまいてくれる。",
      "isDefault": false,
      "characterName": "クレー",
      "characterId": 10000029,
