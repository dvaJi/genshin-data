    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "西風騎士団、「火花騎士」クレー、参上！…えっと、この後は何だっけ？クレー覚えられないよ…"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·収穫",
      "text": "今日ね、クレー変わった模様のトカゲを捕まえたんだ！見たことない模様だから、見てみる？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·冒険",
      "text": "クレーと一緒にお魚をドカーンしにいく？バレたら1日反省室に閉じ込められるけど、お魚は美味しいからやりがいあるよ！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·心得",
      "text": "「城内爆破は反省室」、「怪我人いるところにジン団長あり」、「山火事は一巻の終わり」——これはクレーの騎士団で生きるための心得だよ。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "ふふん、今回の爆弾は防水だからへっちゃら。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "何かが爆発した…！？…あっ、雷か。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "暴風の日…",
      "text": "風神様、クレーの爆弾を必要な場所につれてってー！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "おはよー！クレーをあそびに連れてって！冒険しようよ！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "お昼ごはんの時間だ！なに食べようかな？『テイワット観光ガイド』でも見てみよう…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "こんばんは！クレーはもう子供じゃないってホフマンさんに言ってよ、クレーは夜も遊びに出かけたいの！遊びにつれてってー！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "うう…出かける時帰りたくないって言ったけど、暗くなると道が分からないよ…ね、ねえ、帰るとき、クレーを送ってくれないかな…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "クレー自身について·トラブル",
      "text": "あうっ…爆弾で風車の羽をぐにゃぐにゃしちゃった…ごめんなさい！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "クレー自身について·賠償",
      "text": "ク、クレーは手作業が得意なの。だから新しいのを作るから…え？児童の労働禁止？ううう…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "騎士について…",
      "text": "ふふん…栄誉騎士、クレーは「火花騎士」として西風騎士団の先輩なんだよ？だからね！だから…クレーが起こしたトラブル、内緒にしてくれないかな…"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "遊び仲間について…",
      "text": "だめ、まだ9時だよ！今日は絶対サーカス団のミッドナイト公演が終わるまで帰らないもん！クレーの仲間なんでしょ、帰らせようだなんて考えないでよ…ペペぺ。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "この小さなガラス玉は、バルバトス様がクレーを認めてくれたってこと…？うーん…クレーのどこを認めてくれたんだろ？自由なとこ？じゃあ、バルバトス様の期待に応えられるように、クレーはもっと自由にお魚をドカーンしたほうがいいかな…？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "騎士団の壁を壊しちゃだめだってクレーは知ってるの。壊せばすぐ反省室から出られるけど、もう明日の太陽は拝めないかもってガイアお兄ちゃんが言ってた…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "トカゲはどれも模様が違うよ。一部のトカゲのしっぽは乾燥させて粉にすると、爆薬の材料に使えるの。これはアルベドお兄ちゃんが教えてくれたんだ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "レザーについて…",
      "text": "友達だよ！レザーが頑張って危険からクレーを守ってくれる姿は安心できるんだ！…うーん…危険は大体クレーが持ってくるんだけどね…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "両親について…",
      "text": "パパもママも大陸全土で有名な旅人だよ！ママの書いた『テイワット観光ガイド』のレビュー欄は、たくさんのレストランと宿屋が気にしているらしいの。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "ガイアについて…",
      "text": "ガイアお兄ちゃんはいい人だよ！『騎士団で生きるための心得』はガイアお兄ちゃんが作ってくれたの。クレーがトラブルを起こした時も、よく内緒にしてくれるんだ。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "アンバーについて…",
      "text": "アンバーお姉ちゃんはいい人だよ！ウサギ伯爵はモフモフしてて、ドカーンするから最高なんだ！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "ジンについて…",
      "text": "ジン団長はいい人だよ！少し…怖いけどね…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "ディルックについて…",
      "text": "変わった大人、いつも怒ってる感じ。うーん…なんで笑わないんだろう？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "リサについて…",
      "text": "リサおば…リサお姉ちゃんはいい人だよ！クレーが工房に行くといつも美味しいお菓子をくれるの…ん？そういえば、工房に行ったのは新しい爆弾を作るためだったんだけど…？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "ベネットについて…",
      "text": "ベネットお兄ちゃんはいい人だよ！一緒に冒険に行くと、いつもお宝が手に入るんだ！…ベネットお兄ちゃんは何も手に入らないみたいだけどね、なんでだろう？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "ディオナについて…",
      "text": "ディオナお姉ちゃんはいい人だよ！「自分の力でモンドの酒造業をつぶす」って考え方は面白いよね、クレーも爆弾で手伝う！——んー、「モンドの酒造業」はよく分からないけどね、魔物かな？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "アルベドについて…",
      "text": "アルベドお兄ちゃんとクレーには秘密の約束があるの！工房の扉に「実験中」の札があるときは、またあとで来てって約束なの。アルベドお兄ちゃんが仕事じゃない時はいつも長いことクレーの相手をしてくれるから、クレーも我慢して待つんだ！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "モナについて…",
      "text": "モナお姉ちゃんはいい人だよ！アルベドお兄ちゃんとクレーのところに遊びに来ると、いつもよく分からないけど面白い話を聞かせてくれるの！もっと遊びに来てほしいな！"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "スクロースについて…",
      "text": "スクロースお姉ちゃんはいい人だよ！跳べて走れるボンボンほしい？って聞いてくれたの。えへへっ、もちろんほしいよ！何百個もほしい！モンドの街道、階段、広場がボンボンだらけになったらいいな！"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "ドゥリンについて…",
      "text": "やったー！ドゥリンお兄ちゃんは今モンドに住んでるから、クレー、毎日遊びに行くんだ！ドカーンするときは、ドゥリンお兄ちゃんにたかーいところまで飛ばしてもらって、空からボンボン爆弾を投げたいな！"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "ローエンについて…",
      "text": "ローエンお兄ちゃんはいい人だよ！この前、おいしいものをたーっくさんくれたのに、お返しはクレーのクレヨン一箱だけでいいって！もしローエンお兄ちゃんに時間があったら、ファルカおじさんも呼んで、クレーがお絵描きを教えてあげたいな！"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "プルーネについて…",
      "text": "プルーネお姉ちゃんはいい人だよ！ママからのお手紙に書いてあったんだ。本当は誰かと遊びたいけど恥ずかしくて言い出せない子なの、って！だから、クレー決めたの！これからはお魚をドカーンする時だけじゃなくて、雪山とか、金リンゴ群島とか、シムランカとか…いろんなところにプルーネお姉ちゃんと一緒に行くんだ！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "クレーを知る·1",
      "text": "こんにちは！クレーのとこに遊びに来たの？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "クレーを知る·2",
      "text": "うん、この爆弾はクレーの最新作だよ！うまくできてるでしょ？…えっ——火災現場で見つけたの？クレーじゃない、絶対違うよ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "クレーを知る·3",
      "text": "爆弾の配合の多くは反省室に閉じ込められている時に思いついたんだけど…閉じ込められることがなくなったらもっといいのに…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "クレーを知る·4",
      "text": "これはドドコだよ、クレーの昔からの友達なの。名前をちゃんと覚えてね、もう「バッグについてるぬいぐるみ」なんて呼ばないこと。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "クレーを知る·5",
      "text": "いつもクレーのためにトラブルを解決してくれてありがとう！お礼にこの「クレーの焼き魚」をあげるよ！——実はこのお魚、まだ湖の中にいた時に爆弾で焼かれたものなんだけど、でもそんなのいつものことだから、気にしない気にしない。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "クレーの趣味…",
      "text": "クレーはモフモフしたものが好き。ドドコとか、蒲公英とか、あとレザーの髪の毛とか。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "クレーの悩み…",
      "text": "はあ、いい人だね、悪い子のクレーとは真逆…今回の反省が終わったら、また遊びにつれてってね…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "モンドのスズキは美味しいよ、特にシードル湖のスズキはね！でたらめじゃないよ、これはママも認めてるからね。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "モンドガニが嫌い——カニはみんな嫌い——クレーはお外で遊びたいの——テーブルの前でゆっくり殻を剥くのはクレーには向いてないよ——"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "わぁ、いい匂い！でもクレー、お腹いっぱいでもう食べられない…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "今日のごはんも美味しかった。クレー、とっても幸せだよ！ありがとう！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "お、美味しそうだけど、食べるのがちょっと大変かも…えへへ、クレーを助けてくれる？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "お誕生日おめでとう！誕生日は楽しいね。クレーより年上だから、誕生日を過ごした回数はクレーより多いよね？羨ましいなぁ！"
    },
    {
