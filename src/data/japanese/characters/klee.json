      "id": 202900,
      "name": "すばしっこい火花",
      "description": "クレーの衣装。革製のカバンとセットになった生き生きとした子供服。",
      "isDefault": true,
      "characterName": "クレー",
      "characterId": 10000029,
      "filename_card": "UI_AvatarIcon_Costume_Card",
