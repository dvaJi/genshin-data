  "outfits": [
    {
      "id": 207500,
      "name": "寂忿空相",
      "description": "{REALNAME[ID(1)]}の衣装。修験者の常服。その笠は雨をしのぐ場所を放浪者に与えるが、心の中で轟く風と雷には意味をなさない。",
      "isDefault": true,
      "characterName": "放浪者",
      "characterId": 10000075,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Wanderer_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初めまして…",
      "text": "名を名乗れって？僕はこの世において、様々な名で呼ばれているんだ。まあ、いずれも凡人が呼ぶにはおこがましいものだけど、今やすべて過去のものさ。\\n好きに呼んでくれて構わないよ。ちょうど、君のセンスも確かめられるしね。僕を…がっかりさせないでくれよ。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·風",
      "text": "この世に純粋な自由なんてないのさ。風さえ、いつか止む時が来る。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·話し方",
      "text": "言い方がきついかい？ただ本当のことを言っているだけさ。それを受け入れられない者こそ、もっと自分の問題を反省したほうがいい。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·挨拶",
      "text": "世間話はよそう。話すこともないのに必死に話題を探すなんて、滑稽だからね。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "僕の笠で雨宿りがしたい？よくもそんな要求ができるね。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨上がり…",
      "text": "少し日差しが見えただけで、そんなにはしゃいじゃってさ…まったく幼稚極まりないね。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雷の日…",
      "text": "チッ…煩わしい。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "雪の日…",
      "text": "雨と大差ないはずなのに、人に好かれるのはこっちのほうなんだ…まったく、運命ってのは気まぐれだね。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "暴風の日…",
      "text": "この程度なら、君にだってできるよね？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "「起きて——もう朝だよ——」…なんて、まさか僕がこんな感じに起こしてあげると思ってないよね？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "僕に食事は必要ない。君は自分と隣のちっこいのについてだけ考えていれば十分だ。そうしてくれれば、僕も手間が省ける。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "やっと、退屈な一日が終わる。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "僕がそばにいると眠れないかい？ふふっ。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}自身について·人形",
      "text": "人形を燃やせば灰が残る。その灰から何が生まれるかについては…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}自身について·心",
      "text": "あんなのは適当でいいのさ。自分のものでもないものに執着するのは時間の無駄だし、今はもっと大事なことがあるからね。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "戦ったことについて…",
      "text": "かつて君と僕が戦ったことが、どうしても忘れられない？ふーん。それで、どうしたいんだい？いいよ、ゆっくり考えても。どうせ、僕もたっぷりと時間があるしね。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "仲間について…",
      "text": "僕が「正義」に帰依することはない。でも君からの恩を返すと言ったからには、必ずやり遂げる。\\nそれよりも君こそ、僕と接触する際は自分の立場をよく考えたほうがいいんじゃない？万が一誰かに見られて、君が罪人と「悪巧み」してるって言われたとしても、僕は知らないよ。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「神の眼差し」は不快なものだけど、確かに使える力ではある。だからそれについてケチをつけるつもりはない。ん？「風元素」には深い意味がある気がする？ふんっ、どうしてそう思うんだい？神は残忍で理不尽な行いをする、前に君にも見せたはずだろう？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "ないよ。聞きたいことがあるなら何でも聞いてくれ。気分次第で答えてやってもいい。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "ほら、見てごらん。鳥は羽を見せびらかし、リスは食料を蓄え、人間は生きるための糧を求めて一日中走り回る…頭が単純な生き物ほど、楽に生きてるよね。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "クラクサナリデビについて…",
      "text": "彼女が僕を消さなかったのは、僕に利用価値があること以外にも、何か他の理由があったからかもね。もしかすると、それは彼女が賢明で、至善の心を持っていたからかもしれないし、あるいは僕の身に孤独の影を垣間見たからかもしれない…ん？悪意に満ちた憶測だって？ハッ、当たり前じゃないか！僕は善人なんかじゃないんだから。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "雷電将軍について…",
      "text": "自らの創ったものに目を向けようともせず、干渉するのが忍びないとか、そんな言葉で取り繕うなんて…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "「女皇」について…",
      "text": "誰もが彼女の優しさと慈愛を称賛するけど、「愛」も「罪」の一種であることを知る者は誰一人としていない。もしかしたらその愛っていうのは、いわゆる代償行動ってやつなのかもね。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "「道化」について…",
      "text": "「道化」はカーンルイアの遺民さ——それ以外について、僕は彼をほとんど知らないし、彼と親しく交流したこともない。でも、彼は僕に対して何か考えがあったようで、前に重要な任務をいくつもくれた…「アビス」へ向かうことも含めてね。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "「隊長」について…",
      "text": "「剛直で硬骨な『隊長』」、「公正で果敢な『隊長』」、「功績の豊富な『隊長』」…これらファデュイの中で流れている噂は、人形の耳でさえタコができるほど聞いたよ。絶対的な「公正」だなんて、とても危険な脅威だと思わない？ましてや、「隊長」はトップクラスの実力を持っているから、尚更さ。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "「博士」について…",
      "text": "実に残念だ。クラクサナリデビが、彼にあんなに多くの断片を消させたことで、僕が彼の断片を一枚ずつ切り刻む楽しみがなくなってしまった。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "「少女」について…",
      "text": "質問だ。「どんな時も」ぼんやりと間が抜けていて、「どんなことをするにも」鈍くてとろい「少女」に遭遇した時、どのような反応をすればいいと思う？僕は、構わず戦える。でも君は…良心を痛めるだろうから、やっぱり彼女からは離れたほうがいいよ。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "「召使」について…",
      "text": "道徳家気取りの偽善者さ。彼女が「優雅」と「親切」を見せるのは、人をよりうまく「コントロール」するためだ。彼女の狂った一面を見た者は、もうほとんど…ふぅ～。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "「雄鶏」について…",
      "text": "「公子」くらいだろうね、「雄鶏」が誠心誠意、見返りもなく彼とその家族を気にかけてくれてるなんて思うのは。あの市長様は確かに実のあることを多くしてきたけど、ちょっとでも頭のいいやつなら分かるはずだよ。それが意味することは——「君の家族を握ってるぞ」、でしょ？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "「傀儡」について…",
      "text": "彼女は自分の研究以外には興味がないんだ。性格だって、極めて酷いものさ。だけどそこまで極端に振る舞って、でき上がったのは大量の廃品のみ。僕が執行官だった時も、僕より一位下だった。実に哀れだね。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "「富者」について…",
      "text": "あの第九位のことか。彼は「公平な取引」にすごく固執していて、あまつさえ、神と人の間にあってしかるべき不公平さえ覆そうとしている。まあ、凡人はそういうものさ、非現実的な妄想を抱きやすいんだ。別に特別なことなんかじゃないよ、彼の平凡な能力や目利きと同じようにね。——ふんっ、「博士」と密接な協力をとるなんてね…いい結果にはならないさ。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "「公子」について…",
      "text": "脳筋で、手先も器用なわけじゃない。いくら最下位だとはいえ、あいつが執行官にいるだけで全体のレベルが下がる。幸い、僕はもうそこにいないからいいけど。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "「淑女」について…",
      "text": "彼女の灰には何もない。僕は未来を失った者には興味がないんだ。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "八重神子について…",
      "text": "心にもないことぺらぺら喋る妖怪さ。神の寵愛を受けるために、人間に関心があるふりをしてるんだろう。でも実際のところ、ただ面白いことが好きなだけなんじゃない？"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "楓原万葉について…",
      "text": "楓原家の末裔？それってつまり…ほう？彼にも風元素の「神の目」が…しかも、雷電将軍の一太刀を受け止めたって？ふふふっ…ハハハハハッ！"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "セトスについて…",
      "text": "なぜ僕が彼のことを知っていると思うんだい？彼がいつも僕の後をつけまわって、しつこく帽子を見せてくれとねだってくるから、というわけじゃないよね？ふん、彼と会話を交わしたことなんてほとんどない。初対面のくせに笠っちかと尋ねてくるなんて…見た目で人を判断しないでもらいたいね。それはさておき…あのあだ名がここまで広まってしまうなんて…"
    },
    {
      "id": "4017",
      "type": 1,
      "title": "ドゥリンについて…",
      "text": "本から出てきた時から、質問が多いやつだったけど、まさか人間になってからのほうがうるさくなるなんてね。いつもミミズがのたくったような文字の、長ったらしい手紙を送ってくるんだ、まったく。\\nどうしても暇で仕方ない時は、あいつの質問に答えてやるといい。あいつが道を踏み外さないようにね。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}を知る·1",
      "text": "僕を知ろうだなんて、珍しいね。面倒を招くかもよ？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}を知る·2",
      "text": "ああ、僕と過去のことについて清算したい人はたくさんいるだろうね。なんだっていいさ、誰でもかかってくるがいい——むしろ、楽しみなくらいだよ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}を知る·3",
      "text": "かつて、神になれば無駄な感情を捨てられると思っていたけど、今はそうは思わない。少なくとも「怒り」は、他人のものであれ自分のものであれ、使い勝手のいい道具なのさ。\\n永遠に怒らない人なんていないだろう？まったく想像もできないよ。そういう人って、怒りの神経ってものすらないのかな？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}を知る·4",
      "text": "世界樹に入った時、僕の頭の中にこう浮かんだんだ——「最初から、この世に生まれてこなければよかった」ってね。\\n世界樹はその願いに応えてくれたけど、僕が期待した結果はもたらしてくれなかったよ。この土地の運命は、相変わらずその虜囚たちを翻弄するのが得意だね。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}を知る·5",
      "text": "僕たちはつながり、交差して、そして…いつかは異なる場所へ向かうだろう。でもこれからなにが起こるかなんて、誰にも分からないじゃない？成り行きに任せよう。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}の趣味…",
      "text": "趣味？それって、暇人のやることだよね。僕がそんなふうに見えるのかい？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}の悩み…",
      "text": "どうやったら君を撒いて、ひと暴れできるか考えてるんだ。——冗談だよ、もしかして信じちゃった？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "茶はある？苦ければ苦いほどいい。どこまでも後味が広がるからね。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "ベタベタしてて甘いものかな。歯がくっつく感じがするからね。君ひとりで食べてくれ。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "まあまあかな。君の数少ない長所の一つだ。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "悪くはない。少なくとも口には入れられる。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "僕を殺す気か？まさか、僕が凡人じゃないことを忘れたとでも？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "僕の手を取って。…ふふっ、身構えなくていい、高いところに連れてってあげるだけだから。\\nいいでしょ？絶景が見られるよ。このくらいのことで礼なんていい、そんなのまどろっこしいからね。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "…うん、尽力したのが分かるよ。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "風が吹いてきたね…何をしたんだい？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "僕に力をくれるなんて…どうなるか心配じゃないの？…そう。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "確かに僕は君の力になれるけど、僕を仲間として見るのは危険なことなんだ。自分が直面しているのが何なのか、きちんと理解したほうがいい。それでも怖くないのなら、僕の背中を預けるよ。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "風よ！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "俗世を見下ろさん。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "天へと舞え！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "礼を弁えぬ虫けらが。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "雑魚どもが！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "もっと泣きわめけ！"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆発·4",
      "text": "頭が高いぞ。"
    },
    {
      "id": "200005",
      "type": 2,
      "title": "元素爆発·5",
      "text": "身の程を知れ。"
    },
    {
      "id": "200006",
      "type": 2,
      "title": "元素爆発·6",
      "text": "君ごときが、僕を直視する気か？"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "ダッシュ開始·1",
      "text": "疾風！"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "ダッシュ開始·2",
      "text": "風が如し！"
    },
    {
      "id": "700004",
      "type": 2,
      "title": "ダッシュ開始·3",
      "text": "…おそい。"
    },
    {
      "id": "700005",
      "type": 2,
      "title": "ダッシュ開始·4",
      "text": "ついて来いなんて言ってないよ。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "ふん、ゴミか。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "はぁ？こんなのも欲しいの？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "欲しいなら君にやるよ。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "もう慣れた。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "取るに足らない。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "使えないやつめ！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "あらら～へなちょこめ～"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "深淵へ…落ちる…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "すべて…無駄…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "罪の…報いか…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "その程度か。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける·2",
      "text": "…笑える。"
    },
    {
      "id": "910003",
      "type": 2,
      "title": "重ダメージを受ける·3",
      "text": "…死にたいようだね？"
    },
    {
      "id": "910004",
      "type": 2,
      "title": "重ダメージを受ける·4",
      "text": "命乞いをすることになるよ。"
    },
    {
      "id": "910005",
      "type": 2,
      "title": "重ダメージを受ける·5",
      "text": "そろそろ代価を支払ってもらおう。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "そう来たか…僕に何をしてほしいんだい？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "まさか、用もなく呼んだわけじゃないよね？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "僕じゃなきゃだめ？…いいだろう、仕方ない…"
    }
  ]
}