  "passives": [
    {
      "id": "awakened_by_the_baying_hounds",
      "name": "微睡む林の目覚め",
      "description": "<b><span style=\"color:#FFD780FF\">トゥガリン</span></b>が攻撃を行う時、付近にいるチーム内フィールド上キャラクターのHPが回復する。回復量はアリョーシャの攻撃力の120%に相当する。",
      "level": 1
    },
    {
      "id": "suffer_the_winter_wheat_will",
      "name": "冬の麦と落ち葉に告げる別れ",
      "description": "アリョーシャの元素チャージ効率を基に、アリョーシャの元素スキルと元素爆発によるダメージがアップする。元素チャージ効率1%につき、上記ダメージが0.35%アップし、最大70%までアップできる。",
      "level": 4
    },
    {
      "id": "into_the_fray",
      "name": "危うきに赴く星",
      "description": "<b><span style=\"color:#FFD780FF\">極星フィールド</span></b>内にいる時、アリョーシャは<span style=\"color:#FFD780FF\">輝映・星電導</span>状態に入る。<br/><span style=\"color:#FFD780FF\">輝映・星電導</span>：<b><span style=\"color:#FFD780FF\">狩猟の印</span></b>を発動した時に獲得する<span style=\"color:#FFD780FF\">狩人の照準</span>の効果により、キャラクターがフィールド上にいる時に与える星電導ダメージがさらに+20%。",
      "level": 0
    },
    {
      "id": "treetop_watch",
      "name": "梢からの偵察",
      "description": "ミニマップで周囲の<span style=\"color:#FFD780FF\">スネージナヤ地域の特産</span>の位置を表示する。闇域においても同様の効果を発揮する。",
      "level": 0
    }
  ],
