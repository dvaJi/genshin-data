  "outfits": [
    {
      "id": 204700,
      "name": "天涯に落ちゆく葉",
      "description": "楓原万葉の衣装。カエデの模様が施された浪人の装い。",
      "isDefault": true,
      "characterName": "楓原万葉",
      "characterId": 10000047,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Kazuha_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "「雨ふる風の中、刀を持ちて裸足で歩く」…拙者は楓原万葉と申す。四方を彷徨う浪人でござる。同じ旅路をゆく者同士、共に歩もうではないか。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·自然",
      "text": "これほど美しき景色を見れば、自ずと旅がしたくなるものであろう？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·草笛",
      "text": "手元に葉があるのなら、拙者が草笛で一曲奏でよう。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·剣技",
      "text": "雨ふる風の中、ふるさとを思う…拙者と故郷のつながりは…もうこの刀のみでござる。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "大雨の中を歩けば、精神が研ぎ澄まされる。しかし雨が止んだあとは、急いで服を乾かした方がよいでござるな。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雷の日…",
      "text": "海を渡る時の雷雨と比べれば、この程度は意にも介さぬ。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "雪は好きでござる。雪が降った後の世界は静かで、誰にも夢を邪魔されずに済む。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "晴れの日…",
      "text": "雲一つなし、実に心地好い晴天よ。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "早朝に聞こえる鳥のさえずり、大自然からの恵みでござるな。\\nさあ、参ろう。拙者たちの旅路も始まるでござるよ。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "正午の日差しは、居眠りをしてしまいたくなるほど心地好い。休む場所を探してみてはどうでござるか？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "上に見えるは月、耳に聞こえるは風、杯にあるは酒、心にあるは安らぎ…\\nご機嫌いかがでござるか。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "風が止んだ…\\n静かな世界、休むのに最適であるな。では、また明日。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "楓原万葉自身について·航行",
      "text": "実は、大海も毎日が荒波というわけではないのでござる。天気がよい日は、月光が海面を揺れ、魚群が船の周りを泳ぐ。船首から遠くを眺めれば、この旅も価値のあるものだと思える…唯一残念なのは、船員の歌声がうるさいことでござるな。あやつらは眠らなくても平気なのであろうか？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "楓原万葉自身について·武家",
      "text": "楓原家はかつて有名な武士の家系であったが、拙者が跡を継いだ時にはすでに、武家の名以外は意味のないものとなっていた。しかし拙者からすれば、それくらいがちょうどよい。武士に裕福な生活などいらぬ。拙者たちに必要なのは詩歌と美酒、そして手中にある刀のみでござるよ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "出航について…",
      "text": "天気のよい日は、海に行ってみてはどうでござるか？"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "本音について…",
      "text": "拙者は飾り気のない性格をした人が好きでござる。やはり、思っていることは心の内に秘めず、直接言った方が快いものだ。\\n拙者は万物の音が聞こえる、もちろんお主の声も。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "神の目は力の「根源」ではなく、力の「証明」であると拙者は思う。神の目とは、前へ進みたいと思う人々の願い。拙者たち武士にとってのそれは、いつの日も手中にある刀のみなのでござるよ。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと·竹刀",
      "text": "剣術を学びたいなら…ふむ、これを持つとよい。先ほど作った竹刀でござる。これで打ち合えば、傷を負わずに済むであろう。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "シェアしたいこと·カエデ",
      "text": "「奥山に、紅葉踏み分け、鳴く鹿の、声聞くときぞ、秋は悲しき」…拙者はカエデが好きでござる。しかし、カエデが紅に変わる時は、いつも別れが伴う…"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "興味のあること…",
      "text": "カモメよ、鳴くでない。今日から拙者も同じく、漂流者なのだぞ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "北斗について…",
      "text": "北斗の姉君は拙者の恩人。稲妻から逃げ出した拙者を、姉君が引き取ってくれた。拙者が一番苦心していた時期に、稲妻へ戻る勇気をくれたのだ。彼女は、拙者と周りにいるすべての船員が背中を任せられる戦友なのでござる。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ゴローについて…",
      "text": "拙者が指名手配されていた時、抵抗軍が拙者を助けてくれたのでござる。ゴローとはその時の短い付き合いであったが、彼のことは深く印象に残っている。彼は言いたいことを真っ直ぐに言う性格で、部下と共に喜びや悲しみを分かち合い、友のために犠牲をいとわない。だから拙者は、彼とは気が合うのでござるよ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "九条裟羅について·態度",
      "text": "御前試合で拙者の友人を負かした彼女の実力は認めているでござる。しかし、それほどまでの力を悪行に使い、九条軍を率いて「神の目」を回収するなど、拙者は決して許さぬ。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "九条裟羅について·見直し",
      "text": "なるほど…どうやら彼女は自らの信念があったのだな。ただこの一件が終わったあと、「九条」家の繁栄がこの先も続くかどうかは不明であるが。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "雷電将軍について…",
      "text": "稲妻を離れた後、何度も自分の胸に聞いたでござる。雷電将軍に対する拙者の不満は、あの御前試合から生じたものなのか、彼女が友に下した一振りが原因だったのかと。\\n拙者は考えた末、それは違うと分かった。拙者の友は決闘の場で堂々と死した、雷電将軍のあの一振りは間違っていたとは言えぬ。彼女に対する不満は、「目狩り令」からくるものだ。何人たりとも他人の願いを剥奪する資格などない、たとえそれが「神」であったとしても。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "神里綾華について…",
      "text": "稲妻に住む者なら、「白鷺の姫君」の名を聞いたことがあろう。神里家のお嬢様で、ほぼ完璧に等しい御仁でござる。しかし、拙者は彼女とあまり交流がない、彼女は稲妻に対してどのような考えを持っているのであろうか？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "宵宮について…",
      "text": "以前、彼女が姉君に頼んで花火を璃月まで運んだことがある。その時は拙者が荷を下ろした、が…大変重かったでござる！彼女以外に、あのような大きな花火を作れる者などいないであろう。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "珊瑚宮心海について…",
      "text": "拙者が抵抗軍にいた頃、周りの者はみな珊瑚宮殿を心から慕っていた。彼女は兵力を大事にしている、死傷者の出る戦法はほとんど使わず、いつも最小の代価で勝利を勝ち取るのでござるよ。うわさでは、海祇島の政務と外交も取り仕切っていると聞いたが、本当に一人ですべて行えるのだろうか…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "鹿野院平蔵について…",
      "text": "拙者の友人であるこの探偵は、普段は洒脱で気ままな振る舞いをしている。しかしいざ事件となると、彼の周りを取り巻いていた風は、鋭い気となって集まる。まったく、感心せずにはいられないでござるよ。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "楓原万葉を知る·1",
      "text": "拙者のことを知りたいのか？見ての通り、どこにでもいる流浪武士でござるよ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "楓原万葉を知る·2",
      "text": "拙者は耳が優れていて、様々な音が聞こえる。例えば風が山を越える音、雲が散りゆく音、森で小狐がリンゴをかじる音、カニが泡を吹く音…これは自然と万物が拙者に与えた恩恵、いつでも危険を事前に察知することができるでござる。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "楓原万葉を知る·3",
      "text": "小さい頃は雨が好きであった。あのザァザァとした音を聞くと心地好い夢を見る。しかし今となっては、雨に対する感情も複雑になったでござる…雨の音は今も好きなのだが、黒雲を見かけた時は「今日、泊まらせてくれる心優しき方はいるであろうか」と心配になってしまう。濡れた服で雨の音を聞いても、くしゃみで雰囲気が壊されてしまうでござるよ。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "楓原万葉を知る·4",
      "text": "拙者はあまり同じ場所には滞在しないでござる。長く滞在すれば「自然」との間に隔たりが生じ、刀が鈍ってしまう。遠くへゆける今のうちに、様々な場所にゆき、色々な人に会ってみたいでござるな。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "楓原万葉を知る·5",
      "text": "心配はいらぬ、いつの日かお互い違う場所に赴こうとも、必ず世界のどこかでまた会えよう。人の「縁」とは、そう容易く切れるものではないのでござる。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "楓原万葉の趣味…",
      "text": "正午の日差しで温かくなった岩に横たわり、目覚めた後はぶらぶらと。刀を持っていれば、拙者はどこにでもゆけるでござるよ。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "楓原万葉の悩み…",
      "text": "嵐がくる時は、「自然」の音もざわつく。拙者も耳鳴りがしてしまうほどに。もしそれが夜であれば、そうそうに眠れぬ。少し困っているでござる。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "海を渡る時、最も容易く入手できる食材は魚肉でござる。魚をどう美味しく調理するか、海を冒険する者なら、みなが考えることであろう…機会があれば、拙者の腕前を披露してもよいぞ。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "拙者は粗造りしたものがあまり好みではない。拙者からすれば、ただの魚であろうと、しっかりと焼いた方が旨味がある。食事というのは心身を安らげるもの、妥協していてはならぬであろう？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "うむ、魚をこうも美味しく調理するとは、お主の腕は相当なものでござるな。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "お主の料理は腹を満たすだけでなく、拙者にとって心の安らぎでもある。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "少し休んではどうでござるか？心が疲れていては、せっかくの料理も味が落ちてしまうであろう。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "ふぁ…誕生日だと知って、新しい詩歌を書いたでござるよ。ただあまり心得がなく、何日もかけて途中までしか思いつかなかった。とりあえず、これをお主に贈ろう。\\n「歳月や、雲の赴く、誕生日」…ん、待った、何か思いついたでござる。続きは…「祝いの日には、異郷の友と」、どうであろうか？\\n誕生日おめでとう、今日は一緒に甘味でも食べにゆこうではないか。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "この刀、より鋭利になったでござる。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "雪が地面に落ちる音…今の拙者は、それすらも聞こえるようになったかもしれぬ。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "海の波は強い、拙者ももっと強くならねば。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "世を渡り歩けば、自ずと悩みも多くなるもの。お主との出会いは、拙者に、武道と心の成長をもたらした。今後の人生もきっと、よいものとなるであろう。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "参る。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "はっ。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "風よ。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "風の行先よ。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル·5",
      "text": "風を知れ。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル·6",
      "text": "風の赴くままに！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "雲隠れ…雁鳴く時。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "風の共、雲の行くごと。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "黄葉を、散らまく惜しみ。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "ダッシュ開始·1",
      "text": "いざ。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "風の翼を広げる·1",
      "text": "風の流れる方へ。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "天晴でござるな。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "天地の恵みであるな。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "宝とは、旅の醍醐味でござろう。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "くっ、やりおる…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "精神統一。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "一点集中！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "拙者が守る！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "背中は任せろ。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "誠に遺憾なり…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "次は…必ず…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "終わったのか…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "心配無用…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける·2",
      "text": "痛ぅっ！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "拙者を連れていくのか？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "いざ、参ろう。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "これでよし。"
    }
  ]
}