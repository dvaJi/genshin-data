  "outfits": [
    {
      "id": 202200,
      "name": "緑風に結ばれた詩",
      "description": "ウェンティの衣装。自由気ままな吟遊詩人の服装。",
      "isDefault": true,
      "characterName": "ウェンティ",
      "characterId": 10000022,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Venti_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "ファ…よく寝た。あっ、こんにちは、旅人さん、ボクたちまた会ったね。ん？覚えてない？エヘヘ、それじゃあボクをまた君の旅に加えておくれ。君の実績は、世界最高の吟遊詩人であるボクが歌うにもってこいなんだよ～"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·演奏",
      "text": "もっと聞きたいなら、リンゴをちょうだいよ。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·リンゴ酒",
      "text": "大きな木の上に腰かけて、飲みきれないほどのリンゴ酒を片手にもつんだ。ほら～"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·詩篇",
      "text": "行動するんだ、旅人よ。失われた詩篇が、ボクたちを待っている。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "水たまりを踏んでみよう！どっちが大きな水しぶきを飛ばせるかな！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨上がり…",
      "text": "あれ～晴れちゃったの？もう少し遊べるかと思ったのに。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雪の日…",
      "text": "雪が積もったら…雪合戦しよう！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "暴風の日…",
      "text": "せっかくだし、飛んでみない？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "おはよう。新しい冒険を始めるの？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "グー…お腹空いた。またアカツキワイナリーでタダ飯食べるのも気が引けるしな…君だったのか！ヤッホー、出かけるの？ボクも連れて行ってよ。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "ボクはまだ眠くないよ。もう少し付き合ってよ？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "寝るのかい？ヘヘ、お休み。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "ウェンティ自身について…",
      "text": "練習？フフン、もちろん必要ないさ。ここテイワットではボクに歌えない歌はないんだよ。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "新しい歌について…",
      "text": "君をボクの新しい歌に書き加えたいんだ！あれ、どうしてそんな顔するの？原稿料を払えるかが心配？アハハ、そんなのいらないよ。それより…また君の物語を話してよ！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "勇者について…",
      "text": "#うん…うん…なるほど！エヘヘ、勇者が{M#お姫}{F#王子}様を救い出したら、真っ先に大陸中にこの歌を広めるんだ。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "使徒について…",
      "text": "夜風が涼しくて、神の使徒になるのにピッタリの気候だよ！じゃあ善は急げって言うし、早速ボクに貢物を捧げてよ。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "請求について…",
      "text": "あれ、風の神のボクにもっと頑張れって？それなら君も誠意を見せなくちゃ。例えば、敬虔さ、情熱、または……"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "えっ？ボクの「神の目」が気になるの？うん…はい、どうぞ。気に入ったなら、同じやつを作ってあげようか？エヘヘッ。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "Olah！エヘヘ、これはヒルチャールの挨拶の言葉なんだよ。そんなの覚えて何するのかって？もう、創作のためだよ。当然ながら知識は多いに越したことがないからね。あっ、そう言えばボク、まだヒルチャール語の歌は書いたことがない気がするな…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "旅人さん、セシリアを見たことある？静かな山岳の頂上に黙々と咲く白い花だよ。ボクはセシリアこそがテイワットで一番美しい花だと思うんだ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "ジンについて…",
      "text": "騎士団の代理団長…君は彼女をどんな人物だと思う？エヘヘ、ボクと同じこと考えているね。真面目、勇敢、優しさに溢れている。ボクのある友人と少し似ているんだ…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ディルックについて…",
      "text": "ディルックのところに行って仲良くしておくのはどう？考えてごらんよ。彼の家には秘蔵のお酒が、たっくさんあるんだよ！エヘヘ、エヘへへへ…あれ、何でお酒を飲みたがらないの？その…ちょっと香りを嗅ぐだけなら？香りだけ！香りを嗅ぐだけなら君も大丈夫だよ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "バーバラについて…",
      "text": "歌の上手な牧師の少女を知ってる？…えっ、アイドル？…んと、握手会？…えーっと、単独ライブ？…そうなんだ。音楽ってやっぱり奥が深いね。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "レザーについて…",
      "text": "あの奔狼領の白髪の少年は、へえ、そうなんだ。狼に育てられたのか…道理で、彼の匂いを懐かしく感じるわけだ…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "モナについて…",
      "text": "あっ、あの占星術師のことかい？そうだね、占いもボクの詩と同じで、酒代すら稼げないほど役立たない技術だね！…星占いは伝統文化だから、役立たずじゃないって？うっ、失礼だよ、それなら詩だって役立つよ！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "ディオナについて…",
      "text": "キャッツテールの人気特製カクテル！でも…うっ、くしゃみが。ボクの代わりにもらってきてくれないかい？感謝するよ。約束だよ。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "アルベドについて…",
      "text": "黒土と白亜、宇宙と地層、無垢なる土から原初の人間を創る…こんなあまりにも行き過ぎた能力は看過できないよね。もし危険な古の技術が城内で暴走でもしたら——まっ、いっか、モンドの問題はモンドの人に解決してもらおう。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "モラクスについて…",
      "text": "あのじいさんに会ったのかい？彼は元気だった？えっ、「鍾離」という名前の一般人になってた？あの頑固頭からしたら、これは大きな変化だろうね。ボクと一緒に彼に会いに行こうよ、この風立ちの地に埋められた酒も持ってさ。あっ、そうだ、彼はまだ強いのかい？力はあとどれくらい残ってる？ボクが会いに行ったら、吹き飛ばされたりしないよね？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "エウルアについて…",
      "text": "エウルアのお酒の趣味はなかなか面白いものだよ。夏でも冬でも氷を入れた冷たいのを飲むんだ。彼女みたいなのは、今のモンドにそういないだろうね。彼女とはいい飲み友達になれそうだよ。ん？ボクの作ったローレンス家の歌が…彼女の耳にも？あははっ、それがどうしたの？もしかしたら僕たち、一緒に歌えるかもしれないね。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "バアルについて…",
      "text": "あの偉そうにしている雷電将軍を倒したんだって？うーん…彼女は影武者をやっていた頃から究極の武道を追い求めていた。だから今、きっと色んな理由を駆使して君を稽古に誘うだろうね。よし、じゃあこっそり君に彼女の弱点を教えてあげよう。ちょっと耳貸して——それはね～「スイーツ」だよ！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "ブエルについて…",
      "text": "草神のこと？草神と言ったら、真っ先に彼女の「夢境」に関する権能を思いつくでしょ？ボクの作る詩歌と同じように、彼女の創造する夢境も浪漫と想像力に満ち溢れているんだ。ボクたち、すっごく気が合うんだよ。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "フリーナについて…",
      "text": "吟遊詩人が得意とするのは演奏や歌だけど、劇の演者となると、それ以上の能力が必要になってくるんだ…いっそ次の風花祭は、フリーナも連れてきて一緒に公演するのはどうかな？——ん？彼女がフォンテーヌを救ったことについてもっと聞きたいって？うーん、あれほどの芸術的才能を持った人が世界を丸ごと救うなんて、まったくもって不思議な話じゃないでしょ？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "ハボリムについて…",
      "text": "漆黒の脅威と戦うために多くの民が犠牲になるなんて、胸の痛くなる話だね。でもマーヴィカの導きによって、ナタの人々は魔神に匹敵する偉業を成し遂げた…へへっ、「彼女」の時から、ナタ人はずっとそうしてきたんだろうね。そういえば、マーヴィカはお酒が好きなんだってね？それなら…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "ダリアについて…",
      "text": "旅人よ…風の声が聴きたいかい？風の導きが欲しいのかい？それなら…あの助祭を訪ねるといい！ハハッ、なんてね。直接ボクのとこに来てくれればいいよ。お酒を片手に、お喋りしよう！ボクがどうしていつもダリアに伝言を頼むのかについては…もう分かってるよね？そう——ダリアはさざめく風を追いかけながらも、自分の進むべき道を見失うことがないんだ。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "ドゥリンについて…",
      "text": "また一人、魔女の子供がモンドに住み着いて、賑やかになったね。この小さなお友達はボクの大きな友達と一緒に遊びたいようだったから、ちょっと紹介してあげたんだ。そしたら、大きな友達の方がテンション上がっちゃったみたいでね、嬉しさのあまりお腹を叩いて踊り始めちゃったよ。おっと、大きな友達に聞かれちゃったかな？早く一緒に木の後ろに隠れよう。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "ウェンティを知る·1",
      "text": "ちょうどいいところに来たね、旅人さん。君の願いが何か聞かせてほしいんだ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "ウェンティを知る·2",
      "text": "君と一緒に旅をするのは面白いよ。気がかりな点を挙げるとすれば、君の傍にいるあのチビかな。あんなによく食べるんじゃ、君たちの食費もバカにならないだろう？アハハ。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "ウェンティを知る·3",
      "text": "火の神は横暴で戦い好き、岩の神は人の心が分からない頑固者だよ。どうしてこんなことを知っているのかって？エヘヘ、叙事詩の中にはっきりと書いてあるからね。彼らの物語、あの時代の物語が。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "ウェンティを知る·4",
      "text": "天空の島か。ボクでもあそこまで飛べるか分からないよ。それにあそこには美味しい水も、木の実もないんだ。美味しいお酒なんてもってのほかだよ？ヘヘッ、あそこには頼まれたって行きたくないね。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "ウェンティを知る·5",
      "text": "ボクの願い事？うん、昔はこの世界全体を巡りたいと思っていたよ。今も同じさ。ただ、条件が一つ増えただけ。それは君と一緒にってことさ。君がいてこそ完璧なんだ。やっぱり語り手は冒険者と一緒にいないと、エヘへへ！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "ウェンティの趣味…",
      "text": "ボクはお酒が好きなんだ！あと風もね！うーん、風でできたお酒があったらいいのに。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "ウェンティの悩み…",
      "text": "実は、猫が近くにいるだけでくしゃみが止まらなくなるんだ…ハ、ハハ、ハクションッ！うーん…想像するだけでもダメだ…もう、これってどうすれば治るか知らない？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "君も一つリンゴをどう？もぎたてだよ。ガブッ、あぁ…シャクシャクしていて甘い。リンゴこそが神からの贈りものだよね！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "何か美味しいものを作っているのかい？おや～？チーズパンケーキ！これは…これはダメ。熱くてベタベタしていて。うー…ボクにはクドすぎるんだよ…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "ふぅ、満足、満足！明日もあるんだよね？それから明後日も！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "ふぅ、お腹いっぱい。食後のフルーツも食べられそうにないや…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "このボクですら苦手な料理だなんて。うぅ…困っちゃったな。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "以前、友達から誕生日はケーキを食べるって聞いたんだ…ほら、リンゴケーキだよ。はい、スプーン。焼き上げる時に少し崩れちゃったからアップルパイみたいだけどね。エヘ、スイーツって本当に難しいね。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "えっ、今なにかあったの！？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "お疲れ～音楽を聴いてリラックスしようか？カプリチオがいい？それともセレナーデ？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "さあ、こっちにおいで～新しい詩を作ったよ、タイトルは『旅人の風』にしようか。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "うーん…この景色は何度も目にしてきたのに、君が隣りにいるとまるで新しいものに見えるんだ。まさか君…不思議な力を隠し持ってたりしないよね？…あっ、それでもいいや、ボクの人を見る目が確かだってことだもんね、エヘヘッ！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "ふぅ～"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "ここだよ。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "足下に気をつけて～"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "一緒に遊ぼうよ～"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "逃げようなんて思わないでよね？"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "風だ～"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "ダッシュ開始·1",
      "text": "走るより飛ぶほうが速いよ？"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "風の翼を広げる·1",
      "text": "ヤッホ～"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "コホンッ、ここで一曲、「宝箱の歌」！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "てへっ、「風神のご加護」ってやつ？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "お酒が何本も買えるね～"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "待って、これじゃ面白くないよ！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "うわぁ、ボクばかり攻撃しないでよ！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "ひどいよ。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "ボクに任せて～"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "まだ諦めちゃダメだよ。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "少し寝よう…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "ありゃ、弦が切れちゃった…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "バタンキュ～"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "ダメージを受ける·1",
      "text": "アチャ～"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "乱暴だな。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "音階調整お～わり！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "待たせちゃった？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "ウォーミングアップしよっか。"
    }
  ]
