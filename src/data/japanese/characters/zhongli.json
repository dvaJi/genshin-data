  "outfits": [
    {
      "id": 203000,
      "name": "俗世の知見",
      "description": "鍾離の衣装。「往生堂」の客卿、鍾離先生が近頃お気に入りとしている日常的な装い。",
      "isDefault": true,
      "characterName": "鍾離",
      "characterId": 10000030,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Zhongli_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "新しい「契約」か？…分かった、休暇中だが、付き合ってもいいぞ。契約書はどの名にすればいい？名はたくさんあるのだが、今は…「鍾離」と名乗っている。お前はどうだ？旅人。お前はどの名で契約する？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·旅",
      "text": "旅はいつか終わりを迎える、慌てる必要はない。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·遊覧",
      "text": "次はどこに行くんだ？璃月の名所を巡りたいなら、いい案がいくつかあるぞ。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·璃月",
      "text": "「流通」のために作られた船は港に止まる、だから璃月はあらゆる富が「沈着」する場所だ。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "世間話·過去を懐かしむ",
      "text": "花を買い、酒を持ち、船の上から璃月の景色を堪能しようとしたが、共に過ごした旧友はもう居ない。\\nあの古き友との再会は、いつ叶うだろうか？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨上がり…",
      "text": "「琉璃袋」という植物は湿っぽい環境を好むため、雨上がりに摘むのがおすすめだ。見かけたら、適切な時に摘むといい。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雪の日…",
      "text": "雪が止むまで場所を移動しよう。俺は問題ないが、お前が風邪を引くかもしれない。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "暴風の日…",
      "text": "休暇に向いていない天気だ。芝居でも見に行くか。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "今日も好景気になることを願っている。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "元気になるもの？チ虎岩にあるいい店を知っているが…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "もう雲殿の芝居に間に合わないが、夜の璃月はまだまだいいところがたくさんあるぞ。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "市場が終わり、賑やかな港も眠りについた。お前も休むといい。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "鍾離自身について…",
      "text": "規則がなければ、円を成すことはできない。常人でも仙人でも、それぞれの役割を果たすことで、璃月の平和が保たれる。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "黄金について…",
      "text": "黄金は璃月の富、璃月の心臓を動かす血だ。お前に黄金のように輝く心があるかどうか、見極めさせてもらうぞ。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "契約について…",
      "text": "俺達には「契約」がある——だから契約内のことは、何でも相談していいぞ。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "公平について…",
      "text": "「契約」外のことでも俺に相談していいぞ。この土地で長く生きてきたから、大体のことは知っている。とはいえ、お前にやってもらいたいこともある。そうしないと「公平」じゃないからな。"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "困惑について…",
      "text": "「契約」は「友情」の深さを測ることができない。では、何を使えば俺たちの友情の重さを測ることができるのだろう？「友」よ、お前は答えを知っているか？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「神の目」…それも一つの「契約」だ。あらゆる力を知るには代価が必要だ。千の権力には千の責任が伴う。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "「取引」の決まりは「契約」、その規準は「公平」。それは「契約」を作って、守る者が忘れてはならないことだ。公平が失われたら、契約は嘘の証拠となる。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "「絶雲の間」に行く機会があったら、「清心」を一束取ってきてくれ。一束でいいんだ。旅費は…ああっ、忘れるところだった。「契約」の有効期間中の旅費はお前が持ってくれ。では、頼んだぞ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "魈について…",
      "text": "帰離原の少年仙人と言ったか？…あぁ、彼は今日に至ってもその責務を果たしている…この「連理鎮心散」を、俺の代わりに渡してきてくれないか。そうだ、パイモンが食わないように注意するんだ。この薬は…常人が耐えられるものではない。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ウェンティについて…",
      "text": "っ…。あの詩人が来ただろう、あの風流の分からない呑兵衛詩人が！お前…むっ、ヤツに変な飲み物を飲まされて、うっとりしているのか…少し待て、眠気覚ましの茶を淹れよう。6時間あればできるんだ、少し待ってくれ…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "凝光について…",
      "text": "多忙を極めていても、彼女は奮迅の心を持っている。あの頃、彼女が裸足で瑶光の浜から南埠頭まで歩きながら商いをしていた姿を思い出す。時間は人にとって残酷なものだな…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "胡桃について…",
      "text": "今の堂主？コホン、あの子は苦手だ。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "タルタリヤについて·落ち着き",
      "text": "あのスネージナヤの武人はまだ璃月にいるのか？ハハッ、構わない、彼がお前にちょっかいをかけてきたら、その時は俺を呼ぶといい。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "タルタリヤについて·お酒を飲む時",
      "text": "近頃、「公子」のファデュイでの評価がまた下がったらしい。しかし、悪評を一掃するためであれば、彼は積極的に動くだろう。ふむ…そう考えると、今度彼との宴席でまた面白い話が聞けそうだ。旅人、お前も一緒に来るか？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "甘雨について…",
      "text": "璃月の繁栄は「岩王帝君」のお告げのおかげだけではなく、「契約」に応えた無数の岩神の民のおかげだ。その中で、最も長く職務についたのが甘雨だ。彼女の過去に関しては…ハハッ、彼女の気を悪くしたくないからな、彼女本人に聞いてくれ。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "刻晴について…",
      "text": "彼女は当代七星の中で最も神を敬わない人だが、俺は結構気に入っている。「自分が正しいと思うなら、声を大きく、動揺せずに行動する」——こういう人間が璃月に現れたから、俺は引退を考えたんだ。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "煙緋について…",
      "text": "彼女は俺と「契約」をしていないが、自らの方法で璃月の規律を守り、偏った思想を正している…いつの日か、彼女の父親が戻ってきて、彼女の成長を目にしたら、ほっとするだろう。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "バアルについて…",
      "text": "すべての意志は時によって磨かれる。彼女は信念のためならば、自らのすべてを捧げることさえ厭わない。だからこそ、ここまで歩んでこられたのかもしれない…機会があれば、俺も彼女がすべてを費やした「永遠」を見てみたいものだ。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "ブエルについて…",
      "text": "知恵の神ブエル、スメール全体を統治しているだけでなく、世界樹を守る責務も担っている。卓越した英知がなければ、それらを司るのは難しいだろう。世界樹を救ったことについては、テイワットにおけるすべての生き物が彼女に礼を言うべきだ。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "フリーナについて…",
      "text": "国を救う契約を「自己」と締結し、それを五百年に渡り厳守することで天理を欺いた…「正義」によってなされるすべてを、俺は尊重する。たとえ神性の部分がすでに消え去り、神座さえなくなったとしても、フォンテーヌすべての歴史において、フリーナは正義の神として認められるに値する存在だ。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "閑雲について…",
      "text": "「閑雲」についての逸話なら、何人もの商人から聞いたことがある。一見驕傲で無口に見えるが、ひとたび話せば、その真っ直ぐな性格と方正さから、友好を結びよき友として交流するに値する人物であることに気がつくのだそうだ。それを聞いて、俺も実に喜ばしく思った。ところで、彼女に対する評価のうちの一つ、「気前がよい」という言葉については…ふむ、俺もよく言われるのだが…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "ハボリムについて…",
      "text": "ナタの長きにわたる抗争の歴史が詩に綴られ、それに励まされた無数の戦士が戦場へと赴いた。そして、ついにアビスの脅威と理不尽な宿命を戦い抜き、新たな未来を勝ち取った。その戦士らを率いたのは、時間と歴史を武器に昇華させた人類の戦士。元は人間だというのに神に比肩する実力を持つ彼女には、心から感服する。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "白馬の仙人について…",
      "text": "白馬——懐かしいな。あの仙人とは、もう随分会っていない。時は短く、一瞬にして過ぎ去ってしまうのが残念だ。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "鍾離を知る·1",
      "text": "どうした？せっかくの休暇なのに休まずに俺のところに来るとは。俺の話が聞きたいのか？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "鍾離を知る·2",
      "text": "「黒岩場」の起源を聞いたことがあるか？\\n昔、人々は天衡山の鉱脈を採掘しながら、中で工場施設を作っていて、そしてそれが東大陸最大の工場になった。中の道路は四方八方に通じている、大地の深部にある古い遺跡に通じるものもあったが、その全てを記憶している人は今はもういないだろう。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "鍾離を知る·3",
      "text": "「海灯祭」の起源を聞いたことがあるか？\\n昔、璃月は戦をしていてな、戦地へと赴いた人たちが故郷に帰る方向と自分の初心を見失わないよう、人々が夜に提燈を飛ばしたんだ。今はもうそんなこと誰も覚えていないだろうがな。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "鍾離を知る·4",
      "text": "「契約の神」について聞いたことがあるか？\\n彼は記憶力がとてもいいんだ。宿敵の名前を、璃月船舶局が設立してから船が出港した全ての日を、彼が忘れたことは一度もない。それほどの記憶力があるからこそ、あらゆる「契約」を覚えられる。\\nしかし、記憶力がいいということはたまに不快になるきっかけにもなる。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "鍾離を知る·5",
      "text": "長く生きすぎた人は記憶の中でのみ、昔の戦友や過去の景色を訪ねられる。\\nそれでも、お前との出会いを後悔していない、「友」よ。たとえいつかお前と別れる日が来るとしても、お前は俺の記憶の中で輝き続ける。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "鍾離の趣味…",
      "text": "時間がある時、城内を散歩すると気分が落ち着くな。うん…こんな気持ちはいつからだろうな…？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "鍾離の悩み…",
      "text": "人々に「契約」を守らせ、ルールに従って行動してもらうのは、「公平」を守ってほしいからだ。しかし、そのことに気付かない人はどうしてもいる。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "遠い昔に友と共に飲んだ酒だ。気候が変わったせいか、過去の味はもう再現できそうにない。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "海産物は嫌いだ。見るだけで、ああいう…何というか、つるつると滑るような感覚と洗っても消えない生臭さを思い出す。原因は…\\nはぁ、話すと長くなる。記憶力が良すぎるからということにしてくれ。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "本格的な調理法で、素材にまでこだわっている。大したものだ。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "料理とは、実に趣のあるもの。それはお前にとっても同じことだろう。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "時間があれば、どこかの庭園でお前に物語を聞かせてやろう。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "誕生日おめでとう。これはお前が生まれた日に咲いた「琉璃百合」のドライフラワーだ。\\n昔の璃月の人々は、大地の美しい記憶と祈りのためにこの花が咲くと言っていた。きっと、お前の誕生もそうだと俺は信じている。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "力が戻ってきたようだ。多くはないが、役に立つ。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "力が増した分、体への負担も増えた…大丈夫だ、俺の体は普通の人とは違う、心配いらない。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "なるほど、「神の目」を使って元素の力を操ることは常人にとって単なる偉業ではないんだな。ふん…あの時の彼らは、こんな覚悟を持って俺の傍にいたのか…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "「神の心」を手放した後、こんな景色が見れると思っていなかった——「友」よ、感謝するぞ…そうだ、ここに新しい「契約」があるが、一緒に確認しないか？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "壁立千仞。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "震天動地。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "揺らぐことなし。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル·4",
      "text": "岩山破蓄。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル·5",
      "text": "堅如磐石。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル·6",
      "text": "難攻不落。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "天理長駆。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "天道、ここにあり。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "天動万象。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける·1",
      "text": "いにしえの宝物、実に貴重だ…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける·2",
      "text": "偶然の出会いには、おもむきがある。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける·3",
      "text": "来た甲斐があった。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下·1",
      "text": "その実力、認めてやらなくもない。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下·2",
      "text": "ははっ、面白い。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下·3",
      "text": "危機に陥った時の対応は得意ではない。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "仲間HP低下·1",
      "text": "迂闊に攻めるな。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "仲間HP低下·2",
      "text": "下がれ、ここは俺に任せるんだ。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "戦闘不能·1",
      "text": "ああ、少し疲れた…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "戦闘不能·2",
      "text": "見苦しいところを見せたな。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "戦闘不能·3",
      "text": "磐石も…いつか土に還る…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重ダメージを受ける·1",
      "text": "油断したか。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重ダメージを受ける·2",
      "text": "恐るるに足らず。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "チーム加入·1",
      "text": "いいだろう。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "チーム加入·2",
      "text": "気晴らしになるな。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "チーム加入·3",
      "text": "何をすればいい…"
    }
  ]
}