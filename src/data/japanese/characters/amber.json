  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "偵察騎士アンバー、参上しました！今後何か必要なことがあれば、何でもお申しつけください！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·趣味",
      "text": "少し体を動かしたいなぁ。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·心配",
      "text": "ジンさんにサボっているところを見つかったら、ドヤされちゃうよ。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·新たな発見",
      "text": "向こうに何か変なものがあるみたい…見に行かないの？見に行かないの？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日·心配",
      "text": "雨だ…リボンが濡れちゃうよ…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨の日·注意",
      "text": "雨か…視界が悪いね。気をつけてね。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雨上がり…",
      "text": "うわ～本当にいい天気。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "晴れの日…",
      "text": "う～ん…もう少し風があればいいのにな。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "風の日·心地よい",
      "text": "本当に気持ちいいなぁ…"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "風の日·リラックス",
      "text": "こういう天気大好き。あ～、気持ちいい～"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "おはよう！一緒に朝のランニングに行かない？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "お昼ご飯、一緒に食べてもいいの？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "暗くなってきたよ。松明をつけようか？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "うん、休憩も大切だよ！じゃあ約束だよ、また明日ね！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "アンバー自身について…",
      "text": "モンドの飛行チャンピオンとは私のことだよ！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "試合について…",
      "text": "あんただからって、試合では手加減しないんだからね！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "飛行について…",
      "text": "飛び方のコツを教えてあげるよ…あんたと一緒に飛ぶ時、いつもより速く飛べる気がするの…あっ、何がおかしいの？もういい、勝負だよ、今から勝負しよう！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について…",
      "text": "「神の目」は神様がわたしのことを認めてくれた証でしょ。うん、わたし、一番優秀な偵察騎士になるんだから！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "ほらっ、大教会の時計台に上ってみよう。すっごい良い景色だよ！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "見て、あそこにハトがいる！ふふっ、あの子たちと一緒に飛びたいな。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "ジンについて·協力",
      "text": "大団長が出征した後、仕事を全部ジンさんがすることになったんだよね。わたしがもっとジンさんの役に立てたらいいのに…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "ジンについて·心遣い",
      "text": "ジンさん、まだ仕事しているの？…一緒にコーヒーを飲もうって誘いに行こうよ。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "リサについて·物語",
      "text": "時間があったら、一緒にリサさんのところに行こうよ！この前、リサさんがドラゴンスパインの宝物の話をしてくれたんだけど、半分しか聞けなかったんだ。だから、その続きが聞きたいの！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "リサについて·感心",
      "text": "リサさんって寝ている時以外はずっと本を読んでいるみたい！本当にすごいなぁ。わたしなんかそんなに長時間座っていられないよ。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "ガイアについて·心配",
      "text": "…何か嫌な予感がする！さっきまでガイア先輩がいたでしょ？迷惑かけられなかった？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "ガイアについて·元凶",
      "text": "花畑の蒲公英がしおれてる。もうッ……きっとまたガイア先輩の仕業だよ！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "ベネットについて…",
      "text": "ん？ベネット…どこかで聞いたような…あっ！冒険者協会にいたあの熱い男の子だね！うん、たまに秘境の周辺で彼を見かけるけど、宝探しに夢中みたいだよ。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "クレーについて…",
      "text": "クレーね、たまにいたずらするけど、騎士団のみんなは彼女のことが大好きだよ！むっ…またジンさんを困らせないよう、彼女のことはしっかり見張っておいたほうがよさそうね。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "アルベドについて…",
      "text": "アルベドはいつも自分の工房にこもって、すごいものを作ってるの。でも彼に会うたび何を考えているのか分からないのよね。う～ん、分からない…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "ノエルについて…",
      "text": "ノエル？彼女はとても粘り強いんだ。先輩として、彼女の面倒も見てあげないとね。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "エウルアについて…",
      "text": "エウルアはわたしの友達だよ！彼女の冗談に慣れれば、いい人だってことが分かるはず！エウルアは自分の名前のせいで、誤解されることが多いの。どうすればみんなに分かってもらえるのかな…"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "コレイについて…",
      "text": "コレイからの手紙でね、「魔鱗病」が完治したことを知らせてくれたんだ…本当にうれしいよ！今すぐにでも飛んで行って、ぎゅっと抱きしめてあげたい。あの子、モンドのみんなにすごく会いたいって手紙に書いててね。いつか一人前になったら、直接自分の成長を見せに来るんだって…次のバドルドー祭に間に合うといいな。もう、本当に待ち遠しいよ！"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "ミカについて…",
      "text": "あっ！ミカはエウルアの隊の古参隊員なんだ。最初はわたしがエウルアと仲がいいのを見たからか、わたしのことをずっと長官って呼んでたの。偵察の心得を話してあげたら、今度は先輩って呼ぶようになって…なんだかわたしのほうが恥ずかしくなっちゃったんだ…職務は違うけど、ミカの地図を作る腕は、わたしじゃ到底かなわないものだよ。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "アンバーを知る·1",
      "text": "狩りならわたしも得意だよ！どう？わたしの腕を見たくない？それとも…狩りで試合をする？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "アンバーを知る·2",
      "text": "飛行チャンピオンとしての経験則を教えてあげるよ！一番大切なものはね、勇気を持つことだよ！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "アンバーを知る·3",
      "text": "実は謎解きって得意じゃないの。バドルドー祭で謎解きの屋台を見つけても近づかないの…あんたはどう？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "アンバーを知る·4",
      "text": "わたしはおじいちゃんのために騎士団に入って、ジンさんのために団に残っているの。…そして今は、あんたがわたしにモンド以外の空を見せてくれた。とっても嬉しいよ。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "アンバーを知る·5",
      "text": "わたしはやっぱりもっと遠くの世界に行きたいな。大空の果てを見てみたいの！あんたもわたしについて来てくれるよね？そうでしょ？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "アンバーの趣味…",
      "text": "ウサギ伯爵、今日も素敵な一日だね！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "アンバーの悩み…",
      "text": "うーん…どうしたら美味しいムーンパイを作れるか知ってる？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "ジンさんの淹れてくれたコーヒーって本当にいい香りなんだよ！今度飲んでみてね。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "ググプラムのジュースじゃなければ…うっ…それ以外なら大丈夫！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "わぁ、これ本当に美味しいよ。さすが旅人だね！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "わたしも、あんたみたいな料理の腕があったらいいのになぁ…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "この味は、ちょっとわたしの口に合わないかも。ごめんね！別に旅人のせいじゃないよ！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "エヘヘ、誕生日おめでとう！ほら、これあげる。わたしが作った特製·ウサギ伯爵だよ……安心して、特製なんだから、爆発なんかしないよ！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "わぁっ！まるで風に乗った時みたいに体が軽い！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "このスピード、誰も追いつけないでしょ！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "モンドの空が狭くなったような…ううん、わたしの視野が広くなったのかな？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "今のわたし…知り合ったばかりの頃よりも成長したでしょ。えへへっ、ありがとね！そうだ、ニンジンとお肉のハニーソテーを奢ってあげる。さあ、行こうっ！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "頼んだわよ～"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "ウサギ伯爵、出撃！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "へんっふん～"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "百発百中！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "雨のような…矢を！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "もう逃げ道はないよ！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "ダッシュ開始·1",
      "text": "試合をしよ～"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "ダッシュ開始·2",
      "text": "ついてこれるかな？"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "ダッシュ終了·1",
