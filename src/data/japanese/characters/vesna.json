  "outfits": [
    {
      "id": 214300,
      "name": "冬契の春",
      "description": "ヴェスナの衣装。ヴェスナが冬契軍の制服に自ら少し手を加えて仕上げた。見た目がいいのはたしかだが、かなり値も張るため、ヴェスナが出した冬契軍全員の制服変更の申請は未だ通っていない…",
      "isDefault": true,
      "characterName": "ヴェスナ",
      "characterId": 10000143,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Vesna_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初めまして…",
      "text": "ごきげんよう、冬契軍司令官のヴェスナよ。祝砲も儀仗隊も準備万端だから、いつでも歓迎の儀を始められるわ。もちろん、派手な儀式が苦手なら、もっとこぢんまりしたのも用意しているから！ほらほら、ついてきて！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話・協力",
      "text": "冬契軍は女皇陛下にのみ従うの。だから、そう簡単に君に協力するわけにはいかないのよね。でも、風の精のヴェスナとしてなら、いつでも力を貸すわ。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話・喜び",
      "text": "この礼装、素敵でしょ？陛下から賜ったの。ほらほら、もっと見とれちゃってもいいのよ？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話・効率",
      "text": "書類仕事なら、とっくに終わらせたわ。大して時間もかからないしね。これからはずっと見回りの時間ってこと。さ、行きましょ。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "フェイだって風邪くらい引くわ。濡れたらちゃんと乾かさないと——あ、もちろん羽の話よ？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雪の日…",
      "text": "真っ白な雪原では、ほんの些細なカモフラージュのほころびが命取りになるわ。だから、足元には気をつけるのよ、うふふ。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "晴れの日…",
      "text": "言われなくても分かっているわ。太陽の下では、あたくしの羽がもっとも美しく輝くの。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "風の日…",
      "text": "いい風ね、風の精好みの天気だわ。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "砂漠にいる時…",
      "text": "その…スネージナヤにはいつ帰れるのかしら？いいえ、聞いてみただけよ…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "新しい一日の始まりね！今日もスネージナヤ・グラードに朝日が昇るわ！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "さあ、セラーガーデン・レストランに行きましょ！もちろん、今日もあたくしのおごりよ。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "コロレフスキー劇団で新しい演目が始まったの。ヴォジャニーツァの素晴らしい高音や、オデットの美しい舞いだけじゃなく…「新しいお友達」があたくしを待っているわ。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "ちょっと…もう寝ちゃうの？お散歩に行きましょうよ！ほら、オーロラが出ているわよ！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "ヴェスナ自身について・「魔法武器」",
      "text": "周りを飛んでいるこれは「魔法武器」よ。元素力にあたくしの意識を編み込んで作ったから、性格も似ているところがあるのよね。君に遊んでほしそうに絡んでくるかもしれないけれど、気にしないで。でも、できればかまってあげてね。うふふっ！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "ヴェスナ自身について・司令官",
      "text": "司令官の「威厳」ねぇ…ふふっ、そんなの、場を仕切れない人のためのものよ。あたくしには必要ないの。もちろん、君にもね。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "確かめたいことについて…",
      "text": "あたくしに関するいろんな噂の真偽を確かめたいんでしょ？うふふっ、ゆっくりで大丈夫よ。時間はたっぷりあるんだもの。でも、その代わりに君についても少しずつ「確かめ」させてもらうわよ。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "付き添うことについて…",
      "text": "「誰かに付き添う」っていう言い方、あまり好きじゃないのよね。ロマンチックに聞こえるけど、よくよく考えてみると…片方が主役で、もう片方が引き立て役みたいじゃない？\\nでも、足を踏み出すのは自分自身だし、その道のりで得るものはすべて自分だけのものでしょ。だから、あたくしは「君に付き添っている」わけじゃなくて、「君と共に歩んでいる」の。この感覚は、歩いている時にふと横を見たら…なんて偶然なの！同じ方向に向かっていたのね！って気づくようなものよ。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "「星の楔」について…",
      "text": "「星の楔」はすっごく綺麗だから、コレクションする価値があるわ。そうそう、「月の輪」の美しさにも惹かれるのよね。でも、「神の目」は…遠慮させていただくわ。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "これはあたくしの「古い相棒」よ。素敵でしょ？一族に代々伝わる代物で、あたくしよりもずっと年上の超骨董品と言っても過言じゃないわ。魔法の杖とか、教鞭とか、指揮棒として使っているんだけど…その、銀行の保管庫で埃を被らせるより、現役で使ったほうが、ご先祖様たちも喜んでくれるはずよ。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "フロストフラワーは極寒の地で生き抜く、美しくてたくましい花よ。模様もすごく独特で、目を細めながら頭を揺らして見ると、万華鏡のように幻想的な光景が広がるわ。でも、試すなら周りに誰もいない時にね。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "「女皇」陛下について・忠誠",
      "text": "これまで、愚かにも陛下に楯突こうとする連中を嫌というほど捕らえてきたの。彼らが語る大それた野望なんて、どれも吹けば飛ぶような絵空事だったわ。謀略を巡らせる頭脳も、事を成す器量もない…そんな「野心家」たちと比べれば…いいえ、撤回させて。彼らと陛下を比べるなんて、無礼にも程があるもの。\\n要するに、陛下に忠誠を誓うことは風の精一族の責務であり、このあたくし、ヴェスナ個人の意志でもあるということよ。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "「女皇」陛下について・慈愛",
      "text": "陛下が口にされる「慈愛」という言葉は、常に氷の棘をまとっているわ。陛下は、それは天理に強いられた呪いであって、本当の愛ではないとおっしゃるけれど…あたくしはそうは思わないわ。あたくしが魔獣の討伐から戻ると、いつも指示書の最後に「ゆっくり休むように」と一言添えてくださるもの。あたくしが生の執政の力を失った時も、うまく隠したつもりでいた落胆に気づかれて、残っていた力をあたくしに返してくださった…\\n本来、陛下がそこまであたくしたちを気にかけてくださる必要はないの。おこがましい考えかもしれないけれど、神に「愛」があるかどうかは、民が決めることだと思うの！だから、あたくしが決めてもいいはず…よね？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "ダニカについて・小さい頃",
      "text": "ダニカちゃんは今でこそあんなに落ち着いているけれど、小さい頃はあたくしと一緒に先生の仮面を外すことを企むような、やんちゃな子供だったのよ。二人で先生の肩によじ登ったこともあったんだから！まあ、その企みは結局失敗して、罰として凍った湖の上でずっと「気をつけ」をさせられたんだけど…って、そんな話はどうでもいいの！重要なのは、そのイタズラを思いついたのはあの子だってこと。遊ぶことに関しては、あたくしに負けず劣らずだったのに…それが今となっては、一日中まるで大人が子供に向けるような、呆れた目で見てくるのよ。まったくもう、あたくしのほうがお姉ちゃんだっていうのに。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "ダニカについて・口喧嘩",
      "text": "信頼できる情報筋によると、「口喧嘩大会」なんて訳の分からないイベントを開いて、騒ぐ群衆にまぎれて違法な取引をしようとしている輩がいるそうなの…これは見過ごすわけにはいかないでしょ。\\nというわけで、ダニカをエントリーしておいたわ。あの子は何食わぬ顔で相手の面目を潰して、弱みにつけこむのが得意だもの。一体誰なら言い負かせるっていうの？きっと、たっぷり時間を稼いでくれるはずよ。\\n頑張ってね、ダニカ！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "「隊長」について…",
      "text": "あたくしが記憶している先生の背中は、とっても大きくて頼りがいがあって、まるで山のようだったわ。その山が崩れるなんて…少なくともこんなに早くその日が来るなんて、思ってもみなかった。先生は「真の戦場では別れを告げる機会などない」とおっしゃっていたけれど、身をもって証明しなくたっていいじゃない。最後の機会くらい、残してくれてもよかったのに…\\nひどいわよ、先生。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "「道化」について…",
      "text": "この世界には、明日への希望を胸に、軽やかな足取りで未来へ歩む人たちがいる。その一方で、「道化」様は常に重々しい足取りで歩まれているわ。時折、あの方から先生に似た雰囲気を感じるのは、お二人とも想像を絶する悲しみを仮面の下に隠し、痛ましい過去を背負ってきたからなんでしょうね。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "「雄鶏」について…",
      "text": "皇都評議会で堂々と発言する市長の、終始余裕に満ちた振る舞いには本当に威厳を感じるわ。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "「富者」について…",
      "text": "冬契軍司令官の給料は決して安くはないけれど、好き放題にコレクションを買い集めたり、毎回食事をおごったりするには少し厳しいのよね…って、おごるお金がないわけじゃないわよ。物心ついた頃から、一族が受け継いできた遺産の運用を北国銀行に任せているんだけど、パンタローネさんのおかげで結構な額の利益を生んでいるの。だから負担に感じることはないし、次もあたくしにおごらせてちょうだい！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "「傀儡」について…",
      "text": "サンドローネの振る舞いはまさしく淑女って感じだけど、言葉遣いはとても攻撃的。でもその論理は揺るぎなくて、非の打ち所がないのよね…ふふっ、面白いわ。あたくしも見習わなくちゃ。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "ミティヤについて…",
      "text": "ミティヤとはしょっちゅう一緒に遊んでいるわ。彼はいつもオルジェイナヤ・パラタから抜け出す方法を考えついてくれるから、毎回三人で思いっきり楽しんでいるの！え？二人じゃないのかって？あたくし、ミティヤ、彼のお利口さんなマフラー。ほら、三人でしょ。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "ヴォジャニーツァについて…",
      "text": "ヴォジャニーツァの歌はどれも本当に素敵で、生で聴くのが大好きなの。劇場ではあたくしも他の観客と同じように、彼女の歌声で笑ったり、涙を流したりしているわ。たまに、公演が終わった後もみんながその場に残って、大合唱が始まることもあるのよ。偶然にもあたくしは手頃な指揮棒を持っているから、それで指揮をするの。それに何度か、衣装を着替えて帽子を被ったヴォジャニーツァがこっそり紛れ込んで、一緒にコーラスを歌っていたこともあったわね。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "オデットについて…",
      "text": "オデットが朝の会議に出席するたびに、つい何度も横目で見てしまうの。だって、彼女はファデュイの一員であると同時に、もう一つ「特別」な肩書を持っているんだもの。気にするなっていうほうが無理な話…え？もちろん、コロレフスキー劇団のプリンシパルのことよ？他に何があるっていうの？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "アリョーシャについて…",
      "text": "ええ、気持ちはよく分かるわ。犬なんだもの、「轟く」強風の中で舞う美しい蝶を見かけたら、追いかけずにはいられないわよね。でも、それはそれとして…ダニカの朝食をこっそりトゥガリンにあげて、アリョーシャからもよく言ってもらおうかしら。顔を見るなりあたくしを追いかけ回さないようにって。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "ヴェスナを知る・1",
      "text": "ふふっ、どうやってあたくしのことを知るつもりなの？まさか、ただおしゃべりするだけじゃないでしょ？それじゃつまらないわ…「ホントかウソか大冒険」みたいなゲームをするのはどうかしら？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "ヴェスナを知る・2",
      "text": "冬契軍は女皇陛下直属の親衛部隊よ。魔獣の討伐や戦争への参加といった軍務だけじゃなく、女皇陛下の権威と名誉に関わるすべての任務を担当するの。陛下の命に従い、行く手を阻むあらゆる障害を排除するのが、あたくしたちの務めってわけね。\\nもっとも、天理に抗うという偉業を成し遂げるまでは、どうしても陛下の手が回らないこともあるわ。だから、テープカットや晩餐会への出席のようなオイシイ仕事…コホン、雑事は、あたくしが積極的に引き受けているの。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "ヴェスナを知る・3",
      "text": "あたくしはいろんなものをコレクションしているの。ジュエリーに古書に油絵に…あたくしを幸せにしてくれるなら、どんなものでもコレクションに値するわ。そして、欲しくなったらすぐに手に入れないと気が済まないの。ほら、「スプーンは昼食時にこそ価値を帯びる」って言うでしょ？一瞬の心のときめきを逃してしまうと、後から手に入れても嬉しさは半減しちゃうわ。だから、今欲しいものは、今手に入れるべきなのよ。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "ヴェスナを知る・4",
      "text": "モノマフ皇帝が崩御した後、スネージナヤは動乱の時代を経験したわ。その時、あたくしのご先祖様は強い意志を持って女皇陛下のおそばに仕えることを選んだの。なら、その先人たちの意志を受け継ぐあたくしは、彼ら以上に陛下に貢献できているのか、って？ふふん、君の疑問なんてお見通しよ。さあ、今度は君があたくしの答えを代わりに言う番よ。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "ヴェスナを知る・5",
      "text": "死の執政と対峙する前日の夜、あたくしは多くの人から「生の印」を取り出したわ。素敵な思い出の定義は、みんなそれぞれ違っていて——家族と暖炉を囲んで、たわいもないおしゃべりの時間を大切にする人もいれば、列車の窓際に座って見上げた、夜空に静かに流れるオーロラを忘れられない人もいた。ソリを引いて氷上釣りに出かけるだけで心が満たされるって人もいたっけ…\\nそんな思い出たちは、まるでカラフルなシャボン玉のように、熱く輝く「生命力」を帯びていて——ああ、生きているって本当に素晴らしいって思ったわ。\\nそれなのに、天空の存在ときたら、何も言わずにそのシャボン玉を簡単に壊してしまうなんて。一体、何様のつもりなのかしら…\\nあの瞬間から、あたくしが天理に抗う理由は、陛下のためだけではなくなったの。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "ヴェスナの趣味…",
      "text": "幼い頃から、あたくしには絵画、ダンス、声楽の先生がついていたわ。少し大きくなってからは、フェンシングや馬術なんかも始めて…最近は、歌劇や公演の鑑賞や、ちょっとしたコレクションの収集に夢中になっているの。とにかく、あたくしの生活に「退屈」の二文字は存在しないのよ。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "ヴェスナの悩み…",
      "text": "ダニカの言うことなんて信じちゃダメよ。あたくしの運転技術は決して悪くないの…いわば「人車一体」といったところね。運転禁止令が解けたら、乗せてあげるわ！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物…",
      "text": "こんなに寒い日は、みんなで温かいスープを飲んで、まったりするのが一番ね！あたくしがみんなに声をかけるから、君とパイモンは適当に食材を用意してくれるかしら！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "うふふ…嫌いな野菜は、ぜーんぶダニカのお皿にポイっと！…うぅ、全部返されちゃったわ…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る・1",
      "text": "それじゃあ、遠慮なく！美味しいものは全部、お腹の中にコレクションしちゃうんだから。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る・2",
      "text": "へぇ…面白い工夫で仕上げているのね…なるほど…もう一口…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る・3",
      "text": "ご、ごちそうさま！もうお腹いっぱいだから、残りは持ち帰ってダニカにあげるわね！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "パンパカパーン！ついにこの日が来たのね！昨日、あたくしがどれだけ必死に我慢していたか分かる？フライングで祝福の言葉を口にしたら、吹雪に呑み込まれちゃうんだから！これでようやく言えるわね——誕生日おめでとう！君が白樺のようにたくましく、いつまでも吹雪に負けませんように。\\nさて！それじゃあスネージナヤの習わしに従って、本日の主役の耳を引っ張らせてもらうわね！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想・起",
      "text": "新兵訓練第一課。吹雪に屈せぬ忍耐力を持つ者のみが、陛下のおそばに仕える資格を得る。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想・承",
      "text": "新兵訓練第二課。剣を握る手を震わせてはならない。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想・転",
      "text": "新兵訓練第三課。敵に涙を見せることなかれ。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想・結",
      "text": "君に教わった心得もあるわ——ほんの少しの穏やかさは手放さず、吹雪を耐え抜いた後には、己の守るべき者を抱きしめよ…ってね。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル・1",
      "text": "整列。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル・2",
      "text": "敬礼。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル・3",
      "text": "剣を掲げて。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素スキル・4",
      "text": "ちょっと失礼～"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素スキル・5",
      "text": "まだ終わりじゃないわよ！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素スキル・6",
      "text": "心からの敬意を。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発・1",
      "text": "遊んであげるわ！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発・2",
      "text": "そこね！逃がさないわよ！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発・3",
      "text": "女皇陛下に捧げましょう——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "宝箱を開ける・1",
      "text": "うふふ、新しいコレクションゲットよ！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "宝箱を開ける・2",
      "text": "あなたの分と、あたくしの分と、陛下の分と、あたくしの分！これで決まりね！ダニカの分はなしよ、ふふん。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "宝箱を開ける・3",
      "text": "こっちこっち！あったわよ！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "HP低下・1",
      "text": "司令官が戦場を離れるわけにはいかないわ。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "HP低下・2",
      "text": "心配しないで、ちゃんと避けてみせるから。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "HP低下・3",
      "text": "くっ…ここから巻き返すわよ。"
    },
    {
