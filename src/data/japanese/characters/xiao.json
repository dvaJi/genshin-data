  "outfits": [
    {
      "id": 202600,
      "name": "千年の歳月",
      "description": "魈の衣装。幾千年もの間、魔物を鎮めてきた戦闘服。",
      "isDefault": true,
      "characterName": "魈",
      "characterId": 10000026,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xiao_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初めまして…",
      "text": "王難、賊難、火難、水難、羅刹難、茶枳尼鬼難、毒薬難の際は我が名を呼びたまえ。\\n「三眼五顕仙人」——「魈」、召喚に応じ参上。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "世間話·暇",
      "text": "こんな風に暇を持て余すことになるとは…笑えるな。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "世間話·彷徨う魂",
      "text": "荒野に彷徨う魂、我を傷つけられると思うな。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "世間話·侵食",
      "text": "グルルルッ——！フン、嫌なことを思い出してしまった。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨の日…",
      "text": "魔物は雨だからって休んだりしない。行くぞ。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨上がり…",
      "text": "晴れた？…我は天気など気にしないぞ。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雷の日…",
      "text": "雷を恐れる凡人は結構いる…我には理解できない。珍しくもなんともないことじゃないか。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "雪の日…",
      "text": "雪が積もったら、それを握って食えるな…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "おはよう…",
      "text": "そろそろ出発するぞ。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "こんにちは…",
      "text": "昼餉か…望舒旅館に戻るぞ。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "こんばんは…",
      "text": "夜とは…不吉なものが最も活発になる時間だ。出かけないほうがいいぞ。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "おやすみ…",
      "text": "行ってくるといい、我はここでお前を待っている。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "魈自身について·人間ではない",
      "text": "我は人間ではない、人間の感情はあまり理解できない。"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "魈自身について·璃月",
      "text": "近頃の璃月の変化はあまりにも早い…まぁいい、慣れるつもりもないからな。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "警告について…",
      "text": "いつか、お前まで闇に墜ちる時が来たら、その時は我が——"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "信頼について…",
      "text": "穢されるな、その時我は手加減しないぞ。\\n…無論、「お前」なら、揺るぎはしないだろうが。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "眠たさについて…",
      "text": "っ！？誰だ！…ん？我が立ったまま寝てたと？仙人を愚弄するか！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "海灯祭について…",
      "text": "海灯祭？また凡人が光るゴミを海に流す時期か…なぜこうも稚拙なのか。\\nただ、お前が退屈しているというのなら、付き合ってやらんこともないぞ。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "「神の目」について·欲望",
      "text": "「神の目」、欲望？ふんっ、凡人の基準で仙人を測るな。我に欲望などない。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "「神の目」について·理由",
      "text": "隠すつもりはないが、欲望を他人に教えるべきではない。\\n人間も願い事を他人に教えたら叶わなくなるという習わしがあるじゃないか…ん？全然違う？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "シェアしたいこと…",
      "text": "…殺戮は我の専門分野だ。お前が殺せない時、我を呼ぶといい。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "興味のあること…",
      "text": "荻花洲、かつて一度荒れ果てた地だ。\\nそれは数年前…いや、数百年前のことだがな。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "鍾離について…",
      "text": "うむ…質問だが、鍾離様は普段何を…ん？鳥の散歩？花見？骨董鑑賞？\\nそんなことして、一体どんな深意が…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "北斗について…",
      "text": "北斗か？彼女とは特に交流はないが、冥海の巨獣の件は事実だろう。「海山」を倒したその実力は認めている。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "白朮について…",
      "text": "…痛みを和らげる薬を白朮に頼んで作ってもらうと？ははっ…気持ちはありがたいが、凡人の薬は仙人には効かんのだ。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "胡桃について…",
      "text": "胡桃？あやつは困るほど元気だな。幸い、彼女は面白いから、つまらない人間になる心配はなさそうだが。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "ウェンティについて…",
      "text": "ウェンティ…？なるほど、ウェンティと言うのだな。彼の奏でる曲は…いや、なんでもない。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "甘雨について…",
      "text": "甘雨は仙獣でも凡人でもない、仙と人間の世界を渡り歩き、己が責務を頼りに自我を保っている、それ故迷うのも当然だ。…我？殺戮と生きることしか知らない夜叉が瑞獣を導けと？…馬鹿げた話だな。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "申鶴について…",
      "text": "申鶴はかなりお前を信頼しているようだな。それもそのはず。何せお前のようにお人よしで温かい者はそういない。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "夜蘭について…",
      "text": "千岩軍が層岩巨淵に残した痕跡を、そいつは一人で調査したと聞いた。単独で真相を追い求めるとは、腕の立つ人物なのだろう。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "魈を知る·1",
      "text": "お前のことは我が守る。\\nが…我に近づくな。我の邪魔はするな。でないと、後悔するぞ。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "魈を知る·2",
      "text": "この千年もの間、我は幾万の魂を狩ってきた。面倒事に巻き込まれたくないなら、我から離れろ。我を「道具」のように扱うがよい。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "魈を知る·3",
      "text": "「それら」の声は…よく我の耳元で聞こえる。咆哮、号泣…殺せと叫んでいる…\\n…これは我の選択、そして報いだ。お前とは関係ない。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "魈を知る·4",
      "text": "モラクス…？その名について、どれほど知っている？\\n彼は我に「魈」という名を与え、我を長い苦しみから解放した方だ。\\n彼に不敬なことをしたら、たとえお前でも許さない。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "魈を知る·5",
      "text": "もう遅い。我らの繋がりは過密になりすぎた。お前が諦めたくとも、もう間に合わない。ん？考えたことがない？\\n…はぁ、「靖妖儺舞」、我の戦いは止まらん。\\nだが、お前のことはもっと知りたいと思っている。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "魈の趣味…",
      "text": "我に趣味を聞いてくるとは、なかなかの度胸だ。\\n戦ってみるといい。お前の体は、我の攻撃に耐えられるかな？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "魈の悩み…",
      "text": "悩み？フン、その質問は仙人にとって何の意味もないぞ。千年も存在する悩みなどない。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "好きな食べ物·杏仁豆腐",
      "text": "人間の食べ物に興味はない。料理の過程が複雑で、待つ時間が長いからだ。しかし、杏仁豆腐だけ、食えなくもない。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "好きな食べ物·思い出",
      "text": "杏仁豆腐の味は、かつての「夢」とよく似ている。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "嫌いな食べ物…",
      "text": "小麦粉の生地に肉を入れてほしいと？…それから、一緒に食べると？ふんっ、面倒だ。今の人間はますます常識に欠けるのだな。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "贈り物を受け取る·1",
      "text": "うむ、悪くない…ん？なぜ我をじっと見ている。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "贈り物を受け取る·2",
      "text": "もう充分だ。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "贈り物を受け取る·3",
      "text": "次は別のものを作るといい。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "誕生日…",
      "text": "誕生日…人間の記念日などくだらない。…コホン、待ってろ。アオギリの葉で蝶を作ってやる。\\nああ、やる。これは仙法だから魔除けにも期待できるぞ。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破した感想·起",
      "text": "この程度、驚くほどではない。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破した感想·承",
      "text": "新たな力？この力も、殺すことにしか使えない。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破した感想·転",
      "text": "力の果ては自滅だ。答えろ、なぜそこまで執着するのか…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破した感想·結",
      "text": "我の槍纓は、無数の魂を屠ってきた。我自身も、闇に飲まれてしまった。\\n——お前はそんな我を怖がらずに、我を…「仲間」だと思っている。\\n…お前は我を救いたいのか？…理解できぬ生き物だな。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素スキル·1",
      "text": "フン。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素スキル·2",
      "text": "くだらない。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素スキル·3",
      "text": "無駄だ。"
    },
    {
      "id": "110001",
      "type": 2,
      "title": "落下攻撃·1",
      "text": "ここだ！"
    },
    {
      "id": "110002",
      "type": 2,
      "title": "落下攻撃·2",
      "text": "無能。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆発·1",
      "text": "消えろ。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆発·2",
      "text": "靖妖儺舞。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆発·3",
      "text": "喚くがいい。"
    },
    {
      "id": "300001",
