  "constellations": [
    {
      "_id": 741,
      "id": "fortress_of_fantasy",
      "name": "果てなき夢の領土",
      "description": "<span style=\"color:#FFD780FF\">垂裳凛然の夜</span>の安眠天幕シールドのダメージ吸収量+20%。<br/>また、垂裳凛然の夜を発動する際、安眠天幕シールド状態ではない周囲のチーム全員にダメージを吸収するシールドを生成する。ダメージ吸収量は安眠天幕シールドの35%分、継続時間12秒、<span style=\"color:#99FFFFFF\">氷元素ダメージ</span>に対しては250%の吸収効果を持つ。",
      "level": 1
    },
    {
      "_id": 742,
      "id": "lights_remit",
      "name": "便りと共に還る星影",
      "description": "<span style=\"color:#FFD780FF\">垂裳凛然の夜</span>が発射した飛星が敵に命中すると、レイラの元素エネルギーを1ポイント回復させる。この方法を通して、各飛星はレイラの元素エネルギーを最大で1回のみ回復できる。",
      "level": 2
    },
