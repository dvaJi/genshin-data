  "outfits": [
    {
      "id": 202000,
      "name": "Libertad salvaje",
      "description": "Modelo de vestimenta de Razor. Sencillo y muy cómodo para correr por la naturaleza.",
      "isDefault": true,
      "characterName": "Razor",
      "characterId": 10000020,
