      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Hola...",
      "text": "Tú... oler bien. ¡Nosotros cazar juntos!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Charla - Olor",
      "text": "Humm... Oler a conejo."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Charla - Hambre",
      "text": "¿Vamos? Tener hambre."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Charla - Contemplación de tormentas",
      "text": "Yo vigilar. Si tú irte, avísame."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Cuando truena - Aviso",
      "text": "Si tener miedo, escóndete."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Cuando truena - Guía",
      "text": "Cuidado con árboles. ¡Sígueme!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Cuando hace viento...",
      "text": "Viento... Humm... Qué gusto."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Hace mucho viento...",
      "text": "Mucho viento... Duele."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Buenos días...",
      "text": "Sol salió. ¿Quieres cazar?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Buenas tardes...",
      "text": "Hoy comer mucho. ¡Me gusta carne! ¡Qué feliz!"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Buenas noches... (I)",
      "text": "Tú dormir, yo mirar la luna."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Buenas noches... (II)",
      "text": "Tú dormir, yo vigilar. Mañana nosotros cazar."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Sobre Razor...",
      "text": "Yo ser un lobo. No tener papá humano o mamá humana."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Sobre nosotros - Amigos",
      "text": "#Tú ser mi amig{F#a}{M#o}. Yo cazar contigo."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Sobre nosotros - Armas",
      "text": "Mis garras ser de hierro y mis colmillos, de trueno. Yo te protejo."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Sobre la Visión...",
      "text": "Visión me ayuda y me da colmillos de trueno para proteger lupical."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "¿Algo que decir?",
      "text": "Estrellas muy hermosas por la noche. Se ven en cielo y lagos, y también en ciudad."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Un dato curioso...",
      "text": "Los lobos ser mi lupical, mi familia."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Sobre Lisa...",
      "text": "Sus rayos hacen oscuro el cielo. Es fuerte, pero dar miedo."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Sobre Bárbara...",
      "text": "Bárbara ser buena chica. Muy buena."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Sobre Diluc...",
      "text": "Diluc ser rojo y negro, frío y caliente."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Sobre Venti...",
      "text": "No entender poemas, pero a lupical gustarle."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Sobre Bennett...",
      "text": "Bennett... hablar mucho. Cuando comer con él, nunca me lleno."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Sobre Klee...",
      "text": "¡Klee, mi amiga! Ella mi amiga, pero meterse mucho en líos."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Sobre Varka - Desconocido",
      "text": "¿Varka? ¿Qué es?"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "Sobre Varka - Recuerdos",
      "text": "Ah, Varka es... nombre. Ese hombre alto me da mi nombre y “garra de hierro”. Quiero verlo."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Más sobre Razor (I)",
      "text": "Hueles a... persona buena. ¿Te gusta carne?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Más sobre Razor (II)",
      "text": "Tú muy fuerte, como lobos. Me gusta cazar con tú. Cazamos mucho."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Más sobre Razor (III)",
      "text": "Lupical es “casa de los lobos”. No, es “familia de lobos”. Mi lupical está en bosque. Ellos protegerme, por eso yo ser su lupical."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Más sobre Razor (IV)",
      "text": "Lupical, mi única familia. Yo ser lupical, pero no tener cuatro patas. No ser lobo de verdad. Por eso, a veces yo triste."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Más sobre Razor (V)",
      "text": "#Yo muy contento cuando correr y cazar con tú. No ser lobo, no ser humano, yo ser yo.\\nTú mi amig{F#a}{M#o}, tú también mi lupical. Quiero que tú feliz, ¿sí?"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Aficiones de Razor...",
      "text": "#Me gusta lupical. Me gusta bosque. Me gusta mi amig{F#a}{M#o}. Me gusta correr."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Preocupaciones de Razor...",
      "text": "Hablar ser cansado y difícil, pero hablar ser necesario."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Comida que más le gusta...",
      "text": "Me gusta carne y papas."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Comida que menos le gusta...",
      "text": "Verdura saber mal. Yo comer animal que come verdura."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Al recibir un regalo (I)",
      "text": "Oler bien y saber bien. Me gusta."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Al recibir un regalo (II)",
      "text": "Comerlo darme fuerzas y estar feliz."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Al recibir un regalo (III)",
      "text": "Comer, no bueno. No comer, no bueno. Razor triste..."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Cumpleaños...",
      "text": "Hoy ser tu... día que naciste hace muchas, muchas lunas. Hoy yo hacerte feliz. ¿Comemos carne?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "El sentimiento de Ascensión - Introducción",
      "text": "Mis brazos... más grandes ahora."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "El sentimiento de Ascensión - Desarrollo",
      "text": "Garras y colmillos más afilados. ¡Yo más fuerte!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "El sentimiento de Ascensión - Nudo",
      "text": "Correr... Cazar... ¡No! ¡Yo quiero más fuerte!"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "El sentimiento de Ascensión - Desenlace",
      "text": "Colmillos, garras y piernas más fuertes ahora. ¡Yo protejo a ti!"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Habilidad Elemental (I)",
      "text": "¡Atrás!"
    },
    {
