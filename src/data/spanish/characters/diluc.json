      "title": "Habilidad Definitiva (I)",
      "text": "El veredicto es..."
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Habilidad Definitiva (II)",
      "text": "¡Arde!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Habilidad Definitiva (III)",
      "text": "¡Hora del... castigo!"
    },
    {
      "id": "200010",
      "type": 2,
      "title": "Habilidad Definitiva (I)",
      "text": "¡Fuego purgador!"
    },
    {
      "id": "200011",
      "type": 2,
      "title": "Habilidad Definitiva (II)",
      "text": "¡Asolaré el mal!"
    },
    {
      "id": "200012",
      "type": 2,
      "title": "Habilidad Definitiva (III)",
      "text": "¡Aquí llega el amanecer!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Al abrir un cofre (I)",
      "text": "¡Hum! Menos da una piedra."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Al abrir un cofre (II)",
      "text": "Supongo que esto me servirá."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Al abrir un cofre (III)",
      "text": "Necesitaremos más de eso."
    },
    {
      "id": "410001",
      "type": 2,
      "title": "Vida baja (I)",
      "text": "¿Eso es todo lo que puedes hacer?"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "Vida baja (II)",
      "text": "Maldición..."
    },
    {
      "id": "410003",
      "type": 2,
      "title": "Vida baja (III)",
      "text": "¡Pagarás por eso!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "Aliado con vida baja (I)",
      "text": "¡Cuidado!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "Aliado con vida baja (II)",
      "text": "¡No te agotes! ¡Retírate!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "Derrotado (I)",
      "text": "¿En qué me equivoqué?..."
    },
    {
      "id": "500002",
      "type": 2,
      "title": "Derrotado (II)",
      "text": "No hay excusas... para la derrota."
    },
    {
      "id": "500003",
      "type": 2,
      "title": "Derrotado (III)",
      "text": "Mis llamas... se han extinguido..."
    },
    {
      "id": "910001",
      "type": 2,
      "title": "Recibiendo un fuerte ataque (I)",
      "text": "¡Ah!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "Unirse al equipo (I)",
      "text": "Vamos."
    },
    {
      "id": "600002",
      "type": 2,
      "title": "Unirse al equipo (II)",
      "text": "¿Cuál es nuestro objetivo?"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "Unirse al equipo (III)",
