  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Presentazione",
      "text": "Diluc, di Mondstadt. Non mi interessano le chiacchiere inutili. Se vuoi fare qualcosa, fammelo sapere."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Dialogo: Relax",
      "text": "Immagino che possiamo riposare un po'."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Dialogo: Cavalieri di Favonius",
      "text": "Dovresti davvero portare con te i Cavalieri di Favonius, la prossima volta."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Dialogo: Gilda dei viticoltori",
      "text": "Ho ancora molto da fare alla Gilda, che ne dici di riposarti finché non torno?"
    },
    {
      "id": "1106",
      "type": 1,
      "title": "Dialogo: Preparazione",
      "text": "Dovremmo prepararci finché possiamo, e poi lanciare un attacco preventivo al nemico."
    },
    {
      "id": "1107",
      "type": 1,
      "title": "Dialogo: Pianificazione",
      "text": "Prendiamoci un attimo per riposare e pianificare la nostra prossima mossa."
    },
    {
      "id": "1108",
      "type": 1,
      "title": "Dialogo: Avvertimento",
      "text": "Ogni piano d'azione ha i suoi rischi. Fa' attenzione."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Quando piove: Ombrello",
      "text": "Non ho bisogno di un ombrello, ma tu puoi usarne uno se ti serve."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Quando piove: Purificazione",
      "text": "La pioggia... Se solo potesse purificare le anime corrotte di questo mondo."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Quando spunta il sole",
      "text": "Ascolta, finché resti sulla tua strada, non importa cosa ti mette di fronte Madre Natura."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Quando soffia il vento",
      "text": "C'è chi usa l'ululato del vento per soffocare il suono dei propri crimini."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Buongiorno",
      "text": "#Non c'è bisogno di chiacchiere, l'unica cosa che conta è che ieri sera sei stat{F#a}{M#o} al sicuro."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Buon pomeriggio",
      "text": "Vuoi provare il menù segreto?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Buonasera",
      "text": "È scesa la notte."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Buonanotte",
      "text": "Va bene, a presto. Mi assicurerò che tu possa andare via in tutta sicurezza."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "A proposito di Diluc",
      "text": "La leggenda sul cosiddetto \"Eroe oscuro\"? È una voce interessante."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "A proposito di noi: Necessità",
      "text": "Se hai bisogno di qualcosa, dillo. Per i rimborsi, chiedi a Elzer."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "A proposito di noi: Prove",
      "text": "Hai già dimostrato la tua determinazione. Bene, è ora che tu sia testimone della mia."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "A proposito della Visione",
      "text": "Le Visioni sono una luce nel mare di tenebre che circonda chi ha perso la strada. Per chi ha fede, però, sono poco più che simboli della propria convinzione."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Qualcosa da condividere",
      "text": "Di tanto in tanto lavoro al bar del Dono dell'Angelo. La taverna è nota per essere il centro dell'informazione di Mondstadt."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Curiosità",
      "text": "Cosa? Perché lo chiedi? È un gufo che osserva tranquillamente la sua preda dall'oscurità, aspettando il momento perfetto per colpire... Impeccabile."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "A proposito di Kaeya",
      "text": "Kaeya? Al massimo puoi fidarti della metà di quello che dice...."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "A proposito di Lisa",
      "text": "Credo che Lisa abbia il potenziale per diventare la più affidabile dei cavalieri, se troverà la voglia."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "A proposito di Jean: Nemici",
      "text": "Le questioni insignificanti possono diventare il più grande nemico di Jean."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "A proposito di Jean: Responsabilità",
      "text": "Il suo impareggiabile senso di responsabilità è l'unica ragione per cui non ha ancora trovato la sua vera vocazione."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "A proposito di Mona",
      "text": "La terra di Mondstadt, per grazia dell'Archon di Anemo, è generosa. A cosa servono quindi le previsioni di raccolto degli astrologi?"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "A proposito di Diona",
      "text": "L'atteggiamento di Diona nei miei confronti è... come dire... piuttosto rigido. Devo ancora riuscire a parlarle come si deve. Non sono sicuro se abbia un problema con la mia famiglia o... Eh? Dici di no? Disprezza semplicemente l'alcol? Ah... Non avrei mai pensato d'incontrare una collega barista che la pensa come me, a Mondstadt."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "A proposito di Varka",
      "text": "Il Gran Maestro Varka... Comprendo la sua indole, ma non riesco a dare un senso alle sue azioni... Ho già parlato troppo. Ho lasciato da tempo i Cavalieri di Favonius. Dimentica quello che ho detto."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "A proposito di Eula",
      "text": "Ah, sì... Ho sentito parlare di lei. Ha le sue convinzioni. La sua determinazione a liberarsi dalle catene del suo clan è lodevole. Ma... si è unita ai Cavalieri di Favonius."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Altro su Diluc (1)",
      "text": "Hai degli affari di cui occuparti?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Altro su Diluc (2)",
      "text": "Eh? Cavalieri di Favonius? Non ho niente da dire su di loro. Abbiamo opinioni diverse, tutto qui."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Altro su Diluc (3)",
      "text": "È da molto tempo che non gioco a scacchi con qualcuno, a parte il mio maggiordomo. Ho un momento libero, ti va una partita?"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Altro su Diluc (4)",
      "text": "Scacco matto! Beh, era da un po' che qualcuno non mi metteva così duramente alla prova."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Altro su Diluc (5)",
      "text": "Non male. Che si tratti di scacchi o di combattimento, mi sorprendi sempre. Mmm, lavorare con te è una bella novità. Quindi... non vedo l'ora di continuare."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Gli hobby di Diluc",
      "text": "Le opere d'arte nella tenuta? Non sono mie, è una collezione che apparteneva a mio padre."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "I guai di Diluc",
      "text": "L'oscurità ribolle di malvagità, piena di demoni da sconfiggere... Ci vorrà più di una lama per squarciarla."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Cibo preferito",
      "text": "Vuoi sapere cosa c'è nel mio bicchiere? È... succo d'uva. La mia bevanda preferita."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Cibo meno amato",
      "text": "Non bevo alcol. È solo che... non mi piace la sensazione che lascia in bocca..."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Ricevere un regalo (1)",
      "text": "Squisito. Sapori indimenticabili."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Ricevere un regalo (2)",
      "text": "Si sente che hai cucinato con passione. Un piatto davvero raffinato."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Ricevere un regalo (3)",
      "text": "Ehm... Grazie."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Compleanno",
      "text": "Buon compleanno. Questo è un giorno importante per te. Hai qualche desiderio? Se è in mio potere, prenderò in considerazione l'idea di concedertelo."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Pensieri sull'ascensione: Introduzione",
      "text": "Il potere è necessario per raggiungere i nostri obiettivi."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Pensieri sull'ascensione: Crescendo",
      "text": "Cosa ci aspetta? Raramente mi fermo a pensarci.\\nNon importa cosa provi a ostacolare il mio cammino, devo andare avanti."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Pensieri sull'ascensione: Culmine",
      "text": "Sono diventato più forte... Anche se non è ancora abbastanza, non smetterò di affrontare le tenebre.\\nAffinché sorga l'alba, qualcuno deve perforare il buio con la sua luce."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Pensieri sull'ascensione: Conclusione",
      "text": "Una volta credevo che per estirpare il male avrei dovuto camminare da solo nelle tenebre. Tuttavia, vedendo la tua perseveranza, ho capito che mi sbagliavo. Devo ringraziarti."
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Abilità elementale (1)",
      "text": "Bah."
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Abilità elementale (2)",
      "text": "Ah!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Abilità elementale (3)",
      "text": "Ahah!"
    },
    {
      "id": "100010",
      "type": 2,
      "title": "Abilità elementale (1)",
      "text": "Uh!"
    },
    {
      "id": "100011",
      "type": 2,
      "title": "Abilità elementale (2)",
      "text": "Yah!"
    },
    {
      "id": "100012",
      "type": 2,
      "title": "Abilità elementale (3)",
      "text": "Ahah!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Tripudio elementale (1)",
      "text": "Ti dichiaro..."
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Tripudio elementale (2)",
      "text": "Brucia!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Tripudio elementale (3)",
      "text": "È il momento... della punizione!"
    },
    {
      "id": "200010",
      "type": 2,
      "title": "Tripudio elementale (1)",
      "text": "Che le fiamme ti purifichino!"
    },
    {
      "id": "200011",
      "type": 2,
      "title": "Tripudio elementale (2)",
      "text": "Annienta i malvagi!"
    },
    {
      "id": "200012",
      "type": 2,
      "title": "Tripudio elementale (3)",
      "text": "Alba, sprigionati!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Apertura baule (1)",
      "text": "Uff, meglio di niente."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Apertura baule (2)",
      "text": "Suppongo che possa andare."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Apertura baule (3)",
      "text": "Ce ne serviranno altri."
    },
    {
      "id": "410001",
      "type": 2,
      "title": "PS bassi (1)",
      "text": "Tutto qui?"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "PS bassi (2)",
      "text": "Accidenti a te!"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "PS bassi (3)",
      "text": "Pagherai per questo!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "PS bassi alleato (1)",
      "text": "Fai attenzione!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "PS bassi alleato (2)",
      "text": "Occhio a non scottarti! Ritirati!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "Fuori combattimento (1)",
      "text": "Dove ho sbagliato?"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "Fuori combattimento (2)",
      "text": "Non c'è scusa... per la sconfitta..."
    },
    {
      "id": "500003",
      "type": 2,
      "title": "Fuori combattimento (3)",
      "text": "La mia fiamma... è stata... spenta..."
    },
    {
      "id": "910001",
      "type": 2,
      "title": "Danni da colpo pesante (1)",
      "text": "Argh!"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "Unione al gruppo (1)",
