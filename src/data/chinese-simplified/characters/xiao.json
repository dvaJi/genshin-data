  "outfits": [
    {
      "id": 202600,
      "name": "千秋竞岁",
      "description": "魈的装扮款式。千年间降妖除魔的经典战袍。",
      "isDefault": true,
      "characterName": "魈",
      "characterId": 10000026,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xiao_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "如遇失道旷野之难，路遭贼人之难，水火刀兵之难，鬼神药毒之难，恶兽毒虫之难，冤家恶人之难，便呼我名。\\n「三眼五显仙人」——「魈」，听召前来守护。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·闲散",
      "text": "我居然沦落到如此闲散的地步，可笑。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·荒魂",
      "text": "荒野上的孤魂，休想伤我分毫。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·侵蚀",
      "text": "…呃啊…哼，想起了一些不愉快的事。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "魔物不会因为下雨就休息。我们走。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "天晴了？哼，我不关心天气。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的时候…",
      "text": "不少凡人害怕打雷。无法理解，这分明很寻常。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候…",
      "text": "雪积起来之后，就可以挖着吃了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "时候不早了。出发吧。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午餐…回望舒客栈吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "夜晚，不祥之物最易骚动。你最好别出门。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "你去吧，我会在这里等你。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于魈自己·非人",
      "text": "我并非人类，不太能够理解人类的感情。"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "关于魈自己·璃月",
      "text": "近来璃月变化得过于迅速了…呵，罢了，我也没打算适应。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·警示",
      "text": "如果有一天，连你也陷入了黑暗。就由我来——"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·信任",
      "text": "别被污染，我不会留情的。\\n…我是说，既然是「你」，「你」应该能够保持坚定。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·犯困",
      "text": "…谁！？…你觉得我是站着睡着了？哼，不敬仙师！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于我们·海灯节",
      "text": "海灯节？哼，原来又到了凡人用发光垃圾塞满璃月港的时候了，唉，为何如此幼稚。\\n不过你若无聊，我便陪你去。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」·欲望",
      "text": "「神之眼」、欲望？呵…不要用凡人的标准来揣测仙人，我没有欲望。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "关于「神之眼」·理由",
      "text": "并不是有意隐瞒。我的欲望，不应对外人讲。\\n人间不是有着愿望说出口就会失效的规矩…呃，不是一回事？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "杀戮是我的强项。如果你下不去手，就叫我来。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "荻花洲，曾经一度荒芜。\\n虽然，是过去好多年…不，好几百年的事了。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于钟离…",
      "text": "嗯…打听一下。请问钟离大人平日里都在…呃，遛鸟？赏花？品鉴古玩？\\n…钟离大人做这些，是有什么深意…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于北斗…",
      "text": "北斗吗？我与她没有什么交情。不过，冥海巨兽确有其事。能够将「海山」击败，作为人类，她的实力值得肯定。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于白术…",
      "text": "你想…托付白术研制缓解我痛苦的药物？呵…你的好意我心领了。凡人的药物，对仙人是无法起效的。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于胡桃…",
      "text": "胡桃？那孩子，活泼到令人头疼。所幸她还算风趣，不必担心会成长为无趣的人类。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于温迪…",
      "text": "温迪…？原来如此，名字叫作温迪啊。他演奏的曲调…不，没什么。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于甘雨…",
      "text": "甘雨既非仙兽，又非凡人，游走于仙人两界，靠着职责支撑自我，困惑是免不了的。...你说，我？呵，要让只懂杀戮与生存之道的夜叉，去开导瑞兽？天方夜谭。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于申鹤…",
      "text": "申鹤似乎对你颇为信赖。…也是。毕竟，世间难得几人能有你这般的善心与热忱。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于夜兰…",
      "text": "我听说她曾调查千岩军在层岩巨渊的相关痕迹。孤身追查秘密，想来也是有点本事的人。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解魈·其一",
      "text": "我会为你护法。\\n但是…别靠近我，别妨碍我。否则，你会后悔的。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解魈·其二",
      "text": "在这千年以来，我猎杀过数以万计的怨魂。不想惹上麻烦，就离我远点。把我当作「工具」就好。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解魈·其三",
      "text": "「它们」的声音…常常在我的耳边出现。咆哮、号哭…嘶喊着杀戮…\\n这是我自己的选择和自己的报应。与你无关。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解魈·其四",
      "text": "摩拉克斯？关于这个名字，你究竟知道多少？\\n他是赐予我「魈」之名之人，将我从漫长的痛苦中解放。\\n胆敢对他不敬的话。即使是你，我也不会原谅。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解魈·其五",
      "text": "已经迟了。我们之间的关联已经太多了。即使你想要放弃，也来不及了吧。嗯？没有这样想过？\\n…「靖妖傩舞」，我的战斗是不会停下的。\\n但是，关于你的事情，我想了解更多。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "魈的爱好…",
      "text": "你还真是胆量不小，有勇气询问我的爱好。\\n那便来战吧。以你的身躯，扛得住我几招呢？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "魈的烦恼…",
      "text": "烦恼？呵…这个问题对仙人毫无意义，没有什么烦恼能够存在千年。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物·杏仁豆腐",
      "text": "我对人间的食物并无兴致。烹饪繁琐，等待漫长。唯独杏仁豆腐，勉强可以入口。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "喜欢的食物·回忆",
      "text": "杏仁豆腐的味道，和「美梦」非常相似呢。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "要我亲手在薄饼中包入肉片？啊…然后…一起吃下去？呵…麻烦。如今的人间，真是越来越缺乏常识了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "嗯，不错…为什么要盯着我看。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "不用麻烦。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "下次做点别的吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "诞生的时日…人类的这些纪念，真是冗余。嗯…等着。我给你折一只梧桐树叶蝴蝶。\\n好了，拿去吧。这是仙法，可以辟邪。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "只是这种程度而已。没什么值得大惊小怪的。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "新的力量？这力量，也只会被用于斩杀。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "力量的尽头，是自我毁灭。回答我，为何如此执着呢？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我的枪缨，早就屠戮了无尽的怨魂。连我本人，不免也被黑暗吞噬。——你却敢于驱使这样的我，将我当作…「同伴」。\\n…你是想要救赎我吗？…你，真是难以理解的生物。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "哼。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "无聊。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "无用。"
    },
    {
      "id": "110001",
      "type": 2,
      "title": "下落攻击·其一",
      "text": "这里！"
    },
    {
      "id": "110002",
      "type": 2,
      "title": "下落攻击·其二",
      "text": "无能。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "就此消失。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "靖妖傩舞。"
