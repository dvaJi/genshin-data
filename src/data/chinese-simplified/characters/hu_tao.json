  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "唷，找本堂主有何贵干呀？嗯？你不知道吗，往生堂第七十七代堂主就是胡桃我啦！嘶，不过瞧你的模样，容光焕发，身体健康，嗯…想必是为了工作以外的事来找我，对吧？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·往生堂",
      "text": "不如去我那儿喝杯茶？嘿~"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·客户",
      "text": "一个客户，两个客户，三个客户…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·偷懒",
      "text": "咳咳…太阳出来我晒太阳，月亮出来我晒月亮咯~"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "哎呀…麻烦喽。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "打雷啦，起身啦。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "哇，是雪！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "嗯，真舒服。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "欸？…唉，帽子都要吹飞了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "嗯~早起身体好，晚睡人会飘。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "哟！中午好呀，吃了吗？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "嘻嘻，月亮出来喽~咱也出门吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "哦，困了吗？那你好好休息，我一个人四处转转。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于胡桃自己·名字",
      "text": "胡桃的胡是胡吃海喝的胡，胡桃的桃却不是淘气的淘！嘿嘿…不、不好笑吗？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于胡桃自己·拿手好戏",
      "text": "变个戏法给你看，瞧好了哦…火！然后…嚯！火蝴蝶！呼，飞啦——哈哈。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·好奇心",
      "text": "你到处旅行，一定见多识广。有空也给我讲讲你自己的故事吧。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·夜晚",
      "text": "白天你尽管到处跑，晚上可得小心点。我不在的时候，务必谨慎行动。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于我们·帮手",
      "text": "需要帮手吗？需要帮手吗？我来啦！若你需要帮助，胡桃我定当全力以赴，绝不推辞。"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "关于我们·战斗",
      "text": "战斗是件麻烦事，对我来说，它不是目的而是手段。用手段来达到目的，用战斗来维护不愿让步的东西。就这方面而言，我和你是一样的。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」…「神之眼」？唔，这东西，随缘就好。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "受人之托，忠人之事。我们往生堂性质特殊，肩负着双倍责任，所以，一定要让两个世界的人都满意才行。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "有些花草只长在阴气重月光多的地方，你见过吗？没有？那下次带你见识见识。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于钟离…",
      "text": "钟离长得那么年轻，性格倒像是个老古董，什么都懂，却什么都不关心，他该不会…？嘻嘻…\\n唉，算了，随他去吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于七七…",
      "text": "看到七七了吗？快告诉我她在哪，我要把她藏起来，嘿！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于白术…",
      "text": "白术？哼，麻烦的家伙。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于凝光…",
      "text": "天权凝光，富甲一方；明眸善睐，桃羞杏让；目达耳通，百了千当！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于北斗…",
      "text": "北斗姐可是璃月名人，她不认识我没关系，我认识她就行。啊~真想和她交个朋友啊。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于行秋…",
      "text": "听说行秋少爷在写书？话本还是怪谈呢？好想把平日遇见的杂事说给他听，写成书一定很好看吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于重云…",
      "text": "纯阳正气，阴阳合一？啧啧，嘶…没想到世上真有这种体质的人。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于魈…",
      "text": "仙家的事，我怎么知道？哎呀呀，天机不可泄露。你就别问我啦。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于刻晴…",
      "text": "「玉衡」刻晴啊，嘶…是个很难打交道的人呢。嘿嘿，瞧那一本正经的样子，真想逗逗她。哎呦，她应该不会用剑敲我头吧？不会的吧？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于香菱…",
      "text": "香菱可好玩了，一碰就跳，特别容易被唬住。做我们这行，最喜欢这种人喽。不过也得注意分寸，毕竟，锅巴会替香菱出头呢。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于云堇…",
      "text": "云堇她在正式场合很优雅，私底下却非常容易亲近哦！上次我跟她打了个赌，输的人要用自己习惯的唱法唱对方填的词。哎呀呀，戏腔版的丘丘谣，你真该听一次！"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于申鹤…",
      "text": "她可真是个有意思的人呐，跟别人都不一样。你说，要是我从现在开始天天吃仙草、喝山露，会不会也变成她那么不染红尘的样子？嘿嘿…"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于蓝砚…",
      "text": "蓝姑娘啊…她实力不俗，可不仅仅是「皮毛」这么简单。奇门秘术可真了不得，病气死气都被搬走啦。哎呀，可谓是——世风日上，身强力壮，往生堂的生意越来越难做喽。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解胡桃·其一",
      "text": "大丘丘病了，二丘丘瞧；三丘丘采药，四丘丘熬；五丘丘死了，六丘丘抬~\\n欸…呼。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解胡桃·其二",
      "text": "小巷派暗黑打油诗人，正是本人！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解胡桃·其三",
      "text": "若要我说，往生堂的工作既不困难也不可怕，只是麻烦而已。可惜旁人理解不了，见到咱们夜里出工，总是有些惧怕。唉，是他们不懂啊。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解胡桃·其四",
      "text": "我是「往生堂」第七十七代堂主，我爷爷是第七十五代。我经手的第一份工作，就是替爷爷办葬礼。是不是很意外啊？哎呀，不知不觉就在这行做了好些年，时间过得可真快。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解胡桃·其五",
      "text": "阴阳有序，命运无常。死亡难以预测，却也有它的规矩。记住了，无论何时何地，无论有何原因，人都不该轻易挑衅「死」之一事。唯有认识它、尊重它，才能明白活着的价值。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "胡桃的爱好…",
      "text": "天清海阔，皓月凌空，此情此景，正适合作诗一首。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "胡桃的烦恼…",
      "text": "唉…真想找些新乐子，无所事事比死亡可怕多了。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "♪啦啦啦啦~吃水煮鱼配虾饺啦~"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "清心炒史莱姆凝液…呕…这是香菱对我的复仇吗？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "甚好甚好。本堂主现在就来为这道菜肴题诗一首——"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "真不用我来帮忙吗？做一道送一道哦！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "噫…这是什么东西呀？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "今夜天星璀璨，月相壮丽，想必是个好日子。嘶，待我一算…嗯~我知道我知道，是你的生辰！哎呀，真是个好日子。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哦呀？哦呀呀？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "嗯~真不错，谢啦。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "没想到没想到，胡桃我现在力如泉涌，心似雄鹰，非常有自信哦。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "力量若达到极限，接着考验的便是人心。多亏了你，我才能来到这片未曾踏足的领域。在这里，心和灵魂就像一片云彩…生老病死，天地万象，尽在吾辈。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "喝！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "起！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "散！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "吃饱喝饱，一路走好！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "再会啦！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "蝶火燎原！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "嚯——！"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "冲刺开始·其二",
      "text": "走~"
    },
    {
      "id": "700003",
      "type": 2,
      "title": "冲刺开始·其三",
      "text": "咻~"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "打开风之翼·其一",
      "text": "顺风顺水~"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "撞大运咯！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "让我看看，都有什么好东西。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "快埋进土里，等它长出好多宝箱！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "哎哟哎哟！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "噫——！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "糟糕！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "悠着点！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "放着我来！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "到我了吗…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我记…仇…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "呃啊——"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "干嘛呀！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "哦？该我出马了？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "你很有眼光嘛！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "一波送走，全送走。"
    }
  ]
}