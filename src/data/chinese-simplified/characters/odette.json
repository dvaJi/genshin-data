  "outfits": [
    {
      "id": 215000,
      "name": "雪鹄之舞",
      "description": "奥黛塔的装扮款式。制作精良的芭蕾服装，以雪鹄为灵感来源，伴着勤恳的芭蕾舞者度过无数长夜。其上珠宝总在舞台灯光下折射出静雅的辉光，一如剔透的舞者本人。",
      "isDefault": true,
      "characterName": "奥黛塔",
      "characterId": 10000150,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Odette_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "…谢谢你的支持，签名的后面需要什么图案？一片羽毛可以吗？噢，不是粉丝。看来是我误会了。重新自我介绍一下，奥黛塔，至冬科洛列夫茨基剧团的芭蕾舞者…依旧谢谢你的支持。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·忙碌",
      "text": "如果没有别的事情的话，我先去练习舞蹈了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·简单",
      "text": "能简单回应的事情，不需要长篇大论。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·时间",
      "text": "时间能变成双倍…不，三倍就好了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "雨滴落下时淅淅沥沥的声音总能让我感到平静，这样的天气很适合独自练舞。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "平静而美好的时刻总是短暂的。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候…",
      "text": "至冬的雪，向来冷得刺骨，又永无尽头。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "发型…等一下再重新梳理吧。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "…还好不会在这种地方开见面会。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "我已经热身完毕，随时可以行动。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "我不需要午睡，午后这种不适合训练的时间，我通常会看看舞剧剧本。嗯？你问这些信纸吗？是沃雅妮莎塞给我的粉丝来信，她要我好好看完。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚饭时间到了吗？等下就要登台，吃一个煮鸡蛋就够了，等今晚演出全部结束之后，再随便吃点吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "…任务完成，训练量达标，新舞蹈也练习完毕。表情管理有些不足，还需要再对着镜子调整一下…已经到这个时间了吗？你先休息吧，我还有安排。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于奥黛塔自己·呼啸社",
      "text": "严冬计划推行后，来剧院看演出的观众越来越少了。大家的生活已经跌入困境，更有危害民众的蛀虫，对此我无法无动于衷。我知道仅凭一己之力无法扭转局势，但我仍想做一些力所能及的事情。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于奥黛塔自己·记性",
      "text": "以前的记忆一直烙印在脑海中，在夜深人静的时候，像映影一样反复播放…记性太好不是好事。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·寄托",
      "text": "来自他人的保护就像刚刚凝结而成的薄冰一样，是十分脆弱的东西，我不会把希望寄托在别人身上。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·伤口",
      "text": "我对痛觉的感受很迟钝，等我察觉伤口时，伤口已经结痂了。这样也好。无论是练习舞蹈还是接受愚人众特训，都不会因为身体状况耽误我的日程。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「星之楔」…",
      "text": "以前，在一次训练中，极寒冻伤了我的腿脚，让我近乎失去知觉，最后是在「星之楔」散发出的亮光中醒来的。不过从没有听说「星之楔」能将人唤醒的传闻，当时醒来是因为…我本能地想要活下去吗…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "每一次彩排，我都会当作正式演出一样认真对待。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "有些冰醋栗吃起来不够甜，只要撒一些细盐，就会变得香甜好吃了。据说是有了咸味的衬托，甜味就会被放大。一位粉丝告诉我的。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于罗莎琳·曾经",
      "text": "罗莎琳有恩于我，但我也一度憎恨着她。她的要求非常严苛，在她手下训练的那段时间，挨冻、累倒、受伤与生病都是常有的事情。曾经我天真地想，只要我能独立站上舞台，靠跳芭蕾舞也能养活自己和母亲了，我就离开愚人众给她看。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于罗莎琳·燃珀",
      "text": "人不在了，很多话就失去了说出口的意义。「燃珀」砸碎起来是那么容易，却让误会和伤痛显得更加讽刺…为什么事到如今，我们才能互相理解呢？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于「女皇」陛下…",
      "text": "「女皇」陛下是全至冬的信仰，她事务繁忙，鲜少露面。我能见到她的次数寥寥无几，她十分庄重威严，她的目光不管落在哪里，都像是万年不化的冰雪一般冰冷但坚定。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于「少女」大人…",
      "text": "她走路的姿态好像一片羽毛在飘起飘落。任何一位舞者都会羡慕这份轻盈。沃雅妮莎也曾和我聊起过她空灵的歌声。但我们看到与羡慕的，都是她「台前」的模样，我们并不了解真实的她心中是否背负着不为人知的痛苦，不是吗？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于「仆人」大人…",
      "text": "壁炉之家的孩子们都将「仆人」大人视为「父亲」。有父亲庇佑的孩子，成长路上总归会少些冰雪风雨。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于「木偶」大人…",
      "text": "从前罗莎琳参加完「木偶」大人的茶会，心情都会变得比平时更好——虽然要求依旧严苛，但语气明显缓和了许多，任何人都能察觉出来。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于沃雅妮莎·微笑",
      "text": "第一次「女皇」陛下要来科洛列夫茨基剧团看我们演出的时候，沃雅妮莎提前把这个消息告诉了我，我回答说嗯。结果她伸出食指把我的嘴角提了上去，硬是制造出一个微笑，还要我跟着她一起念：「太、好、了！」\\n我依然不觉得「女皇」陛下喜欢看到那样的笑容。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于沃雅妮莎·看病",
      "text": "沃雅妮莎生病的时候总会缠着我，让我陪着她一起…理由是万一需要打针或者吃苦药的话，她会很害怕的，所以想要紧紧抓住我的胳膊。我的痛觉很不明显，自然也不会甩开她。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于阿罗夏…",
      "text": "身为猎户养活自己并不难，但他还是经常来剧院打零工，为了援助那些受苦的人们…我并不奇怪他会加入呼啸社。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于米提亚…",
      "text": "这位…「粉丝」先生，他经常来剧院观看我和沃雅妮莎的表演。但每次表演开始，他都在低着头写些什么，在一众翘首看向舞台的观众中很是醒目。或许他的围巾比他更懂得欣赏演出。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于瓦列里…",
      "text": "瓦列里少校，一位有着严格时间观念的愚人众军官，听说他总用一种冷静且骇人的态度为同僚安排工作。但我们所属不同所以鲜有交集，而且…我该做的事情并不需要任何人提醒。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于薇斯纳…",
      "text": "别因为她有对翅膀，就把她当成华丽无害的蝴蝶，那个受人簇拥的家伙是冬契军的总司令，冰雪之中的猎食者。你要擦亮眼睛，别被热情的笑容骗了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解奥黛塔·其一",
      "text": "我的日程安排比较紧凑，等会儿还有训练。请见谅。要聊天的话，我们长话短说。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解奥黛塔·其二",
      "text": "我的母亲出自芭蕾世家，父亲曾效力愚人众，他们因一次演出而结缘，那是一段能让任何听者都露出笑容的浪漫往事。幼时，母亲会带我一起轻盈地跳舞，父亲会给我买漂亮的新舞裙。我唯一的烦恼是每天到底要从糖果罐子里选择哪一块。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解奥黛塔·其三",
      "text": "后来父亲因公殉职的噩耗传来，母亲悲痛欲绝，在演出时摔断了腿。糖果罐子里所有的糖都洒了出去，而我被关在了那里面。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解奥黛塔·其四",
      "text": "再后来的事情，你也知道了。这些回忆被我咀嚼了太多次，已经不会再伤害到我了。但对抗命运过程中获得的力量，却是属于我自己的。我不会忘记这一点。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解奥黛塔·其五",
      "text": "我不想对任何粉丝说这些，好在你不是。我的身份已经太多了，任何一面最好都保持其应有的剔透…我会向着我心中的完美舞下去。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "奥黛塔的爱好…",
      "text": "从始至终我都很喜欢芭蕾，我会竭尽全力在这个舞台上为观众带来我能跳出的最好的舞蹈。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "奥黛塔的烦恼…",
      "text": "说实话我一直觉得自己不太受小动物欢迎。剧院周围经常有小猫出没，沃雅妮莎会拉着我一起去喂它，我一走过去，小猫就开始磨爪子…嗯？你说那是欢迎我的意思吗？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "餐厅快打烊时，会半价出售当天的沙拉，从前有段时间经常吃这个。放久了的沙拉味道当然比不上新鲜的，但因为口感实在熟悉，反倒让人安心。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "从我个人喜好上来说，并没有难以下咽的食物。但作为芭蕾舞者，必须在饮食上保持克制，每日饮食计划外的食物是不推荐吃的。所以我不吃。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "这几天演出比较多，或许…不，没什么。谢谢你，这个很美味。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "一道菜？更像…一整天的食物。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "抱歉，我在控制体重。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐。不知道你想要怎样的生日礼物？我收到的总是鲜花、舞鞋与音乐盒。但我猜那并不是你的愿望。不如你向我许愿吧，只要是我能实现的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "还欠缺了一些什么…再加点训练量好了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "嗯，动作更加精准了。保持这样的训练量。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "现在我有信心能够完美地完成鞭转了。不过训练量不能减。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "「情感也是芭蕾舞不可欠缺的一部分。」现在我能理解它的含义了，谢谢你一直以来的陪伴和支持，今天有我的演出，这是门票。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "开始了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "冰中雪影。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "起。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "共舞时刻。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "旋转。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "呵。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "冰封的旋律。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "镂冰履凌。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "献上，雪鹄的礼赞。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "我不需要这些，你收好。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "旅途就像练习，每一步都算数。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "努力的成果。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不足为意。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "区区小伤。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我还可以。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你还好吗？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "换人吧。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "是我不够努力…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "不行，要站起来才对…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "原来，还能感到疼痛…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "…嗯？"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "然后呢？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "就这吗？"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "不痛不痒。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "我准备好了。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "是特邀演出吗？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "这次去哪里？"
    }
  ]
}