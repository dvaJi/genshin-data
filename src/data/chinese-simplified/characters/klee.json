  "outfits": [
    {
      "id": 202901,
      "name": "琪花星烛",
      "description": "可莉出演关键剧目时所穿的精致服装，色彩明丽，如同点缀着奶油花朵和明红蜡烛的蛋糕，能将快乐与笑容带往冒险所至的每个角落。",
      "isDefault": false,
      "characterName": "可莉",
      "characterId": 10000029,
      "source": [],
      "filename_card": "UI_AvatarIcon_KleeCostumeWitch_Card",
