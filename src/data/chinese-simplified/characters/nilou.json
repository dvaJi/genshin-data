  "outfits": [
    {
      "id": 207001,
      "name": "莎邦之息",
      "description": "妮露的典雅服饰，千花编织般的轻盈裙装，如有黎明时的东风捎来淡香，承载着童话世界的美好祝福。",
      "isDefault": false,
      "characterName": "妮露",
      "characterId": 10000070,
      "source": [],
      "filename_card": "UI_AvatarIcon_NilouCostumeFairy_Card",
      "filename_icon": "UI_AvatarIcon_NilouCostumeFairy",
      "filename_iconCircle": "UI_AvatarIcon_NilouCostumeFairy_Circle",
      "filename_splash": "UI_Costume_NilouCostumeFairy",
      "filename_sideIcon": "UI_AvatarIcon_Side_NilouCostumeFairy"
    },
    {
      "id": 207000,
      "name": "非花非雾",
      "description": "妮露的装扮款式。既非花也非雾，她身着舞衣飞旋时却有如花开雾起。",
      "isDefault": true,
      "characterName": "妮露",
      "characterId": 10000070,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Nilou_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "你好，我是来自祖拜尔剧场的妮露。今天上演的剧目是这一支舞。请你不要眨眼哦，要开始了——"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·练习",
      "text": "先这样…下一个动作是…这样吧，嗯…嗯！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·困意",
      "text": "深呼吸，吹一个大大的气球，把困意放进气球里，呼——气球飞走吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·休息",
      "text": "这样清闲的日子倒也不错嘛，优哉游哉。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "天气和心情一样，有时候会变得阴沉沉的，但是不用着急，雨后的天空会更加澄澈。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "雷声有点恐怖呢，你会害怕吗？我可以分享你一个神奇的方法哦。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "欸？哇——下雪了。你听，下雪的簌簌声，加上旋转着的雪花，像不像自然的精灵在跳舞？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "阳光明媚的日子…晒得暖洋洋的。唔，会犯困…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "你还好吗？小心风沙哦。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好哦。欸？你盯着我看是…哦头、头发翘起来了吗？啊，先别看我，唔，我马上整理好。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "唔…嗯…中午吃饼好呢，还是吃饭呢…要不吃豆泥吧？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好，今晚我在祖拜尔剧场有演出。给你两张剧票吧？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "睡前把烦恼全部都倾诉掉，会睡得比较香哦。如果你愿意，我很乐意当你的听众。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于妮露自己·肢体语言",
      "text": "有时候，舞蹈比语言更能传达出心情，不知道该说什么好的时候，就跳舞吧。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于妮露自己·舞蹈与知识",
      "text": "探究知识需要很高很高的天赋，很多人拼了命地努力，结果劳累又沮丧…但跳舞就不一样了，就算看不懂门道，也能看个热闹。要是能从这份肢体动作中品味到艺术的美丽与价值，那我就更开心了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·缓解生气",
      "text": "你会生闷气吗？嗯，生闷气是不好的。来，跟着我做。先在身前用右手画一个大大的圆，然后，双手把讨厌的事都从胸口里取出来，放在圆里。接着，用力地推出去！怎么样，心情好起来了吗？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·外出冒险",
      "text": "尽管我之前没离开过须弥城，但…我想和你一起去冒险。哦，到陌生的地方，我适应一下就好…唔，稻妻的沙滩下，真的不会有很大很大的沙虫，突然钻出来吗？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "我的神之眼是第一次登台跳舞时拿到的。我想，神明大人会成为我的观众，一定也认可了人类艺术的美丽之处吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "努力没有结果，也是很正常的。就像我不管怎么努力，也没办法理解明论派的知识。嗯，这个时候晃一晃脑袋，让大脑转个弯，换个方向就好了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻·晶蝶之舞",
      "text": "晶蝶有各种各样的颜色，很漂亮。当你实在按捺不住好奇心，悄悄伸出手的时候，它们就会一下子跳起优美而迅疾的舞步，离你远去。啊，我要是会飞的话，就能学会晶蝶之舞了。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感兴趣的见闻·帕蒂沙兰",
      "text": "花神大人跳舞的时候，真正的帕蒂沙兰会在她踏足过的地上盛开。…啊，听起来就非常美好，真想见一见这样的场景。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于赛诺…",
      "text": "教令院的人，我不太敢接触，毕竟他们对歌舞艺术的印象都不好。我常常会想，那他们会通过什么来解闷呢？呃…你说赛诺的话，会玩「七圣召唤」？真是不可思议呢。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于提纳里…",
      "text": "据说他是很厉害的植物学家。那他分辨蘑菇的本领肯定很厉害，至少不会吃到毒蘑菇…好羡慕呀。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于柯莱…",
      "text": "她偶尔会来看我的演出，是一位很热心的见习巡林员呢。她还提醒过我小心迷路，这是为什么呢？我也没有迷路过呀。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于卡维…",
      "text": "我听说是他建造了华美的艾尔卡萨扎莱宫，能建造出那样的作品，过程应该快乐又陶醉吧。就像我练舞的时候一样，只要一想到能跳给大家看，就充满了喜悦和动力呢。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于迪希雅…",
      "text": "最近发生了那么多事情，总觉得很不可思议。我原本想为迪希雅和迪娜泽黛挑选一些合适的礼物。但我自己拿不定主意，嗯…要是把大巴扎朋友们推荐的品种全送去，又太多了。哎呀，到底该怎么办才好呢？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于多莉…",
      "text": "出手阔绰的多莉大商人也曾看过我跳舞。我记得，有一次她和祖拜尔先生商量了什么事情，之后就再也没来过了。会是什么事情呢？嗯…呃？你是说她可能想带我进行一场提瓦特巡演？不会吧，祖拜尔先生肯定帮忙拒绝了吧…应该拒绝了吧…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于小吉祥草王…",
      "text": "大巴扎的大家都很喜欢小吉祥草王大人，好想听听她对我跳的花神之舞的评价呀…啊！不、不，还是算了算了。她真的来了，我肯定会紧张得不得了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解妮露·其一",
      "text": "唔——啊！抱歉，我在想等下去吃什么好呢？有点出神了…你需要帮忙吗？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解妮露·其二",
      "text": "我的老师教过我很多跳舞的要领，但她说，最重要的还是要把情感都投入到舞蹈里，因为这样才是最能打动人的。有所感，才能抒发。想要传达美丽的话，我就要成为美丽本身吧。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解妮露·其三",
      "text": "有时候我会收到观众们的来信，说他们因为我的舞蹈打起了精神。我会和祖拜尔剧场的大家共同分享这份快乐。虽然在观众眼里，我是在台前的那一个，但在我心中，这永远是靠所有人的努力才能取得的成果。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解妮露·其四",
      "text": "大巴扎有时候会有一些杂技表演，比如说不停抛起球来又不停接住。以前我也试过这个，但是不知道怎么回事就是接不住球，反而全掉头上了。当时祖拜尔先生他们都笑了起来。嗯…好像在他们眼里，我的身体协调能力应该特别强一样…暴露短处了呢。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解妮露·其五",
      "text": "以前有人说我就像是暖阳下的绿洲，让人感到治愈与温暖。我多多少少会高兴一下，但我的追求、我试图向大家呈现的价值不止在此。不过，和你相处久了我才知道，被人照顾和关怀是这样的感觉。现在…现在，我感觉那个比喻更适合你。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "妮露的爱好…",
      "text": "我的人生就是跳舞，跳舞就是我的人生…到底该说哪个才比较好呢？哎呀，我果然不适合思考这些太有逻辑的东西。总之，我会一直跳下去的。用我的表演，让这份艺术之美被更多人看见。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "妮露的烦恼…",
      "text": "我还是搞不懂哪些蘑菇有毒，哪些又没有…据说，颜色不管是鲜艳还是朴素的蘑菇，都有可能有毒。唔，好像明白了什么，又好像什么都没明白…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "甜食总能让人心情愉快，须弥大多数人都喜欢甜食哦！欸，你要不要也试试看？我可以给你一一介绍。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我有点难以接受菌菇那一类，主要是害怕。不是那种见到了想逃走的害怕啦。我…我是小时候误吃过毒蘑菇，在床上躺了好几天…如果你想尝一尝须弥的菌菇美食，要记得确保是无毒蘑菇哦。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "原来美食在舌尖起舞，指的就是这样的感觉…好神奇呀！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "谢谢你。就像我不断练习跳舞一样，这道菜肴，一定也凝结着你的心血吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "抱歉，可能是我最近胃口不太好，你别介意。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "那个…生日快乐！我最近学会了一支新的舞蹈，想要跳给你看。呃，你问我紧张吗？呼——被你看出来了呀。因为，想要融合心意与技巧，不知不觉编得越来越难…总之，希望美好与快乐能永远留在你身边。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "啊，这是什么感觉？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "身体舒展开了，能比以往发挥得更出色吧。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "我就像躺在一只大大的风史莱姆背上，好轻好轻。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我喜欢和你待在一起。嗯…我也不知道为什么，总感觉好像有蝴蝶要从胸腔飞出来一般…还是让我跳一支舞给你看吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "来了哟。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "准备跳喽。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "全力以赴。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "和浪花共舞吧。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "请看好了哦。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "这支舞，献给你。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "都给你。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "我来帮忙一起收吧。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "哇，是意外之喜。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "唔，不用担心我…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "真伤脑筋呀…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "得快点深呼吸…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "别急，我来了。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "请让我来抵挡一阵！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "还没来得及…谢幕…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "不能…继续跳舞了吗…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "美丽之物，不要远去…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "啊，要稳住平衡。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "有点…疼。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "今天要去哪里跳舞呢？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "有什么我能帮忙的吗？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "啊…是叫我吗？来啦。"
    }
  ]
}