  "passives": [
    {
      "id": "unstinting_succor",
      "name": "不吝佑助",
      "description": "迪希雅通过<span style=\"color:#FFD780FF\">熔铁流狱·剑域炽焰</span>或<span style=\"color:#FFD780FF\">炎啸狮子咬</span>回收净焰剑狱后的6秒内，迪希雅承担来自赤鬃之血的伤害时，受到的伤害降低60%。该效果每2秒至多触发一次。<br/>此外，迪希雅施放<span style=\"color:#FFD780FF\">熔铁流狱·净焰昂藏</span>后的9秒内，将为队伍中所有角色赋予「熔金铸躯」状态。处于熔金铸躯状态下的角色处于净焰剑狱领域中时，将获得额外的抗打断能力。每18秒至多产生一次熔金铸躯状态。",
      "level": 1
    },
    {
