    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "侦察骑士安柏，前来报到！今后有什么需要帮忙的，尽管说好啦！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·兴趣",
      "text": "好想跑一会儿步呀。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·挂念",
      "text": "要是被琴发现我们在偷懒，她会不高兴的。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·新发现",
      "text": "那边好像有什么奇怪的东西耶…不去看吗、不去看看吗？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候·担忧",
      "text": "下雨了…蝴蝶结会淋湿的…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雨的时候·提醒",
      "text": "下雨了啊…视野会有影响，要小心哦。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雨过天晴…",
      "text": "唔哇~天气真好。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "嗯…要是风大点就好了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起风的时候·惬意",
      "text": "真舒服呀…"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "起风的时候·放松",
      "text": "我喜欢这种天气，嗯…真轻松！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好哟！要不要一起晨跑？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "可以跟你一起吃午饭吗？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "天黑了，要我点个火把吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "没错，休息也很重要！那就说好了哦，明天见！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于安柏自己…",
      "text": "蒙德城的飞行冠军，就是我啦！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·比赛",
      "text": "就算是你，比赛我也不会放水！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·飞行",
      "text": "教你飞…与你一起飞行的时候，我自己好像也能飞得更快…欸，你在笑什么啊？来比赛吧！现在就比！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」，是神对我的认可吧。嗯，我要成为最优秀的侦察骑士才行！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "走嘛~去大教堂的钟楼上看看，风景超棒的！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "看，那里有鸽子！嗯…想跟它们一起飞呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于琴·帮忙",
      "text": "大团长出征之后，大大小小的事务都压在了琴的身上。如果我也能多帮到她一点就好了…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于琴·关怀",
      "text": "琴可能还在工作？…走，一起请她喝杯咖啡吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于丽莎·听故事",
      "text": "等你有空，我们一起去找丽莎吧！她上次和我讲了一个龙脊雪山宝藏的故事，只讲到一半。唔，我还想知道后续！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于丽莎·钦佩",
      "text": "丽莎好像除了睡觉的时间都在看书！真厉害啊，我就坐不住那么长时间。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于凯亚·忧虑",
      "text": "…有种不安的感觉！刚才是凯亚陪着你吧？他没给你添麻烦吧？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于凯亚·祸首",
      "text": "花圃里的蒲公英看上去蔫蔫的，哼…一定又是凯亚捣的鬼！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于班尼特…",
      "text": "嗯？班尼特…好像在哪里听过…哦！你说的是冒险家协会那个热血的男孩子啊！嗯，我有时会在秘境附近见到他，好像对寻宝很有热情呢。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于可莉…",
      "text": "可莉呀，偶尔会有点调皮，但骑士团的大家都很喜欢她！唔…为了不让她又被琴抓去关禁闭，还是看紧她一点吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "阿贝多，大多数时候都呆在自己的工坊里，捣鼓一些很厉害的东西。但是，见到他的时候，会有种猜不透他在想些什么的感觉。嗯，猜不透呢…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于诺艾尔…",
      "text": "你问诺艾尔吗？她的韧性可是很强的。作为前辈，你也要多照顾她一点哦。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于优菈…",
      "text": "优菈是我的好伙伴！只要习惯了优菈开的玩笑，你就会发现，其实她是很好相处的。只不过，优菈因为自己的姓氏，经常被很多人误解，怎么样才能让大家理解她呢…"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于柯莱…",
      "text": "柯莱和我写信说，她的「魔鳞病」已经彻底康复…我太为她高兴了！真想下一秒就飞到她身边，紧紧地抱住她。她还说很想念蒙德的大家，想等哪一天独当一面之后，亲口来汇报自己的成长…啊，要是能赶上下一次羽球节就好了，我都快等不及了！"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于米卡…",
      "text": "哦，米卡是优菈那儿的老队员了，最初可能是看我和优菈关系比较好吧，总是长官长官地叫我。在我跟他分享自己的侦察心得之后，他又改叫我前辈了…弄得我挺不好意思的。明明我们的职责不一样，他在绘制地图上的专业性，是我怎么都比不上的。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解安柏·其一",
      "text": "狩猎我也很擅长哦！怎么样，想不想看看我的身手？还是…要来个狩猎比赛？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解安柏·其二",
      "text": "和你分享我的飞行冠军经验吧！最重要的，就是要有勇气！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解安柏·其三",
      "text": "其实我不擅长解谜，羽球节里看到猜谜的摊位都要绕着走…你呢？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解安柏·其四",
      "text": "我因为爷爷才加入骑士团，因为琴留在了团里。现在，是你陪我见到了蒙德以外的天空。我真的很开心。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解安柏·其五",
      "text": "我还想去更远的世界。我想去看天空的尽头！你也会继续陪着我的，对吧、对吧？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "安柏的爱好…",
      "text": "兔兔伯爵，今天也是干干净净的一天！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "安柏的烦恼…",
      "text": "唔…你知道，怎样才能做出好吃的月亮派吗？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "琴泡的咖啡真的好香！有机会你要尝尝哦。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "只要不是冰钩钩果汁…唔…我都应付得来！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "哇，这个太好吃了。你真厉害！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "要是我也有这样的手艺就好了…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "我不太习惯这种味道，抱歉啦！不是你的问题！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "嘿嘿嘿，生日快乐！来，这个给你，是我亲手缝的「兔兔伯爵·特别定制版」…放心放心，是特别定制版哦，不会爆炸的！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哇！像乘着风一样轻快~"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "现在的速度，没有人能追得上了吧！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "蒙德的天空好像变小了…还是因为我的视野变大了？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我现在…比起最初跟你认识的时候，又进步了不少吧。嘿嘿，非常感谢！让我请你吃蜜酱胡萝卜煎肉吧，跟我来跟我来！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "靠你咯。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "兔兔伯爵，出击！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "♪哼哼~哼哼哼~"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "百发百中！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "箭如…雨下！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "你没有退路了！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "来比赛吧！"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "冲刺开始·其二",
      "text": "跟得上我吗？"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "冲刺结束·其一",
      "text": "说了你们跑不过我。"
    },
    {
      "id": "710002",
      "type": 2,
      "title": "冲刺结束·其二",
      "text": "就是这种感觉！"
    },
    {
      "id": "800001",
      "type": 2,
