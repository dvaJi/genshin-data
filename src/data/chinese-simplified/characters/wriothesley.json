  "outfits": [
    {
      "id": 208600,
      "name": "凛冬夜啸",
      "description": "莱欧斯利的装扮款式。彰显威严与力量感的衣装，粗犷的灰狼驳头链是他统领梅洛彼得堡的标志。",
      "isDefault": true,
      "characterName": "莱欧斯利",
      "characterId": 10000086,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Wriothesley_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你好，请尽量简洁地说明你的来意。嗯？不是公事？那我反而更紧张了。\\n坐下详谈吧。顺便一提，你可以称呼我「公爵」，他们都是这么叫的，我也听习惯了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·贴纸",
      "text": "如果看到我背后粘着美露莘画的贴纸，帮我揭掉吧？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·宠物",
      "text": "我曾经考虑过要不要在办公室里养宠物，但小猫小狗在不见阳光的地方生活太可怜了。还是算了吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·忠告",
      "text": "不要违法。还有什么需要叮嘱的吗？哦对了，不要违法。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "下雨了？还好。要是在梅洛彼得堡感到头顶滴水的话，问题可就大了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "心中无罪的人，在这种天气下也能安睡吧。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "嗯…和水下的冷不太一样。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "「太阳之下无新事」，但可以找个好地方野餐。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早。晨报上的天气预测怎么说？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "现在特许食堂人正多，我叫人送餐到办公室来吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "都这个时间了？总觉得才刚刚喝过下午茶。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。我要等会儿再睡，趁夜深人静正好算几笔账。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于莱欧斯利自己·误解",
      "text": "他们不是把我想得太神秘，就是太全能了。我只有一双眼睛、一对耳朵，怎么可能照顾到梅洛彼得堡的每一个角落呢。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于莱欧斯利自己·小憩",
      "text": "我早已服完刑，现在是自由公民，当然可以来水上闲逛。\\n不必担忧。要是梅洛彼得堡必须要我一直待在下面才能稳定运转，那也太不健康了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·收监",
      "text": "我对很多人的第一印象都是从收监登记表开始的，看来你也没能例外。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·出狱",
      "text": "都说没了利益牵扯才好做朋友，我们可以现在开始。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "我以前跟一些罪人学过借助化学药剂使用元素的方法。无论「神之眼」的发放归哪个部门管，他们似乎不是很介意这点僭越之举。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "知道怎么做更容易逃脱警备队的抓捕吗？给自己起个又长又难记的名字，然后他们在大喊「那个谁，把手举起来！」时就会卡壳。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "「不劳动者不得食」，这句话很久以前就刷在梅洛彼得堡墙上了。我也不知道是谁安排的，在水下的确很实用。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于那维莱特…",
      "text": "记得有次被那维莱特叫去上面谈事情，走到沫芒宫门口正好看到他在路边淋雨。我替他打了伞，他礼貌地道了谢，表情却不大自然。我大概是打扰到了什么吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "可能是因为我认罪太快，芙宁娜小姐在当年的审判中看起来兴致索然，早早就退场了。让水神大人失望可是大事，只好今后多给她送些好茶了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于希格雯…",
      "text": "希格雯护士长具备一名医护人员所需的全部美德，并关心着身边每一位同伴。\\n不过她似乎从我身上学走了一些坏习惯，比如时常和她的美露莘朋友们打赌，看谁能偷偷在我的东西上贴更多贴纸。不，我并不觉得困扰。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于克洛琳德…",
      "text": "克洛琳德应该是你能找到的最好的决斗代理人了，实力有目共睹。我从未和她比试过，没有那个必要。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于林尼…",
      "text": "我承认，拔除「壁炉之家」安插在水下的眼线是种挑衅。而他们的回应是只派几个孩子下来，的确令我有些难办。是真心觉得他们也可以被牺牲，还是看准了我不会对小孩下狠手呢…唉。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于娜维娅…",
      "text": "梅洛彼得堡和刺玫会有一些物资方面的合作，但仅限于此。并不是不信任娜维娅小姐或是质疑她的能力——实际上恰恰相反——只不过，我们之间水下水上的事务互不干涉是我与卡雷斯先生约好的规矩，维持不变就好。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于艾梅莉埃…",
      "text": "梅洛彼得堡应该用不上她的服务，有些痕迹就是作为「前车之鉴」被留下来的。…气味也是痕迹的一种，不是吗？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于夏沃蕾…",
      "text": "被特巡队关照过的犯人大多挺老实的，这位队长功不可没。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解莱欧斯利·其一",
      "text": "理论上来讲，完全不认识我的人会比较幸福。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解莱欧斯利·其二",
      "text": "身上的疤痕？曾有深海巨兽企图占领梅洛彼得堡，我和它搏斗时被抓伤了。…当然是假的，不要信。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解莱欧斯利·其三",
      "text": "你知道吗，手铐只要型号相近，大部分都能用通用的钥匙打开。只有我这副不一样。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解莱欧斯利·其四",
      "text": "我的个人能力其实很有限。你看，我既不会治病，也不会搞发明，更不会造大船。我只是知道该去哪里找人做这些事，而他们恰好愿意卖我这个面子而已。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解莱欧斯利·其五",
      "text": "我现在过上了还不错的生活，但也仍然羡慕一些我得不到的东西——比如安逸快乐的童年，和轻易信赖他人的能力。可能有人认为这很矛盾，或者难以启齿，我倒觉得没什么不好承认的——何必和自己的本心过不去呢？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "莱欧斯利的爱好…",
      "text": "拳击？不算是爱好吧，只是生活所需。你有什么其他推荐吗？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "莱欧斯利的烦恼…",
      "text": "我确实有着枫丹人的长相，但没法百分之百肯定——只能跳胎海水确认咯？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "喝咖啡时我习惯加奶，茶的话，两块糖就好了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "你喝过护士长做的奶昔吗？能从中尝出…「荒芜」的味道。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "完美的调味，我就不擅长这个。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "好吃。下次换我请客。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "等我去泡杯茶。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "枫丹的孩子是伴随着双亲的心愿与祝福诞生的，不过我愿意相信这世上的每一个人都是如此。和这个比起来，我的祝愿就有些微不足道了。\\n不，如果你犯事的话我是没办法帮你减刑的，只能在今天给你安排一份特殊的福利餐。所以生日期间还是安分一点，保证我们可以在水上庆祝，好吗？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "能获得你的信任，是我的荣幸。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "这下必须还你一个人情了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "哈，你怎么看起来比我要得意？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我喜欢力量和希望的信号，会让我感觉未来一切向好。这并非悲观，只是陈述事实，因为现实本就不可能一帆风顺。但有个好消息，就是当坏事发生时，我们可以站在同一阵线，对吧？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "开始吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "别跑啊。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "请留步。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "一路顺风。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "注意防寒。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "无需畏惧，直面罪责。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "没有锁吗？真方便啊。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "先收好吧，总能派上用场。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "无主之物最好归公…所以这里什么都没有，对吧？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不慌。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不叫增援？也行。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "见机行事。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "退后。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "去医务室。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "抱歉，没能守住…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "孤注一掷的后果…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我没有异议。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "这么客气？"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其一",
      "text": "…还可以。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "开工。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "请我出外勤？走。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "我尽力，但不保证赢。"
    }
  ]
}