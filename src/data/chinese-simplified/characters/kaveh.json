    {
      "_id": 10812,
      "id": "artistic_ingenuity",
      "name": "画则巧施",
      "description": "将「梅赫拉克」的测绘能量转为攻势用途，进行圆状扫描，造成<span style=\"color:#99FF88FF\">草元素范围伤害</span>，并使扫描范围内的所有草原核立即迸发。",
