  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "在下行秋，不过书海一蠹。某虽不才，仍愿为君略尽绵薄。难得有机会说这种风格的台词，感觉还不错。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·无人夜",
      "text": "「有时明月无人夜，独向昭潭制恶龙。」"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·文章",
      "text": "「衣裓贮文章，自言学雕虫。」"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·偷闲",
      "text": "正所谓「偷得浮生半日闲」，哈哈。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "闲聊·阅卷",
      "text": "如此如此，这般这般…欸？欲知后事如何，且听下回分解？唔…"
    },
    {
      "id": "1105",
      "type": 1,
      "title": "闲聊·新书",
      "text": "盘算着也该到「万文集舍」新进小说的日子了，不妨…我们顺道去看看？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "这么说来，我们家出品的锦缎伞，好像既不能遮阳也不能挡雨。唯一的用处就是挂在墙上。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "晴了就好，不然藏书会生霉的。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "只有这种天气的时候，我才会觉得家里比书店好。家里炭火很足，而书堆里就不准用火。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "练功的好…啊不，是看书的好时节啊。好啦，我脸上又没有写字，别一直盯着我看了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早啊。早上的时间这么难得，能做做自己喜欢的事情就好了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午饭有点不想吃米饭，想吃糕点。待在书斋吃，父亲和兄长就不知道了…嗯？想一起来吗？嗯…只要你不把碎屑沾到书上就行。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "去偷点萤火虫来看书，怎么样？唔，我的玩笑话你可别当真，对眼睛不好的。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "明天我也在老地方。只要你不中途迷了路，就准能找得到我。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于行秋自己…",
      "text": "在人前彬彬有礼，是因为大家见我是飞云商会的二少爷；在你面前能这么轻松，大概因为你看我的方式并不一样吧。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·书友",
      "text": "你算是我的书友吧。什么？打架？古华派？战友？…唔！你都在说些什么呢。不是说好这是我们两人间的秘密吗！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·结拜",
      "text": "我要和你结拜，就去绝云间的祭坛那边。不行，不能拒绝。你知道了我的底细，也就知道了一直被我掩饰着的真实的自己…我不能放你走。除非…你答应我不会撒手不干！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」·古书",
      "text": "「神之眼」的事情，虽然一般少有记载，但在我所收集的古书中却有一段特别的描述，待我找给你。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "关于「神之眼」·领悟",
      "text": "受书中启发，我领会到，枪术与剑术的本质，正是瞳术。唔，解释起来可能有点费力…如果你真想知道，就跟我去「王山厅」走一趟吧。事先声明，到时候你可不准笑。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "璃月非去不可的地方？这个问题很难回答，不过，如果消失了会让我很难过的地方…「万文集舍」稳排第一，「古华堂」能进前十吧。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "以前是兔子，后来是鹿。对我来说，「请从绝处，读我侠义」是舍弃一切的觉悟，鹿却是绝处逢得新生的希望。真想再见它一次啊。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于北斗…",
      "text": "北斗阁下是我非常敬重的人。不过希望她不要喊我「小子」，也不要一见面就揉我头发。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于凝光…",
      "text": "「天权」大人是我不得不敬重的人。不然会给家父以及家兄添麻烦。嗯？对她本人，我想想。嗯…还是算了，不说人坏话了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于重云…",
      "text": "唉，重云这家伙，虽然也知道我的底细，但真要和他搭档去完成任务还得审慎。他现在还是执着「武」技，却不理解「侠」心的境界。需要多练练。尤其…是吃辣的方面，哈哈。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于云堇…",
      "text": "云堇啊，她只要能喝到满意的饮品，就会有动力去创作新戏。我呢，就一直在床底下囤着一小罐茶叶，就是为了等哪天她兴致索然的时候给她送去。这样，我就有听不完的异侠传奇了！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于胡桃…",
      "text": "那个小姑娘，正是「往生堂」的当代堂主。嗯？问我怎样看待她的为人？…行事作风嘛，坊间传闻是作不了数的。真想了解一个人，还得看她真正想要的是什么。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于七七…",
      "text": "总感觉七七的身上藏着谜团。但只要白术先生在场，就跟她说不上几句话。除非，我们能找个白术先生外出看诊的机会，专门…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于香菱…",
      "text": "见到香菱的时候，你可得多观察一下她的表情。尤其是刚刚添置完食材回来的香菱，笑得越开心，就越危险。要是被她缠上、逼你试吃新品…这种情况，我一般会靠重云来处理。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于辛焱…",
      "text": "辛焱到底是在哪里演出的？从吃虎岩到玉京台，哪里都躲不过那种鸡飞狗跳的穿透力…唉，能够安静看书的时日是多么宝贵啊。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "下一卷、下下卷、下下下卷的重要场景，我都已经想好要配怎样的插画了！啊，必须赶快把灵感记下来，修书一封，寄给白垩老师…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于钟离…",
      "text": "我看见过家父和家兄接待这位先生，就从他们行礼时候的恭敬态度来看…对方应该是很有地位的人物吧。我还听说他是给仙人办丧事的人，感觉很有底蕴。要不要一起去挖掘他身上的秘密呢？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于申鹤…",
      "text": "总觉得申鹤小姐看我的眼神里略显凶恶，让我不敢随便跟她搭话。奇怪，难道我无意中得罪过她吗？或者…得罪过她身边的人？"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于夜兰…",
      "text": "你听说过「一人千面」这个词语吗？夜兰小姐就给我这种感觉。上门来访的时候，家父和家兄以礼相待，她也还之以礼，就像是个亲切稳重的大姐姐。可在别的地方见到她时，又完全是不同的印象。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于嘉明…",
      "text": "嘉明的工作颇有侠之风范。试想，功夫盖世的黑衣少年携手威武镇煞的瑞兽，在月黑风高夜，将盗贼与恶徒打得落花流水，狼狈而逃…等他得空，真想听他多分享一些走镖路途中的见闻。你也一起来吧？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解行秋·其一",
      "text": "阁下近来可好？如果闲来无事，可以来「万文集舍」转转。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解行秋·其二",
      "text": "问我为什么总是一个人看书？好学…并不是什么坏习惯吧。没有什么特别的地方，嗯，真的没有。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解行秋·其三",
      "text": "今天的时间已经空出来了吗？好，我也随时可以出发。书？没关系，书可以回来接着看，那些需要我们帮助的人可不能等啊。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解行秋·其四",
      "text": "你说你有个好点子？用我们之前做的事情当原型，写一本探案集加武侠题材的小说，《万文集事件簿》？嗯，啊哈哈哈…是个好点子，但是不采纳。嗯，不会采纳的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解行秋·其五",
      "text": "「洋洋万言，织诗成锦。」唉，我也想有这样的评价啊。这件事我只和你一个人说。其实，我也在写小说。现、现在当然不能给你看，以后…以后你会在书店里看到的。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "行秋的爱好…",
      "text": "我的爱好自然是看书。什么书都会看。嗯？你一脸坏笑看着我干什么。唔，那事我们两个知道就行了，还是不适合明面上讲。说出来就没意思了。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "行秋的烦恼…",
      "text": "烦恼啊，嗯…未来有朝一日兄长继承了家业，我会怎么样呢？这样无忧无虑的生活恐怕…啊，我不是在说身份之类的，我不在乎那些。我是觉得大哥太呆了，没我帮忙不太行啊。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我比较喜欢吃糕点和月菜海鲜。主要是因为，我们家一直就吃得很清淡吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我很讨厌胡萝卜，小时候家母经常捣碎胡萝卜做成…还是不要让我讲下去了。即使是在回忆里，那种味道也…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "此等美食，吃过一次就再难忘怀了啊。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "既然你有这份手艺，不如我们开个路边餐馆，如何？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "你吃你吃，不必客气。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日·祝福",
      "text": "咳，咳咳。恭祝你福寿与天齐，庆贺你生辰快乐。"
    },
    {
      "id": "7002",
      "type": 1,
      "title": "生日·习俗",
      "text": "据记载，天成石桥是上古战争时候，岩之神摩拉克斯投出的石枪倒塌后形成的。要是生日当天在桥上走一趟，往两边海里投点摩拉，就能保佑一年安康…生日一年只有一次，想去的话就快点去吧…没骗你，是真的。真的，快去吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "如果没有能力，那我心中的那个字，可能也就停在纸面上了吧。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "如果心中没有善恶的标尺，努力就会错了方向。舍本逐末，变成追逐暴力的俗人。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "我所追求的那个字，在璃月这方土地上并非处处通行。不过行道至此，我对这一点早就有了足够的认识。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "多亏了你的陪伴。我对自己也很满意了——无论是武学，还是对那个字的理解。唉，算啦。我也不用对「侠」字讳莫如深了。我的「侠」，父亲和兄长应该也不会质疑了。只不过嘛，低调行事这点还是得保留的。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "雨线难画。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "裁——！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "断！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "古华深秘。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "织诗成锦。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "裁雨留虹。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "形随神至。"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "冲刺开始·其二",
      "text": "该行动了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "甚好甚好。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "寻得珍宝，真是充满侠意的经历。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "倘若还有几卷失传的古书，就完满了。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "计划有变…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "接下来就不再是「点到为止」了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "「请从绝处，读我侠义。」"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "过来这边，我有一计。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "小心行事为好。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "承蒙…赐教…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "灯华易散…我是知道的。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "失手了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "不妨事。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "大意了。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "不好…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "厚积而薄发。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "不惭世上英。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "扶善惩恶，当仁不让。"
    }
  ]
}