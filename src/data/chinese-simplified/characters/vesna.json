  "outfits": [
    {
      "id": 214300,
      "name": "春结冬契",
      "description": "薇斯纳的装扮款式。由薇斯纳亲自在冬契军制服的基础款式上稍作修改后制成，但好看归好看，昂贵也是真昂贵，所以薇斯纳的冬契军整体换装申请到现在也没有通过。",
      "isDefault": true,
      "characterName": "薇斯纳",
      "characterId": 10000143,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Vesna_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你好呀，亲爱的朋友。冬契军司令薇斯纳，向你致意。礼炮和仪仗队都已经就位了，随时可以为你奏响。当然，如果你不习惯张扬，我也准备了更私人的欢迎仪式，快快跟上~"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·效劳",
      "text": "冬契军只听命于女皇陛下，当然不能随随便便就为你效劳了。但，风仙薇斯纳可以噢，亲爱的朋友。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·快乐",
      "text": "这身仪装好看吧？陛下亲赐的，多看几眼也无妨。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·高效",
      "text": "案牍工作？早做完啦，花不了多久。接下来都算巡视时间，走~"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "妖精当然也会着凉，淋湿了要赶快扇干，我指翅膀。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候…",
      "text": "白茫茫的雪地里，任何一点伪装的瑕疵都会变得极为致命。走路当心点哦，亲爱的朋友。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "阳光很好…",
      "text": "我知道我知道，阳光下我的翅膀最是闪亮。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "不错，是风仙喜欢的天气。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "随口一问…我们什么时候回至冬？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "新的一天！向你问候，至冬堡！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "走吧，去老庭院餐厅！当然依旧是我请客咯。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "科洛列夫茨基剧团有新的演出。除了沃雅妮莎首席的高音、奥黛塔小姐的舞步…还有一些「新的朋友」。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "嘶嘶…这就要睡了吗？要出去散步吗？有极光欸！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于薇斯纳自己·「魔法武器」",
      "text": "看到我身边飞来飞去的「小家伙」了吗？是我造的「魔法武器」，每一把都是用元素力和我自己的意识糅合出来的，多多少少带了点我的脾气哦。所以它们有可能会缠着你邀玩，请不要介意。当然，可以的话也请不要拒绝啦，呵呵！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于薇斯纳自己·司令官",
      "text": "司令官的「架子」…噗。这种东西是给镇不住场子的人准备的，我不需要~这点我们是一样的哦。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·求证",
      "text": "我懂我懂，你肯定有许多关于我的传闻想求证。没关系，我们有的是时间。不过作为交换，关于你的一切，我也会一点一点地「求证」清楚哦。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·同行",
      "text": "我不习惯「陪谁人走一段路」这种说法。听上去是很浪漫，可仔细一想…「陪」这个字，把一个人放在了主角的位置，另一个人则成了陪衬。\\n可脚是自己迈的呀，沿途的经历和收获，也从来都是自己的。所以呀，我不会说「陪你」，而是很高兴「与你同行」。这种感觉就像，走着走着，一转头却发现…哈哈好巧哦，居然刚好顺路！"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「星之楔」…",
      "text": "「星之楔」的样式非常漂亮，很有收藏价值。说到这个，「月之轮」也很不错，我一直挺心动的。至于「神之眼」…暂不考虑呢。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "我手上这柄「老伙计」？漂亮吧！是家族传下来的噢，它的年纪比我大得多得多了，说是殿堂级的古董也不为过。它有时被我当成魔法杖，有时是教杖，有时是指挥棒…哎呀，比起将它锁进银行的保险柜里吃灰，我让它在这把年纪还能发挥余热，先祖们想必夸我还来不及呢。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "霜仙花美丽又顽强，在严寒的地方都能存活下来。花纹也很特别，我喜欢半眯着眼，晃着脑袋看它，眼里的景象就会像万花筒一样，特别梦幻。但你最好在没人在旁时再尝试。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于「女皇」陛下·忠诚",
      "text": "我抓过太多自以为是、想要跟陛下唱反调的家伙了。他们嘴里的宏图霸业，全是不堪一击的花拳绣腿。既没有举事的谋略，也没有成事的能力。跟那些所谓的野心家相比…不，我收回这些话。他们不配跟陛下相提并论。\\n简而言之，效忠陛下，既是风仙一族的职责，更是我薇斯纳个人的选择哦。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于「女皇」陛下·慈爱",
      "text": "「慈爱」这个词在陛下口中总是带着冰刺的。她说那是天理强加给神明的诅咒，不是真正的爱。可我偏偏不这么想哦。讨伐魔兽归来，陛下会在手谕末尾添上一句「好好休息」。生之执政的能力被回收后，她也照顾到了我明明藏得很好的失落，把没被回收的部分送回到我这里…\\n但这些，以陛下的身份，她本可以不必做的。这么说可能有些僭越，我始终认为，一个神明到底有没有「爱」，应该由子民说了算！所以我说的也算？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于达妮卡·小时候",
      "text": "我们亲爱的达妮卡小姐，别看她现在严肃又深沉，小时候，她可是跟我一起策划过「掀开老师面罩」这种事的捣蛋鬼哦，我们还成功爬到了老师肩膀上呢！虽然最后没得逞，反被罚在冰湖上站了很久军姿…哦不，这点糗事不是重点！重点是，这个鬼点子明明是她先提出来的，要说贪玩，她可一点都不输我。现在倒好，整天对我摆出一副大人看小孩般无语的表情。拜托哦，我才是姐姐。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于达妮卡·吵架",
      "text": "据可靠线报称，有嫌疑人借着举办「吵架大赛」这种莫名其妙的活动为噱头，趁人群起哄之际完成不法交易…我必须管管了。\\n所以，我已经替达妮卡报名了，她很擅长「冷面拆台、专戳软肋」，谁能吵得过她呀？一定能帮我拖延很多时间吧。\\n加油啊，达妮卡！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于「队长」…",
      "text": "印象里他的背影总是那么宽厚又可靠，像一座沉稳的大山。我从未想过有一天大山也会倒下，至少…没想过会这么快…什么「真正的战场不存在告别的机会」，那也用不着亲身向我证明吧，连最后的机会…都没有留给我。\\n太坏了，我的老师。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于「丑角」…",
      "text": "这个世界上，有些人脚步轻盈，他们大多期盼着走向明天。而他，始终走得很沉重。我时常觉得他和老师很相似，大概是因为他们都把难以想象的悲伤藏在面具底下，把沉痛的过去全都背在身上了吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于「公鸡」…",
      "text": "市长先生在皇都评议会上侃侃发言，游刃有余的样子，显得他非常伟岸。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于「富人」…",
      "text": "冬契军司令的薪水不算低，可要用来随心所欲购买收藏品和请客吃饭还是会有些吃紧…哦哦，我不是那个意思，听我说完嘛。从记事起，家族的「闲钱」就经由北国银行打理，托潘塔罗涅先生的福，收益滚动到现在已经非常可观了。所以我完全没有什么负担啦，你不用客气，下次还是让我来请客！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于「木偶」…",
      "text": "桑多涅的举止完全符合淑女的标准，言语却又带有极强的「攻击性」，同时逻辑经得起推敲，无可挑剔…太有意思了，嘻嘻，我要好好学学。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于米提亚…",
      "text": "米提亚是我固定的游戏玩伴，他总能想办法从军械宫溜出来，我们三个每次都玩得很尽兴！哪来的三个？我，米提亚，还有他那条聪明的围巾。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于沃雅妮莎…",
      "text": "沃雅妮莎小姐的每一首歌都很好听，我非常享受在现场听歌的感觉。跟台下的大多数观众一样，我也会随着她的歌声时而欢笑时而流泪。有时候演唱结束后，大家还会自发留在现场大合唱。巧了不是，我手上正好有一根指挥棒呢。更巧的是，有好几次我都发现了悄悄混入人群的沃雅妮莎小姐，她换下演出服戴上了帽子，在为大家和声呢。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于奥黛塔…",
      "text": "其实每一次奥黛塔小姐来参与朝会，我都会忍不住多瞄她几眼。毕竟，她除了是愚人众的一员，另有个「特殊」的身份，让人很难不在意…我指的当然是科洛列夫茨基剧团的首席芭蕾舞者呀，不然呢？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于阿罗夏…",
      "text": "我明白的，哪只小狗能拒绝在「呼啸」的狂风里，去追逐一只漂亮的蝴蝶呢？呜…我把达妮卡的早餐偷出来给图加林吃吧，再请阿罗夏帮我美言几句，拜托它不要一见面就追着我跑啦…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解薇斯纳·其一",
      "text": "嘻嘻，想通过什么方式了解我？不会真的只是聊天吧？那多没意思…不玩点「真假话大冒险」之类的游戏吗？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解薇斯纳·其二",
      "text": "冬契军是直属于女皇陛下的亲卫部队。职责嘛，可不仅仅是讨伐魔兽、参与战事这类军务哦。举凡一切关乎女皇陛下权威与荣誉之事，冬契军皆需无条件听候陛下差遣，为陛下扫清前路上的一切障碍。\\n不过，在对抗天理的伟业尘埃落定前，陛下难免分身乏术。所以其他诸如开幕剪彩、参加晚宴这种好事…咳咳，这类琐事，我非常乐意效劳。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解薇斯纳·其三",
      "text": "我的收藏品有许多，珠宝啦古籍啦油画啦…任何能让我开心的物件都值得被我收藏。而且我必须第一时间拿下，一秒钟都不想等！不是有那样一句话吗，「勺子在午餐时才珍贵」。错过了那一瞬间的心动，往后再得到，味道也就淡了大半啦。所以当下想要，当下就要得到。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解薇斯纳·其四",
      "text": "莫诺马赫皇帝牺牲后，至冬曾经经历过一段动荡时期。我的先祖在那时便坚定站在女皇陛下这边，我们的荣耀从未曾折翼——那么，站在他们肩膀上的我，究竟有没有青出于蓝的实力呢？哼哼，我已经把你心中的疑问说出来了。是啊，有没有呢？现在轮到你把我心中的答案说出来了，请~"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解薇斯纳·其五",
      "text": "对抗死之执政的前夕，我提取了许多人的「生之印」，大家对于美好回忆的定义各不相同：有人珍视的，是与家人围坐在壁炉边，有一搭没一搭地闲聊。有人念念不忘的，是独自坐在火车窗边，看极光在夜空里静静流淌。还有人，只是拉着雪橇去冰钓，便觉得满足…\\n那些回忆，就像一个个五彩斑斓的泡泡，附带着滚烫又鲜活的「生命力」，让人想要不自觉地感叹——啊，活着真好！\\n可所谓的天上的存在，却能轻而易举地将这些泡泡碾碎，连一句解释都吝于给予。凭什么啊？\\n从那一刻起，对我而言，对抗天理，便不再仅仅是为了辅助陛下。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "薇斯纳的爱好…",
      "text": "很小的时候，家中就给我安排了绘画，舞蹈和声乐老师，稍微长大一些了，我就开始练习击剑和马术等等…近期嘛，我迷上了听歌剧，看演出，还有搞点小小的收藏…总之我的生活里没有「无聊」两个字。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "薇斯纳的烦恼…",
      "text": "别听达妮卡胡说，我的开车技术真不差，那叫人车合一。等我的开车禁令解除后，就载你去兜风吧！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "天气这么冷，没有什么比围在一起喝点炖汤更让人惬意的了！这样吧，我来组局，你跟派蒙随便拿点食材来就好啦~"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "嘿嘿！烦人的蔬菜统统挑到达妮卡的盘子里噜！呜——又被夹回来了…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "那么，我不客气啦，把美味统统收藏进肚子里。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "嗯嗯…烹饪的巧思吗…嗯嗯…我再尝一口。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "我吃饱啦谢谢！这些我打包给达妮卡吃~"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "铛铛铛铛，时间到！你知道我昨天憋得有多辛苦吗？提前说出那句祝福可是会被暴风雪吞没的！现在终于可以说了——生日快乐！亲爱的朋友。愿你像白桦树一样强壮，永远不被风雪打败。\\n好啦，按照习俗，接下来我要轻轻揪几下寿星的耳朵咯——"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "新兵训练第一课：风雪压不弯的脊背，才有资格护卫在陛下左右。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "新兵训练第二课：握剑的手不许抖。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "新兵训练第三课：敌人面前不许哭。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "而我亲爱的朋友，你教给了我另一课：留一丝柔软，去拥抱风雪后，值得拔剑守护的人。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "列队。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "敬礼。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "举剑。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "让一让~"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "没结束哦。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "向您致意。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "陪你们玩玩吧！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "瞄准——逃不掉咯！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "献予女皇陛下——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "嚯嚯，新藏品入库！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "你一件，我一件，陛下一件，我一件，分完了！达妮卡没有，哈哈。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "这呢这呢，看这里！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "司令官当然要留守在战场上。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "放心，我能躲开哦。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "咳…暂时的劣势…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "撤退，由冬契军接管。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "别逞强，亲爱的朋友。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "飞不起来了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "永远效忠…女皇陛下…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我不痛…只是不甘心…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "什么动静？"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "哈？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "你竟敢！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "真无礼！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "巡视时间到~"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "我看看——有什么好玩的呢？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "那就等你的号令咯？"
    }
  ]
}