  "outfits": [
    {
      "id": 213000,
      "name": "孤羽成谶",
      "description": "莉奈娅的装扮款式。特别定制的冒险服，兼有美观与实用之能，还给露米（和其他未来可能到来的朋友）准备了专属的随身小屋，唯一的问题是，这间小屋的对外窗口只有一个，到底谁能住在窗边，是一个值得莉奈娅和她的朋友们仔细讨论的问题。",
      "isDefault": true,
      "characterName": "莉奈娅",
      "characterId": 10000130,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Linnea_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你好！我叫莉奈娅，是冒险家协会的顾问，这个小家伙是露米，是我的伙伴。关于野外冒险你有什么想知道的，尽管问我好啦！对了对了，如果你在冒险时遇见了什么不可思议的生物，可别忘了告诉我哦！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·露米",
      "text": "露米很可爱对吧？不过要是你身上有亮晶晶的东西，可要小心别被它吞掉咯！不然很有可能找不回来，哈哈…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·「斯佩兰扎」",
      "text": "要说那夏镇最值得去的地方…当然是「斯佩兰扎」了。你就当是我偏心好了，去尝尝看吧，卡嘉的手艺不会让你失望的。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·图鉴",
      "text": "你想看看图鉴？当然可以，这可是我的得意之作，就连里面的插图也都是我自己画的呢。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨过天晴…",
      "text": "湿润的泥土的气息…世界重新醒来了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候…",
      "text": "好冷哦…要堆雪人吗？露米也来帮忙吧！啊！用不着锤子。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "起风的时候…",
      "text": "不知道蒲公英的种子会飞向何方…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "「睡吧，睡吧，黄金的梦乡在召唤流浪的沙子，在这里不必将那苦涩的盐水掬饮，在这里不会再有明日的愁肠…」"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好！草叶上的晨露还在，很清新，你也要闻一闻吗？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "差不多该吃点东西补充能量了，今天还很长呢，还能做很多事！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "你要是还不困，我们就这样一起看会儿星星，好吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "今天也走了好多路，该休息了，祝你做个好梦，晚安…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于莉奈娅自己·追逐和等待",
      "text": "这个世界上有许多美丽又奇特的生命，要了解它们的秘密，就像和一个害羞的朋友玩捉迷藏，但好在无论是追逐还是等待，都是我擅长的。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于莉奈娅自己·童年",
      "text": "虽然没能和「家人」一起生活，但我知道，他们都以自己的方式爱着我…我是被截然不同的爱浇灌长大的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·见闻",
      "text": "哇，你的脑袋里到底是装了多少奇妙的见闻呀！和你聊天真让我受益匪浅…要不干脆让我推荐你当冒险家协会的顾问吧？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·分享",
      "text": "你已经知晓了我的故事，而你的世界，我才刚刚窥见一角。如果可以的话，今后我也想听你分享那些我不曾参与的冒险，作为交换…我会为你在黄金猎犬号上留一个位置的！"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「月之轮」…",
      "text": "悄悄告诉你，其实我不靠它也能使用力量…不过露米很喜欢它，可能因为它也是亮晶晶的，所以就留下当作装饰啦。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "据说挪德卡莱曾经存在广阔的原始森林，松珀香就是那些参天巨木所流下的树脂，人们浪漫地将其解读为巨木之泪。而在数百年的时光中，森林消失了，泪水却没有干涸。不过，只要拾起这些散落的「碎片」，我就能在脑海中还原出过去世界的模样，这种像是回望古老遗珍一样的乐趣，正是我无法停止冒险的理由呀。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "嘿嘿…美露莘真是太可爱了！嘿嘿…如果能在海沫村住上一段时间就好了…可惜不管我怎么拜托，她们就是不愿意答应，到底为什么呢？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于爱诺…",
      "text": "我们曾经是海螺帮的伙伴呢，爱诺小时候真的可爱极了，后来她喜欢上了机械…唔，长大了一点的爱诺还是很可爱，但她的爱好就没那么可爱了…你别误会，不管她喜欢什么我都支持她！只是…只是我真的很不擅长应付会动的机械…也许是因为「换生灵」的天性吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于伊涅芙…",
      "text": "听说她做的蛋卷甜甜的，特别好吃，可惜我一靠近她就本能地想要逃跑，所以到现在还没有品尝过…而且她好像有什么事想要问我的样子，唉，不然下次去拜访的时候让爱诺把我绑在座位上听她说好了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于菈乌玛…",
      "text": "她的角冠真漂亮…我曾经很礼貌很礼貌地问过她，可不可以让我摸一摸她的角冠，她很礼貌很礼貌地拒绝了我。看起来，霜月之子在这方面比美露莘还要严格…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于菲林斯…",
      "text": "我想，即使是在妖精之中，菲林斯先生也是最博学的那一类。虽然和他对话的机会不多，但每次交流都让我收获颇丰。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于奈芙尔…",
      "text": "在挪德卡莱活动，或多或少都会和「秘闻馆」打交道，奈芙尔小姐办事利落，再没有比她更可靠的合作伙伴了。不过，比起情报，我对她家的猫更感兴趣，阿舍鲁呀阿舍鲁，你一定不是一只普通的小猫咪吧…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于叶洛亚…",
      "text": "他年纪轻轻就当上了执灯人的分队长，一定有什么过人之处吧。不过我们第一次见面的场景有点混乱，可能给他留下了不好的印象，不知道他还会不会愿意让我为阿咚撰写图鉴条目…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于桑多涅…",
      "text": "你知道吗？冒险家协会的凯瑟琳其实是愚人众执行官「木偶」的造物。通常来说，我是很不擅长应付这类会动的机械造物的，但面对凯瑟琳时却没有任何抵触的情绪，真奇妙，不知道她使用了怎样的技术。也幸亏如此，我才不用麻烦萨林或者其他人来帮忙接取协会的委托。如果有机会见到她，我真想向她道谢！"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于沃雅妮莎…",
      "text": "歌剧院里的人们为她疯狂，却不知道自己听到的不过是海浪的余响。或许她也有自己的理由…但我能感觉到，在那副歌喉深处，潜藏着一旦释放就能让所有人理智断弦、万劫不复的魅力呢！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解莉奈娅·其一",
      "text": "不是图鉴或是冒险相关的问题，而是关于我自己吗？这倒是个新鲜的视点，如果我是我自己的观察者，会得出怎样的结论呢…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解莉奈娅·其二",
      "text": "虽然已经不是海螺帮的一员了，不过有空的时候我还是会回去看看大家，「斯佩兰扎」对我来说就是家一样的地方。或许正是因为有了这样一个栖身之所，我才能鼓起勇气去探索并记录这个世界，是他们无私的爱让一度迷茫的我意识到，自己并不是被世界所拒绝的…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解莉奈娅·其三",
      "text": "我也有过这样的担心，离开冻原，露米会不会适应不了？特别是去纳塔之前，我害怕得都快睡不好觉了。万一露米像雪人一样，气温升起来了，它就一点点融化…呜哇，现在想起来还是会觉得后怕！还好后来据我观察，环境的温度对露米没什么影响，哪怕差点掉进岩浆里，它也还是笑嘻嘻的，真是了不起的霜精啊，露米。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解莉奈娅·其四",
      "text": "「去吧，妖精的孩子。到村落与城镇中去吧，和人类朋友手牵着手。妖精的世界载满你不懂的忧愁…」我的父母试图将我从那条既定命运的河流中捞起，把我放在人类的摇篮里，希望人类对命运的迟钝能成为保护我的茧，让我免受那些过早到来的悲伤侵蚀。我也曾有过不解，但现在我知道了，这是一种出自悲伤的爱…伤痕或许不会消失，但结痂后就不会再流血了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解莉奈娅·其五",
      "text": "就像姐姐说的，也许未来我终究还是逃不开「谶鸟」一族的宿命，但在那之前，我想尽情享受探索解明未知世界的快乐，乘着黄金猎犬号走遍提瓦特大陆的每一个角落，将我的图鉴填得满满的…而等到「那一天」来临，或许我就能真正理解那份孤独和痛苦，并心无芥蒂地拥抱我亲爱的姐姐了吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "莉奈娅的爱好…",
      "text": "在观察生物的时候我会想象自己也是其中的一员，过着和现在完全不一样的生活…啊，比如美露莘！如果我是美露莘的话，一定就能理解她们眼中所见的「色彩」了。这种东西，不是自己看到的话，完全无法想象嘛…"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "莉奈娅的烦恼…",
      "text": "说起来，辛苦收集到的矿石标本总会莫名其妙地不见几个…等等，该不会是被露米给吞掉了吧？露米，快张嘴呀，说「啊——」"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我喜欢甜甜的食物，带着露水的浆果，新鲜蜂蜜做的糖雕，刚出炉的蛋糕…如果在野外冒险时也能随时吃到这些就好了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "只要不是对身体有害…我没有什么特别讨厌的食物，要是明明可以吃却因为口味的偏好而浪费掉，那也太奢侈啦。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "这个真的好吃！是怎么做的，能教教我吗？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "好吃！下次换我来，也让你尝尝我的手艺。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "唔…至少对身体没什么害处。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐…虽然不是什么贵重的礼物，但这块我私藏已久的化石，请你收下。你看，这里有着早已灭绝的鸟类留下的骨骼和羽印，虽然它们再也无法飞翔，但那振翅的瞬间却被拓印了下来…即使生命终会消逝，我们存在过的证明总会以某种方式延续。愿你的生命也如古树般坚韧，每一圈年轮，都刻录下美好的故事。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感官变得更敏锐了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "对世间万物的理解又更深了一层。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "感受得到力量的流动…就像掌握了洋流的规律，航行也会变得更顺畅。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "知识正在转化为直觉…我信任这个世界就像信任一朵雏菊。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "去吧，露米！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "打个招呼吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "可别小瞧了！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "尝尝这个！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "不可以挑食喔！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "要小心咯！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "青春之地的馈赠。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "如结晶般闪耀吧。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "皆大欢喜！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "怎么样？有什么好东西吗？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "亮晶晶的…露米，这个不能吃喔！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "看起来不错，你运气真好！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "还能坚持…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不应该是这样的…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "要小心了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我来帮你！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "包扎就交给我吧！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "是我选错了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "是噩梦吗…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "这不是…属于我的未来…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "哎呀…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "唔…！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "不算什么！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "好痛…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "露米！我们出发咯！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "今天要去哪里探险？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "叫我吗？我准备好啦！"
    }
  ]
}