  "outfits": [
    {
      "id": 203900,
      "name": "粉糖青酿",
      "description": "迪奥娜的装扮款式。猫尾酒吧明星调酒师工作时的日常装束。",
      "isDefault": true,
      "characterName": "迪奥娜",
      "characterId": 10000039,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Diona_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "「猫尾酒馆」的招牌调酒师，迪奥娜，我的出场费可是很贵的。唔？你居然…不是为了酒才来的？哼，那你的邀请…我就勉为其难地接受了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·放松",
      "text": "哈~~好舒服，身体都变得更柔软了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·思考",
      "text": "蜥蜴尾巴、胡椒、星螺…还差点什么才能调出「难喝到头脑炸裂的酒」呢？呜…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·等待",
      "text": "才，才没有在等你。我只是，正好在休息而已！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "呜呜…讨厌下雨…去屋子里吧。唔，只是因为弄干衣服很麻烦！才不是什么怕水呢！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "欸？！…我没有在发抖！没有！…呜…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候·玩雪",
      "text": "这个凉飕飕的触感，哇…好棒，好有趣。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候·观雪",
      "text": "白茫茫的雪在风里跳舞，真好看呢。嗯…我旁边的座位还空着，没人坐哦。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "阳光很好…",
      "text": "走喽，晒太阳…你不去我可就自己去了哦…唔，最后一次机会！走不走！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早，把橱柜里那罐腌泥鳅递给我一下——好咧，我要开始摧毁蒙德酒业啦。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好·异响",
      "text": "咕噜噜…嗯？没有！你什么都没有听到！"
    },
    {
      "id": "1005",
      "type": 1,
      "title": "中午好·罐头",
      "text": "这个鱼肉罐头是我好不容易省下来的，别，别看啦！最多…最多只能给你尝一口。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "失败了…又失败了…大家都喝得好开心，呜…别安慰我，我才不需要安慰…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "你没有猫的夜视能力，走夜路不要紧吧？要我护送你的话…欸，有灯啊？…谁，谁要护送你啦，快点走快点走。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于迪奥娜自己…",
      "text": "耳朵和尾巴才不是什么装饰，是「凯茨莱茵家族」血统的象征，真是少见多怪。呃…你、你把手伸过来干什么？这个…唔…好吧，耳朵的话可以让你摸一下…但是尾巴、尾巴绝对不可以！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·饮料",
      "text": "想喝无酒精饮料？难倒是不难，但是没有意义！无论成功还是失败，都和摧毁蒙德酒业的目标没有关联。我才不会做呢。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·贵宾渠道",
      "text": "喏，这个是「了不起的夏日梦幻忧郁珊瑚气泡茶」，只是因为最近无聊才做的。热门产品？排队抢购？你在说什么呢，我可没听见。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·聊天需要",
      "text": "唔…要是，要是你感觉孤单了，我可以随便陪你聊聊天。我还是知道很多事情的哦！也是很好的…那个叫什么，说话对象哦。没错没错！来跟我，多说说话吧…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于我们·好奇心",
      "text": "是什么是什么？你拿着的是什么？快给我看看！说不定丢到酒里能做出相当难喝的…啊，什么嘛，原来只是长得奇怪了点的蘑菇而已呀，真无趣。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」·遗传",
      "text": "问我的「神之眼」是怎么来的？哼，是、呃…是凯茨莱茵的家族遗传！唔？杜拉夫先生根本没有神之眼？欸——露馅了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "关于「神之眼」·来历",
      "text": "为什么非得告诉你啦，哼！算了，看在你一直追问的份上，看在…看在我们是朋友的份上。那次我爸爸外出打猎，差点出大事，在大雨中，我脑袋里想的全部事情就是要找到他，救出他…好了啦，满意了吧！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "龙脊雪山上，会不会长着奇珍异草呢。「拥有致命的苦味」或者「沾到一点就嘴巴发麻」这样？要拔好多下来！然后…嘿嘿嘿…嚯嚯。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "我扑…捕捉蝴蝶的技巧可是一流的。喂，不是啦！抓蝴蝶是为了加进酒里做出难吃的味道，不要把我当成猫啦！喵！"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于迪卢克…",
      "text": "那个…迪卢克，是我最讨厌的人！没有迪卢克就不会有蒙德酒业，没有蒙德酒业爸爸就不会喝酒，爸爸不喝酒就…就会陪我了，哼。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于凯亚…",
      "text": "为什么连我的「护卫队长」也是个令人讨厌的酒鬼啦！就是那个，说起话来总是笑盈盈的家伙！喝起酒来一杯接一杯的，没完没了。呼！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于温迪…",
      "text": "温迪？不太熟的样子。但说到吟游诗人，就是那伙会给酒鬼们唱歌助兴的人吧。那就不喜欢！不喜欢不喜欢。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于芭芭拉…",
      "text": "芭芭拉小姐的粉丝们，都是大哥哥大姐姐…好羡慕，为什么我的粉丝都是一群大叔呢。呜…可恶，哼，不想了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于琴…",
      "text": "琴啊，骑士团的代理团长，嗯…难得一个不喝酒的成熟大人…但总感觉认真过了头，骑士团的大家对我有些过度保护了吧？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "首席炼金术士大人？唔…我这种一直调出好酒的体质，他会知道破解的方法么？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于丽莎…",
      "text": "丽莎姐姐，很和善对吧，很温柔对吧？但是，这样的姐姐也经常喝酒！呜呜呜…这是为什么啦…蒙德城已经没救了吧…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于香菱…",
      "text": "我向香菱讨过一份「口感搭配特别糟糕的食物组合」，据说是她亲自实践下来的，绝对难吃什么的…没用，完全没用。「续杯」两个字已经听到猫耳朵都生茧了！呜…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于可莉…",
      "text": "可莉每次来找我玩的时候，我都只好把她带去离酒馆远一点的地方。酒和炸弹…实在是太危险了！就算我想摧毁蒙德酒业，也得用堂堂正正的方式。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于父亲…",
      "text": "爸爸是我最尊敬的人！爸爸是最厉害的人！但是…喝了酒的爸爸，唔——果然还是要早点终结蒙德的酒业！没时间闲聊啦！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解迪奥娜·其一",
      "text": "「调酒师」可是很忙的！即使不在酒馆工作，也要抽出时间来收集配方。所以，所以没有要紧事情的话，就不要来打搅我。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解迪奥娜·其二",
      "text": "你不会…也像那些讨厌的酒鬼一样要我学猫咪叫吧？不会的，绝对不会的！我才不是什么抖抖耳朵伸伸懒腰的宠物！我可是…可是…「酒业杀手」！"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解迪奥娜·其三",
      "text": "你问我…为什么「酒业杀手」变成了「猫尾酒馆」的招牌…？你，你是故意这样问的吧！就是想看我的笑话。呜，坏人！再也不给你调喝的了，水也不给！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解迪奥娜·其四",
      "text": "别再惹我了啊，我宽容大度，但也不好欺负！我警告你，我生起气来可是会咬人的！喵！虽然不一定舍得咬你…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解迪奥娜·其五",
      "text": "我和你…已经成为好朋友了，对吧。我隐约记得…我以前也有过这样一个朋友，但我不确定那是不是梦…\\n把你的手给我。啊呜，唔…暖和的。这样就好，不要变成梦走了…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "迪奥娜的爱好…",
      "text": "我喜欢打猎，追捕猎物可是我的强项！但爸爸说野外情况瞬息万变，只有跟着可靠的大人一起，才能深入森林。你…算是可靠的大人吧？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "迪奥娜的烦恼…",
      "text": "嗯…到底怎样才能调出难喝的酒呢…连我给予厚望的噩梦搭配——「酱油牛奶绝云椒椒配蒲公英籽特调」都被说成是「小迪奥娜又有进步了」，呜…我不会认输的…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我喜欢吃鱼！作为主食的鱼…爸爸做的鱼！但是…不要作为下酒菜，那是对鱼的亵渎！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "胡萝卜、土豆、洋葱、番茄…这些味道都不太喜欢。我，我可不是吃素的啊！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好吃…我，我就随便问一下哦，下次还有吗？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你可别指望我尝了点甜头，就会来蹭你…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "喂…你是把我当成路边的野猫了吗！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "炸鱼，配上这个我特别调制的酱料，给你。\\n…没有加奇怪的东西！我认真调味的手艺才不会差呢，先尝过才可以说话。\\n哼…这才对嘛…唔，那个，生日快乐。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "猫的眼睛，看得见黑暗中的一切猎物！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "猫的耳朵，听得见地上最细微的脚步声。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "猫的四肢，爬得上全提瓦特最高的树。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "猫的鼻子，闻得出熟悉的、喜欢的人的…唔？！是你听错了！我怎么可能说出那种话…呜…"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "嘿…呀！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "咻咻——"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "目标确认。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "攻守兼备。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "抓到你了！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "我可不好欺负！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "迪奥娜特调！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "贪杯的下场…哼！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "反省吧，酒鬼！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "唔，来了。"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "冲刺开始·其二",
      "text": "出发，出发！"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "冲刺结束·其一",
      "text": "呼。"
    },
    {
      "id": "710002",
      "type": 2,
      "title": "冲刺结束·其二",
      "text": "哈唔…"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打开风之翼·其一",
      "text": "飞起来喽。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "让酒变难喝的材料啊，出现吧！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "亮晶晶的…想要…扑过去！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "宝箱里有些什么，我很好奇！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我不会认输…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "喵…喵…！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "胜负还没分呢！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "太乱来啦！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "去休息去休息！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "酒的味道…好臭…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "泉水精灵…不要走…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "眼睛…睁不开了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "没躲开…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "从哪里来的？"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "狩猎开始！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "果然需要我出手嘛！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "哼，就包在我身上。"
    }
  ]
}