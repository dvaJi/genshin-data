  "outfits": [
    {
      "id": 209100,
      "name": "黄丝绒沙龙",
      "description": "娜维娅的装扮款式。完美契合枫丹淑女形象的优雅裙装，被一位喜欢冒险、喜欢大笑的非传统淑女穿出了不一样的风格。",
      "isDefault": true,
      "characterName": "娜维娅",
      "characterId": 10000091,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Navia_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "大名鼎鼎的刺玫会现任会长、领导者、总指挥、话事人、老板娜维娅，很高兴认识你！看你才貌出众、气度不凡，我有种预感，我们的缘分会像我的名号一样长呢。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·旅行",
      "text": "好想去旅游呀——！去哪无所谓啦，主要是想跟朋友们一起玩，嘿嘿。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·经验之谈",
      "text": "多年的帮派经验告诉我，身边有一把不称手的武器会比没有更危险。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·会标",
      "text": "刺玫会的标志是母亲设计的，我非常喜欢。你看，轮廓像颗心脏一样呢。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "啊…又是雨天…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "哎呀！刚才看到闪电就该捂住耳朵的！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "是不是应该摘掉帽子，让雪花落在脸上？感觉一定很清爽。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "就是现在，立刻，马上，抬头！你看天上，是不是烈日炎炎，骄阳似火！知道这说明什么吗？\\n说明我们现在应当立刻，马上，去买最大号的超级冰冰凉甜筒，然后比赛谁能在它融化前全部吃完！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "雨过天晴…",
      "text": "太好了，雨停了！"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "刮大风了…",
      "text": "帽子和裙摆…好难取舍！"
    },
    {
      "id": "1207",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "戴上墨镜就不会被沙子迷住眼睛了！但天黑时会看不清路…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好！想好今天要做什么了吗？没想好的话，要不要跟我来？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "听说最近出了一种新口味的千层面，你有没有兴趣？感觉一定不会好吃，但我还是想去试试！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚间新闻播报：「今天的刺玫会会长也和她的好搭档度过了完美的一天。」真棒！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "快，速速清空大脑，睡个好觉！明天见。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于娜维娅自己·乐观",
      "text": "盲目乐观可不行，幸福的生活要靠自己的双手去争取！所以，来，握住我的双手，左右摇晃几下——怎么样，是不是很开心？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于娜维娅自己·运气",
      "text": "了解我经历的人可能会觉得我运气不好吧，但我不这么认为哦。\\n能得到这么多的爱，是我一生最幸运的事情了吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·搭档",
      "text": "他们有人叫我老板，有人叫我大小姐，我都无所谓啦。最开心的还是你称呼我为「搭档」的时候，所以请多叫几次，满足我的虚荣心吧！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·保密",
      "text": "有人说秘密一旦说出口就不是秘密了，但能和朋友分享的秘密不是更加珍贵吗？\\n…什么啊，我不是在威胁你啦！虽然身为刺玫会的会长，我当然知道很多让人保守秘密的诀窍，但我是不会用在你身上的，安心啦。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "给你看，这就是我的神之眼！亮晶晶，很称我衣服的颜色吧？\\n不过还是你比较厉害，不需要神之眼就能使用很多种元素，应该不是靠练习就能做到的吧？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·狗狗",
      "text": "在所有的品种里，我最喜欢深栗猎犬。你看它们眼睛上方的花纹，是不是很像眉毛？所以它们总是一副憨厚又认真的样子呢。\\n不过这件事还请帮我保密，千万不要告诉别的狗狗！"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什么想要分享·可靠的刺玫会",
      "text": "假如你在灰河待过一段时间，应该会发现枫丹还是有不少其他帮派的。他们的目的不一，并不都像刺玫会那样友善，你可要多加留心。如有必要，可以向酒保泰托先生求助。若是对方不愿意坐下来谈的话…嗯，那就只好请我们可靠的白手套先生出马咯。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "久雨莲的颜色真好看啊。而且当你看到它们纷纷绽放的时候，就说明漫长的雨季终于过去了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于克洛琳德…",
      "text": "她平时话不多，表情也不多，但还是能看出来喜怒哀乐的。之前老爹的事卡在我们之间，唔…有些隔阂吧，就算是那段日子，我也不爱她小心翼翼的样子…还是现在这样比较好。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于夏洛蒂…",
      "text": "比起跑新闻时的热情和速度，夏洛蒂的拍照技术更让我惊讶。她之前随手给我拍过一张半身照，光影效果好像精心绘制的油画一样。既能写出意想不到的报道，又能拍出最能抓人眼球的画片，她大概天生就是要做记者的吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于千织…",
      "text": "这位为枫丹时尚带来异国风情的服装设计师，私下里帮过刺玫会不少忙呢。她说我的奇思妙想给她提供了好多创作灵感，以我对她的了解来看，应该不是客气话。但当我请她做一个十米高的礼帽时，她却严词拒绝了。唉，要是能摆在店门前，应该是很惹眼的宣传手段呀！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "小时候有幸观看过一次芙宁娜大人参与义演的歌剧，票可难买了！虽然扮演的是别的角色，但她看起来反而比平常站在高处演讲时更自然些…现在回想起来，竟然不是错觉。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于那维莱特…",
      "text": "那维莱特先生啊，既复杂又简单。怎么说呢…就像海里的礁石，磕磕绊绊的，但假如理解了其中的规律，也不是完全没法观测。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于莱欧斯利…",
      "text": "想和他谈点东西可费劲了。克洛琳德说在既定的合约基础上可以放心与他合作，但千万不要相信他说的每一句话。怪不得老爹以前从不插手水下的事，保险起见，还是维持原样吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于「仆人」…",
      "text": "她是一位威严却又慈爱的领导者，有「一家之主」的风范。不过能成为愚人众的执行官，她一定也有手段狠厉的一面。\\n所以放心吧，我会永远记得她帮助过白淞镇的恩情，但在其他方面也会留心的。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于林尼和琳妮特…",
      "text": "我知道大魔术师说话总会有些浮夸啦，但能看出，林尼是真心对待身边亲友的。有时候他表现出的责任感，可比他的年纪大多了…\\n哦对了，他之前免费给白淞镇的小朋友们变过魔术呢！有机会的话，下次也请他和琳妮特小姐一起来吃马卡龙吧。琳妮特小姐经常凭空变出茶杯来喝茶，那应该不会讨厌甜点吧？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于爱可菲…",
      "text": "我的好朋友爱可菲呀，她总算是结束闭关了。听说，她在开发超越「德波大蛋糕」的新品，一直闷在自己的专属厨房里。再这样下去，眼睛都要畏光了吧？不如，我们约上她，找个时间出门野餐吧？阳伞和墨镜随她选。和爱可菲出行，普普通通的郊游都会变成一场美食之旅哦。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解娜维娅·其一",
      "text": "刺玫会的工作嘛，杂七杂八的什么都有吧，不过核心目的都是帮助大家解决各种麻烦。这里的「麻烦」只用来指代问题本身，不代表我觉得这些事情烦心哦。相反，能帮到大家会让我觉得神清气爽呢。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解娜维娅·其二",
      "text": "人还是要有些浪漫情怀才行。春天的花，夏天的海，还有朋友的笑容，都不该是被忽略的景色。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解娜维娅·其三",
      "text": "有时我会找个人迹罕至的野外，摆一些物件作为目标，然后练习打靶。\\n很解压的！你想试试吗？我来手把手教你。虽然你是我的第一个学生，但我觉得我会成为一名好老师的。老爹还有布莱卡利奶奶教我的东西我都还没忘呢！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解娜维娅·其四",
      "text": "我不会变成和老爹一样的人。有刺玫会里的老干部觉得我和老爹越来越像了，但我认为那只是很小的倾斜，要归因为有些问题只能用固定的几种办法来解决。刺玫会已经不是当年的样子了，那么会长也不会相同。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解娜维娅·其五",
      "text": "我觉得我也不会变成和母亲一样的人。虽然很多人都说我性格和她很像，我也大约能想象到她当年做出很多选择的理由，但是…\\n哎，突然很想去坐一次克莱门汀线。就现在，可以陪我吗？倒也没什么特别的目的，就当是我邀请你去城里闲逛吧？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "娜维娅的爱好…",
      "text": "我从小就喜欢烘焙。看着一堆零散的食材按照比例融合在一起，就能在烘烤的过程中一点点膨胀、定型，变成香喷喷的样子，是不是很神奇？\\n对了，有机会一起来烤姜饼吧？比比看谁能用饼干搭出最高最漂亮的小屋！"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "娜维娅的烦恼…",
      "text": "呃，烤完蛋糕以后散落的面粉好难收拾啊，还有粘在容器里的蛋清和奶油…我、我去叫帮手来！"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我喜欢能带来惊喜的食物，但请不要怀疑我的味觉。我只是欣赏其中包含的创意，但这也不会改变很多菜品难吃的事实就是了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我不喜欢存放了很久的剩菜，感觉辜负了新鲜食材的一生…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "惊人的厨艺！跟你出门的话，我才是应该带着食材和厨具的那个。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "味道真不错，再让我加些摆盘艺术就更完美了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "不要气馁，世界需要这种创新精神。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "你相信许愿吗？向泉水中丢一枚摩拉，然后等待好运降临在头上。我想，只要摩拉丢得够多，其中总有一个愿望能够实现吧？\\n所以与其寄希望于这样的随机事件，我决定直接用一袋摩拉为你实现今天的愿望。只要是我娜维娅力所能及的，一定都帮你办到！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "这种感觉…好像柠檬乳酪蛋糕！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "奶油融化在舌尖，压力也跟着消散了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "你知道有一种子弹形状的巧克力糖吗？它的甜度能瞬间让你全身充满力量，就像我现在的感受一样！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "最后再来一壶熨帖的奶茶，属于你我的茶歇时间就可以开始了。不过你为我做了这么多，用一顿茶点作为感谢还是不太够呀。以后你在枫丹要是有什么需要帮忙的，就来找刺玫会吧！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "小心咯！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "正面偷袭！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "你好呀！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "试着躲躲看？"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "猜我还有几颗子弹？"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "是…伞弹枪？"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "开火！虽然是岩元素啦。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "玫瑰礼花！刺玫会特别定制版。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "持续打击！嗯嗯，就是这样。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "喔！好运连连！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "快，快收好！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "寻宝大成功！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "再…再撑一会儿！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "…得尽到责任！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "注意力集中。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "交给会长吧！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "增援到了！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "就当是…回家了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "是我的错吗…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "就连我也…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "怎么了？"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "哪来的？！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "啊…不算什么！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "说走就走。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "刺玫会出马！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "今天我带路！"
    }
  ]
}