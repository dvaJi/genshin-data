  "outfits": [
    {
      "id": 202301,
      "name": "岁夜欢哗",
      "description": "香菱的装扮款式。冷风中的一抹红色灶火，帽子在胡桃提议下根据锅巴的形象特别设计而成，很受香菱喜爱。",
      "isDefault": false,
      "characterName": "香菱",
      "characterId": 10000023,
      "source": [],
      "filename_card": "UI_AvatarIcon_XianglingCostumeWinter_Card",
      "filename_icon": "UI_AvatarIcon_XianglingCostumeWinter",
      "filename_iconCircle": "UI_AvatarIcon_XianglingCostumeWinter_Circle",
      "filename_splash": "UI_Costume_XianglingCostumeWinter",
      "filename_sideIcon": "UI_AvatarIcon_Side_XianglingCostumeWinter"
    },
    {
      "id": 202300,
      "name": "椒红姜黄",
      "description": "香菱的装扮款式。洋溢着火辣热情的轻便衣装。",
      "isDefault": true,
      "characterName": "香菱",
      "characterId": 10000023,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xiangling_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是来自璃月的厨师香菱，最擅长的是做各种捞…捞，料理…哎呀，练了那么多次，还是会紧张，嘿。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·点心",
      "text": "要吃点点心休息一下吗？我准备了一箩！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·火史莱姆",
      "text": "火史莱姆，是椒盐…还是做成蒜香的好呢？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·觅食",
      "text": "嗯，闲着也是闲着，还不如一起找找食材去！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候·态度",
      "text": "嗯…我不太喜欢雨天。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雨的时候·疏忽",
      "text": "我想想…今天有没有晒衣服出去…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "雨过天晴…",
      "text": "走走走，我带你去找松茸！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "风史莱姆最喜欢在这种天气活动，快趁机多收集点儿！我给你做史莱姆沙冰！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "来得正好！一起去补充点食材吧？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午饭已经做好了，快过来吃哦！啊呜…来晚了可就没了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "要吃夜宵吗？我这正好做了串炭烤岩蜥蜴。哎呀，别盯着了，快尝尝吧！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "喂…你不会是想背着我偷偷吃什么好东西吧？哦，只是休息啊…嘿嘿，那晚安喔。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于香菱自己…",
      "text": "你见过蒙德城的龙？有多大？哇，不是吧。那要是做成龙肉排——嗯，该有多棒啊！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·长处",
      "text": "虽然比起认路我更擅长做饭，但…不管啦，出门喊我准没错！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·新知识",
      "text": "自从认识你，我好像学会了不少料理以外的知识。欸？呃…你问我都有些什么？嗯…嗯…你突然这样问，我又有点想不起来了。算了算了，我原本就不擅长这些，还是给你做两道新菜尝尝吧！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "无论什么时候，我都要做出所有人都爱吃的料理。神一定也认为这是正确的事情，才授予了我这个连大师父也没有的「神之眼」…唔，怎么说来着…哦，以资鼓励！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "如果拉肚子了，喝一杯霓裳花泡的茶就会好的！欸？我懂一点食疗方法也不用奇怪吧！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "我喜欢洋葱！…我试过十几种切洋葱不会流泪的方法，没一个对我有用。但这也阻止不了我喜欢洋葱！"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于白术…",
      "text": "嗯？我闻到了雾虚花的香气！是白先生，白先生来帮你看病了吗？你是哪里不舒服，头晕还是胃疼？还是嗓子痒？还是没力气？哦…没生病啊。那还好。不然白先生会给你超——苦的药哦。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于凝光…",
      "text": "哦！刚才那个，是「天权」大人啊…嗯，你凑过来点。再，再过来点。我跟你说哦，她可是一个特别厉害的人，港内的事情她什么都知道。所以，你也要小心一点，不要被她盯上了…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于胡桃…",
      "text": "唔，你是不是也被胡桃欺负过？她老是趁我不注意躲到我后面，这样突然拍我的后背，得逞了还嘿嘿地笑，哼。但我大人大量，看在她每次都会给我带酿梅花做线花糕的份上，才没跟她斤斤计较。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于迪奥娜…",
      "text": "清泉镇的迪奥娜！啊啊，听说她能调出特别好喝的酒，我专门拜访过她！想着如果能把调酒的秘方借鉴到料理上，说不定也能做出美味。但是，她给我的秘方，比如啤酒里泡蜥蜴尾巴，蒲公英酒里放小块熏鱼…做出来都不是很好吃。呜，果然还是要靠自己吗？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于北斗…",
      "text": "北斗姐姐人特别好！跟着她出去航海的话，每次都能捕获到好多新鲜的食材！章鱼脚拿来煲汤最好，海天青就要用辣椒好好炝一炝。不光北斗姐姐，「南十字」的船员们都很喜欢我做的菜呢。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于钟离…",
      "text": "我遇到过不少挑剔的食客，但像钟离先生那种嘴巴上讲究，还能一针见血的，真的就只有他一个！那天我给他上的第一道菜是「椒盐豆腐」，他只尝了一口，就问我用的是什么盐，然后又说什么「不妨试试孤云阁浅海处提炼的海盐吧，它的层次感能够为豆腐赋予更多鲜味」。我试过之后味道真的大有不同。你说，他是不是好厉害！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于重云…",
      "text": "重云啊，他总是跟着行秋一起来「万民堂」吃饭…呃，或者应该说，是被行秋拖来的？但是重云不吃热食。每次热菜上桌，行秋就会客客气气地说一声「失敬」，然后动起筷子逐一评点起每道菜的美味之处，他那夸得呀，我都想冲过去尝一口！你是没见到重云那种眼神，哈哈哈。还挺有趣的呢，他俩。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于甘雨…",
      "text": "甘雨？嗯…啊啊有印象有印象，是那位只吃素食的客人吧！她来「万民堂」的次数不算多，每次都是一个人躲在小角落里不吭声地吃着饭。我嘛，看她孤孤单单有些可怜，就总帮她多舀两大勺菜。没想到，她每次都能全部吃完！真是不可貌相。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于瑶瑶…",
      "text": "嘿嘿，她啊，是我引以为豪的小师妹喔！不过呀，她很久没来「万民堂」玩儿了。是大师父放心不下吧…哼，明明生的云来大章鱼那么好吃，瑶瑶上次不光不让我吃，还叫上大师父一起训斥我，呜…有时候真不知道，到底谁才是师姐了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于辛焱…",
      "text": "辛焱经常来「万民堂」吃夜宵喔！像行秋、重云他们不敢试吃的新品，辛焱就会毫不犹豫地下筷…而且有八成以上的概率喜欢！哎，真是很不错的人呐。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于夜兰…",
      "text": "夜兰姐？我当然记得她啦。第一次见面时，我还猜她会喜欢那种清淡的菜式，没想到她是我见过最能吃辣的客人！菜肴里的辣味她觉得不够，居然把绝云椒椒直接嚼来吃！真了不起。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于嘉明…",
      "text": "哎呀，知道嘉明要来，我就会早早备上一大壶茶水，方便他涮辣菜。我提议说给他做一份不辣的，但他却摆着手说就喜欢原汁原味的配方…不会错的，那不是客套话，我能分辨出真正食客的眼神！嘿嘿，那我当然也不能让他失望啦！"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于蓝砚…",
      "text": "锅巴很喜欢她！第一天见面就不停地跟她握手，不知道的还以为他们认识了很久呢哈哈！我已经跟蓝师傅约好啦，让她带我去抓昆虫，采野蕈…嘻嘻，等我的新菜创作出来之后，你们都要来吃哦！"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于爱可菲…",
      "text": "啊！那个枫丹的厨师姐姐，我很喜欢她！那天她请我试吃了许多新奇的菜品，里边的口感非常…那个词怎么说的来着？哦，是「精准」！就像用各种味道的食材，在嘴里精雕细琢地制成了一尊雕塑！她对做菜过程中每个环节、每种原料的控制手法，都让我眼界大开。我是不是也该托申鹤去找闲云姨，做个能够定时定量还定温度的机关，再来学学她的手法呢？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解香菱·其一",
      "text": "烤鸽子肉，来两串？哎呀~尝尝嘛。加了我的独门秘方，绝对跟其他家的不一样！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解香菱·其二",
      "text": "大师父教我的枪法，很厉害吧？你想学的话我也可以教给你哦！不过说到这个…要是你愿意跟我学厨就好了！我的这些技巧和配方，要流传得远远的才好呢。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解香菱·其三",
      "text": "问我的愿望吗？那当然是要创造全新的新菜系！璃菜和月菜都是有极限的。哦，关键一定在于辣味吧！事不宜迟，让我爆炒个锅巴辣椒给你尝尝！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解香菱·其四",
      "text": "嗯！我看你已经快被我的厨艺征服了嘛~是时候给你品尝我苦心研制的新菜品了——七彩琉璃大煎饼。喏喏，这薄薄一层蛋皮里面包着红色的松鼠火腿，橙色的胡萝卜，黄色的太阳蛙肉，绿色的嘟嘟莲，蓝色的蝴蝶翅膀…呃？真的不想吃吗？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解香菱·其五",
      "text": "我…有点想不明白，明明以前睡一觉就好了的，这可不是我的风格。啊呀，不行！还是让你来想吧！嗯…我很想让你一直试吃我的新菜，但不知道从什么时候起，如果你吃坏了肚子，我也会特别难受。我，我到底该怎么办呢？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "香菱的爱好…",
      "text": "看着点哦！像这样烧热一锅油，然后，把去掉翅膀的晶蝶这样放下去炸…哎呀你别走啊，超香的啦！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "香菱的烦恼…",
      "text": "呜，史莱姆滑蘑菇一份也没卖出去。就因为卖相不好吗？口感明明很棒的呀…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "喜欢的食物呀，嘿，那当然是尚且不知道味道的新菜啦！欸，我这样回答很狡猾？呜，明明说的是实话嘛。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我是不会对食物有什么偏见的！只有不合适的做法，没有不合格的食物！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "哇，这就是…「噼咔」的味道！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "嗯，你做菜真有一套。下次就换我来露两手吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "难道是做法的问题吗？总觉得哪里怪怪的…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "啊，找到你了！快来，我给你做了一整桌的菜喔！嘿嘿，不用急着夸我，先等你尝过味道再慢慢说吧！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "呼哇~！好爽！全身上下都充满了力量！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "嘿、哈！好！一拳就能把野物打晕…保证食材新鲜！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "有这种力量的话…终于可以…不好，口水要流下来了！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "父亲曾经说过：「想做出十分的菜肴，就要投入十二分的热情。」我懂的、我懂的！能走到今天这个地步，一定是因为有你付出了十二分的热情陪我练习。嗯，那我也要再加倍…用再加倍的热情来回应你！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "锅巴，喷火！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "热和热和嘛。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "开锅了开锅了！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "嘿…哈！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "讲不通，就打扁咯！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "见识下师父的枪法！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "跑起来跑起来！"
    },
    {
      "id": "710001",
      "type": 2,
      "title": "冲刺结束·其一",
      "text": "肚子岔气了…"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "是新的食材！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "大丰收大丰收！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "我会物尽其用！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "呜，今天的食材好凶啊。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "哎呀，疼疼疼…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我是不是惹了个不得了的家伙！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "别着急，歇会儿再打吧？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "快回来！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "搞砸了呢…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "突然…好渴啊…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "是不是…连累你了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "不要打我…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "救命啊，食材打人啦！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "还挺疼的唔…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "佐料带全了！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "长枪磨亮了！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "一刻都不想多等！"
    }
  ]
}