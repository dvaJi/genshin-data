  "outfits": [
    {
      "id": 203300,
      "name": "荣光之刃",
      "description": "达达利亚的装扮款式。标识着愚人众第十一执行官「公子」身份的荣耀衣装。",
      "isDefault": true,
      "characterName": "达达利亚",
      "characterId": 10000033,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Tartaglia_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是愚人众执行官第十一席，「公子」达达利亚。而你——哈，也是能招致纷争之人，实在愉快。我们应该会很合得来吧？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·闲散",
      "text": "在这干站着，也不会有对手找上门的。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·比试",
      "text": "嗯——附近就没有什么值得一战的强敌吗？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·愚人众",
      "text": "不知道其他执行官在忙些什么呢？嗯，算了，无非又是那些莫名其妙的「宏大计划」吧。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "闲聊·雪国故土",
      "text": "在我老家的雪原里这么闲站着的话，早该被冻僵了。哈哈哈。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨过天晴…",
      "text": "雨点打在水面上的声音，会把鱼儿吓跑。相比之下，雨后是钓鱼的好时机。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候·异国",
      "text": "哈哈哈，不知老家那边，是否也在下雪？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候·至冬国",
      "text": "多好的雪！天地都和月光一样干净，在这样的舞台上泼洒的鲜血才格外炙烈。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "啊！风中传来了纷争的气息。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了·异国",
      "text": "真是畅快的风！"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "刮大风了·至冬国",
      "text": "感觉身体和头脑，都被穿过身体的风洗净了。真舒畅。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "哟，伙伴！今天精神不错啊。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "你看起来状态还不错嘛，要不陪我切磋一下？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "哈——吃得真爽。活动活动，消化一下好了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "真是愉快的一天。明天再见，伙伴！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于达达利亚自己…",
      "text": "身为战士，要时刻把挑战之心系于刀尖之上。但无论胜败，都是无可替代的珍贵经历。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·同僚",
      "text": "与你同行的事情，在别的执行官当中，已经传开了吧。哼，真想看看那帮人脸上的表情，哈哈哈。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·兵器",
      "text": "弓，其实是我最不擅长的武器。正因如此，我才要征服它。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·生存",
      "text": "连神之眼也没有的你，竟有这样的力量，真是令人期待啊…在你抵达自己的极限之前，与我放下一切、决一死战之前，绝对不要倒下啊，伙伴！我绝不允许你倒下。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于我们·邀请",
      "text": "伙伴，要不要加入愚人众？嗯，当我没说。以你现在的身份，和你在一起，连光明正大和其他执行官厮杀的理由也有了。这样的机会，实在无法放弃啊，哈。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "只要能让我变强，「神之眼」也好，「邪眼」也好，师承深渊的罪人也好，都无所谓…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "在无尽的雪原里，生命随时都会被碎骨一般的纯白天地吞噬，连足迹也无法留下。为此，我们每日都在与看不见的敌人战斗。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "我曾经在世界的深渊与无名的巨大魔兽对视。总有一天，我会堂堂正正地，将那强大得令我骨髓冻结的怪物斩杀。届时，就拜托你当我的见证者了，伙伴！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于丝柯克…",
      "text": "有多少年没见到师父了呢。哼，下次和她比试的时候，希望至少能逼她用上双手来对付我。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于钟离·掂量",
      "text": "那家伙城府很深，不知真正的实力又如何呢…哼，真令人期待。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于钟离·挑战",
      "text": "钟离先生，最近可好啊？嗯…还不错？看来他倒是挺适应作为「凡人」的生活嘛。可恶…竟然把我骗得团团转，只有痛痛快快地交战一场才能平息这份不甘！\\n你说…我打不过他？哈哈哈…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于「女皇」…",
      "text": "女皇大人其实很温柔。但正是因为太温柔了，所以才不得不变得冷酷。正是因为梦想和平，才要向整个世界宣战。也正是因为她与世界为敌，我才有机会与你相识。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于法尔伽…",
      "text": "法尔伽吗？哼，光是想到，有朝一日能和西风骑士团的顶点、传说中的「北风骑士」交手，就兴奋得颤抖。活在这个世界上，真是美妙。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于「丑角」…",
      "text": "他是愚人众最初的执行官，也是今日执行官们的领袖，只会在大场面出现。至于他的功绩…坦白说，我不关心。我效忠的对象是女皇大人。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于「队长」…",
      "text": "我曾见过他在战场上的模样，实在是过于强悍了。或许我的席位太靠后了吧，让他没有留意到我。但就算今天被他忽视，明天，我也会让他看到我的实力。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于「博士」…",
      "text": "听说他把不同年龄段的自己切片做成了义体，负责不同的任务。没办法，我的同僚都是些不太正常的人。反过来想想，要是某一天，我遇见了自己的义体…哈，肯定得和对方决出真正能活下去的那一个。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于「少女」…",
      "text": "愚人众执行官的席位是按照实力划分的，我不明白那个女孩为什么是「第三席」。有机会的话，我是想和排在我之前的执行官都比试一遍啦，但总有种不太想和她交手的感觉…不管怎么说，你也小心一点。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于「仆人」…",
      "text": "我不讨厌有自己打算的人。毕竟我加入愚人众，也是为了获得更多争斗的机会。但这个人，我不喜欢。如果背叛能够获得收益，她会毫不留情地向女皇大人挥剑。她的眼里只有疯狂。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于「公鸡」…",
      "text": "我不懂什么人情世故。但我知道，他是真心想要帮助我的。他看我的眼神，就像看待家人一样。哦，说到这个，冬妮娅和托克给我回信的时候，时常提到他送去家里的馅饼和礼物。在我暂别冬都期间，他确实按照约定，照顾好了我的家人们。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于「木偶」…",
      "text": "好像是个埋头研究的人？我想想，那些机械是不是都跟她有关啊。总之，仅有几次的见面中，她一副想杀了我的眼神。可我完全不记得做过什么惹她生气的事。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于「富人」…",
      "text": "哦，那个满脑子「宏大计划」的野心家。他的那些理论，我半句都听不进去啊。总之，只要后备资金管够就好啦。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于「女士」…",
      "text": "我和她合不来，你是知道的。如今也不必评价她本人了吧。对于执行官而言，死期并不掌握在自己手上…不过，放心，我是无论如何，都会拼尽全力活下去的。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于「散兵」…",
      "text": "他带着「神之心」与我们失去了联络，后面才有了追回那颗心的行动。我倒是不介意去四处走走，说不定还能在哪儿和你偶遇？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解达达利亚·其一",
      "text": "记住了，伙伴，我是终有一天要征服世界的人！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解达达利亚·其二",
      "text": "无论决斗的对手是神，还是深渊的魔兽，只要有形，就有得胜的可能。但执行官当中，有的人热衷于权术、阴谋那些…「看不见的手段」。我跟那些无聊的家伙合不来。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解达达利亚·其三",
      "text": "这里的天空和故乡的天空是连成一片的。抬头看见雪一样的月光，就能想到，老家的人们也能看见同一个月亮。不知道弟弟妹妹…哈，他们有没有变成出色的战士呢？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解达达利亚·其四",
      "text": "伙伴，不要忘记：厮杀的时候，绝不能用什么「燃烧起来了」之类的蠢话来驱策自己。毕竟，燃尽之后，除了灰烬，什么也不会剩下。无论如何，都要活下去。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解达达利亚·其五",
      "text": "时间过得真快。总有一天，我要让你亲眼看见我征服世界的样子、我把神的王座踩在脚下的样子。哈哈，在那之前，你可绝对不要倒下啊，伙伴！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "达达利亚的爱好…",
      "text": "冰钓和决斗的道理是相通的，关键是耐心与决断。这么说来，同样的道理好像也能应用在人生中的所有事情上？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "达达利亚的烦恼…",
      "text": "嗯？烦恼的事情…哼，与你同行，总是有值得挑战的强敌，根本没空思考这种琐碎无趣的小事。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "这个世界上，充满了美妙的料理和酣畅淋漓的战斗。活着真是美妙！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "食物和武器是一样的。真正的战士不会挑剔兵器，也不会挑剔食物。你也不要挑食啊。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "只要吃到好吃的，心情就会十分舒畅。我该如何回报你呢？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你的厨艺似乎长进了不少。难道你也在不断变强吗？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "真是出乎意料的口感，好…我就再试一次吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "哟，伙伴，生日快乐！有什么想痛打一顿的人吗？有的话，就尽管说出来吧！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "喔！好像变强了一些。找谁试试好了…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "「战士的力量就像一个圆。圆越大，能挑战的人就越多。」欸，这句话是谁说的来着…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "真不错！伙伴，多亏了你，我离「征服世界」的目标又近了一步。就连女皇大人，也不曾料想过我这样的成长吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "伙伴，你也要好好锻炼自己才行！不然的话，等我到达了世界的顶点，又有谁能与我殊死厮杀呢？哈哈哈。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "要上了！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "哈！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "势如狂澜！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "来吧！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "接下来——"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "呼——"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "一箭止水！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "逃得掉吗！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "破绽，稍纵即逝！"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆发·其四",
      "text": "忍着点，这可是很痛的。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "兵贵神速。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打开风之翼·其一",
      "text": "呵，感觉不错。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "好！再去寻找更多的宝藏吧！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "相当不错！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "真让人摩拳擦掌！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "哈！有点意思。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不赖嘛！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "生死边缘而已，我很擅长处理。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你们，最近是不是缺乏锻炼啊？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "闪开！这里让我来！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "怎能这样…得而复失…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "失手了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "还挺…有两下子…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "嘁！大意了。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "哈，强敌何在？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "睁大眼睛看着吧！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "真让我好等！"
    }
  ]
}