  "outfits": [
    {
      "id": 204700,
      "name": "叶落天涯",
      "description": "枫原万叶的装扮款式。染有枫叶纹样的浪人衣装。",
      "isDefault": true,
      "characterName": "枫原万叶",
      "characterId": 10000047,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Kazuha_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "「飘摇风雨中，带刀归来赤脚行」…我的名字是枫原万叶，游历四方的浪人。既然你我都在旅行的路上，这段路不妨结伴同行。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·自然",
      "text": "见到了这么美丽的景色，自然会产生云游四海的想法吧？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·吹奏",
      "text": "既然手边有树叶，我可以为你吹奏一曲。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·剑技",
      "text": "飘摇风雨中，睹物思故乡，这把刀…是我与故乡唯一的联系了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "在大雨中漫步，让人神志清醒。不过等雨停之后，还是尽快把衣服烤干比较好。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "比起在海上航行时遇到的雷暴，这倒也算不上什么。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "我喜欢下雪，雪后的世界很安静，无人来扰我清梦。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "晴空万里，真让人心情愉快。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "清晨的鸟鸣，是大自然的馈赠。启程吧，属于我们的旅途也要开始了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "正午的阳光，让人想要小睡片刻。找个地方休息一下如何？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "抬头见月，侧耳听风，壶中有酒，我心太平…\\n晚上好。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "风停了…\\n安静的世界，适合好好休息。明天见。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于枫原万叶自己·航行",
      "text": "其实，大海并非每晚都充满风浪。天气清朗的时候，月光倒映在摇晃的海面上，鱼群在船舶的周围随行。我坐在船头眺望远方，会觉得这段旅程非常值得…唯一的遗憾是水手们的歌声太吵了，他们不用睡觉的吗？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于枫原万叶自己·贵族武士",
      "text": "枫原家曾经也是有名的武士门第，可惜传承到我这里时，除了贵族的名号外已经别无长物。不过对我来说倒也足够了，武士不需要富足的生活，我们需要的是诗歌、美酒与手中的刀。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·出海",
      "text": "找个好天气，出海看看如何？"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·畅谈",
      "text": "我喜欢性格爽朗的人，这样相处时可以畅所欲言。有什么想说的不必藏在心里，我能够听到自然万物的声音，其中也包括你的声音。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "在我看来，神之眼是力量的「证明」，而不是力量的「来源」。神之眼象征的是凡人继续向前的愿望，而我们武士的底气，一直都是手里的刀。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·竹刀",
      "text": "想学剑道的话…我想想，拿着这个吧，这是我刚刚做好的竹刀。用这个切磋的话，我们就都不会受伤了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什么想要分享·枫叶",
      "text": "「深山踏红叶，耳畔闻鹿鸣」…我很喜欢枫叶，可惜枫叶红时总多离别。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "海鸥别叫啦，从今天起，我也是漂泊者呀。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于北斗…",
      "text": "北斗大姐头是我的恩人。大姐头她收留了从稻妻逃出来的我，并在我最困难的那段时期里，给了我重返稻妻的勇气。她是我和所有船员可以托付后背的战友。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于五郎…",
      "text": "我在被通缉的那段时间里，反抗军给了我许多帮助。那时候我与五郎只有短暂的接触，但我对他的印象很深刻。他是那种有话就说的直性子，与部下同甘共苦，为朋友两肋插刀，与我很合得来。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于九条裟罗·态度…",
      "text": "能在御前决斗中战胜我的朋友，我确实认可她的实力。但她却用这样的力量为虎作伥，带领九条军不断回收「神之眼」，我无法原谅。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于九条裟罗·改观…",
      "text": "原来如此。看来她也有自己坚持的信念。只是不知道风波平息后，「九条」家还能否延续曾经的昌盛。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于雷电将军…",
      "text": "离开稻妻后，我许多次扪心自问，我对雷电将军的不满是否源于那一次御前决斗，是否源于她对友人落下的那一刀？\\n我想了很久，觉得不是的。我的友人是堂堂正正地死在了决斗场上，雷电将军的那一刀也并无不妥。我对她的不满，来源于「眼狩令」。没有任何人有资格剥夺他人的愿望，即便是「神」也不行。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于神里绫华…",
      "text": "生活在稻妻的人，应该都听过「白鹭公主」这个名字吧。神里家的大小姐，近乎完美的一个人，不过我跟她没什么交集，不知道她对如今的稻妻抱有怎样的看法。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于宵宫…",
      "text": "上次她托大姐头把烟火运到璃月，还是我亲自去卸的货。好沉！除了她以外，应该没人能造出这么大的烟火了吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于珊瑚宫心海…",
      "text": "我在反抗军的时候，周围的同伴无不对珊瑚宫大人充满敬仰。她爱惜兵力，很少会做出不计死伤的打法，总是能够用最小的代价取得胜利。听说她还要统管海祇岛的政务和外交，真的忙得过来吗…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于鹿野院平藏…",
      "text": "别看我这位侦探朋友平日里潇洒随性，一旦他办起案子来，那些原本围绕在他身旁活泼灵动的风，就聚成了凌厉锐气。确实让人钦佩。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解枫原万叶·其一",
      "text": "想要了解我的事？如你所见，我只是个随处可见的流浪武士。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解枫原万叶·其二",
      "text": "我的耳朵很敏锐，能够听到各种各样的声音。比如风吹过山岗的声音，云散开的声音，林间的小狐狸啃咬苹果的声音，螃蟹吐泡泡的声音…这是自然万物对我的眷顾，让我总能提前发现危险的到来。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解枫原万叶·其三",
      "text": "小时候我很喜欢下雨，那种沙沙的声响容易给人一个安稳的梦。但长大了以后，对雨的感情就变得复杂了许多…虽然依旧喜欢听雨，但每次看到乌云的时候，却又忍不住感叹「今天能不能找到好心人让我借宿呢」。穿着湿漉漉的衣服听雨，往往会被喷嚏声打断了情调。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解枫原万叶·其四",
      "text": "我不会在一个地方驻足太久。因为太久的停留会让我跟「自然」产生隔阂，也会让我手里的刀变钝。趁我还能远航，我希望自己能去各种各样的地方，见到不同的人们。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解枫原万叶·其五",
      "text": "不必担心，就算有一天我们去往不同的地方，也一定会在世界的某处再次相遇。人与人的「缘」不是那么容易就断掉的东西。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "枫原万叶的爱好…",
      "text": "躺在被正午的阳光晒暖的岩石上休息，醒来后继续漫无目的地前行。只要与刀相伴，我可以去任何地方。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "枫原万叶的烦恼…",
      "text": "每逢风暴降临的时候，「自然」的声音就会变得嘈杂，我的耳朵也会嗡嗡作响。如果是在晚上的话，往往会辗转许久都无法入眠，让人有些头痛。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "在大海上航行时，最容易获取到的食材便是鱼肉。怎么样把鱼做得好吃，是每个在海上冒险的人都要思考的问题。有机会的话，也想让你尝尝看我的手艺。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我呢，不是特别喜欢那些粗制的食物。在我看来，就算是一条普普通通的鱼也要烧得好吃才行，吃东西本应是让人身心愉快的事情，怎么能将就呢？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "能将鱼肉烹调出如此滋味，你的手艺当真了得。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你做的饭菜不仅能够饱腹，对我而言也是慰藉。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "要休息一下吗？内心疲惫的话，做出来的菜也会失去风味。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "哈…得知今天的生日，我特地写了新的诗歌。只可惜诗才不佳，几个晚上只想到前两句，就先送给你吧。\\n「流光换日月，鹤归云起庆生时」…欸等等，先别说话，我有灵感了。最后一句…「异乡有故知」，如何？\\n生日快乐，今天一起去…吃点甜品吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "这把刀，更加锋利了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "雪落在地上的声音，细不可闻…但现在的我，应该可以听到了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "海上的风浪很大，我也要变得更强。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "行走世间，自然会有各种烦恼相伴，但既得与你相遇，不管是武艺还是内心都有了新的成长。想必今后的人生也会更加自在吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "起！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "嘿！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "踏风！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "御风而行。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "朔风解意。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "往返自然！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "云隐…雁鸣！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "风共云行。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "可叹，落叶飘零。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "该出发了。"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打开风之翼·其一",
      "text": "顺着风的方向。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "令人快慰。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "天地的馈赠。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "偶遇珍宝，是云游四方的妙趣之一。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "呼、有一套嘛…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "静心凝神。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "保持专注！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "换我来保护你了！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "你可以把后背交给我。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "深感遗憾…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "下次…绝不会再…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "结束了吗…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "不要…紧。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "好痛！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "要带上我吗？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "出发出发。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "就这么做吧。"
    }
  ]
}