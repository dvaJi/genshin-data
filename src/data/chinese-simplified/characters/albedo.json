  "outfits": [
    {
      "id": 203800,
      "name": "朔分星芒",
      "description": "阿贝多的装扮款式。阿贝多实验时常穿着的西风骑士团炼金术士制服。",
      "isDefault": true,
      "characterName": "阿贝多",
      "characterId": 10000038,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Albedo_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是阿贝多，西风骑士团首席炼金术士。我对你身上星海的气息很感兴趣，想要就近观察研究。相信以后我们会有很多独处的机会。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·写生",
      "text": "风景不错，趁着休息，就把这一幕画下来吧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·探究",
      "text": "「世界的真相」…究竟是什么呢？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·怀旧",
      "text": "用自己的双脚丈量土地，将「未知」变为知识。…这种感觉，真怀念啊。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "土壤湿润，适合采集爆爆瓜的根。没事，我来动手就可以。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候…",
      "text": "师父…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "阳光很好…",
      "text": "光线充足，生物行为活跃，嗯，很适合写生。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早安，是准备出门寻找古代遗物吗？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午安，我听到了你的脚步声。工坊之外真是热闹啊。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "外面安静下来了，呼。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安，你先去休息吧，我打算把最后一个实验做完。既然你那么感兴趣…明日再会时，我再与你一起探讨实验结果吧。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于阿贝多自己·天才",
      "text": "天才？…不少人这么称呼我。其实，我不这样认为。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于阿贝多自己·人际",
      "text": "与人交往…很麻烦。一旦开始就要不断维持，如果联系中断了，想再重新恢复，就得消耗更多的时间。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·实验",
      "text": "你…这是准备陪我做实验吗？呼，真荣幸。\\n啊，不用紧张。我的实验虽然危险，通常不会伤及无辜。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·助手",
      "text": "能麻烦你当我的助手吗？鉴于你旁观了那么多次，想必早就熟练了吧。放心，我在你旁边。就算是第一次实际操作，也不会有问题的。我相信我的指导能力，更相信你的天赋。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」？不过就是个实验用的工具罢了，和烧杯、坩埚没什么不同。唯一让我感兴趣的，就是它的原理…我总有一天会研究明白的，这只是时间问题。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "一直有些难以开口，因为假设被你拒绝的话，我可能会失落吧…\\n嗯…我对你身边那个飞着的小家伙很感兴趣，方便让我拿去研究一下吗？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "想知道更多石化古树的事情？唔…你在附近秘境里观测到的那些，其实不算古老。稍微成熟一些的树，一般能长到两三公里高；在树的根部，常常聚集着一种大蜘蛛。那种蜘蛛啊，用地栀子和香茅草捆紧，抹上白豆蔻，熏烤上几个小时，那香味，是真的很…令我难忘。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于亲人…",
      "text": "亲人吗？虽然艾莉丝总希望我喊她妈妈…唔，但在我心里，谈起亲人第一时间想到的还是师父吧。我从记事起就和她在一起探险了，她教会了我炼金术和无数世间的知识。或许…「亲人」或者「师父」，这些词汇都不足以描绘出她对我来说的意义吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于砂糖·方向",
      "text": "砂糖吗？我大概能理解她一心专攻「生物炼金」的理由…不管怎样，看到她的研究越来越顺利，我也为她感到高兴。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于砂糖·坚持",
      "text": "虽然在学术方面的合作非常愉快，但课题以外的部分，砂糖也有很多她自己的坚持。比如我告诉她我们是平辈，叫我阿贝多就好，她却坚持要用尊称。…只好随她去了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于丽莎…",
      "text": "丽莎吗？和她讨论总会得到很有价值的观点。如此有才华却满足于图书管理员一职，想必背后藏着与那才华等重的因缘吧。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于可莉…",
      "text": "我的确把可莉当作亲妹妹一样看，所以每次当这位妹妹惹出麻烦的时候，我都只能安慰自己，至少她现在的破坏力，还不及艾莉丝女士的零头。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于琴…",
      "text": "琴吗？她是一位正直的代理团长，甚至可以说比那位团长大人更为可靠。可能大家心中都在期待着她成为正式团长的那一天吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于行秋…",
      "text": "行秋吗？他写的小说挺有趣的。稻妻那边的「八重堂」一直在旁敲侧击希望让我和别的作者合作，说这样版税收入也会更好。哼，我缺这点钱吗？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于芭芭拉…",
      "text": "芭芭拉吗？她是一位认真的牧师，说来以前碰巧有机会给她画过速写…你问画哪儿去了？嗯…我拒绝了艾伯特的开价，直接把画送给了代理团长。人际交往…真是耗费精力啊。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于杜林…",
      "text": "我的这位兄弟正在探索很多新事物，他很聪明，也热衷于思考。尽管他时常因此陷入某些认知困境，但这并不妨碍他对这个世界保持热情。他的到来，或者说，他作为家人的到来让我对人类关系的理解有了新的心得。现在，有了最亲近的同类，家里变得热闹起来，这无疑是一种好的改变。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于布伦妮…",
      "text": "她时常找我探讨「存在的本质」。不过，每当我提出几个反问，讨论就会提前结束。值得高兴的是，她下次还会带着写满答案的笔记本再来。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解阿贝多·其一",
      "text": "有问题想问我？请说吧。啊，冒昧地问一句，应该不会花费太长时间吧？手头的研究马上要进入最后一个阶段了。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解阿贝多·其二",
      "text": "啊，只是随口一提。不人为介入的话，黄金需要杀死一个八倍大的太阳才能自然生成。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解阿贝多·其三",
      "text": "人物画的耗时主要和心情有关。有时候霍夫曼我也能画半天，有时候凯亚都只需要三笔——这个圆是脸，这个是眼罩的带子…这个是眼罩。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解阿贝多·其四",
      "text": "除了画画和研究之外的生活…我偶尔会去看稻妻和璃月的小说吧，能看到很多很有趣的想法，有时也会为创作提供意想不到的灵感。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解阿贝多·其五",
      "text": "即便到了现在，师父传授给我的「黑土之术」仍是充满了谜团，师父到底想要用这个技术创造出什么呢？…研究之期还远未到尽头，得麻烦你和我一起继续探索了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "阿贝多的爱好…",
      "text": "嗯…研究之外我最愿意花时间去做的应该是画画吧。一开始只是为了理解物体与材料的构成，便于研究开展，不过到了后来就变成了爱好。嗯，也是一种很好的放松方式。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "阿贝多的烦恼…",
      "text": "时间真是不够用啊，即使把大部分麻烦的事情都推掉还是会觉得时间不够。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我挺喜欢甜点的。怎么说呢…在体力和精力同时消耗殆尽的时候，高能量的物质会提供原始而高效的支持吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "讨厌的食物？餐馆里分量比较大的肉吧。我的胃口吃不了多少，只会面临「浪费」或者「失去风味」的结局。后来我就干脆不去餐馆了，虽然这也意味着要花更多时间在做菜上…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "味觉仿佛折射出了色彩…我想它是金色的。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你似乎很愿意花时间在做菜上，所以才能做出这样的味道。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "量有点大…要一起分享吗？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐。你看起来很高兴，可以将你的样子画下来吗？大脑的容量是有限的，人总会不断忘记。如果画在纸上，那么这些画就成了记忆的延伸，在未来重新看到这些画面时，一定能回想起当时的感觉吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "「黑土」，是炼金术的词源，也是最初的状态。活在这个世界上，我等俗类必须寻找意义。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "「白垩」，即是变化的开始。抽离了杂质，准备好接受一切知识。要和我一起去探索世界吗？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "「赤成」，炼金术中的意思是，情感的炼化。我的赤色好像来自于你。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "「黄金」，炼金术最后的阶段。无价值的事物终于找到了自己的意义，变化成了黄金。我，也找到了意义。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "绽放吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "拟造阳华。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "创生之法。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "此即，诞生之刻。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "冥古，于此显生。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "见证伟业吧。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "大地的秘宝。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "无言的叙事。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "虽无法比拟「黄金」，但终有价值。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "计算失误…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "需要重新评估…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "必须改变策略。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "交给我吧。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "换人，对你来说太危险了。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "尘归尘，土归土…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "实验失败了吗？"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我的研究，结束了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "阈值以内…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "失算了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "了解。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "是拓展课题吗？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "一起探索吧。"
    }
  ]
}