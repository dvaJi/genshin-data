  "outfits": [
    {
      "id": 202400,
      "name": "赫浪连涛",
      "description": "北斗的装扮款式。充满踏浪者气魄的轻便裙装。",
      "isDefault": true,
      "characterName": "北斗",
      "characterId": 10000024,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Beidou_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是北斗，听过我的「南十字」船队吗？如果你也喜欢冒险，那就跟着我吧。我罩你。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·切磋",
      "text": "想切磋的话，我随时奉陪。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·畅饮",
      "text": "啊——干完活，喝口酒。真畅快。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·陆地",
      "text": "难得在陆地上逗留那么久，居然有点不习惯了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "被困荒岛的时候，雨水就是宝贵的淡水来源。嗯…虽然现在是用不上啦。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "喂，打雷而已。在海上不用怕，在陆地上，就更不用怕了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "起风的时候…",
      "text": "这天气，很适合出航啊。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "刮大风了…",
      "text": "注意扬起来的风沙，别揉眼睛。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "哟，早。我准备出发了，一起来？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "去香菱那吃午饭吧。你别说，这大锅热油炒出来的，还真和海上的烤鱼腌肉不一样。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "好，出发喝酒去喽！嗯？哈哈哈，平时没人卖酒给你是吧？那不如——"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "这时间过得可真快。去吧，一帆风顺。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于北斗自己…",
      "text": "航海准备，兄弟们，各就各位，全新的冒险要开始了！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·称呼",
      "text": "我是老大，你是我兄弟，没问题吧？哈？这些叫法太老土？行。那就按你喜欢的方式叫吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·识人",
      "text": "我认人很准。当你见过大海，那么普通人脸上的小水花，可就太好读懂了。哈哈，所以，我第一眼就认准了你这个家伙。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·选择",
      "text": "你是我选择的船员，是我选择的兄弟。就说这一点，都够我自豪很久。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "在那些没有「神之眼」的家伙心中，拥有「神之眼」，获得了神的认可的人，应该是旗帜吧。那么，旗帜就该有旗帜的样子。我是这样鞭策自己的。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "遇到难题了吗？不知道如何向前的话，总之先迈出第一步，后面的道路就会自然而然地展开了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "每次远航回来看见石鸢的时候，就说明差不多快到家了。海上的景色看多了难免单调，相比之下，虽说是猛禽，但那副自在翱翔的模样，总觉得亲切可爱。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于凝光·璃月七星",
      "text": "凝光啊，从「璃月七星」的角度上来说已经做得很好了吧。只是，我要负责的对象从来就是我的船和兄弟们，不是什么「璃月七星」啊。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于凝光·态度",
      "text": "凝光一向不怎么坦率，但她曾经很直接地表露过对我的不满。哈哈，不过啊，喜欢和讨厌都是她自己的事情，我是不可能动摇的。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于香菱·好厨艺",
      "text": "香菱的一手好菜，可是我们一众人在远航时的念想。没力气的时候，要是想想干煸绝云椒椒那满嘴留香的滋味，都能精神几分。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于香菱·试吃",
      "text": "香菱啊，她偶尔也会用一些说不上好滋味的食材，做出一些很是了不得的味道。不过嘛，没有尝试就不会有进步，我倒是挺乐意帮她试吃的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于钟离…",
      "text": "你说「往生堂」的那位先生吗？兄弟们有时会聊起他的传言，听上去是个很有意思的人啊。嗯，有机会去结交一下吧。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于魈…",
      "text": "有一年海灯节前夕，船队在归航时遭遇了风暴，紧赶慢赶才在入夜时分回到了璃月港。那时候海灯早就散了。我却在孤云阁的方向，看到了空中悬着一个少年模样的仙人。想必就如传闻一样，在人们看不见的地方，也有人在守护这个璃月港吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于甘雨…",
      "text": "我和甘雨那丫头私交不错！但你也知道，她是「璃月七星」的秘书，「七星」不待见我那可不是一天两天了。哈，我倒是无所谓，要连累了那丫头可不行。嗯，对外还是保密得好。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于辛焱…",
      "text": "哈，很有意思的丫头！船上的兄弟们也有喜欢听她「摇滚」的。嗯…我本人？怎么说呢，虽然在某些方面跟辛焱有共同话题，但我的音乐品味却是另一方面的…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于瑶瑶…",
      "text": "瑶瑶这个小家伙啊，总是爱到船上来玩。但她那副扑闪着眼睛，见什么都新奇的样子，让谁都狠不下心来赶她走。唉，差点要打乱出航的计划。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于枫原万叶…",
      "text": "听说万叶那小子在天守阁外挡了雷电将军的一刀，不简单嘛！嗯…战争结束后，他回了我们南十字船队，说是继续和我们同行一段时间。我当然是非常欢迎了，如果哪天他决定要独自踏上下一段旅程，我再打一壶好酒为他送行，哈哈。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解北斗·其一",
      "text": "想要踏上我的「死兆星」号，得先回答我一个问题。大海之中充满凶险，告诉我——你为什么想上我的船？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解北斗·其二",
      "text": "那些关于我的传奇故事？哈哈哈，那是兄弟们看重，才在夸我的时候添油加醋。不过，你要问我怕不怕在出海的时候遇到什么魔物，那自然是不怕的。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解北斗·其三",
      "text": "问我帮助平民的用意？哈，哪有什么用意不用意的。谁的人生还没有个低谷。我的帮助是小事，但对他们而言，迈不迈得过去那道坎，可能就是两条路啊。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解北斗·其四",
      "text": "我经历过痛苦的时光。小时候没摩拉买吃的，只好偷人家树上的果子，讨了几年生活。等到有了自己的船队，还是被趾高气昂的商人们排挤在外。但是，这些事当作茶余饭后的笑谈讲给你听，就足够了，我绝不会让你再经历一遍。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解北斗·其五",
      "text": "追随我的兄弟有很多，我问过，我也记得他们每一个人上船的理由。你是很特别的。我知道你还有需要完成的事情，我不会授予你职务和头衔。但无论你的旅途去往何方，「死兆星」号上，永远都有你的位置。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "北斗的爱好…",
      "text": "爱好啊…我想想。冒险算一个，掌舵算一个，交朋友算一个，喝酒算一个，吃好吃的算一个…啧，一个手都数不过来啊。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "北斗的烦恼…",
      "text": "搞得定的事不必烦恼，搞不定的事烦恼也没有意义。我就这样过得快快活活的。哦，要是你遇到什么想不通的事情，你可以来找我。我帮你一起解决。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我喜欢味道重的菜！什么炝炒肉片啊，麻婆豆腐啊我就很喜欢。能填饱肚子，大家围坐一圈一起吃的时候，气氛也会变得火热火热的。哈，说得我都想去吃一顿了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我不太喜欢吃凉菜冷盘。有这慢悠悠开胃的功夫，鱼都能烤熟几条了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好味道，我喜欢！有米饭吗，帮忙添两碗？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你的手艺真不错，让人心情也变得不一样了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "菜是好菜，这就够了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "来，上船。我早就跟兄弟们约好把时间腾出来了，吃的喝的也都准备好了。今天你生日，让你做一天老大。哈！嗯，想去哪？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "痛快！又变强了不少。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "这满载而归的滋味，开瓶美酒来庆祝吧！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "好样的，有你这种得力的兄弟，是我北斗的荣光！我也不能让你小瞧了啊。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "这几番操练下来，算是达到了我武艺的巅峰状态了吧。谢谢你…对了，不如再陪我过两招吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "闪开！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "哈！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "悉数奉还！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "接下吧！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "——喝啊！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "这是斩灭「海山」的力量！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "给我瞧好了！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "化作焦炭吧！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "哟，真让人开心。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "不错嘛，又有收获了！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "找到了财宝，就来喝酒助兴吧！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "还没完呢！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "哼，我来精神了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我绝不屈服。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "到我身后！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "退下！别逞英雄。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "糟透了。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "兄弟们…先…撤…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "全员…归航…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "区区小伤。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "输赢还说不定呢。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "有两下子。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "好，出发吧！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "跟我来吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "我相信你。"
    }
  ]
}