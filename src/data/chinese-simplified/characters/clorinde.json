  "outfits": [
    {
      "id": 209800,
      "name": "荣光之剑",
      "description": "克洛琳德的装扮款式。在没有力量作为担保的情况下，法律的尊严和正义的秩序难免显得脆弱。而身着工作制服的克洛琳德成为了最凌厉的震慑。",
      "isDefault": true,
      "characterName": "克洛琳德",
      "characterId": 10000098,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Clorinde_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "枫丹廷决斗代理人，克洛琳德，向你致意。如需雇佣我进行代理决斗，请先陈述你所陷之纠纷…无需赘述人情，这与我无关。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·对手",
      "text": "我在决斗中遇见过不少对手，他们大部分都落败了，剩下的则主动投降…我有没有输过？没有。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·决斗代理人",
      "text": "决斗代理人是我的职业，我怎么想并不重要。因为握紧长剑之时，我代表的是枫丹的律法与规则。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·制胜诀窍",
      "text": "决斗是意志的对战，剑则是决斗者心灵的延伸。如果你的心已然畏缩，那你的剑也会如同裹鞘一般，无法斩败任何人。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "猎物会在雨天休息，但猎人不能。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "看来风和云的对决分出胜负了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的时候…",
      "text": "希望世界上能少个恶徒。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候…",
      "text": "真新奇。但也够冷清的。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "我从来没这么想念过枫丹。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好。我正准备去喝杯咖啡，一起吗？我自带咖啡杯，如果你需要，我可以借你一个。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "抱歉，现在还是我的工作时间。这份三明治给你，先吃点垫垫吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "很抱歉不能和你分享品酒心得，但我可以向你推荐几家颇具特色的冷门餐馆。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。我维护好武器后也会休息。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于克洛琳德自己·新闻报道",
      "text": "报纸上总是存在着一些谈不上公正，也绝不算正义的报道。撰写它们的人都被人情与摩拉带偏了心。\\n如果你想知道某件事的真相，最好的方法是去找相关的人，用你自己的嘴发问，用你自己的心去理解。\\n至少，别让其他人的舌头代替你的头脑。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于克洛琳德自己·铳枪与长剑",
      "text": "我的武器装备遵循逐影猎人的传统制式。铳枪用来驱赶猎物，长剑给予它们致命一击。\\n当然，代理决斗时我一般只用长剑，踏上决斗场的人已经无路可逃，用不着再做驱赶。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·仪式",
      "text": "在每次决斗开始前，我会用浸了特制药水的软布擦拭武器，一方面是为了保养，另一方面是为了让自己保持沉静，排除杂念。\\n作为执剑者，你应该也有自己的仪式吧？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·人与魔影",
      "text": "我的许多习惯都承袭自逐影猎人的传统。他们对抗的是邪恶魔物，而我对抗的则是不法凶徒。但魔物本就生来邪毒，这是它们的本能，那些堕落的人本来有行善的能力与机会，但他们却自寻恶孽。\\n你呢？你持剑的理由是什么？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "在我获得「神之眼」后，在决斗中向我投降的人数明显增加了不少。有的代理人说，这枚「神之眼」是我进行决斗时的「震慑手段」。\\n我还以为我从未败北的决斗战绩才是「震慑手段」，或许我以后的决斗应该赢得更有表现力一些。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "我曾多次见证某些矛盾琐事，被当事人基于纯粹的感性反复咀嚼，最终演变成一桩事关人身尊严，不可退让的惊天耻辱，闹上审判庭，甚至引发一场荒诞的决斗。\\n作为决斗代理人，我对于用决斗来维护名誉这件事没有意见。但是…怎么说呢，从一个普通的枫丹市民角度来看，咖啡里到底该不该加茉洁草，实在不见得是一件非要用剑来论证的事情…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "见过蓬蓬果吧？它们飘飞的速度和位置不易捉摸，很适合作为枪靶练习射击。但是，去野外找蓬蓬果很不方便，要是有人愿意人工培育蓬蓬果就好了…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于夏洛蒂…",
      "text": "夏洛蒂小姐是一位识趣的记者，我对她没什么坏印象。\\n毕竟，夏洛蒂小姐既不会在上班的路上堵截拍摄我，也不会跟踪我去咖啡馆，记录我今天喝了什么咖啡。最值得称赞的是，她明确地知道，我不接受记者采访，所以不会来自讨没趣。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "从前参加茶会的时候，我总是扶着剑站在她背后，现在我却能在长桌对面就座，与她分享茶点。\\n位置变化之后，我开始理解为什么她会成天念叨着「控制体态」了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于娜维娅…",
      "text": "娜维娅最近心情很好，隔几天就会拉我去「桌上剧团」玩新剧本。\\n选材五花八门。除了担任了几次剧本主持人，我也作为玩家和她共同参与了几场冒险。但我会尽量避免扮演和审判庭有关的角色，防止气氛变得太过严肃…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于那维莱特…",
      "text": "最高审判官的权威无可置疑，他总是能做出最公正的判决。必要的时候，我也会用剑再次强调判决的公正性。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于夏沃蕾…",
      "text": "夏沃蕾队长，我听说过她的大名。她曾经因为抓捕凶犯时的手段太过强硬，而遭到过几次起诉。她应诉时态度依然十分强硬，将对方驳得哑口无言，实在出色。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于林尼…",
      "text": "这位大魔术师的职业素养值得称赞。如果有空的话，我会以观众的身份享受他的魔术表演。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于菲米尼…",
      "text": "有天我收到了一个包裹，装着迷你机械玩具和表达谢意的卡片。那份玩具十分精致，下次有机会，我会对菲米尼先生当面表达一下感谢…最好不要当面？好吧，那我也写份卡片，请你帮我带给他。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于千织…",
      "text": "我买过她家的衣服，质量不错。但平时，我更习惯穿现在这套工作制服，一方面它可以明确地阐述出我的身份，另一方面是因为我喜欢熟悉的事物。这套制服就像是我的剑，熟悉且适用，不必多做更换。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于莱欧斯利…",
      "text": "梅洛彼得堡并不是一处好打理的地方。能让那个地方保持相对的稳定，莱欧斯利的手腕无可置疑。\\n其中应该不乏一些不能明说的手段，这就不是我们能知道的了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于希格雯…",
      "text": "希格雯小姐是一位优秀的护士，既擅长治疗身体的伤痛，又懂得如何疗愈人的内心。即使是梅洛彼得堡里的那些心怀恶孽的凶徒，想必也会被她的美德和善心感动，内心涌起一丝善念。\\n这一丝善念，或许就能成为他们踏上改邪归正之路的契机。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于艾梅莉埃…",
      "text": "我听说过这名香水设计师小姐，对她真正的职业也有所耳闻。偶尔一次，我遇到她正在抚摸一只路边的小狗，脸上挂着温和的笑意。我们互相点头后就道别了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解克洛琳德·其一",
      "text": "决斗代理人的工作并不繁杂，甚至可以说十分简单。遵循审判庭的要求，击败对手就好。除此之外，无需多想。\\n…也许这就是外面有些人把我称为「刽子手」的原因。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解克洛琳德·其二",
      "text": "进行代理决斗时，我会尽可能保证与对手公平较量。如果对手有眼疾，我就会蒙住眼睛，如果对手腿脚不便，我则会限定自己的移动范围。无论如何，我所参与的必须是一场公平的决斗。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解克洛琳德·其三",
      "text": "我见过太多人临阵投降。连拔出武器的勇气都没有，所谓的冤屈和名誉受损，想必也只是自私的一家之言罢了。\\n他们早已被自己击败，无需我动手，就自愿变成了心灵的囚徒。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解克洛琳德·其四",
      "text": "你见过审判庭上的罪人吗？在我所经历过的审判里，罪人们总会强词夺理，将自己伪装成好人。在他们口中，暴行变成义举，罪恶变为正义…但他们狡辩的终点却总是一句话——自己虽然一时糊涂，但这罪过人人都会犯，实在无可指责。\\n他们掩盖自身污秽的方法，就是污染整片水源。\\n而击碎这群罪人们的谎言，为正义之廷激浊扬清，正是我成为决斗代理人的理由。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解克洛琳德·其五",
      "text": "我见过许多想要在审判庭上寻求温和人情的人。我并无不敬，但他们来错了地方。\\n审判庭是昭示公理正义的场所，而正义总是…也必须冷漠，否则它就无从延续。\\n如果正义掺杂了人情，那么它有时候就容易被误导偏折，让基于公理执行的「审判」变为由人情驱使的「私刑」。而审判庭中的「私刑」，与那些违律的凶恶暴行无异。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "克洛琳德的爱好…",
      "text": "与代理决斗不同，「桌上剧团」主持人的身份，能够让我游离于故事之外，在不卷入人情冷暖的情况下观察人们的种种反应，为他们搭建出一个受我掌控的世界。嗯？你说听起来像看着笼子里的猎物？有道理…是我没有思考过的角度，不过我从来不会为难玩家，尽量都让他们开心地体验故事，这点和打猎还是很不一样的。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "克洛琳德的烦恼…",
      "text": "希望那些记者不要再打扰我喝咖啡、买花和看书。否则我会考虑抓两个典型向审判庭起诉。如果他们申请代理决斗，我会让他们带着留影机上场的。公平起见，我也会只带留影机。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "用肉类做的菜肴都不错，但肉一定要新鲜。刚猎下的肉用盐简单调味后烤制，旁边搭配上微酸的水果，味道十分不错。下次有机会的话，随我去打猎，我做给你尝尝。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "鱼类不合我的胃口，一方面是刺太多，另一方面则是有一股腥味…或许我在儿时已经吃够了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "完美的味道，很合我口味。别让记者和美食家发现，他们只会用镜头和报纸享受美食。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "嗯，不错的美食，很适合慢慢品尝。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "…幸好这道菜并非出自餐馆，避免了一些厨师和食客之间的矛盾。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#生日快乐。这短剑样式的项链由我亲手打造，送给你作为礼物。\\n按照逐影猎人的传统，在新成员作为逐影猎人度过第一次生日时，教导这位猎人的导师会为{M#他}{F#她}亲手打造一柄刻有姓名的短剑项链，并让{M#他}{F#她}把它时刻挂在胸口。这象征着用剑锋指问自己的内心，是否涉足恶孽，是否心有旁骛，是否有决心逐灭邪魔。\\n虽然你不是逐影猎人，但我相信你和我们一样，有着惩恶扬善的决心。\\n为什么样式不是铳枪？因为铳枪会走火，指问内心的手段太直接了也不行。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "原来如此，的确有所长进。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "剑挥舞时的手感更好了，完全能适应。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "眼力有所提升？让我朝那片落叶试射一下。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "在武力层面，我并不认为你会需要我的帮助。但倘若你希望借助我的力量，我会尽我所能，一如既往。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "预备。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "上膛。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "猎影！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "射猎邪魔！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "你的自证时刻。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "洞见恶孽，逐灭鬼影！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "路遇好运，不错。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "没有归属的物品，不会引发纠纷。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "先到者得，合理。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "…速决胜负。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "骄纵轻狂。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "…可笑。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "退场！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "由我接手，后退。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "胜负…已分…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "败者…当如此…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "你已证明了名誉…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "还算精准。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其一",
      "text": "够了！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "如你所邀。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "需要我为你代理决斗吗？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "剑锋，直指暗影。"
    }
  ]
}