  "outfits": [
    {
      "id": 203600,
      "name": "清正灵台",
      "description": "重云的装扮款式。方士一族家传的驱邪装束。",
      "isDefault": true,
      "characterName": "重云",
      "characterId": 10000036,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Chongyun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我名重云，家族久居璃月，世代以驱邪除魔为业。今日萍水相逢，看来我与阁下有些缘分。唔…不收钱的，不收钱！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·驱邪之法",
      "text": "方士驱邪一靠咒术，二赖武艺。另辟蹊径亦可，但终非正道。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·饮食",
      "text": "寒食饮冰利于平神静气…清心泡水辅以冰块饮下，对身体最好。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·口诀",
      "text": "驱邪缚魅，内外澄清，啊，呃…糟了，后半句口诀忘了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "雨是无根水，是最澄净的水，对驱邪除魔大有帮助。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的时候…",
      "text": "这落雷好大阵仗，妖邪也会惧怕的吧。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候…",
      "text": "啊…好天气，真是舒服。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早晨的好时光可不能辜负，抓紧练功。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "正午灵气极盛，可得抓紧练功。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚间最适静息凝神，更要抓紧练功。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "呼，累了一整天，你也休息去吧。明天再去传闻中鬼怪出没的老宅看看，说好了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于重云自己·方士",
      "text": "我们方士一派自古守护璃月，传承久远，剿杀邪魔自然是手到擒来。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于重云自己·委托",
      "text": "明明什么都没做，只是进了凶宅的门就解决了问题。这个委托的报酬，你觉得是拿还是不拿呢？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·旅伴",
      "text": "你的本事不错，对丘丘…咳…邪魔从不手软，我们结伴而行如何。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·怪谈",
      "text": "璃月的奇闻异事你已经见了不少吧，你说的那些方外的鬼怪，我…我也想看看。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」虽然厉害，却不可盲目依赖。我还是更加信任方术和武技。本事要精进，还是得勤学苦练。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "璃月的土地上妖邪传闻虽然众多，但真假掺杂，有些奇奇怪怪的委托…其实跟鬼怪一点关系也没有。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "听说琥牢山的琥珀中封存了不少稀奇古怪的东西，会不会也有一些历史传说中的妖邪呢？真想见识见识。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于钟离…",
      "text": "「往生堂」的钟离先生啊，隐约觉得是个厉害角色，凡夫恶党杀人，我们方士除妖，他居然能葬仙人。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于行秋…",
      "text": "我虽然敬佩行秋的武艺和侠心。但是我一定要事先提醒你，他坏心思也不少。如果真的发生了什么事情，记得回来和我结成受害者同盟啊。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于魈…",
      "text": "降魔大圣和我们方士一派，一暗一明，共守璃月，历史已久，我非常尊敬魈上仙。但是，那位大人居然说…居然说什么驱邪方士量小力微不值一提，我，我绝对不能苟同！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于胡桃…",
      "text": "「往生堂」的手段还是信得过的。但是那副「不用你们方士操心」的嘻嘻笑脸却看着让人火大…呼，冷静冷静。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于七七…",
      "text": "看起来是个僵尸小姑娘，但作为方士我能察觉到…她可不一般。嗯…名字也不见宝诰之中，究竟是哪尊呢…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于辛焱…",
      "text": "我会尽可能避开辛焱演出的区域。那般热烈的气氛，即使无意融入，也难免受其影响…我是说，会让人不自在。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于香菱…",
      "text": "香菱做菜的手艺有口皆碑，但是她那些辛辣烫口的菜品我是绝对不会碰的…没有，没有什么…你看，史莱姆滑蘑菇？这能吃吗？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于申鹤…",
      "text": "我曾听家中长辈聊起过她。她家的遭遇…很让人同情。原以为这次能够让分家的远亲重回家中，长辈们听说她还活着也都高兴坏了，说是要备上礼物，择个吉日好好聚聚。却没想到，平日根本见不到她的人影…等等，按辈分来算的话，我、我该不会…要叫她「小姨」吧…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于夜兰…",
      "text": "我初任方士那会儿，受邀到委托人家中驱邪，离开时，曾撞见过这位女性。她把我的名字记在某个小册子里，或许是想确认我有没有做值得怀疑的事吧。不过就那一次，后来再没遇见过她。\\n现在想想，大概是因为我平日打坐总是一动不动，谁看着都会觉得无趣吧。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解重云·其一",
      "text": "本事很重要，不然空有热血，只会坏事。对于这点，我深有体会。啊，倒不是我自己的体会，呃…是近年行走璃月，观看人间百态的感悟。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解重云·其二",
      "text": "我天生是「纯阳之体」，据说千年难遇，所有鬼怪对我退避三舍。唉…这其实一点都不好，哪有见不着鬼怪的驱邪方士。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解重云·其三",
      "text": "「纯阳之体」常常导致热血太盛，没少害我出糗。我不食辛辣高温、出门撑伞、回避激荡的音律，就是为了克制它。唉…什么时候这体质才能不妨碍我呢？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解重云·其四",
      "text": "坐等妖邪现身是没用的，得主动寻访。我为璃月人镇邪，于人能免去烦愁，于我也能广开视野。如果你遇到邪祟搅扰，我一定也会立刻来帮你。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解重云·其五",
      "text": "剿灭天下妖邪是我身为方士的最终目标，将来这个宏愿实现之后，不管是温泉、绝云椒椒还是别的什么…热血刺激的东西，我其实…都可以考虑。唔…不行。这样想想就会有些激动…不好不好。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "重云的爱好…",
      "text": "我？嗯…我最喜欢的还是听说书。茶博士总是能把各种奇闻怪谈讲得惊心动魄。有空不妨一道去听听。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "重云的烦恼…",
      "text": "经我多方打听，费了好大功夫，才找到一处破庙有妖邪出没！于是，我守了四天，却完全不见妖邪的影子。唉…这种事经常发生。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "每日修行完毕后，要是能吃上稻妻运来的生鲜还有冷餐就好了，那种冰凉清爽的口感能缓解所有疲劳。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "所有又烫又辣的食物我都不能入口。如果是有绝云椒椒的菜，啊，想想就吓人。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "口感凉爽，正合我意！我要多留一些，等到修行完毕后再来享用。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "不好意思啊。明明是你的一片心意，我却只能放凉再吃…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "糟糕！这味道是…绝云椒椒？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "今天是你的生辰，这朵冰晶结成的小花送你，是我自己雕的。如果遇到妖邪，掷出冰花，我封入的咒术自会生效，助你脱险。啊…还有，生日快乐。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "驱邪的术法也常常用到这些材料，没想到还能用于提升自己的灵气。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "习武与术法一样，都有境界。受你指导，我又有进益了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "原来习武之道还有这样一种境界，手眼相通，人与剑合…嗯，我悟到了！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "领悟了这些武技，「剿灭天下妖邪」的愿望或许就能达成了。你一路相助，我当然铭感在心，今后赴汤蹈火在所不辞。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "剑印染冰！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "剑，出！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "急如敕令。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "听我法旨。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "邪魔退去！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "宝印幻剑！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "束手伏诛吧。"
    },
    {
      "id": "700001",
