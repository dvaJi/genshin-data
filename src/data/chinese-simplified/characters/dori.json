  "outfits": [
    {
      "id": 206800,
      "name": "我爱摩拉",
      "description": "多莉的装扮款式。这套恨不得嵌满宝石和贵金属的衣服大声宣告着主人对财富的欲望。据说这还只是商人多莉的常服，难道她还有比这更昂贵的衣服吗？！",
      "isDefault": true,
      "characterName": "多莉",
      "characterId": 10000068,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Dori_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "哎呀呀，这不是大名鼎鼎的旅行者吗？我是旅行商人多莉·桑歌玛哈巴依。作为给你的见面礼，我这儿的商品全部限时九折优惠，赶快来挑选吧，我帮你打包~"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·摩拉",
      "text": "我爱摩拉，摩拉爱我，啦啦啦。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·双赢",
      "text": "先把商品涨价百分之三十，然后再打八折卖出，不仅我赚得多了，顾客也会觉得划算，这就是双赢。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·财迷",
      "text": "只要摩拉管够，和教令院对着干也没什么大不了的。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "需要伞吗？我这里有一把特制雨伞，收集雨水的同时能够净化水质，把雨水变成饮用水储存在小罐子里，可以说是旅行必备品！只需要五十万摩拉喔。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "这种天气，恐怕商队也不太好前进了。又要少赚好多摩拉…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "哒啦，看我的全自动雪球机！想要吗想要吗？租金给你打九点五折喔！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "摩拉在阳光下闪闪发光，真好看！嘿嘿。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "不会吧不会吧，不会真的有人选在大风天穿越沙漠吧。我当然有办法救这种蠢蘑菇，但费用…至少要翻三倍才行！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早安，昨晚的梦里全是圆滚滚的可爱摩拉，今天一定会是盆满钵满的一天。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "想午睡吗？我可以给你一个软绵绵、蓬松松，完美贴合你背部曲线的靠垫。当然具体有多舒服就看摩拉有多少了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "在夜色中赶路很有挑战性喔，不过这可难不倒常年在外行商的我！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "你要睡觉了吗？嘿嘿，我就大发慈悲让你试试我的摩拉歌谣催眠法吧！一万摩拉入口袋，两万摩拉入口袋，三万摩拉入口袋，四、嘿四万…嘿嘿，摩拉，嘿嘿…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于多莉自己·吆喝",
      "text": "万能的多莉商店，应有尽有，童叟无欺。只要摩拉够，只有想不到，没有买不到。需要任何东西，或者遇到任何困难，都可以来找我喔！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于多莉自己·妙论派",
      "text": "通常我会躲着教令院的人，他们的各种条条框框简直让人没办法做生意。不过呢，告诉你也没关系。妙论派有些人还算是头脑灵活，和我私下签了条约。我有摩拉，他们有技术和手艺，顺便还能让我的行商更加通畅。嘿嘿，大商人多莉，从不做亏本生意。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·推销",
      "text": "你要在须弥旅行吗？须弥的沙漠很危险喔，就让大善人多莉来帮你吧！锵锵，沙漠旅行大礼包，只需要五百万摩拉！现在购买还会免费附送雨林旅行大礼包！机不可失，时不再来喔。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·摩拉分配",
      "text": "我的摩拉是我的，你的摩拉还是我的，嘿嘿。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·实价",
      "text": "好吧好吧，和你实话实说也行啦。沙漠和雨林的旅行大礼包，拆开来卖的话，分别都值二百五十万摩拉。但买一送一听起来比较划算嘛，你不觉得吗？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "哎呀哎呀，我的神之眼亮晶晶的，很漂亮吧？既然看到了这么漂亮的东西，你是不是应该付摩拉呢？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "以前也有些蠢蘑菇试图欠账不还，嘿嘿，也不看看我是谁。不如，你来猜猜看他们的下场如何吧？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻·共同语言",
      "text": "如果盗宝鼬能开口说话的话，我们肯定很有共同语言。它们多有眼光呀！全提瓦特最惹人喜爱的，自然是亮闪闪金灿灿的摩拉。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感兴趣的见闻·驮兽乐园",
      "text": "想见见驮兽吗？没问题！你想见多少我就有多少。只不过这个门票钱嘛，欸嘿嘿…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于赛诺…",
      "text": "我和他算是有点私交。毕竟能为他拿到「七圣召唤」所有周边产品的人，全须弥只有我一个。很罕见吧！教令院里居然有他这种特行独立，眼光不错，又从不讲价的人。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于提纳里…",
      "text": "他热爱学术就和我热爱摩拉一样。听说他经常会做一些神奇的小玩意儿，只可惜会用什么公务繁忙作为理由，拒绝和我合作批量生产，要不然…可以赚上一大笔摩拉呢！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于艾尔海森…",
      "text": "他以前试探过我的手下。所以说，教令院的家伙真是又呆板又不诚恳。我又何必冒这个风险呢？懂了吗？小跟班。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于卡维…",
      "text": "他是跟我有合作的妙论派的人之一，和某些教令院的死脑筋不一样，是个会为理想奋斗的人，我很欣赏他。我悄悄借了他一大——笔摩拉，让他造出了我的艾尔卡萨扎莱宫。可以说没有善良的多莉的资助，就没有今天的卡维。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于迪希雅…",
      "text": "有时候我会雇佣她帮忙保护商队。毕竟她实力不错，要价也不高，可以说是性价比最优之选。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于岩王帝君…",
      "text": "岩王帝君离去之前，我每天起来第一件事就是默念：财神在上，保佑多莉日进斗金。现在嘛，求神不如求己。多莉在此，保佑自己日进斗金！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于小吉祥草王…",
      "text": "在须弥，小吉祥草王的信徒非常少。你问我吗？啊，如果她愿意给我摩拉的话，我就是她永恒的信徒。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于妮露…",
      "text": "她的舞跳得不错，但只留在须弥，还是不能最大程度上发挥出她的价值…我是说，有点屈才。你说你说，如果能把她带出去，在提瓦特举办巡回演出的话，一共能赚多少摩拉呢？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于艾莉丝…",
      "text": "艾莉丝女士有源源不断的新奇东西，是我的最佳供货商，没有之一。嚯嚯，这种商业机密都告诉你了，你是不是应该交点学费，表示表示呢？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于绮良良…",
      "text": "在我跨国收购物资的时候，她为我送过好几次货。服务又好，收费还便宜。哦，对了，她很喜欢各种漂亮的小饰品，我这刚好进了一些，须弥特色，纯手工制品，可精致了。怎么样，要不要买来送给她呀？我给你打折。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于瓦雷莎…",
      "text": "哎呀，我知道你说的是谁了，单纯可爱的水果领主…她家的作物啊，品质顶呱呱！人也非常好说话，我面无表情托腮思考，都会让她紧张，怀疑自己的货品质量欠佳，主动提出降点价…嘿嘿，这样的性格，做生意可是要吃亏的！我希望她只对我展现出来，以免便宜了别家！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解多莉·其一",
      "text": "想听故事？那就…给我一百万摩拉。嗯…看在我们交情的份上，给你打个九点九折好了，九十九万摩拉。怎么样？很划算吧！"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解多莉·其二",
      "text": "嘿嘿，你可真有眼光。那我开始讲了！\\n这是一个商人的故事。很久很久以前，她在行商途中迷失了方向。这时候她遇到一只雾怪，雾怪要一口吞掉她。她连忙说，雾怪先生不要着急呀，我这里有个故事。您听听看，如果有趣的话，就请您不要吃掉我…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解多莉·其三",
      "text": "雾怪答应了。于是商人开始讲自己的故事，当年她的生意还不像如今这么红火，在她一筹莫展之时，正巧，她从库房里翻出了一个不知从哪儿来的魔灯。她恍惚间擦亮了魔灯。一团红雾从里面弥漫了出来，她自称是「人美心善的大魔王」，见着这位商人就想起了自己乖巧可爱的女儿，所以她说，可以实现商人一个愿望。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解多莉·其四",
      "text": "还有什么比摩拉更吸引商人的呢，于是商人许愿：希望接下来的日子，能赚到数也数不清的摩拉。「人美心善的大魔王」同意了，她成为了商人的供货商，为商人提供了源源不断的奇妙商品。商人也因此赚得盆满钵满…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解多莉·其五",
      "text": "雾怪听完这些觉得很神奇，明明自己和红雾大魔王也算同类，自己怎么没办法变出什么东西。商人呀，就夸了雾怪天赋异禀，说不定在同一个魔灯里待上一段时间，就能拥有大魔王的能力了。雾怪欣然同意，进入了商人的魔灯…\\n咳咳，你问我这个故事是不是真的？这是另外的价钱喽，再给我九十九万摩拉，我就告诉你！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "多莉的爱好…",
      "text": "我的爱好可多了，第一是赚摩拉，第二是数摩拉，第三是看摩拉，这世界上没有比摩拉更令人开心的东西了！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "多莉的烦恼…",
      "text": "总有些人，拿着才三成利的生意就来打扰我，唉，我也是很忙的。没有百分百的利润，我连听完的兴趣都没有。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我听说璃月有一种叫做摩拉肉的食物，名字里带摩拉，一定非常好吃。什、什么…你会做？咳咳，你当我的小跟班也有一段时间了，应该从我这儿学到了不少吧。作为交换，你要给我做摩拉肉吃！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "椰炭饼那种黑乎乎的东西，一点儿也不符合我的品味，我是绝对不会吃的！就算反过来给我摩拉，我…呃，我、我再考虑考虑。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好吃好吃，啊不如你跟着我一起行商，兼职私人厨师吧。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "哇，我的小跟班做饭水平可以呀。能让我点餐吗？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "居然让我吃这种东西，嘿嘿，你要赔偿我精神损失费！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "今天我可以满足你一个心愿！毕竟我是无所不能的多莉。说吧说吧，想要什么？不过呢，先和你说好，「一辈子都用不完的摩拉」这种愿望可不行喔。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "你这是在投资我吗？你可真有眼光。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "多多益善，多多益善。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "喔！我好像有了一个奇妙钱袋，能掏出源源不断的力量。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "恭喜你成为神通广大的桑歌玛哈巴依老爷的尊贵会员！以后你的订单一律八折，这种待遇你可是第一个喔。啊，好好珍惜吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其一",
      "text": "看我的！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其二",
      "text": "留下摩拉来！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其三",
      "text": "嘿哟！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "魔灯显灵！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "大显身手时间！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "一手交钱，一手交货。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "哇，分我一半！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "先让我看看。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "我来我来！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "休想抢走我一分摩拉！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "啊救命啊，抢劫啦！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "一定要保护好摩拉。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "救命之恩，记得给钱！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "呆头菇，命和摩拉一样重要。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "摩拉…还没赚够呢…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "又是…这样…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "摩拉也不管用吗…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "小问题。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "磕碰而已。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "欺人太甚！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "列进黑名单！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "走吧走吧，赚笔大的！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "摩拉不等人，快跟上。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "是什么大生意？"
    }
  ]
}