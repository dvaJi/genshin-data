  "passives": [
    {
      "id": "an_eye_for_gold",
      "name": "披沙沥金",
      "description": "与<span style=\"color:#FFD780FF\">灯中幽精</span>相连的角色在触发感电、月感电、超导、星超导、超载、原激化、超激化、超绽放、雷元素扩散或雷元素结晶反应后，<span style=\"color:#FFD780FF\">镇灵之灯·烦恼解决炮</span>的冷却时间缩短1秒。<br/>该效果每3秒至多触发一次。",
      "level": 1
    },
    {
      "id": "compound_interest",
      "name": "利上加利",
      "description": "<span style=\"color:#FFD780FF\">镇灵之灯·烦恼解决炮</span>的断除烦恼炮或售后服务弹命中敌人时，基于多莉的元素充能效率，每100%为多莉恢复5点元素能量。<br/>每次施放镇灵之灯·烦恼解决炮只能通过这种方式恢复一次元素能量，并至多恢复15点元素能量。",
      "level": 4
    },
