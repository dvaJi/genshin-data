  "outfits": [
    {
      "id": 210701,
      "name": "星与烟帷的夜语",
      "description": "茜特菈莉的装扮款式。闲居在家的茜特菈莉偶尔会换上一身少女感十足的衣装，届时任何以公务为由上前叨扰的人都会遭到重击。于是那身衣装成为了传闻中的凶煞之物，见到了就得尽快绕路。",
      "isDefault": false,
      "characterName": "茜特菈莉",
      "characterId": 10000107,
      "source": [],
      "filename_card": "UI_AvatarIcon_CitlaliCostumeXia_Card",
      "filename_icon": "UI_AvatarIcon_CitlaliCostumeXia",
      "filename_iconCircle": "UI_AvatarIcon_CitlaliCostumeXia_Circle",
      "filename_splash": "UI_Costume_CitlaliCostumeXia",
      "filename_sideIcon": "UI_AvatarIcon_Side_CitlaliCostumeXia"
    },
    {
      "id": 210700,
      "name": "启明视",
      "description": "茜特菈莉的装扮款式。萨满是窥视过去与未来的预言者，眼睛对于他们有特别的象征意义，茜特菈莉半披于身的这件长袍上编有「启明之眼」图案，完美契合了她的身份与品味。",
      "isDefault": true,
      "characterName": "茜特菈莉",
      "characterId": 10000107,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Citlali_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "「烟谜主」的茜特菈莉，已经透过迷烟看到了未来的道路。诸恶曜必不会伤害你，诸吉星必环绕你。你会拥有强大的「盟友」。请让我也同行。——呃，见到认真的我很奇怪吗？不要用这种眼神看着我啦！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·小说",
      "text": "基、基本上八重堂出版过的小说我都看过。也、也不奇怪吧！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·喝酒",
      "text": "岁月献给小酒杯，借钱九出十三归。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·出神",
      "text": "「出神仪式」对旁人来说还是挺不稳定的，就不要太好奇了吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "在家里看小说的好日子。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "今晚应该能看到星星了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "呜啊，从来没有见过！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "呸——啊，我不是在随地吐痰，我怎么可能那么没有素质？是嘴里进飞沙了！你相信我！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "啊——早上好啊。上次这么早起床都是出师以前了。独当一面之后，我都是睡到自然醒。说吧，什么事？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "中午好啊。其实我还是很节制的，起床到中午的时间内是不会喝酒的…至于熬夜主持仪式结果彻夜不眠直到第二天天亮就是另一码事了…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好啊。纳塔有些荒野晚上会有很大幅度的降温，别凉着了。燃素活跃的地方倒是白天晚上都一样。你没问？没问也听着！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。今晚恶曜不显，地灵微眠，迷烟浅睡。是个好夜晚。我的枕头怎么掉地上了…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于茜特菈莉自己·蜃楼战记",
      "text": "哦，你感兴趣啊。《蜃楼战记》是稻妻八重堂中岛纯先生所著的幻想小说，算是八重堂活化石级别的老系列了。故事发生在名叫「苇之原」的幻想岛国。大部分章节的主角都是东渡而来的猫头道士「东之山君」，其真身正是超古代诸侯东王公。小说的篇幅很长很长，中间换过三次作者，最终还是没有揭开「方壶」的真相…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于茜特菈莉自己·终结",
      "text": "纵使「还魂诗」可以唤回血气之身，但星曜、太阳尚有终结，何况生命。你问死亡是什么样的？那就像是在永恒的午后，你骑着龙驰骋在大平原上，天际线那边有一张看不清的脸。无论你速度多快，它都在天边不动。突然某一刻它动了起来，以恐怖的速度和你迎面撞上。你来不及躲避，当看清那张脸时，一切都结束了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·帮助",
      "text": "欸，除了辈分虚高，我也不知道我在纳塔能帮你什么。你的「盟友」强大，前途光明。在这方面我已经没什么能为你做的了，更何况像我这种年纪的奶奶，一般不都该在家里找把椅子躺着了吗？除非你真的要我帮忙用辈分去压人…你不会真的需要这种吧…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·局促",
      "text": "我、我对你的态度和对其他人一样啊。没、没什么差别吧。呼…好吧，村里人对我的误会已经传了几代人，我早就放弃努力了。但是你不一样，你面前的我才是真正的我。对外无所顾忌、大大咧咧的模样，都是我努力装出来去迎合外界忌惮的…在你面前的局促才是真的我。我就是一个谨小慎微的人啊。我从来都不骗你，但是这个真心话我只说一次。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "获得神之眼就是获得了另一种强大的「盟友」。不过当我们说某人「盟友」强大的时候，本质上还是在说其人本身超凡。毕竟「盟友」只是协助你的力量，只有你自己拥有无坚不摧的意志，才能把力量发挥出来。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "稻妻的小说连载运到纳塔会晚两周，而合订本要整整晚一年。不知道背后有什么深意。这时间差的两周内，各种稀奇古怪的内部消息、先行透露满天飞，不知道多少是造谣、多少是自己编的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "传说纳塔曾有一种特殊的仙人掌，被我老师的老师称呼为「梅斯卡利脱」。据说食用它能让凡目也看到另一重世界。我也就说说，现在不知道「梅斯卡利脱」灭绝没有。你遇到了可千万别吃。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于欧洛伦…",
      "text": "哼哼。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于玛拉妮…",
      "text": "玛拉妮和我之间有笔算不清楚的账。她应该付我的报酬、弄坏我家门的赔偿、实付报酬、蹭我零食、给我带的小吃…总之算不清了。如果她不介意的话，我倒是想就此两清。正应该睡觉的周末上午十一点…啊，没什么！总之，突然被她咚咚咚锤门，太可怕了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于希诺宁…",
      "text": "像她这样既不在乎关于我的奇怪谣言，又不会过分热情的人相处起来最轻松不过了。啊，不是——在你面前我也很轻松。我拘谨的本性都不自觉流露了！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于玛薇卡…",
      "text": "玛薇卡这家伙…咳咳，不好意思，火神大人她前些日子突然过来找我说了一大堆话。后来我半夜吃宵夜时才明白她过来炫耀了什么。有一句异邦的古话，想想还挺适合她的。「圣者谦卑，只有谈到自己责任时，会骄傲地加一句『我说句大话…』」。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "对神里绫华…",
      "text": "…哈，小妹，你转过来给我看看。嘶，这是《奥西兹小姐事件簿》啊，嗨，我还以为是《赫尔洛克》系列的女二号呢。枫丹的衣服在我看来都一样。行了，你继续吧，我没事了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于基尼奇…",
      "text": "他身边的那个小东西有点烦人。他是你朋友吗？那我想想还有什么别的印象…他本人还是挺可靠的。嗯。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于伊安珊…",
      "text": "好像对她没什么更深了解。不过根据八重堂小说的套路来看，这人能力这么强，个子这么小，是不是遇到紧急情况会有一个两米三的百分之二百出力模式啊？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于瓦雷莎…",
      "text": "带上面具的战士会被认为是「英雄」、「自然」、「神灵」的化身。曾经就有一个大家喜闻乐见的英雄扛着被酒打败的巫婆耀武扬威的故事，还是在半夜足足敲了一百户人家的门。我倒是也不剩什么好名声了，所以没有很在意。嗯，没有。为了她饮食健康，我要给她下连吃十天蘑菇的诅…呃，祝福！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解茜特菈莉·其一",
      "text": "啊？你怎么突然过来和我说这个？是听到了关于我的传闻？唉，对对，我就是萨满里的老妖怪，想信就信吧。我已经放弃解释了。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解茜特菈莉·其二",
      "text": "你还是想听我解释吗？唉。「烟谜主」有一个秘而不宣的传统：为了敦促后辈进步，老师会故意算计徒弟，让他们和师叔们结下梁子。为了不挨长辈的揍，后辈就必须拼命努力反超长辈。如今「烟谜主」大半都是我朋友的谱系。他们所有人都喜欢找我来当这个坏人巫婆。怎么办呢？我根本没想为难后生，可这么多年没有一个人能赢过我！唉！于是关于我多恐怖、脾气多差的谣言就根深蒂固了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解茜特菈莉·其三",
      "text": "没错。我在人前的状态是装出来的，这才是我本来的性格。这也很好理解吧，所有人都期待着你说话带着口音和过时表达的时候，你说出了优雅、字正腔圆的标准口音，对面也会愣住的。你说的没错，这就是一种不自知的愚蠢。但是这种愚蠢很难从习性上摒弃，你看，我一开始还以为你也和其他人一样呢，嘿嘿。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解茜特菈莉·其四",
      "text": "你想知道「烟谜主」的后辈是怎么被他们师父算计，和我结下梁子的吗？最传统的做法就是师父骗徒弟自己被骗了，要去骗子家门口涂鸦。一般徒弟听了就会义愤填膺，捋起袖子就涂。真的很过分欸，对吧？不过最近大家都知道我家在哪里了，所以这招不怎么能见到了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解茜特菈莉·其五",
      "text": "这些龙遗迹研究协会送回来的酒瓶…啊，这，这是，对，是欧洛伦他喝完了随地乱扔的，和我没关系。对吧，欧洛伦，快出来认错！我酒量还不错，不会轻易喝醉的，就算醉了也不会乱扔垃圾。何况协会说是野外找到的在野外也没有给别人添麻烦而且这也不是我丢的…啊，解释不清楚了！请你相信我！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "茜特菈莉的爱好…",
      "text": "我的生命太过无意义，只剩下喝酒的迷醉、看小说的妄想和睡觉的昏沉了。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "茜特菈莉的烦恼…",
      "text": "这你还看不出来吗？看起来什么都不在乎只是我的保护色，其实我什么都很在乎。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我喜欢五成熟的肉，比较接近祭祀品本来的味道。然后就是吃起来简单，可以一只手拿着另一只手翻小说的东西。再然后就是，你推荐的我都喜欢！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "就是…稍微有些不理解酸味的食物。饿了就吃东西，困了就睡觉，渴了就喝水。既然需要酸味开胃，那不就是不饿不需要吃东西吗？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "呜啊，太好吃了。「烟谜主」附近的吃食我都尝过了，全都没你做的好吃。真的真的。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "平常吃这种东西不多…不不不，不是说不好吃的意思！就是…现在感觉吃出来了另一番风味。是夸奖，真的是夸奖！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "怎、怎么会不好吃呢。啊哈哈哈…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐！我也不知道有什么可以送你的，你的前途上灾星恶曜不显，爱情、功业、武勋的运势也很通畅。米克特兰式的祝福对你效果甚微。之前本想送你我传教用的《菲谢尔皇女夜谭》，但是看到你好像有很多八重堂藏书，我都羡慕…这可为难了，送你什么好呢？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "不像是提瓦特外面世界的占卜技术，我——至少我这一系不依靠天，反而更依靠大地。天上虚假的凶星恶曜显露之时，我就依靠迷烟、大地之灵和动物骨头将其绑缚。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "天上对人间命运的操控如同木偶提线，这些恶曜本身并没有自我意志。但是这些力量被封进布偶体内之后，凭着小动物骨头附着的念头，它们呈现出了意识。我把这些玩意…咳…小家伙叫做「星魔」，可以说是凶星恶曜的化现吧。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "每个布偶里都有小动物的骨头，仔细想想确实也有点瘆人吧。用这样的秘术，被其他人所恐惧，可能有十分之一的责任确实在我。但是这都是我游历野外时收捡的，我可没有伤害小动物！你可不能误会我！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "从今以后，我会一直与你同行。直到所有星辰消隐，直到所有的火熄灭，直到迷烟散尽。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "出来干活！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "履行盟约吧，星魔们。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "不必留情。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "小心…小心地…"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "不会手抖的。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "好的。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "灭口交给你们俩了！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "茜特菈琳、伊兹帕帕，给我上！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "让你见识见识恶曜伤人！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "挺好的，收下吧。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "先收下，答谢诸星的祈祷我替你做。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "两只手都抱不下的话我来帮你。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不该出门的…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "唉，想回家啊。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不能…在你面前…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "…不许死！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "给奶奶我小心点。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "天上的诸曜啊…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "大地的迷烟啊…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "对不起…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "好胆子！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "疼疼！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "我可没迟到…"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "哈？干什——啊，没事的，准备好了！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "那我肯定帮忙呀。"
    }
  ]
}