  "outfits": [
    {
      "id": 212500,
      "name": "织月裁光",
      "description": "哥伦比娅的装扮款式。月灵们用「霜月之子」所供奉的布匹，加上几束柔美的月光，为哥伦比娅编织出了这套轻盈曼妙的衣装。不明所以的「霜月之子」们，自然而然地把这件新衣服也理解成了「库塔尔」的神迹。也难怪哥伦比娅自那之后，偶尔会听见类似「拜托库塔尔大人赐予我和您一样的灵巧手艺吧」的愿望。",
      "isDefault": true,
      "characterName": "哥伦比娅",
      "characterId": 10000125,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Columbina_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你可以叫我哥伦比娅，也可以叫我库塔尔、月神大人…选你喜欢的吧。我习惯了有很多名字的日子。若你需要的话，我会给予你月亮的赐福。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·歌",
      "text": "我的歌并不为谁而唱。但如果有人驻足聆听，我希望他能从中获得片刻的安宁。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·月亮",
      "text": "想要赏月吗？你可以坐到我的摇椅上，找个舒服的角度。或者我们一起去月亮上，赏提瓦特也行。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·漫步",
      "text": "我过去每天都会在银月之庭漫步很久，不用担心我跟不上你的步伐。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "避雨的时候倾听雨水冲刷大地，会给我一种在「家」的安全感。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "天晴了，晚上应该能看到月亮吧？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的时候…",
      "text": "唔…！看不到闪电的话…很容易被雷声吓到…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候…",
      "text": "我喜欢雪。美丽又安静，还能和月灵们打雪仗。你想现在来玩玩吗？"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "睁不开眼的话，就把手给我，我带你走。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "夜晚的沙子踩上去很凉快，很舒服。但到了白天就会变得好烫好烫…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早…看到我的发绳了吗？嗯？头发有些乱…？在哪边？帮我梳梳。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "呼…月亮还没升起来，我想先抱着月灵们睡个午觉。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "夜幕落下…不觉得这种说法很有趣吗？就好像「夜晚」是被月亮绊了一跤才掉下来的一样。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "睡不着吗？唔…月灵们有时也会这样。一般这种时候，我就给月灵们唱唱歌，讲讲故事。要不要给你也试试？"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于哥伦比娅自己·眼罩",
      "text": "我习惯了用月矩力去「感受」，这比「看」更能为我展现事物的真相。不过，我偶尔遇到好奇的时候，也会悄悄睁开眼睛偷看一下。我的眼罩是镂空的。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于哥伦比娅自己·家",
      "text": "我曾以为自己一直在流浪，月亮才是我的「家」。但现在，我的「家」不仅变多了，也变得更近了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·事迹",
      "text": "我很久之前就听说过你。在「愚人众」的时候，其他执行官聊起过你的事迹。但似乎当时觉得你的名号太多，他们还没讲到名字的时候，我就已经睡着了。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·旅行",
      "text": "能告诉我一些旅行期间的注意事项吗？比如怎么和其他国家的人说话之类的。嗯…？你说更应该关注生火和捕猎的技巧…日常的交通方式？这些…不是用月矩力就可以了吗？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「三相月临」…",
      "text": "三位女神将她们的权能交予了我。三份力量互相交汇，很耀眼，又很温柔。我能从中感受到她们对这个世界的眷恋，以及在生命最后时刻给予这个世界的期盼与祝福。我将继承她们的月光，让它照亮月下的世界，照亮我们共同的「家」。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "在至冬作为「愚人众」执行官第三席的时候，能够享受到许多生活中的便利。坐列车不用买票、去科洛列夫茨基剧团也不用排队…啊，但去餐厅吃饭的话，虽然能够…「报销」？但那好像很复杂，我搞不懂。所以我都是和桑多涅，或者阿蕾奇诺一起去吃。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "月亮上的风景比我之前期待的还要美丽得多。蓝色的月矩力静静流淌，变为了一眼望不到边的海洋。漂亮的水母们在这片月色的海洋上自由飘荡。还有不知生活在哪里的粉色霜鳍鲸、好大好大的月灵…等我花些时间，把月亮上的「家」打理好，就请朋友们来做客吧。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于菈乌玛…",
      "text": "要是往菈乌玛头顶的方向递去一缕月光，她的角冠就会长得更高更大，算准角度，还能一下子戳中长在高处的果实…后来？嗯…被训了。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于尼可…",
      "text": "前段时间我们还保持着联系。「有没有推荐的书？想拿来读给月灵们听。」像这样和尼可小姐说了一句之后，她送来了很多有趣的书籍，还向我详细介绍了每一个故事的灵感和设定。我问她，「什么时候才能读到尼可小姐亲笔写的书呢？」结果她突然消失不见了。嗯…或许是写书去了吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于那维莱特…",
      "text": "在枫丹担任最高审判官的水之龙？唔…听上去也是一位会将人投进囚牢的龙呢。不太想见他。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于尘世七执政…",
      "text": "如果在旅途中巧遇的话，我会和他们打个招呼的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于「冰之女皇」…",
      "text": "我第一次在至冬宫的花园里唱歌的时候，「女皇」恰好途经那里，她静静地站在一旁，像一尊还没来得及刻画表情的雕像。有一刻，我感觉她想对我说些什么，但没有。\\n她把感情封进了厚厚的冰层，只对外显露她作为女皇的一角…我的答案留在月亮上，她的答案，或许葬在了冰山之下。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于「丑角」…",
      "text": "他像是故意想成为他代号的反语。名为「丑角」，语调却严肃深沉，总是说些难懂的话。他佩戴嗤笑世界的面具，自己却从不微笑。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于「队长」…",
      "text": "尊敬他的人不少，畏惧他的人也多。唔…不好懂么？那些习惯生活在阴暗处的生物是不会选择靠近光源的。光太危险，只会拖长他们自身的影子。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于「博士」…",
      "text": "曾有一段时间，「博士」很照顾我，他说对待我就像对待自己的妹妹一样。\\n后来我发现，越是在他心中亲近的人，他利用起来便越是自如。「既然是一家人，应该要学着忍让吧？」我看得出他由衷那么想，而我不想那么做。这种需要只会令我回想起在第一个家时，石台下的那些贪婪目光。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于阿蕾奇诺…",
      "text": "壁炉之家孩子们很多，有时会有些吵闹。我听见他们都叫阿蕾奇诺「父亲」，以为这是在壁炉之家时需要遵守的规矩。于是我在阿蕾奇诺经过时，也那样叫了一声。然后我才知道，原来壁炉之家还能那么安静。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于「公鸡」…",
      "text": "我可以教你怎么学他说话，只需要把「钱」、「该死的潘塔罗涅」和「我保证」三个词组混在一起就行了。「钱呢？该死的潘塔罗涅。我保证过的」是一种，「我保证让该死的潘塔罗涅吐出钱来」又是一种。你看，很神奇吧？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于桑多涅·发条",
      "text": "她背后的发条会一直转吗？是永远朝同一个方向转吗？睡觉的时候，她会把发条拆下来吗？翻身要怎么办？刚见到桑多涅的时候，我就对她的发条产生了好奇。但那时和她还不熟，直接去碰似乎也不太好。所以我只要有机会就一直跟在她身后，想找到她发条转动的规律。但有一天，她突然转过身，看起来很生气地质问我为什么总要跟着她。我老老实实告诉她之后，她对我说，「你那么好奇的话，我给你背后安一个试试得了」。于是我就背着发条生活了几天，唔…的确很辛苦，桑多涅的生活真不容易。自那之后，我就更关心她了。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于桑多涅·发条其二",
      "text": "我不清楚对人偶来说，怎么样才算是「死亡」…但桑多涅真的不动了，我感受不到她的「运转」，她的发条也不动了。她是为了那个「术式」，为了让我回到这里，才变成了这样…我多么希望她这么做只是为了吓我一次，就像她曾经说过会报复我的那样…"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "关于桑多涅·发条其三",
      "text": "桑多涅回来了。我好开心。我发现她的发条现在偶尔会转得快一些，好像以前总是以同样的速度在转。她说这是因为自己接受了内心情感的缘故，现在的她和以前已经不一样了。但我觉得不论是换了身衣服，还是发条转得快了些，桑多涅就是桑多涅，是我最好的朋友。不论是从前还是现在的样子，我都很喜欢。听完我这么说后，她的发条转得更快了。虽然不知道为什么，但真有趣。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于「富人」…",
      "text": "在他眼中，每件事物，每个人，都是被明码标价了的，他掌握着价格的规则，通过运作筹码来扩建他的财富帝国。但那个地方很无聊，我也不会想去做客的。\\n啊…如果「富人」见到现在的我，他的笑容里一定会藏入比以往更深的厌恶吧。我都能想象出他的声音了。「恭喜你升值了，哥伦比娅小姐。」"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于罗莎琳…",
      "text": "如果羽化意味着催动翅膀扑向火焰，那么维持茧的形态是否才是留存生命的更好选择？罗莎琳仿佛从没考虑过可以那么选，又或者她早已为自己选定了结局。她尽情爱，尽情恨，尽情舞…然后将哀歌留给别人来唱。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于「公子」…",
      "text": "听说他和家人的感情很好，休假的时候会举家外出，去湖边露营烧烤。桑多涅说他是执行官当中生活得最像普通人的那一个，我不了解普通人，但我觉得那样的日子听上去倒是不错。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解哥伦比娅·其一",
      "text": "欸…？我的故事？唔…那可能要说很长时间。嗯？你准备了茶水和点心？好吧，那作为回报，我就多讲一些。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解哥伦比娅·其二",
      "text": "我曾用很长时间去学习如何同他人相处，如何同这个世界相处。现在回想起来，最初在「霜月之子」和「愚人众」的两段经历，都不是很好的教材呢。以至于很长一段日子里，我都以为相处和交往即是利益的索求与代价的支付。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解哥伦比娅·其三",
      "text": "我喜欢为月灵们讲故事，也喜欢唱歌。我的人生有一块空白，它出现在我诞生之前，却如一个胎记般伴随着我的生活。当你的故事生来就是残缺的，你就得学着用其他故事去填补这个空白。我尝试用词语去摹画它的轮廓，又用歌声为它添上色彩。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解哥伦比娅·其四",
      "text": "在祈月之夜，我得到了自己的名字——哥伦比娅·希珀塞莱尼娅。从前的我会以为，名字不过是个代号，是自身以外的某种东西。但那晚过后我明白了，名字是我同这个世界的连接，它包含着朋友们的心意，是朋友们心中的「我」在现实中的回响。我会珍惜这个名字的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解哥伦比娅·其五",
      "text": "我的故事像是一部倒放的歌剧。它先给予了我结果，才叫我去探寻原因。但若问我重来一次，是否希望这故事有所不同的话，我又会觉得现在这样挺好。如果没有这趟探寻的旅途，我就不会知道诞生在挪德卡莱其实是我自己的选择，就不会在朋友们的帮助下学会同真正的「家人」相处，你那晚也不会在努昂诺塔的指引下踏入银月之庭。我的故事或许会迎来另一种空白，我不希望那样。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "哥伦比娅的爱好…",
      "text": "偶尔回到月亮上，睁开眼睛静静地看着提瓦特运转，会让我感到很安心。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "哥伦比娅的烦恼…",
      "text": "想和普通人一样在那夏镇散步…但每次都会被认出来。是应该换件外套吗？还是说普通人不会和镇上的月灵说话？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "新鲜的水果、蔬菜，配上麦香味的面包…嗯？很朴素吗？可能是习惯了吧。最初诞生在挪德卡莱的时候，「霜月之子」给我的就是这些。小动物们也经常带它们采到的野果和我分享。我喜欢食物最初的样子，其中包含着一部分这个世界最初的模样。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "「火水」，还有其他一些味道很烈的酒。至冬有很多这样的饮品。尽管我在那边待了很长时间，但还是习惯不来。为什么大家喜欢那种身子像在燃烧、世界像在旋转的感觉呢？他们也想飘到月亮上去吗？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "我还要。咦…？没有更多了吗？好吧，我下次省着吃。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "还不错，我会伴着月光慢慢享用的。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "唔…我惹桑多涅生气的时候，她也会给我吃类似的东西…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "你的生日每年都是同一天吗？真好记。唔…祈月之夜每年举办的时间都不同，我只能通过感知月亮来估算自己的生日。不过，「生日」倒的确是个愉快的节日。大家围在一起跳舞，还会为你制作好吃的贡品。欸…？普通人的生日不是这样的吗？礼物、蛋糕，还有朋友…？嗯，好呀，那就叫上朋友们来为你一起庆祝。我可以为你唱首歌，还能叫上梅拉为你画幅画呢。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "潮汐因恒月而翻涌。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "寒夜因霜月而长明。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "幽冥因虹月而深邃。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "命运的纺线继承到了我的掌间，自此，新月将注视并照亮月下的世界。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "漫流。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "盈满。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "垂映。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "新月终临。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "三月交辉之刻。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "将此月夜，献予众生。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "是「惊喜」…对吧？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "它们也离家出走了吗？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "我已经不需要贡品了，你收下吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "晕晕的…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "夜色变深了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我不太好…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不晕么？你看起来轻飘飘的。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "你不休息吗？"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "夜空…再次黯淡…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "月亮…坠落了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "离家的…代价…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "我没事…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "好痛…！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "…为什么？"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "要我借你一束月光吗？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "会出去很久吗？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "嗯，我跟你走。"
    }
  ]
}