  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "「蒲公英骑士」，琴，申请入队。从今往后，我的荣誉与忠诚将与你同在！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·行动",
      "text": "行动起来吧，我们不该在这里停留。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·骑士团",
      "text": "骑士团的大家…有没有认真工作呢？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·目标",
      "text": "走吧，前往下一个目标！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "下雨也无法阻挡我的脚步。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "这样的天气，正适合行动。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "下雪了，要注意战靴的保养啊。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "舒适的天气。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "传说，那天也刮着罕见的大风…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "「一日之计在于晨」，今天也请加油。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "好，现在开始处理任务吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "看样子，差不多已经对咖啡免疫了。如果有什么替代品的话…问问丽莎好了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "今日的修炼就到此为止，做得很棒，辛苦你了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于琴自己…",
      "text": "今天为了保护民众，把五座遗迹守卫斩成了碎片。唉，我还需要继续磨练自己…这么珍贵的文化遗产，下次应该尝试空手制服…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·信条",
      "text": "我会全力帮助你，当然，如果你的方向偏离了正义，我也会毫不犹豫地指出。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·誓言",
      "text": "我以此剑起誓，必将胜利献给你。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·任务",
      "text": "任务可是不会自动完成的，但适当放松一下也好。今天就破例午休几分钟吧。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「永护蒙德」是古恩希尔德家族的家训。每当驱动「神之眼」，我都会想起母亲、还有蒙德民众的期盼。为蒙德而战，为自由而战——我，在所不辞。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "我谨代表西风骑士团，向你为蒙德所做的一切致以谢意。还请你劳逸结合，量力而…怎么了，你突然笑了起来，我说了什么奇怪的话吗？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "「蒲公英，蒲公英，跟风一起，到远方去吧。」…它乘上风，说不定连天空岛都能飞到呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于芭芭拉…",
      "text": "芭芭拉非常努力，只不过有时过于勉强自己…嗯？问我为什么了解得这么清楚？因为西风教会也归属骑士团管辖。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于丽莎…",
      "text": "丽莎，有她在的话，我会安心很多。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于安柏…",
      "text": "安柏这段时间确实有所成长。希望有朝一日，她的事迹也会被吟游诗人传颂。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于凯亚…",
      "text": "是吗…凯亚也向你提出建言了啊。他是一名优秀的西风骑士，这点毋庸置疑。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于可莉…",
      "text": "虽说玩乐是孩子的天性，但可莉中意的玩具却都是些危险品。让人难以放心。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "「天才」这种名词，或许正是为了阿贝多这样的人准备的吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于法尔伽…",
      "text": "法尔伽大团长，他是西风骑士团的当代传奇。等到他凯旋归来的那一天，就请你亲自和他交谈吧。相信你也能从中受益。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于诺艾尔…",
      "text": "诺艾尔，嗯…那个努力想要成为西风骑士的少女。她的内心仍有软弱之处，现在这个阶段，也许还不适合让她接触外界的凶险。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于罗莎莉亚…",
      "text": "罗莎莉亚修女总是把「麻烦」挂在嘴边，实际却十分称职。上次我和她说「如果觉得麻烦也可以找我帮忙」，她却回答「这样更麻烦」。嗯…我果然还有很多欠缺啊。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于迪卢克·愧欠",
      "text": "迪卢克前辈对骑士团的指摘事出有因，即使心中愧疚也无法改变既定的结果…我只想通过我的努力，让他对骑士团有所改观…嗯，这是我的责任。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于迪卢克·敬重",
      "text": "迪卢克…是一位非常可敬的前辈。虽然我们选择的道路不同，但这份共通的守护蒙德的心意，我能感受得到。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于砂糖…",
      "text": "作为炼金术士，砂糖也算天赋异禀。况且她的身边还有阿贝多指点，未来应该不用担心。只是…不，没什么，沉浸在自己的世界里，也不算坏事吧。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于优菈…",
      "text": "优菈？咳…请不要对她的身世耿耿于怀，西风骑士会公正地评价每个人。优菈明辨是非，才华出众，偶尔发表危险言论，也只是她的性格使然。哪怕她总是说要挑战我，我也不介意。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于米卡…",
      "text": "大团长选中米卡作为远征队的前侦骨干，不仅是出于任务需要，更是看中了他踏实勤恳的品质。从我个人角度而言，我也很荣幸能与这样的同伴共事。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解琴·其一",
      "text": "我肩负着西风骑士团的信任，还有蒙德民众的期待。为此，我不能松懈。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解琴·其二",
      "text": "温妮莎的「蒲公英骑士」之名传承至今，曾经有无数伟大的骑士获授这一荣誉。我不能辱没这个名字。因此，决不能松懈。要成为守护众人的坚盾与利剑。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解琴·其三",
      "text": "无论是传奇故事还是史书，都只记载了伟大骑士的功绩。难道，他们一次也不曾迷失过吗…？\\n风啊，请指引我前进的道路。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解琴·其四",
      "text": "全身心投入工作的时候，烦恼和时间会一并被忘却。「你是最适合做这种事情的人选。」…那个时候，大团长法尔伽就是这样对我说的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解琴·其五",
      "text": "与你同行时，前进的道路变得无比清晰。就好像，终于有人能依靠，这究竟是…\\n不，一定是我还不够努力。绝对不能松懈，不能辜负西风骑士团和蒙德…但是，谢谢你。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "琴的爱好…",
      "text": "或许可以和你聊聊书上那些英雄传记。嗯，你听说过「坎瑞亚英雄王」的故事吗？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "琴的烦恼…",
      "text": "假如有什么神奇的药剂，喝了就不需要睡觉…嗯，要不明天问问丽莎吧？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "猫尾酒馆的披萨…很久没吃过了。如果能外送到办公室就好了呢。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "优秀的骑士不能挑食。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "不仅味道好，还兼顾了健康。让你费心了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "嗯，精神振奋不少。谢谢你。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "呼…总之，辛苦你了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "今天是值得庆祝的日子。要说为何的话，因为这是受风护佑的你，诞生的日子啊。既然是生日，那就好好休息一下吧。\\n咳咳…祝你生日快乐…\\n啊，请原谅我的冒昧。不知这份礼物，是否能令你满意呢？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "好，一鼓作气前往下一个目标。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "只要风不停歇，我就不会停下脚步。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "就算暂时获得了平静，也不能掉以轻心。身为代理团长，我必须未雨绸缪。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我做得还不够好。自从与你相遇，一直承蒙你的关照。这份感激…\\n风啊，请容许我的私心。并非作为代理团长，只是作为「琴」，在此起誓——我的剑将与你同在。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "一决胜负！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "…哈！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "…散！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "风，回应我吧。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "以剑为誓！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "风之神，请指引我们。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "惊喜的收获。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "嗯，真是幸运的一天。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "希望大家都能获得宝藏。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我，没事…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "还有同伴…需要保护…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "还不能放弃…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "你受伤了…请暂时退后吧！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "让我来吧。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "蒙德…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "个人的力量是有极限的…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我…还不够称职…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "这点伤而已！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "随时可以出发。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "已做好万全准备。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "听凭风引。"
    }
  ]
}