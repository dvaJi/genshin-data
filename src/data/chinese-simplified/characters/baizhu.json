  "outfits": [
    {
      "id": 208200,
      "name": "君臣佐使",
      "description": "白术的装扮款式。肩上的氅衣以长生喜好的草木熏染，清芬长伴，安神消乏。",
      "isDefault": true,
      "characterName": "白术",
      "characterId": 10000082,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Baizhuer_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "嗯，我是「不卜庐」的大夫白术。身体哪里不适，有几天了，和我说说吧…哦？不是来问诊而是专程来找我的？抱歉，恐怕要请你稍候了，我接待完后面的病人就来和你详谈。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·慢节奏",
      "text": "<color=#37FFFF>白术：</color>这一路上的无限风光，得慢慢欣赏才有意趣。\\n<color=#37FFFF>长生：</color>你是不是跑不动了？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·天道",
      "text": "生死有道，天行有常…呵呵，不试一试，谁能知道这天道的边界在哪里呢？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·体质",
      "text": "咳…咳…老毛病了，不是什么大事，你别担心。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "雨天湿寒，还是找个地方避避吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "别怕，小心看路，不要在树下行走，雷电伤不了我们。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "<color=#37FFFF>长生：</color>…好冷，好困。\\n<color=#37FFFF>白术：</color>长生？这就睡着了吗…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "<color=#37FFFF>白术：</color>好天气，「不卜庐」新收的药草…\\n<color=#37FFFF>长生：</color>放心啦，就算七七忘记晾药草，阿桂也不会忘的，好好晒太阳吧。\\n<color=#37FFFF>白术：</color>的确。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "碰上这么大的风你也不躲吗？唉，要爱惜自己的身体啊。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好。我习惯餐前一杯茶，要给你倒一杯吗？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午餐后不要久坐，最好起身走一走，有助于消食。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好，如果是来看病的话，抱歉了，今天「不卜庐」大夫的坐诊时间已经结束。不过，你有紧急情况的话那自然另当别论。如果只是来找我的话，正好，现在是我的私人时间。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "还不想睡吗？可你已经在打哈欠了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于白术自己·今方古方",
      "text": "师父的确留下了不少古人总结出的千金良方。不过古方虽然久经考验，我们这些今人却不能一味泥古。古时与今时，环境不同，风俗有异，过去管用的方子今天不一定管用。还守着过去的千金良方，最终是要耽误病患性命的。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于白术自己·医心",
      "text": "久病的人精神萎靡，如果得的是重症，更是全凭一口气吊着。这时候最要紧的事不是医治他的身体，而是稳固他的信心。毕竟病人要是认定自己活不成，也不想活了，再高明的医术也都无能为力了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·医患",
      "text": "凡是来「不卜庐」求医的，不论贵贱，我都会一视同仁，尽力救治，你也不例外。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·试药",
      "text": "甲之毒药，乙之蜜糖。对某些人来说百害无一利的毒物，对另一些人来说却恰好是救命的良药，这在药理上也是成立的。只是这些话却不能对普通病患说，要是让他们知道我开的方子里有毒药，恐怕以后就再也不敢来这里了吧。\\n知道了这件事却毫不恐惧的，你还是第一个。不愧是见多识广的旅行者，那么以后我也可以放心给你开些猛药了吧？正愁找不到试药的人呢，呵呵。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "呵呵，神也允许我这狂妄之人探索生死之道呢。这神之眼来得正好，多谢了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·蜜饯",
      "text": "说了不怕你笑话，其实我自己也不爱喝苦药。我的体质你也知道，常年喝药是免不了了，没办法，只能喝完药多吃点蜜饯缓解一下嘴里的苦味。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什么想要分享·秘药",
      "text": "我曾遇上一些人，身体略有不适，便以为自己得了重病，以理相劝仍是不依不饶。后来，我干脆以甜甜花和清心为原料，调制出了一批白色无味的药丸，配给这批疑心过重的「患者」。他们得到安慰后，「病情」有所缓和，转而称赞起了我「秘药」的效力。像这类情况，我也是能够理解的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "据说须弥雨林中的蘑菇种类众多，有些品种甚至能让人产生幻觉，大概有些药用价值。不过我一直没有机会详细考察一番，要是以后能有闲暇亲眼看看就好了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于七七…",
      "text": "你猜得没错，封住七七一缕神智的的确是仙人的秘法。也是多亏七七，我才摸索出了保住将死之人的方法。既然仙人都怜悯这孩子，施法将她留在「此岸」，那我顺水推舟收留她，又有何不妥呢？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于胡桃·道不同",
      "text": "观念不同而已，我对胡堂主本人并无意见。非要说的话，应该是她防备我居多吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于胡桃·疲惫",
      "text": "<color=#37FFFF>白术：</color>有可能的话，我还是希望胡堂主做生意时注意些方式方法。\\n<color=#37FFFF>长生：</color>哦，原来你还记着她到「不卜庐」门口打广告的事啊。\\n<color=#37FFFF>白术：</color>唉，没事的时候，也别总是惦记七七了。\\n<color=#37FFFF>长生：</color>你其实对她有意见吧？\\n<color=#37FFFF>白术：</color>我又怎么会真跟她计较呢，只是每次她把七七带走，我都要费劲拜托总务司寻人，实在太累人了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于甘雨…",
      "text": "仙家体质强健，即便身体有恙，不需药物也能自愈。不像凡夫俗子，一旦伤筋动骨，没有医治非落下残疾不可。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于刻晴…",
      "text": "从面部状态来看，玉衡星应该是习惯了熬夜，且思虑过多，才会时不时显露疲态。想要保养好身体的话，还得放下工作，静养为宜。可惜她太过上进，似乎是打定了主意要用健康换事业，我这话说了她未必听得进去。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于瑶瑶…",
      "text": "…这孩子每次来找七七玩耍时都要和我抱怨药苦，问我有没有不苦的药。治病救人的药，哪有不苦的呢？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于钟离…",
      "text": "钟离先生这样的博学多闻之士，哪怕是聊起偏门的古医方也能从容应答，肯定自有一套养生调理的讲究。普通的头疼脑热他自己就能解决了，的确没必要到我这里来开方子。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于魈…",
      "text": "<color=#37FFFF>白术：</color>降魔大圣杀生为护生，心有大慈悲。我曾有幸亲眼见过他本人，还将昏迷的他带回庐中照顾了一天，只可惜当时我不识仙师真身，又没来得及多交谈几句，他就独自离开了。\\n<color=#37FFFF>长生：</color>后来你们不是又见过嘛，不用遗憾啦。\\n<color=#37FFFF>白术：</color>说得也是。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于提纳里…",
      "text": "原来须弥教令院里有你的相识？那能否麻烦你帮我与这位提纳里先生联络一番，我有不少药草方面的事情想要请教。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于嘉明…",
      "text": "比起这个年纪的寻常少年，他身上有更多伤痕旧患，每每过来又常添不少淤青扭损…唉，劝恐怕是劝不住的。我教过他一些包扎和养护的方法，希望对他有帮助。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解白术·其一",
      "text": "我一个治病的大夫，身上能有什么有趣的故事。你要是对传奇故事感兴趣，不如去和裕茶馆请说书先生讲几段。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解白术·其二",
      "text": "非要说什么惊心动魄的故事，我这里实在没有。当初我拜师学医时，也没经历什么重大考验，师父他老人家看我不算太笨，让我发了简单的誓，也就入门了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解白术·其三",
      "text": "誓言不算复杂，我还记得个大概：\\n「…若有疾厄来求救者，不得问其贵贱贫富，亦不得瞻前顾后，自虑吉凶。见彼苦恼，若己有之，如此可为苍生大医。」"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解白术·其四",
      "text": "师父的意思我明白，他是希望我勿为外物所动，多为病患考虑。唉，他老人家的确是宅心仁厚，一心舍己救人，可惜未享天年便早早去了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解白术·其五",
      "text": "医者普救世人，但我以为医者自身也在世人之列。身为医者，既要救人也要救己，舍己为人固然值得钦佩，但没有人生来就是要为他人牺牲的，不该这样。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "白术的爱好…",
      "text": "分拣药材，再依其各自特性炮制成药丸或是药膏，这其中的过程我再熟悉不过。世人都觉得制药过程繁难，但在我看来，其实乐趣无穷。试想，竟有人能将天地造化之功凝聚于小小一剂药中，挽救苍生性命，不是很奇妙吗？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "白术的烦恼…",
      "text": "为病人看诊时最麻烦的从来不是配药，而是找对病因。唉，病人们身体不适的原因真是千奇百怪，有和人比赛吃绝云椒椒吃到肠胃受损而不自知的，有过量饮水导致头晕恶心的…我只盼望世人都能以健康为重，没事不要胡乱折腾自己的身体。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "挑食可不是好事。肉、蛋、奶、蔬菜、水果…凡是有营养的食物都要吃，但也不能吃得太多，暴饮暴食同样对身体有害。你别嫌我唠叨，正因我是大夫，才深刻地明白祸从口入的道理。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "怎么买了这么多糖？你别一口气吃太多，糖吃多了容易蛀牙。我？我对甜味的摄入很有分寸，辛辣的食物也不常吃。你说的没错，我的确非常注意饮食管理。毕竟，如果我连自己的饮食都管不好，又怎么好意思给病人提饮食建议呢。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "<color=#37FFFF>长生：</color>还有吗？多来点！\\n<color=#37FFFF>白术：</color>味道的确不错。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你的厨艺有进步，恭喜。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "不用担心，味道总比药好些。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "<color=#37FFFF>长生：</color>那话怎么说来着…哎呀，白术，提醒我一下。\\n<color=#37FFFF>白术：</color>过生日时的吉利话吗？\\n<color=#37FFFF>长生：</color>对对对。\\n<color=#37FFFF>白术：</color>愿你年年有今日，岁岁有今朝。旅行者，生日快乐。\\n<color=#37FFFF>长生：</color>话都被你说了，那我说什么？算了，我再想点别的。我祝旅行者…嗯…嗯…唉，想不出来了，祝你心情愉快吧。\\n<color=#37FFFF>长生：</color>你们笑什么嘛，人就是麻烦，比蛇还会弯弯绕。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "凡事需循序渐进，不必急躁。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "多劳你费心，感觉身体比以前强健了不少。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "大概是最近体质有所变化的缘故，精神比从前好了许多，坐诊一天下来也不觉得疲惫。这都是你的功劳。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "连日来辛苦你了。明明我自己就是大夫，却还要麻烦你为我的身体忙前忙后，咳咳…惭愧。放心，往后不会有这种事了，我会照顾你。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "<color=#37FFFF>长生：</color>得治治。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "良药苦口啊。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "是药三分毒。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "病宜速救。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "须知惜命。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "且尝，苦尽甘来。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "咳…咳。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "<color=#37FFFF>长生：</color>捣鼓了半天是为了这个啊。\\n<color=#37FFFF>白术：</color>长生…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "冒险生活不容易啊。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "回头擦擦手吧，这箱子我怕不够干净。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "…我还能撑。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "<color=#37FFFF>长生：</color>不妙不妙！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我不能…先倒下。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不可冒进。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "留心伤口…"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "人死灯灭…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "长生，抱歉…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "愧为医者啊…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "啧，眼镜。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "这点痛，哼。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "伤口由我处理。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "这就出诊。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "希望别走太远…"
    }
  ]
}