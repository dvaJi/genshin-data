  "outfits": [
    {
      "id": 206301,
      "name": "冷花幽露",
      "description": "申鹤收到的海灯节贺礼。由其师留云借风真君请人缝制的优雅礼服，双臂上红绳依旧，但申鹤心中的苦寒之意已淡。",
      "isDefault": false,
      "characterName": "申鹤",
      "characterId": 10000063,
      "source": [],
      "filename_card": "UI_AvatarIcon_ShenheCostumeDai_Card",
      "filename_icon": "UI_AvatarIcon_ShenheCostumeDai",
      "filename_iconCircle": "UI_AvatarIcon_ShenheCostumeDai_Circle",
      "filename_splash": "UI_Costume_ShenheCostumeDai",
      "filename_sideIcon": "UI_AvatarIcon_Side_ShenheCostumeDai"
    },
    {
      "id": 206300,
      "name": "缚绝红尘",
      "description": "申鹤的装扮款式。伴随申鹤常年修行的优雅衣装，缠绕身躯的红绳既是束缚也是庇护。",
      "isDefault": true,
      "characterName": "申鹤",
      "characterId": 10000063,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shenhe_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我名申鹤，命格孤煞，易伤身边人，仙人叮嘱要以此红绳锁魂，控制杀心。若你不畏惧与我同行…很好，就请伸出手来吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·归宿",
      "text": "人间的归宿是一种奢望，我早已习惯跟山川与鸟兽作伴了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·要诀",
      "text": "回向正道，保身护命…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·刀枪无眼",
      "text": "刀枪无眼，红绳的力量也有极限，所以我才不喜欢人多的地方。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "按照凡人的做法，这种时候，是否应该…撑伞？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "天气变好，我也很开心。只希望没有人来打扰…如果有，就让他们消失好了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的时候…",
      "text": "把魔物冻在原地，雷劈下来就能瞬间解决它们，还不会让衣服沾上尘土。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "刮大风了…",
      "text": "嗯…师父最喜欢庆云顶上的罡风。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早安。晨露很甜，要分一点给你吗？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "若是午后困乏，不妨试试打坐养神，很有效果。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "不知道你是喜欢人间的灯火，还是山林的月光？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "放心休息吧，我睡眠很浅，有什么动静，我会替你查看的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于申鹤自己·本能",
      "text": "磨砺自身，修炼方术，都是本能使然，想要保全自己而已。我没有兼济苍生的胸怀，惩奸除恶只是顺手，不必感谢我。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于申鹤自己·异类",
      "text": "受我恩惠的人叫我仙人，被我惩罚的人喊我魔女，呵…不管是仙是魔，终究都是跟凡人不同的异类罢了…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·待人接物",
      "text": "我很少下山，不懂得多少待人接物的道理。发生冲突的时候，我一律按自己的方式处理。但，如果你觉得不妥，都请告诉我，即使不理解，我也会听你的。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·红绳",
      "text": "师父赐我红绳用以压制心性，但这些日子你我同修，我才真正领悟到要诀，力量收放也更自在…你才是真正能锁住我的红绳。若你懂得这份心情，就请留在我身旁。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "原来这颗闪耀的石头叫做「神之眼」？呵…有缘既得，无缘便失。日后倘若缘分消散，它也会熄灭吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "邪祟易驱，心魔难除。若自身无法放下执念，仙法与术式都无从挽回。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "为什么说「初雪多浪漫」？那处山巅日日下雪，何日才算是初雪？我不理解，请你告诉我。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于凝光…",
      "text": "人们所谓的财富，对我而言没什么用。但到了凝光小姐手里，却能解决连刀枪都无法处理的难题。她能掌握人间规则，洞察人心…师父说，这些连仙人都无法做到。我很佩服她。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于北斗…",
      "text": "与她相处不用讲究礼节，交谈时也不用揣测深意，让我轻松了不少。只是…她身边总是有人，听说船上还有诸多船员…我需要跟你一起，才能应对人多的场合。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于云堇…",
      "text": "云堇唱的…叫做「璃月戏」吧？我很喜欢这种形式。不必亲见其面，就能了解他人的事迹。如果将来她把你唱进戏里，那一定会是非常精彩的故事，我很期待。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于甘雨…",
      "text": "我从师父那里听过许多有关她的事…她原先在我心中的形象，和实际差距还是挺大的。放心，我不会说出去。说起来，璃月港的工作竟这般繁忙…看来融入人间，也要付出一些代价。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于重云…",
      "text": "真没想到我在这世上…还有「亲缘」。他若是有什么修行上的困惑，我愿帮忙解答。不过，得请他上山来。他们一家太过热情，我不知道该如何回绝才符合礼数…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于行秋…",
      "text": "我曾见到他凑在你耳旁不知说些什么。若他敢威胁你，我一定会将他…嗯？只是朋友间的玩闹话？当真如此吗…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于钟离…",
      "text": "那位先生自称是凡人，却与身为仙人的师父很熟络。师父曾说，如果碰见他在仙府前的石凳上饮酒，莫要打扰，让他静静独坐一会。我照做了。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于白术…",
      "text": "他的药草品质很好，为人也随和周到。相比起来，脖子上的小蛇倒是口无遮拦…放心，我没有动手。我还不至于和一条蛇置气。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于胡桃…",
      "text": "她在附近山林游荡时，经常会唱奇怪的歌。久而久之，我把她的歌断断续续听了个遍。听习惯了也还是觉得奇怪，但，我并不讨厌。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于魈…",
      "text": "印象中他一直不苟言笑。近来见他，虽说沉默依旧，但…像是比从前轻松了不少。兴许是结识了哪位良人吧。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于闲云…",
      "text": "上回，师父带漱玉来万民堂吃饭，漱玉言谈间已有了几分师父的神形…我也是在师父的呵护下如此成长，不知道我的举止，是否也带着些师父的样子呢…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解申鹤·其一",
      "text": "请不必在意人们对我的称呼，我不是仙人，也没什么神通。生于驱魔世家的旁系，长在远离璃月港的山间，只能算是个仙家弟子，仅此而已。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解申鹤·其二",
      "text": "遇到恶意滋事的人，人们似乎都会选择上前说教，我不太明白。明明可以直接将这些拦路碍事、心存歹念的恶人斩草除根，为什么要这般麻烦？"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解申鹤·其三",
      "text": "我师从多位仙家，静心修炼。随着修为提升，他们不再传授我新的术式，而是改教我怎样收敛杀性。别紧张…像平地凿出深坑，树木连根拔起之类的事，只在远离人烟的山林中发生过，从未波及过无辜性命。况且，现在我也已经能控制自我了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解申鹤·其四",
      "text": "父亲想用我的血肉换回母亲的生命。自从被他丢在山洞，我一度期盼过他会回来救我。一天、两天、三天…我拼尽全力与魔物厮杀，直到倒下都没能等到他。我不知道，究竟是我命格孤煞才遭人遗弃，还是命途坎坷使得我萌生出这股煞气？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解申鹤·其五",
      "text": "有一回，我瞒着师父偷偷下山回到村里，却发现原本的村庄荒弃了，父亲早已去世。我突然明白，自己与血亲的缘分彻底断绝了。在乎的往事永无后话。自那日起，我一度舍弃人间种种…直到遇见你。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "申鹤的爱好…",
      "text": "打坐的要点在于「静」，需要摒弃杂念，用身体感受周遭气息，它能让我迅速回归自我。听师父说，修为达到足够境界后，打坐的姿势就不用再拘泥，仙人哪怕站立着都能打坐…我还远远不够。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "申鹤的烦恼…",
      "text": "害怕失去重要之人、想要拯救重要之人…这种心情会将整颗心紧紧揪住，以前从未体会过。这是困扰，但…也是寄托。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "下山期间尝了不少菜，但都不太记得味道了。唯独从前在家吃的那碗面，永远忘不了…不该记住才对，不该记住才对…"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "药草嚼得久了，只剩苦味与涩味…修行多年，我早已习惯这些清规戒律了。仙人们？「仙人不会被人间俗物阻碍修为，所以可以敞开吃各式菜肴。」…这是师父的原话。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "这般滋味…真的是我能够享受的吗？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你做的饭菜，确实美味。无法割舍。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "也好。这样的味道，我早就熟悉了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "我听说生辰是个值得铭记的日子，人们会向寿星送上礼品以示庆贺。身外之物，我不太了解。银河夜色，是我在山林中见过最美丽的事物。我将湖面冻成明镜，让浮云和星斗映照在眼前，跟你共贺生辰…希望你喜欢。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我能操控的力量…愈发强大了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "师父若知道了，怕是会让我多系几根红绳吧…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "这段日子，我闭关修炼的时长有所削减，修为却不知不觉地增进…嗯，也许只有跟你一起才能做到。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "「心无杂念，方可超然」，这是我从前所想。经历种种才明白，唯有心存牵挂，才能唤醒守护的欲望，让力量…变得有意义。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "听令！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "显！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "魂出！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "炼气化神！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "意生冰身！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "付君真形！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "天真敕奏！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "寒冰变神！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "依律奉行！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "这就是凡间的宝物吧。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "与仙人法宝有何区别？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "这些东西…该用到何处？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "休要怪我…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我不甘心…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "必须…诛除！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不必勉强。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我来了结。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "难逃…宿命…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "死丧既定…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "劫煞为灾…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "不成气候。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "休想！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "别后悔！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "团队作战…是什么意思？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "明白，站在这里就行了是吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "…听君敕令。"
    }
  ]
}