  "outfits": [
    {
      "id": 202200,
      "name": "青风结诗",
      "description": "温迪的装扮款式。自由随性的吟游诗人装束。",
      "isDefault": true,
      "characterName": "温迪",
      "characterId": 10000022,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Venti_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "哈…睡得好香呀。欸，你好呀，旅行者，我们又见面了。嗯？不记得我了？嘿嘿，那就让我再次加入你的旅程吧。你的诗篇，值得被我这个世上最好的吟游诗人传唱！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·弹琴",
      "text": "嗯…想接着听下去的话，送我一个苹果吧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·苹果酒",
      "text": "嗯…好想坐在大树上，手边有喝不完的苹果酒。哎。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·诗篇",
      "text": "动身吧，旅行者。佚失的诗篇，还在等着我们呢。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "来踩小水坑吧！看看谁溅出来的水花更大！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "欸~这就天晴了？我还想多玩一会儿呢。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "等雪积起来…我们来打雪仗吧！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "刮大风了…",
      "text": "难得呀，要不要去飞一飞？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早，准备开始新的冒险了么？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "咕…肚子饿了，又不敢再去晨曦酒庄蹭饭…啊，是你呀！欸嘿，要出门么？带我一个呗。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "我还不困哦。要我陪你走走么？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "欸？要休息了吗？嘿嘿，晚安。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于温迪自己…",
      "text": "练习？哼哼，我当然不需要啦，在这提瓦特就没有我不会唱的歌。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·新歌",
      "text": "我想把你写进新歌里！欸，怎么露出这种表情呀，担心付不起稿费吗？哈哈，摩拉就不要了，不如…跟我再讲讲你的故事吧！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·勇者",
      "text": "#唔…嗯！嘿嘿，等到勇者救出了{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}，我会第一时间让全大陆传唱这首歌谣。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·使徒",
      "text": "夜风凉爽，是适合成为神的使徒的天气！那么事不宜迟，快来向我献上供奉吧？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于我们·请求",
      "text": "欸，要风神我更加努力一点？那你是不是也要展示点诚意呢。比如虔诚、热爱，或者说…"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "欸？好奇我的「神之眼」？喔…喏，给你。喜欢的话…要我给你做一个一样的么？嘿嘿嘿。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "Olah！嘿嘿，这是丘丘人打招呼用的话哦。问我学这个干嘛？哎呀，为了创作，知识面当然越广越好啊。唔，好像，我还没尝试过用丘丘语写歌呢…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "旅行者，你见过塞西莉亚花么？那是一种只在安静的山崖顶上默默绽放的白色野花。在我心里，它就是全提瓦特最美的花。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于琴…",
      "text": "骑士团代理团长大人…你觉得她是个怎样的人？嘿嘿，跟我想得一样。认真，勇敢，也不乏温柔。和我一个朋友有点像呢…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于迪卢克…",
      "text": "去跟迪卢克老爷处好关系吧？你想，他家可是有好~多~珍藏的酒啊！嘿嘿嘿，嘿嘿嘿嘿…咦，无论如何不准喝酒么？那…就去闻一闻吧，闻一闻！只是闻的话，你也可以喔。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于芭芭拉…",
      "text": "唱歌很好听的牧师女孩儿，你认识么、你认识么？…唔，偶像？…啊，握手会？…嗯，专场live？…这样啊，音乐还真是深奥呐。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于雷泽…",
      "text": "那个奔狼领的白发少年，哦哦，是吗，是被狼养大的啊…怪不得呢，他身上的气息，令人怀念…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于莫娜…",
      "text": "啊，那位占星术士吗？这么说吧，占卜和我的诗歌一样，都是让人穷到酒钱都凑不齐的没用技术呢！欸？你说占星至少是一项文化传统，所以不是没用的？呜，真失礼啊，那诗歌也一样有用啊！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于迪奥娜…",
      "text": "远近闻名的猫尾酒馆特调酒。可是…呜，会，打，打喷嚏。要不，你帮我讨一杯酒来吧。我肯定会好好感激你的，一言为定。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "黑土与白垩、宇宙与地层，无垢之土创生原初之人…特征实在太明显了，难以忽视呀。这么危险的古老技术，万一在城里失控——嗨，算了，就让蒙德人自己解决蒙德的问题吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于摩拉克斯…",
      "text": "你见过那位老爷子了？他近来还好吗？欸，变成名叫「钟离」的普通人了？对他那个死脑筋而言，这应该是不小的改变啊。啊，陪我去见见他吧，带上这瓶埋在风起地的陈年好酒当作慰问品。啊对了，他现在还强不强，实力还剩几成啊？我这样过去，应该不会被打飞吧？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于优菈…",
      "text": "优菈对酒的品位可是很不错的。无论夏天、冬天都要喝冰的这一点，在现在的蒙德人里也算难得啦。感觉能和她成为不错的酒友。嗯？你说我编排的劳伦斯家的歌…早已经传到了她的耳朵里？哈，那有什么关系嘛？说不定，我们还能一起唱呢。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于巴尔…",
      "text": "听说，你把那位不可一世的雷电将军也击败了？啊…想当年她作为影武者的时候，就在追求极致的武技了。如今，也一定会借用各种各样的理由叫你做陪练吧。嗯嗯，偷偷告诉你她的弱点吧，耳朵凑过来——是「甜点心」哦！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于布耶尔…",
      "text": "你说草神啊，说到草神，就会先想到她那关于「梦境」的权能吧？与我所作的那些诗歌一样，她所创造的梦境也一样充满了浪漫与想象，我们可是很合得来呢。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "吟游诗人所擅长的，多是弹奏与演唱，可一位戏剧表演者所需要具备的能力，还远远不止这些…下次风花节把芙宁娜请过来一起表演怎么样？嗯？你想让我聊聊她拯救枫丹的事？有这样艺术才华的人就算拯救了整个世界，也毫不奇怪吧？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于赫布里穆…",
      "text": "需要一个又一个的人类成为柴薪去对抗漆黑的威胁，这个世界还真是不讲情面。但在玛薇卡的带领下，他们创造了堪比魔神的成就…嘿嘿，从「她」开始，纳塔人似乎一直就是这样呢。对了，我听说玛薇卡很喜欢喝酒对吧？要不然…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于塔利雅…",
      "text": "旅者，你想要聆听风的声音，寻求风的指引吗？那么…去找这位助祭肯定没错。哈哈，开个玩笑。你随时可以找我一边喝酒一边聊天噢！至于我平时拜托塔利雅传递消息的原因…你已经猜到了吧？他热衷于追逐喧嚣的风，却从来不会失去自己的方向。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于杜林…",
      "text": "又有一位魔女小姐的孩子在蒙德落脚了，真热闹呀。这位小朋友看起来很想跟我的一位大朋友一起玩，于是我便做了一些微不足道的引荐工作。让人惊喜的是，大朋友比小朋友还激动，高兴得上蹿下跳，拍着肚皮转圈跳舞呢。哎呀，被大朋友听见了？快快，我们往树后躲一躲。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解温迪·其一",
      "text": "来得正好，旅行者。我想听听，你的愿望是什么？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解温迪·其二",
      "text": "跟你一起旅行真是件有趣的事，要说美中不足就是你身边的那只小不点了吧。那么能吃，你们的伙食费很了不得吧？哈哈。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解温迪·其三",
      "text": "火之神是个横行霸道的战斗狂，岩之神是个不懂人心的死脑筋。问我怎么会知道这些？欸嘿，叙事诗里都写得一清二楚嘛，他们的故事。那个年代的故事。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解温迪·其四",
      "text": "天空岛啊。连我也不一定飞得到那里呢。而且在那里，没有甜的水，也长不出什么好吃的果子。就更不会有好酒咯？嘿嘿，所以请我去我都不想去哦。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解温迪·其五",
      "text": "我的愿望？嗯。以前，我想着要游历整个世界。现在也一样，不过嘛，加上了一份限定条件，那就是跟你一起。有你在，才是完整的。记叙者果然要和冒险者在一起才行嘛，嘿嘿！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "温迪的爱好…",
      "text": "我喜欢酒！还有风！唔，如果能有用风酿的酒就好了。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "温迪的烦恼…",
      "text": "其实，只要有猫在附近，我就忍不住会打喷嚏…啊-啊-阿嚏！唔…哎呀…就连想一想也不行么…欸，你知不知道该怎么治好这个毛病呀？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "你也来一个苹果吗，刚摘的。啊呜，啊…又脆又甜，苹果才是神的馈赠吧！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "哎，你在做什么好吃的吗？欸？热奶酪饼！这个…这个不行，热热的黏糊糊的，唔…对我来说，太腻了…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "啊，好满足！明天也会有吧？后天也会有吧？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "呼，好饱，连餐后水果都要吃不下了…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "竟然是连我都应付不来的食物。唔…这下可难办了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "我以前听朋友说生日是要吃蛋糕的…喏，苹果蛋糕，给，勺子。烤出来的时候有点塌了，所以看上去像是苹果派。欸嘿，甜点还真是复杂呀。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "欸！刚刚发生了什么！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "辛苦啦。想要来点音乐放松一下吗？随想曲，还是小夜曲？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "来，坐这边。我写了一首新诗哦，就叫它「旅行者之风」吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "唔…明明这些风景早就看过很多遍了，有你在身边，却像是呈现出了不同的样子。你该不会…还藏着一大堆奇奇怪怪的能力吧？…唔，那倒也不错。说明，我看人的眼光很准呀，欸嘿。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "哟呼——"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "在这哟。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "留意脚下。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "一起来玩吧。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "别想逃开喔？"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "起风咯~"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "飞，比跑快吧？"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打开风之翼·其一",
      "text": "呀嘿~"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "咳咳，请听一首，「宝箱之歌」！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "嘿嘿，要不要感谢「风神的眷顾」呀？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "收获不少，可以拿去换几瓶好酒啦。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "等等，这可不好玩！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "哎呀，别盯着我打呀。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "好过分呐。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "交给我吧。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "还不能放弃哦。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "稍微睡一下吧…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "啊呀，弦断了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "扑通。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "哎呀…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "好粗鲁哦。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "调音完成。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "让你久等了哦？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "是要做热身运动吗。"
    }
  ]
}