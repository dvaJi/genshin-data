  "outfits": [
    {
      "id": 204400,
      "name": "灵魂热望",
      "description": "辛焱的装扮款式。装饰有尖刺的摇滚乐手服饰。",
      "isDefault": true,
      "characterName": "辛焱",
      "characterId": 10000044,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xinyan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是辛焱，璃月港唯一的摇滚乐手，最近在想要不要去其他地方巡回演出，目的地的话…啊，听说你是走遍了很多地方的旅行者，对吧？让我加入你们吧！去哪里都行。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·气势",
      "text": "摇滚不可缺少的，就是激情——喂，别发呆了，快动起来！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·新曲",
      "text": "要不我来弹首曲子给你听，我新写的哦？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·注目",
      "text": "快看那边！好像有很摇滚的东西！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "这么大的雨…可不能让琴被淋到了啊。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "看样子这雨一时半会儿不会停…嗯，但演出不会推迟！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "唔…这种天气要怎么吸引观众呢？对了！来一场「暴风雪极限耐力摇滚挑战」怎么样！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "刮大风了…",
      "text": "呜哇，快找个地方躲躲，不然发型要塌了！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早啊，我刚刚在开嗓，今天嗓子的状态也好得很呢。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "啊，收工了收工了，哈…没什么事的话，我去打个盹儿。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "马上就要演出了，你也一起来嗨吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "哦，好的，你先去睡吧。我吗？我还要保养我的琴，还想改改曲子，嘿嘿，刚从舞台下来，睡也睡不着的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于辛焱自己·凶恶",
      "text": "你居然不怕我？唉，有人说，我眼神跟刀子一样，衣服不好好穿，讲话也不守规矩。他们一看到我就躲得远远的，哎，真是…只是风格不一样而已，我又不是什么怪物…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于辛焱自己·摇滚",
      "text": "摇滚是从枫丹传过来的，算是新东西吧。不过啊，在璃月挺不受欢迎的，一般人都觉得吵吵嚷嚷，不喜欢听。所以我啊，很感激每一个能来听我唱歌的人，哈哈。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·观演",
      "text": "来看我演出？哈，到前面来吧！前面的感觉更好。咳咳，那么，璃月港独一份的摇滚现场，现在开始！"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·投缘",
      "text": "我还在想为什么和你这么聊得来，原来你不是这个世界的人，那也就用不着关心这个世界的条条框框了——人生就该是这样！繁文缛节什么的统统闪一边去，无拘无束，自由自在。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于我们·邀请",
      "text": "我想让我摇滚的音乐元素更丰富一点。其实，你的节奏感很好嘛，要不要试试帮我打鼓？没打过？唉呀，不要怯场，关键是气势。来试试看嘛，你绝对很有天赋的。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "会把「神之眼」的火用来给摇滚伴奏的，估计全提瓦特也就我一个。有人批评我，应该好好敬重这种力量…不过，既然神都把「神之眼」给了我，就说明他对我的用法，也是认可的吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·命名",
      "text": "这把琴，是我亲手做的哦。本来是按照枫丹的摇滚乐器来做的，但做着做着就不再是一个东西了。我一直想给它取一个好听又好记的名字，比如「焱琴」「碎玉」「定山」什么的，但还是差点味道…你有什么好主意吗？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "有什么想要分享·宴乐",
      "text": "欸，你知道「宴乐」吗？就是有钱人在宴会上听的曲子。一会儿唱这个多有本事，一会儿又唱那个多了不起…把音乐用成这个样子，哎呀，一点儿都不摇滚。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "我最喜欢的一套演出服，是我亲手用「霓裳花」织的。你肯定也见过那种花吧，红得够激情。而且，和我的摇滚也很搭呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于香菱…",
      "text": "我经常去「万民堂」吃夜宵，香菱如果手头不忙，还经常跟我聊天，一直聊到很晚很晚。啊？你问我都点的啥？嗯…其实是香菱做啥我吃啥，哈哈。每次都不一样，味道也千变万化，她可以说是料理界的「摇滚明星」了！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于钟离…",
      "text": "以前没什么人听我的摇滚，有一天他突然来邀请我，说可以去他那里试试，合适的话可以去当驻唱歌手，我心里激动啊，终于有人理解我的音乐了！就直接答应了下来。结果去了场地才知道，他居然是那个「往生堂」的客卿…这明显不合适啊，真是个怪人。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于凝光…",
      "text": "你知道千岩军吧？他们以前总是妨碍我，说什么这里也不准搭舞台，那里也不准，麻烦死了。咳咳，不过在我找总务司申诉之后，听说那个「天权星」专门修订了璃月的什么…呃…反正是某个规则，划定了演出专属场地，还要申请什么许可。哎…其实还是很麻烦，不过，好歹不用像之前一样，被赶得到处乱跑了嘛。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于白术…",
      "text": "白术先生开的药方保养嗓子效果一流，为了答谢他，我在他面前来了一段即兴摇滚，结果…他养的那条蛇就晕了过去。从那以后，那条蛇看到我就一个劲儿地往白术先生的衣领里面钻，哈哈哈。我从那以后才知道，蛇原来对震动很敏感。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于北斗…",
      "text": "她啊，说话直爽，气量也大，聊起来特别投缘。「死兆星」号乘风破浪的故事，实在是太帅了，给了我很多摇滚的灵感。嘿嘿，我还专门写了一首歌给他们。现在，只要我唱第一句，好多船员都能跟我唱下去，都快变成船歌啦。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于重云…",
      "text": "他超有意思！看上去文静内向，但有一次演出，他好像是被朋友叫过来，要跟我说什么话。舞台上声音太大，我还没听清呢，他已经一个箭步跳上台来和我一起唱了，还唱得特别摇滚。这就叫「人不可貌相」吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于胡桃…",
      "text": "她明明是往生堂的堂主，却每天一副开开心心的样子，完全不知道在想什么。街上碰到的话，还会大大方方地和我打招呼，说什么「喜欢玩火的人，是生意兴隆的保障呢。」…呃，有、有点诡异。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于云堇…",
      "text": "告诉你个小秘密，别到处乱讲哦。那个人可喜欢摇滚了，不管多忙，一周都来听我三场，只多不少。按理说，「和裕茶馆」的戏班头牌，该喜欢什么琴棋书画，花鸟虫鱼才对吧？肯定是平时被憋坏了，哈哈哈。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于嘉明…",
      "text": "他第一次说我是「摇滚发烧友」的时候，我还仔细摸了摸额头，回答他说「没有啊」，结果他来了句「你绝对是」，我们争论了小半天，最后才发现是误会，他跟我说「发烧友」就是「爱好者」的意思。哈哈哈，他可真好玩，我要把这个词写进歌里！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解辛焱·其一",
      "text": "想要了解我？哈，一般人看到我就躲得远远的了，你还真是奇怪。那好吧，那就…从了解我的摇滚开始？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解辛焱·其二",
      "text": "小时候，大人都让我要像个女孩子，让我学这个，学那个，但我天赋不行，总是挨骂。摇滚就不一样，没人教我，我也能做得很好，但却被大人说「没个女孩儿样」，唉，这就叫成见。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解辛焱·其三",
      "text": "你有注意到我今天有什么区别吗？其实为了见你，我出门之前做了面部的按摩，放松了眼睛和嘴，还对着镜子练习了半小时的微笑。怎么样？是不是看上去没那么凶了？比原来更凶了？唉…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解辛焱·其四",
      "text": "陪我练琴辛苦了！欸？差不多到中午了，来吃午饭吧，你的份我也准备了！喏，里面有西红柿，香肠，煎蛋…什么？我不像是做这种事的人？别、别小看我啊！做个吃的，摆个可爱的造型，也、也没什么不行的吧。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解辛焱·其五",
      "text": "我很信奉摇滚的反抗精神，但我觉得这不代表我就一定要去张扬个性，我也可以有很正常的生活，可以做缝纫，可以养花养鱼，可以做造型可爱的菜肴，可以喜欢任何事，还有…任何人，对吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "辛焱的爱好…",
      "text": "爱好那当然是摇滚！你有没有全情投入过某件事呢？当你与你最爱的东西合二为一，时间空间什么的都不再重要，只需要尽情享受，尽情宣泄——对对！这样沉醉进去的感觉，上百次上千次都不够！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "辛焱的烦恼…",
      "text": "我每次不小心和路边的小孩子对上眼，都会把他们吓哭。唉，到底有没有办法，能让我看起来不那么凶啊？能想到的办法我全试过了，都没什么用…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "璃港船局的午饭真的超好吃！油水很多，肉也管够，虽然菜就那么几样，但我怎么吃都吃不腻！要我说，光是为了尝尝他们的午饭，就值得去船局干一天活！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我几乎不挑食，但我讨厌清汤寡水的菜。咸就是咸，辣就是辣，有滋有味吃着才过瘾！哪怕食材只够做一道「珍珠翡翠白玉汤」，我也会事先备好干碟蘸水。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "身体情不自禁想要跟着律动起来。太酷了！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "味道不错，稍微欠点「火花」…需要我帮你摆个盘吗？"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "你不介意我调点佐料，配着吃吧？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐！你看，这是我特地做的刺绣，我参考枫丹的洋娃娃的样子，把我们两个纹在了上面，特别可爱对吧？欸…为什么这样看着我呀，我、我会刺绣是很奇怪的事吗？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "嗯！就是这样的节奏！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "状态火热，期待我的下一次演出吧！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "掌握了这么强的力量，说不定也能创作出前所未有的摇滚！谢谢你，我的新作不会让你失望的！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "酷！我感受到你饱满的「激情」了！那么，就让我写一首专属于你的摇滚，只为你而奏响吧！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "能跟上节拍吗？"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "热情还不够！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "来点火花吧！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "摇滚时间到！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "为反抗高歌！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "听我的最强音！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "为了庆祝，演奏一曲吧！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "很「摇滚」嘛！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "气氛嗨起来了！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "都还只是前奏…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "乐感不太好啊。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "这种程度，早习惯了。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我的摇滚会支援你的。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "这可不摇滚！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "节拍…乱了。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "还不够…激昂…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "不该…跑调的。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "这可不摇滚。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "啊，我的琴！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "轮到我登场了！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "非常摇滚的选择！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "一起演奏吧！"
    }
  ]
}