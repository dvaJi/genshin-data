  "outfits": [
    {
      "id": 208400,
      "name": "幻戏猫",
      "description": "林尼的装扮款式。猫只在它完全信任的人面前伸懒腰，其余的时候，它藏起自己的爪子对人微笑。就像魔术师先生的甜言蜜语一样，亲密却有所保留。",
      "isDefault": true,
      "characterName": "林尼",
      "characterId": 10000084,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Liney_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "是我哟，全提瓦特最棒的大魔术师——林尼。惊喜吗？意外吗？想知道我是怎么出现在你面前的吗？嗯——你那双像黄宝石一般晶莹剔透的眼睛，让我很中意哦！让我再为你表演一次吧。看好了哦，这回，千万不要眨眼。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·分心",
      "text": "大魔术师就在面前，还有心思东张西望吗？这样可就要错过最精彩的一幕咯！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·妹妹",
      "text": "我亲爱的妹妹——琳妮特此刻在做什么呢？肯定想我想得不得了吧！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·眼见为实",
      "text": "我希望观众们都相信「眼见为实」的道理，那我就能变出数不尽的戏法。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "哎呀，这种天气，看来今晚没办法看到星星了。除非…我试着把星星变出来？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "真幸运，天晴了，该不会天上有谁在变魔术吧？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "啊嚏…呼…我听过一种说法，说打喷嚏是有人在想自己。琳妮特吗？哦——还是你呢？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "呼，好险。要是帽子被风吹跑的话，里面的道具就会哗啦啦砸在我脑袋上了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "这风也太大了，我的纸牌都——等等，哎，别迷路啊！你的主人在这边！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "…唔，再让我睡会儿…嗯？是你呀——嗯，我说怎么今天的阳光那么好，原来是你来了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "下午我需要检查一下魔术用品，构思新的魔术创意。你要一起来吗？来嘛，别推脱啦！你可以试着喂喂我的动物助手们，我想你们一定合得来。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好。今晚有大魔术师的演出，你肯定没忘吧？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。要是睡不着的话，我有些催眠小道具可以用…啊，还是算了吧。睡吧，愿美梦陪你到天亮。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于林尼自己·嘴甜",
      "text": "对了，有件事情，我必须强调一下。我可不是对所有人都这样说话的哦，主要还是因为对象是你。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于林尼自己·搭档",
      "text": "啊——琳妮特不在，我要进入待机模式了。虽然一个人也能处理好身边的事，但还是会有些不习惯。你能理解的吧？毕竟你也…我是说，毕竟派蒙总陪着你。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·隐瞒",
      "text": "哇，好尖锐的话题…这么说吧，甜美的浆果通常出没于荆棘丛生之地，不然就会被馋嘴的狐狸一口吃完…这都是为了保护自己呀！好吧，我承认我确实不介意偶尔对别人撒点小谎，但我们之间最多只能算是有所隐瞒吧？不是吗？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·原则",
      "text": "魔术师一般不会透露魔术的核心秘密…但如果你愿意喊我「林尼老师」，成为我的学生，那么「原则」就产生了变化。也不知道你的领悟力和耐心到底能有几分呢？真让人期待。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "魔术师佩戴着神之眼上台，难免会遭到质疑，所以我习惯了提前摘下它。既然你有兴趣，要不下次我表演的时候，就由你帮我保管它吧？要看紧一点哦，可千万别让它又偷偷滑到我手上了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "魔术不仅是一种表演形式，也是一种思维方式。世界上有很多看似平平无奇的东西，其中大有玄机。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "猫咪的耳朵能表达情绪，向后翻折说明恐惧或者警戒，向前竖起，偶尔朝外多半表明心情愉快，快速晃动则是在警觉地判断四周情况…多观察就有经验了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于「父亲」·家",
      "text": "「父亲」给了我们一个家，教导我们成长，告诉我们每个人应该努力的方向。我能做的也很简单。保持忠诚之心，以及…守护我们的家。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于「父亲」·王",
      "text": "在这座只有孩子们构成的王国里，「父亲」是我们的王。我知道国王早晚会选继承者，也知道那会是我…但同时，我对那样的情况感到恐惧…请不要告诉任何人，尤其是妹妹和菲米尼。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于琳妮特·模式",
      "text": "你觉得妹妹她话很少？明白了，那是运行模式不对。下次，先对她说「激活，聊天模式」，运气好的话，她会和你说上很长一段话。你问运气不好要怎么办？别担心呀，就算被她瞪几眼，你也见到了和平时不一样的琳妮特！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于琳妮特·双子",
      "text": "我和妹妹从小到大都在一起，艰难的时光只要有彼此就能度过，开心的时候也会和对方共享。家人，就是我们最宝贵的归宿。我们都能理解你与家人分别的痛苦…如果发现了任何线索，一定会告诉你的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于菲米尼…",
      "text": "我这位天真的弟弟，至今还相信童话故事。真让人有些羡慕。哦，这不是他自己告诉我的，是有次我不小心看到了他锁在秘密抽屉里的东西…真的是不小心哦！所以还请你不要告诉他，不然他肯定会生我气的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于那维莱特…",
      "text": "那维莱特先生很少公开露面，似乎刻意和人们保持着距离。一开始我还以为是我的错觉，但观察最最敏锐的琳妮特也有同感，那看来确实是这样了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "水神芙宁娜大人的行事作风不可捉摸，说得更露骨些，她平时说话也像是一种表演。枫丹人对精彩的舞台演出情有独钟，因此崇敬她的人也有不少。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于千织…",
      "text": "恭维话在她那里是行不通的，只有真正懂得欣赏的人，才能让她另眼相待。你问她怎么看我？这问题可让我有些伤心哦，我可是既懂欣赏，又对大家真心相待的人呀。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于娜维娅…",
      "text": "没想到她在不认识我的情况下愿意出手相助。要是没有你们的话，我和琳妮特肯定无法脱身…总之，非常感谢你们。就请让我等待一个阳光灿烂的日子，邀请大家去露泽咖啡厅吃最美味的茶点吧。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于夏洛蒂…",
      "text": "自从那次见面之后，夏洛蒂小姐多次邀请我接受专访，呃…好像快有个二十次了吧。她对新闻有种与生俱来的敏锐，个性还异常执着。但说老实话，我可不想成为她笔下「爆炸性新闻」的主角，只好一次又一次用不同的理由婉拒了。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于克洛琳德…",
      "text": "作为决斗代理人，克洛琳德小姐颇有名望。但我最近在报纸上看到，她似乎麻烦缠身…媒体非常喜欢挖掘她的故事，至于她本人…应该相当厌恶这种行为吧。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于艾梅莉埃…",
      "text": "你闻过她设计的香水吗？我还挺喜欢的，原本想买一瓶试试…但琳妮特的尾巴似乎有不同的意见。那我也只好算喽。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解林尼·其一",
      "text": "看来我们彼此都对对方很感兴趣呢，我的荣幸！哈哈，放心吧，只要看到你那令人着迷的眼睛，我就舍不得对你撒谎。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解林尼·其二",
      "text": "魔术表演当然没办法保证永远不出现纰漏。对我而言，演出的重点也不是百分之百避免穿帮，而是时时刻刻保持镇定，随机应变。就算露出了小破绽，只要能让观众相信那也是表演的一环，依旧能成为一场精彩难忘的演出。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解林尼·其三",
      "text": "没有父母遮风挡雨，从小流落街头的孤儿，总要经历比常人更多的磨难。但正因为那些事情，才造就了如今的我和琳妮特。现在，我们都过得不错…「家人」、观众…我的帽子里装着很多很多人的期待呢！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解林尼·其四",
      "text": "哈哈，到现在还没办法完全相信我说的话吗？看来你警惕心很强，这是好事，我就不用担心你被别人骗了。另外嘛，你可要负起责任来，盯着我，谨慎挑选眨眼时机…不然的话，趁你不注意，我就去撒弥天大谎咯！到时候你也脱不开干系。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解林尼·其五",
      "text": "「真实」的我，并没有我所表现出得那么外向、健谈。更多时候，我是为了跟大家拉近关系，才使用了语言上的「魔术」…你会同情原本的我吗？还是会觉得这种戏法…很愚蠢呢。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "林尼的爱好…",
      "text": "嘿，看这儿——可爱的小白兔，喜欢吗？好奇它是什么时候来到这里的吗？那就对了！观众脸上惊喜的表情，正是每一位魔术师的最爱。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "林尼的烦恼·掩饰",
      "text": "怎么办呢？我最大的烦恼就是——你在我这样的大魔术师面前，还能想到烦心的事情。"
    },
    {
      "id": "6011",
      "type": 1,
      "title": "林尼的烦恼·鸽子",
      "text": "过去，我总是放养我的鸽子，它们也总会飞回我的身边。后来有一次，回家的鸽子少了几只，等我们循着痕迹找到的时候，它们已经变成了鸽子派。至今我也不知道，我要怎样同时带给它们「自由」和「安全」。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "看到这个鱼缸了吗？来，你可以把手伸进去感受一下，是不是真的只有水。确认好了吗？那就开始咯！看这块布，现在盖上去了…嘿呀，鱼变出来咯！怎么样？这精彩的表演，能换一道你亲手制作的鱼肉菜肴吗？"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "出于表演需要，我和琳妮特得保持身形相似，我们会尽量不吃油炸食品。我倒是无所谓，妹妹就比较辛苦了——街头的炸鱼实在很香嘛！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "能吃到你亲手制作的美味，真是荣幸之至。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你的厨艺不错嘛，很好吃哦！多谢款待。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "想看魔术吗？来吧，看我把布盖在上面，你跟着我一起念——三、二、一！食物消失咯！"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "这里有一根羽毛，请伸出手来确认一下，它的确是一片普通的羽毛。好了吗？啪嚓——其实是礼花哦，生日快乐！看到了吗？礼花里飘下的一片彩纸，被我抓住了。在我点燃它的同时，你就可以许愿了，顺带想象一下你的生日礼物。三、二、一——嗯，很~好~我已经明白你的想法了。来吧，把手伸进我的帽子里——如何？这份礼物是你想要的吗？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "哎呀，我还以为你想让我用这些素材变魔术呢。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "要是什么变化都没有，会不会让你更加吃惊？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "你愿意信任我，没有比这个更令我开心的事情了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "为我付出这么多，是想要偷走我的心吗？那就让我恭喜你、祝贺你吧！我亲爱的学徒，或者说伙伴——你已经做到咯。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "一点小把戏。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "看看这个吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "惊喜连连。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "压轴表演！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "好戏开演！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "响起你的掌声！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "用这个道具，把它们全部变走…开玩笑的啦。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "装进魔术口袋里吧。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "这也算是一种宝箱魔术吗？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "这是要我表演诈死魔术吗？"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不错的戏法…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不会有事的。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "可别忘了还有我啊！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "节奏已经乱了哦？"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "琳妮特…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我的表演，不会失败！…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "幕布…快点拉上…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "没事。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其一",
      "text": "冷静…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "噢！「旅行魔术团」。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "乐意效劳。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "能被你邀请是我的荣幸。"
    }
  ]
}