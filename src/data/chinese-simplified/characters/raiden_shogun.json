  "outfits": [
    {
      "id": 205200,
      "name": "御建鸣神主尊之典",
      "description": "雷电将军的装扮款式。因以「雷之三重巴」纹为饰而获得无上地位的尊崇着物。",
      "isDefault": true,
      "characterName": "雷电将军",
      "characterId": 10000052,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shougun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "无须行礼，此身虽然尊贵殊胜，不过此般前来，是想要做些微服游历民间的事。我看上了你的身手，现在你就是我的御侧保镖了。不用担心，遇到危险，我会出手的。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·徒然",
      "text": "徒然无事，对砚枯坐。哼。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·浮世",
      "text": "浮世景色百千年依旧，人之在世却如白露与泡影。虚无。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·花鸟余情",
      "text": "无人相陪，此般花鸟余情，也不过衬托我身不移不变的背景罢了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "只是雨滴有什么麻烦的。这还没有打雷呢。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "哎呀，你不会怕了吧。明明此世最为殊胜最为恐怖的雷霆化身就站在你身边。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "冬将军也来了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "晴天的时候…",
      "text": "天晴也并不能掩盖雷霆的威光。不下雨也可以降下神雷，看到那棵树了吗？你说你懂了，叫我停手。好吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "道完早安就打呵欠，太懈怠了。我这次就赦免你的无礼了。早安。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "啊，想吃甜点心。嗯，为什么不行？什么叫「哪有这个时间吃甜品的」。之前是因为他们看我是将军所以惯着我的？这样啊。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "你想知道夜晚流星的真相吗？哈哈，真相就是缥缈须臾的一瞬天光罢了。嗯，你说其实是你？你也是天狗吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "我命十方世界雷鸣平息，愿你今晚得享安睡。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于雷电将军自己·须臾",
      "text": "雷鸣闪电，一瞬即逝。正因如此，才会想要撷取「永恒」。不，才必须掌握「永恒」。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于雷电将军自己·永恒",
      "text": "「磨损」是一件很可怕的事情。此身诞生的意义，就是承受磨损。这样，或许「内在」就可以触及永恒了吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·奥诘众",
      "text": "现在你是我的侧用人，换言之，依我判断，你是对幕府有用，对我忠诚的人。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·用心棒",
      "text": "虽然是微服出访的保镖，但是我遇到危险不用替我挡刀了。将军她构造还挺结实的，坏了还能替换呢。所以遇到危险把将军她推到前面就好了。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·直传",
      "text": "稻妻的薙刀术和剑术以及锻刀技法，基本都是由我直接传下的，随后因人资质不同而分枝开花、各自结果。\\n如何，再接我一刀？还能无事的话，许可你在稻妻开宗立派哦。啊，武艺的精进真是叫人欲罢不能。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "外面的世界居然已经这么久没有出现过雷元素的神之眼了吗？虽然我因为一些制约无法说明…赐予神之眼这件事，和我的意志无关。重要的，还是人的「渴望」，以及…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "有什么想要分享的？没有。倒是你，为什么没有神之眼却能使用元素之力。和我说说。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "虽然身消梦陨，但是她化作了神樱。这，也是「永恒」。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于八重神子…",
      "text": "那家伙啊，最初她就是个会被油豆腐引诱的家伙。现在居然这么工于谋略了，让人欣慰。不过被她算计了，还是有些不愉快。虽说是为了我好，下次见到她恐怕会被她嘲笑的…那就先发制人，斩她一刀好了。反正她也能躲掉。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于神里绫人…",
      "text": "神里一门，无愧于稻妻名门笔头之格。绫人虽然此前在三奉行事务中，耍了不少手段，但是本身忠心可鉴。既往不咎了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于神里绫华…",
      "text": "神里一门，无愧于稻妻名门笔头之格。欸，你说我和将军的评价一模一样。那，绫华她，她剑术也很好。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于九条裟罗…",
      "text": "忠义之士，武艺精湛，可担「豪杰」二字。有此麟儿，九条家应该还能兴盛下去吧。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于宵宫…",
      "text": "是谁来着？啊，做烟火的。制造须臾幻象的人，沉醉于夏日幻觉的人，虽说如此，亦为我之臣民。\\n嗯，在天领奉行属地里炸烟花？谁啊，她吗？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于托马…",
      "text": "虽然差点夺走他神之眼这件事，我也不能说是完全没有责任。但要说道歉的话，还是应该让将军她去比较好吧…好吧，我也会好好反省的。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于珊瑚宫心海…",
      "text": "奥罗巴斯确为此身所斩。但是我也许可了珊瑚宫之民，以海祇大御神之名继续祭祀，让它得享牲醴。现在珊瑚宫捣毁鸣神分社，反叛幕府。她作为海祇大御神的现人神巫女，必须要承担责任。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于国崩…",
      "text": "那小子是制造将军的副产物。对他不加以管束，应该是因为我内心还是觉得对他有所亏欠吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于荒泷一斗…",
      "text": "谁？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于摩拉克斯…",
      "text": "曾经与他共饮之时，我还只是一介影武者，敬陪众神末席。他做出了这样的选择是吗？不过，我想他在下一个时代，仍然会继续和更多的人相遇吧。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于温迪…",
      "text": "风神的化身现在还叫这个名字吗？说实话，第一次见他就感觉他浑身透着和我一定相处不来的气质。然后就是，他的确很能喝酒。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于布耶尔…",
      "text": "我很欣赏她的谦逊，谦逊也的确是智者的美德。她的权能理应可以做到许多超乎想象的事，但布耶尔只是将它用在「纠正与守护」之上…真是个温柔的神明。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "「雷电将军」曾与我在意识世界中进行数百年的决斗，以确定我的意志不曾动摇。而你所说的这位芙宁娜，虽是人类之躯，但五百年间的表演也无异于每时每刻都在进行精神上的「实战」。我认可她，此等意志，可谓已臻神境。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于赫布里穆…",
      "text": "五百年前我抵达坎瑞亚之时，曾在战场上见过不亚于无想刃狭间的大片焦土，我听闻那就是火神的愤怒。时至今日，我竟然还有和这样一位人类见面的机会…可否为我引荐一番呢？作为「武人」，我想前往合适的空旷之地，与她交流一些心得。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于梦见月瑞希…",
      "text": "梦见月瑞希是神子的旧识，不过，我有些看不明白她们两位的关系…既是彼此无可替代的友人，又不愿将感情置于台面。总是为某些计划相持不下，想要决出高低…鉴于这些计划的核心都是帮助民众享受生活，我便不多说什么了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解雷电将军·其一",
      "text": "有什么事情，说来便是。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解雷电将军·其二",
      "text": "民间都相信，雷雨天口念「桑原桑原」，便可以无恙。如是因我一念而起的雷暴，必不会加害于你。但是自然天气形成的雷雨就难说了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解影·其三",
      "text": "《珍说》一书所言大致都是真的。那时她正忙于周旋岛内之事，于是我作为影武者，假托她名出现在了平定海祇的军阵中。但是后面的剧情，就只是人们的一厢情愿罢了。我原本只是醉心剑技的武人，没有那种感化万民的德行。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解影·其四",
      "text": "追求「永恒」可能也只是一种逃避罢了。最后我采取的方法也和缩壳乌龟一样。不过乌龟本来就是长寿的象征，说不定追求永恒就是会变成这样的形态。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解影·其五",
      "text": "恐惧是因为我在五百年前目睹了她的消亡和「那个事物」。但，如果…如果是你的话，一定可以拯救所有人的。如果是你的话，一定会拯救世界的。就像是我记得稻妻的一切一样，只要你记得我，我就能永远地活着。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "雷电将军的爱好…",
      "text": "愚问。只有必须要做的事情，和一定不能做的事情。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "影的烦恼…",
      "text": "你不要让我做饭啦。我什么都能办到，但是真的不会做饭。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "你别听将军她的。甜点心！蛀牙什么的，换一套就好了。这怎么会影响对永恒的追求呢。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "愚问。只有维持身体营养必须吃的，和会损害身体的。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "熟悉的味道。不坏。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "放在这里吧，我会尝的。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "会损害身体机能，拿走。"
    },
    {
      "id": "6010",
      "type": 1,
      "title": "收到赠礼·其四",
      "text": "好吃。心情也放松了不少，谢谢你。"
    },
    {
      "id": "6011",
      "type": 1,
      "title": "收到赠礼·其五",
      "text": "看起来不错，是怎么做出来的？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "收到赠礼·其六",
      "text": "恕我谢绝。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生辰…",
      "text": "今日是你的生辰之日吗？随我回城，我来对全体旗本众宣读祝词吧。嗯？「太丢人别这样。」…好吧。"
    },
    {
      "id": "7002",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐！那今日就一起庆祝吧，使之成为可以铭记一年的美好瞬间。然后等到来年今日，便继续庆祝。如是便可得「永恒」的快乐。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我之流派里，「初传」之位，可以学习太刀的九向剑路之势，以及薙刀术的基本。与其他流派并无大差异。应该说，其他流派与我之流派并无差异。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "我之流派里，「中传」之位，太刀术需要研习各种「构」位与变化，薙刀术则需熟练诸「切」与「返」之理。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "我之流派里，「皆传」之位，需要研习诸般奥义。无奈大部分都需要配合元素之力，对凡人来说可能有些太难了。世间其余流派大多都无法触及此境。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "奥义中的奥义，也就是「无想」又无双的一刀。有你作为陪练之宾，我好像能挥出更强更快的一剑。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "威光无赦！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "无处遁逃！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "泡影看破！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "无念，断绝！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "此刻，寂灭之时！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "稻光，亦是永恒！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "收下吧，于我无用。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "…不过须臾之梦。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "嗯？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "…枷锁当断。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "…诸恶当斩。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "…肃清阻碍。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "至我后方待命。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "退下。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "浮世一梦…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "无念，无执…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "雷鸣，将歇…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "无礼…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "荒谬…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "有什么事？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "随我左右即可。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "出征之时已至。"
    }
  ]
}