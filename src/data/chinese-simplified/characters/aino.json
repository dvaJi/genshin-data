  "outfits": [
    {
      "id": 212100,
      "name": "蓬蓬天才工作服",
      "description": "爱诺的装扮款式。白色大衣在娇小的爱诺身上显得尤为宽松。大大的袖口似乎是藏宝贝的好地方，甩一甩的话，不知道里面会蹦出什么东西呢？",
      "isDefault": true,
      "characterName": "爱诺",
      "characterId": 10000121,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aino_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你是来陪我玩的吗？嘿嘿，我叫爱诺，擅长机械发明，现在和伊涅芙住在一起。这个世界上所有的甜食我都喜欢，其中最喜欢的是白灵蛋卷！欢迎你常来我的叮铃哐啷蛋卷工坊做客。你呢你呢？互相介绍完自己，我们就是朋友啦！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·安排",
      "text": "好久没吃甜点了，脑子像生锈的螺丝转不动了…决定了！今天的晚餐我要吃五碟蛋卷！就算伊涅芙进入超级生气模式也拦不下我。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·牙痛",
      "text": "嘶——牙齿突然好痛。怎么会这样？伊涅芙——救救我，呜呜。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·玩耍",
      "text": "今天的待办事项我都交给伊涅芙啦，放心放心，我们去找重拳出击鸭一起玩吧！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "阿嚏——鞋子袜子都湿漉漉的，爱诺好想回家…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "天晴了，我们出去郊游吧，带上伊涅芙一起！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "呼哈，下雪了！来，这个呱呱雪球机给你，用它夹雪球的时候，会发出呱呱的叫声哦！很有意思吧？我嘛，就用嘎嘎雪球机好了，我们去打雪仗吧。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "啊，好大的太阳，这边的袖子借给你，挡一挡太阳吧…唔…你可以蹲下来一点吗？我已经很努力踮脚了，但还差一点点…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "咦？沙漠里好像传来了机械运作的声音…我们过去找找看吧，好不好嘛~说不定有很多有用的零件呢，嘿嘿…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "我让伊涅芙给你做好了早餐，是一碟小蛋糕，很甜很好吃哦…呃，嘴角的蛋糕屑是、是…好吧好吧，朋友之间不应该说谎的，对不起，我已经把我的份吃掉了。嗯？你说还可以分我一半吗？太好啦！那我的蔬果杯就全送给你啦！"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "二号螺丝…二号…唔，到底在哪里呢？…算了，伊涅芙——借你手关节的二号螺丝用一下！哎呀，午饭我待会儿就来吃，你先听话。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "看我发明的餐盘！下达指令后，它们会自动朝你走过来哦。晚餐，出列！上菜！"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "欸…？你这就要走了吗…？要、要不要再试试我发明的咕嘟咕嘟泡茶机？或者再玩一局游戏！唔…好吧，我们拉勾，明天也一定要来和我玩哦，不见不散！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于爱诺自己·实用主义",
      "text": "我做机械的零件基本都是我从废旧物品上拆下来的哦，包括伊涅芙身上的部件也是。垃圾只是放错了地方的资源罢了。不管从哪里来，只要最后能动起来就没问题。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于爱诺自己·家长义务",
      "text": "身为家长当然要好好关爱每个家庭成员，所以每次伊涅芙做完清扫工作之后，我都会摸摸她的头表扬她。当然，别的小机器人工作完之后，我也没有漏掉表扬。嗯嗯，爱诺真是个好家长！"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·咔哒咔哒",
      "text": "我身后的机械？它叫做咔哒咔哒，是我的小助手之一，搭载的功能非常多！你要试试看吗？它很乖，不会咬你的。来，咔哒咔哒，打个招呼。「咔哒咔哒！」"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·没吃",
      "text": "道理我都懂啦…伊涅芙控制我的糖分摄入量，是出于对我健康的关心。但爱诺不是机器人，甜食的诱惑真的很难抵抗呀。我的答案是…只要伊涅芙没发现就是没吃！来吧来吧，我偷偷带你去吃甜品，我请客，只要你帮忙瞒着伊涅芙。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "我总想让伊涅芙多搭载一些功能，为此装了又拆，拆了又装，后来在抓零件的时候，摸到了这枚神之眼，我还以为是太久没休息所以出现幻觉了…欸？你问伊涅芙的总制作时长吗？咳咳，这种事情不重要啦，你只要知道爱诺是天才就行了！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "我一开始起的名字明明是叫「轰隆隆月矩力能量炮」，结果除了伊涅芙，几乎所有人都只会用「大炮」来称呼它。哎，算了，反正是功能性为主的发明，我能理解关键时候念一长串名字是有点拖沓。看在大家都夸它有用的份上，我就不追求听起来可爱了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "你信不信，只要你从一数到一百，我就能拆完一只螃蟹？再数到两百，我又能把螃蟹复原回去。哼哼，其实拆机械和拆螃蟹也差不多。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于伊涅芙·温暖",
      "text": "伊涅芙醒来后，我还陆陆续续给她做了一些升级，比如说为她搭载了模拟体温模块哦，因为拉手和拥抱就是要暖暖的嘛！你一定能懂吧？下次我们同时和伊涅芙抱在一起吧？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于伊涅芙·家人",
      "text": "伊涅芙是我最重要的家人，她能顺利回家，甚至连偶尔失忆的小毛病都被修好了，我真的应该好好谢谢你。对了，不如你现在就跟我回家吧！我让伊涅芙…哦不，还是我自己来吧，我下厨做蛋卷给你吃好不好？还有还有夏槲蛋糕也不错，你喜欢吃吗？欸？你跑什么呀…我还没说完呢！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于雅珂达…",
      "text": "别看雅珂达总是和伊涅芙拌嘴，其实她们关系很要好！她还是伊涅芙第一次交到的好朋友。作为一位开明的家长，我可不会限制伊涅芙交朋友，而且我知道的，有些朋友之间就是会拌嘴，越吵闹关系反而越好。哦，差点忘记告诉你了，她的机械臂虽然现在由我学生在维护，但一开始的制作者是我本人，很漂亮吧？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于菈乌玛…",
      "text": "你喜欢她头上的角冠吗？我可以给你做一对类似的，对了，要不安装上发光和开花的功能吧，或者你喜欢能绽放烟花的角冠吗？这些对爱诺来说都是小菜一碟。「霜月之子」会找你麻烦？好吧，那我也给他们做就是了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于菲林斯…",
      "text": "他是一位有品位的男士，说出来的话总是很悦耳，就像机械们碰撞发出的叮铃哐啷声一样。这赞誉太高了？好吧，可能稍微有点…但也是大实话！不是因为被甜点收买了！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于多莉…",
      "text": "之前她来找我谈过合作，哼哼，不错，她确实是个有眼光的商人，但价格压太低了啦。伊涅芙说，我为多莉工作一天的工钱都不够买两份刚刚出炉的双果卷。天才也是要填饱肚子的！唉，除非她愿意把手头上那些来历不明的奇妙机械借给我拆一拆…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于奈芙尔…",
      "text": "奈芙尔姐姐有只黑猫叫阿舍鲁，我曾经提议过给阿舍鲁装载一个翻译器，这样我们就能知道阿舍鲁在说些什么了。但奈芙尔姐姐想也没想就拒绝了这个提案，说她知道的情报已经够多了，不需要再知道一只猫咪想说的话了。什么嘛！那么冷冰冰，她是被菈乌玛的翻译伤害过吗？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于法尔伽…",
      "text": "伊涅芙去找你们的那段时间，法尔伽大叔偶尔会来陪我玩哦。我想伊涅芙的时候，还被他看出来了，他拍了拍我的头安慰我。他的大手上都是厚厚的茧子，而且还重重的，但是也很温暖。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于莉奈娅…",
      "text": "莉奈娅姐姐？小时候，她每次出门回来都会和我们讲很多好玩的事情，我很喜欢她。等我学会做机械之后，给她送了一些…可惜她都没有收下，只是告诉我心意她领了。一定是没送到符合她心意的款式，接下来我要做更多更多的机械，总有一个会是她喜欢的！"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于布伦妮…",
      "text": "我非常欢迎她！她每次来都会把伊涅芙给她准备的甜点让给我吃，这样我就能趁伊涅芙看不到的时候，吃掉两份甜点！哎，布伦妮去了蒙德后还会回来吗？难得有能认真听我讲机械原理的朋友…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解爱诺·其一",
      "text": "想知道更多我的事情？当然没问题！我们来交换吧，我说一个关于我的事情，你也说一个你的故事，怎么样？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解爱诺·其二",
      "text": "我一点也不讨厌预算很低的客人，就算只有五千摩拉也能做很多事情了。比起预算不够，那些自己无聊又不懂得欣赏的人问题才更大，就算我往他们想要的机械里加入好玩的功能，他们也只会念叨着实用性，真是没救了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解爱诺·其三",
      "text": "「扳手老爹」？你从哪里听说的这名字？他是我的老师，他连自己的名字都忘记了，却还记得所有零件的标准规格。我和他说了我的很多想法，不管多么奇妙，他都会笑着摸摸我的头和我说，「好好好，那我就等着爱诺能造出来的那一天。」"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解爱诺·其四",
      "text": "我拼装出来的第一个机器人，叫做叮铃叮铃，和我现在的作品完全不一样，它没有任何别人眼里所谓实用的功能，不会说话也不会做家务，很难想象吧。它陪了我很长一段时间，直到它的外壳破损，脱落的螺丝再也没办法安装回去了，我才把它收了起来。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解爱诺·其五",
      "text": "其实最初我选择制作机器人而不是别的发明，只是希望有人陪我玩而已…我明白人类往往有自己的事情要做，就算陪了我一段时间，很快我也会重新变成一个人，只有机械才是我的归宿。但有一天伊涅芙告诉我，她把我当作「家人」，我可以相信她…我忍不住哭了，因为我知道机器人是不会说谎的…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "爱诺的爱好…",
      "text": "我喜欢给机械装上别人意想不到的功能，想想看，可以当做狗狗来遛的扫地机，肯定比普通的扫地机好玩不少吧？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "爱诺的烦恼…",
      "text": "经常有各种零件，在我需要的时候找不到，在我不需要的时候才突然出现…我又不可能给每个零件都安装上自动搜寻功能…试试吸铁石？哎，我这里的精密机械太多了，伊涅芙也会被吸过来的…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "如果我有一天变成了机器人爱诺，那你一定要帮我把供能设置成糖！没有糖分的日子，那不就成了彻底的苦日子了吗？我一天都过不下去。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "挪德卡莱有种硬硬的薄饼，你尝过吗？跟咬伊涅芙的外壳一样！最关键的是它居然不甜，简直不可饶恕！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "哇——我要让伊涅芙把我下周的零食全部换成这个！太好吃了，不如下下周也换吧！还有吗还有吗？再让我吃一份嘛，就一份！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "好吃哦，但是稍微少了点幸福的味道。对了对了，这包砂糖给你！下次多加点糖，一定会更好吃的！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "唔，尝起来没什么味道呢…不如我帮你做饭？欸？不要吗？好吧…那要不我把闲置的蛋卷机器改进一下送给你吧！稍微给我一点时间。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "你是不是在等着爱诺给你惊喜呀？嘿嘿，看！叽里咕噜愿望神灯！你点亮蜡烛，它就会边唱生日歌边咕噜咕噜地转起来，好玩吧？喜欢的话，新的一年也要陪我一起玩哦！然后——现在是许愿时间，说出你的愿望吧，天才爱诺一定会帮你实现的！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "嗯嗯，机器人的升级也是这种感觉吗？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "升级完成。爱诺运行稳定度上升，能量消耗相应增大，请多多准备甜点用以供能。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "你对天才爱诺的欣赏我已经感受到了，哼哼，很有眼光嘛！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我理想中的家人，恐怕就是像你这样的…理解、支持并且陪伴着我…嗯，我没在难过。接下来相信我就好啦，毕竟，还没有天才家长爱诺解决不了的问题！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "吃我一击！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "咔哒咔哒！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "尝尝这招！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "瞄准你啦。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "预备！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "哼哼！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "快看，有彩虹！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "哗啦哗啦水弹！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "洒水时间到——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "我看看，里面有零件吗？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "好多东西，伊涅芙在就好了。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "呃…更乱了，对不起！我不是故意的。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "这、这不对啊…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "一点也不好玩！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "犯规了犯规了！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "别闹，听我的！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "不怕，还有我！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "呜，不是这么玩的…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "好冷啊，伊涅芙…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "蛋卷…还没吃完…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "坏人！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "没躲掉…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "痛痛。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "出去玩出去玩。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "到啦，放我下去，咔哒咔哒。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "爱诺——到！"
    }
  ]
}