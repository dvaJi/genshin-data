  "constellations": [
    {
      "_id": 1211,
      "id": "the_theory_of_ashfield_equilibrium",
      "name": "灰与力场的平衡理论",
      "description": "爱诺施放元素战技<color=#FFD780FF><b>妙思捕手</b></color>或元素爆发<color=#FFD780FF><b>精密水冷仪</b></color>后，爱诺自身的元素精通提升80点，附近的当前场上其他角色的元素精通提升80点，持续15秒。<br/><br/>该命之座提供的元素精通提升效果无法叠加。",
      "level": 1
    },
    {
      "_id": 1212,
      "id": "the_principle_of_transference_in_gear_differentials",
      "name": "齿轮差分的进位原理",
      "description": "元素爆发<color=#FFD780FF><b>精密水冷仪</b></color>中的<span style=\"color:#FFD780FF\">对点水冷域</span>持续期间，若爱诺处于队伍后台，队伍中自己的当前场上角色的攻击命中附近的敌人时，<span style=\"color:#FFD780FF\">「冷静一下鸭」</span>将对该敌人发射一枚额外的水弹，基于爱诺攻击力的25%与元素精通的100%，造成<span style=\"color:#80C0FFFF\">水元素范围伤害</span>。该效果每5秒至多触发一次，且造成的伤害视为元素爆发伤害。",
      "level": 2
    },
