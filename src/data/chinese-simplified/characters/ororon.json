  "outfits": [
    {
      "id": 210500,
      "name": "服翼之眼",
      "description": "欧洛伦的装扮款式。预见者应当懂得隐藏，斗篷和兜帽是他最好的武装。",
      "isDefault": true,
      "characterName": "欧洛伦",
      "characterId": 10000105,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Olorun_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你好，我是来自「烟谜主」的欧洛伦。我不是卖菜的，但是可以送你一些。\\n别担心，没什么特别的原因，也没有想从你这里换取什么。我只是好奇每颗种子最终会长成什么样，所以越种越多。希望它们都能在中意它们的胃里安度晚年。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·怪人",
      "text": "你听谁说的烟谜主里都是怪人？我以为只有我一个。还有谁啊？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·目标",
      "text": "每个人都应该有一种自己最喜欢的动物，或者蔬菜，或者水果。这样才能知道自己想要成为什么样的人。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·迷烟",
      "text": "不是所有的迷烟都能穿过。如果野心太大，就会被烟雾呛到。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "跑起来泥水会溅到衣摆上，飞的话…浸水的披风又太沉了。还是找个地方蹲会儿吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "闪电很像蛇。不知道有没有人利用它们的颜色和形状占卜…说实话，有点担心这些人的安全。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "…雪下面葬着什么。轻一点，不要惊醒它们。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "太阳是永燃之火，纳塔人从不惧怕直视烈日。当然，实在受不了可以戴墨镜。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "这地方…感觉很难种出东西来。要不还是走吧？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "抱歉，虽然睁着眼睛，但我还没醒…正事可以晚点说吗？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "胃说时间到了，应该去吃点东西。但我想不出要吃什么…也可能是脑子还没醒。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "突然想喝肉龙掌气泡咖啡，不加奶。你说太晚了？那…早上好。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "一到这个时候大脑就会活跃起来。我很早就放弃强迫自己睡眠了，所以你先休息吧，我带上夜灯去看看地里的萝卜。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于欧洛伦自己·交流",
      "text": "我知道自己说话有时很难懂。你如果有哪里没听明白，请直接提问，我不介意的。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于欧洛伦自己·未解之谜",
      "text": "我不知道自己是从哪来的，但似乎也并不好奇…比起这个，我更想知道自己该往何处去。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·道歉",
      "text": "抱歉…嗯…我是说，真的很抱歉。一上来就骗你，的确不是什么好的开局。原因已经都告诉你了，绝无虚言。如果你不想接受也没关系，那我会尽量不出现在你面前。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·谢礼",
      "text": "这是「凌晨四点」的肉龙掌，「比头大」的青蜜莓，「截至上周为止第一甜」的蜜…还有…哦，还有「咔库库免费问诊券」。\\n怎么露出疑惑的表情，这些是送给你的，请收下。你帮了我的忙，但看上去并不缺什么，我只好按照自己的喜好准备了礼物。\\n咔库库是谁？咔库库是龙。有机会介绍你们认识。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "听人说打雷有助于作物生长。我试了下在菜地中央驱动「神之眼」，很遗憾，卷心菜和番茄都不太开心，所以就没继续了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "一个小窍门：不要做第一个提出建议的人。就像先长出来的果实容易被盯上，第一个出头的人经常输得很惨。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "飞鼯其实并不总像它们在高空滑翔时那样目中无人。它们会突然飞过来，扒在你身上不走。这种时候很难不给它们点好处。从某种角度来看，算是一群狡猾的家伙。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于希诺宁…",
      "text": "她好像很喜欢待在高处，尤其是树上。我发现倒挂在树枝上会比躺在上面更解压，有机会可以和她交流下心得。欸，不好吗？大家总说要换个角度看世界，像希诺宁这样的发明家，应该很需要吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于基尼奇…",
      "text": "那个阿乔很有意思。它年纪很大，却又年纪很小。基尼奇正好相反，他年纪很小，但年纪很大。你…你能明白我的意思对吧？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于恰斯卡…",
      "text": "恰斯卡很厉害，也很出名。只要她一来，人们就都不吵架了，开始和和气气地握手。最讲理的家伙原来叫「武力威慑」，是个不错的名字。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于伊法…",
      "text": "别看伊法经常教训病号，他和龙们的关系其实很好。闲下来他会在诊所门口弹吉他，让围上来的龙一个一个跟着唱。\\n但其实就是呜呜叫啦。我如果碰到了也会加入。我是说加入龙。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于茜特菈莉…",
      "text": "奶奶其实是个很直白的人，高兴或者不高兴都会直接表现出来，也不太擅长掩饰自己的情感。你看上去像是她的同辈，或者…甚至比她更大？\\n抱歉，这样好像不太礼貌，我不多问了。但如果真是这样，就请你多和她聊聊天吧，奶奶大概受够了身边都是晚辈，见到你会很开心的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于伊安珊…",
      "text": "只能说，还好火神大人没有派她来抓我。她是远近闻名的运动教练，虽然我有身高优势，但很可能跑不过她。障眼法？用多了就不管用了啊。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于玛薇卡…",
      "text": "我之前并不认识火神大人。\\n我的意思是，我当然知道火神是谁，但并不像当面对过话的那种「认识」。在这之前，火神大人对我来说更像一种刻写着力量的图腾，一个象征着掌控全局的标志。这在我心中并不算切实的了解，所以我产生了疑问。\\n现在疑问消失了不少，我很开心，也有些心虚和羞愧…她似乎从不迷茫，知道火焰为何长燃，所以无论如何不能让其熄灭。我希望…希望自己能成为帮得上纳塔的人。\\n当然，关于她我还有一些思考…上次在宴会上见到她吃了很多很多绿叶蔬菜，我们还聊了这件事，她说她很喜欢营养均衡的感觉。总觉得，是比想象中更细致的人。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于「队长」…",
      "text": "真是一段奇异又仓促的缘分。\\n都说烟谜主的人擅长预知未来，但我在路边遇到「队长」时，从没想过事情会变得这样复杂。在你看来，人情是可以简单两清的吗？如果是，我心中为何仍保留感激与亏欠？\\n…又或许是我考虑得太多了。无论之前发生了什么，他帮助拯救了纳塔岌岌可危的地脉，是一位值得尊敬的英雄。我会一直记得他的。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解欧洛伦·其一",
      "text": "你好。要握手吗？纳塔人打招呼一般不会这样正式，但你想要也可以。其实在远处喊一声就够了，我听力很好，会察觉到的。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解欧洛伦·其二",
      "text": "你似乎总是很忙，我也希望像你一样，一直有事可做。但有时，我又很喜欢清闲度日。人的心情真多变啊，我自己也控制不了，真为难。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解欧洛伦·其三",
      "text": "纳塔的白天很热，所以除非必要，我更喜欢晚上出门。你见过夜晚的水面吗？月光让水波闪着光，看起来十分清亮。但只有在阳光下你才能看清它是不是真的干净，所以，尽量不要触碰夜晚漆黑的水。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解欧洛伦·其四",
      "text": "我对灵魂的感知天生比其他人强一些。怎么描述呢…人的灵魂有些像一团团莫测的能量，如果世界上有形态各异的小龙棉花糖，那大概就是灵魂的样子吧。你的灵魂很温暖，是烤过的那种。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解欧洛伦·其五",
      "text": "老实说，我自己对自己也不甚了解。我总是有很多疑问；已有的问题还没得到解决，马上又会有新的加入进来。\\n好像没有什么特别好的解决办法…只能尽量往前走，对吧？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "欧洛伦的爱好…",
      "text": "除了种菜和观察蜜虫以外的爱好？有的。…当然有，给我点时间，会想出来的。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "欧洛伦的烦恼…",
      "text": "有时，想要和做到之间的距离真的很难跨越。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "吃塔塔可时，在下面放一张空饼皮。只要吃得足够多，掉下来的食材就能变成一个新的塔塔可了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "军用食品…尤其是压缩饼干。它们就像「队长」的灵魂一样沉重…品质很好，只是太硬了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "厉害，比我自己做的好吃。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "不多不少，正正好的味道。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "我不太明白…这是什么艺术？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "在纳塔，有种说法是，一个人的出生日期决定了他的命运。如果他的生日和某位大英雄是同一天，那他就会得到这位英雄的庇佑，拥有和他一样的品质。\\n我想，和你共享生日的人一定很幸运。生日快乐。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "你刚刚拿给我的是什么？能再让我看一下吗？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "#我是不是应该叫你声老师？谢谢你，{M#爷爷}{F#奶奶}老师，我学到很多。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "身体很轻，看来可以一下子去到更高的地方了。但要控制好力道，因为磕到头会很疼。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我还没能力窥探死亡的界限，但你的帮助似乎将死亡推得更远了一些。放心，我不会因此就去随心所欲做坏事的，我保证。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "别跑太远。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "再见咯。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "放生！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "去吧，你自由了。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "来，跟大家问好。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "帮我四处看看。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "你对宝箱的热情正在威胁它们的生存环境。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "敲上去的声音很清脆，应该是颗不错的果实。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "小心哦，有些龙喜欢躲在箱子里。可能是内向吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "跑不动了…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "警惕…！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "坏兆头。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "要带你去看医生吗？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我先补上。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "先走一步…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "看不清了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "听见了…不该存在的声音…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "呃，跑慢了…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "这不对吧？"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "要我加入吗？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "去哪？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "能不能先说，是好事还是坏事？"
    }
  ]
}