  "outfits": [
    {
      "id": 203500,
      "name": "夏冰梦身",
      "description": "七七的装扮款式。因为贴满符咒而令七七倍感安心的药童衣装。",
      "isDefault": true,
      "characterName": "七七",
      "characterId": 10000035,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Qiqi_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是七七，是个僵尸…啊，还要说什么来着。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·自言自语",
      "text": "咦，刚刚…我想说什么来着…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·怕热",
      "text": "想去凉快点的地方。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·锻炼",
      "text": "七二三四，七二三四…五六七七，五六七七…"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "又忘记带伞了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候…",
      "text": "想堆雪人…可以陪我吗？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "阳光很好…",
      "text": "今天不该出门的。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "凉凉的，很舒服。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "拉手…拉手！要、要被吹跑了！…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上了吗？今天要做的是…我看看笔记。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "…忘记帮白先生分拣药材了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好。今天…我做了什么来着…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "你先休息吧，我该去做柔软体操了…不要偷看。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于七七自己…",
      "text": "你问我吗…？对不起，我不记得了…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·记忆力",
      "text": "很多事情我都记不起来了，但是…也没什么不好。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·记忆力锻炼",
      "text": "最近我努力做了很多记忆力锻炼，所以不用担心我会忘记你了。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」，虽然无法停住时间，但是给了我守护重要之人的力量。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "其实我的身体状况比白先生好很多…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "药庐附近有时候会有小团雀出没，小小的一团。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于白术…",
      "text": "我记不起来白先生的脸了，但是也没什么关系…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于胡桃…",
      "text": "高温、假笑和死亡…讨厌。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于魈·名字",
      "text": "唔，听起来像老古董…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于魈·记忆",
      "text": "我见过他吗…？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于辛焱…",
      "text": "…是谁？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于瑶瑶…",
      "text": "可爱…像小团雀。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于小冥…",
      "text": "晚上…偶尔会感觉到有人和我一起做体操…是错觉吗？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于布伦妮…",
      "text": "外表硬硬的女孩…但手心很软。喜欢。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解七七·其一",
      "text": "有什么事吗？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解七七·其二",
      "text": "柔软体操，让我能够保持和人类一样的身体状态。但是如果放松下来的话，就会变回去…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解七七·其三",
      "text": "有的人想要利用我，有的人很害怕我。但是你…和他们都不一样。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解七七·其四",
      "text": "从第一次见面开始，你就给我一种很温暖的感觉。和让人不舒服的热不一样，是我的心，感觉到了温暖。谢谢你…我很高兴。可惜我只认识现在的你，如果以后我忘记了…我们就…不，我会「命令」自己记住你。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解七七·其五",
      "text": "以前我只想要活下去，虽然不知道为了什么活下去…但现在我好像知道了，以后想要和你一起活下去。我、我们可以…永远一直在一起吗？啊…真的可以吗？嗯！我会保护好你的！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "七七的爱好…",
      "text": "想要一只小宠物…小团雀那样子的。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "七七的烦恼…",
      "text": "我不明白，但是，温度高会让身体很难受…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "喜欢椰奶。但是…尝不出味道。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "对不起，我不知道…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "凉凉的，很喜欢。虽然没有味道…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "唔…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "有点烫…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生辰快乐。给，草药香囊。很惊讶吗？上次你告诉我的时候，我就记在纸上了。每天都看一遍的话，今后也不会忘记的…"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "啊，变强了吗…变强，是什么呢？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "啊，理解了。变强之后，控制力量需要更多的精力了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "以前我对更加强大并没有概念，但是现在…我希望能够再强一点。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "这一切都是因为你在，谢谢你…可以答应我一个愿望吗？今后…就让我来保护你吧，好不好？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "流转不息。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "生生不绝。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "去。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "起。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "听诏，宣此诰命。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "真名，度厄真君。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "玉签，仙法开匣。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "要更快一点吗？"
    },
