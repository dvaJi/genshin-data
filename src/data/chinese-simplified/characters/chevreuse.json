  "outfits": [
    {
      "id": 209000,
      "name": "守正之枪",
      "description": "夏沃蕾的装扮款式。设计师们保留了经典的黑白红制服配色，增加了大量饰品，但它实在太重，这招致了夏沃蕾队长的抗议。众人最终看到的是去除了大量金属饰扣的版本。",
      "isDefault": true,
      "characterName": "夏沃蕾",
      "characterId": 10000090,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Chevreuse_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "我是枫丹特巡队队长夏沃蕾，寒暄就免了，有什么棘手的案件需要处理吗？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·铳枪",
      "text": "铳枪是我最喜欢的武器，它具有强大的杀伤力和威慑力。有些时候，后者甚至比前者更有用。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·巡逻",
      "text": "我们特巡队并不参与枫丹廷的日常巡视工作，我们追捕的人，也不可能在大街上露面。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·食物",
      "text": "「圈圈圆圆」这种零食便于携带，还可以搭配酱汁，尝出不同风味…等着，我去买几份回来。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "放心，即使是在雨里，我的铳枪依旧能够正常开火。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "有些罪犯会用雷鸣声来掩盖枪声，但这骗不过我的耳朵。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "…等等，我要维护一下铳枪。以免它的机关结构被冻住。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "天气不错，视野良好。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "这种风速…只怕连出膛的子弹也会被吹歪。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "广阔的沙漠，很适合掩埋某些事物。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好，我刚准备去做几组体能训练，要一起吗？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "中午好，要和我一起去特巡队食堂吃饭吗？那里的饭菜很适合填饱肚子。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今天的工作总算结束了，而且没出什么大乱子，我们去吃点夜宵吧，我来带路。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。我稍后也会去休息，希望…今晚不要发生太多紧急事态。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于夏沃蕾自己·特巡队",
      "text": "特巡队专门应对各类危急凶案和恶劣罪犯，所以，我们在执法时会相对…强硬一些。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于夏沃蕾自己·帽子",
      "text": "在特巡队里，有一个不成文的规定。如果一个队员牺牲了，那我们就会将他的帽子保存起来，如果他的后代也成为了特巡队员，我们会将这顶帽子授予他的后代…这也算是一种「传承」吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·兴趣",
      "text": "我会在空闲时读一些「犯罪小说」。和推理小说不同的是，犯罪小说并不会去设计复杂的犯罪手法，而是着重描写围绕罪案发生的各色人情纠葛和情绪冲突，在我看来还挺有趣的。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·法理",
      "text": "如果你对法理有什么疑问，可以随时来问我，或者说…当你的脑子里出现「也许这件事并不算违法」的念头时，必须第一时间来和我商量。\\n每年都有不少蠢货因为侥幸心理而踏过红线，我可不愿意看见你成为那种人。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "在我的工作中，「神之眼」确实是一种不可忽视的武力辅助。有了它之后，我的铳枪再也没有发生过严重故障。\\n「同时持有神之眼和铳枪的特巡队队长」，这些名头加起来，应该能够吓倒一些胆小的嫌疑人了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "汉考特竟然真的逮捕了米莉丝…面对挚爱之人也能下得去手，让人钦佩。但是米莉丝做错了什么呢？她只是变卖了一件捡到的首饰而已，就变成了贵族口中十恶不赦的罪人…正义真让人捉摸不透，你觉得呢？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻·警卫机关",
      "text": "虽然我们隶属于执律庭，但特巡队执行任务时，并不会大量启用警卫机关。至于为什么…呵，那些笨重的机关，只会挡住我们射出的子弹。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于娜维娅…",
      "text": "我听说过和娜维娅小姐父亲有关的那件谋杀案，当时在执律庭也闹得沸沸扬扬，不少人都因为这件案件而吵个不停…\\n好在如今案件已然昭雪，真正的凶犯也已经伏法…「正义」总算是正式入席了。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于林尼…",
      "text": "我认识这位大魔术师。有一次我们逮捕了一位涉嫌故意伤害、拐骗和谋杀的魔术师，却一直弄不清他的犯罪手法。最后还是请来了林尼先生做顾问，才找到了关键物证，顺利将嫌疑人定了罪。听说一位小说家对这件罪案很感兴趣，写了一本用魔术手法犯罪的推理小说。\\n不过…小说的细节描述实在太过详细，现在还处于脱敏期，暂时是无法出版了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于菲米尼…",
      "text": "我有一次出门买零件的时候遇见过这位潜水员，当时我们都想要买下店里剩下的唯一一个通用零件。我刚想说把那枚零件让给他，但他却一下子缩回了手，低着头一路小跑出了店里。说难听点，简直像个犯人一样…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于克洛琳德…",
      "text": "这位决斗代理人在枫丹廷可是大名鼎鼎啊。我们两人职务不同，我不会随意评价她的工作。但我相信，她接下那些代理决斗的原因，都是发自她内心的「正义」。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于莱欧斯利…",
      "text": "莱欧斯利先生的工作卓有成效。至少罪人们都清楚地知道，「梅洛彼得堡」并不是一个养老的好去处。这对我们的审讯工作提供了很大帮助。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于艾梅莉埃…",
      "text": "我俩私交不错，我有好几次请她用专业的化学知识来帮我分析物证、追缉凶犯。她还能帮忙发现很多看不见的信息，比如犯人用了什么香水、送过什么花，甚至去过什么地方、踩过什么泥土…她从没错过。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于千织…",
      "text": "千织处理纠纷的方式有些激进。但她凭借自己的门路和人脉，为特巡队提供过很多次情报。作为回礼，我会在她把人丢出店门、或是掀翻恶性竞争对手的店铺时睁一只眼闭一只眼。事后调查你会发现，千织总是有理的那一方。她只是懒得和人废话罢了。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于夏洛蒂…",
      "text": "这是一位让人头疼的记者小姐。每次重案发生后，无论我们怎么封锁现场，她都能第一时间出现在最近的地方…有次我的一名手下甚至把她列为了第一嫌疑人，羁押了足足半个月，但她还是在拘留室里写完了报道…我要找个时间，正式和她的主编谈谈了。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于希格雯…",
      "text": "特巡队和美露莘的交情由来已久。我们经常和逐影庭里的美露莘合作。她们善良、诚实又可靠，在处理某些重案时，还能发挥无可替代的作用…而我个人，也和几位美露莘关系不错。希格雯护士长就是其中一位。\\n从过去到现在，美露莘都是我们不可或缺的同伴。如果…再有任何人胆敢用任何方式污蔑中伤她们，那么特巡队的枪口，绝不会留情。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于那维莱特…",
      "text": "众人皆知，最高审判官大人在审判时全无私情。有人说他少了点人情味，但在我看来，正义本就不该被人情干扰。违律者即有罪，仅此而已。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "芙宁娜大人…有段时间突然指定我们进行什么…花枪表演训练。她不仅要求我们全员装配一种特制的「礼仪铳枪」，还要接受特殊的舞枪训练…还好，因为她始终找不到喜欢的仪仗曲，这件事就草草作罢了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解夏沃蕾·其一",
      "text": "抱歉，我并不擅长和人交际。或者说…和正常人交际。如果你有什么想问的，直接问就是。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解夏沃蕾·其二",
      "text": "特巡队是隶属于执律庭的多个执法部门之一。因为我们的行事风格和人员组成都非常大胆，在执律庭某些先生嘴里，我们是「最不守规矩」的部门。\\n但是，我认为特巡队的行事准则不应受外界影响。我们要对付的恶徒可不是沫芒宫里的好好先生。如果罪人的违法乱纪来得像暴雨一样突然，那我们也绝不能慢他们半拍。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解夏沃蕾·其三",
      "text": "我接触的犯罪者，并非全是穷凶极恶的歹徒或恶匪。\\n更多的人，最开始都只是犯下了一个小错，他们害怕为此负责，想要悄悄补救，却在不自觉中陷入了谎言的漩涡，最后…在无数谎言的挟裹下，身不由己地走上了犯罪的歧途。\\n我最喜欢的那位剧作家曾经在一台歌剧里写道：「谎言是生发罪行的恶土」。\\n但是，他自己却在几年后因为剽窃罪而被捕…真是给那台歌剧做了一个戏剧性的注脚。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解夏沃蕾·其四",
      "text": "我的父亲受过牢狱之灾，我曾被称作「罪人的女儿」。我还在灰河长大，见过不少太阳光照不到的角落。托这些经历的福，讨厌我的人有不少，但我学会的东西更多。\\n执法者要相信自己心中的「正义」，并且将其付诸在自己的行动中…这是父亲教导我的话。\\n我也深以为然。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解夏沃蕾·其五",
      "text": "实不相瞒，作为特巡队队长，我见过很多毫无道德底线可言的恶人胡作非为，也见过无辜与善良之人卷入事件受伤，甚至付出生命。我常常感到愤怒与无力。\\n我坚信「罪人」应当受到惩罚，但这并不意味着无尽的复仇循环。\\n如果我们蒙蔽双眼，任由情感驱使自身的行为，迟早都会溺亡在冬天的海水里。\\n越是掌握权力，就越该警惕这一点。坚定追寻自己心中的「正义」，但万不可迷失在追寻它的路上。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "夏沃蕾的爱好…",
      "text": "训练？射击？非要说的话…看犯罪小说吧。对了，我要去拿最新一期的《谜案寻踪》了。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "夏沃蕾的烦恼…",
      "text": "不要再让我学习那些繁琐的礼仪了，与其将时间浪费在这上面，我宁愿去盯防凶犯。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "富含油脂和糖分的食物，可以在工作日为我提供充足的能量，还有好心情。休息日？休息日的话，它们就沦为了会增长体重的「罪恶食品」，而将此等「罪恶」消灭，同样能带给我一天的好心情。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我…不太能接受生冷食物。既然是要入口的东西，至少要做得全熟才行…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "很不错。不过…呵，就是我不由自主地吃太多，等会要加练了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "嗯，比特巡队食堂的饭菜味道好多了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "足够填饱肚子，也不会勾起额外的食欲…这道菜对我来说非常优秀。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐。嗯…立正！站直一些，不要屈膝。我要测量一下你的身体数据，给你订做一柄便携的小型铳枪，还有速拔枪套…\\n好了，放松。在铳枪做好之前，我先带着你用训练铳枪打一段时间的靶。现在就开始，跟我走。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "不错。端枪的手更稳了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "这样的话，也许能狙击到更远的敌人…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "多谢，有了这样的力量，追缉恶徒就更有效率了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "感谢你为我提供的所有帮助…虽然我不能承诺特巡队随时听你差遣，但就我个人来说，只要你开口，我就会与你同行。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "不许动！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "放下武器！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "最后通牒！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "必要武力。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "绳之以法。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "束手就擒！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "不错。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "希望里面没有赃物。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "这不算是违法所得，放心吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "恶徒…！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "目无法纪。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "你，无权申辩了。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "稳住队列！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "保持阵型！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "正义…何在…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "罪人…尚未…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "这就是…结局吗…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其一",
      "text": "无用顽抗…！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "出动吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "就当是加练。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "我随时准备着。"
    }
  ]
}