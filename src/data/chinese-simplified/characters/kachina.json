  "passives": [
    {
      "id": "mountain_echoes",
      "name": "山的回声",
      "description": "队伍中的附近的角色触发「夜魂迸发」后，卡齐娜的<span style=\"color:#FFE699FF\">岩元素伤害加成</span>提升20%，持续12秒。",
      "level": 1
    },
    {
      "id": "the_weight_of_stone",
      "name": "坚岩之重",
      "description": "<span style=\"color:#FFD780FF\">冲天转转</span>造成的伤害提升，提升值相当于卡齐娜的防御力的20%。",
      "level": 4
    },
    {
      "id": "night_realms_gift_heart_of_unity",
      "name": "夜域赐礼·团结炉心",
      "description": "在夜魂值耗竭后，卡齐娜将会转而消耗燃素来维持夜魂加持。<br/>在纳塔存在燃素机制的区域时，能够进行夜魂传递·卡齐娜。当前场上角色处于冲刺、攀爬或是特定天赋赋予的移动状态下，或是位于一定高度的空中时，切换卡齐娜登场时触发：卡齐娜将进入夜魂加持状态，搭乘<span style=\"color:#FFD780FF\">冲天转转</span>登场，并获得30点夜魂值。自己的队伍每10秒能触发一次夜魂传递。<br/><br/>此外，位于纳塔地区时，卡齐娜搭乘<span style=\"color:#FFD780FF\">冲天转转</span>时攀爬消耗的体力降低90%。",
      "level": 0
    },
    {
      "id": "boon_of_crystal_flame",
      "name": "晶焰之祝",
      "description": "在纳塔存在燃素机制的区域时，与部分采集物交互能恢复20点体力。此外，在小地图上显示周围的<span style=\"color:#FFD780FF\">纳塔区域特产</span>的位置。",
      "level": 0
    }
  ],
  "constellations": [
    {
