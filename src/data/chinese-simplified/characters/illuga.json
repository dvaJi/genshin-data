  "outfits": [
    {
      "id": 212700,
      "name": "不懈执望",
      "description": "叶洛亚的装扮款式。出于工作考虑，叶洛亚为自己定制了这套工作用制服。虽说是「工作用制服」，但因为叶洛亚的工作太多，他基本上也没有换衣服的机会，所以，这件衣服基本上也能算作是叶洛亚的「常服」了。",
      "isDefault": true,
      "characterName": "叶洛亚",
      "characterId": 10000127,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Illuga_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你好呀，我是叶洛亚，执灯人调查分队的队长。请问是遇上什么麻烦了吗？这也是常有的事，附近的路的确不太好走。不过别担心，跟我来吧，我会帮你照亮前方的路。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·警惕",
      "text": "越是平静的地方，就越有可能隐藏着危险…我也不知道这话对不对，但警惕点总没错。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·巡夜",
      "text": "你是不是觉得冷？巡夜的时候很容易受凉，我煮碗暖汤给你喝吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·困难",
      "text": "只做擅长的事情可不行，只有强迫自己去做困难的事，才能在挣扎中变强嘛。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨过天晴…",
      "text": "太阳出来了，看来这次是光明的一方打赢了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "老爹说这是天上的神明们在交战，我只希望他们不要殃及无辜。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "阳光很好…",
      "text": "难得的好天气啊。要是能一直这么好，我们执灯士的工作也会轻松很多吧。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "刮大风了…",
      "text": "起风了，总感觉会有不好的事情发生…要不我们还是去附近的营地躲躲吧？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "夜晚过去了，看来我们又度过了平安的一天。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "阳光正好，应该趁这个时候观察一下周围有没有什么隐患…唔，不过好像有点困了…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "天黑之后说不定会有魔物出没。走夜路的话，请一定要小心谨慎。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "嗯，时候不早了，你先休息吧。放心，今晚我会替你守夜的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于叶洛亚自己·执灯人",
      "text": "加入执灯人的事，是我求了老爷子好几次才说服他同意的。比起一直待在皮拉米达城被前辈们保护，我更想要去到战场的最前方，和大家一起成为阻挡狂猎前进的力量。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于叶洛亚自己·分队长",
      "text": "成为分队长意味着要肩负起同僚的性命，虽然我还是时常怀疑自己是否有这样的资格…但是既然大家都选择了相信我，那我也不可以辜负大家的信任，对吧？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·职责",
      "text": "为往来的商旅提供保护，是我们执灯人的职责…你问保护对象包不包括冒险家？嗯…虽然理论上这确实超出了我的责任范围，但我可不能允许任何人在我负责巡察的区域里受到伤害。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·队员",
      "text": "现在你已经算是我们调查分队的队员了，这就意味着，我必须为你的生命安全负责…听他们说你最近又去了危险的地方冒险，现在看到你平安无事，我稍微安心了一点…所以说，下次要不还是让我跟你一起去吧？"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "曾经有人告诉我这只是枚好看的宝石，直到终于有机会将它掂在手里，我才明白其中承载的重量。我想，命运把它交到我的手上并非偶然，我得努力配得上它。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "从皮拉米达城的最高处向北眺望，可以看到至冬雪原的一角。据说那里就是我们的初代执灯长，铸灯者索洛维的家乡。失去一切而无法回到家园的人，最后在这里找到了归宿…说不定，这座城堡从一开始就是为了让我们这样的人抱团取暖而存在的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "皮拉米达城附近有许多散发着月矩力的奇妙生物，像是曼陀草、獭懒羊…可不要被它们的表象所欺骗，虽然看上去像是你们见过的动物，但它们其实是拟态成动物模样的植物…不过实话说，它们的味道还不错。不介意的话，下次可以做一份给你尝尝。嗯？你问我为什么会知道这个？巡夜的时候总会有许多不得已的情况嘛…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于菲林斯·拜访…",
      "text": "刚认识菲林斯先生的时候，还以为他是不善交际或者性格乖僻才选择离群索居的呢，但没过多久，我就发现事情与我想的恰恰相反…不过每次我们聊天，他总是在故事最后加入些吊胃口的情节，我在想，这是不是因为…他其实欢迎我多去拜访呢？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于菲林斯·秘密…",
      "text": "你是说菲林斯先生身上藏着许多秘密？当然，这在执灯士当中并不稀奇。我的同僚们出身各不相同，谁能没有几个不想告诉别人的秘密呢？就连老爹也很少向我提及他年轻时的往事。至于菲林斯先生嘛…最近发生了那么多事，好歹也是朋友，他的秘密我多少能猜到一点点。我试着求证过，他既没有否认，也没有承认，可能那也是一种表态。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于菈乌玛…",
      "text": "自铸灯者的时代开始，我们与霜月之子就保持着传统的友谊。这一代的咏月使是位温柔又和善的小姐，每次拜访我都能从她那里学到很多。以如今这个世道，当咏月使不会比做执灯人轻松。她能始终保持这种态度，想必也承受了许多吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于法尔伽…",
      "text": "法尔伽先生是位了不起的战士，我们曾并肩对抗过狂猎。听说西风骑士团也和我们执灯人一样，是为了守护家园而建立的组织。或许有一天，等挪德卡莱的狂猎都被消灭干净了，我们也能远赴异域，为更多生活在苦难中的人们而战。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于奈芙尔…",
      "text": "多亏了秘闻馆的关照，我们在那夏镇的行动才会如此方便，以前可不是这样的。据说在奈芙尔小姐来到挪德卡莱之前，执灯士们和那些不守规矩的帮派分子经常发生冲突，老爷子还一度为此苦恼…现在真是好多了呢。不过，奈芙尔小姐也和菲林斯先生一样爱拿我寻开心，也让我有些苦恼就是了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于爱诺…",
      "text": "我们执灯人维修复杂机关，一般都会请爱诺小姐来帮忙，不过她看起来好像是真的想教会我们…自从有一次，我被她看到在自己修理机关之后，她就大吵着怎么说也要拉我去上课…嗯？你问我是怎么修的？那我当然是跟老爹学的，机关不灵，只要用力敲两下就好了，谁知道她会这么生气…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于莉奈娅…",
      "text": "像莉奈娅这样的妖精小姐，即便在鱼龙混杂的挪德卡莱也很少见。在认识之前，我原本以为她会是更加沉稳的类型。没想到第一次见面，她看到阿咚之后直接两眼放光地扑了上来…阿咚可是面对狂猎都从不退缩的信鸟，但现在每次只要一听到她的声音，就会马上躲进灯里不肯出来…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于「月神」…",
      "text": "挪德卡莱是「人」的乐园，这条道路是由数百年来无数执灯士的血与骨所铺就的。就算如今迎来了一位新的神明，属于挪德卡莱的生存方式也不会因此而改变吧。不是不相信那位「月神」小姐…只是我觉得，比起等待别人来拯救，还是拥有能主动保护身边人的力量更安心。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解叶洛亚·其一",
      "text": "想要了解我的过去？嗯…让我想想…好像没有那种说出来能让人开心的部分啊，你真的想听吗？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解叶洛亚·其二",
      "text": "阿咚是我的信鸟，每次出门巡夜的时候我都会带上它。它不仅会提醒我周围的危险，还能帮我照亮前方的路，是非常可靠的伙伴…嗯？你是说你走过这么多国家也从没见过这种会发光的鸟？等等…该不会它真的不是普通的信鸟吧…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解叶洛亚·其三",
      "text": "如你所见，我的誓言之灯与大家的制式并不相同。这可不是因为我是分队长就有什么特殊，它是我在后勤分队的时候所用的信号灯。后来执灯人的装备更新换代，就只剩下了我手上这最后一盏…我大概是习惯了吧，每次想到要换掉它就觉得很难受。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解叶洛亚·其四",
      "text": "我的老爹尼基塔，同僚们都叫他老爷子。说是这么说，我可一点没觉得他老。各地灯塔的部署情况，他比我记得还清楚，我的事情也从来瞒不过他。不过越是这样我就越忍不住想，要是有一天他真的老了该怎么办呢？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解叶洛亚·其五",
      "text": "狂猎到来时，我总能听到狂风中夹杂着逝者的哀鸣。每到这个时候，就仿佛又回到了那个地狱般的战场，回到了被老爹捡回来的那一天。或许只要狂猎还没被彻底消灭，缠绕着我的梦魇就不会离去。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "叶洛亚的爱好…",
      "text": "你这样一说，我的闲暇时间好像也都和同僚们待在一起…最近执灯士中很流行一种叫作「桌上剧团」的游戏，我们还没凑够一起玩的人，你要不要也来参加？"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "叶洛亚的烦恼…",
      "text": "无辜之人因为突如其来的灾难而莫名其妙地丢掉性命，这种事情我无法原谅。我所做的一切努力，都是为了让这样的事不再发生在其他人身上。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "食物嘛…我倒是没什么特别的偏好。在我看来，只要能和大家一起围着炉火，热热闹闹地吃上一顿，无论煮的是什么，那都是最好的美食。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "只要是热乎乎的食物都没问题，凉的最好不要…你想想啊，要是等到了冬天，大晚上值夜的时候吃到的饭菜还是凉的，想想都忍不住要说难听的话了…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "令人惊艳的味道，能告诉我调味的秘方吗？我也想学学看。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "不错啊，真想让同僚们也尝尝。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "嗯…要不还是让我再多教你几道料理吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐，亲爱的队员。今天就别管什么委托了，也暂且忘掉那些冒险吧。这么重要的日子，就应该一整天都跟朋友们待在一起，吃饱喝足然后睡个好觉，你说对不对？放心，我会替你守着的。要是有什么烦人的家伙敢来打扰你，我就用我手上的这盏灯把他们都赶走。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "原来还有这种变强的方法，事半功倍了啊。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "力量有所提升，但要用来保护大家还远远不够…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "多谢你教我，这段时间我学到了很多，对自己稍微有些信心了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "真是惭愧，一直在麻烦你。不过现在我已经变得足够强大了，所以接下来希望你也能多依赖我一点。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "去吧，阿咚！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "趁现在！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "交给你了！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "瞄准好了。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "你跑不掉的。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "机不可失。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "我的灯下没有阴霾！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "接受明光的制裁吧！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "迎接黎明的曙光！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "宝藏应该交给需要它们的人。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "居然不是陷阱，看来是我多虑了。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "之前没注意到啊…得加强巡察了。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "有种不祥的预感…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我还是高估自己的实力了啊…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "现在叫增援还来得及吗？"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "别离开我的视野。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "该轮到我来保护你了。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "要是能再努力一点的话…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "至少要将情报带回去…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "还是，没能保护大家…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "可恶…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "大意了。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "还能忍受。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "再坚持下。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "明白了，这也是执灯士的职责。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "让我来替你掌灯吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "我会努力不让你失望的。"
    }
  ]
}