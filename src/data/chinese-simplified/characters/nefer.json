  "passives": [
    {
      "id": "a_wager_of_moonlight",
      "name": "月下的豪赌",
      "description": "依据队伍的<span style=\"color:#FFD780FF\">月兆</span>，奈芙尔将获得对应的强化效果。<br/><br/><span style=\"color:#FFD780FF\">月兆·满辉</span>：施放元素战技<color=#FFD780FF><b>弈术·千夜一舞</b></color>时，将使当前场上的草原核转化为「诳言之核」，且附近所有角色在接下来的15秒内触发月绽放反应时，将取代草原核与丰穰之核产生诳言之核。诳言之核无法触发超绽放与烈绽放反应，也无法迸发。<br/>奈芙尔施放重击或<b><span style=\"color:#FFD780FF\">幻戏</span></b>时，可以吸收附近一定范围内的诳言之核，每吸收一枚诳言之核，奈芙尔便会获得一层<b><span style=\"color:#FFD780FF\">「伪秘之帷」</span></b>效果；该效果叠加至3层或3层的持续时间刷新时，奈芙尔的元素精通提升100点，持续8秒。",
      "level": 1
    },
    {
      "id": "daughter_of_the_dust_and_sand",
      "name": "尘沙的女儿",
      "description": "奈芙尔处于<b><span style=\"color:#FFD780FF\">「影舞」</span></b>状态下时，队伍中的角色触发月绽放反应后的5秒内，奈芙尔的<color=#FFD780FF><b>蛇行</b></color>状态还会额外为队伍提供<b><span style=\"color:#FFD780FF\">草露</span></b>；依据奈芙尔的元素精通超过500的部分，每100点元素精通都将使上述提供草露的效果提升10%，至多通过这种方式提升50%。",
      "level": 4
    },
    {
      "id": "moonsign_benediction_dusklit_eaves",
      "name": "月兆祝赐·廊下暮影",
      "description": "队伍中的角色触发绽放反应时，将转为触发月绽放反应，且基于奈芙尔的元素精通，提升队伍中角色造成的月绽放反应的基础伤害：每点元素精通都将提升0.0175%月绽放反应的基础伤害，至多通过这种方式提升14%伤害。<br/><br/>此外，奈芙尔在队伍中时，队伍的<span style=\"color:#FFD780FF\">月兆</span>将会上升一级。",
      "level": 0
    },
    {
      "id": "conspiracy_of_the_golden_vault",
      "name": "金室的密谋",
      "description": "在挪德卡莱执行时长为20小时的探索派遣任务时，获得的奖励增加25%。",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1221,
      "id": "planning_breeds_success",
      "name": "谋篇乃成败之始",
      "description": "奈芙尔的<b><span style=\"color:#FFD780FF\">幻戏</span></b>造成的月绽放反应伤害的基础伤害提升，提升值相当于奈芙尔的元素精通的60%。该效果同样会受到<b><span style=\"color:#FFD780FF\">「伪秘之帷」</span></b>的加成。",
      "level": 1
    },
    {
      "_id": 1222,
      "id": "observation_feeds_strategy",
      "name": "明察为筹算之先",
      "description": "突破天赋<b><span style=\"color:#FFD780FF\">「月下的豪赌」</span></b>的效果获得强化：<b><span style=\"color:#FFD780FF\">「伪秘之帷」</span></b>的持续时间延长5秒，上限提升至5层，且至多使<b><span style=\"color:#FFD780FF\">幻戏</span></b>造成原本140%的伤害；奈芙尔施放元素战技<color=#FFD780FF><b>弈术·千夜一舞</b></color>时，将立刻获得2层「伪秘之帷」。此外，「伪秘之帷」叠加至5层或5层的持续时间刷新时，奈芙尔的元素精通改为提升200点，持续8秒。<br/>需要解锁突破天赋「月下的豪赌」。",
      "level": 2
    },
    {
      "_id": 1223,
      "id": "deceit_cloaks_the_truth",
      "name": "诳言掩虚实之迹",
      "description": "元素战技<color=#FFD780FF><b>弈术·千夜一舞</b></color>的技能等级提高3级。<br/>至多提升至15级。",
      "level": 3
    },
    {
      "_id": 1224,
      "id": "delusion_ensnares_reason",
      "name": "眩惑入谜局之网",
      "description": "奈芙尔在场上且处于<b><span style=\"color:#FFD780FF\">「影舞」</span></b>状态下时，获取草露的速度提升25%。<br/>此外，奈芙尔处于「影舞」状态下时，还会使附近敌人的<span style=\"color:#99FF88FF\">草元素抗性</span>降低20%，当奈芙尔不处于「影舞」状态或离开敌人一定距离后，该效果会在4.5秒后移除。",
      "level": 4
    },
    {
      "_id": 1225,
      "id": "opportunity_hides_in_the_margins",
      "name": "见机在忽微之间",
      "description": "元素爆发<color=#FFD780FF><b>圣约·真眸幻戏</b></color>的技能等级提高3级。<br/>至多提升至15级。",
      "level": 5
    },
    {
      "_id": 1226,
      "id": "victory_flows_from_the_turning_of_tides",
      "name": "决胜于逆转之时",
      "description": "奈芙尔施放<b><span style=\"color:#FFD780FF\">幻戏</span></b>时，自身的第二段伤害将转为造成相当于奈芙尔元素精通85%的<span style=\"color:#99FF88FF\">草元素范围伤害</span>；此外，幻戏的攻击结束时，还会造成一次相当于奈芙尔元素精通120%的<span style=\"color:#99FF88FF\">草元素范围伤害</span>。上述伤害均视为由幻戏造成的月绽放反应伤害。<br/><br/><span style=\"color:#FFD780FF\">月兆·满辉</span> <br/>奈芙尔造成的月绽放反应伤害<b><span style=\"color:#FFD780FF\">擢升</span></b>15%。",
      "level": 6
    }
  ],
