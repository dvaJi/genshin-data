  "outfits": [
    {
      "id": 207400,
      "name": "梦里星",
      "description": "莱依拉的装扮款式。幽深安宁的夜中，点点星光包裹着她进入最甜蜜的梦乡——以上是莱依拉的美好愿望。",
      "isDefault": true,
      "characterName": "莱依拉",
      "characterId": 10000074,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Layla_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "哈…你好，我是梨多梵谛学院的在读学生莱依拉。…嗯？对不起，昨天没睡好我现在精神有点差，你刚才是在说「想和我组队」吗？\\n没有没有，我不是不愿意，只是怕你不习惯我的作息方式…那、那个…请多关照！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·注视",
      "text": "就算我们不抬头仰望，星空，也永远注视着我们。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·梦游",
      "text": "腿好酸…唉，大概昨天晚上又梦游了吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·哀叹",
      "text": "…为什么报告和论文永远写不完？为什么？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "天气好差，今晚没法观测星空的话…唉，我的星图课作业真的不能再拖了啊…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候…",
      "text": "雪地看起来亮晶晶的，很像天上的星星。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "阳光很好…",
      "text": "太阳晒着…好困…对，保持这个感觉，赶快找个枕头睡一觉…我已经两天、两天没有…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "白天晒，晚上冷，我、我要不行了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "你睡得饱吗？要是还困就回去再睡会儿吧…我？我…习惯了…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "我在计算星轨呢，刚算到一半，午饭你就先吃好了…这里的角度不太对劲吧…不、不会吧…我是从哪儿开始算错了呢？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今晚我要早早躺到床上去，争取早点睡着。伟大的智慧之神啊，求您庇护我的睡眠。好，我要闭上眼睛。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "…哈，让我看看她又被什么难住了。嗯…要整理三年份的旧星表，中期报告的附录还缺几张星图没画…好吧，从这份开始。\\n嗯，你怎么来了？现在可是最重要的睡眠时间。我？我当然是在梦游了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于莱依拉自己·理论星相学",
      "text": "按照教科书上的说法：「利用理论星相学知识解决具体生活中的麻烦，这不是我们该关心的问题。」其实我觉得还有一个重要原因…就是…嗯，成本太高。我们测算的时候，一般会动用好多台星象仪，至少要查阅一年份的星图，才好给出一套…严谨的答案。但如果是为了算明天香料会不会涨价，怎么想都不太划算吧…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于莱依拉自己·理由",
      "text": "既然有了自己喜欢又能做得好的事，就得坚持下去，哪怕这条道路特别艰辛，哪怕一路上竞争极其激烈，哪怕不一定能顺利毕业，哪怕没能顺利毕业的话，就要把所有的奖学金还回去…啊，要不我还是回家吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·陪伴",
      "text": "嗯哼，我也不想熬夜补课题进度，可谁叫她总有那么多做不完的事。没办法，我当然得帮帮她咯。…你想陪我一起吗？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·漫游世界",
      "text": "如果毕业之后，我没有留在教令院工作，就和你一起去漫游世界吧。你觉得怎么样？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "哈…是什么在亮？我睡觉的时候忘了关灯吗…哦，是神之眼啊，我说呢…欸，不对，我睡觉之前…把它放在床头了吗？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "我们学院主编的星表汇聚了所有生灵的命运，毫无疑问是占星知识的顶峰，第一次看到的时候我整个人都被吓得说不出话了！欸？你感兴趣吗？只是简单看看的话…我帮你提交申请吧，应该能被批准，应该…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "有没有什么能捕虫的植物啊，快救救我吧。晚上本来就睡不着，房间里还有小飞虫，一直嗡嗡响个不停，但我、我怎么找都找不到它在哪里…呜呜…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于莫娜…",
      "text": "在明论派学者的小圈子里，阿斯托洛吉斯·莫娜·梅姬斯图斯发表在《蒸汽鸟报》上的星相学文章名气不小。那些文章专业性都很强，但却能被学者之外的群体喜欢，要做到这点还是挺不容易的…欸？我把她的名字念得很流利？因为…厉害的人…得多多尊敬。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于丽莎…",
      "text": "啊，我知道你在说谁了。丽莎·敏兹，传说中只用了两年就学成毕业的素论派天才，要是我也能有这样的头脑…你在蒙德的时候见过她本人？真、真的吗？她平时都是怎么学习的？看些什么书，做些什么工作？我…我该从哪里向她学起？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于多莉…",
      "text": "多、莉、吗…我咬着牙、攥着拳头在她那里买过一次东西，她看我结账很痛快，好像误以为我是什么有钱人，后来还一直寄商品宣传单给我，唔…真是天大的误会！那次购物的代价…不仅把我的奖学金垫进去了，接下来的大半年里，我吃饭都不敢多要肉，买书还得等打折…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于赛诺…",
      "text": "「大风纪官」大人很擅长「七圣召唤」吗…啊我是在想，有机会的话，说不定可以和他打一局。像「七圣召唤」这种牌类游戏，熟练掌握运算技巧的人玩起来总是简单一点，我反而…不一定…或许不会输给他。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于坎蒂丝…",
      "text": "我第一次梦游醒来的时候，曾经见到过你描述的这个人，原来她叫坎蒂丝啊。我还记得自己醒来的那一刻…所有报告和文章都被完成了。当时的感觉就好像…好像我每天对着星空念叨，终于被星星听见了，它们派了一位使者来帮助我，呜呜…太感动了！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于艾尔海森…",
      "text": "职务达到书记官这种高度的人，应该就不用发愁能不能立项、能不能成功了吧。不对，既然都当了书记官，应该连项目都不用做了。真好啊…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于小吉祥草王…",
      "text": "伟大的智慧之神，我最近每晚都在熬夜复习，考试就请让我通过吧！拜托了拜托了…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于珐露珊…",
      "text": "珐露珊老师招到学生了吗？听知论派的人说，她的项目申请经费一直很难，招不到学生也很正常。唉…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解莱依拉·其一",
      "text": "我算不上有天赋，领悟力也不太够…拼命读书通过考试这才进了教令院。对不起，我…我先不跟你闲聊了，一说到教令院我就想起来，我的课题进度报告…到现在为止还没有进度呢。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解莱依拉·其二",
      "text": "我和导师的关系吗？嗯…怎么说呢…啊，你不要误会了，其实导师对我挺好的，我入学的时候还得到了她的推荐呢。每次我觉得自己要撑不住了，她都会鼓励我，然后顺便多要求一篇论文…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解莱依拉·其三",
      "text": "整个须弥最有才能的人几乎都到教令院来了，而且这儿还有那么多聪明得让人发抖的外国学者，你想想，这里的竞争该有多大！和这些人一起学习…我真的够格吗？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解莱依拉·其四",
      "text": "嘘，小声点，不要吵醒她，就让她安心睡上一觉吧。你问我嘴里的「她」是谁？哦，当然是每天为课业抓耳挠腮的莱依拉呀。那我是谁？呵呵，我也是莱依拉呀。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解莱依拉·其五",
      "text": "我听别人提过，她好像以为所有写不完的课业总能在一场梦之后自动完成，都是「星空的赐福」。她呀，完全搞错了哦。…不过，你可别告诉她哦。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "莱依拉的爱好…",
      "text": "画星图真的是件累人的事，如果不是因为喜欢，我恐怕也坚持不下来。一会儿要用尺、一会儿要拿纸算、一会儿要查历年的星象…不知不觉一天时间就过去了。但看着画得整整齐齐的巨大星图，总是很有成就感。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "莱依拉的烦恼…",
      "text": "从前我还没进入教令院念书的时候，睡眠质量还算过得去。但自从在这里学习之后…唔，压力实在是太恐怖了…我真的很想每天安安稳稳一觉到天亮，呜呜…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "每晚我躺上床之前，都会为自己热一杯牛奶喝，希望夜里能有个好觉，希望夜里能有个好觉，希望夜里能有个好觉。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "有一次，我听人说，有个神奇商人在卖的「睡眠软糖」很有效。我花光了奖学金和攒下的零花钱试了试，确实有效，那阵子我也睡得很好。但一盒卖二十万摩拉…实在太贵了，我、我绝对不会再买了，买一送一也不行，买一送二的话…我就再考虑考虑。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好厉害，好羡慕，你还真是什么都会呀。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "…嗯，味道还算不错。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "要不…我们还是去店里买外带吧？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐，我把这个袖珍星盘送给你。希望从过去到未来，见证了我们所有人类命运的星星能把目光分给你，伴随你走过沙漠、穿过海洋，到达你所探寻的终点。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "莱依拉啊莱依拉，你还要更勤奋。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "莱依拉啊莱依拉，你已经很勤奋了，不过你的知识还不够全面。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "莱依拉啊莱依拉，你读书又勤奋又广博，这很好。但你可千万不能松懈，一时懈怠，就会落后于人，最后悲惨延毕。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "莱依拉啊莱依拉，要相信自己，也要相信帮了你那么多的那个人。你们一起，什么问题都能解决！\\n呼…好了，所有担心我都抛到脑后了，咱们出发吧！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "寒星！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "拒绝打扰！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "星星的加护。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "星辰，为我降下。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "极寒，任我驱使。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "别害怕。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "性价比不错。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "还是你眼睛尖。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "哇！突然感觉不困了。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我好困…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "完了完了完了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "现在逃还来得及吗？"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "醒醒，别昏过去！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "糟了糟了，你、你受伤了！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "永恒的睡眠…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "老师，对不起…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "拜托了，这是个…梦…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "你不讲理！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "这是违反规定的！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "睡不着就四处走走吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "请好假了…没有忘的吧？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "唉，脑袋空空，出去放松。"
    }
  ]
}