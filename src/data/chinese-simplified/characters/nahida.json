  "outfits": [
    {
      "id": 207300,
      "name": "万识一偈",
      "description": "纳西妲的装扮款式。唯有阐释真知的谶语妙词堪为智慧之神作饰，因此她的一切衣饰均被信徒视为圣言。",
      "isDefault": true,
      "characterName": "纳西妲",
      "characterId": 10000073,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Nahida_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "初次见面，我已经关注你很久了。我叫纳西妲，别看我像个孩子，我比任何一位大人都了解这个世界。所以，我可以用我的知识，换取你路上的见闻吗？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·邀请",
      "text": "不知道干什么的话，要不要我带你去转转呀？"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·心事",
      "text": "又有心事吗？我来陪你一起想吧。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·感受",
      "text": "果然要亲眼去看，才能感受到世界的美。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "快去避雨吧，小心头顶上长出蘑菇哦。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "你知道吗？雷鸣是生命的前奏，很快这片大地就会充满生机。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "听见了吗？天空正对万物轻语：「睡觉时间到了哦。」"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "天气真好啊，暖洋洋的，我们的身边马上也要热闹起来了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起风的时候…",
      "text": "宫殿里可不会起风呢…哦，抱歉，对你来说是理所当然的知识吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好，我们赶快出发吧，这世上有太多的东西都是「过时不候」的呢。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午休时间到，我想喝树莓薄荷饮。用两个和太阳有关的故事和你换，好不好？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "太阳落山啦，我们也该把舞台让给夜行的大家族了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "快去睡吧，放心，我已经为你准备好甜甜的梦啦。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于纳西妲自己·见识",
      "text": "烬寂海啊，那里什么都没有，就像蕈猪的脑子一样空空如也，我当然知道。啊？我…我确实没有亲眼见过，那也是我所触及不到的地方呀。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于纳西妲自己·痴迷",
      "text": "神明只送给人类填饱肚子的知识，人类却借此制作了工具，书写了文字，壮大了城邦，现在又放眼星辰与深渊…他们每时每刻都在创造全新的「知识」，也令我再也无法移开双眼。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·故事会",
      "text": "你旅途中的见闻，比我学习到的知识要精彩太多，而且我还能随时提问，把所有的细节都了解到一清二楚…真是太满足了。好了好了，别浪费时间，我们快继续吧。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·旅行",
      "text": "我早就不满足于当一个听众了，一直都想出去看看。你冒险经验这么丰富，当我的向导好不好啊？你之后所有的故事，我都想亲身感受。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "天空长出眼睛是为了见证大地的美好，而本来就拥有双眼的人类，是在什么样的情况下，才需要靠「神之眼」观察这个世界呢？这个问题的答案，聪明的你能够明白吗？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "很多时候，我们直到经受切肤之痛，才不得不直视自身的懒惰，愚昧，鲁莽或傲慢。但大可不必为此懊悔，我们无法观测未来的所有可能性，只能靠这样略显笨拙的方式获取知识。学费而已，再正常不过啦。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻·未见之花",
      "text": "须弥的沙漠看上去比雨林缺乏生机，但它也承载了久远的文明，孕育了稳定的生态。等哪天它不再和雨林吵架了，一定能开出我从来没见过的花吧。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于赛诺·笑话",
      "text": "他讲的笑话确实深奥，还挺有意思的。嗯？你有哪句没听懂吗？那我解释给你听吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于赛诺·职责",
      "text": "在面对秩序与正义的冲突之时，不是每一位「大风纪官」都能得出绝对坚定的答案。他应该最清楚，妥协的结果只有无路可退，所以他现在能回到属于他的位置上，对整个须弥而言都是一大幸事。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于提纳里…",
      "text": "雨林能够对抗「死域」的侵蚀，至今都生机焕发，巡林官们的付出举足轻重，而提纳里又是他们之中的佼佼者。只是…希望他可以稍稍温柔一些，这样才更有利于巡林员招新纳贤嘛。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于柯莱…",
      "text": "我听说过她的故事，她的坚韧如宝石般璀璨夺目。她经历了太多，希望须弥的葱绿能够长久地庇护她，令她像普通的女孩子那样健康成长。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于艾尔海森…",
      "text": "他拥有很超前的知识体系，并且每时每刻都在保持思考，或许这个世界上没有什么事能瞒过他吧。然而对智慧者而言，普通人的凡庸是一种与生俱来的错吗？那都是「我们」不可分割的一部分。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于妮露…",
      "text": "我曾经借用别人的身体，问她想不想让小吉祥草王来看她的舞蹈…虽然我已经悄悄看了很多次，但按理来说，应该要我本人到场，才算是对她「花神诞祭」表演的尊重。结果我却被委婉地拒绝了…唔，有点伤心。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于多莉…",
      "text": "她见到我的第一句话就是，「我看上了你的宫殿，怎么卖啊？」净善宫怎么可能卖给她呢？不过她的问题确实把我问住了，我想了好久，也不知道净善宫该定价多少摩拉…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于卡维…",
      "text": "他对须弥推行智慧这一事的理解，已经非常接近本质了，很可惜的是，他掌握的真相无法成为这个国度的主流。什么？你说他和艾尔海森是室友？世上居然还有这种可能性…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于珐露珊…",
      "text": "她的身体遭受了赤王遗迹中残留力量的影响，就像是被时间这只大乌龟不小心甩下了背，永远忘在了身后。如果你感兴趣的话，应该能从她身上窥见过去须弥的一角吧。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于尘世七执政·引荐",
      "text": "好像尘世七执政之间在很久很久以前还会定期联络，只是我的情况比较特殊，已经不记得这段经历了…既然须弥的混乱告一段落，我觉得我该重新见他们一面。你熟识的那几位神明，能为我引荐一下吗？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于尘世七执政·游戏",
      "text": "听说玩游戏能够快速缩短人与人之间的距离。神也是如此吧。不如，在和大家相聚之后，我就主动提议一起玩「跳房子」…好像也不合适。弄得像是我把房门做成了小小的洞口，仗着自己的优势欺负大家一样。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于散兵…",
      "text": "当他自认为追寻已久的愿望终于实现，他眼中所见的究竟是满足，还是更大的空虚呢？正是因为我们不会飞，才会无比向往天空…让他好好想想吧，在拥抱过空无一物的天空之后。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "人们常说，智慧并不取决于知道些什么，而是取决于可以改变些什么。毫无疑问，那个「预言」早就刻写在了世界树中…明明好像一切都没改变一样，但又好像什么都已经改变了。你我都知道，她是聪明到可以扭转世界命运的人呀。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于赫布里穆…",
      "text": "深渊会以最致命的形态在提瓦特显化，在须弥是「禁忌知识」，在纳塔则是魔物，正因如此，须弥的诸多经验也无法帮助到她，对此我有些愧疚。所幸现在危机已经化解，她说会有很多纳塔人到须弥游玩，我很欢迎他们，而且已经做好准备啦。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解纳西妲·其一",
      "text": "我的过往相当单调，估计你听上一会儿就会像炮鲀吸水那样打哈欠。不过好奇心是弥足珍贵的东西，我也不想浪费…既然这样，我给你分享一些我做过的梦吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解纳西妲·其二",
      "text": "我的梦中总会出现一个花盆，每次浇水施肥就会长出相同的花。对于完全确定的收获，你还能享受养花的过程吗？呵呵，对我来说，至少每次开花之后飞过的蝴蝶，都有不一样的颜色，有时候还会有蜜蜂呢。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解纳西妲·其三",
      "text": "我的梦中总会出现一个沙漏，我喜欢往里面加一点点水，搅匀之后看它走完一次需要多长时间，和上一次又差了多少。没有规律，也没有意义，却能带走我大脑积累的疲惫，我想「什么都没有」正是它的乐趣所在。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解纳西妲·其四",
      "text": "我的梦中总会出现一片空地，无论周遭的景色如何变化，它都会占据最重要的位置，挺奇怪的吧？我觉得这里曾经应该存在过什么东西，可就算我驱使梦境的权能也无法获得答案。唔，居然梦中也有我不能掌控的东西…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解纳西妲·其五",
      "text": "我的梦中什么都有，唯独缺少来来往往的人。但在与你相遇之后，这里渐渐变得热闹了。或许你在梦中扮演的是「向导」这样的角色，不仅让我的梦变得更有人情味，也带我走出了牢笼。呵呵，走吧，接下来的旅途也请你引路了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "纳西妲的爱好…",
      "text": "就这么看着你，算是爱好吗？因为你的一举一动都让我很好奇啊。作为世界的旅行者，你从哪里来，将到哪里去，会遇到什么人，战胜什么困难，都是我想寻求的答案。你不用太在意我，就让我一直观察你吧。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "纳西妲的烦恼…",
      "text": "我自认为我擅长提问和回答问题，但我渐渐明白，有很多人是揣着明白装糊涂，问题的答案并不能帮上他们的忙。是不是随着年龄增长，大家都会失去面对质问和答案的勇气呢…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "当然是枣椰蜜糖了，只要吃上一小块，大脑就会噼里啪啦地飞速运转，没什么问题解决不了。唯一需要注意的是，装蜜糖的罐子不能放在太容易伸手够到的地方。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "那些海鲜，它们在无边无际的黑暗中出生，成长在我所不了解的海底深处。要我吃下它们，就好像要我咽下一团脏兮兮的乌云一样。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "像这样的好味道，应该被世界永久记录下来。谢谢你。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "呵呵，你的心意我收到了，味道也可圈可点。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "…怎么说呢？打比方的话，你不会给狗狗喝蔬菜汁吧？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "我想了想，要庆祝你的生日，至少也要像「花神诞祭」一样隆重…欸？太夸张了吗？可是我都让人准备好了，走吧走吧，仅限一次也好，绝对会让你满意的！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "变聪明啦~"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "思路变得更开阔了，天空和大海都能装进去。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "这种感觉，就像月莲找到了莲叶，珊瑚真珠找到了贝壳。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "感谢你愿意让我成为你的同伴，还教会了我那么多新的知识。我以智慧之神的名义为你赐福，从今往后不再会有困惑阻碍你的旅途。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "记住你了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "蔓延吧。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "等下有点痛哦。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "嘿！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "手牵手~"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "全都看见咯。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "来我家做客吧~"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "知识，与你分享。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "此即智慧之殿堂。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "好奇心值得嘉奖哦。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "是源自谁的馈赠呢？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "有你想要的吗？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "换个策略吧。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "别打啦！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "这样不太明智…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "让我来想想办法。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "别再硬撑了。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "生命…终有尽时…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "枯萎之刻…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我…不明白…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "好痛啊。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "被打晕了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "我等你好久啦。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "没去过的地方还有很多呢。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "又可以增长见识了。"
    }
  ]
}