  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "嗨，小可爱，你是新来的助理吗？啊？魔导师大人？那是很久以前的事啦，现在的我不过是一介图书管理员而已。放心吧，姐姐会照顾好你的。那么…"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·下午茶",
      "text": "明明是该喝下午茶的时间。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·任务",
      "text": "任务是做不完的，还不如陪姐姐…聊会儿天。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·不宜出门",
      "text": "今天不宜出门…欸，我昨天也是这么说的？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "这种天气，泡一杯茶，坐着看雨多好。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "在雷雨天训练事半功倍哦~呵呵，骗你的。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "起风的时候…",
      "text": "天气真好，能躺下来补个觉就更好了。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "啊…早安，琴。嗯？不好意思，我看错了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午休时间到了…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "你还不睡吗？我已经困了呢…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "你努力的样子，姐姐全都见到了哦。嗯…让我想想，给你什么奖励吧…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于丽莎自己…",
      "text": "这可不是偷懒呀。谁不想用最省力的方法达到目的呢？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·关系",
      "text": "你想把我当作你的老师、前辈，还是朋友？都可以哦。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·本领",
      "text": "哎呀，再不拿出点真本事出来，就对不起你的努力了吧。嗯哼…也好也好。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·仪式",
      "text": "再等一下，「将悔罪的记号吻在弟子的前额」…好了，那么仪式就完成了~今后你就是我丽莎的首席弟子了哟。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」啊…那可是导引元素力所必要的装置呢。唯独在你身上却是例外。唔…究竟是什么原理呢，啊，有了，你…有空陪姐姐做个实验么？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "图书馆楼上的炼金工坊，可以随意使用哦？不过进去之前记得敲门，如果撞见什么不该见到的东西那就麻烦了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "嘟嘟莲是有着解毒功效的药草。有了它，就不用再担心魔药的副作用了…哼哼。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于琴…",
      "text": "琴是个称职的好团长。看到她认真工作的样子，就连我也忍不住想要多帮她一把。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于安柏…",
      "text": "小安柏刚进骑士团的样子我还记得呢，一转眼都那么能干了。啊，再过几年，又会变成什么样呢？"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于芭芭拉…",
      "text": "芭芭拉的歌，你听过么？哼哼，听说她的旋律里有种治愈的魔力在流动喔。和我的魔药相比，不知道哪边更合你的胃口呢？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于迪卢克…",
      "text": "哦，想听迪卢克的故事？哈哈，那我知道一个更好的聊天对象。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于雷泽…",
      "text": "小狼狼，来来，过来这边。今天就临时来一场实战练习吧，对手我已经给你找好了哟。欸？怎么跑了，真是的…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于可莉…",
      "text": "上次小可莉想借用我的工坊做实验，被我拒绝了，她可是生了我一天的气呢。嗯？你问第二天？第二天，她当然又高高兴兴地出门去玩了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于莫娜…",
      "text": "莫娜？似乎是一位很优秀的魔导师小姐呢。但我并不是她们「魔女会」的成员哦。古树考察，组织茶会，一听就是麻烦的事情吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "姐姐我觉得，阿贝多是很优秀的炼金术士。跟他只需要用三言两语，就能得到不错的结论。而且脸也长得好看。和小可爱你很像喔，嗯。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于菲谢尔…",
      "text": "菲谢尔…哦，那个总是来图书馆借幻想小说的女孩子。每次还书都会提前三天，对书籍也十分爱护，是个好孩子呢。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于诺艾尔…",
      "text": "拜托诺艾尔清扫书架的时候，总感觉这孩子，越是疲惫就越开心，嗯…到底是怎么回事呢？"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于砂糖…",
      "text": "没事就不要去打扰小砂糖哦，会吓到她的。呵呵，她擅长和各种各样的生物打交道，却唯独，不怎么善于和人类相处呢。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于赛诺…",
      "text": "离开须弥之后，除了和恩师保持礼节性的通信，我和教令院已经没有什么往来了。幸好，不是每位被寄予了重望的弟子，都像我一样怠惰…听说那位师弟赛诺就相当活跃呢。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于柯莱…",
      "text": "小柯莱每次写信都会使用新词，尝试与之前不同的表述方式。呵呵，也难怪她进步得那么快。除了自己的努力之外，她那位善良而又热忱的师父，一定也给予了很多帮助吧。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于米卡…",
      "text": "真羡慕霍夫曼先生有这样一位擅长照顾人的弟弟。不仅帮着打点生活起居，连喝醉后的护理也无微不至。啊，我也好想什么都不用操心，懒洋洋地度过每一天啊…嗯？你说我现在也差不多？哼，小可爱…胆子变大了嘛。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于布伦妮…",
      "text": "小布伦妮呀…总喜欢借些晦涩难懂的书，只要我稍微靠近一些，或者对她笑一下，她就会像一条琉璃花鳉，突然就挣扎起来。呵呵，可爱极了。真庆幸我不是她要找的「魔女」，不然，要是被这么认真的小猎人「盯上」了，姐姐我都不知道该怎么办了呢~"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解丽莎·其一",
      "text": "那么，今天想学习哪种元素力的知识呢？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解丽莎·其二",
      "text": "我的过去？嗯？想要更多地了解我一些吗？…可今天我恰巧有点累了。不过这份心意，姐姐我还是很高兴的。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解丽莎·其三",
      "text": "我教雷泽掌握元素力量的时候，完全没想到那个孩子的悟性有那么好。仔细想想的话，你也相当能干啊，小可爱。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解丽莎·其四",
      "text": "什么？想学习须弥教令院的魔法？可对现在的你来说，负担会有些重…啊？至少想学会入门的知识？那先看完这本《绪论》吧，也就800多页而已。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解丽莎·其五",
      "text": "总有一天，这「眼」中的力量会毁灭一切的吧…到了那时，如果有你在的话…啊，没什么。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "丽莎的爱好…",
      "text": "小可爱，你想要来挑一瓶神奇的药水么？喝下去之前完全不知道会有什么效果，呼呼。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "丽莎的烦恼…",
      "text": "二楼的审讯大厅已经闲置两年了，明明给我用作元素工坊的话，就不至于那么荒废…赫塔小姐真是死脑筋。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我喜欢蔬菜汤哦。只要把所有的蔬菜全都丢进一口大锅子里，再用长柄的勺子搅一搅…欸，问我好不好吃？哼哼，来，啊——"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我有南瓜恐惧症，每年的秋收节对我来说都太煎熬了。啊，要不要干脆把南瓜这个物种，彻底抹除呢？"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "真贴心呢，小可爱。姐姐我很满意哦。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "呵呵，你很擅长做这些呢。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "哎呀…这可真是…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "来，拿着，护身符，就作为生日礼物送给你了。虽然制作起来花了我不少时间…不许弄丢哦。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "该不会想让我加班吧…那可不好哦。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "锻炼的机会，应该多留给新人，不是吗？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "…要是我恢复全盛状态的话，说不定会发生什么不得了的大事哟。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "明明已经用各种方法劝过你了…真有你的，小可爱。到这份上还装作无动于衷的话，恐怕连丘丘人都看得出来我在撒谎了。那就让你见识一下，「蔷薇魔女」的真实吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "哼哼。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "该电一电了。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "别逃哟。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "…Blitz！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "这是…惩罚哦！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "…呵呵~"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "酥酥麻麻的哟。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "快点投降吧。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "可别上瘾喔。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "努力，获得回报了哟。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "我也来兴致了…"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "小可爱会喜欢吗？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "有你的嘛。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "有点生疏了呀…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哎呀，手套要破了呢。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "逞强可不好。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "要姐姐帮忙吗？"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "出门好累…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "看来我大意了呢…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "果然不该出门的…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "疼…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "不要那么粗暴。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "让姐姐帮帮你吧。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "我会看着你的。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "要出门了吗？"
    }
  ]
}