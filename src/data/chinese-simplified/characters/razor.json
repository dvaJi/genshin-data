  "outfits": [
    {
      "id": 202000,
      "name": "奔行原野",
      "description": "雷泽的装扮款式。便于野外奔行的简约装束。",
      "isDefault": true,
      "characterName": "雷泽",
      "characterId": 10000020,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "你的气味…好闻。一起狩猎吧！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·气味",
      "text": "唔，兔子的味道…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·饿",
      "text": "走吗，肚子饿了。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·望风",
      "text": "我去望风，走了叫我。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "打雷的时候·提醒",
      "text": "怕就快点躲起来。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "打雷的时候·带路",
      "text": "避开树，跟我来！"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "起风的时候…",
      "text": "风…唔…舒服。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "刮大风了…",
      "text": "风…嗯…扎扎的，有点疼。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "太阳出来了。狩猎一起去？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "大块吃肉，开心！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "你去睡觉吧，我看月亮。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "你睡觉，我看守。明天一起狩猎。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于雷泽自己…",
      "text": "我是狼。人的爸爸、妈妈，没有。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·朋友",
      "text": "你是朋友。我和你一起狩猎。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·武器",
      "text": "我有铁的爪子和雷的牙。我保护你。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」，师父帮忙。雷的牙打架，保护「卢皮卡」。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "晚上，星星很好看。天空，湖里，都有很多很多星星。\\n晚上，城市里，也有很多星星。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "我的「卢皮卡」的狼。它们是家人。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于丽莎…",
      "text": "师父的雷，天空会变黑。很可怕，很强。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于芭芭拉…",
      "text": "芭芭拉，亮晶晶的女孩子。很善良。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于迪卢克…",
      "text": "迪卢克，红红的、黑黑的。又冷又热。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于温迪…",
      "text": "诗歌…唔，不明白。虽然不明白，「卢皮卡」喜欢。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于班尼特…",
      "text": "班尼特，话很多，和他一起，吃不饱。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于可莉…",
      "text": "可莉，朋友！朋友，但是，头疼。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于法尔伽·陌生",
      "text": "法尔伽？不认识…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于法尔伽·回忆",
      "text": "哦…法尔伽，是名字。那个男人，高大。雷泽名字，铁的爪子，他给的。唔…想见他。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解雷泽·其一",
      "text": "你的气味，善良的味道。喜欢吃肉？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解雷泽·其二",
      "text": "你很强。和狼一样强。喜欢和你狩猎。收获很多。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解雷泽·其三",
      "text": "卢皮卡是「狼的家」。不对，是「狼的家人」。我的卢皮卡在树林里。它们保护我，说我是卢皮卡。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解雷泽·其四",
      "text": "我只有卢皮卡。\\n但是，就算是卢皮卡，我没有四只脚，不是真的狼。有时候心里难过。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解雷泽·其五",
      "text": "和你一起奔跑开心，和你一起狩猎开心。和你一起，我是狼，我是人，都没关系。\\n你是朋友，你是我的「卢皮卡」。我想要你也开心。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "雷泽的爱好…",
      "text": "喜欢卢皮卡。喜欢树林。喜欢朋友。喜欢奔跑。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "雷泽的烦恼…",
      "text": "说话很累，很难。但是，不说话不行。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "喜欢肉。喜欢土豆。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "蔬菜不好。我吃的肉才吃菜。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "气味很香，味道一样好。喜欢。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "吃了有力气，很开心。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "吃，不好。不吃，不好。有些难过。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "今天是你的…你是在很多很多个月以前的，今天出生的。想和你一起开心。今天一起吃肉。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "手臂，更粗了…？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "磨爪子，磨牙，要更强！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "跑，狩猎。不够，不行！我要…更强。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "牙齿，爪子，腿。更强，更有力气…保护你！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "走开！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "啊！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "嗷！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "别过来！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "嗷——"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "Blitz！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "嚎——"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆发·其四",
      "text": "啊——"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "这些东西，可能有用？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "箱子，用完可以，装东西。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "宝藏的气味。奇怪。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "疼。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "嗷——"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "杀了你！…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不行。"
    },
    {
      "id": "400002",
      "type": 2,
