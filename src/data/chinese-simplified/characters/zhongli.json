  "outfits": [
    {
      "id": 203000,
      "name": "凡世致身",
      "description": "钟离的装扮款式。「往生堂」客卿钟离先生近来最为青睐的假日常服。",
      "isDefault": true,
      "characterName": "钟离",
      "characterId": 10000030,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Zhongli_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "一份新的「契约」？好吧…虽然我还在度假，但也可以陪你走一趟。契约书上，该签什么名字呢？我有许多名字，度假期间的话…我会自称「钟离」。你呢，旅行者？你会签下什么名字？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·旅程",
      "text": "旅程总有一天会迎来终点，不必匆忙。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·游览",
      "text": "接下来想去哪里？如果想游历璃月名胜的话，我有一些不错的参考方案。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·璃月",
      "text": "为「流通」而造的船，遇到港口也会停泊，所以璃月是一切财富「沉淀」的地方。"
    },
    {
      "id": "1104",
      "type": 1,
      "title": "闲聊·怀旧",
      "text": "欲买桂花同载酒…只可惜故人，何日再见呢？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨过天晴…",
      "text": "「琉璃袋」这种植物，它偏爱潮湿的环境，最适合雨后采摘。如果发现的话，适当储备些吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候…",
      "text": "找个地方避避雪吧。我不会有事，但你可能着凉。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "刮大风了…",
      "text": "嗯…不适合度假的天气。去听听戏吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "希望今日也有好景气。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "想要吃点提神的？嗯，吃虎岩倒是有爿不错的店…"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "虽然这种时候已经错过了云先生的戏，但夜晚的璃月仍有许多好去处。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "集市已收，喧闹的码头也已沉睡。去休息吧。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于钟离自己…",
      "text": "不以规矩，不能成方圆。不管是常人还是仙人，惟有各司其职，方能保璃月长久太平。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·黄金",
      "text": "黄金是璃月的财富，是令璃月的心脏搏动的血液。你是否拥有黄金般闪耀的心，就让我拭目以待吧。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·契约",
      "text": "你我既有「契约」之交——那么凡在契约范围内的事，都可同我商量。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·公平",
      "text": "「契约」之外的事也可与我相谈。毕竟我在这片土地上活了这么久，凡事都略通一二。哦，虽说如此，我也有希望你能为我做的事情。毕竟，这样才符合「公平」嘛。"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "关于我们·困惑",
      "text": "「契约」无法界定「友谊」、无法丈量「情谊」，那到底用什么才能称量你我之间情感的重量呢？「朋友」，你知道答案吗？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」…也是一种「契约」。须知一切力量皆有其代价，一千种权力伴随着一千种责任。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "「交易」的规矩是「契约」，准则是「公平」。这是订立、遵循「契约」者绝不可忘却之事：倘若失了公平，那契约便成了欺瞒的凭据。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "你若去往「绝云间」，便替我采来一束「清心」吧。一束就好。此行的旅费…啊，差些忘了，「契约」生效期间，旅费由你代为垫付。那就有劳了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于魈…",
      "text": "你说，归离原的少年仙人…啊…直至今日，他仍在履行他的职责…哦，这副「连理镇心散」，请替我带给他。对了，可千万不能让小派蒙偷吃了去，这里的药力…绝非常人所能承受。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于温迪…",
      "text": "嘶...好浓的酒气。那个诗人刚刚来过吧，那个和风雅二字搭不上一点关系的酒鬼诗人！你这里…唔，被他诱骗着灌了酒，话也说不清了么…你等一下，我去沏一壶「醒神茶」，只需三个时辰便好。你等一下…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于凝光…",
      "text": "即便每日经手的事务千条万缕，她仍不失进取之心，实属难得。让我想起，彼时的她赤着脚从瑶光滩走到南码头，一路叫卖货品的样子。时间对于常人，真是残酷…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于胡桃…",
      "text": "当代堂主？嗯…那孩子，我应付不来。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于达达利亚·沉着",
      "text": "那位来自至冬的武人，还没离开璃月吗？没关系，要是他找你麻烦，你可以唤我去应付他。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于达达利亚·酒桌",
      "text": "听说「公子」最近在愚人众的风评又变糟了不少。但像他这样的人，一定会用积极的行动去扫清那些对他的怨言吧。嗯…这样想来，下回酒桌上又有不少趣事可以听了。旅者，你也一起来吗？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于甘雨…",
      "text": "璃月这个国度的繁荣，靠得绝不仅是「岩王帝君」的神谕，而是无数响应「契约」的岩神子民。在这之中，甘雨已是就职时间最长的一位了。关于她的往事…我怕她怪罪，让她自己和你说吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于刻晴…",
      "text": "她是当代七星中最「不敬神」的，但我还挺欣赏这样的人。「觉得自己是正确的，就大声地说出来、坚决地去行动」——就是因为璃月有这样的人，我才会考虑退休一事。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于烟绯…",
      "text": "她未曾与我签订「契约」，却在以自己的方式维护璃月各界的规矩，并将有失偏颇的观念纠正。倘若某天，她的父亲远游归来，想来会比我更欣慰吧。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于巴尔…",
      "text": "时间会淬炼一切意志。而她，恰好是会为信念付出所有的人。或许正因如此，她才能走到这一步。如有机会，我也想见识一下她为之倾尽一切的「永恒」。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于布耶尔…",
      "text": "智慧之神布耶尔，不仅统管整个须弥，还肩负着守护世界树的职责。若非有大智慧，的确难以司掌这些。拯救世界树一事，整个提瓦特的生灵都理应向她致谢。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "与「自我」签订下拯救国家的契约，并严守五百年，最终骗过了天理…我尊敬一切需要自我践行的「正义」。即便神性的部分已经消散，神座不复存在，但对于整个枫丹的历史来说，芙宁娜依旧是值得被认可的正义之神。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于闲云…",
      "text": "我听不少商人聊起过「闲云」的逸闻。说是这位女子看似倨傲，不喜言谈，交谈一番却发现她性格耿直，作风正派，是位值得结交的良友。我为她高兴。但「出手阔绰」这条评价，嗯，也有不少人对我说过…"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于赫布里穆…",
      "text": "纳塔将悠久的抗争历史谱写成诗，激励无数战士前仆后继，由此得以跨越深渊与宿命的威胁，创造出新的未来。而率领他们的，是一位将时间与历史化作武器的人类战士，她足以与神明比肩的实力，令人叹服。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于白马仙人…",
      "text": "白马，白马…这位仙人，其实也是我许久未见的一位故人。只可叹，春夜短，秋日速，隙过驹，风过烛。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解钟离·其一",
      "text": "怎么，难得闲暇，不好好休息却反来找我。是想听我讲故事吗？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解钟离·其二",
      "text": "「黑岩厂」的起源，听说过吗？\\n在过去，人们一边将天衡山中的矿脉挖空，一边在里面修建工场设施，渐渐建成了东大陆最大的工厂。山中黯道四通八达，一些甚至能通往大地深处的古遗迹。能掌握其中一切通路的人，如今大概没有了吧。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解钟离·其三",
      "text": "「海灯节」的起源，听说过吗？\\n在很久以前的战争中，璃月人会在夜里放飞明亮的灯，让厮杀的战士不迷失回家的方向，不迷失自己的心。这种事情，如今大概已经没有人记得了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解钟离·其四",
      "text": "「契约之神」的事情，听说过吗？\\n他的记性很好。每位对手的名字，璃港船局建成以来制造的每一艘船起航的日子，都不曾忘却。毕竟，有这样的记忆力，才能铭记一切「契约」。\\n然而，记性很好有时是令人不快的事。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解钟离·其五",
      "text": "活得太久的人，只能在记忆中寻访往昔的战友、过去的景色。\\n即使如此我也不后悔与你相识，「朋友」。假使有一日不得不同你相别，你在我的记忆中也会如黄金般闪耀。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "钟离的爱好…",
      "text": "得闲时在城内散步，就能让我心安不少。嗯…这种心情，是从何时开始…？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "钟离的烦恼…",
      "text": "让人们遵循「契约」，依照契约的规矩行事，其实是希望人们能遵循「公平」。只是这一点，总有人意识不到。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "很久以前，与朋友共饮的酒。是因为气候变了吗？唉，过去的滋味，或许再也不能重现了吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我不喜欢海鲜。仅仅是看到海鲜，就会想到那种…该怎么说呢，滑溜溜的触感，洗不净的腥味。哦，原因的话…\\n唉，说来话长，就当是因为我记性太好了吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "用料讲究，做法地道。属实不易。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "烹饪是一件饶有趣味的事，想来对你而言也是如此。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "既有闲暇，不如找一处庭院，和你说一段故事吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐。这是曾在你出生的那天盛开的，「琉璃百合」的干花。\\n很久以前的璃月人会说，这种花承载着大地中的美好记忆与祈愿而盛开。我愿意相信，你的诞生也是同样的道理。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "力量似乎渐渐回来了。不多，但有用。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "力量增长了，身体的负担随之剧增…哦，我没事，我的构造不同常人，请不用担心。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "原来如此，驱动「神之眼」驾驭元素力，对于常人而言不啻伟业。哦，原来如此…那时的他们，是抱着这样的觉悟站在我身旁啊…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "不曾料想，放下「神之心」后，还能看到这种景色——感谢你，「朋友」...对了，我这里有一份新的「契约」，不一起来看看么？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "壁立千仞。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "震天撼地。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "靡坚不摧。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "俱收并蓄。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "安如磐石。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "固若金汤。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "天理长驱。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "此乃天道。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "天动万象。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "遗珠弃璧，吉光片裘…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "偶遇之物，亦有风雅。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "不虚此行。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "你的实力我姑且认可。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "哈，有点意思。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不太擅长危机应对啊。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不可贸然进攻。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "下去休息。这里交给我。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "啊，略感疲惫…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "让你看到，难堪的一面了啊。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "磐石…也会归于尘土…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "大意了吗。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "不足为惧。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "也好。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "就当是散心了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "做些什么好呢…"
    }
  ]
}