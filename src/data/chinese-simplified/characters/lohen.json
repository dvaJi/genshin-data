  "outfits": [
    {
      "id": 212900,
      "name": "霜铸之锐",
      "description": "洛恩的装扮款式。比起冒险者时期的装束，骑士的甲胄显然庄重了许多。但于洛恩而言，变化的不过是装备的重量，旁人的目光，不变的却是克敌制胜的锐意，与一往无前的执念。",
      "isDefault": true,
      "characterName": "洛恩",
      "characterId": 10000129,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Lohen_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "初次见面，我是第五小队的现任副队长洛恩。如果有任何需要西风骑士团协助的事务，请直接前往骑士团求助。如果需要我个人帮忙，那我们还得好好商量一下。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·副队长",
      "text": "想要成为队长，光有「队长级」的实力可不够。更重要的是…呵，我也不知道，不然我已经成队长了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·风的归处",
      "text": "呼…果然还是待在蒙德城最舒服，等一会再去喝点苹果酿好了…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·人际关系",
      "text": "我在骑士团和大家的关系怎么样？嗯…至少，大家对我印象都挺深的，这样也还不错。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "雨势不小啊，不知道又有多少东西被它冲刷殆尽了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "雨过天晴，权当之前那场雨从未发生。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的时候…",
      "text": "雷声可以盖过许多东西，但绝对盖不住你自己的心跳。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候…",
      "text": "我十分热爱猫尾酒馆…尤其是在这种天气下。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起风的时候…",
      "text": "起风了，可惜我手头没有蒲公英，不然撕点纸吧，感觉也差不多。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "我非常怀念果酒湖。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好。今天要忙什么？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午饭吃过了？行啊，下午还有事要做呢。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今天晚上…嗯，给队员们来一趟「袭营训练」吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安，记得早点休息。无论你怎么熬夜，明天都会到来的。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于洛恩自己·痛觉留存",
      "text": "在平时治疗时，我尽量不使用麻醉类药物，一是这种东西会影响战斗，二是…呵，从某种角度来说，我还挺愿意在战斗之后仔细感受「痛觉」的，毕竟这证明我活了下来，而我的敌人，则什么都感受不到了。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于洛恩自己·力量与借口",
      "text": "对于某些人来说，「力量」是一个很好用的借口，只要用上了它，任何失败和挫折都能找到原因，任何不安和恐惧都能寻见源头…或许，有一个明确的目标，确实能够给人们一种怪异的安全感吧。就算…这种「安全感」的背后，隐藏着更为恐怖和巨大的影子。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·战斗方式",
      "text": "我的战斗方式？哈哈哈哈哈，找到领头的，和他好好打一场，尽可能快地分出胜负，就这么简单。我的队友们应该都已经习惯了。当然了，不习惯也没用。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·职责所在",
      "text": "如你所见，我已经是副队长了，希奥多那个傻瓜也正在承受他该受的惩罚。不过在我看来，他的才能还能派上一些用场，等他赎完了罪，我还想把他捞回第五小队呢，但副官是做不了了，他就做个普通队员吧。不过，想要彻底相信他——还有我——都为时尚早。\\n你相信我，也有那个相信我的「实力」？哈哈哈哈哈，不愧是「荣誉骑士」，和传闻中一样可靠。不然你直接来做我们「第五小队」的队长吧，法尔伽肯定会答应的。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "在执行任务的时候，这枚「神之眼」的确派上了不少用场。可惜，它只能用来剿灭有形的魔兽，不能抚平无形的创害。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "我不喝酒，酒对我来说唯一的作用就是给伤口消毒。特别是晨曦酒庄的陈年蒲公英酒，消毒的效果和痛觉都很明显，而且在消毒的同时，我还能顺便欣赏一下我的同僚们——特别是法尔伽——抽搐的眼角，哈哈哈哈——"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "我之前一直对蒲公英过敏，听砂糖说有一种「脱敏疗法」之后，我就买了许多蒲公英放在屋里，每隔一段时间就去主动吸入一点，以此来治疗我的过敏症状。结果怎么样？反正我现在遇见蒲公英已经不打喷嚏了。但我不得不说，打喷嚏打到头晕目眩的感觉，还是不可多得的。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于法尔伽·药物耐受",
      "text": "法尔伽对于药物的抗性越来越高了，前几天我调配的药物居然只是让他红了红脸，要不是他瞪了我一眼，我都要怀疑自己究竟下没下药了。唉，要是还在挪德卡莱的话，我都想要给他掺点那种带月矩力的植物了…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于法尔伽·团长职责",
      "text": "团长的职责？就法尔伽而言，基本上是带人出去打架吧。剩下的都被他甩给琴团长了，哈哈哈，毕竟敌人真的会被消灭，但文书工作真的没有终结啊。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于琴…",
      "text": "正是因为有这位勤勉的代理团长坐镇蒙德城，「大团长」才能在挪德卡莱放手施为，现在他回到了蒙德城…好吧，他也会继续放手施为，情况好像没有什么改变。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于凯亚…",
      "text": "凯亚很擅长模仿其他骑士小队队长的签名，特别是琴团长的签名，他伪造得堪称天衣无缝，几乎没有破绽。他练习这个的目的？凯亚说，这是为了自己给自己批假，我相信他，毕竟以他的品格，应该也做不出来更过分的事了…呵呵。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于安柏…",
      "text": "听安柏说，她和琴团长商量好了，过段时间会有些不叫「侦察骑士」的侦察员来给她帮忙，可喜可贺啊，她总算不用一个人在蒙德城上空来回飞了。不过这么一想，飞行执照考试的条例和考纲是不是也很陈旧了，不然，也一起更新了吧？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于迪卢克…",
      "text": "迪卢克老爷，还是应该说迪卢克「前辈」。从某个角度上来说，我们俩都被同一个混账坑害得不轻，现在新仇旧恨都已经清算完毕，他还不考虑回西风骑士团？就算不能做最年轻的队长了，也能做资历最老的队员啊。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于诺艾尔…",
      "text": "诺艾尔还没有成为正式骑士啊，都过了这么长时间，我还以为她肯定通过骑士试炼了呢…不知道法尔伽在想什么，难道要给诺艾尔准备一个超级大试炼？那她的骑士称号到底要多厉害，才能配得上她的训练时长啊…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于优菈…",
      "text": "我对优菈最深的印象，就是她那双靴子踢踏地板的声音，只要她脚步急一点，我隔着一层楼都能听见咚咚咚的声音，既响亮又有穿透力，就和优菈的剑术一样，印象深得根本忘不掉。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "第五小队所用的军备消耗品是第八小队和阿贝多一块开发的，弩箭、弹药和各类炼金产品的质量都很不错，我偶尔也会去拜访他的办公室，顺便委托他做些新的武器研究。不过，最近和我对接的人换成了砂糖，阿贝多应该是又去忙其他研究了吧…"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于可莉…",
      "text": "法尔伽之前和我说，他觉得那位愚人众执行官「队长」用蜡笔都能戳爆遗迹守卫，所以呢，我用好吃的和可莉换了一盒子蜡笔，准备带给法尔伽，到时候如果遇见了魔物，正好让他亲手试一试。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于米卡…",
      "text": "米卡很擅长测绘，而我很擅长测谎。之前，他给我的测绘图上专门掩盖了魔物聚集点，就怕我一个人冲过去。而我只是看了看他的表情，就知道这张图上哪里的魔物最多。可惜啊米卡，沉默也没用。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解洛恩·其一",
      "text": "抱歉啊，我没有什么阴暗深沉的「有趣秘密」。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解洛恩·其二",
      "text": "虽然平时用长枪比较多，但我好歹也是第五小队的人，弩箭和铳枪的练习也是没落下的。至于准度…反正我打蓬蓬果和史莱姆挺准的，基本算是抬手就能中的程度吧。我听说稻妻有一种叫做飘浮灵的东西很难打？有意思，下次拿它试试手吧。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解洛恩·其三",
      "text": "第五小队？只是一支普通的远程支援队伍而已，没什么值得说的。虽说我们的火力还算过得去，但要是对上某些…过于特殊的敌人，我们最多就只能在旁边做做掩护了。就像是跟随法尔伽阻击猎月人那次一样，到最后，主攻完全变成了大团长，我们都被命令散去周围阻击狂猎…只有这样，我们才不会被卷入他和猎月人的战斗里。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解洛恩·其四",
      "text": "为什么我坚持用长枪？那是因为…战场上最好的诱饵，当然是看起来像是队伍主官的人啊，有我吸引住敌人，其他队员只要尽情开火就好。至于危险的敌人…哈哈哈，越是紧张，我越是能集中精神，那种极致的专注感非常美妙…可惜啊，离开挪德卡莱之后，能让我放手一战的地方太少了。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解洛恩·其五",
      "text": "和敌人展开贴身战的时候害不害怕？怎么说呢，我觉得敌人那边应该「更」害怕吧。我出枪的速度是不会慢的。再说了，我背后还有医疗骑士等着呢…敌人也有怎么办？嗯，那我就只能尽可能抢先干掉对面的医疗人员了。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "洛恩的爱好…",
      "text": "除了上战场厮杀，我平时的最大爱好，就是给我亲爱队友们的平淡生活，添上几分「惊喜」，这也算是日常训练的一环，骑士可得时时刻刻提高警惕啊。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "洛恩的烦恼…",
      "text": "驻扎荆夫港的好日子结束了，回到蒙德城，琴团长可没有大团长那么好说话了，唉，就不能再给我派一点外勤任务吗？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我比较喜欢吃辣一点的东西。平时在外面执勤的时候，也喜欢嚼点晒干的绝云椒提神…「那叫绝云椒椒」？谢谢，我只说一个「椒」字就好。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "别喝酒，好吗？在挪德卡莱驻扎的时候，我总是被那些喝多了的骑士们吵醒…这帮人喝到最后，已经不知道自己在喝什么了，就算我把酒换成了…呃，算了，没什么。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "谢谢，很合我口味。这道菜好吃到…我都有点怀疑，你是不是偷偷调查过我了。没事的，我也调查过你，我们两清了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "我之前学习如何在饭菜里下毒的时候，基本上也是做到不会让任何人起疑的程度…你已经下毒了？噢，我对毒药的耐性很高，让我再吃点。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "…这么直白的陷阱，我就…不主动往里面跳了。下次还是换我来做菜吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "今天是你生日，拿着这把微型手弩吧，是我自己琢磨出来的，应该刚好能戴在你的手腕上…我什么时候量的尺寸？目测的，我可是第五小队副队长，相信我的目测能力。哦对了，这把手弩还能反向发射，以防有人背后偷袭嘛，只要摁这里…哈哈哈，别躲嘛，这柄手弩的安全锁还扣着呢，难道我看起来，像是那种送朋友手弩，然后看着他摁动发射扳机，把弩箭戳到自己身上的人吗？"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感觉不错，武器都使得更顺手了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "好像能看得更远了…下次出枪的时候，应该能更准一些了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "头脑更清醒了，哈，突然想到了一个训练的新方法。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "看来，以我现在的实力，应该足够做个「副队长」了？"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "开战了！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "发抖吧。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "一个不留！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "出奇制胜。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "时机正好。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "哼。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "吵吵嚷嚷…待宰羔羊。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "挣扎——也没用！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "哈哈哈，你不会安息的。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "收获颇丰啊，来吧，看看里面装了什么。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "好像不太值钱啊…不过，反正是白捡的，拿上吧。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "嗯，没有陷阱，也没有剧毒烟雾…没劲。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "感觉不错…继续！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "…还没完呢！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "正好当我的对手！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "实力不足，就退后！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "让我尝尝！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "我的…局限…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "不…尽兴…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "风啊…告诉…我…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "小伎俩。"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "一点感觉也没有。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "实力不错啊…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "呵…！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "走吧，活动活动。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "打头阵？行。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "这次我来殿后。"
    }
  ]
}