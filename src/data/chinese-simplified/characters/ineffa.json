  "passives": [
    {
      "id": "overclocking_circuit",
      "name": "频率超限回路",
      "description": "若<b><span style=\"color:#FFD780FF\">「薇尔琪塔」</span></b>附近存在月感电反应产生的雷暴云，薇尔琪塔进行放电攻击时，将额外进行一次攻击，造成相当于伊涅芙攻击力65%的<span style=\"color:#FFACFFFF\">雷元素范围伤害</span>，该伤害视为月感电反应造成的伤害。",
      "level": 1
    },
    {
      "id": "panoramic_permutation_protocol",
      "name": "全相重构协议",
      "description": "施放元素爆发<color=#FFD780FF><b>至高律令·全域扫灭</b></color>时，将为队伍中自己的所有角色赋予「参数重构」效果：基于伊涅芙攻击力的6%，提升伊涅芙与队伍中自己当前场上角色的元素精通，持续20秒。",
      "level": 4
    },
    {
      "id": "moonsign_benediction_assemblage_hub",
      "name": "月兆祝赐·象拟中继",
      "description": "队伍中的角色触发感电反应时，将转为触发月感电反应，且基于伊涅芙的攻击力，提升月感电反应的基础伤害：每100点攻击力都将提升0.7%基础伤害，至多通过这种方式提升14%伤害。<br/><br/>此外，伊涅芙在队伍中时，队伍的<span style=\"color:#FFD780FF\">月兆</span>将会上升一级。",
      "level": 0
    },
    {
      "id": "flavor_synthesis_unit",
      "name": "美味合成单元",
      "description": "伊涅芙使用食物时，有30%概率获得一个调味剂食材。<br/><br/>此外，在挪德卡莱，似乎可以通过某种途径来改变薇尔琪塔的外观…",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1161,
      "id": "rectifying_processor",
      "name": "循环整流引擎",
      "description": "伊涅芙展开光流屏障护盾时，将为队伍中附近的所有角色赋予持续20秒的「载流复合」效果，使月感电反应造成的伤害提升，提升值基于伊涅芙的攻击力：每100点攻击力都将提升2.5%伤害，至多通过这种方式提升50%伤害。",
      "level": 1
    },
    {
      "_id": 1162,
      "id": "support_cleaning_module",
      "name": "辅助清理模块",
      "description": "元素爆发<color=#FFD780FF><b>至高律令·全域扫灭</b></color>命中敌人后，将为其中一名敌人施加「惩戒敕谕」状态：短暂间隔后，或该敌人被击败时，将对其周围的敌人造成相当于伊涅芙攻击力300%的<span style=\"color:#FFACFFFF\">雷元素范围伤害</span>，该伤害视为月感电反应造成的伤害。<br/>此外，施放元素爆发<span style=\"color:#FFD780FF\">至高律令·全域扫灭</span>时，也会为附近的当前场上角色赋予光流屏障护盾。",
      "level": 2
    },
    {
