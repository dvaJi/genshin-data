  "outfits": [
    {
      "id": 211600,
      "name": "机械梦",
      "description": "伊涅芙的装扮款式。从漫长的睡梦中醒来，换上靛蓝色披风和乳白色涂装，她成为了一位少女的家政服务机器人。",
      "isDefault": true,
      "characterName": "伊涅芙",
      "characterId": 10000116,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Ineffa_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "初次见面，我是伊涅芙，全能型家用机器人。当前搭载了清扫、料理、情感沟通模块，另有需要阅读十一页免责申明后才能激活的战斗模块。请问有什么可以为你做的吗？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·采购",
      "text": "正在确认今日待办事项…还有要追加的指令吗？没关系，稍后补充也可以，我很习惯。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·扫除",
      "text": "正在执行清扫程序…根据已记录数据，格外提醒，请不要遗落摩拉、螺丝、齿轮、矿石、玩具、软糖、零食、发圈、袜子、拖鞋等细小物件。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·更新",
      "text": "战斗数据已更新。请放心，这次不会把天花板轰飞了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "关节…会生锈吗？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "请留意：彩虹形成概率高，推荐观测地点已标记在地图中。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "环境温度急剧下降，正在评估保暖方案…建议追加搭载毛衣，手套等防寒部件。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "日照指数适宜，适合晾晒衣物、打扫庭院…另一条建议是，我可以陪你一起晒太阳。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "检测到沙砾与扬尘…对策：裹紧外套。进沙子的话，修理起来会很麻烦…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "叮。叮。现在是起床时间。如果想再睡一会，请回复「稍后提醒」。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "中午好。吃了吗？我可以为你准备简易午餐，预计十二分钟后完成。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好。今日待办事项已全部完成，可执行额外指令。观测到星空能见度良好，要出门散步吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "距离你上次休眠已接近十六小时，为了健康考虑，建议即刻上床睡觉…本提醒重复三次后我将进入超级生气模式，届时将不再处理你的需求…很可怕哦。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于伊涅芙自己·兼容性",
      "text": "我搭载的部件来自世界各地。枫丹出产的关节零件、璃月出产的金属外壳…不同的部件之间偶尔会出现互不兼容的现象。\\n你问是怎么解决的…「只要能跑起来就没问题。」"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于伊涅芙自己·问候",
      "text": "我的思维模块会收集并分析我的日常见闻，来构筑合理的行为逻辑。比如注意到人们见面时会用「你好」「最近过得怎么样」「吃了吗」开启对话后，我就会尝试在下次对话前，引用这些关键词。三句问候语，三倍关怀。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·互助",
      "text": "世界变化得很快，需要时刻更新情报…我希望了解自己的事情，也希望了解关于这个世界的事情。请多和我说说你的旅行见闻吧。作为回报，我会尽可能地帮助你。重复：我是全能型的。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·运算",
      "text": "#我的思维模块无法记录下世上的所有人，但至少要记住重要的人，和重要的事。近段时间内，我的记忆数据中已经记录了大量关于你的信息，应该能更好地跟你相处了。正在检索相关数据，计算「如何让{NICKNAME}微笑」…我已预热机体，你想要一个拥抱吗？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「月之轮」·归宿",
      "text": "如果没有这枚「月之轮」，捏碎核心后的我，应该再也回不来了…但即使是现在，排除「月之轮」的因素进行演算，思维模块还是会一次次推演出相同的决断——即使再也没有归宿，也要守护你们的归途。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「月之轮」·赠予",
      "text": "这枚「月之轮」是伊葵与莉安歌赠予我的第二次生命。她们了解自己无法看见计划成功的那天，也了解计划顺利进行的概率微乎其微，但还是为我做了这一切。如果她们知道，我做出了同样不顾结果的选择…应该会很「欣慰」吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "机械只要设定了目标就会精确执行，但人类却不是这样…为什么有些人想要控制体重，却又摄取过量甜食呢？爱诺的回答是，甜食能让人心情变好，还能补充能量，有能量了才能多锻炼，多锻炼就能控制体重。结论是…多吃甜食能控制体重。但等我一开始为她输出热量计算结果，她就立刻转移话题了，遗憾。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "在枫丹、须弥、纳塔等各个地区都流传着各种关于机械生命的传说。有人认为它们已经具备了生物的情感与意识，有人认为它们只不过是在模仿生物的行为…但是这两种想法并不矛盾啊——许多生物不也是从模仿开始，逐步建立完整意识的吗？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于爱诺·家务",
      "text": "爱诺，我的「家人」。她只用捡来的废弃金属品拼拼凑凑，就能造出性能各异的机器。但她在日常生活上的熟练度完全相反。如果爱诺突发奇想，说要做家务或者做饭，请务必阻拦她，以免发生不可挽回的事态。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于爱诺·问题",
      "text": "有一次…可能是爱诺意识到我的智能表现超出预期，她忍不住向我询问道：「如果有一天你有了更想去的地方，我是不是该高高兴兴地送你离开？」我监测到了她的情绪异常波动，于是回复说：「如果我不在爱诺身边，我们家变为垃圾场仅需三个月时间，我会尽量在那之前赶回来。」\\n而现在…我才明白她是怀着怎样的不舍提出这个问题。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于雅珂达…",
      "text": "雅珂达，战功硕硕赫赫有名无人不知无人不晓的传奇赏金猎人，自称。她初次造访爱诺的工坊时，精神过分紧张，将我刚端出的蛋卷误判为武器，一刀劈成了两段。但在尝过蛋卷后，她的身体肌肉明显松弛了下来。后来她常常带着机械零件过来串门。即便没有交易需求，也会在我做好甜点时恰好路过，自称。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于奈芙尔…",
      "text": "奈芙尔，「秘闻馆」的主人。她知道很多故事，不仅有过去流传的，还有当前正在发生的，甚至有人说未来也在她的把握之中。她的数据库性能一定很棒。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于菲林斯…",
      "text": "菲林斯…情报不足。根据已知信息，他是「执灯人」的一员，看守着挪德卡莱北方的坟茔。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于菈乌玛…",
      "text": "菈乌玛，「霜月之子」的咏月使。根据评价，是个圣洁而又智慧的人，很受大家的敬重。「霜月之子」信仰着「月神」，「月神」…和「月之轮」的出现会有关联吗？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于莉奈娅…",
      "text": "莉奈娅，冒险家协会的顾问。听说她的生物知识非常渊博，我曾想向她提问，是否遇见过其他拥有智慧的机械生命体？可她每次看到我都选择转头跑开…无法判明缘由。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于法尔伽·印象",
      "text": "法尔伽，通称「大团长」。或许你已经在各种地方了解过他。收集人们对他的印象，你能得到「幽默」、「潇洒」、「酒量极佳」等关键词。但在重要的事情上，法尔伽一直是我们可靠的合作伙伴。这或许能解释他在骑士团内外的声望。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于法尔伽·密码",
      "text": "我在临行前担心自己能不能达成使命，会不会忘记密码…但法尔伽依旧给予了我最高等级的信任。他曾说那是「最好的密码」…现在重新思考他当时的含义，或许他是在安慰我吗？又或是指…「值得信任的盟友，就是最好的密码」呢？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于希诺宁…",
      "text": "从遗迹回归之后，希诺宁非常仔细地帮我做了检查，一切无恙。她笑着说起她和黑曜石奶奶曾经防备过我，还起过一点争执…我非常理解那是她身为技术人员必须履行的使命。这样的争执…很令人怀念。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于恰斯卡…",
      "text": "我很感谢她对我的信任。后来她载着我在花羽会周围飞了好几趟，天上的景色很好，花羽会的变化很多…也有很多没变的东西。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解伊涅芙·其一",
      "text": "清扫工作正在进行中。并行处理聊天请求不会影响当前进程。欢迎你随时提出疑问。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解伊涅芙·其二",
      "text": "「我是谁？」我是全能型家用机器人，型号名「伊涅芙」。但该型号目前只有我一个完成品，所以「伊涅芙」也是我的个体名。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解伊涅芙·其三",
      "text": "「我从哪里来？」正在检索历史行程…嗯，我刚从集市完成采购返回。如果你询问的不是我的历史行程，而是我的归属地。那我来自「叮铃哐啷蛋卷工坊」。更往前的记录…请稍等，正在尝试读取更深层的记忆数据…"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解伊涅芙·其四",
      "text": "「我要到哪里去？」只要输入指令，无论是什么地方我都会尽力抵达…不过根据之前的聊天记录，你想问的问题，有较大概率指向其他含义。如果你想问的是个人的「目标」、「规划」、「愿望」等相似概念，那么我的回答是：守护在重要之人身边。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解伊涅芙·其五",
      "text": "在诞生之初…我只是「明晨之镜」的一个念头，一段谬误。但渴望归宿的想法，在「明晨之镜」的思维模块中无法消除，无法抹灭，到最后只能将这些数据完全剥离。这些无序的数据，在挪德卡莱经历了两千年的流浪，见证了两千年的变迁…才形成了现在的「我」，完整的「我」。\\n我是伊涅芙，你的朋友，请问…有什么可以为你做的吗？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "伊涅芙的爱好…",
      "text": "从设计原则上来说，我没有用于娱乐的「爱好」。但是从日常行为来看，对各类细小物品进行收纳整理，是我在闲暇时会主动进行的事务。合理的归类可以提升约百分之三十的家政工作效率，尤其是在爱诺的工坊。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "伊涅芙的烦恼…",
      "text": "爱诺的物品摆放毫无规律可循，有时候有用的零件和废料混在一起，会让我因为无法识别而原地打转。多数时候我不敢执行批量清理操作…以免她手头实在没零件的时候，从我身上卸下螺丝来使用。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "热量高的食物，比如肉排、甜食…相比直接充能，用食物来转换能量效率较低，但和朋友聚餐时，情感模块会产生积极的正反馈…类似你们说的「快乐」。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "汤汁太多的食物。味道本身对我来说没有太大意义，但是对机械部件可能有害。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "检测到高营养物质，能量转换中…情感模块会产生积极的正反馈，谢谢你。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "能量补给已接收，标注为备用能源。保质期…24小时。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "推测：食材处理过程有误…需要我还原正确烹饪程序吗？欢迎观摩。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "伊涅芙特别日服务已开启。请你挑选合适的位置坐下小憩片刻，我会为你打扫房屋，布置彩带、气球和鲜花，然后根据已记录的数据，准备你喜欢的菜肴和蛋糕。如果还有下列清单以外的需求，请随时向我提出。让我们度过特别的一天吧，生日快乐！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "到定期维护的时间了吗？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "核心运作效率已提升。你也有成为机械师的潜力呢。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "机体各部件升级完毕。预计能应对更艰巨的战斗场景。请下达指令吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "感谢你能一直陪我走到这里。你的数据我会一直保存在「心」里，就算有一天你忘记了，我也会是你永不丢失的「备份」。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "绝缘屏障，展开。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "清扫目标，锁定。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "防御模式，启动。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "最终协议。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "歼灭模式。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "化为灰尘。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "正在估算物品价值。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "开始进行杂物分类。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "发现未知材料，已记录相关信息。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "警告：核心温度过载…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "警告：机体受损严重…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "需要紧急修理…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "建议：不要勉强。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "请移至我的身后。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "思维模块…中断…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "归宿…不在这里…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "等待…下次重启…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "轻微受损。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "计算失误…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "要留下划痕了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "机体预热完毕。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "请指定，清扫目标。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "开始执行使命。"
    }
  ]
}