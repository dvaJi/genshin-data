  "outfits": [
    {
      "id": 205500,
      "name": "百狩之义铠",
      "description": "五郎的装扮款式。为使神射将军五郎御弓灵便而打造的轻铠，肩头与肘部护有甲片，便于控弦。",
      "isDefault": true,
      "characterName": "五郎",
      "characterId": 10000055,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Gorou_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "海祇岛反抗军大将，五郎，前来助阵！早就听说过你的威名了，我将与你齐驱并进，一同攻夺胜利！哈哈，怎么样，我刚刚这句话的气势，还不错吧？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·军略",
      "text": "枕戈坐甲，才能应对变数。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·训练",
      "text": "难得没有战事，来场体能训练吧！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·体格",
      "text": "魁梧的体格是力量的象征，对鼓舞士气也很有帮助。我得再加把劲啊！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "尾巴湿了…找堆篝火烤一烤吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "有敌情吗！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "好冷…这种天气不适合露天活动啊…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "晒太阳虽好，士气却不能松懈啊。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "顺风进攻，我方占优。逆风作战，也不必畏惧！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "晨练时间到了，要和我一起去登山吗？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "午饭就吃鲜鱼炖萝卜和白米饭吧。这种搭配在反抗军中很流行，推荐你也试一试。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上也不能怠懈，要让眼睛充分适应黑暗。毕竟，黑灯瞎火的地方，也有可能变成战场。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "累了吗？那就安心休息吧。待在这里放哨的任务就交给我了！保证你回来的时候，一切都跟现在一模一样。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于五郎自己·大哥",
      "text": "「五郎大哥」？你是从哪里听到的啊！唉…实不相瞒。平时，我和将士们的交流都很密切，有什么好东西也都大家一起分享。他们敬重我，私底下就大哥大哥地叫了起来。可实际上，他们的年纪都比我大啊…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于五郎自己·建议",
      "text": "大概因为我总是打胜仗吧，总感觉将士们把我想象成了特别厉害的人，哪怕是小事也会来问我的建议。他们的眼神让我没法拒绝，但我的计策也有限…只能讲些大道理，或是凭直觉给出答案了。唉，会不会对不起他们呢…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·倾诉",
      "text": "有什么烦恼，千万不要埋在心里，来和我说说吧。虽然我不是什么事情都在行，但我一定会尽力为你出谋划策的。就算…就算答案不够可靠，至少我也是你忠实的听众。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·同食同寝",
      "text": "一起训练，一起吃饭，一起休息…方便随时交流，还能增进我们之间的默契。到了关键时刻，一个眼神就能传递重要的信息…欸？这样不合适吗？唔…我和其他兄弟都是这样熟悉起来的啊。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」为我的战斗提供了许多帮助，让我能在战场上承担更多责任，为战友们开辟道路。但我也明白，个人的力量再强，都没法左右战争的胜负。大家齐心协力才是关键。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·轻装上阵",
      "text": "轻装上阵正是我的风格。我擅长灵活游走，寻找战机。我的箭矢会优先对准敌方最强的将士，挫伤对方的锐气。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什么想要分享·常胜将军",
      "text": "将士们给我取了个绰号，叫「常胜的尖耳将军」，还有些奇怪的传闻，说是「摸到五郎大哥的耳朵，就能获得常胜将军的好运」。唔…摸是绝对不行的！他们笑得再开心也不行！欸？你也想摸？喂，喂…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "听说璃月有着高耸入云的群山，真想亲眼去看看，再尽情攀登一番。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于北斗…",
      "text": "北斗船长重视情义、身手不凡，令人尊敬。她曾说不愿把同伴卷入纷争，我们也理解这一点。因此，只有到了必要的时候，才会请她来帮忙。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于枫原万叶…",
      "text": "我见过形形色色的浮浪人，万叶绝对是他们之中最特殊的一位。他就像一缕风，不会在任何地方停留，但总能给身边人带来些什么。和他并肩战斗期间，我就从他身上学会了几分「洒脱」。总之，我和万叶相当合拍！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于珊瑚宫心海·职责",
      "text": "珊瑚宫大人作为海祇岛最高领袖，负责掌控大局，制定计划。我负责将细节落实，把控前线的形势。反抗军上下一心，只求胜利。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于珊瑚宫心海·态度",
      "text": "我对珊瑚宫大人抱有崇高的敬意。珊瑚宫大人神机妙算，没有她的谋略和统筹，反抗军不可能取得如今的战果。只不过，私底下她似乎更偏好安静的生活。没有军事要务的话，我不会主动打搅她。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于雷电将军…",
      "text": "雷电将军…不论理由如何，我无法认同她以前的做法。现在，海祇岛与幕府签订了和平条约，但我绝不会放松警惕。假如冲突再次爆发，我必定会重返前线。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于九条裟罗…",
      "text": "我对幕府军没有好感，但九条裟罗，也许是幕府军里最正直的一位将领了。我们之间进行过数次较量，各有胜负。我曾不成熟地想过，要是这样的人能够重视民众的愿望，不受幕府掌控就好了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于八重神子…",
      "text": "那个女人…我们可以不聊她吗？我来帮你干活，什么杂活都没有问题…呜…就当是为了我的身心健康着想，我们还是换个话题吧？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于神里绫华…",
      "text": "社奉行从属于幕府，但立场更倾向于民众。在这种两面为难的处境下，「白鹭公主」还能站稳脚跟，应该是特别冷静，又能把握做事分寸的人吧。这一点值得我学习。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于早柚…",
      "text": "我军情报显示，那位忍者精通潜入之法，也许她的忍术能够在珊瑚宫大人的某些奇策中发挥作用…不过，情报里又说很难掌握她的行踪，看来不好招募啊…欸？你说她是社奉行的人？…呃，那还是算了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于鹿野院平藏…",
      "text": "你说那个鬼鬼祟祟，游手好闲的侦探先生？毕竟是来自幕府的家伙，没办法完全信任，我会继续盯紧他的。说起来，他倒是有那么点探案的功夫。至于这是不是什么阴谋诡计…嗯，就得用时间来证明了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解五郎·其一",
      "text": "毕竟我大多时间都在战场上，我的故事，可能不算很有趣…但如果你想听的话，我就慢慢和你说，想到什么说什么。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解五郎·其二",
      "text": "我没有令人敬畏的智谋，只有一双手和一条命。也许我的手足够有力，命足够硬吧，这么多年来，经历了不知多少场恶战，都成功活了下来。有人说，只要跟着我，不管遇上多绝望的战局，都能平安无事。就这样，不知不觉，我得到了大家的认可，成为了将领。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解五郎·其三",
      "text": "最初，我们的敌人是流寇、海贼和魔物，但后来，雷电将军颁布了「眼狩令」。气焰嚣张的幕府军来到了我们的面前，被我们迎头痛击。哈哈，大概他们也没想到，会遭受如此激烈的抵抗吧。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解五郎·其四",
      "text": "珊瑚宫大人曾经说过，我有个致命的弱点，战斗的时候太过忘我，只顾着深入敌阵。她说勇猛是好事，但对于统率一军的将领而言，这样并不称职。我…努力在改进这一点！你…能够在我身边，监督我吗？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解五郎·其五",
      "text": "我需要抗争到底的对象，并非特定的团体或阵营，而是一种「恶意」。这种「恶意」曾践踏大家的愿望，破坏大家平静的生活，肆意伤害大家…彻底消除它们后，我就能安心放下武器了。等那时候，我就换上便服，和你在海祇岛上随意地散步吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "五郎的爱好…",
      "text": "我喜欢登山，越险峻的山越好。登山能锤炼我的肉体和精神，让我变得更强壮。还有，和同伴一起登山。在挥洒汗水后共同欣赏山间的美景，也是人生一大乐趣。不过，我不敢…不想攀爬稻妻的最高峰…"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "五郎的烦恼…",
      "text": "轻装上阵也有不方便的时候，比如，一旦遇上火攻，我的尾巴就要格外小心。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我喜欢蛋糕和三彩团子！嗯…大概是因为我很少吃到这类精致的点心吧。军营里的饭菜强调简便快捷，通常也不会用到太多调味料，至于糖，就更是珍贵物资了。甜味…我无法拒绝！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "大部分食物我都不忌口，可洋葱是个例外。有一次，后勤兵往饭菜里加了洋葱末，让我在饭桌上痛哭流涕…啊，那次实在太丢人了！弄得后勤兵也很过意不去。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "这种甜味，完全无法抵抗！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "哦！心中气势大增！有什么需要我帮忙的吗！"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "比想象中的还要辛辣…呜，我…我有些力不从心了。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "今天是你的生日，是意义重大的一天，请允许我来为你庆祝吧。我们在海边生一堆篝火，抓来最新鲜的鱼和螃蟹，我想给你亲手做一顿大将级别的「士气晚餐」！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "强大的力量，是为了保护同伴。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "要保护同伴，不能只是被动防守，必须积极进攻。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "攻夺胜利的要领，是牢记战斗的意义，遵循正确的战法，拿出锐不可当的气势。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "有了锐不可当的气势，与战友们紧密配合，方可无往不胜。谢谢你的指点！这是属于你我二人共同的胜利。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "进军！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "强攻！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "结阵！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "随我出征！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "势如破竹！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "兵贵先声！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "今日运势不错！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "和同伴们一起分享收获吧！"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "这个宝箱…埋伏了我？"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "随我来。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我还能战斗！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "大意了！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "没到认输的时候！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "按甲休兵！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "不要乱了阵脚！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "兵败了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "海祇岛的…大家…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "全军…撤退…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "不痛不痒！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其一",
      "text": "再来！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "整装待发！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "准备进军！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "行兵列阵！"
    }
  ]
}