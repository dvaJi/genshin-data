  "outfits": [
    {
      "id": 207500,
      "name": "寂忿空相",
      "description": "{REALNAME[ID(1)]}的装扮款式。修验之人的常服，斗笠可以为雨中的流浪人留下一隅驻足之地，对心中肆虐的风啸雷鸣，却无能为力。",
      "isDefault": true,
      "characterName": "流浪者",
      "characterId": 10000075,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Wanderer_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "要我报上名来？此行世间，我名号诸多，虽然随便一个对凡人来说都高不可及，但于我都已成过往。\\n想称呼什么就随你吧，让我见识下你的品味，可别让我失望。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·风",
      "text": "这世上没有纯粹的自由。风也会有吹到头的时候。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·说话方式",
      "text": "我说话刻薄吗？只是实话实说罢了，接受不了的人才该自己反思原因。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·寒暄",
      "text": "寒暄就免了吧，没话找话的样子也太可笑了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "想用我的斗笠遮雨？亏你提得出这种要求。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "见了点阳光就能高兴成这个样子？幼稚。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的时候…",
      "text": "啧…烦心。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候…",
      "text": "明明和雨没什么区别，却讨人喜欢多了…真是人各有命。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "这点程度，你都能做到吧？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "「快醒醒——太阳要晒屁股咯——」…哈，你不会以为我会这么叫你起床吧？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "我不需要吃饭。管好你自己和身边的小东西，就算是让我省心了。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "终于，无聊的一天就要结束了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "在我身边睡不着吗？呵呵。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "#关于{REALNAME[ID(1)]}自己·人偶",
      "text": "烧掉一个人偶会留下灰烬。至于灰烬中会诞生什么…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "#关于{REALNAME[ID(1)]}自己·心",
      "text": "那种东西随便了。执着于注定不属于自己的事物只是在浪费时间，现在的我有更重要的事情要做。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·对手",
      "text": "对你我以前的对峙耿耿于怀？哦。所以呢，你要怎么做？慢慢想，我不急。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·同伙",
      "text": "我不可能皈依「正义」，但既然说过要偿还你的恩情，就定会做到。\\n倒是你，在和我接触的时候可能需要想想自己立场哦？万一被人撞见，说你与罪人「狼狈为奸」，我可概不负责。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "所谓「神明的注视」令人不爽，但反正是可用的力量，我不挑。你觉得「风元素」有其深意？呵，为什么会这么想？神明行事蛮横又无理，我不是让你领教过吗？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "没有。你想问什么就问吧，我看心情回答。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "看啊，鸟雀会炫耀羽毛，松鼠忙着囤积食物，人类为了柴米油盐整日奔走。头脑简单的生物活得就是比较容易呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于小吉祥草王…",
      "text": "她选择不除掉我，或许不只是因为我有利用价值。也许是因为她很贤明，又有至善之心，又或许，是她在我身上看到了孤独的影子…你说我是在恶意揣测？哈，这不是当然的事情嘛！我又不是什么好人。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于雷电将军…",
      "text": "对自己的造物视若不见，却又美其名曰不忍心干预…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于「女皇」…",
      "text": "人人都称赞她的温柔与慈爱，却不知「爱」也是「罪」的一种。搞不好是代偿心理作祟哦？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于「丑角」…",
      "text": "「丑角」是坎瑞亚的遗民——除此之外，我对他知之甚少，也从未与他有过什么密切的交流。但他似乎对我意有所求，以前给我指派过不少重要的任务，包括前往「深渊」。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于「队长」…",
      "text": "「刚正不阿的『队长』」、「正直果敢的『队长』」、「战功累累的『队长』」…这些愚人众里流传的言论，就算是人偶的耳朵也要听出茧子来了。你不觉得，绝对的「正直」，其实是个极其危险的隐患吗？更不用提，「队长」拥有顶尖的实力。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于「博士」…",
      "text": "真遗憾，小吉祥草王让他消除了那么多的切片，剥夺了我将他一片一片千刀万剐的快乐。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于「少女」…",
      "text": "试问：当遇到一名「无论何时」都懵懂无知，「无论做什么」都麻木平淡的「少女」时，该作何反应？我的话，尚可一战；你的话…因为太有良知，还是离她远些吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于「仆人」…",
      "text": "道貌岸然的伪君子。她对人展露「优雅」与「亲切」都只是为了更好地「控制」罢了。而直面过她疯狂一面的人，大多已经…呼~。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于「公鸡」…",
      "text": "也就是「公子」才会觉得「公鸡」是真心实意、不求回报地关心他和他的家人。虽然那位市长大人确实做了不少实事，但稍微有点脑子的人都能看出来，这里的潜台词是「你的家人都在我掌控之中」吧？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于「木偶」…",
      "text": "她除了自己的研究以外什么都不关心，性格恶劣得很。但即便做到如此极端的地步，却也只是制造了大量废品，在我仍是执行官时还低我一席，真是可怜。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于「富人」…",
      "text": "那个第九席啊，他对「公平交易」过分偏执，甚至试图推翻神与人之间天生的不平等。不过凡人就是这样，容易有不切实际的妄想，倒也没什么特别的，就像他平庸的能力和眼光一样——选择和「博士」密切合作，哼，是不会有好下场的。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于「公子」…",
      "text": "头脑简单，四肢也不甚发达。让他做最后一席都是在拉低执行官的整体水准。万幸，我已经不在其列了。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于「女士」…",
      "text": "她的灰烬里什么都没有。我对失去未来的人不感兴趣。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于八重神子…",
      "text": "油腔滑调的妖怪，为博神明的青睐，将自己伪装成关心人类的样子。其实，只是为了找乐子吧？"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于枫原万叶…",
      "text": "你说枫原家的后人？那岂不是…哦？他也有风元素的「神之眼」，还扛下过雷电将军的一刀？呵呵…哈哈哈哈哈哈哈哈！"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "关于赛索斯…",
      "text": "你为什么觉得我会认识他？就因为他经常追在我后面吵着要看我的帽子吗？我们没怎么说过话，第一次见面他就问我是不是叫阿帽，这又何尝不是以貌取人？哼，阿帽，这个名字倒是流传开了…"
    },
    {
      "id": "4017",
      "type": 1,
      "title": "关于杜林…",
      "text": "那个家伙刚从书里出来时就已经带了一堆问题了，没想到成为人类之后，问题更多。每次都把信写那么长，字还歪歪扭扭的看都看不清楚，啧。\\n你要是闲得慌，倒是可以去给他解答解答。免得他走上什么歪路。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "#想要了解{REALNAME[ID(1)]}·其一",
      "text": "真稀奇，竟然想了解我。会招来麻烦哦？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "#想要了解{REALNAME[ID(1)]}·其二",
      "text": "啊，一定有很多、很多人想要找我清算前尘。无所谓，我来者不拒——或者说，还挺期待的呢。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "#想要了解{REALNAME[ID(1)]}·其三",
      "text": "我曾以为成神便可摒弃无用的情感，现在不这么觉得了。至少「愤怒」，无论来自他人还是自我，都是方便使用的工具。\\n怎么会有人永远不生气呢？难以想象，这种人就没有一点脾气吗？"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "#想要了解{REALNAME[ID(1)]}·其四",
      "text": "在进入世界树时，我心中只有一个念头：希望自己从未来到这个世上。\\n世界树回应了这个愿望，却没有带来我期盼的结果。这片土地的命运在捉弄它的囚徒方面一如往常。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "#想要了解{REALNAME[ID(1)]}·其五",
      "text": "你我有过交点，但终有一天会去往不同的地方。谁知道以后会发生什么呢？走着瞧吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}的爱好…",
      "text": "爱好？那是闲人才有空琢磨的东西吧，我看起来像是没事做吗？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "#{REALNAME[ID(1)]}的烦恼…",
      "text": "在想怎么才能把你甩掉，去胡作非为一番。——开玩笑的，你信了？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "有茶吗？越苦越好，回味无穷。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "腻腻歪歪的甜东西，牙齿都要被黏在一起了。你自己留着吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "还行吧，算是你为数不多的优点了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "不错，至少做出了能入口的食物。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "想害我？难不成你笨到忘了我非凡胎？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "把手给我。…呵，别紧张啊，只是带你去高处看看而已。\\n如何？应当是非凡的景色。感谢就免了，谢来谢去的没意思。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "…看得出来，你尽力了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "风吹过来了…你做了什么？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "给我力量，你不担心后果吗？…好吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "虽说我可以成为你的助力，但将我视作同伴仍是件危险的事情，希望你清楚自己在面对什么。若你不畏惧，便站到我身后吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "风起！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "俯瞰凡尘！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "怒风腾天！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "不度蝼蚁！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "鼠雀之辈！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "叫大声点！"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "元素爆发·其四",
      "text": "把头低下！"
    },
    {
      "id": "200005",
      "type": 2,
      "title": "元素爆发·其五",
      "text": "毫无自知之明！"
    },
    {
      "id": "200006",
      "type": 2,
      "title": "元素爆发·其六",
      "text": "就凭你，也配直视我？"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "风驰！"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "冲刺开始·其二",
      "text": "疾风随行！"
    },
    {
      "id": "700004",
      "type": 2,
      "title": "冲刺开始·其三",
      "text": "…真慢。"
    },
    {
      "id": "700005",
      "type": 2,
      "title": "冲刺开始·其四",
      "text": "没叫你跟着。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "多余。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "啊？这你也要？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "你自己拿着玩吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "习惯了。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不值一提。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "要你何用！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "也没指望你派上用场。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "坠入…深渊…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "皆为…徒劳…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "罪业的报偿…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "不过如此。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "…可笑。"
    },
    {
      "id": "910003",
      "type": 2,
      "title": "重受击·其三",
      "text": "…你死定了。"
    },
    {
      "id": "910004",
      "type": 2,
      "title": "重受击·其四",
      "text": "等着求饶吧。"
    },
    {
      "id": "910005",
      "type": 2,
      "title": "重受击·其五",
      "text": "做好付出代价的准备。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "没想到…叫我做什么？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "你最好有要事相求。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "非我不可？…行吧，勉为其难。"
    }
  ]
}