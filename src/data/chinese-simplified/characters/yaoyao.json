      "filename_sideIcon": "UI_AvatarIcon_Side_YaoyaoCostumeWinter"
    },
    {
      "id": 207700,
      "name": "栗蕊木樨花",
      "description": "瑶瑶的装扮款式。父母为瑶瑶缝制的小小短袄，和师父赠予的仙铃一道，伴随她在轻策庄与璃月港之间安全往返。",
      "isDefault": true,
      "characterName": "瑶瑶",
      "characterId": 10000077,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Yaoyao_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "初次见面，我是瑶瑶，忝列门墙，师从歌尘浪市真君。出门在外，若有不便…请叫上我！瑶瑶有礼了。对了，我这里有炸萝卜丸子，吃一点吧！但是不可以多吃哦，油腻的东西吃多了对身体的负担会增加的。如果没吃饱，我还带了洗干净的萝卜和醋，可以给你凉拌萝卜丝吃。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·大道理",
      "text": "「明日复明日，明日何其多…」总之，快快行动起来吧。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·凑热闹",
      "text": "那边好像有什么动静，偷偷看一眼的话，应该没事吧！"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·寻仙问道",
      "text": "真奇怪，为什么总有人想寻仙问道呢？仙人不是到处都是吗？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "你听，青蛙的叫声，像不像在给雨声伴奏？呱呱呱。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "呜、呜哇！我、我帮你捂住耳朵，害怕的话就抓紧我的手。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "下——雪——啦——！你先穿上毛茸茸的外套，戴上厚厚的帽子和围巾，喏，别忘了还有手套，我们再去堆雪人吧。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "天气很好呢，我们去璃月港的码头逛逛吧。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "小心哦，别被风吹走啦。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "该起床啦，我已经准备好早饭了，你动作快些…欸、欸？回笼觉吗？那好吧，只能再多睡五分钟哦！五分钟后我再来叫你~哎，早知道就该提醒你早点睡…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "你要记住哦~吃完午饭后，不要立刻躺下午睡，也不能马上动身冒险，这些都对消化不好。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "欸？晚上还要出门吗？唔…什么时候才能回来呀？天色已晚，小心为上哦~"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "睡前故事…上回和你…说、说到哪里来着…璃月自古时起…便有三眼五显仙人守护，其、其中…呼呼…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于瑶瑶自己·璃月码头",
      "text": "你知道吗？璃月港的码头，总是人声鼎沸，可热闹了！和我家那种静到叶子掉在地上都能听见的感觉完全不一样呢！所以，我一有空就爱跑去码头看看。新来的船，新鲜的见闻…还有新玩具！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于瑶瑶自己·吃饱穿暖",
      "text": "所谓「仓廪实则知礼节，衣食足则知荣辱」，所以说，出门在外，要好好吃饭，衣裳穿暖…呃、欸？这句话不是这样的意思吗？那是什么意思呢？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·练枪",
      "text": "不是我偷懒，是枪太长，又很重，练枪真的挺辛苦的…好在师父对我的要求不高，嘿嘿。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·牵肠挂肚",
      "text": "最近有按时吃饭吗？天冷了，有好好添衣裳吗？冒险的时候有没有遇到危险？有没有受伤？哎呀算了，要不你还是带上我吧，草行露宿，我实在有点放心不下你。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "师父是三眼五显仙人！但她告诉过我，神之眼代表着神明的认可。可我也没有做什么特别的呀？真想和神明大人聊聊天，听听她的想法呢！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "奥赛尔？说的是海里的那个超级大的云来大章鱼吗？啊！我不是想吃，只是…如果想吃的话一定记得要烤熟了再吃…呀！不一定非要烤，只是…只是我觉得烤着会很好吃…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "我喜欢小团雀哦，去找七七玩的时候，经常能在路上见到。我还会和它们打招呼呢！啾啾啾♪～哎呀，被你猜对了，真聪明！确实是早早早的意思哦。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于香菱…",
      "text": "师姐她最近…没有去找什么奇怪的食材吧？上次她说要生吃云来大章鱼，可让我担心坏了，要是吃坏了肚子可怎么办呀？她又不喜欢吃白先生的苦药。我求了师父一起劝住了她，可不要又看上另一种危险的食材了…哎…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于七七·好朋友",
      "text": "七七是我最好的朋友！她有时候会忘记我，但我知道她不是故意的，只要提醒她看一下笔记，她马上就能想起来。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于七七·一辈子",
      "text": "其实我也悄悄问过白先生，有没有办法治好她…嗯…没关系的，就算要提醒她一辈子，我也没关系的。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于白术…",
      "text": "白先生开的方子可有效啦。虽然苦是有点苦，但这就是所谓的「良药苦口」吧！我理解的！哎呀，你怕苦吗？别担心，我这边有蜜枣，喝完药吃一颗就好了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于甘雨…",
      "text": "甘雨姐姐的工作一直很多，听说上次她还因为劳累，不小心趴在草地上睡着了，哎，让人担心！要不…我们进行一个「突击检查」！过去看看她有没有好好照顾自己吧？啊…稍等我一下，我去准备些甘雨姐姐喜欢吃的花花草草…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于刻晴…",
      "text": "刻晴姐姐为人细心，做事周全。逢年过节总会来问候师父，这就是所谓的「尊师重道」吧？还是说「知文达礼」比较合适？…总之，我也要向刻晴姐姐学习！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于云堇…",
      "text": "云堇姐姐呀，她舞枪舞得可好啦，她表演的璃月戏也非常受欢迎，师父偶尔也会带我去看哦。只要有云堇姐姐登台，场面必是座无虚席，门不停宾…但、但…她唱的是什么意思呀？"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于北斗…",
      "text": "北斗姐姐的船，好气派~要不是我和甘雨姐姐约好了不往船上跑，我连要在哪里搭个小小的床铺都想好了。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于申鹤…",
      "text": "申鹤姐姐远离世俗多年，这次好不容易回到了璃月港，难免有很多不适应的地方。我也想帮着甘雨姐姐一起照顾她…可我要怎么开口，才不会让她觉得不自在呢？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于烟绯…",
      "text": "烟绯姐姐有一本厚厚的法典，就连休假来探望师父的时候，都随身带着呢，真厉害呀~能一直拿着这么重的东西，还要读这么难懂的东西…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于闲云…",
      "text": "那天我去找师父的时候，见到师父在和一位很有气质的姐姐聊天。她自称「闲云」，还想逗逗我呢，但我一眼就看出来她是留云阿姨啦！毕竟，看师父那高兴的样子，没有半点生分，分明是见到了一位老友嘛！"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于布伦妮…",
      "text": "上次她拿着书坐在树下，没一会儿就睡着了。她睡觉的时候，眉头皱得紧紧的，好像在梦里还在跟谁吵架一样。师父说过，每个人都有不想让人看到的软弱之处。作为朋友，只要在她累的时候，给她一个肩膀依靠就足够了。所以我挨着她坐下了，她睡得很香哦。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解瑶瑶·其一",
      "text": "瑶瑶的出身吗？我父母隐居于山郊，唔，按道理来说，我应该算是轻策庄人吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解瑶瑶·其二",
      "text": "我家靠种植珍贵药草为生，家父家母忙碌的时候经常会忘记做家务，甚至连吃饭都会忘记…哎，这样怎么行呀！我得照顾好他们。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解瑶瑶·其三",
      "text": "我从小在山间长大，花草树木，还有小动物们都是我的朋友哦！对了，你想和小团雀聊聊天吗？我可以带你去，也可以帮你传话。来吧，很有趣的~我们先去准备点米粒给它们当做礼物！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解瑶瑶·其四",
      "text": "璃月到处都是仙人，我遇到过好多位呢！留云阿姨，理水叔叔…我最喜欢的就是留云阿姨啦！她送了我好多好玩的仙家物什，还细致地教我用法，让瑶瑶受益匪浅呢！"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解瑶瑶·其五",
      "text": "遇见师父之后，她说我有仙缘，收我做了弟子。其实我至今还不懂仙缘到底是什么呀？但能在大家身边热热闹闹的，听师父讲故事，和师姐一起偷懒…还有帮上璃月港大家的忙，我非常知足！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "瑶瑶的爱好…",
      "text": "常言道，良宵苦短，胜事难逢！如果有什么好玩的事情，一定要过去看看才行呀…说不定还能遇上瑶瑶能帮上忙的事，你说对吧？"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "瑶瑶的烦恼…",
      "text": "哎、哎呀，练枪真的有点枯燥…我就和月桂玩一小会儿，休息一会儿就接着再练…"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "轻策农家菜、来来菜、水煮鱼…这些璃月地道的味道不仅好吃，还能让人感到热闹。嗯？你也喜欢吗？太好了，那下次来我家吃饭吧，我来露一手！别担心，我帮师姐打过下手，在烹饪上也算「师出名门」呢！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "有次申鹤姐姐一顿清心吃多了，身体虚了好几天呢！瑶瑶要爱惜身体，不生吃清心。唔？你问我怎么知道的？是留云阿姨跟我说起的哦！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "太好吃啦！这厨艺简直和师姐「难舍难分」？不对，好像是「不相上下」！嘿嘿，瑶瑶一时激动，「口不择言」了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "好吃！下次做饭记得喊上我哦，让我帮你打下手吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "…哎，你平时吃的都是这些吗？要不然还是让我来给你做饭吧！吃得不好怎么能出门冒险呢，要是累到了自己、身体垮了怎么办呀…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "今日是你的生辰，按照习俗，这样的日子要来一碗长寿面，我找师姐学了一手，一整条面都没有断哦！还打了个很圆很圆的鸡蛋进去，嘿嘿。快跟我来吧，要趁热吃才好。新的一岁，愿你身体健健康康，生活圆圆满满。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "咦？枪怎么变轻了？要是能再变短点就更好了…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "哇哇，我现在说不定都能拿起师姐的枪了！真想现在就把这个好消息告诉师父~"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "平时听大家说的「勤以立身」，就是这种感觉吧？欸？这个「勤」…不是勤奋的意思吗？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "原来被人挂念的感觉是这样的，嗯…我能有这样的成长与变化，都是你的功劳哦！所谓投之以桃，报之以李，你放心吧，我会护你安然无虞的！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "月桂！该上咯。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "不要乱动哦！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "不怕不怕。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "预备…跑！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "痛痛飞。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "要冲喽，月桂！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "都收好，不要落下哦！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "都整理好啦，请拿好。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "哇！这些够用好几天了吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不行不行…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我要撑下去…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "没事，我可以的…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "让瑶瑶保护你！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "人命关天，不要勉强！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "没办法再照顾大家了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "有辱…师门…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "枪好重…头也好重…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "痛痛。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其一",
      "text": "好痛好痛…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "我会照顾好大家的。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "我来领路，跟我走吧！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "我在，不用担心。"
    }
  ]
}