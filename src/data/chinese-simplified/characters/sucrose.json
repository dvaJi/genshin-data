  "outfits": [
    {
      "id": 204300,
      "name": "萌生的灵风",
      "description": "砂糖的装扮款式。带有砂糖个人特色的西风骑士团炼金术士制服。",
      "isDefault": true,
      "characterName": "砂糖",
      "characterId": 10000043,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sucrose_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是砂糖，炼金术的…研究员。听说你去过很多地方，一定也…不，没什么，第一次见面，不该这么麻烦你。但…如果你愿意，和我讲讲路上有意思的事，那个…我，会很开心的。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·好奇",
      "text": "那是什么？啊…不见了，我可以去看看吗！"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·整理",
      "text": "趁现在，赶快整理一下研究笔记…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·深呼吸",
      "text": "嗯——！好久没出来透气了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "刮大风了…",
      "text": "今天城里的风车，转得好快。欸，你说，如果在小动物背上，也装一个像风车一样的东西，会让它们跑得更快呢，还是会飞起来呢？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "这么大的雪，一年都没有几次，错过了，想研究就要等明年了，所以就别拦我啦。啊…阿嚏！呃…我知道了，我多穿一点…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "天…天已经亮了？！那、那再做最后一次实验吧，做完就休息！嗯，最后一次…"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "下雨的时候…",
      "text": "湿度上升，嗯…要不要再加一组实验呢？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好，昨晚睡得还好吗？研究表明，只有睡眠充足，第二天的精神才会好，而且，脑袋的运转也会更高效哦。欸…什么？我总是熬夜？那个…唔，没办法嘛。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "呜哇！别、别过来！啊…不是，我的意思是，不要靠得太近，我在做实验，这个…可能会爆炸的。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好，啊…请稍等一下！「实验体玖零伍式」的光照分泌物其实有两种，为了明确区分，就叫「壹零叁叁式」和「壹零叁伍式」…嗯，好了，请问有什么事情要找我吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "不用等我，先去休息吧。唔…有这么不放心吗？实验已经在收尾了，不会熬夜的，真的…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于砂糖自己·「生物炼金」",
      "text": "「生物炼金」，比起「创造」，更注重「改造」，找到生物隐藏起来的优点，然后放大，结合，结果往往都让人大吃一惊。嗯…生命真的是太神奇了，究竟还有多少我们不知道的东西呢？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于砂糖自己·怕生",
      "text": "我…其实我不知道怎么和陌生人说话。每个人性格都不一样，在意的东西也不一样，一不小心就会不够礼貌，或者哪里冒犯了，唉…说话真的好难啊，比炼金术什么的难多了。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于砂糖自己·耳朵",
      "text": "你…你注意到了啊。我的耳朵是家里遗传下来的，和其他人很不一样，所以平时我都会用头发尽量把它们藏起来…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于我们·观察",
      "text": "我对你的经历，特别好奇，所以…我可以「观察」你一段时间吗？我会很安静的，不会打扰你，这样…你会介意吗？"
    },
    {
      "id": "2006",
      "type": 1,
      "title": "关于我们·收获",
      "text": "老实说，一开始我看你不怎么说话，有点害怕…还以为是在哪里冒犯了你，后来时间长了才慢慢发现，原来，你还是挺好相处的。嘿嘿，这也算…「观察」的意外收获吧。"
    },
    {
      "id": "2007",
      "type": 1,
      "title": "关于我们·请求",
      "text": "听说，是你赶走了风魔龙？战斗一定特别危险吧，幸好你没事。那个…有件小事，风魔龙它在战斗的时候，有没有，掉下来什么东西呢？鳞也好，皮也好，一点点就可以，我想，研究一下…"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "「神之眼」，是我最重要的实验器材。欸？就、就是实验器材啊，没有了「神之眼」，很多跟元素相关的实验，就没办法进行了。你说战斗？啊…偶尔吧，去野外找材料的时候，偶尔会用到。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "这个房间里，都是我收藏的骨头。放在左边柜子里的，有蜥蜴，青蛙，还有草鱼，挂在前面的是野猪，右边角落里的那个，是丘丘人…啊，别紧张，不用害怕，其实都是很可爱的东西，习惯了就好了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "你看，种在这里的冰雾花，其实每一朵都不一样。这一朵冰元素含量更高，这一朵花期更长…嗯？你问那一朵，哦，那一朵叫「叁式冰雾花改十七号放大版」，特点，嗯…就是更大一点。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于诺艾尔…",
      "text": "她…经常会主动帮我的忙，但有时候太热情了，反而…让我有点苦恼。有一次，她看到我实验室门前堆了三箱器材，就很麻利地帮我搬了进来，但其实…那些都是我刚刚搬出去的。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于可莉…",
      "text": "她已经被琴团长关过好多次禁闭了，但只要被放出来，不久就又会闯祸，唉，不知道有没有真的反省过。啊…我答应她，要帮她做一个会蹦会跳，又很安全的蹦蹦，只不过现在，设计上还有不少问题…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于琴…",
      "text": "我有点不敢和琴团长说话，因为她太严肃了…我知道她是个很好的人，但、但知道归知道，害怕…还是会害怕。我一般都不会去打扰她，实在有不得不找她的事，我…我也会拜托阿贝多先生。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于丽莎…",
      "text": "我觉得她，好像懂的特别多。她明明没有看过我的研究，但有好几次，都给了我最关键的建议。她到底是怎么知道的呢？是…观察？还是推理呢？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于凯亚…",
      "text": "唔…我知道他喜欢开玩笑，也没有存心捉弄我的意思。可是，我实在是…分不清他的哪句话是真话，哪句话又是玩笑，所以最后要不然就变得很尴尬，要不然，就是我出洋相…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于阿贝多·艺术",
      "text": "当他的助手，每天都能学到很多。重点不是知识，而是「天才」的思考方法，无论是多么复杂的问题，他总能抽丝剥茧，再一一解决。在我看来，那就是艺术…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于阿贝多·天赋",
      "text": "你说天赋？嗯…假如和他做同样的研究，可能确实一辈子都没法超过他。但，我研究「生物炼金」并没有故意要躲开他的意思，只是…嗯，我和他恰好有不同的爱好，还有梦想，仅此而已吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于安柏…",
      "text": "我很好奇，为什么她做的布偶，名字叫「兔兔伯爵」呢？和兔子没什么关系吧。唔…你说，头上的发带，很像兔耳朵？…有道理，但其实这是刻板印象，也有很多兔子耳朵是垂下来的。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于菲谢尔…",
      "text": "你是说《菲谢尔皇女夜谭》？我知道，作者创造出的世界很有意思，要是能亲眼去看一看就好了…欸？你在说那个「菲谢尔」啊？她啊…嗯，她…应该是没办法带我去的。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于优菈…",
      "text": "游击骑士的工作很危险，优菈小姐的行动又格外大胆，所以我给她制作了一个侦察装置，这样她就不用潜入敌人的营地了。但优菈小姐的气势太吓人，我有点怕她，告诉她使用方法的时候，不小心漏掉了几条注意事项，结果真的发生了意外…\\n怎么办？我会不会被她记仇了…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解砂糖·其一",
      "text": "了解我？你…是对「生物炼金」感兴趣吗？你有疑问的话，我会尽量给你准确答案的。嗯？不是炼金，而是「我」？唔，这个，我也不知道该说什么…"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解砂糖·其二",
      "text": "研究的本质，是寻找答案的过程。这个过程有时候很繁琐，也很累，但每次只要看看积累起来的成果，就会觉得…嗯，我是真的很喜欢做这样的事。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解砂糖·其三",
      "text": "小时候，我有两个好朋友，我们无话不说。本来我以为，我对她们了解得一清二楚，但后来发生了一些事，我突然就…看不透她们了。她们现在在哪儿，在做什么，还记不记得我，这些…我都不知道。就算再好的朋友，也会变成这样呢。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解砂糖·其四",
      "text": "告诉你一个小秘密，我对谁都没有讲过。「生物炼金」的最终目标，是创造出「仙境」…对，就是童话里的那个，能找到永远的快乐与幸福的「仙境」。嘿嘿，有点幼稚对吧？但，我现在都还相信那个故事。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解砂糖·其五",
      "text": "嗯…如果你忙的话，就去忙吧，我不想给你添麻烦。不忙？真的不忙吗？没事的，就算忙也没关系，一个人做实验我早就习惯了。啊…真、真的不忙？那…那可不可以，帮帮我的忙？或者…只是陪我说说话，什么的…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "砂糖的爱好…",
      "text": "我喜欢看起来很规则的东西，你看，书架上每一本实验记录，厚度都是一样的，实验台上的几百瓶药水，都是按功效与颜色分别排好…欸？…欸欸？！为什么这瓶紫色的药水会出现在这里！我、我要全部整理一遍！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "砂糖的烦恼…",
      "text": "我想知道，你平时休息的时候，会干些什么呢？每到休息日，我就找不到事情做，只能发呆…明明做实验的时候时间过得很快，休息的时候，怎么就有种度日如年的感觉…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我会提炼出甜甜花的花蜜，做成糖块。脑袋转不动的时候吃一块，就又可以集中精神了。做研究，糖分的补充是很重要的。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "知道了很多「生物炼金」的知识之后，我就不怎么吃蘑菇了…你应该知道吧？蘑菇，是长在死掉的生物上的，联想到同类的其他东西，我、我的胃口就…呃…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好吃！啊…趁着现在状态最好，赶紧把研究做完…"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "比我做的营养餐好吃了不少。嗯，我也算改善伙食了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "对不起。我对这道菜，还是有点…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐！我做了好几个月的实验，终于，可以把这个药水送给你了。它能唤醒你这一年来最美好的回忆，名字叫做「生物秘药叁玖壹陆号」…唔，不是「叁壹玖陆号」，是「叁玖壹陆号」啦！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "「生物炼金」的研究，终于有突破了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "这次旅行，我又收集到了很多研究材料，谢谢你，我会好好利用的。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "最近我在做实验的时候，经常会莫名地期待起来，什么时候又可以和你一起去冒险。唔…好奇怪，这是为什么呢？我要研究看看。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我收集到的研究材料，已经很足够了！花更多时间在我的身上，会…会很浪费的！至少…也让我用「生物炼金」，做点什么回礼给你！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "吸附力测试。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "陆叁零捌式风单元！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "确认…安全距离！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "超扩散态！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "柒伍式超级风模块！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "无相之风…拟造！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "宝箱的出现成因…也值得研究。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "真希望实验材料也能成箱出现啊。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "太好了，有这么多素材！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "这种误差，还能接受…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "有点，超出预想…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "不痛不痛，不痛的…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "快回来，我这里有药水！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "小心点，看准了再上！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "研究…又失败了。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "还需要…调整。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "该…睡一会儿了。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "不应该啊…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "眼镜会碎掉的！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "希望能帮上忙…"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "我、我会努力的！"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "实验…一定要成功。"
    }
  ]
}