  "outfits": [
    {
      "id": 207800,
      "name": "崇理者",
      "description": "艾尔海森的装扮款式。「别拿没意义的杂事打扰书记官大人了，他戴耳机就是为了应付这种情况。」\n——缄默之殿工作人员的经验之谈。",
      "isDefault": true,
      "characterName": "艾尔海森",
      "characterId": 10000078,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Alhatham_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "我是教令院的书记官艾尔海森。想调阅档案的话，请把你的需求按照正规格式填好申请表后递交。\\n还没整理完？没关系。我的工作时间贴在办公室门外，等下个工作日再来吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·工作",
      "text": "书记官的工作很简单，我就是因此才做了这个职位。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·读书",
      "text": "读书并不会让人变聪明，看看教令院里的那些家伙就知道了。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·思考",
      "text": "嗯…最近乱七八糟的申请表有点多，都驳回吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "雨天出门是最麻烦的。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "没什么可怕的，自然现象而已。除非你往大树下躲。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "很冷吗？我还好。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "这种好天气，最适合什么都不干。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "糟糕，鞋里进沙子了…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "时间还早，我先去喝杯咖啡。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "没什么事的话，我要戴着隔音耳机睡一会儿。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "接下来就是私人时间了。再见。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "希望室友不要半夜敲敲打打做模型…或者他不在家最好。我不想晚上睡觉还得戴着耳机。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于艾尔海森自己·事实",
      "text": "比起辞藻的包装，我更喜欢用事实说话。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于艾尔海森自己·流言",
      "text": "哦？听过不少关于我为人的传言吗？很在意？\\n没必要，因为我也并不在意你相信与否，只要别徒增额外的事端就好。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·打招呼",
      "text": "要是在街上和我打招呼我却没有反应的话，不要见怪。我只是开了耳机隔音而已。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·互助",
      "text": "你是自理能力非常强的人，甚至能兼顾身边的伙伴。我没什么要给你的建议，你应该也不需要我的帮助。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "说实话，草元素「神之眼」对我的研究帮助不大。不过有了元素力后打人倒是更疼了，所以还算有用。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "真理诞生不是为了服务于谁。人类不是知识的载体，知识也不是人类的目的。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "这世上吸引人注意力的东西有很多，不要太相信自己的双眼。如果所见即为真实，人就不需要思考了。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于小吉祥草王…",
      "text": "过于小瞧或敬畏神明都是不可取的。神明需要信徒，同时神明也是生物链中的一环。所以我并不因为参与拯救过神明而自豪，希望小吉祥草王也不必介怀。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于卡维·关怀…",
      "text": "他对所有人和事都抱有过度的关怀心，可能是因为他自己太脆弱了吧，整天大惊小怪的。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于卡维·上当…",
      "text": "有人在路边摆摊，说只要卖出一个手工钥匙扣，就会有一个贫困家庭的孩子吃上饱饭。卡维买了十几个回来。\\n在医疗服务都免费提供的须弥…我不多说了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于提纳里…",
      "text": "好像很多人觉得他脾气不够好，我倒认为有失偏颇。当初卡维把房子建在死域上，搞出很大一个烂摊子，给巡林队添了不少麻烦。即使如此这位巡林官也没有记恨卡维，还愿意请他在家里吃饭…可能就是因为世界上有这样的好人，才能让卡维继续生存下去吧。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于多莉…",
      "text": "她精明又警觉，懂得如何将梦想落实到实际，是能把生活过得很好的聪明人。没有要包庇她的意思，但立场不同并不影响我认可她的生活态度。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于赛诺…",
      "text": "「集群意识」的案件增加了风纪官们的工作量，但我并没有什么心理压力。说到底，该起事件的根本成因并不在我。赛诺应该也是明白人，后来没再为这事找过我。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于妮露…",
      "text": "艺术家的优点和缺点都很明显。妮露在扬长避短方面做得非常好，所以能过得简单又快乐。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于迪希雅…",
      "text": "能力很强的人，留在镀金旅团里有些浪费。要是她能接受我的提议来教令院任职就好了，有这样的帮手，我们的工作也会轻松不少。不过她对安稳的生活不感兴趣，我能理解。可惜了。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解艾尔海森·其一",
      "text": "大部分人都不会主动与我接触，也许是因为忌惮，也许是因为性格不合。对此我很满意。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解艾尔海森·其二",
      "text": "我向来对社交不感兴趣。如你所见，我的生活过得比大部分人舒适，这足够证明社交不是生活的必需品了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解艾尔海森·其三",
      "text": "每个人都应该有自己的主张，并始终保持清醒，不然很容易被各种突发状况绑架，甚至误入歧途。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解艾尔海森·其四",
      "text": "一旦秩序被破坏，其后果会迅速蔓延。我不喜欢这样，会打扰到我现在的生活。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解艾尔海森·其五",
      "text": "下班后我偶尔会去酒馆喝一杯。\\n不是想知道这个？什么，我还以为分享闲暇时间是比分享个人观点更隐私的事情。毕竟，无论谁都可以在留言板上侃侃而谈呢。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "艾尔海森的爱好…",
      "text": "看晦涩难懂的书，欣赏其他人抓耳挠腮的样子。 \\n开玩笑的，别人的痛苦并不会给我带来快乐，我也很少碰到读不懂的书。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "艾尔海森的烦恼…",
      "text": "据我观察，很多人的烦恼都是自找的。生活中已经有不少难处，就别自添烦忧了。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "美味程度高于美观程度的。很简单的要求吧？不然就是本末倒置了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "有汤有水的菜肴很难在看书时吃。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "嗯，可以看出对调味配比的精准把控。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "是流行的味道，我不讨厌。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "不在这吃了。介意我打包回家吗？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐。我总觉得人们在庆祝出生这一天上付出了不必要的热情，不如把这些精力用在让自己生活中的每一天过得更愉快上来得实际。你这方面做得还可以。\\n不知道送什么礼物合适，就给你预留一次申请表的特批通道吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "谢谢。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "原来不是一次性的。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "在奋进这件事上，你比我要热心。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "不能让教令院那些喜欢偷懒的家伙知道我又在进步，否则他们会想方设法把麻烦事推给我。我当然不会接了，但沟通起来总要浪费些时间。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "接好了。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "镜闪。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "哼。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "散射。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "分光。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "理论的推演。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "你自己收好。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "动作快，东西掉远就难捡了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "哦。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "麻烦事。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "计划有变。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "要多花时间了。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我来吧。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "不意外。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "预期之外…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "失策。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "我的误算。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "啧，谁啊。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "呃…行。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "有事？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "公事公办吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "不需要太长时间吧？"
    }
  ]
}