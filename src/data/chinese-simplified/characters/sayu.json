  "outfits": [
    {
      "id": 205300,
      "name": "小貉服",
      "description": "早柚的装扮款式。以神秘生物——「貉」为灵感设计的奇妙装束。",
      "isDefault": true,
      "characterName": "早柚",
      "characterId": 10000053,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sayu_Circle"
    }
  ],
  "voices": [
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "走啦…唔。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "溜咯…啊。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "咕噜，哈！…嘿呀。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "极意遁走。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "抓不住我…呜。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "随风而遁…呜。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "分身之术。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "出来吧！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "嘿咻…呜。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "疾风遁术。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "这个箱子…好像可以睡进去。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "大丰收！可以睡觉了吗？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "是对长高有帮助的东西吗？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "逃跑的话，该用…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "头晕乎乎的。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "呼，好累。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我来掩护。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "先退下休息。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "没能...逃掉..."
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "…晚、晚安了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "不该偷懒的…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "痛。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "没躲开。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "呜，要晕倒了。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "好困。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "可以睡觉吗？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "呜，居然被抓住了。"
    },
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "「终末番」早柚，参上。\\n呼——如果没有什么事情的话，我先去睡觉了。对了，不准趁我睡觉的时候偷偷摸我的头。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·睡着",
      "text": "呼啊…呼噜呼噜——"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·工作",
      "text": "工作还不如睡觉。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·长高",
      "text": "什么时候才能长高呢？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "快躲雨，被雨淋到就长不高了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "好大的动静，不过只要整个人都钻到被子里就能安稳睡觉了。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "雪天很方便躲藏。比如说「雪降之隐」这种忍术，借助飘雪隐去身形，等别人察觉的时候，对方的眼前就只剩下飘落的雪花了。啊，你千万不要把这些告诉巫女姐姐。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "舒舒服服的好天气，啊——好困哦。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "起风的时候…",
      "text": "风起之时，便是开溜的好时机。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "刮大风了…",
      "text": "风吹得眼睛睁不开了，不如就这样，闭起眼睛睡一觉吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "已经…已经早上了吗？再睡10分钟…就10分钟嘛…那、那5分钟也行…呼…"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "好困，午睡时间还没到吗？"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "确认完毕，方圆十里内没有巫女姐姐的踪影。今晚可以睡个好觉啦~"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "终于…可以睡觉了…晚…晚安…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于早柚自己·终末番",
      "text": "我虽然属于「终末番」，但交给我的工作无非就是些情报收集、偷取物品之类的琐事。所以…所以不做也没有什么关系嘛。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于早柚自己·旷工",
      "text": "「终末番」的工作本来就没什么意义嘛，一直拖着不做，就会有更合适的人去做。但是睡觉不一样啊，只要睡得够久，说不定哪天就能长高了，这可是意义非凡的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·帮个忙",
      "text": "如果巫女姐姐来了，记得告诉我一声哦，我稍微睡…啊不，休息会儿。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·摸摸头",
      "text": "摸摸头？唔，如果是你的话...那好吧，我不会咬你的，但是不能摸太久了，否则会长不高的！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "双手剑真的很重，光靠忍术的话，我肯定举不起来。但是有了「神之眼」就不一样了，所以不管怎么说，「神之眼」对我帮助很大。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "老师说我是我们流派最后一代传人了。毕竟也不是什么特别适合战斗的流派，我学的也都是些逃跑和隐蔽气息用的忍术，这也是没办法的事情吧…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "你知道貉吗？一种比狸猫可爱得多的小动物，下次带你一起去看看吧~"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于神里绫华…",
      "text": "神里家的大小姐优雅又端庄，但是她专门任命了一位巫女姐姐来监督我，不让我偷懒…怎会如此…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于神里绫人…",
      "text": "我在树上休息的时候，经常会听到巫女姐姐们在聊他，似乎是一位工作很忙的大人。真是奇怪，工作什么的明明旷掉就好了…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于托马…",
      "text": "明明都有神之眼了，他每次出现还是缠着我说想要学忍术，真是搞不懂。而且我睡觉的时间都不够，哪有时间教他嘛。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于宵宫…",
      "text": "她每次碰到我就说什么，小狸猫我们一起去祭典玩之类的话。我才不是狸猫，也不想去祭典。说是一起去玩，其实就是想着在祭典上让我配合她的烟火表演忍术，但是这和「终末番」的工作有什么关联嘛！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于雷电将军…",
      "text": "那位大人…不是我能见到的人物。想知道更多事情的话，或许问问绫华大小姐比较好。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于八重神子…",
      "text": "她总喜欢摸我的头，可是我不敢咬她，也不敢反抗，总感觉如果拒绝了她会发生很可怕的事情。但是，再这样被摸下去，我会不会真的长不高了？怎么办呀…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于荒泷一斗…",
      "text": "怎么会有这么吵吵嚷嚷的人，而且他还能长这么高！"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于久岐忍…",
      "text": "没什么印象的名字，让我想想…欸？她是荒泷一斗的小弟吗？那肯定也是干扰睡眠的人，毕竟有个词叫做一丘之貉，啊不对，是一丘之狸！"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于绮良良…",
      "text": "有次我午觉睡醒，感觉身后暖和和的，一转头就看见有只猫正蜷着睡觉，关键是有一对毛茸茸的尾巴！吓得我差点从树枝上掉下去。这，这也是变身术吗？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于梦见月瑞希…",
      "text": "奇怪的紫色妖怪…被她盯着的时候，感觉好像要被吃掉一样…唔！惹不起，我还是躲着她走吧！"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于布伦妮…",
      "text": "她送了我一本很厚的书，叫《营养学导论》，她说光睡觉是不够的，还要按照上面的公式吃饭才能长高。但是，她明明懂这么多，我们好像也差不多高嘛…奇怪，难道她不想长高吗？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解早柚·其一",
      "text": "呼——"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解早柚·其二",
      "text": "呃…你是问我忍术流派的名字吗？那个…想不起来了啦，我还没睡醒，我再去睡一觉，睡醒后说不定就能想起来了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解早柚·其三",
      "text": "好吧，告诉你也行。你先答应我不准笑，不然我就再也不理你了。我们流派叫做——呜呼流…\\n说是因为我们流派的忍术以戏弄敌人为长而取的名字，可是，可是…唉。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解早柚·其四",
      "text": "你会爬树吗？我非常擅长这个，可以教你哦。还有，神社那边有棵树特别适合偷…啊不，特别适合小憩。下次你想睡午觉的时候，记得来找我，我们一起爬上去午睡吧。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解早柚·其五",
      "text": "其实这套衣服是老师给我的，说是以貉为原型做的，还有助于我逃跑什么的…然后又说我已经长大了可以独当一面了，但也要保护好自己，说完老师就离开了我。可我这个身高，真的能独当一面吗…\\n唔…欸？你是说你会陪着我吗？你真的不会离开我吗？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "早柚的爱好…",
      "text": "套上衣服上的帽子，不用担心会被巫女姐姐找到，然后睡个天昏地暗，这应该是世界上最幸福的事情了吧。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "早柚的烦恼·误会",
      "text": "很多人第一次见到我的时候，都会大呼小叫，还把我当成狸猫。可早柚就是早柚，才不是狸猫。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "早柚的烦恼·身高",
      "text": "什么时候才能长高呢？跟我同年的人身高都快是我的两倍了，可我还…不行，再睡久一点一定能长高的！我要睡觉了，晚安。"
    },
    {
      "id": "6006",
      "type": 1,
      "title": "早柚的烦恼·死循环",
      "text": "我上次听人说，烦恼太多也会长不高…呜，我该怎么办才好…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "能一下子提供很多能量的食物吧，比如说饭团。睡醒了吃一个就不会头晕眼花，然后又能继续睡觉了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "想要长高的话，就不能挑食！说来最近好像身高也没有变化，是不是因为蔬菜吃少了，但是沙拉真的没有办法提供饱腹感，而且还苦苦的，呜欸——"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "肚子好饱。这下可以安心睡觉啦。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "吃着吃着…就困了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "要想个办法…逃走。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "你有什么想学的忍术吗？我可以教你！当然仅限于我会的。呃？你问我为什么不睡觉？嗯…我还不困，而且，而且今天是特别的日子，我不可以睡过去，因为我想亲口对你说——生日快乐呀。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我有长高一点点吗？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "太好了，能溜得更快了，这下子肯定不会被抓住了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "谢谢你帮我收集了那么多材料，要是我自己来的话…肯定在路上就会睡着了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我好像确实像老师说的那样，可以独当一面了。这样子长不长高或许对我来说也没有那么重要了，因为现在重要的是…有你陪在我身边。"
    }
  ]
}