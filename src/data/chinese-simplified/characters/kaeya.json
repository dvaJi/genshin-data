  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "西风骑士团，凯亚。请让我与你同行吧。比起团里的差事，还是做你的护卫要有趣得多。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·无所事事",
      "text": "没想到你也知道忙里偷闲。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·骑士团",
      "text": "骑士团的战友们已经忙得不可开交了吧，哼哼。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·懒散",
      "text": "逗留够久了吧，再不活动活动筋骨，要长出蘑菇来了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "这雨天里，冰冻的力量会更强吧，有趣。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候·逸闻",
      "text": "呼…趁着这雪天，跟你讲一个鬼故事吧。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候·寒冷",
      "text": "怎么，你怕冷？"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "真是和平啊，可又能持续多久呢？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "享受这一天吧。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "哟，要不要一起去酒馆坐坐。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "你该不会怕黑吧？哦？那我…可找到新素材了。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "这就要走了吗。那就下回见了，别让我等太久啊。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于凯亚自己…",
      "text": "你最近有没有被深渊教团找麻烦？有什么心烦的可以跟我聊聊。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·雇佣关系",
      "text": "需要我的时候就派我上场吧，别谈那些雇佣关系了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·实力",
      "text": "哦？既然这么在意我们之间的雇佣关系，就多使唤我一点吧，老大？哼哼，可别被我的真正实力吓到哦。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "不明白「神之眼」的原理？嗯…我想想，给你打个比方吧。引导视线的器官是眼睛，而引导元素力的器官是「神之眼」。这样就很简单了吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "你喜欢酒吗？蒲公英酒的口感就很特别。什么？还没到喝酒的年纪？呵呵，那试一试蒙德的苹果酿吧，我知道一家还算不错的店。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "你见过龙脊雪山的猫头鹰么？和它对视的时候，它好像看穿了你，而你却完全参不透它…很迷人的家伙，不是吗？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于琴…",
      "text": "哦？代理团长大人，你可要多多支持她。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于丽莎…",
      "text": "丽莎啊…你千万记得要准时还书哦？上次因为这事儿惹她生了气，直到现在我左手的尺骨还是麻麻的。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于安柏…",
      "text": "侦察骑士是个机灵又正义的好骑士。可千万别在她面前做坏事喔。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于迪卢克…",
      "text": "迪卢克？小时候的他挺可爱的。可如今却活在自己的世界里…总之是个无趣的家伙。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于可莉…",
      "text": "可莉，看来还是没有掌握躲避代理团长检查的技巧啊，明明我已经点拨过她…哈哈，我说着玩玩的，你可别去揭发我哦。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "阿贝多啊，沉稳优雅的小帅哥，而且才华横溢，是很讨人喜欢的类型。怎么，你也心动了？"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于迪奥娜…",
      "text": "你也尝过了迪奥娜调的酒？还没到喝酒的年纪呐。哈哈，哎呀，可惜，真是可惜，这种快乐无法跟你共享。呵呵，只能期待你早点长大喽。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于法尔伽…",
      "text": "说来可惜，现在的西风骑士团里，根本没人继承大团长的行事作风。唉…我个人倒还挺欣赏那种的。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于菲谢尔…",
      "text": "什么？你说菲谢尔遮起一只眼睛的神秘样子，的确很符合「断罪皇女」的形象？哈哈哈，按照这个规律，我至少也得是个末代皇族后裔，对吧？"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于诺艾尔…",
      "text": "我受代理团长大人所托，暗中照顾这位后辈。不过她很懂事，不需要我操太多心。真是令人欣慰。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于罗莎莉亚…",
      "text": "啊哈哈，你想知道罗莎莉亚修女的秘密吗？这个不能说。不过我对她印象还不错，比某人好多了。她能够诚实地面对自己。烂事就是烂事，提不起干劲就是提不起干劲。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于砂糖…",
      "text": "别看砂糖文静又内向，据说，她在实验室里，收藏了很多特别的东西哦，很刺激，又很…露骨的那种。嗯？你问我？…我像是会偷看女孩子房间的人吗？"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于柯莱…",
      "text": "嗯，柯莱？真是个怀念的名字，你可找对人了！我来告诉你过去发生的事情吧，干脆从头说起——保证原汁原味！"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于米卡…",
      "text": "刚开始接触那会儿，我看米卡容易紧张，就跟他开了一点无关痛痒的小玩笑。哪知他更紧张了，连笑都笑得很僵硬…最后还特意写信道歉。欸，这种单纯老实的品质，难道是施密特家族的遗传？"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于塔利雅…",
      "text": "他平时是不是经常会喝教堂里的葡萄酒？酒量真不一般。那次我在豪饮比赛里输给了他，这成为了我们结识的契机。风神热爱美酒，风神的代行人也在孜孜不倦地传播美酒的魅力。这就是自由之城的浪漫吧！"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "关于洛恩…",
      "text": "洛恩那小子，已经有一段时间没来找我帮忙伪造签名了啊，难道他已经学会了手法？以他的聪明程度倒也不奇怪…之后，我用大团长的笔迹写一封信给他吧，看看他究竟学懂了几成。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解凯亚·其一",
      "text": "骑兵队长的头衔可没什么了不起的。说起来，蒙德城的骑兵都被大团长带走了。呵呵。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解凯亚·其二",
      "text": "其实西风骑士团一共有十位队长。但不是所有人都有队长级的实力。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解凯亚·其三",
      "text": "我的眼睛？我的眼睛没事。想把身体的某些部分遮起来是很平常的事儿吧？衣服和裤子也是一个道理。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解凯亚·其四",
      "text": "坎瑞亚？哦，你知道的真多。坎瑞亚的荣耀早已不在，剩下的如今都已沦为罪人，又何必再提起他们。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解凯亚·其五",
      "text": "原来我们已经相遇这么久了。跟你一起旅行，大概是我这辈子遇上的最有趣的事儿了，今后可别让我失望哦。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "凯亚的爱好…",
      "text": "品酒也是一种艺术，蒙德的酒是风神的恩赐，懂得好好品味才不会浪费了这份幸运。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "凯亚的烦恼…",
      "text": "孤独？怎么会，现在不就有人在我身边唠叨么。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "蒙德特酿的起泡白葡萄酒，兑上三份蒲公英酒，苦味会被完美中和，这种酒名叫「午后之死」。美味。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "居然有人直接把葡萄汁拿来喝，明明只需少许时日就能变成佳酿的…啧，真是不懂浪漫。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "哦！这味道好棒，看不出来，你真有两下子啊。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "配上美酒，会变得更美味吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "放心，我只是吃得慢了一点，我会好好吃完的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "值得庆贺的日子，祝你今天能得到真正的快乐。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "嚯，你也有两下子嘛。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "你好像一直都很照顾我嘛。谢啦。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "力量又增强了啊…我说，你那是什么眼神，怎么感觉比我还兴奋。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "本来只是同行，没想到你居然为我做到这一步…看来我也必须好好回应你才行呢。继续我们的旅程吧，挚友，是时候认真起来了。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "老实点！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "冻结吧！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "这个如何？"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "小心着凉。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
