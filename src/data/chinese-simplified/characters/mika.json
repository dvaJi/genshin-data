  "outfits": [
    {
      "id": 208000,
      "name": "高飞信标",
      "description": "米卡的装扮款式。为野外作业特别设计的这款骑士装束大量采用柔韧布料，并增添了收纳武器与工具的位置。祝穿戴者一路顺风！",
      "isDefault": true,
      "characterName": "米卡",
      "characterId": 10000080,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Mika_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "西风骑士团游击小队所属，前进测绘员米卡，向你报到。与你并肩作战是我的荣幸，请随意差遣我吧…我会竭尽全力，为你探清前路，查明敌情！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·目标",
      "text": "赶快调整好状态，不知道下个任务什么时候会来。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·记录状况",
      "text": "核对当前位置、向目标扇区测距…嗯，地理状况记录完毕。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·探明道路",
      "text": "无论处在什么环境里，只要仔细探索，应该都可以找到通畅的道路。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "好大的雨…希望地面不要变得泥泞，不然就要帮大家擦靴子了…做饭的时间要不够了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "雷声可以掩盖行动的声响，是我们的好朋友。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "积雪很漂亮，但又会把原来的地貌覆盖掉，我不太喜欢。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "阳光柔和，视距充足，观察条件良好。嗯，心情真舒畅！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "这风…是出自风神的旨意，还是地形对大气的作用呢？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "哦！早啊，我准备了远征队常吃的早饭，不介意的话，请一边用餐，一边和我说说今天的行动计划吧？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "请稍等，游击小队最爱的三号野战午餐很快就准备好。待会儿我再看看，附近有没有适合午休的地方。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚饭完成了，虽然还是行军餐，有点简陋…但提供的营养肯定管够，请不要介意…如果有需要维护的装备，也请交给我吧。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "时间还早，我要整理一下今天的勘测记录。行军床已经准备好了，请你先休息吧。等到你的精力恢复，夜宵应该也做好了，到时候，我们可以交替值岗。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于米卡自己·工作",
      "text": "前进测绘员？这个岗位的职责是率先进入未知的区域，探明地形，寻找最有价值的阵位，有时还要对付敌方的哨兵。所以，除了测绘地形，我也得掌握战斗、医疗和野外生存的技巧。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于米卡自己·琐事",
      "text": "搭建营帐、生火做饭、维护装备，这些事总得有人来做嘛。如果别人嫌这些事麻烦，而我做得还勉强合格，那我至少可以…让大家轻松一点，开心一点？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·传闻",
      "text": "对不起，刚回蒙德那几天，我听说了你们的事迹。像你和派蒙这样的超级强者，总有自己独特的原则。有些强者的脾气不太好，也许我说错一个词，就会让他们不高兴…好在你们都很和善，我根本不用担心！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·暗语",
      "text": "有的前锋会用「奥克塔维」表示「弩箭耗尽，正在返回营地」；用「薇拉」表示「状况良好，可以交战」。要不然，我们也约定几个暗语？毕竟我们会长期合作，这样更方便。哦，你说了算，我都听你的！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "说实话，能够得到「神之眼」，我也很吃惊。它的确能为我提供不少帮助，但我不能依赖它的力量，而是要把它当成一种保险手段。作为骑士团的一员，我更应该重视团队合作，想办法和同伴们一起战胜困难。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "有个简单的测距法，应该对你们有用：伸直手臂，竖起拇指对准目标，分别用右眼和拇指的轴线对准目标的左侧，左眼对准目标右侧，把两侧间的距离乘以一个数，就能提前确认山有多高，河有多宽，能不能一口气爬上山顶，游到对岸。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "听可莉前辈说，世上有种传递声音的植物，要是这种植物可以被随身携带就好了。这样一来，我就能实时汇报地形情况，甚至待在前方，为后方的同伴提供指引，用弩箭远远地抛射，早早排除威胁。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于凯亚…",
      "text": "入团之前，我接受了许多测试，主考官就是凯亚队长。凯亚队长一直支持着我，给我各种建议…不过，有时我不太理解他的话，担心自己跟不上他的节奏，让他扫兴。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于法尔伽·教诲",
      "text": "法尔伽大团长是万分可敬的强者，也是我在战斗方面的老师。他觉得我个子小，体力没优势，教导我「打架的理念要灵活」，「避免和敌人短兵相接」。所以，我才学着用长枪和手弩对付敌人，这样的战法的确更适合我。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于法尔伽·队长",
      "text": "大团长还说，我要树立更高的目标，不断磨练本领，我一直是这么想的，但直到远征期间，我才明白事情的严重性。有一天，我们遇见了自称「队长」的愚人众执行官。我完全没法想象，该怎么招架那样的对手。强者的境界，对我来说实在太遥远了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于琴…",
      "text": "副团长…代理团长是让人安心的好前辈，一直守护着大家的强者。在工作排期、战地医疗、还有下厨这几个领域，我能向她学习的东西，简直无穷无尽。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于安柏…",
      "text": "安柏长官…安柏前辈是最可靠的前锋，侦察领域的强者！前进测绘员和侦察骑士的阵位很接近，总是提前于主力部队行动。安柏前辈的经验太丰富了，我从她那里学到了很多野外生存的技巧，还有维护弩弦和箭矢的窍门。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于优菈·任务",
      "text": "优菈队长是战斗风格独树一帜的强者，她一直很照顾我。我刚刚入队时，她就给我安排各种各样的任务，数量是其他队员的好几倍，更快地锻炼了我的适应力。只要习惯了她的表达方式，和她相处起来就很愉快！"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于优菈·作风",
      "text": "其实，我很羡慕优菈队长，她为人友善，作风洒脱，内心特别强大。要是我也被别人用奇怪的目光盯住，还在背后不停议论，我大概会不敢出门吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于丽莎…",
      "text": "在我自学测绘的时候，丽莎长官一直在帮我，为我找到了好多有用的书，要是我也像她那样博学就好了。知识总归是不嫌多的，也许哪天就能用到呢？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于可莉…",
      "text": "可莉前辈？她的性格特别开朗，好像还是…和大团长旗鼓相当的强者？她好几次邀请我一起冒险，我们玩得超开心！虽然她偶尔会试验厉害的武器，让我重画很多地方的地图…不过，我也觉得很值得！"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于温迪…",
      "text": "好喜欢那位吟游诗人，他是演奏乐器的强者，他的曲调总让我有种回到家里的亲切感。如果要选出最能代表蒙德的曲子，我一定投他的作品一票。可惜我平常待在城里的时间不多，不然就可以每天送他一些礼物了。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "阿贝多长官对我有恩，我常用的测绘装备就是他帮我制作的，还有一种绘图笔，就算倒挂在树上，也能正常使用。嗯不过，测绘地图和画画好像并不相通？之前我对着目标区域画过几张写生，作为补充的情报，听说阿贝多长官看见之后，沉默了好久。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于洛恩…",
      "text": "你看见洛恩了吗？我才发现我的笔记本跟他的互换了，而他一大早又不见了。唉，他肯定是一个人冲去魔物聚集点了…明明说过这样做很危险的…要是我也是「队长」就好了，那样我说的话他就会听了…呃，会吗…"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解米卡·其一",
      "text": "我自己的事？我只是个普通人，没什么有意思的故事。如果只聊我以前的经历，你愿意听吗？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解米卡·其二",
      "text": "从小时候起，我就想当一个地图测绘员，描绘出提瓦特每个角落的轮廓。后来我发现，骑士团正好有这样的岗位，就在哥哥和爸爸的支持下参加了选拔，当上了前进测绘员。这份工作让我过上了理想中的生活，我已经心满意足了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解米卡·其三",
      "text": "骑士团的大家都好强，每个人都有值得我学习的地方。我从大家身上学到了新的本领，也应该给大家回报，如果大家有需要我的地方，我都会尽全力帮忙。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解米卡·其四",
      "text": "不过，帮大团长和优菈队长跑过几次腿后，有的同伴已经把我当成两位长官的信使了。如果我说错了话，给两位长官带来了困扰，那可就是我的过错了。所以，每次和不太熟悉的同伴交谈，我多少都有点拘束，让大家觉得我很胆小，这算是一种误解吗？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解米卡·其五",
      "text": "好在，经历过远征后，我没那么担心了。只要不给其他人添麻烦，就算大家对我有什么看法，我也不会介意。骑士团就像是我的第二个家，我要把前进测绘员的工作干得完美无缺，让我的家人们平平安安地完成任务，轻松愉快地度过每一天。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "米卡的爱好…",
      "text": "爱好吗…除了工作，我最喜欢的应该是…在陌生的地方野营了。沉浸在新鲜的美景里，搭一个舒舒服服的营地，升起篝火做一顿好吃的饭菜，真的很愉快！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "米卡的烦恼…",
      "text": "说实在的，我不擅长和陌生人打交道，也许是我不懂说话的技巧吧。这方面的窍门，能请你教一教我吗？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "大团长说，我这种年轻人就该多吃肉，把力量和体能练得棒棒的。虽然我怎么也不可能长出一身结实的肌肉啦，但我确实很喜欢肉类料理，这一点倒是和游击小队的大家很合拍。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "不像我的哥哥，我完全欣赏不了酒的风味，只要喝上一小口，我就会醉得不省人事，给大家添麻烦。碰上有的陈年烈酒，光是打开瓶塞后的气味，都能让我脚步发晃。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "太感谢了，这道料理实在太珍贵，我怎么舍得吃！可以把它收藏起来吗？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "口味和份量都无可挑剔，让你为我费心了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "唔…不管怎么样，这可是你为我做的饭菜，我一定会吃完的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "这种时候应该怎么说才好呢…嗯，今天是最特别的日子！应该用最热烈、最盛大的方式来庆祝！我为你准备了一本「蒙德绝景游览手册」，手册上记录了很多风景优美的地点，但没什么人知道这些地方哦。希望你从今天到明年的今天，每天都开开心心！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "虽然比起你还差得远，但我现在有一点信心了，至少不会再拖你的后腿。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "希望我能给你带来更多有用的情报，真真切切地帮你分担压力！"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "请允许我…一直和你同行，一起丈量脚下的大地！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "实在感谢！这下，我就距离目标更近了——让大家安安心心地前进，不必在崎岖的地形受苦受累，也不用惧怕角落里隐藏的危险！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "速射牵制。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "试探攻击。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "请你后退。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "精确射击！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "对不起了！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "肃清威胁！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "大家，请振作！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "我负责医疗！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "打开突破口！"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "打开风之翼·其一",
      "text": "从高处观察…"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "是新的收获！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "有战利品吗？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "找到了宝藏，恭喜大家！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "有点麻烦…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "要改变战术吗？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "对手…很强啊。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "请后撤，我来顶住！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "要快点治疗…"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "早知道…就迂回了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "对不起，大家…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "完了…我搞砸了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "要忍住！"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "没问题的！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "不痛…不痛！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "不能慌张…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "清点装备…一切就位。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "嗯，长枪和弩箭都准备好了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "我…我来为队伍探路！"
    }
  ]
}