  "outfits": [
    {
      "id": 203400,
      "name": "甲铁玫瑰",
      "description": "诺艾尔的装扮款式。甲胄与厚实丝绒连缀成的沉重裙装。",
      "isDefault": true,
      "characterName": "诺艾尔",
      "characterId": 10000034,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Noel_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是诺艾尔，西风骑士团的女仆，从今天起会陪你一起去冒险。如果遇到任何困扰或者麻烦，不用担心，我都会尽全力帮你解决的。嗯，现在就可以哦。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·帮忙",
      "text": "交给我吧！什么都可以交给我！——对了，你要拜托我做什么来着？我还没来得及听…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·休息",
      "text": "有点累了吗？那就在这里休息吧，我去为你沏茶，要全糖、半糖，还是无糖？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·可靠",
      "text": "只要你需要我，我随时都会出现在你的身边。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "糟了，大家的衣服还晾在外面！我能不能现在回去收拾一下？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "遇到打雷还是待在屋子里比较好哦，如果有非出门不可的事，就交给我吧。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "阳光很好…",
      "text": "天气晴朗，不如做一些和「阳光」有关的事吧。欸？具体一点…只要能让你的心情也变得晴朗的事，都可以。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "听见了吗？是风神的声音。每到我心烦意乱的时候，听见风声就能平静下来。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好，早餐已经做好了哦。我就待在你身边，如果哪里不合口味，请随时告诉我。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "想要坐下来喝杯茶吗？我去为你准备。对了，我还顺手准备了厚云朵松饼，是我的拿手菜哦，请一定要尝一尝。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上是大家的休息时间，也是我最忙的时候…安柏洗好的发带放在哪了？凯亚新买的眼罩有几套？我会全部记住的，这是女仆的责任。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "今天的冒险辛苦你了，请去休息吧。我还要回骑士团一趟…欸？要我守候你入睡吗？…唔…倒是没什么问题，不过…不是在捉弄我吧？"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于诺艾尔自己·自律",
      "text": "我只是每天都做同样的事，和真正的骑士比起来还差远了…但这是通往骑士之路的修行，修行可不能只是嘴上说说而已啊。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于诺艾尔自己·分歧",
      "text": "我有点不太擅长和别人争辩，很多时候说不清道理，还会惹别人生气，所以我就会先按我的想法去做，结果又被人说是「固执」了…我只是想用结果说服他而已，这也是「固执」吗？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·身份",
      "text": "我的奉献是出于自由的奉献，「女仆」在我看来就是最自由的身份。厨师、园丁、战士、向导…你需要我是什么，我就是什么！"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·叮嘱",
      "text": "就算再怎么仓促，一日三餐也不能应付，不可以吃来历不明的东西，也不能光吃肉不吃蔬菜。对了，尽量不要喝冷水，对胃不好…唔，你不会在想「因为太麻烦所以还是交给诺艾尔」吧？唔唔…如果你真的这么想…好吧，还是交给我来吧！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于我们·欢迎会",
      "text": "我听说了，你成为了西风骑士团的荣誉骑士，真是羡慕啊…那今后你就是我的前辈了。对了，应该为你举办一场热闹的欢迎会！我现在就去准备！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "说实话，有些失望…虽然这「神之眼」象征神明对我的肯定，但为什么不是「风」，而是与风的性质相差最远的「岩」呢？我觉得最适合西风骑士团的元素，毕竟还是…"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "其实我很喜欢闻酒的味道，可是现在的我还没到喝酒的年纪…虽然不止一次有偷偷尝的机会，但我都忍住了，还是把这份神秘感保留到我成年的那一天吧。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "女仆要严守秘密，所以我很喜欢玫瑰，玫瑰在蒙德就代表「守口如瓶」，它总是能提醒我…欸？在你的家乡，玫瑰代表「爱情」吗？…居、居然还有这么火热的含义啊…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于安柏…",
      "text": "她是我非常尊敬的前辈，实力很强不说，对人也很亲切。她还教我怎么做「兔兔伯爵」，你看，我会把它当成护身符带在身边，做得不错吧？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于可莉…",
      "text": "我一直很想知道，她还这么小，是怎么正式成为骑士的。有一次向她请教经验，她还没听完我的话，就拉着我去骑士团外面玩炸弹…我以为这是什么修行，结果最后我和她都被琴团长关了禁闭…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于琴…",
      "text": "琴团长一直都是我的榜样，我的实力和认真程度完全比不上她。她对别人就像对自己一样严格，所以如果有一天我能得到她的认可，那也是对我一直以来努力的最大肯定了。在那之前，我都是不会松懈的！"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于法尔伽…",
      "text": "本来我想跟着他的队伍一起去冒险，履行女仆的责任，但大团长说我留在蒙德他才不会有后顾之忧…大团长这么器重我，我特别开心！虽然后来我知道大团长不只对我一个人说了这句话，不过…器重就是器重嘛。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于凯亚…",
      "text": "他很神秘，来如影，去如风，每天都有很重要的任务要去处理。他还经常会给我安排一些小任务，就好像我已经是他的小队成员了一样…嗯？只是跑腿？不不不，虽然确实是跑腿，可是我很珍惜的！"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于班尼特…",
      "text": "他不止一次来邀请我，说什么比起骑士团，还是冒险家协会更适合我…虽然我是会像一个普通的冒险家一样，帮他照顾他的老爹们，但…骑士团对我来说有特别的意义，而且我也不想认输…嗯，果然还是没法答应。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于菲谢尔·茶点",
      "text": "她好像是从别的世界来的，其他的我也不清楚…不过她好像很喜欢骑士团的图书馆，总是在那里看书。我打扫的时候会送去一些热乎乎的茶点，她每次都会感谢我，还会说很多听不明白，但都很夸张的话…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于菲谢尔·身世",
      "text": "以前我打扫图书馆的时候，记得有本书叫《菲谢尔皇女夜谭》，我还以为只是幻想小说…但没想到，里面的主人公居然真的存在！能有一本自己的传记，她一定很厉害吧。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于芭芭拉…",
      "text": "我们经常在一起喝茶，有时候她会轻轻哼出很好听的调子，告诉我灵感来了。虽然我对音乐给不出什么实用的建议…但能跟芭芭拉享受这样的时光，我真的非常高兴！"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解诺艾尔·其一",
      "text": "是需要我帮忙吗？哦…只是想和我聊聊天，好吧，如果这就算帮上了你的忙，那想聊多久都可以。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解诺艾尔·其二",
      "text": "没关系，什么样的事都可以交给我，不用照顾我的感受的…欸？那不是「女仆」而是「工具」？唔…工具做了很多事也不一定会开心吧，但我为你做的每件事，我都很有成就感哦。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解诺艾尔·其三",
      "text": "这、这些点心是送给我的吗？不不不，这怎么好意思呢？那…那我也要做很多点心作为回报！我现在就去，马上就去！半个小时…呜，最多一个小时就做好了。你可以先去做别的事，茶点很快就会热乎乎地端到你的面前！"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解诺艾尔·其四",
      "text": "我每天做的都是一些琐碎的小事，但只要这些小事能帮到你的冒险、你的生活，我就会很开心…因为你的道谢，会让我觉得这些小事，也都有小小的意义。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解诺艾尔·其五",
      "text": "我是为骑士团服务的女仆，也一直想要帮到更多人的忙。但不知不觉，用在你身上的时间已经变得越来越多了…唉，像我这样自私的做法，是不是…不太好？"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "诺艾尔的爱好…",
      "text": "爱好吗？我最喜欢洗各种各样的东西，洗衣服，洗地板，洗窗户，看到脏东西变干净我就会特别有成就感…欸？是指「休息时的爱好」？我想想…嗯，果然还是洗东西！"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "诺艾尔的烦恼…",
      "text": "该怎么用最少的预算、采购到最多最好的物资呢…我试过一个人跑去璃月比对所有商铺的价格、再一个人把东西全都搬回来…但那次花的时间太长，琴团长差点以为我在路上被风魔龙吃掉了…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "当然是「满足沙拉」，蒙德的自然水土汇于一盘，营养均衡，热量也不会超标…你问吃不腻吗？当然不会，很好吃的！我已经吃了十年了。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我不挑食！但有一种情况会让我比较头疼…宴会上的一大桌菜，作为女仆，每一道菜都必须自己先尝一尝。但这样一口接一口…唉，太罪恶了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "能把普通的菜肴做得那么好吃…我对你的钦佩，又多了一些！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "味道真好。我也要向你学习！再怎么说，这也是女仆的职责…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "热量…会不会已经超过一整天的份额了…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "每天都忙于冒险，是不是积压了很多琐事来不及处理？今天我就是你的专属女仆，全都交给我吧！还有…在这最棒的一天，祝你生日快乐！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "这就是…新的力量？谢谢你，这样我就能帮到更多人了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "还不能满足，在成为正式的西风骑士之前，我都要加倍努力。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "多亏了能和你一起冒险，我才获得了这么多的成长。明明女仆的职责是为你排忧解难，结果反倒是让你为我花了这么多心思…"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "蒙德城的大家都说我变得比以前更可靠了，还说我马上就能成为真正的西风骑士了，但其实我…什么？你也这么觉得？呃…谢谢你能这么说，这是对我最好的夸奖！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "岩石的重量，令人安心。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "一定要干净利落。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "交给我吧。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "该打扫战场了。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "我会注意骑士的风度。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "我会注意女仆的礼仪。"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "应该赶得上。"
    },
    {
      "id": "700002",
      "type": 2,
      "title": "冲刺开始·其二",
      "text": "还有人需要帮忙。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "心满意足。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "真高兴…"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "这些宝藏积灰了，先清洗一下！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "没关系，轻伤而已。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "唔，衣服都弄脏了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "我不会退缩的。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "别动，小心伤口，我来治疗！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "交给我吧！换我来！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "让骑士团…蒙羞了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我还想…保护大家…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "再见了…主人…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "唔…失态了。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "真高兴…啊、嗯。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "一定会保护你。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "嗯，如你所愿。"
    }
  ]
}