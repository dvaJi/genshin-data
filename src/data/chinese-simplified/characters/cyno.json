  "outfits": [
    {
      "id": 207100,
      "name": "衡断之心",
      "description": "赛诺的装扮款式。体现大风纪官威严与公正原则的装束，由于头部的饰物是应赛诺本人要求特别定制的，做工复杂，需要定期维护。",
      "isDefault": true,
      "characterName": "赛诺",
      "characterId": 10000071,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Cyno_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面·过往",
      "text": "我是赛诺，曾经的「大风纪官」。如今我正在以自己的力量审判罪恶，若你同样心系规则与正义，我可以助你一臂之力。"
    },
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面·如今",
      "text": "我是赛诺，教令院的「大风纪官」。维护规则、审判罪恶是我的职责，今后的旅途中，我会保护好你的安全。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·称重",
      "text": "善与恶，最终都会被称量。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·牌运",
      "text": "运势会左右某一场对决的胜负，但不会一直影响下去。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·疑惑",
      "text": "偶尔我也想缓解一下气氛，但我其实分不太清什么笑话能够引人发笑。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "又下雨了…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "在一些传说中，雷电是神明对人间降下的审判。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "我很喜欢下雪后的世界，安静却并非一片死寂。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "阳光终会照进每一个角落。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "好大的风…当心。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "熟悉的风景…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "打起精神，该出发了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "需要我准备午饭吗？事先说好，我可不保证好吃。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "还记得我跟你说过的话吗？夜晚总是伴随着危险，无论做什么都不要放松警惕。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安。一些罪犯在附近活动，我去处理。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于赛诺自己·冷笑话",
      "text": "有一个旅人在沙漠中口渴无比，于是祈祷自己遇到一只水史莱姆，没想到一只饿着肚子的水史莱姆也在祈祷自己遇见落单的旅人…嗯？你那是什么表情，不好笑吗？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于赛诺自己·散步",
      "text": "我偶尔会去夜晚的沙漠散步，寒冷而干涩的风让人头脑清醒。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·决斗",
      "text": "要打一把「七圣召唤」吗？给你看看我的新卡组。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·此刻",
      "text": "过去无法更改，未来无法预料，所以我很珍惜眼前的时光。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "凭依在我身上的非人之物也好，将视线投射于我的魔神也罢，我受神明青睐，但我无意为此而改变自己的道义。我只尽我应尽之责，做我应做之事。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·求知欲",
      "text": "「欲望泛滥就会引发灾害」，这似乎已经是一种共识。然而提及「求知欲」的时候，人们却往往只愿意谈论它的正面作用…在我看来，求知欲也是欲望的一种，必须加以控制。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什么想要分享·敬畏心",
      "text": "在执行任务时，我的任何一个判断都可能会改变他人的命运。所以我必须要求自己时刻对「风纪官」这个职位保持敬畏——就像我敬畏知识与力量一样。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "我喜欢生长在沙漠中的那些灌木。沙漠象征着归寂，一切文明都会被风沙掩埋。但就在这片荒凉的土地上，却能见到生命不断萌发的迹象，有时连我也会被它们的坚韧震撼。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于提纳里·知识",
      "text": "提纳里和我见过的其他学者不同。他对知识同样有着很深的执着，却始终不会逾越那道红线。有些学者会将自己视为「实验室中的神明」，但提纳里不会，他一直平等地尊重每一种生命。听说他拒绝了教令院的聘请，我也站在他这一边。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于提纳里·笑话",
      "text": "提纳里曾劝我不要在饭桌上讲笑话，说是根本笑不出来。我不以为然，连讲了三个压箱底的笑话，并逐一解释了笑点…然后我的饭菜凉了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于柯莱…",
      "text": "我曾经帮她封印了体内的魔神残骸，但封印的过程给她带来了很大的痛苦。那种程度的痛苦可能比死亡更让人害怕，她能够坚持下来，很了不起。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于艾尔海森…",
      "text": "我不太喜欢过于聪明的人，他们总是自认为能掌控一切，从而经常在危险的边缘游走。不过艾尔海森还算稳定，在绝大部分场合，他确实有掌控局面、化险为夷的能力。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于卡维…",
      "text": "提纳里和柯莱没有亲口说出来，但他们之间的眼神交流已经说明了一切。卡维分享的亲身经历比我准备的笑话有趣多了。我的看法？我觉得他们会为这种事情发笑，反倒是挺好笑的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于纳西妲…",
      "text": "评价神明…这在我看来是略微有些僭越的事情。不过在同行的那段时间里，我也亲眼见证了她的智慧、勇气与决心。相较于那些只靠臆想就对她指指点点的贤者，我应该更有资格下这个结论：她是一位优秀的、值得尊敬的神明。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于妮露…",
      "text": "我能从她身上感到对舞蹈的热情与执念，这份执念非常坚定，不会轻易改变。希望以后，她也可以用自己热爱的舞蹈为他人带去快乐。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于珐露珊…",
      "text": "我曾仔细翻阅过记载珐露珊前辈失踪的案卷，那时候我怀疑她进行了某种危险的研究…不过与她见面之后，我就彻底打消了这个念头。虽然相处起来有些困难，不过她就像一位喜欢絮絮叨叨的长辈，心里会为他人着想，不会做什么出格的事情。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于丽莎…",
      "text": "丽莎和我曾向同一位贤者求学，我自然知道她的事。身为大风纪官，我也见过许多过分追求知识而引发的悲剧，所以能理解她的选择。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于赛索斯…",
      "text": "赛索斯很有责任心，我绝对认可他作为战士的能力，也钦佩他的勇气。他也帮了我很多，有他在，教令院与缄默之殿的合作一定会更顺利。\\n不过我觉得他身上还有一处欠缺，就是牌打得太少。每次见面我都邀请他打几局，他总有事在身，要吃饭了、有事要办、要去见朋友…全是借口！他在须弥城最熟的朋友不就我们几个吗？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解赛诺·其一",
      "text": "你问关于我的事？也是，毕竟在很多人眼中我是一个无法忽视的「麻烦」…不用担心，只要你不做什么危险的事情，我就不会找你的麻烦。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解赛诺·其二",
      "text": "以此身为容器，可以令非人之物的力量显现。这既得益于先天的体质，也是一种后天的交易。没什么可避讳的，我以风纪官的身份称量世间的罪恶，自然也要把我自己的灵魂放到审判之秤上一同称量。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解赛诺·其三",
      "text": "比起「为什么做」，我更看重「做了什么」。因为这个世界上有成千上万种理由，有时你听到那些理由，会觉得做了错事的人情有可原，甚至觉得旁人对他们太过苛责。劣势方总是容易引起别人的同情，但审判者却要摒弃这种情绪。情有可原，但罪无可赦。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解赛诺·其四",
      "text": "在幽暗的无知之海上，偶尔会泛起微光，吸引着不明真相的人靠近。常有人视其为灯塔，却看不到漆黑的海水中隐藏的巨大危险。将久居在黑暗中的人带离光明的指引，本身是一件残酷的事情，但我不得不这么做——直到未来有一天，我们能够战胜海水中潜藏的敌人为止。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解赛诺·其五",
      "text": "我判断有价值的信息，已经如数分享了，你还在期待听我说什么？哈…你的好奇心真是不简单，那就由你提问吧。习惯了审问别人之后，这种被人询问的感觉…也算新奇。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "赛诺的爱好…",
      "text": "闲暇的时候，我会和其他人打几局「七圣召唤」。这种建立在规则之上，却又充满灵活变通的游戏，在我看来更像是一种艺术。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "赛诺的烦恼…",
      "text": "前段时间，我看到了一本来自稻妻的轻小说。小说以「七圣召唤」为主题，里面的主角被逼入绝境的时候，忽然从卡组中抽到了一张原本不存在的卡。我深受震撼，同时也陷入困惑：通过对卡组进行特殊操作，创造出让人摸不着头脑的奇迹，这究竟是打破了规则，还是也算规则的一部分？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "大米与肉类、干果混合，加酸奶进行烤制，不同的香味会混合到一起。敲开焦脆的外壳，香味就会随着蒸腾的热气一同冒出来。制作起来也不会花太长时间，是我很喜欢的菜肴。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "在沙漠中行走的时候，带的干粮通常坚硬无味，习惯之后就没有什么讨厌的东西了。非要说的话，跟虫子有关的食物还是有些难以接受…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "味道很好，劳你费心了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "我收下了，多谢。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "给我的吗？是不是搞错了？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "嗯…先祝你生日快乐。虽然没有太多庆祝的经验，不过想到是你的生日，我还是提前做了一些准备。首先是一套我研究了几天后得到的卡组构筑，风格和你比较契合。另外我调整了这段时间的安排，你有什么想去的地方吗？我可以陪你一起去。虽然生日只有一天，但放松还是需要尽兴，行程安排在三天内即可。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "我能感受到新的力量，这是变强的证明。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "审判罪恶，维护规则。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "不错的提升，多谢你了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "力量已达顶峰，然而仅靠这一身武力，仍旧有许多做不到的事情。人情与规则许多时候相互冲突，如何更好地兼顾，我会在今后的旅途中寻找答案。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "束手就擒吧。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "徒劳的挣扎。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "你无处可逃！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "裁决已至。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "该定罪了。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "偿还罪业！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "以此身…肃正万象！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "判决，如期降临。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "称量，你的罪孽。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "应得之物。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "贵在恒心。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "财富积累，成为文明的基石。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "威胁程度…比预想中要高。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "差不多也该习惯了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "咳…再来！"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "去休整，别逞强！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我来替你。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "轮到我了吗…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "覆灭…新生…终而复始。"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "审判，失败了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "无用的挣扎。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "真难对付。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "有两下子。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "我会尽我所能。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "行动开始。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "这次的目标是谁？"
    }
  ]
}