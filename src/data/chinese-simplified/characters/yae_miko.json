  "outfits": [
    {
      "id": 205800,
      "name": "御子之谕",
      "description": "八重神子的装扮款式。宣昭鸣神大社斋宫高贵地位的巫女服饰。愿她身着此衣时的美丽容姿，像那洁白襦裙上永不凋谢的神樱花一般驻留。",
      "isDefault": true,
      "characterName": "八重神子",
      "characterId": 10000058,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Yae_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我是鸣神大社的宫司，此番造访，自是为了确认你的一举一动，此为大社诏令…呵，不用那么紧张，场面话罢了，这样才有正当理由休沐嘛。快，去做些有趣的事让我看看吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·创作体裁",
      "text": "最近八重堂穿越异世的小说也太多了，哼，就对自己的世界如此不满吗。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·故事",
      "text": "很多人的一生，写于纸上也不过几行，大多都是些无聊的故事啊。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·尘世",
      "text": "于我而言，不变也是一种美好，哎呀，可尘世哪是如此不变之物。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "下起雨后，浑身的毛发都会变得湿漉漉的…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "很多人会害怕打雷，不过我听到雷声只会觉得亲近。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "未生灵智的小狐狸，往往会一头栽入雪地来觅食…想看我那样做？哼。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早，嗯？怎么一副无精打采的样子，没有睡好吗？哎呀，昨晚是去做什么坏事了么？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "嗯~伤脑筋，中午吃些什么呢？油豆腐吃腻了，想吃点清淡的。话说好久没见到社奉行家的小姑娘了，我们不如就去吃她做的点心吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今夜的月光如此清亮，不做些什么真是浪费。随我一同去月下漫步吧，不许拒绝。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "该入眠了，呵，在夜里不听到连绵的雷声，甚至都会睡不安稳呢。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于八重神子自己·永恒",
      "text": "所谓的永恒，就是不再失去已拥有之物，但从别的角度说，也放弃了得到更多的可能，不过世事总是如此，没人能够得到全部。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于八重神子自己·趣味",
      "text": "人类很有趣，所以我才如此喜欢人类。明明生命短暂，却能散发映昼光辉。他们之中，有些人的光芒，即使隔开久远时间长河都不曾黯淡。阅读这样的人生，是一大乐事啊。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·作家",
      "text": "无聊，这本也无聊透顶…啊呀，这些人都是为了什么才成为作家的。欸，对了，不如你把自己的经历写下来投给八重堂吧，感觉一定能给我一点乐…一定能大受欢迎吧。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·磨损",
      "text": "将自己封闭起来，或许会更快地遭受「磨损」。只有自己的世界，无他人作镜以对映，可是很可怕的事…你我共处之时，重要的就是互相观照哦。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "你说…你很喜欢我佩戴「神之眼」的方式？真有眼光。那么…要来摸摸看吗？"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "在油温到八成热时，沿锅下豆腐，再开成小火，等到煎至金黄的时候再夹出来，热乎乎的，这世上没有比油豆腐更好吃的东西了。咦，做法都已经告诉你了，你怎么还愣在这里呢？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "虽然因为在鸣神大社，日日抬头都能得见，有时也会觉得厌烦。不过，那棵神樱毕竟已经是我命运所系之物了啊。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于雷电将军…",
      "text": "明明想要出来，却一直把自己关在一心净土里，简直就是自我折磨嘛…从另一个角度来说，也挺可爱的不是吗。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于神里绫人…",
      "text": "社奉行家的那个小子啊，从小就不安分，别看他表面上笑得春风和煦，暗地里可不知道在盘算什么呢，令人讨厌…哼，我可跟他不是一类人，哪来同类相斥的说法。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于神里绫华…",
      "text": "我很喜欢社奉行家的小姑娘，任何事都安排得井井有条。不过社奉行一直都在做些吃力不讨好的活，可怜，如果她不是神里家的人，我早就把她挖到八重堂了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于九条裟罗…",
      "text": "这块愚笨的木头啊，远不如她那天狗爹爹心思活络…哎呀，怎么说呢，虽说木讷耿直也有木讷耿直的好处吧，不过还是希望下次不要在神社拦着我，一个劲追问影的事了。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于宵宫…",
      "text": "长野原的烟花嘛，也是每年难得的值得期盼之物了。据说前些天她还大闹天领奉行，在敷地大放烟花。呵，九条家的人恐怕气得脸都变青了，真是可惜呀，没能亲眼看到那副场景。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于甘雨…",
      "text": "这么说来，很久没有见过甘雨姐姐了。稻妻尚未锁国时，璃月与稻妻往来事务都是我与她接洽，真是相当可靠，下次若有机会去璃月，再给她带些新鲜的海灵芝吧。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于珊瑚宫心海…",
      "text": "现在的巫女，一个比一个可爱。不知道这孩子跳起太平神乐之舞会是什么样子，说不好群鱼也会跟着旋转吧。只要她肯叫我一声神子姐姐，呵呵…我倒有些心得愿意分享。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于国崩…",
      "text": "我当时就觉得那是个麻烦，不过她却说毕竟是自己创造之物不愿出手。早知变成现在这样，还不如当初就瞒着她处理掉算了。现在？呵…现在，已经变麻烦啦。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于荒泷一斗…",
      "text": "他呀，鬼族的奇怪小子，呵，听说他找了九条家不少的麻烦。天领奉行的人想要以有伤风化为由将他写于街上的留言擦掉，是我找人保留的，呵，这么有趣的小鬼，这些年可是难能一见了。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于五郎…",
      "text": "五郎的尾巴色泽很漂亮，不过…还是我的更柔软一些。呵…"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于早柚…",
      "text": "这个子小小的孩子，躲倒是挺会躲的，鹿野奈奈经常向我抱怨，得花很多时间找她，连看小说的时间都变少了。要我说啊，或许是有人在暗中帮助早柚呢？"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于久岐忍…",
      "text": "听说阿幸的这位妹妹很有个性，虽说出自巫女世家，却远离神社，学了许多门手艺，甚至去过璃月留学，最后还加入了荒泷派…如此有趣的女孩子，应该让阿幸帮忙引荐一下，嗯，阿幸肯定不会拒绝我的。"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于绮良良…",
      "text": "最近对人类社会感兴趣的妖怪真是越来越多了。这种趋势，该说是好事吗？我的态度？哎呀，当然是劝大家及时行乐啦。再说，乖乖掏钱请客吃饭的小后辈，谁会不喜欢呢？"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于梦见月瑞希·产业竞争",
      "text": "「焦虑劳累之人根本读不进小说」？唉，我们「八重堂」真是失败啊，旗下的小说还是趣味性不足，到现在为止，还没能推出足够获得瑞希小姐认可的小说。再给我的编辑和作家一点时间吧，要是接下来的作品还是没法让瑞希店长点头，我这个没用的主编，就只能亲自给瑞希小姐写一本小说咯，名字…就叫「梦貘记」好了。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于梦见月瑞希·重遇",
      "text": "瑞希刚回来稻妻那一会，总是一副揣着心事的样子，明明在路上看见了我，却还要把目光撇开…我？我当然没有主动搭讪她。还想多看一阵她那副别扭的模样呢。如果我没想错，等我们俩擦肩而过之后，她还要扭过头，瞪着眼睛瞅我两眼…要是我这时候再回头看她，只怕瑞希要被我吓得露出原形，捂着耳朵飘走了。\\n不过现在嘛…她都已经会在闲事月刊的读者来信里给我挑刺了。食梦貘的成长，真是迅速哪。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解八重神子·其一",
      "text": "想知道更多我的事？也不是不行，不过世事都讲究一个互惠互利，想了解我，就拿你自己的事来交换如何？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解八重神子·其二",
      "text": "狐斋宫大人啊，说着出一趟远门，就再也没有回来。唉，我那时可一点都不想接手鸣神大社的麻烦事，她对我说，说我要是当了神社的宫司，就可以随心所欲地吃油豆腐了。什么糟糕的理由呀，吵吵闹闹的，令人头疼的女人…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解八重神子·其三",
      "text": "最开始建立八重堂的动机当然是为了看有趣的小说，不过到后来乐趣就变成看那些小说家殚精竭虑的样子了。呵，你永远想不出来那些人在拖稿的时候说出的理由，哎呀，比他们自己写的小说要有趣多了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解八重神子·其四",
      "text": "无论如何，魔神皆有消亡之时，若是他们的那些故事随时间一起散佚于天地，再无人忆起，那就太可惜了。以及，有资格写他们故事的人，必须得有上乘的文思与笔法…如果世上没有这样的人，那就培养出…培养出足以书写那些故事的作家吧。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解八重神子·其五",
      "text": "说来，虽然看过许多人写的小说，我自己倒是从未动笔过，写小说毕竟还是很麻烦的事嘛。不过，如果你的冒险结束了，想要有人记录你的故事，而我那时正好有空的话…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "八重神子的爱好…",
      "text": "我第一喜欢的是他人的故事，第二喜欢的就是看他人烦恼的神色，两者若是在一起，哈，那可是相得益彰的有趣啊。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "八重神子的烦恼…",
      "text": "过度安稳的日子实在是太过无聊了啊…"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "你有听说过一物，其名为「狐狸乌冬」吗，其实也就是加了油豆腐的乌冬啦。怎么样，油豆腐加乌冬，听上去就很好吃吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "不行，腌制过的东西不行，不管是花鳉还是腌海雀，不觉得都有一股不能让人接受的臭味吗？本宫身为鸣神大社的宫司，怎么能咽下如此不洁不净之物。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "哎呀，小家伙，你对我的口味了解得很清楚嘛。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "既然是你亲手做的，我就尝尝看吧，呵呵…"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "怎么说呢…小家伙，需要努力的地方还有不少哦？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生辰…",
      "text": "今日是你的生辰啊…\\n「凡御岁之祝礼，以徒名之令，遇其其之所求，遂其其之所愿，正心明神，以受萌荫庇佑。」好了，就这样。祝你这一年能够诸事顺遂，得偿所愿吧。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "所谓巫女修行阶位，在修习毕业之后，能准确开口念诵祭言即可称为「直阶」。对于人类来说很方便，不过对狐族来说倒是最困难的一步…毕竟是狐狸嘛。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "成为宫司代理，也就是「正阶」的修行可是很辛苦的，要受诸多清修戒律，修行的秘诀唯有一条，就是晚上偷偷进食时，不要被人发现。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "升为「明阶」，即要求进入天地明察的境界，神通宇内，世事洞明。只要进入了这个境界，一般都会受获神之眼，拥有远超一般狐族的悠长寿命了哦。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "鸣神大社的「净阶」，历来只有鸣神大社的宫司具有，仅此一位。「净阶」只是类似荣誉职位的东西，跟实力倒没什么关系，不过我若是自称实力最强的「净阶」，倒也无何不可。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "律令。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "咒禁。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "敕！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "显化。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "留形。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "真瞳显现！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "雷霆侘寂！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "雷光凄美啊。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "有什么有趣的东西吗？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "就只有这些么…"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "快，打开来给我看看。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "这样下去可不行啊。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "可不能再玩下去了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "好了，要认真一些了哦。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "别再勉强了。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "交给我就好。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "哎呀，玩过头了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "结局真是糟糕啊…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "止步于此，何谈永恒…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "就这样？"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其一",
      "text": "真是麻烦。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "这时候想起我了？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "去做点有意思的事吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "好吧，既然你都来邀请我了…"
    }
  ]
}