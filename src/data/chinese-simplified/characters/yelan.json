  "outfits": [
    {
      "id": 206001,
      "name": "静暇雅宴",
      "description": "夜兰为假日时光所搭配的装束，典雅而不失利落，捎来悠暇的心境之余，也不失为一种「充满攻势」的伪装…",
      "isDefault": false,
      "characterName": "夜兰",
      "characterId": 10000060,
      "source": [],
      "filename_card": "UI_AvatarIcon_YelanCostumeSummer_Card",
      "filename_icon": "UI_AvatarIcon_YelanCostumeSummer",
      "filename_iconCircle": "UI_AvatarIcon_YelanCostumeSummer_Circle",
      "filename_splash": "UI_Costume_YelanCostumeSummer",
      "filename_sideIcon": "UI_AvatarIcon_Side_YelanCostumeSummer"
    },
    {
      "id": 206000,
      "name": "于阑珊处",
      "description": "夜兰的装扮款式。常年随主人一道潜伏于暗影之中的装束，气质神秘宛如午夜绽放之兰。",
      "isDefault": true,
      "characterName": "夜兰",
      "characterId": 10000060,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Yelan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "你好，旅行者，叫我夜兰就好。我想你或许会需要我的帮助，我恰好也对你所拥有的情报感兴趣。总之，让我们友好相处，互帮互助吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·线报",
      "text": "线人来信了，嗯，看来又出现了新的变数。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·翘班",
      "text": "点数不错，今天就继续翘班吧，等到状态好了，再去把活一次干完。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·身份",
      "text": "在这世间行走，「身份」多一点才便利。需要我帮你捏造一些吗？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "又下雨了？真是麻烦啊…痕迹一旦被雨水冲刷干净，就需要不少时间来还原了…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "在打雷时会感到害怕的，要么是纯真的孩子，要么是心虚之人。你应该两者都不算吧？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "有点冷嘛…不能把外套披在肩上了。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "刺眼的阳光，好烦人啊。这样一来，我可没法打盹了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "风里传来了躁动不安的情绪…嗯…"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "…嗯~这么早？没有必要的工作时，我习惯中午起床。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "啊，有点困了，小睡一会儿吧，不用提醒我，到了工作时间，我自然会醒的。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好啊，晚饭吃了吗？吃了点什么？啊…我就随口问问，不要太在意。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "把牛奶喝了，乖乖睡吧。嗯？你说你不是小孩子？呵呵…那就放在这里，喝不喝随便你了。我的话，一般会在后半夜入睡。万一你有讲梦话的习惯，我不能保证不把它们记下来哦。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于夜兰自己·职责",
      "text": "七星对璃月各地的情况了如指掌，但总有一些情报需要通过特殊手段去收集。我算是这方面的行家，所以这类差事基本被我包揽了。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于夜兰自己·传闻",
      "text": "有人说，岩上茶室的现任老板是个一夜暴富的年轻商人；有人说，总务司有位体虚多病的高等雇员，隐居在城外；还有人说，不要接近涉密地区，会被蓝色的鬼魂缠上…当然，大多普通人完全没听说过「夜兰」这个名字。所以你把那些传闻当成笑话听就好。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·关系",
      "text": "嗯？你那是什么表情？跟我相处不用这么警惕，我啊，从来不算计自己认可的人。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·欺骗",
      "text": "别过分期待他人的「肺腑之言」，滑头鬼只会说你爱听的话；也别轻易迎接他人的目光，眼神最容易出卖一个人的情绪。我们怎么说都是朋友，要是你被人骗，我也会有种吃了哑巴亏的感觉呢。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "重要情报所在的地点，往往隐藏着致命的杀机，无论有多少可靠的部下，都无法彻底排除风险，足够破局的武力才是关键。我还算走运，至少在悟出这个道理后几天，就获得了「神之眼」。否则，站在这里和你聊天的…就是蓬头垢面的鬼魂了。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·屏蔽噪音",
      "text": "仔细打磨鳅鳅宝玉后，可以将它当成耳塞，隔音效果很不错，哪怕有人在你耳边嘶声哀嚎，都不会打扰你的美梦。当然，希望你以后不必用到这种东西。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什么想要分享·幽奇腕阑",
      "text": "右手的镯子？告诉你也无妨…它蕴含着我们家族的术法，能传递简单的信息。至于信息的含义，都隐藏在这蓝光中，只有我能看懂。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什么想要分享·追踪目标",
      "text": "在追踪目标时，我一般倾向于给对方施加心理压力。在试图摆脱我的过程中，他们会阵脚大乱、搬救兵、改变计划…直到把自己的老底都交待出来。呵…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "你了解盗宝鼬吗？它们的智力平平，但经过人为驯化后，也能熟练地重复偷盗，甚至开锁撬锁。多鲜活的例子啊——只要方法得当，连动物都能作为趁手的棋子，勾心斗角的人们又何尝不是如此？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于凝光·关系",
      "text": "我跟凝光认识得早，那时她还不是七星，我们合作了一段时间。她能提前当上七星，说不定也有我的功劳。呵，谁知道呢？总之，现在这份工作是她推荐给我的。确实不错，很适合我。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于凝光·期待",
      "text": "凝光是个不错的合作对象。不过我平日在外行走，得注意身份。总务司雇员见到七星，难免要尊称一声大人了。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于甘雨…",
      "text": "那位秘书啊…我不可能像她那样，时刻不停地工作。何况她的效率同样无可挑剔。半仙的血统大概给了她不少便捷吧，不用睡觉也能保持精力。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于刻晴…",
      "text": "我不太喜欢把日程排得很满的人，他们没有给自己留下调整的余地，只要碰上意外，就会手忙脚乱，连累同僚。但「玉衡」不同，她总是有条不紊地办事，每次与她共事，都令我相当愉快。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于烟绯…",
      "text": "烟绯啊，我还挺喜欢她的。不谈以前的交情，作为鼎鼎有名的律法咨询师，她是璃月港内诸多情报的交汇点。每次帮她搞定麻烦，我都能顺带收获珍贵的线索。但她似乎对我有些敬重过度了。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于魈…",
      "text": "家族的长辈们曾说，要对「护法夜叉」保持最大的敬畏。据说我那疯疯癫癫的先祖路过望舒客栈时，都会少见地安分下来，想必是被他那驱除邪祟的威压给照顾了。但若是有一天，我有幸与那位「降魔大圣」并肩作战，我还是会以任务为重，不可能因为他的身份而有所顾忌。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于香菱…",
      "text": "香菱啊，讨人喜欢的小厨师，挑选食材的标准完全不输琉璃亭和新月轩。有时我会去她那里买些风干后的绝云椒椒。她似乎不理解我吃辣的方式，我也不想和她解释，这是家族的传统。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于行秋…",
      "text": "我当然记得他，飞云商会家的小少爷。我经常和他们家来往。也许以后，他也会成为眼观六路的能人呢？"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于达达利亚…",
      "text": "那位愚人众的执行官？他在无意中给我带来了一些好处。我原本打算彻查「岩上茶室」的前任老板，但那位执行官下手更快，强硬地上门讨债，还公开了前任老板做的假账，让他获罪入狱。我也因此顺利接管了岩上茶室，得到了一个不错的据点。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解夜兰·其一",
      "text": "愿意在你身上下注，是考虑到你身份特殊，应当能为我找来不少通往「真相」的线索。呵，今天带来什么消息了吗？"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解夜兰·其二",
      "text": "交换情报讲究平等，和你讲些往事也无妨。托家族的福，我从千岩军的斥候那里学到了一些本事，挺早就入行了。虽然收集情报的过程会受到各种阻挠，但只要丢不掉性命，最后的赢家，总归是我…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解夜兰·其三",
      "text": "线索是一环扣一环的，沿着它们不断追查到一切的根源，才算是个了结。为此，我有必要将耳目散布到各行各业去。在这个过程中，难免就要扮演各种角色。有些人形容我「一人千面」，这种说法，我就当成夸奖收下了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解夜兰·其四",
      "text": "有人告诫过我，贸然探查某些往事，有可能惹来杀身之祸。呵，我可不想停下，更不会因为别人的话就停下。哪怕无法改变事实，我也绝不能待在迷雾中。你呢？你的选择会是什么？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解夜兰·其五",
      "text": "说起来，你希望陪伴在你身边的我，是怎样的人？普通的合作对象？磨砺你的竞争对手？众多泛泛之交中的一位…还是说…重要的伙伴？依你的期望和态度，我可以「扮演」或「成为」他们中的任何人。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "夜兰的爱好…",
      "text": "闲暇之时，我会随机安排生活。方法很简单：列一张清单，投骰子来决定接下来要做的事。这种消遣能带来意想不到的乐趣，还能让我拓宽思维的边界，对于我的本职工作而言，也算有不小的帮助。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "夜兰的烦恼…",
      "text": "相较于一些武人，我的体能其实不算太好，这是家族遗传的毛病。处理某些不能怠慢的工作前，我会调整作息，积蓄精力，争取一次完事收工。除此之外的时间里，我会尽量保持悠哉的节奏。所以，体力活我会谢绝的。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "将风干后的绝云椒椒和琉璃袋的花蕊一同研磨成粉，均匀混合在云来白毫之中，沏一壶酽茶，它馥郁的香气必定会让你沉醉。相比咖啡和烈酒，我更偏好这种回味悠长的饮品。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "对于甜食，可得保持警惕啊。那种强烈的满足感…会削弱人的意志力，让人放松警惕。只要吃过几次，就有可能上瘾。长期吃甜食的人，或许会在不知不觉中变得迟钝吧。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "嗯，手艺不错，差点就要被你贿赂成功了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "吃惯辣味之后，其他菜总觉得不够劲。没办法啊。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "投个骰子吧？点数比我小的话…就你来吃？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "要是在这种日子里，我还警告你「别因为庆祝而松懈，会被人趁机暗算」，可就太不解风情了。总之，今天你可以尽情放松。来「岩上茶室」坐坐，尝尝我为你特意准备的点心吧？当然，点心不甜，只是微微辣。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "在我的工作中，战斗技巧从来不可或缺。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "唯有在必要时刻快准狠地出手，才能揭露某些谎言，排除沿途的干扰。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "探索「真相」听来简单，实则需要长期咬住线索的毅力，还有深入险境的实力。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我早已将你当成最为重要的线人。自然就要作好万全的准备，迎接你为我带来终极答案时附带的风险。走吧，我们去把它拿下！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "收。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "抓到了。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "别喊疼。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "终场~收工！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "丝线，交织。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "点数如何呢？"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "不必心急。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "取财有方。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "宝箱，也能引蛇出洞。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "散落的财物，无声的线索。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "有点扫兴…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不能敷衍了事呢…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "新的变数…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "点到为止，你退下。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "残局，让我来吧。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "哪一步…算错了？"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "这种失误…不合理…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "真相…还没揭晓…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "真有胆量。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "不对…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "咬住目标了？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "去收网吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "走吧，去打听点新消息。"
    }
  ]
}