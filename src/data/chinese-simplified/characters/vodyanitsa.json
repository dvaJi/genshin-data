  "outfits": [
    {
      "id": 214000,
      "name": "溯涌遗韵",
      "description": "沃雅妮莎的装扮款式。服饰的造型据说来源于「水妖」的各类传统文化，而这些传统文化具体为何，还请详询沃雅妮莎小姐。\n当然，若想详询，还请等到她演出暂歇，有些许空闲的时候。",
      "isDefault": true,
      "characterName": "沃雅妮莎",
      "characterId": 10000140,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Vodyanitsa_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你好，我是科洛列夫茨基剧团首席女高音沃雅妮莎，如你所见…喔，我的意思是看我耳朵，看着就不寻常吧，因为我是一名「水妖」，不过这个身份不重要，你只需要记住，在整个科洛列夫茨基剧团里，我唱歌最好听就行。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·听力",
      "text": "…嗯？你小声点，我好像又听见有人在说悄悄话，嘻嘻嘻，让我仔细听听看…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·练习",
      "text": "反正闲着没事，在这里练习一下吧，算了，好像又会扰民，或者扰动物呢…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·休闲方式",
      "text": "呼…又在陆地上待了这么久，皮肤都干干的，还是快点回水下休息一下吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "嗯，是个好天气，很适合躺在水底休息。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "就停了？没劲…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "白茫茫一片，哼，够干净的。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "好热，好干…想回水里去——"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好，我刚好也开完嗓了，你听见了？嗯，那也正常，毕竟我的歌声很有穿透力嘛。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "行了，吃午饭去吧，忙了一上午，我喉咙都要裂开了，等会去叫奥黛塔，我们简单吃一点。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "呼啊，一天终于结束了。等会再去湖里泡泡吧，你来吗？怕什么，我又不是那种会拖人溺水的水妖，但如果你想试试，倒也不是不行。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安喽。早点睡吧，明天早上我还要按时开嗓呢，当然，如果你有需要，我也可以换首歌。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于沃雅妮莎自己·歌声的魅力",
      "text": "很遗憾，我的歌声没什么能引人发狂的特别魔力，大家之所以愿意听我唱歌，只是单纯的因为我唱得好听而已。啊，但说到这个，我有一个关于矮灵的笑话，噗…呃，算了算了，不讲不讲，不然奥黛塔又要瞪我了。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于沃雅妮莎自己·审视",
      "text": "无论是不是演员，如果一个人想要被人们「看见」，那他就必须要接受人们的「审视」。这世上没有只占便宜，不付出代价的好事，就算有…呵，那也只是因为命运把价格标在了暗处。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·鱼尾巴",
      "text": "为了方便在陆地上走路，我就把鱼尾巴变成双腿了，代价？没什么代价啊。哼，我作为一个水妖都离开水了，这代价已经足够大了，我还能付出什么，从此之后不能喝纯净水，只能喝果汁或者枫达吗？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·郊游日",
      "text": "不过嘛，总是待在至冬也不行，我有时候也会顺着水源四处溯游，去看看其他地方的歌手是如何歌唱的。现在我已经去过了璃月，枫丹，稻妻，须弥…啊？有没有被人发现，有啊，嘻嘻，所以世界各地都流传着所谓「鲛人」、「人鱼」和「泉客」的传说啊。但我对纳塔的印象…呃，好热，然后还是好热。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "这个小玩意？很好看，当个挂饰挺不错的，但平时唱歌也用不上它，至于「被神明注视」…呵，比起这个，我更愿意被观众们注视。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "枫丹的水质真好啊，之前我去枫丹看演出的时候，忍不住钻进水底待了好久，还不由自主地咕嘟咕嘟喝了好多水，可能是我弄出的动静太大了吧，让一个在岸边训练的特巡队队员注意到了，她还以为我溺水了呢，大呼小叫地就冲过来想要把我救上岸，至于我嘛…当然是一甩尾巴，飞快地窜走喽，嘻嘻嘻，然后我在远处看着她一边踩水，一边茫然地四处张望，还挺好玩的。直到看着她安全回到岸边，我才回去水底继续咕嘟咕嘟喝水，真的很好喝，下次一起去喝点？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "你知道「霜鳍鲸」吗？它们会用常人听不懂——甚至听不见——的「鲸歌」互相交流，但我们「水妖」能听懂它们的歌声，甚至还能学会呢。我就认识一位脾气特别好的霜鳍鲸，它叫希托娃，我之前去世界各地旅游的时候，都是它带着我赶路的，有机会的话，我把它介绍给你认识，它肯定会答应载着我们出去玩的。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于奥黛塔…",
      "text": "每次奥黛塔去前台彩排的时候，我都会在后台仔细聆听她的舞步声。落下，跳起，旋转，再落下…干净利落，节奏规整，即使只是听声音，都能知道这绝对是一场完美的舞蹈演出…为什么我不去前台看？因为我要躲在后台吓她一跳啊。虽然每次都没吓到，但吓还是要继续吓的，不然我不是白躲了？"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于米提亚…",
      "text": "希望这位聪明的先生不要在剧院的观众席上继续解题了，我们剧院不是什么超级自习室，也不是逃避工作的避难所，请认真地享受演出。不然我就…呼，算了，我也不能做什么，他确实很遵守剧院的观演礼仪。哼，下次我要挑一首动静大点的曲子，我看他还能不能顺利地解题。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于阿罗夏…",
      "text": "我一直在想，阿罗夏的小狗们能听懂我唱的歌吗？应该听不懂吧，毕竟我们也听不懂小狗们的歌，甚至都不知道它们会不会唱歌…不过，我唱的摇篮曲确实对小狗们很有用，每次都是只唱了一个开头，小狗们就睡成一片。唉，也不知道这算我唱得好还是不好啊。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于薇斯纳…",
      "text": "多亏了薇斯纳小姐，那些倒卖剧院门票的票贩子们才不敢太嚣张。过段时间，薇斯纳小姐还打算邀请我开一场有关于预防票务诈骗的小型座谈会呢，在结束的时候，我还要唱一首歌作为闭幕。可我知道的歌里，也没有一首是能用来讽刺诈骗的啊，等等，战争里的战术欺骗，应该也能算是诈骗吧…？不、不然…来一首战争史诗…？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于达妮卡…",
      "text": "我和达妮卡小姐虽然不算很熟，但也听说过她的威名。达妮卡小姐过得真辛苦啊，一边要帮女皇陛下分忧，一边还要看住薇斯纳小姐…咳，我什么都没说，没说。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于女皇陛下…",
      "text": "如果女皇陛下来剧院观赏演出。那么我会为她演唱水妖们的「老歌」的。有多老？嗯…虽然还没老到只有女皇陛下听过的地步，但也足够吹起一阵小小的时光遗尘了，希望大家别被这阵扬起的尘沙迷住眼睛而流泪啊。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于哥伦比娅…",
      "text": "那位哥伦比娅小姐已经不再是执行官了？可惜，我一直很喜欢她的嗓音，她哼唱的曲子就像是月光一样，柔美、轻盈又冰冷，虽然近在眼前，却又触不可及。呵，希望她能找到一个好去处，还有一群能听懂她歌声的朋友。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于达达利亚…",
      "text": "达达利亚先生经常带着家里人来剧院里观看演出，不过，虽然执行官们可以免费入场，但他的家人们按照规定还是要如常购票的，好在，达达利亚先生总是能为自己的家人顺利弄到票。噢，冬妮娅你应该已经知道了吧，她也很喜欢演出，说不定等她长大之后，真的会加入我们剧院呢。到时候，达达利亚先生来剧院的次数恐怕又要增多了。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于阿蕾奇诺…",
      "text": "阿蕾奇诺女士有时候会带几个孩子来看演出，其中有一个孩子还有猫耳，我记得是叫琳妮特来着？她和那个叫林尼的孩子都很擅长魔术表演，有一次年终演出时，他们还在我们剧院的舞台上展示过魔术呢。不过，每次演出「山与雀」的时候，阿蕾奇诺女士几乎都是独自前来的…或许，她希望独自欣赏那场演出吧。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于桑多涅…",
      "text": "桑多涅小姐来看演出的时候，总是急匆匆的。有时候她咬着牙，眼角抽搐，有时候她面无表情，手里的稿纸却已经揉成了一团，看着好像是被人强行「请」来看演出的。我不想猜测到底是谁能「请」得动她，但…呵，至少每次演出结束时，她的表情都缓和了不少，看来是没白来。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于「队长」…",
      "text": "你说那位「队长」大人么？他…老实说，我并没有和他长时间地聊过天，最多只是演出散场时偶遇，简短地聊上几句。但我能感觉到，他是一个很严肃、正直的人。即使是在观众席的座位上，他也坐得十分笔直，就像是旗杆，或者是石柱，感觉无论多恐怖的风暴也无法将他折断或掀翻。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解沃雅妮莎·其一",
      "text": "有什么好奇的问题，问呗。不过你问一个问题，我也要问你一个，这才公平。没关系，我不会问那种很难回答的问题，只会问…那些我暂时没打听到的问题。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解沃雅妮莎·其二",
      "text": "虽然很抱歉打破了你的幻想，但至冬的「水妖」可不是传说中那种，会用歌声引诱水手发狂，或者是付出了巨大的代价才走上陆地，只要违反誓言就会变成泡沫的神奇物种，我们只是普通地生活在至冬，和所有人一样，仅此而已。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解沃雅妮莎·其三",
      "text": "自从那件事之后，水妖们几乎全部离开了至冬堡。我亲爱的兄弟姐妹们也邀请过我离开，但我拒绝了他们。如果至冬的各位市民突然听不见水妖的歌声，肯定会很难过，如果水妖的歌声被至冬遗忘，那我和其他的水妖们也会很难过。为了两边都不难过，我就留下来，继续唱歌了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解沃雅妮莎·其四",
      "text": "…时过境迁，如今的至冬已经大变样了，我的歌声，也不得不承载更多的东西，变得越来越复杂，沉重，不由自主…我不喜欢这样，所以我给自己定了一个规矩，每当我想回家的时候，就在至冬找十个人，看他们是不是真心喜欢我的歌声，如果十个人里哪怕有一个人是真心喜欢我的歌，那我就会留下，如果这样的人十不存一，那我就会回到我兄弟姐妹们的身边。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解沃雅妮莎·其五",
      "text": "呵，但不知道是幸运还是不幸，迄今为止，我总是能在那「十个人」里找到真心愿意听我唱歌的人，他们之中有人刚刚戴上了帽子，有人正昂首挺胸奋力拼搏，有人正坦然地走完人生的最后一程…即使是为了这些观众，我也会和那些萦绕在剧院之中的兄弟姐妹们继续唱下去。怎么样，你喜欢我的歌么？好好回答喔，水妖的听力可是很灵敏的，如果你撒谎，我就能听见你乱七八糟的心跳了，我来倒计时，三，二…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "沃雅妮莎的爱好…",
      "text": "每当我心情好——或者特别不好——的时候，我都会跳进水里，闭上眼睛，让水流带着我四处漂流。我一边漂流，一边听着波浪为我带来的各种声音，小鱼们聚在一起，鳞片沙沙摩擦；巨鲸低沉地长吟，呼唤着遥远的同伴；水底的气泡浮起又破灭…偶尔漂流到城边，还能听见渔民喊着号子撒下渔网；孩子们欢笑着跃入水中；准备远航或已然归港的船吱呀作响…这样子聆听世界之声的感觉，可是很奇妙的，你想试试吗？下次带你一起去呗。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "沃雅妮莎的烦恼…",
      "text": "我不喜欢被赋予太多意义的声音，歌声就只是歌声，就好像波浪带回的信音，枯叶凋落在地的脆响，或者是奔跑的脚步声…声音背负的东西越多，就越难被理解，也就越难听。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "甜的就行，最好要冰冰凉凉，还带着点甜汤…啊，这么一说，不就是冰淇淋嘛。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "毫无水分的东西，我实在咽不下去，如果强行吞咽的话，我会有一种自己的喉咙都被划破的错觉。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "很好吃喔，怎么，上次我说了自己喜欢的口味，你就记住了？记性还不错啊，下次我也给你做点合你口味的食物吧。你没说过自己喜欢的口味？没关系，我已经知道了，我有自己的方法打听。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "谢谢。哦对了，上次我和你说过我最喜欢吃的东西，你还记得么？记得啊，嗯…记性不错，那下次我再说点难记的吧，嘻嘻嘻。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "…下次，我还是清楚地把我喜欢的口味告诉你吧。或者，我直接教你做点好吃的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐！礼物我就放在那边了，等会你自己拆开来看看吧，大概就是一些小饰品和玩具之类的…哎呀，这个不重要，你现在应该没什么事要忙吧？走走走，去我的「回音室」，我前几天托人从纳塔采购了一台「热舞乐台」，还有其他很多奇奇怪怪但很好玩的乐器，我正准备办一场整个至冬最棒的音乐聚会，猜猜谁第一个被邀请？没错，就是你，来吧，今天我们唱一个通宵！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "咳咳，咳——声音不错。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "好像可以唱得更高了。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "喉咙的状态更好了。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "嗯！该彻夜高歌了！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "仔细聆听。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "先开开嗓吧。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "登台时刻到了。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "这样才痛快——"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "嘻，瞧我的鱼尾巴。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "呼啊！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "这首，是遗尘的挽歌。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "这首，是旧日的颂曲。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "所有人，一起高歌吧！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "哎呀！这么多亮闪闪的宝贝，快收起来。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "看着还行，拿着玩玩倒也不错。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "里面装着这些？宝箱？好吧…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "呵呵…呵…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我玩够了。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "…真是够蠢的。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "喂！干什么呢？！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "过来！别乱跑了！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "呵…你们来了…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "波涛啊…带我…归乡…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "终曲…？也不错…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "脚滑了…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "哼！还没完呢…！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "有本事去水里！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "陆地真不方便…！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "我听见你叫我了。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "来了，有什么事？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "咳…嗯，嗓子状态不错。"
    }
  ]
}