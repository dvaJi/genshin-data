  "outfits": [
    {
      "id": 208300,
      "name": "魅影猫",
      "description": "琳妮特的装扮款式。猫藏匿在暗影中，只在它想要现身时才走进人的视线，就像魔术助手小姐一样，让人捉摸不定。",
      "isDefault": true,
      "characterName": "琳妮特",
      "characterId": 10000083,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Linette_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "初次见面，我是林尼的魔术助手，工作事宜请咨询林尼。观看演出请咨询售票处。找我？…请长话短说。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·喝茶",
      "text": "茶泡好了，接下来可以休息一会儿了。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·哥哥",
      "text": "林尼好像又在说什么奇怪的话了…真让人放心不下。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·发呆",
      "text": "进入待机模式…希望不要有人来打扰我。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "雨天适合发呆…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "雨过天晴…",
      "text": "这就天晴了，可惜。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "打雷的时候…",
      "text": "唔…耳朵疼。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "下雪的时候…",
      "text": "冷…把你藏到帽子里吧。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "阳光很好…",
      "text": "太阳底下没有新鲜事…真是这样吗？"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "刮大风了…",
      "text": "风里传来的气息…不，没什么。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早安…充能尚未完成，即将再次休眠。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "我习惯工作之前喝一杯茶，能转换心情，也能保持清醒。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "太阳下山之后，人们内心潜藏的欲望，就会浮上水面…我是说，晚上的演出会很精彩。要给你留票吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "快睡吧，我还要处理白天没做完的事情…（还要把弄坏的吸尘器修好。）"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于琳妮特自己·魔术",
      "text": "表演的时候，我一般担任林尼的助手，因为一直不说话也不做表情，有人以为我是魔术人偶…这种误解能避免不必要的交际，倒也不错。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于琳妮特自己·情报",
      "text": "沉默有助于集中精神，看清有用情报。曾经来看演出的某位贵客，掏出了不属于他太太的手帕…至于情报的具体用途，嗯…就看那位大人的意思了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·倾听",
      "text": "我不习惯主动表达，但应该算是个不错的听众。如果有什么烦恼，就来找我吧。我会为你保密。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·兴趣",
      "text": "我曾经以为，金色的「太阳」和夜色的「暗影」，是无法互相理解的，可你身上有着奇特的复杂性，让我产生了不必要的好奇心…今后也让我继续观察你吧。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "比起武力，我更喜欢用自己的眼睛掌握现状，找到合适的解决方法。不过，拥有力量就会拥有更多底牌，就能在危急情况下保护重要的人。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "泡茶是一件看似简单实则费心的事情，茶叶的品质、茶水的温度、冲泡的次数，只有所有的变量都控制恰当，才能泡出味道最纯正的茶。要来一杯吗？"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "小动物们也会表达自己的情绪，如果仔细聆听的话就会知道它们现在的状态。对于小猫来说，「喵~」比起「喵喵喵！」，前者心情更好，这时候不管怎么摸它都不会逃走哦。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于林尼·默契",
      "text": "我和林尼一直都待在一起，我们即使不开口也能明白对方的想法，所以单独相处时，他会比平时要安静。你问我他说的哪些是真话，哪些是假话？其实我都知道，但这是最高保密事项。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于林尼·担忧",
      "text": "林尼平时总是自信不疑，做起事来游刃有余，或者说，他让所有人都以为他一直如此，所以在遇到麻烦的时候，他也总会想要一个人完美地解决…如果遇到这种情况，还请多多关照他吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于菲米尼…",
      "text": "他是个细腻温柔的孩子，却有些喜欢妄自菲薄…或许是和之前的经历有关吧。有时候他给我的感觉就像是林尼的反面…既然两边都是我的家人，意见不合时，我会负责弥合分歧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于「父亲」…",
      "text": "「父亲」表达爱意的方式…不一定能被每个人接受，但就是因为有「父亲」在，家…才得以为家。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于那维莱特…",
      "text": "最高审判官总给我一种奇怪的疏离感，明明言行谈吐都很谦和…还是说，他也不怎么喜欢跟人打交道呢？不过他和美露莘们说话的时候，倒是很亲切。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于芙宁娜…",
      "text": "芙宁娜大人的行为太难解读了，也观察不出什么有用的情报，总觉得她一举一动像是在扮演不同的人…不愧是神明，不能用普通人的角度来揣测。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于娜维娅…",
      "text": "虽然是「刺玫会」的新会长，作风却像邻居家爱管闲事的大姐姐呢。要是「家」里真有这么一位姐姐就好了…啊，这话好像不太合适…"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于克洛琳德…",
      "text": "我曾经奉命观摩过她的决斗，仅仅是从旁观察，就能感觉到令人害怕的寒意…真不知道在决斗场上直面她会是什么感觉…嗯，希望这辈子都不要知道。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于千织…",
      "text": "我跟林尼的演出服都是请她定制的。有一次林尼用小刀表演魔术，不小心划到了袖口，后来被她数落了好久…真可怕。幸好每次去她店里，都可以躲到林尼背后。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于夏洛蒂…",
      "text": "呃…我后来也被她抓着采访过几次。明明被林尼拒绝了那么多次，真是毅力可嘉…可惜她准备了这么多问题，我一个也没回答。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于艾梅莉埃…",
      "text": "这位香水设计师小姐的作品热门到需要凌晨排队抢购。但我对香水的味道太敏感，打出喷嚏来就太失礼了…所以只能绕着走。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于爱可菲…",
      "text": "嗯…看爱可菲今天的尾巴…估计是开发出让她满意的新甜点了，期待下次茶话会。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解琳妮特·其一",
      "text": "如果要解释魔术，就会失去看表演的乐趣，人际关系也是这样，想了解我的话，不妨一点点收集信息，拼凑答案吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解琳妮特·其二",
      "text": "人是很复杂的生物，即便不是有意欺瞒，也会不自觉地隐藏自己的真实一面。虽然我总能注意到一些「多余」的细节，但除非必要情况，我不会拆穿别人的伪装。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解琳妮特·其三",
      "text": "魔术曾经是我和林尼的谋生手段，现在更多是一种便利的社会身份，以魔术表演的名义，我们就能融入这座城市，成为家的「眼睛」。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解琳妮特·其四",
      "text": "在来到新家之前，我和林尼一直到处流浪，经历了许多艰难和危险的状况。从那时起，我便习惯时刻注意一切危险的迹象，也逐渐学会解读他人的所思所想。好在，如今我们拥有了一个安身之所。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解琳妮特·其五",
      "text": "建立人际关系是一种赌局，无论掌握多少信息，都难以预测人心的变化。一直以来我习惯待在安全的距离，但如果是你的话…我愿意承担输掉的风险。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "琳妮特的爱好…",
      "text": "人的精神和弓弦一样，如果一直绷得太紧，就会有断裂的风险。所以在工作之外，我会做一些能放松神经的事情，比如泡茶、喂猫、发呆。平时心情越是平静，就越能应对将来的危险。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "琳妮特的烦恼…",
      "text": "我不是很习惯操作机械，一旦不注意就会出现意外状况，有一次在雨天搞坏了烘干机…还好菲米尼很擅长修理东西。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "撬开贝壳，在新鲜贝肉上挤点柠檬汁，连餐盘都不需要了。完美。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "调料过重的食物，不行。食材就是要保留原始的口味才好。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好吃，配方我已经记下来了。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "谢谢招待。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "调料的比例，再斟酌一下吧？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐！卡片给你…这不是贺卡，当然没写东西了。写下你想要的礼物，放进我的帽子里，不管是什么，都会为你准备的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感知更敏锐了。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "思考速度…继续上升。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "看到了，胜利的条件。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我竟然能获得这样的力量…这样我也能站在你的身前了吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "一点把戏。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "在这里。"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "惊喜。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "魔术开场。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "来点灯光。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "请看这边。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "宝物的气息。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "不出所料。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "轻松到手。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "保持冷静。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "我得集中精神。"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "启动应敌模式…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "快退后。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "我来吸引火力。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "我…看漏了什么…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "魔术失误了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "林尼…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "还好。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "啊，没躲开。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "魔术要开演了吗？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "下午茶时间到了。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "你带路吧。"
    }
  ]
}