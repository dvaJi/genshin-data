  "outfits": [
    {
      "id": 205600,
      "name": "严正净衣",
      "description": "九条裟罗的装扮款式。洁净端正，足以面神的虔信者装束。",
      "isDefault": true,
      "characterName": "九条裟罗",
      "characterId": 10000056,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sara_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "我的名字是九条裟罗，你记不住也无妨，只需知道：我将永远护卫稻妻、践行鸣神的意志，不论神鬼，遇敌必除！呼…别紧张，既然答应与你并肩，我自当尽心尽职。大义外的事情，我不会计较的。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·正鹄",
      "text": "只有保持心、弓、箭三位一体，才能命中正鹄。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·永恒",
      "text": "为将军大人实现「永恒」，这就是我的「愿望」。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·使命",
      "text": "天狗的职责是护佑山林，九条家的使命是守卫稻妻，两者并无二致。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "雨滴的声音会掩盖脚步声，多加注意吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "听见了吗？鸣雷正是将军大人的意志。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "想要留住雪花。但在手心里，它只会融化得更快。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "天清气朗，适合演武。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上吗？对于我而言，这已经不早了。通常我睁开眼时，天还没亮。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "我没有午休的习惯，但如果你想，我可以等你。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好。随口一提，花见坂的夜樱，是不可多得的景致。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "去休息吧，这里有我看着就行。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于裟罗自己·天领奉行",
      "text": "家主于我有恩，「天领奉行」是我唯一的依靠，我会倾尽一切来捍卫家族的荣誉。嗯？你问「天领奉行」的行事准则？那自然是忠于雷电将军大人，这也是我九条裟罗此生唯一的信条。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于裟罗自己·备战",
      "text": "「准备好了吗？」如果在出发前，你有这样确认的习惯。十次中，恐怕只有一次，你能听到我的答复。其余九次，我已经化身利刃，身处前线。这并非蛮勇或不忠，而是战场从来不会留给人喘息的时间。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于裟罗自己·愿望",
      "text": "我的愿望？我原以为你早已知道，辅佐将军大人实现「永恒」就是我的愿望。嗯？为自己所想的愿望？这种东西，我没有想过…"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·观察",
      "text": "虽然你对于将军大人的「永恒」而言是个「不安定」的因素，但「不安定」也未必代表「阻碍」。我不会与你为敌，但，我会一直盯着你。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于我们·体会",
      "text": "收缴神之眼时，我漠视了人们的愿望。在眼狩令已然结束的当下，我有责任作出弥补。听说你能听见千手百眼神像上那些神之眼蕴含的愿望？请跟我好好讲讲吧。还有…也跟我说说你的愿望吧，我想知道。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "得到神明的注视，才能获得「神之眼」。既然我的「神之眼」是由将军大人所赐，最后，我也会将它还给将军大人，不怨不悔。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·陀螺",
      "text": "上次执行任务时，花见坂的商户送给我一个名为「独乐」的陀螺，那是种「一个人也能玩」的玩具，我觉得挺有意思，就留在了身边。你说…一起玩？那岂不是违背了「独乐」的原则，请容我拒绝。"
    },
    {
      "id": "3004",
      "type": 1,
      "title": "有什么想要分享·特产",
      "text": "知道稻妻最具代表性的特产是什么吗？不对，并非刀具。是「御建鸣神主尊大御所大人像」造型的漆器，由老练的漆器师傅手工打造，城内几乎每家每户都供奉着一座。我的屋里？有五座。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "当我心中有难解之事时，我会伫立在神樱树下闭目养神，再次睁开眼时，飘落的花瓣就会为我指引方向。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于托马…",
      "text": "「天领奉行」的宅邸很大，如果有像托马一样优秀的家政官就好了，一定能将家中纷繁事务打理妥当。要是什么时候，他不再想侍奉神里家了，我很希望他能过来帮忙。不过大概不会有这一天吧。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于神里绫华…",
      "text": "平时在九条家，只有士兵们在道场训练的声响，而每次路过神里家，总会听见舞乐声、打闹声和笑声。听闻神里家的大小姐棋技了得，我一直等候时机，想要登门拜访，却又担心…像我这般严肃的人，是否会与那般氛围格格不入呢。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于宵宫…",
      "text": "只要她不在我的军营里乱放烟花，我是不会找她麻烦的。哼，我知道，抛开别的不谈，她做的烟花的确流光溢彩，值得称赞。只不过烟花易逝，刹那光辉结束后，夜空上留下的依旧是黑暗。所以我时常提醒自己，想要贯彻护佑稻妻的使命，就不能沉沦在这些虚幻的光景中。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于鹿野院平藏…",
      "text": "鹿野院…虽说这位是我的同僚，但我对他没什么好感。总感觉他有很多自己的盘算，没有把组织的事放在第一位。要不是看在他探案有功的份上，早该对他多加管束。\\n唉，真是头疼。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于雷电将军·相信",
      "text": "你肯定从不少地方听说过吧？将军大人追求的是无念无执的永恒，舍弃尘世的执念，执着不变的永恒。将军大人的言行决断，我并非每一处都能参透。但既然这是她的决定，我便相信她。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于雷电将军·追随",
      "text": "「眼狩令」废除…嗯，看来你才是对的。咳…但这并不说明将军大人是错的。只是追求「永恒」之路的方式将要改变罢了。不知那位千百年来守护着稻妻的将军大人，如今心中是否平静呢。我只知道，不管道路上有多少险阻，我都会一如既往追随她。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于八重神子…",
      "text": "八重宫司大人的所作所为，经常会让我产生误会…但她既然贵为鸣神大社的大巫女，不难得见将军大人对她的信任与默许，我自然也会敬重她。不过，如果哪天她做了忤逆将军意志的事情，那就恕我冒犯了。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于珊瑚宫心海…",
      "text": "比起「巫女」，她作为「军师」的才能更高。用锦囊打仗，此前实属闻所未闻。我是否也该学习着用这种方法来指挥幕府军呢？嗯…但这样恐怕会演变成双方把锦囊摆上台面，像卡牌一样逐张对战…想想还是不妥。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于五郎…",
      "text": "他之于珊瑚宫心海，正如我之于将军大人。同为坚守忠义之人，我很欣赏他。只可惜立场不同，注定没办法同行。但有这样值得敬佩的对手，还不赖。而且，「五郎」…可是个好名字。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于荒泷一斗…",
      "text": "…说起这位，难免有些头疼。收缴他的神之眼时闹了不少动静，是我见过最聒噪的人…不，最聒噪的鬼。能堂堂正正认输算是有点男子气概，只不过他的复仇之约实在是…到此为止，我不想说了。你如果实在想知道，还是自己去问他吧。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于久岐忍…",
      "text": "以她的才华和资质，留在那个名为「荒泷派」的组织实在有点可惜。但不得不说，有她在，至少有效地阻止了闲散人士滋事扰民，减轻了天领奉行的负担。"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于绮良良…",
      "text": "近来总觉得暗处有奇怪的视线，待我确认时又消失无踪。真是不明所以的恶作剧。你说…是只猫又？嗯…既然有事找我，堂堂正正报上名来就行。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解裟罗·其一",
      "text": "了解我…请问是指什么？天领奉行的各项事务均为机密，将军大人的事情更是无可奉告，我不明白你有什么意图。嗯？了解我本身？倒也并非不可，只是…从未遇过这种情况。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解裟罗·其二",
      "text": "我的生活还算简单，不用领队战斗时，我会准时在凌晨五点零五分起床，在庭院做五组深呼吸后走五圈，早饭习惯吃五口米饭…「五」是能为我带来幸运与胜利的数字，所以我会一直坚持「五」，请问你有什么异议吗？"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解裟罗·其三",
      "text": "执行眼狩令的过程中，最令我感到棘手的，是那些顶着幕府军头衔动用私刑的官兵。将军大人的任务固然要坚定执行，但我决不允许他们滥伤无辜！我已经三申五令禁止这种行为，就结果而言…依然难以杜绝。你若是有什么好办法，还望赐教。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解裟罗·其四",
      "text": "虽然名义上是九条家的养子，但孝行大人看我的眼神，与看镰治时的不同。即使木讷如我，也会偶感寂寞，尤其…在看到部下与亲人相见的温暖场面后。\\n抱歉，家主于我有恩，原是不该说这种大不敬的话的…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解裟罗·其五",
      "text": "现在回想起来，你我也算「不打不相识」。我们一度处于对立面，说势不两立也不为过，真没想到现在竟然能这样并肩而行，促膝长谈。这样想来，我还真是得到了命运的眷顾…不，没什么。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "裟罗的爱好…",
      "text": "即使到了现在，素引练习和草靶练习依然是我每天必不可少的训练项目。从身法到瞄准再到听弦，绝不是枯燥的重复，而是对昨日的突破。与其说是爱好，不如说是一生的修行。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "裟罗的烦恼…",
      "text": "天狗的翅膀是固有的客观存在，并排站的话肯定会占据一定的空间，我不明白你说的「拉近距离」究竟要怎么实现。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "长久以来，我已经习惯吃饭团之类方便携带、能够迅速饱腹的食物了，这也是战场上恢复体力的首选。不过，这只是个人习惯，我不会要求部下跟我一样。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "没有厌恶一说，只是我平日会避免吃甜食。问我原因吗？甜食会使人身心放松，一旦吃了就容易…呃，总之，我不能懈怠，话题到此结束，不要再追问了！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "比饭团更美味的食物…值得记下它的名字。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "我吃饱了。多谢款待。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "甜点还是不必了…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "来得正好，那我就免去礼节，直接问了。有什么生日愿望吗？只要不与将军大人的大义相悖，我都会竭尽全力帮你完成。为表诚意，今天你可以许五个生日愿望。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "满意的弦音，看我一击即中。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "力量已经融入我体内，随时听命。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "我一个人，就是一支幕府军！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "磨炼自身，突破武艺，本是我的职责所在，但你却倾尽心力相助…我不会辜负这份力量，定将其用于大义！还有，天狗的情谊，与你同在！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "羽移！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "散！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "雷闪！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "常道恢弘，鸣神永恒！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "落雷…不悔！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "雷光千道！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "不错的宝物，能够提振士气！"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "很好，没有放过任何角落。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "补充完就上路吧！"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "我会坚持到底…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "必须寻找突破点！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "快到极限了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不要勉强！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "退下！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "生命终非永恒。"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "我绝无怨言…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "哼，是我败了。"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "再来！"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "不错的对手…"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "怎么会！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "战况不顺…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "我会带领你获得胜利。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "哼，来吧。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "与你并肩！"
    }
  ]
}