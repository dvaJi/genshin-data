  "outfits": [
    {
      "id": 212800,
      "name": "北风起誓",
      "description": "法尔伽的装扮款式。比甲胄更颠簸不破的是骑士的信念，比剑锋更一往无前的是北风的决绝。穿上这身铁衣，立下这道誓言——恍如昨日，已是经年。",
      "isDefault": true,
      "characterName": "法尔伽",
      "characterId": 10000128,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Varka_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "再自我介绍一次——虽然你可能都已经听厌了。我是法尔伽，西风骑士团的「大团长」，蒙德的「北风骑士」，前来履行骑士之间的盟约——以我的剑起誓，我绝不会让你先于我倒下。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·饮酒",
      "text": "人逢喜事千杯少，没喜事也少不了…哈哈…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·武器",
      "text": "武器要时常养护。平时多照顾它们，关键的时候才能指望它们照顾我们。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·休憩",
      "text": "呼——离开办公桌的感觉真好，找个地方多睡一会儿吧？"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "雨过天晴…",
      "text": "雨停了，继续行军吧。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "下雪的时候…",
      "text": "下雪的时候，总会想起远征途经过的地方。"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "刮大风了…",
      "text": "哎哟，这么大的风，是要和我对着干喽？"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好！怎么这么没精神，要来一杯提提神吗？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "中午好！午休的时间到了，该歇就歇吧。中午不睡，下午更累！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "晚上好！今天费了不少力气吧，要来一杯助眠吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "晚安吧，就连风也要歇息。我会守在帐外的。不需要人守夜？噢…对，现在已经不是露宿野外了，看把我习惯的…"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于自己·北风骑士",
      "text": "「北风骑士」是人类与北风王狼之间的桥梁。但在这一千年里真正能被王狼认可的骑士并不多见。至于我嘛…哈哈，那当然得算一个，真得不能再真了。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于自己·远征",
      "text": "为了守护蒙德城周边的安定，我曾经发动过不少次「远征」，但比起这一次，都算不上什么…比如清剿达达乌帕谷、联合千岩军扫荡石门、从鹰翔海滩出发迎击外海魔物…嗯？你说难怪在这些地方都遇不到什么强敌…我应该还是留了些下来给人练手的吧？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·异乡人",
      "text": "蒙德是自由的城邦，无论是罪人的子嗣、漂泊的魔神，还是异乡的旅人，都能在这里找到自己的安居之地。所以，不用跟我客气，你可是我们的荣誉骑士呀！"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·捕风",
      "text": "「从千风之中锚定独一的思念，捕捉出无二的那一缕…」\\n这是巴巴托斯当初对于如何逆转同化的说明，如果不能将自我与王狼分离，就无法避免汇入地脉的命运…当时我没太听懂，实际体验过一遍之后…还是没太搞懂！不过还好，不用再经历下一次了。\\n仔细一想，从地脉归来之后，还没正式向你道谢呢。那不如就趁现在吧？咳咳…\\n——你抓住我了啊，「捕风的异乡人」。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "记得刚拿到神之眼的时候，我还是个莽打莽撞的愣头青，为自己能得到风神的注视而兴奋了好半天。但后来真的认识了巴巴托斯，才知道不是这么一回事…少年的幻想又破灭了一个啊——但好在它带来的力量，和带来它的愿望，永远不会改变。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·四风守护",
      "text": "其实我一直没搞清楚「四风守护」这名号是怎么来的。你看，东风之龙、西风之鹰，还有南风之狮，都有明确的指向吧？但「北风之狼」既可以指玻瑞亚斯，又可以指我。而且「西风骑士团」成员还包括了「狮牙骑士」跟「北风骑士」，也就是说「西风」里其实包括了「南风」跟「北风」？这说得过去吗？\\n嗯？你说没准只是哪个吟游诗人，想要凑一个听起来很厉害的数字？好吧，那倒是不难理解了…"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻·猫与狗",
      "text": "蒙德城里曾有过「猫派」和「狗派」的争论。虽然「北风骑士」听上去很像是会推崇狗的那一派…但我其实也很喜欢猫来着？有活力的小狗确实很可爱，可是安静的小猫有些时候也很善解人意吧？要是有机会收养的话…嗯，果然还是得全养了！"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于温迪…",
      "text": "巴巴托斯啊，虽然平时看起来自由又随性，但做起正事来可比谁都正经。还有他对酒的品味我也很赞同，不愧是我们蒙德的神明！…嗯？你说这些评价听起来像在说我自己？哈哈，不敢当不敢当，我怎么可能跟风神大人相提并论呢！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于雷泽…",
      "text": "以前刚见到雷泽的时候，他大概只比奔狼领的幼狼高出半个头，光是举起大剑就费劲。不过比练剑更费劲的，还是怎么陪他说话，我大概花了半年时间才掌握跟他沟通的技巧。他现在都已经交上那么多朋友了…时间过得真快呀。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于罗莎莉亚…",
      "text": "嗯…为了避免事后被她嫌多嘴，我还是保持沉默吧。她的那种眼神还是挺有寒意的。有什么想了解的，可以直接去问她。我想她现在…应该已经愿意跟你们谈及往事了。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于迪卢克…",
      "text": "所以，他还是不愿意回骑士团吗？哈哈，那就随他去吧，蒙德的风一直是来去自由的。他有不回来的自由，我也有接着劝的自由。不过嘛，也得控制下程度，要是啰嗦过了头，他不让晨曦酒庄卖酒给我了怎么办？那可是天大的危机啊！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于凯亚…",
      "text": "我很清楚克利普斯先生在凯亚心里的分量，他在那场变故中遭受的打击绝不亚于他的义兄。但即使遭逢不公，兄弟阋墙…他依旧决定留在骑士团内。后来揪出伊洛克的时候，他也出了很大的力。既然他选择信任我们，那我也会选择信任他——无论他身负着怎样的过去。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于琴…",
      "text": "我其实一直觉得琴在才干和心性上都比我更能胜任「大团长」这个职位，可惜我再怎么费尽口舌，她都自谦资历尚浅——明明我当初上任的时候也没多大啊！荣誉骑士，你要是有机会，能不能也帮我多劝劝她…嗯？想彻底把工作都推给琴？我绝对没有这么想过哦！真的没有！对着酒发誓？呃，这是否有些太严格了…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于诺艾尔…",
      "text": "那孩子在力量上的天赋连我都很惊讶，听说她现在也在向琴学习单手剑的技巧，不知道等她把双手剑跟单手剑都融会贯通之后，有没有机会继承我的…嗯？你说她上次把单手剑丢上了天花板？好吧…看来还得再给她安排些训练。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于洛恩…",
      "text": "这小子三天两头出去闹事，我曾经以为他跟从前的我一样，是热衷于挑战强者、赢取荣耀…哪知道他只是喜欢「挑战」，对「荣耀」没有半分兴趣…嗨，起码在外头干架，比没事就挖陷阱偷袭我要好点。"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于米卡…",
      "text": "人生迷茫的时候得靠导师引路，行军迷茫的时候要靠地图引路——照这个说法，说他是我的导师也不为过吧，哈哈哈！——可惜我上次跟米卡开这玩笑的时候，他的脸刷一下就白了…其实他完全可以再自信一些吧？可不是谁都能成为骑士的啊！"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于优菈…",
      "text": "本来我还在计划，派人去荆夫港接应部队的事，优菈告诉我她已经安排好了。我看了调度，十分得当。没想到她心思那么缜密，而且这回连嘴上的别扭都没闹。哈哈，没什么比看到骑士们的成长更让人高兴的了。"
    },
    {
      "id": "4011",
      "type": 1,
      "title": "关于安柏…",
      "text": "那孩子很热情吧？作为侦察骑士兼飞行冠军，她经常活跃在蒙德郊野，帮助有需要的人。很多来蒙德的客人头一个遇到的西风骑士就是她，都快成为我们的门面了。嗯？你说她也是你在蒙德遇见的第一位骑士？哈哈，不愧是她！"
    },
    {
      "id": "4012",
      "type": 1,
      "title": "关于阿贝多…",
      "text": "阿贝多刚来蒙德的时候，我就觉得这孩子哪里都好，完美得就像「别人家的孩子」，又谦逊又得体…不过换个词就是又拘束又谨慎。我倒是希望他能更自由自在一点？毕竟这儿也不是什么「别人家」嘛。还好，现在他都会揶揄我的画技了，哈哈！"
    },
    {
      "id": "4013",
      "type": 1,
      "title": "关于杜林…",
      "text": "说句实话，当初从报告里听说「杜林」要出世的时候，我的心脏都漏跳了半拍，当时就想调兵回守蒙德…好在此「杜林」非彼「杜林」，蒙德昔日最大的隐患之一，如今却成了我们最值得信赖的助力…命运还真是反复无常啊。"
    },
    {
      "id": "4014",
      "type": 1,
      "title": "关于可莉…",
      "text": "「火花骑士」逃出禁闭室的功夫是不是越来越熟练了？看来她有在好好研习我留下的经验教训…该反过来向她学习了吗…啊，不，没什么，我说的是画画技巧。另外，你不会告诉琴跟阿贝多的吧？嗯…艾莉丝女士也不要，谢谢。"
    },
    {
      "id": "4015",
      "type": 1,
      "title": "关于艾莉丝…",
      "text": "在艾莉丝女士的诸多名号里，我最羡慕的还得是「诸世界的大冒险家」。我年轻的时候也走过不少地方，但每次听艾莉丝女士讲述她见过的风景，都得挠破头皮才能想象出那些奇景的十之一二。不知道等我将来卸任了「大团长」，有没有机会再开开眼界…不过到时候我还有没有力气走动，又是另一码事了，哈哈。"
    },
    {
      "id": "4016",
      "type": 1,
      "title": "关于尼可…",
      "text": "尼可女士身上有许多值得我学习的地方，比如说方向感奇佳，永远不用担心行军时迷失方向；再比如能用心声说话，可以横跨战区隐秘通讯…什么？你说拿天使的能力干这些事都太大材小用了？明明都很实用吧！"
    },
    {
      "id": "4017",
      "type": 1,
      "title": "关于芭比洛斯…",
      "text": "我曾从芭比洛斯女士的水占盘里窥见未来的倒影，她说那是命运本身试图向我展示的景象…那「命运」是否也预见了我会去改变它？又能否预见如今的结果？\\n哼…我的答案是，没必要考虑那么多。烦恼这些只会让我的剑变慢。无论命运让我看见了什么，我都只会去做自己认为正确的事。"
    },
    {
      "id": "4018",
      "type": 1,
      "title": "关于爱诺…",
      "text": "刚遇到爱诺的时候我一度很担心，这么小的孩子要怎么一个人在挪德卡莱长大…后来我才意识到自己错了，她并非独自一人，也无需任何人的担心。每个孩子都会以自己的方式成长，强行套用自己的观念去担心他们，反而不是什么好事吧。"
    },
    {
      "id": "4019",
      "type": 1,
      "title": "关于伊涅芙…",
      "text": "当初请她去给你们送信的时候，我还真没想到她的来路有这么多曲折。生于囹圄之中的灵魂，最终超越诅咒拥抱「自由」…这事如果传到蒙德，绝对能编成一首壮丽的史诗！「温妮莎」也好，「花羽会」也好…打碎锁链追求「自由」的故事，总能让人热血沸腾啊。"
    },
    {
      "id": "4020",
      "type": 1,
      "title": "关于菲林斯…",
      "text": "经常有人把「骑士精神」跟「贵族精神」混同，要是放在以前，凭旧蒙德那帮家伙的作风，我怎么都得反驳几句…不过要是「贵族」们都能像菲林斯先生一样，哈哈，那我们还是能坐在同一张长桌旁开怀畅饮的。"
    },
    {
      "id": "4021",
      "type": 1,
      "title": "关于奈芙尔…",
      "text": "在远征军抵达挪德卡莱之后，「北大陆情报网」帮了我们许多，未来我也打算继续维持这良好的合作关系…我都为自己想好代号了，就叫「天狼」，怎么样？很帅吧？"
    },
    {
      "id": "4022",
      "type": 1,
      "title": "关于雅珂达…",
      "text": "虽然嘴上总在抱怨，但她干起活来真不是一般的麻利，不愧是从鱼龙混杂的挪德卡莱脱颖而出的宝藏猎人，我都想招她进骑士团了！可惜，那就得从她老板手里挖人了，而且…恐怕她自己也不会想要跳槽吧，哈哈，原来还想给她开两倍薪资呢，还是别问了吧。"
    },
    {
      "id": "4023",
      "type": 1,
      "title": "关于玛薇卡…",
      "text": "无论是作为人，还是作为神，那位火神都是一位令人敬佩的战士。要是能生在纳塔，不知道有没有机会跟还是人类时的她过上两手…不过生在纳塔不就守护不了蒙德了吗？不行不行…唉，果然还是算了。"
    },
    {
      "id": "4024",
      "type": 1,
      "title": "关于「队长」…",
      "text": "我与他仅有一面之缘，但…是吗，坎瑞亚的骑士…「天柱骑士」瑟雷恩…原来他也走向了自己的征途。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解法尔伽·其一",
      "text": "哦？我有什么值得你好奇的吗？…在图书馆里有本《关于法尔伽的一百个事实》？有点意思，我都不知道还有这么一本书，那就来对对账吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解法尔伽·其二",
      "text": "「从没有北风骑士声明过自己是历代最强，因为骑士的美德里既有谦虚，又有诚信，直到出现了法尔伽——因为法尔伽这么声明的时候，既是在表达谦逊，也是在宣告事实。」…噗。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解法尔伽·其三",
      "text": "「蒙德的四风守护也曾指法尔伽的主手剑、副手剑、左飞踢和右拳击。但完整见识过的人都不在了，所以只留下了现版本的四风守护。」…咳，这不至于。光凭我一个可干不完四风守护的活。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解法尔伽·其四",
      "text": "还是收起那本书吧，太夸张了，不知道是哪个喝醉酒的家伙写的。正如你所见，我只是一个凡人，活生生的凡人。会受伤，会流血，会老去。所以也跟正常朋友交往一样，比起逸闻跟传言，还是坐在一起喝杯酒，能彼此了解得更快——不如现在就去整一杯？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解法尔伽·其五",
      "text": "——喝！接着喝！哈哈…我继续跟你讲啊…这道伤口是跟玻瑞亚斯打的时候，那老狼刮得可疼了，它嗷嗷叫唤，我也被打得嗷嗷叫唤…这道是单挑魔女会试炼的时候…凡人要想守住一切…要有觉悟付出一切…「最强的北风骑士」啊…就是这么来的…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "法尔伽的爱好…",
      "text": "我从前勉强也能算是个冒险家，前往新的区域、挑战新的强敌，总是令人激动，不是吗？至于现在嘛…还有更重要的东西需要我来守护啊。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "法尔伽的烦恼…",
      "text": "挪德卡莱的据点建设、荆夫港的防务调动、远征军的返岗安排、骑士团上下的开支明细…呃啊啊啊…为什么远征结束才是折磨的开始啊？"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "那当然是——嗯？你问酒以外的…酒酿圆子跟酒心巧克力也不能算？呃…嗯…唔…那就…快火炙烤的大块肉类、方便开胃的凉拌小菜…奶酪和坚果…哈哈哈…"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "有些饮料啊，明明看着是酒，闻起来也是酒，偏偏喝上去不是酒！这已经算是欺诈了吧！"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "这道菜…嗯，值得开一支顶级的蒲公英酒来配餐！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "不错的口粮，得让后勤小队多跟你学一点。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "你们…平时吃的都是这些？冒险生涯也不比远征军旅容易呀…回头一起去吃点好的吧。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐！你等着噢，西风骑士团正在为你准备生日歌大合唱。别误会，这可不算职权滥用，是他们自发提出的，我不过是代为组织了一下而已，顺便布置了场地。身为我们的荣誉骑士，你也该意识到自己有多受爱戴了吧？走吧，大家还等着寿星和领唱呢！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "骑士的美德之一是「谦虚」，虚心受教，才能日益精进。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "骑士的美德之二是「诚信」，巧言与诡计只能骗过一时，剑锋上的胜利却从不说谎。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "骑士的美德之三是「自律」，骑士之道各有其理，笃定于自己的道路，矢志不渝地践行吧。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "骑士的三重美德都记住了吗？好，现在把它们全忘了吧——想成为什么样的骑士，踏上什么样的征途，都由我们自己说了算！"
    },
    {
      "id": "100010",
      "type": 2,
      "title": "重攻击·其一",
      "text": "——破！"
    },
    {
      "id": "100011",
      "type": 2,
      "title": "重攻击·其二",
      "text": "——斩！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "激流！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "烈火！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "冰霜！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "轰雷！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "疾风！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "迸裂吧！"
    },
    {
      "id": "100007",
      "type": 2,
      "title": "元素战技·其七",
      "text": "再猛烈些！"
    },
    {
      "id": "100008",
      "type": 2,
      "title": "元素战技·其八",
      "text": "哈——"
    },
    {
      "id": "100009",
      "type": 2,
      "title": "元素战技·其九",
      "text": "跟得上吗？"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "喝啊啊啊啊！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "北风，席卷！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "随我冲锋！"
    },
    {
      "id": "700001",
      "type": 2,
      "title": "冲刺开始·其一",
      "text": "跟上我！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "有酒没？分我一杯。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "喜欢什么就拿吧。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "战利品是对冒险的褒奖，收下吧。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "哈…该认真点了！"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "不错的对手！"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "有点大意了啊…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "守护盟友是骑士的职责！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "暂且撤退，由我接手。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "北风…不该断绝于此…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "哈…我也有这一天啊…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "蒙德就…交给你们了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "一点小伤！"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其二",
      "text": "不碍事！"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "又一道疤？"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "很好，准备出征！"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "今天的「北风」，要吹向哪里？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "「北风骑士」——入列。"
    }
  ]
}