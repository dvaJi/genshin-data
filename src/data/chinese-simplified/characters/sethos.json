  "outfits": [
    {
      "id": 209700,
      "name": "金沙行者",
      "description": "赛索斯的装扮款式。沙黄色的衣襟象征着养育他的广阔沙海，亦是他信仰的一部分。",
      "isDefault": true,
      "characterName": "赛索斯",
      "characterId": 10000097,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Sethos_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "#这位{M#先生}{F#小姐}，是在叫我吗？你好你好，我叫赛索斯。你呢，找我有什么事吗？哎呀，也别干站着了，我知道一个适合坐下来聊天的好地方，跟我来吧。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·思考",
      "text": "过度思考「为什么」很容易钻牛角尖，不如放过自己。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·动静",
      "text": "你听到了吗？那边有动静。先下手为强，我想去凑凑热闹。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·上学",
      "text": "教令院里面怪人真多，搞得我都想考进去上个学了。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "沙漠里极少下雨，所以就让我享受一会儿这样的天气吧，不用帮我打伞啦。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "糟了糟了糟了，快去地势低的地方…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "嘶…快快快，跑起来，跑起来就不冷了！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "天气真好，不找个地方露营可就太浪费了。走吗，一起去绿洲钓鱼？"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "你试过在沙地上画画吗？从高处看会很壮观哦！就是要找个风小的地方。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早早早，要跟我去吃点东西吗？我从昨晚就惦记着做几个烤肉卷了。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "现在喝咖啡的话，就没法享受午觉了哦。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "虽然沙漠白天没什么生机，但晚上总有很好看的星星。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "睡了睡了，准备迎接明天的太阳！"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于赛索斯自己·印象",
      "text": "有些长辈说我像野生动物一样难以控制。倒不是说他们的印象有错，但首先，想要控制别人的想法有点不太对，你说是吧？"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于赛索斯自己·首领",
      "text": "老实说，做首领还是有些压力的，更别提是在缄默之殿。不过和爷爷耳濡目染了这么多年，我清楚那些最不能让步的底线。而且经历了之前的决斗之仪，又认识了那么多新朋友，我也明白了缄默之殿之后要走的路在哪。放心吧，不会搞砸的。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·闲聊",
      "text": "抱着想要和对方打好关系的目的刻意谈话，很容易陷入僵局。就像这样一起走走，随便聊聊，反而更容易熟悉起来呢。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·篝火",
      "text": "夜晚的篝火，既能为人提供温度，又能防范野兽。你给我的感觉就像篝火一样。\\n说得太抽象了？哎呀，就是拿你当朋友的意思啦。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "沙漠人获得神之眼时，大伙儿都会说这是谁谁的恩赐，具体人选视各自信仰而定。看一群人为了别人的神之眼争论赫曼努比斯大人和索贝克大人究竟谁更强，怪好玩的。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "如果去沙漠旅行，夜间赶路是个不错的选择。气温确实寒冷，但可以避免在炎热的光照下流失过多水分。多带件衣服总比四处寻找水源方便多了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "「悼灵花」这名字不知道是谁起的，还挺浪漫。换我来看，也许只会以为它是被太阳晒蔫了才垂头丧气的呢。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于赛诺…",
      "text": "赛诺很优秀，无愧于赫曼努比斯力量的传承。作为「大风纪官」，他对知识与智慧有着至高的敬畏之心。如果教令院能与缄默之殿再次合作，有他在我会放心很多。\\n哦对了，他还有个难得的优点，就是讲话很好笑。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于提纳里…",
      "text": "提纳里挺厉害的。我后来才听说他不太适应沙漠的气候，决斗之仪那时可完全没看出来啊。我也没想到他会写信邀请我去化城郭做客，说是让我有机会见见赛诺的朋友们。你说，他们平常吃饭都会讲那种笑话吗？真期待！"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于艾尔海森和卡维…",
      "text": "我在酒馆见过他俩。也在咖啡馆见过。…好像在大巴扎也有一次。那位建筑师总是嘀嘀咕咕一些不想被别人知道的事情，但实际上嘛…哎，可不是我故意偷听，这样两位先生凑在一起，很难不引人注意吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于流浪者…",
      "text": "这位小哥，是不是外国来的留学生啊？帽子挺别致的。有次我想凑近了仔细看看，但眨眼的功夫他就咻地一下消失了。可惜，下次不会再让他跑了。而且听人说那哥们很有想法，我要和他多聊聊！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于迪希雅…",
      "text": "「炽鬃之狮」，沙漠里人人都听说过这个名号。你也知道，镀金旅团里可不都是好人，像迪希雅这样正直可靠的就更少了。如果你要来大赤沙海探险，迪希雅是做向导第二好的人选。第一嘛，当然是我咯？"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于坎蒂丝…",
      "text": "你被坎蒂丝招待过吗？她做饭超大份的，连我都差点没吃完。不过吃饭就好了，千万别吃她的拳头。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于珐露珊…",
      "text": "很少见到比我还自来熟的人！在教令院附近闲逛时被她当成了新生，非要带我进去参观，还说什么现在加入知论派就能享受二十种语言教材大礼包，包教包会，吓我一大跳。问了别的学生才知道这是他们院的内部笑话，根本没有这种毕业要求。所以到底哪里好笑？只会让人更不想加入吧。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于妮露…",
      "text": "我是个闲不住的人，但不介意在祖拜尔剧场多站一会儿，看看这位小姐的舞蹈。能让人内心宁静也是一种很难得的能力。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解赛索斯·其一",
      "text": "想打听事情？你找对人了。万一有我不知道的东西，也可以帮你四处问问。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解赛索斯·其二",
      "text": "你要是有什么装备或者工具坏掉了，可以叫我来修。你问我是做什么工作的？哎呀，当然是无业游民了，不然哪有这么多闲工夫做手工呢。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解赛索斯·其三",
      "text": "我喜欢徒步旅行。提前规划好路线，整理行囊，挑选好的日子踏上旅途，这种有条不紊的感觉很不错。当然，我不会把行程排得很满，也要享受突如其来的邂逅嘛。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解赛索斯·其四",
      "text": "在大巴扎闲逛可有意思了。我会挑选各种香料混在一起，搭配现烤的肉类食用。我不会特意去记录配方，所以很多时候都是「一次性食谱」。怎么样，有没有兴趣尝尝这种限时限量、独一无二的美味？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解赛索斯·其五",
      "text": "自记事起，我就在缄默之殿生活，老实说没有太多的选择。能承受赫曼努比斯的力量对个人而言不知是福多还是祸多，但确实为我的生活赋予了更崇高的意义。\\n人生中的遗憾有千千万，能圆满解决一件事，我就很满足了。现在我成了缄默之殿的新首领，赫曼努比斯之力也有了合适的归属，爷爷应该也很欣慰吧。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "赛索斯的爱好…",
      "text": "老是待在屋子里挺没意思的，无论天气好坏，我都喜欢出门跑跑。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "赛索斯的烦恼…",
      "text": "出远门前一定要做好准备，尤其是前往没去过的地方。当初第一次在树林里过夜不知道要带防潮垫，给我害惨了。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "我喜欢调配香料，是为了能让肉变得更好吃，可不要本末倒置了哦。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "绿色植物是很养眼啦，但吃起来就…"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好香好香好香。我食量有点大，你不介意吧？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "真不错，怎么做的？下次徒步旅行我也弄点带上。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "唔…嗯…好像没什么味道，我再尝尝…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "你的头发…按照沙漠人的风格编一下应该会非常好看。马上就要步入人生新一年了，想不想试试新发型？怎么样，交给我，保证给你扎个魅力四射的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "原来你们都是这样锻炼的吗？"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "噢…原来连看三天书是这种感觉…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "厉害啊，感觉可以一口气从阿如村跑到赤王陵。不是开玩笑哦，要试试吗？"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "没想到你会帮我到这种地步。有时太依赖古老的智慧，会让人忘记自己和同伴本身的力量。谢谢你，让我回想起了这些。"
    },
    {
      "id": "120001",
      "type": 2,
      "title": "普通攻击·其一",
      "text": "小心背后！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "先手为赢。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "打扰了！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "各退一步如何？"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "众贤的智慧。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "阿赫玛尔的遗荣！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "抱歉，你挡路了。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "快看看，有合你心意的东西吗？"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "是旅途中的惊喜呢。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "啊！里面有怪物！…欸，不上当吗？"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不会认输的。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "还行，再撑一会儿…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哎呀哎呀…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "换我了哦？"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "逞什么强呢。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "可惜，前功尽弃…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "太阳…也会落下…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "对不起了，爷爷…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "好吧好吧。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "别别别。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "哎哟，是我慢了！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "来了来了。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "好好好，听你的。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "嗯，带好行囊了。"
    }
  ]
}