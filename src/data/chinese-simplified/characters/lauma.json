    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "睁开眼睛。我名菈乌玛，此地乃霜月之光慷慨弥散的谧林。无论去往何方，皆在天目所及之处。现在，闭上眼睛，你不再迷路了。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·月光",
      "text": "即使不在夜晚，即使看不到天空，月光也从未消散。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·动物",
      "text": "在挪德卡莱，如果有动物的行为让你不解，可以来找我。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·旅途",
      "text": "想好要去哪边了吗？或者，找块草坪休息一会吧。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "啊，又快到草木繁茂的季节了…"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "一瞬的闪耀，比月光更难捕捉…"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "听说不能长时间注视如此纯粹的白，是这样的吗？我还挺喜欢的…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "听奈芙尔提过世界上有像这样的地方…原来是这般风貌。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早安。月神保佑，不论日夜。"
    },
    {
      "id": "1005",
      "type": 1,
      "title": "早上好…",
      "text": "早安。月光联系着你我，不论日夜。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "…啊，我刚刚打瞌睡了吗？抱歉。有什么需要，请讲吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "今晚的月光很平静。要一起去树林里走走吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "群星已互道过晚安，轮到我们了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于菈乌玛自己·责任",
      "text": "诸律无法则为把戏，人之无心即为伪神。无论何地，人群聚集的地方都需要规则。即使是像「霜月之子」这样有着共同信仰的地方，也必须要有属于人的规矩。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于菈乌玛自己·解忧",
      "text": "我本应是听取教众烦恼、为他人解忧的神使，但很多时候却在听动物们叽喳呢…呵呵…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·溪流",
      "text": "林间溪流总是朝向大海而行，或许我们的相遇也是既定的命运。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·草木",
      "text": "草木扎根于泥土，向上，也同时向下生长。星辰与深渊都难以穷尽，希望我们的未来亦是如此。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「月之轮」…",
      "text": "这是神明的慈悲，据称以愿望衡量。\\n为什么说「据称」？嗯…因为没有地方去确认啊。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "置一盆水于月下，对其诉说你的快乐与烦恼吧。如果月影应邀浮现在水面，那么你便得到了月光的祝福。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "想听动物们对你的评价吗？呵呵…那可能得讲上好多轮月升月落。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于伊涅芙…",
      "text": "在挪德卡莱有不少经过义体改造的人，但全身都由机械构成就是别的问题了…不过转念一想，和那些心怀不轨的人相比，如此温和、友善、又充满好奇心的她，反而更像理想化的人类呢。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于爱诺…",
      "text": "十分聪慧，却又命运坎坷的孩子。她的发明帮助了许多人，挪德卡莱应当为拥有这样的宝物感到荣幸。如果她想来霜月之坊生活，我一定会保证她营养充足，摄取足够的新鲜蔬果与甘泉。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于菲林斯…",
      "text": "他看上去是位很讲究礼节的先生，然而动物们却似乎畏惧着他的存在…我会保持警惕，但不想在没有证据的前提下就对不熟悉的人妄下定论。每次他路过霜月之坊时，我都会让他收下一份今日收获。\\n你说他不是坏人，只是名字太长…嗯…真的吗？"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于奈芙尔…",
      "text": "她和我的行事风格很不一样，但我始终认为，我们并不是无法相处的类型。\\n无论如何，月光都会庇佑她的。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于雅珂达…",
      "text": "在结伴潜入试验设计局前，我只知道她是「秘闻馆」的成员，是奈芙尔值得信赖的部下。夹在奈芙尔和各种客户之间一定很辛苦吧，我一直想好好招待她一次…呵呵，不知道奈芙尔以前是怎么在她面前称呼我的呢。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于法尔伽…",
      "text": "虽然挪德卡莱一向人员混杂，但也很难见到比这位先生融入得更好的外乡人了。他待人接物时有一种天然的亲和力，是难能可贵的品质。记得第一次见面，他便向我称赞「霜月之子」分发餐品的美味…虽然我不记得自己曾给过他任何食物，但奇怪的是，我并不怀疑他的诚恳。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于「库塔尔」…",
      "text": "新生的神明无法从任何地方学到与信众共处的方法，过去的她一定很难过吧…\\n为了能找到调和这种关系的办法，我对神明提出了近乎无礼的要求。虽然她声称自己的确更喜欢独处，但我总还是怀有一丝希望，希望有朝一日，「库塔尔」与「霜月之子」，明月与仰望明月的人，能够在同一片天空下共饮。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解菈乌玛·其一",
      "text": "看看月亮吧。它永远在那里，无声无息。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解菈乌玛·其二",
      "text": "在很多地方，残月都是厄运的征兆。\\n但月亮并不是自己想要破碎的…它们也只是命运颠簸的结果。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解菈乌玛·其三",
      "text": "有时，神的代言人需要比神本身表现得更有「神性」，这样才能符合人们的期待。信众对神明的任性往往表现出超脱常识的宽容，但对使节就不一样了。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解菈乌玛·其四",
      "text": "水果放得时间稍微长一点，就会散发酒的味道。我没有喝酒的习惯，但闻到这种气味时总觉得会更放松些…我，应该不太适合喝酒吧？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解菈乌玛·其五",
      "text": "「霜月之子」的小孩子们，很喜欢将轻薄的白纱举过头顶奔跑，因为大人们总是哄他们说，身披白纱就像被月光照拂，一切灾厄都将被隔绝在外。不过一旦过了一定年纪，大家便不再这样嬉闹，转而对着夜幕下苍白的月色礼拜。\\n我也做过么？当然。人都是从小孩开始，一点一点长大的。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "菈乌玛的爱好…",
      "text": "我喜欢漆黑的夜色中，独自一人的时光。只有风吹过树叶的声响，鸟兽也不再言语。这样最安静。"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "菈乌玛的烦恼…",
      "text": "头顶…很重。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "无关戒律与信仰，清淡的饮食对我来说最易入口。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "油脂丰富，或者缺乏水汽的…我适应不来。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "这样新鲜的食材，让你费心了，就由我带给教众们吧。…什么，只给我吗？"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "感谢你的礼物，不如一起分享吧。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "应该有比我更需要的人，我会帮你留意的。"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "一柄带着祝福的匕首，赠与被月辉与谧林宠爱的贵客。匕首并非一定是凶物，偶尔也作为礼器在祝祷仪式中出现。\\n当然，你想用它做什么都是自由的。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "不可贪求捷径…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "不可贪享力量…"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "若一切都是为了与「真实」相见——"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "我愿意为此献上求道者的血泪。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "苍林的守护。"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "迷途之子啊…"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "去吧。"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "如月辉绽放。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "林风之颂。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "带去我的祝福。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "愿霜月如故。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "愿林野如初。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "祈祷，为众心之所向。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "对辛劳者的赠礼。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "是世界在对你示好。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "或许，它一直在等你的到来。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "呼…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "是对我的考验…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "应当反省。"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "密林的影子会为你掩护。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "送还霜月的怀抱。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "深林啊，请收下，这折断的角冠…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "月汐的扰动，终于结束了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "无月的夜幕…降临。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "请别这样…"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "…不义之举。"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "走吧，去月色温柔的地方。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "圣者自会走上正途，无光亦然。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "无需顾虑，我应愿而来。"
    }
  ]
}