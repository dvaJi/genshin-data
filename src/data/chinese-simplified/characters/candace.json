  "outfits": [
    {
      "id": 207200,
      "name": "沙漠与夜",
      "description": "坎蒂丝的装扮款式。不论走到哪里，点缀在衣间的金黄沙漠和故乡的夜空都陪伴着她。",
      "isDefault": true,
      "characterName": "坎蒂丝",
      "characterId": 10000072,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Candace_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "你好呀，远道而来的旅行者，夜晚的沙漠可是很严酷的，不如就在敝处稍住一晚吧，由我来照看你的无梦之夜。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·盾与枪",
      "text": "为了保护珍贵之物，只有盾是不够的。所以…我才会握起枪。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·生活",
      "text": "希望每个人都平安无事。只要能维持这样的生活，我就心满意足了…"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·愿望",
      "text": "无论以怎样的方法，我都希望守护住那些重要的东西。尽管有时…这会是一种奢望。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "可别着凉了。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "雷声隆隆——会让你害怕吗？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "这些白色的东西，冰冰凉凉的…"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "刮大风了…",
      "text": "在沙漠里，这样的风会吹起沙暴，得小心了。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "我就在你身旁。若你不放心的话，就请牵着我的手吧。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早上好啊，不知旅者昨夜可曾安然入眠？"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "已经是中午了，天上明眸之光灼然炫目，不如找个荫凉处歇息一下吧。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "夜晚啊，在那光芒褪尽的诸多帷帐之后，藏着多少难言的隐秘呢…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "嗯，确实已经到休息的时间了，你先去睡吧。我吗？离我入睡的时候还早，夜晚虽然美丽却也危险，我得好好帮你守夜才行啊。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于坎蒂丝自己·瞳色",
      "text": "很奇怪吗，不管是琥珀色还是蔚蓝色，应该都还算常见的瞳色吧…"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于坎蒂丝自己·阿如村",
      "text": "我自小就在阿如村出生长大，在我尚且懵懂之时就知道，将来一定会从祖父手中接过守护阿如村的职责…如今，这已是我欣然接受的天职了。"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "关于坎蒂丝自己·父母",
      "text": "我的父亲是教令院的学者，当时为了研究才到了阿如村，也由此和我的母亲相遇。关于母亲的事，我全是从父亲口中得知的…在我出生那日，母亲就走入永夜之中了…"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·主客",
      "text": "你永远是阿如村的客人，无论何时，若是在旅途中觉得困倦疲累，你都可以到这儿来歇息一会儿。阿如村永远欢迎你…我永远会欢迎你。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·宝匣之中",
      "text": "据说每个人心中都有一个宝匣，他们将珍视之物装入匣中，花上一生的时间好好守护。这样想要守护的东西，在我的宝匣之中也有许多，要猜猜看都有什么吗？"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "在我获得「神之眼」的时候，村里不少人都说这是阿赫玛尔的恩眷…但对我来说这并不重要。无论有没有神明的恩赐，我都会履行「守护者」的职责。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "我很喜欢在阿如村度过的日子。同时，在这里度过的每一天也都在提醒我，如果我因为松懈失察而酿成大错的话，就再也无法回到这样的生活了。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "你有在旅行的途中见过枣椰吗，村里的人经常把它们摘回来做成糖果吃，味道非常甜美。如果感兴趣的话，你也尝尝看吧。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于小吉祥草王…",
      "text": "草神啊…作为阿赫玛尔血脉延续的我既然能在此安然生存，或许也仰赖她的仁慈吧。不过，虽说心中怀有淡薄的感激之念，但我毕竟是沙漠的子嗣…"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于莱依拉…",
      "text": "「状若梦游的古怪少女」么…我确实在防沙壁附近看到过，虽然完全听不懂她说的话和写在纸上的一堆算式…不过，她似乎说完那些心情变好了许多。或许这是她排解心中压力的方式吧。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于艾尔海森…",
      "text": "真是奇怪的须弥学者，跟我接触过的其他学者都有些不太一样，他的想法与见解都很独到…希望他的这份锐利，不会打扰到阿如村的安宁吧。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于赛诺…",
      "text": "教令院的大风纪官…之前很少到防沙壁的这一侧来，最近却常常出现。关于他，镀金旅团里似乎流传着一些相当可怕的传说…"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于迪希雅…",
      "text": "迪希雅，她每次带着镀金旅团的人在阿如村寄宿的时候，都能约束好手下的行动，可以说…给我免了很多麻烦。迪希雅小姐，跟看上去大大咧咧的样子不同，是个非常可爱的人哦。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于赛索斯…",
      "text": "赤王的子民永远保有骄傲，他也是如此。我听说了他的事，赫曼努比斯的威光将与有能力的人共存。听说他最近在须弥城很活跃，还跟赛诺他们提起阿如村，说是想来作客，我很期待。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解坎蒂丝·其一",
      "text": "想要了解我的事情吗…那算不上是一个好故事，但要是你执意想听的话…那就在入夜之后，由我在篝火边为你讲述吧。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解坎蒂丝·其二",
      "text": "我们是失去了神明庇护的一族，对我们而言，谎言不是什么敌人，没有明天才是。怀揣谎言行走于痛苦的荆棘之路上，说不定…说不定比自顾自拥抱真相死去的人要高尚一些呢…"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解坎蒂丝·其三",
      "text": "即使到现在，也有人相信赤王有朝一日能够复活，但那是不可能的。一切的过去都如同被吹拂的砂砾，对过往之事来说，随风而去才是最好的归宿。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解坎蒂丝·其四",
      "text": "我的盾牌？喔，如果按照村外人的说法，这面盾牌上可是有着「贝努」的祝福呢，只要拿着这面盾牌，沙漠里的每一颗沙砾都是我的斥候，沙暴也任我驱使…这其实都是外人的臆想。但无论如何，对我来说…至少这面盾牌用得挺顺手的。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解坎蒂丝·其五",
      "text": "我真想用这只琥珀色的眼睛，预见你的未来…我想，它大概会是一片金黄，介于阳光和黄金之间，是充满希望的颜色。你的前路一定会顺利，我由衷祝福着它。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "坎蒂丝的爱好…",
      "text": "在村中散步就是我最喜欢做的事。看到一切都好，就让人觉得今日犹如昨天，昨天犹如过去，而过去又总是好的。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "坎蒂丝的烦恼…",
      "text": "偶尔还是会有不长眼的宵小之徒，企图打扰阿如村的宁静。或许…只将那些家伙赶进全是魔兽的山谷里还是太过仁慈了，怎么样，你有更好的建议吗？"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "对我来说…食物的分量比口味更重要。在沙漠里生活需要耗费比想象中更多的体力，一天的劳累过后，没有比吃饱肚子更为惬意的事了吧。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "倒也没到讨厌的程度，不过相较于肉，鱼吃起来确实非常麻烦…可能也是在沙漠中很少吃鱼的关系吧，我对于那种将刺从鱼肉中剔除的工作并不擅长…让你见笑了。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好吃极了，为做出这样的美食，你想必付出了相当的努力吧。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "明明是四处漂泊的旅人，你做的饭，却有家的味道呢。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "或许是我对可食用之物的定义太过保守…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "祝你生日快乐！多了不起啊，你在过去某年某月的这一天出生了。有什么想要实现的愿望吗。如果要去险远之处，我就作你旅途的护卫。若是想稍作休息，那就来阿如村，我用最好的烤肉和饮料招待你。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "感觉到了更坚实的力量，希望我可以保护更多…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "更坚固的盾，和更锋利的枪。我曾听说过一个枪和盾的故事…不，我不会做出枪盾相击的尝试。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "人在「现在」获得的力量，或许都是为了应对「将来」的不安。就像我过去锻炼枪术和持盾的技巧，实际上都是为了守护现在的安稳。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "现在的我，已经可以站在你的身前，替你挡下所有的危险。如果你相信我的话，就请闭上双眼，将敌人交给我吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "破！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "走开！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "来吧！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其四",
      "text": "坠刺！"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其五",
      "text": "不过如此！"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其六",
      "text": "有破绽！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "听取我的战祷！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "赐予我们祝福！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "此为守护之战！"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "都是些有用之物呀…"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "怎么样，有看得上眼的么？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "希望里面有能帮上你的东西。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "不用手下留情了。"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "仍不悔改吗？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "请你们，滚开…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "好好休息一下…"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "站我身后吧！"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "仍需磨炼…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "对不起，我没能守护…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "盾，破碎了…"
    },
    {
      "id": "900001",
      "type": 2,
      "title": "普通受击·其一",
      "text": "没问题。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "了不起。"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "小伤罢了…"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "怎么了，遇到危险了吗？"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "记得跟紧我哦。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "我会保证你的安全。"
    }
  ]
}