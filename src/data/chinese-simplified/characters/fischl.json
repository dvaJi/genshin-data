    },
    {
      "id": 203100,
      "name": "绮夜圣礼",
      "description": "菲谢尔的装扮款式。「断罪之皇女」于提瓦特大陆巡礼时所着之常服。",
      "isDefault": true,
      "characterName": "菲谢尔",
