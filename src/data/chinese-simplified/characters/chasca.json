    {
      "_id": 1044,
      "id": "sparks_the_sudden_shot",
      "name": "星火，瞬息的击发",
      "description": "元素爆发<span style=\"color:#FFD780FF\">索魂命袭</span>中的<span style=\"color:#FFD780FF\">溢光索魂弹</span>命中敌人时，将为恰斯卡恢复1.5点元素能量，并会根据<span style=\"color:#FFD780FF\">溢光索魂弹</span>的元素类型，造成相当于恰斯卡攻击力400%的对应元素范围伤害，该伤害视为重击伤害。<br/>上述造成对应元素范围伤害的效果，每次施放<span style=\"color:#FFD780FF\">索魂命袭</span>至多触发1次该效果。",
      "level": 4
    },
    {
      "_id": 1045,
      "id": "brim_the_sandshadows_silhouette",
      "name": "帽檐，沙影的轮廓",
      "description": "元素爆发<span style=\"color:#FFD780FF\">索魂命袭</span>的技能等级提高3级。<br/>至多提升至15级。",
      "level": 5
    },
    {
      "_id": 1046,
      "id": "showdown_the_glory_of_battle",
      "name": "相决，斗争的荣光",
      "description": "恰斯卡进行<span style=\"color:#FFD780FF\">多重瞄准</span>所需的蓄力时间减少，且触发突破天赋「子弹的戏法」中的「附灵转化」后，恰斯卡将获得「命袭」状态，在接下来的3秒内，恰斯卡下一次施放元素战技<span style=\"color:#FFD780FF\">灵缰追影</span>中的<span style=\"color:#FFD780FF\">多重瞄准</span>时，会立即完成蓄力，并且本次<span style=\"color:#FFD780FF\">多重瞄准</span>中的<span style=\"color:#FFD780FF\">追影弹</span>和<span style=\"color:#FFD780FF\">焕光追影弹</span>的暴击伤害提升120%。每3秒至多获得一次「命袭」效果。<br/><br/>上述效果需要解锁突破天赋「子弹的戏法」。",
      "level": 6
    }
