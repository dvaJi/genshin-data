  "passives": [
    {
      "id": "bullet_trick",
      "name": "子弹的戏法",
      "description": "进行元素战技<span style=\"color:#FFD780FF\">灵缰追影</span>中的<span style=\"color:#FFD780FF\">多重瞄准</span>的蓄力时，若队伍中存在符合元素转化条件的元素类型的角色，则依据符合条件的不同元素的数量，获得以下效果：<br/>·每种元素有33.3%/66.7%/100%的几率触发「附灵转化」，使第三枚装入弹匣的<span style=\"color:#FFD780FF\">追影弹</span>随机转化为对应元素类型之一的<span style=\"color:#FFD780FF\">焕光追影弹</span>；<br/>·每种元素将为恰斯卡产生一层「焕影之灵」效果，使焕光追影弹造成的伤害提升15%/35%/65%，该效果持续至本次多重瞄准结束，至多叠加3层。",
      "level": 1
    },
    {
      "id": "intent_to_cover",
      "name": "掩护的心意",
      "description": "队伍中的附近的角色触发「夜魂迸发」时，恰斯卡会对附近的敌人发射「流焰追影弹」，造成具有夜魂性质的<span style=\"color:#80FFD7FF\">风元素伤害</span>，该伤害相当于元素战技<span style=\"color:#FFD780FF\">灵缰追影</span>中的<span style=\"color:#FFD780FF\">追影弹</span>的150%；若队伍中存在<span style=\"color:#FF9999FF\">火元素</span>、<span style=\"color:#80C0FFFF\">水元素</span>、<span style=\"color:#99FFFFFF\">冰元素</span>或<span style=\"color:#FFACFFFF\">雷元素</span>角色，则流焰追影弹会发生元素转化，造成具有夜魂性质的对应元素伤害，该伤害相当于元素战技<span style=\"color:#FFD780FF\">灵缰追影</span>中的<span style=\"color:#FFD780FF\">焕光追影弹</span>的150%。<br/>通过上述方式造成的伤害视为重击伤害。",
      "level": 4
    },
    {
      "id": "night_realms_gift_everburning_heart",
      "name": "夜域赐礼·不熄炽心",
      "description": "在夜魂值耗竭后，恰斯卡将会转而消耗燃素来维持夜魂加持。<br/>在纳塔存在燃素机制的区域时，能够进行夜魂传递·恰斯卡。当前场上角色位于空中时，切换恰斯卡登场时触发：恰斯卡将进入夜魂加持状态，并获得32点夜魂值。自己的队伍每10秒可以触发一次夜魂传递。",
      "level": 0
    },
    {
      "id": "mediations_true_meaning",
      "name": "调停的真意",
      "description": "队伍中自己的角色击败敌人时，将恢复25点燃素，该效果每12秒至多触发一次。<br/>该效果在秘境、征讨领域、深境螺旋中无效。",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1041,
      "id": "cylinder_the_restless_roulette",
      "name": "弹匣，躁动的轮盘",
      "description": "触发突破天赋「子弹的戏法」中的「附灵转化」时，会额外使第二枚装入弹匣的<span style=\"color:#FFD780FF\">追影弹</span>转化为<span style=\"color:#FFD780FF\">焕光追影弹</span>。<br/>触发「附灵转化」的几率增加：若队伍中存在符合元素转化条件的元素类型的角色，则触发「附灵转化」的几率提升33.3%，至多提升至100%。<br/><br/>需要解锁突破天赋「子弹的戏法」。<br/>此外，不处于战斗状态下时，恰斯卡的夜魂加持状态消耗的夜魂值与燃素降低30%。",
      "level": 1
    },
    {
      "_id": 1042,
      "id": "muzzle_the_searing_smoke",
      "name": "枪口，灼烧的轻烟",
      "description": "恰斯卡登场时，获得一层突破天赋「子弹的戏法」的「焕影之灵」。该效果需要解锁突破天赋「子弹的戏法」。<br/>此外，施放元素战技<span style=\"color:#FFD780FF\">灵缰追影</span>中的<span style=\"color:#FFD780FF\">多重瞄准</span>时，恰斯卡的<span style=\"color:#FFD780FF\">焕光追影弹</span>命中敌人时，会根据<span style=\"color:#FFD780FF\">焕光追影弹</span>的元素类型，造成相当于恰斯卡攻击力400%的对应元素范围伤害，该伤害视为重击伤害。每次施放<span style=\"color:#FFD780FF\">多重瞄准</span>至多触发一次该效果。",
      "level": 2
    },
