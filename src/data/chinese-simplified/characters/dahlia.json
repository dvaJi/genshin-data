  "passives": [
    {
      "id": "the_winds_gentle_grace",
      "name": "风色柔愿的眷宠",
      "description": "处于元素爆发<color=#FFD780FF><b>纯耀的祷咏</b></color>中的「西风之眷」效果影响下的角色对敌人触发冻结反应时，将会为塔利雅赋予2层「祝颂」效果，该效果8秒内至多触发一次。",
      "level": 1
    },
    {
      "id": "prayer_of_wellwrought_joy",
      "name": "黠巧欢愉的祈颂",
      "description": "队伍中自己的当前场上角色处于元素爆发<color=#FFD780FF><b>纯耀的祷咏</b></color>中的「西风之眷」效果影响下时，攻击速度将获得提升，提升值基于塔利雅的生命值上限：每1000点生命值上限都将提升0.5%攻击速度，至多通过这种方式提升至20%攻击速度。",
      "level": 4
    },
    {
      "id": "pilgrimage_upon_returning_winds",
      "name": "归风相随的巡礼",
      "description": "在白天（6时至18时），队伍中自己的角色获得迅行效果：移动速度提高10%。<br/>该效果在秘境、征讨领域、深境螺旋中无效，迅行效果无法叠加。",
      "level": 0
    }
  ],
