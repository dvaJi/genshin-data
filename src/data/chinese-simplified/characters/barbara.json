    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "芭芭拉，闪耀登场~治疗就交给我吧，不会让你失望的！"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·犯困",
      "text": "再这样站下去，会…想睡觉的…"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·激励",
      "text": "大家应该都在努力着，那我们也不能偷懒，对吧？"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·提神秘诀",
      "text": "欸，是没精神了吗？尝一尝我做的辣味饮料吧，很提神的喔！"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "这样淋着不要紧吗？会感冒的吧？"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "呜哇！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "欸！是雪花欸！冰冰凉凉的~！"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "这样的好天气，嗯~适合比较明快的曲风呢！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "放心，我不会被吹走的！"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早安~今天也要加油呀。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "欸，想听我唱歌…？对不起，还…还没有到演出时间呢。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "想吃猎鹿人餐馆的香辣鲈鱼…可是最近的肚子，呜…"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "辛苦了！请好好休息吧。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于芭芭拉自己…",
      "text": "「指引我前进的风啊。在我困顿时给我继续前行的力量，在我迷惑时给我辨明善恶的智慧，在我遭受不义时给我抗争的勇气…」…哎呀，抱歉，刚才在专心祈祷。有什么事吗？"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·愿望",
      "text": "我的愿望，是给身边的大家带来笑容！只要能帮上你的忙，我就很开心了。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·梦想",
      "text": "谢谢你陪我走到现在，离我的梦想已经越来越近了呢。未来的日子，也请多多关照啦~！"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "每个人都会有自己的愿望。汇聚大家的愿望，让大家感到幸福，这一定，就是神给予我的使命吧。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "蒙德城外青青的原野，真的百看不厌。但我听说，世界上还有蓝色的树林呢！就在海对岸的稻妻城那边。嗯！我还得多攒一点…欸？问我在攒什么？嘿嘿，是秘密哦~！"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "向日葵一直对着阳光的样子，很耀眼呢。其实，妈妈送过我一条向日葵风格的礼裙…但我什么时候才能穿上它去演出呢？"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于琴…",
      "text": "代理团长大人…骑士团的领袖，大家都很喜欢她哦。欸？问我吗？我…我当然也非常尊敬她！"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于丽莎…",
      "text": "我一直承蒙丽莎姐姐照顾呢。要是她也成为偶像的话，我绝对会全力应援，喊到嗓子哑掉…啊，这样会吓到别人的吧…"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于安柏…",
      "text": "以前就经常看到安柏风风火火地往城外跑，侦察骑士还真是辛苦呀。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于迪卢克…",
      "text": "迪卢克老爷吗？上次在「天使的馈赠」演出，他一直皱着眉头…是不是我唱的歌他不喜欢呢？"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于温迪…",
      "text": "温迪的声音很好听！不过，他唱的歌跟我擅长的风格差异很大。我试着偷偷学过…那旋律还真是复杂呀。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于班尼特…",
      "text": "班尼特经常带着一身伤痕来教堂…他却一直毫不在意、大大咧咧地笑着。唔…还是应该更爱惜自己才好啊。"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于法尔伽…",
      "text": "父亲跟着法尔伽大团长一起出远门了，也不知道路途中会不会遇到什么…啊，没关系，大团长可是「北风骑士」，一定没问题的！我…也会为他们祈祷的。"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "关于罗莎莉亚…",
      "text": "罗莎莉亚修女虽然难以接近，也从不参加祈祷，但我觉得…唔，她一定是相信着风神的！不过，不过我并没有勇气和她交流就是了…"
    },
    {
      "id": "4009",
      "type": 1,
      "title": "关于诺艾尔…",
      "text": "诺艾尔实在是太可爱了！人又温柔，还很有耐心，跟她在一起的时候，完全不会有什么压力…哦，对了，她做的茶点也很特别。又香，又甜，而且很健康，嘿嘿。"
    },
    {
      "id": "4010",
      "type": 1,
      "title": "关于塔利雅…",
      "text": "塔利雅是一位十分可靠的前辈，由他传达的神谕，总能为大家带来很大帮助。不过，他不喜欢待在教堂里，经常光顾集市和酒馆这样人声嘈杂的地方。有时想找他人都找不到…就跟罗莎莉亚修女一样呢。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解芭芭拉·其一",
      "text": "骑士们挥剑作战的样子好帅啊！你是不是也有这种感觉？我自己也试过用剑…欸嘿嘿，可惜我在剑术上，完全没有天赋呢。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解芭芭拉·其二",
      "text": "想要治愈大家。就是这么简单的心情，让我成为了牧师。要是能帮上大家就好了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解芭芭拉·其三",
      "text": "偶像，唔...是从艾莉丝那边了解到的…「优秀的偶像能够治愈人们的心灵。」嗯，嗯，总之就是这样啦。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解芭芭拉·其四",
      "text": "我每天都在努力，这份努力…如果能配得上蒙德城大家的信任…"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解芭芭拉·其五",
      "text": "每次演出的时候我都会想…我真的能够治愈蒙德城里的每个人么？但是看着你，我总觉得只要一步步向前，总有一天…欸？至少已经把你治愈了…？这时候不是应该说！我已经治愈很多人了吗？！不过这样也不错…"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "芭芭拉的爱好…",
      "text": "是大家脸上的笑容，一直在支持我。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "芭芭拉的烦恼…",
      "text": "同伴们一直在受伤…我，没有替大家分担痛苦的力量。但我可以尽最大的努力治疗！一定，要让大家恢复健康。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "你喜欢麻辣小鱼干吗？我这还有两条…喏，给你一条！"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "我不太喜欢苦的东西，特别是…苦瓜。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "很少吃到那么合我口味的菜肴。今天是幸运日呢！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "谢谢你特意做的这些，这次，是被你治愈了。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "不，不好…"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "请收下！这个是给你的生日礼物，专属签名绘哟~欸嘿，等下一首新歌，我会第一时间唱给你听的！生日快乐呀！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "芭芭拉的舞步…治愈力UP！"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "谢谢你的支持~啊，不好，好像有点太激动了…心脏怦怦跳个不停。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "请告诉我继续变强的秘诀~欸？放心交给你就行？…这怎么行，我也要一起努力！"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "和你一起旅行，我才意识到舞台是没有边界的。谢谢你！嘿嘿…好！一起喊出那句咒语吧！三、二、一，——芭芭拉冲呀！"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "我会保护大家！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "打起精神来哟！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "演唱，开始！"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
