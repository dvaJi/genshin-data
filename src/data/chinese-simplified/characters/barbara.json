      "name": "闪耀协奏",
      "description": "芭芭拉的海滩装扮。洋溢着夏日活力的俏丽短裙，似乎散发着海洋的清爽气息。",
      "isDefault": false,
      "characterName": "芭芭拉",
      "characterId": 10000014,
      "source": [],
      "filename_card": "UI_AvatarIcon_BarbaraCostumeSummertime_Card",
      "filename_icon": "UI_AvatarIcon_BarbaraCostumeSummertime",
