      "filename_splash": "UI_Costume_BarbaraCostumeSummertime",
      "filename_sideIcon": "UI_AvatarIcon_Side_BarbaraCostumeSummertime"
    },
    {
      "id": 201400,
      "name": "纯真期待",
      "description": "芭芭拉的装扮款式。带有芭芭拉个人特色的西风教会牧师制服。",
      "isDefault": true,
      "characterName": "芭芭拉",
