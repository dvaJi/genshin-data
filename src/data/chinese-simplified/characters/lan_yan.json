  "passives": [
    {
      "id": "four_sealing_divination_charms",
      "name": "四戈封刀灵卜",
      "description": "元素战技<span style=\"color:#FFD780FF\">凤缕随翦舞</span>的突进命中目标时，如果接触了<span style=\"color:#80C0FFFF\">水元素</span>/<span style=\"color:#FF9999FF\">火元素</span>/<span style=\"color:#99FFFFFF\">冰元素</span>/<span style=\"color:#FFACFFFF\">雷元素</span>，则会使凤缕护盾发生元素转化，转化后的护盾对于对应元素伤害有250%的吸收效果。<br/>此外，如果这次元素战技<span style=\"color:#FFD780FF\">凤缕随翦舞</span>使凤缕护盾发生了元素转化，蓝砚向敌人抛出的翦月环将附加原本50%对应元素伤害，该伤害视为元素战技伤害。",
      "level": 1
    },
    {
      "id": "skyfeather_evilsubduing_charm",
      "name": "苍翎镇邪敕符",
      "description": "元素战技<span style=\"color:#FFD780FF\">凤缕随翦舞</span>与元素爆发<span style=\"color:#FFD780FF\">鹍弦踏月出</span>造成的伤害值提升，提升值分别相当于蓝砚元素精通的309%和774%。",
      "level": 4
    },
    {
      "id": "thought_and_intent_like_silken_scent",
      "name": "「心随芳兮意犹绵」",
      "description": "蓝砚在队伍中时，队伍中自己的角色接近晶蝶等部分生物时，不会惊动它们。<br/>有效对象可参考图鉴中「生物志 / 野生动物」的「其他」分类。",
      "level": 0
    }
  ],
  "constellations": [
    {
      "_id": 1081,
      "id": "as_one_might_stride_betwixt_the_clouds",
      "name": "「若有人兮云之际」",
      "description": "触发突破天赋「四戈封刀灵卜」中的元素转化后，蓝砚在这次元素战技<span style=\"color:#FFD780FF\">凤缕随翦舞</span>中向敌人抛出翦月环时，将额外抛出一枚翦月环。<br/>需要解锁突破天赋「四戈封刀灵卜」。",
      "level": 1
    },
