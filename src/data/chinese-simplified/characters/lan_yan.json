  "outfits": [
    {
      "id": 210800,
      "name": "银铛琳琅",
      "description": "蓝砚的装扮款式。沉玉谷的蓝氏有佩银的传统，蓝砚身上的每一样银饰都是家人的礼物。当她迈动双脚行走在山间，满身银饰叮铃作响，如同春燕欢歌。",
      "isDefault": true,
      "characterName": "蓝砚",
      "characterId": 10000108,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Lanyan_Circle"
    }
  ],
  "voices": [
    {
      "id": "1006",
      "type": 1,
      "title": "初次见面…",
      "text": "你好，我是沉玉谷手工艺工会的蓝砚。是想做点摆件、篮子还是花瓶、家具之类的呢？呃，备用的藤枝藤条不多了，得先去山里采一趟…你也想帮忙？嘻嘻，你人真好，我多送你一顶藤编遮阳帽可好？"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·每日计划",
      "text": "今天的计划？嗯…听随当下的心意而动。明天也是，每天都是，嘻嘻。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·传家宝",
      "text": "好的藤器经篾薄如绸，纬条细若丝，经久不坏…说它能跟银器一样当传家宝一点都不夸张。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·燕子",
      "text": "天暖燕子么搭窝窝，升雷扯闪么我家躲。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "赶不及躲雨了，那——安心淋雨吧，还省了跑步的力气。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "呜哇！借、借你手握一会！"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "阳光很好…",
      "text": "看，阳光扫到的地方都镀上了一层金欸。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "起风的时候…",
      "text": "听见吗？我头上的银饰叮铃…叮铃…风很温柔呢！"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "叮叮叮叮叮——风有点生气了啊。"
    },
    {
      "id": "1206",
      "type": 1,
      "title": "在沙漠的时候…",
      "text": "喝点水吗？尝尝我瓶子里的吧，泡薄荷叶子果然是明智的选择呢。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "被鸟叫吵醒了？哈哈，我去跟它们商量商量，但不一定奏效哦，它们有时也不听我的话。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "采了些很新鲜的花，我这就带回去给妈妈做好吃的…你也来嘛，我家里人见到你肯定高兴！"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "夜市里有碳烤小昆虫！想一起去尝尝吗？"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "我好困…先睡了先睡了，就不陪你熬夜了。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于蓝砚自己·幸福感",
      "text": "幸福感就是…每一口都细嚼慢咽直到吃完碗里最后一粒米，躺在草地上听着耳边的呼呼风声睡午觉，不被打扰地看完整整十册的志怪连载小说！"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于蓝砚自己·奇门世家",
      "text": "那位万象风角灵官在蓝氏的族谱中确有记载，可我家这一脉早已从宗家分枝散叶了。奇门术法纷繁复杂，我也只是学了个皮毛而已，有很多难题我还要向前辈们请教呢…但唯独扎藤人的手艺就连爷爷都要向我看齐，哈哈…这能算一种「独当一面」吗？"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·握手？",
      "text": "坐好。朋友。握手~\\n啊不不，我是让小动物们看我，不是叫你坐下啦！快请起来…这句话的意思是「大家看过来哦，今天有一位新朋友跟我们一起玩！」有点难懂吗？唔…「坐好」可以是「先别动」或者「听我说」，也可以是「停下来」…规律吗？哎呀总之你多来山里跟我们玩，自然就懂啦。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·握手！",
      "text": "来呀，握个手，抱一个吧。\\n嗯…？来握手呀？哈哈，这回真的是我想要跟你握手的意思啦！好朋友之间不是这样相互鼓励的吗？对不起哦，怪我没有事先说清楚。但也没关系，我会多去找你玩，这样自然你也懂我我也懂你啦。"
    },
    {
      "id": "3006",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "感谢神之眼的助力，我居然能毫不费力地将环刃抛起又稳稳接住…啊，环刃非常锋利，小朋友切勿模仿！但如果是你…要上手试试吗？身要定，臂要稳，手要疾，你的话一定能做到！"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享…",
      "text": "想吃野蕈真的不能马虎，许多有毒的蕈子根本吃不得。另一些，则必须在处理的时候加工到位，用油炒熟！如果一顿吃不完，第二顿也要再次炒熟炒透，很多人就是在第二次中的招！如果吃两口后看到家里的鸡来找你借火，或者院子里的狗喊你去收衣服了，那么不要犹豫，赶快叫它们带你去看医生吧。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "有一回，我坐在树上编小摆件，伸个懒腰的功夫，刚编的藤制松果就被小松鼠全偷走了！还好后来我用双倍数量的真松果跟它们换回来了…东西被拿走是小事，但破坏小松鼠一天的好心情就不好了！忙活了一天采松果，回家发现是假的！唔…说不定还会被别的小松鼠嘲笑呢…"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于香菱…",
      "text": "都说第一印象很重要，在万民堂吃过在璃月港的第一顿饭后，我就后悔了。后悔怎么没有早点来璃月港，这样说不定能早点认识香菱！她听说我老家山里有许多罕见食材后，忙不迭就开始计划来沉玉谷的行程了，到时我一定得让她满载而归。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于胡桃…",
      "text": "胡堂主给人感觉总是嘻嘻哈哈的，哪怕在危急的困境中她都没有忘记说玩笑话来安抚我…我跟她认识的时间不长，她一直都这样乐观积极吗？嗯…不管怎样，至少从今天开始，祝愿她笑的时候是真的很开心，而不是为了不让身边的人担心。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于刻晴…",
      "text": "玉衡大人什么时候能闲下来呢？海灯节期间看她东奔西跑忙个不停，也没能找到机会请她吃顿饭，好好感谢她的招待…我还想拜托她帮我梳一对跟她一样的猫猫耳朵呢…会不会很僭越？但直觉告诉我她不会介意欸…"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于行秋…",
      "text": "我曾在山林里偶遇过行秋少爷几回，他身边没有飞云商会的伙计跟着，看起来不像在办公事…在那以后他时不时会给我送几本最新出版的志怪小说，请我帮他保守秘密。完了…我是不是不小心说出来了…这下请你帮我们俩都保守住秘密啊！"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于重云…",
      "text": "有一次我跟着爷爷上门占卦，正巧碰到他从事主家中沮丧离开…我本以为屋里头的情况不容乐观，就连他也无计可施了。可我进屋后并没有感受到任何不妙的气息，爷爷这边得出的也是吉卦…兴许是他费了大功夫，累到没力气说话了。你说他很可能什么都没做？那我就更不懂了…"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于嘉明…",
      "text": "我跟嘉明从小就认识，还记得他小时候是家喻户晓的淘气大魔王，现在完全看不出来？哈哈，也许这就是成长吧，我也跟小时候不太一样呢。但有一点他始终没变——就是走到哪总会带点好吃的在身上，每次回来都不会忘记给家乡朋友带些外地的点心。当然，更不会忘记打包一堆家乡小吃带走…"
    },
    {
      "id": "4007",
      "type": 1,
      "title": "关于七七…",
      "text": "七七姑娘喜欢小团雀对吗？想用藤皮编一只送给她…你知道她喜欢什么颜色吗？"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解蓝砚·其一",
      "text": "先别说话！稍等一下…马上…编完这个把手就好…呼…搞定！嘻嘻别见怪，我脑筋比较简单，一时只能干一件事。但现在可以专心跟你聊天啦。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解蓝砚·其二",
      "text": "要来山里面玩吗？可以和柔柔羊玩躲避头槌，或者让朱喙鹈鹕扮演大嘴巴强盗，在限定时间内从它嘴里解救可怜的玉玉心羽鲈…想玩风行迷踪？你当猎手？哼哼，很自信嘛。好吧，要是你急得打转，我会摇响银铃给你提示的，摸到我的发尖就算你赢，我也是很自信的哦。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解蓝砚·其三",
      "text": "我头上的银饰是「银翎翦玉玄鸟」，是家中祖传的宝贝。银簪、银项圈、胸兜坠是爸爸妈妈给我的庆生礼物…噢，银手镯是有一年海灯节爷爷送的，银耳坠好像是逐月节的礼物…还有庆祝我学会用风之翼送的、庆祝我拿到神之眼送的、庆祝我吃了满满三大碗米饭送的…\\n呵呵，在我们家族的传统里，银器有避邪解毒，护佑平安的作用，所以家人们总会想着法子给我添置…\\n一套行头下来确实很沉呢…是沉甸甸又令人安心的爱哦。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解蓝砚·其四",
      "text": "小时候，家里放的藤人常常让我发怵，该怎么描述好呢…黑黑灰灰的枯草随便一扎，是小孩子看了就会做噩梦的程度！当时我觉得爷爷一定是中邪了，才把我送去跟宗家的姐姐学害人的法术呢！于是半夜壮着胆子，把能找到的藤人统统烧掉了。好在吸收了病气的藤人本来就是要被焚毁的，算是没捅大篓子…\\n从那时我就开始思考，如果把藤人做得可爱一些，是不是就不容易被人误解成歪门邪术了呢？"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解蓝砚·其五",
      "text": "藤编不难的，我真没骗你！再怎么复杂精妙的工艺，也离不开最简单的一行一竖，一经一纬，只要稍微有点耐心都能编出东西来！比起手艺，更难的是「细心」，再难一些，是要有「恒心」…但在我看来这些都不是最关键的，要我说，最最重要的，是「开心」。要是做起来不开心，什么事情都做不好的，我讲的不止是藤编…总之，要开心呀！我也是，你也是！"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "蓝砚的爱好…",
      "text": "之前我特别想要求证溺鬼的传说，就用棍子伸进闹水鬼的湖里…结果棍子真的被拽住了！水下面全是水草！要是下去游泳不被缠住才怪了…\\n我还听说，日落后不要吃日落果，半夜时分不能对着镜子削苹果，这里头到底有什么依据呢…唔…"
    },
    {
      "id": "6012",
      "type": 1,
      "title": "蓝砚的烦恼…",
      "text": "剪毛刺可真累人啊，既费眼睛又费手…把我十个指头都扎了个遍…呜。"
    },
    {
      "id": "6003",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "新鲜的花不仅好看好闻，做成糕饼还很好吃！清新不甜腻，再泡上一壶花茶…唔…走吧，一起去采花？不用找花篮啦，去到山里我现编一个。"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "「糖也只在开心的时候吃才甜」，没心情的话吃什么都觉得差点意思…嘻嘻，好在这种情况很少发生。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "好吃欸！稍等，我去把珍藏的纯银餐具拿出来，这才配得上这道菜嘛！"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "噢，谢谢。这里有蘸水哦，蘸着吃更美味。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "你尝过了？肚子疼吗？眼前有小人在打转吗？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "#按照家里的传统，生日嘛，总得收点银器傍傍身的。喏，这两个小藤人送你，头上有银燕的是我，{M#拿着小银剑的是你}{F#戴着花的是你}，嘻嘻，像不像？\\n藤草我提前熏制过，挂在背包上可以帮你驱蚊除虫。小银饰样式也是我自己设计的，从银匠师傅手里拿回来后又仔细打磨了边角，绝对不会刮手。\\n那么，祝你生辰快乐，愿福气运气常伴你左右！"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "等等，我才编了两个结你怎么就…是你太快了还是我太慢了呢…"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "银器要时常擦拭才能焕发光亮，人果然也要不断磨练才能「身轻如燕」呀。"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "握手~握手~握手~还记得吗？意思是表示开心，表示感谢，表示一切好的事情好的心情。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "「燕衔泥，莫与齐」…别小瞧我哟，我的实力一路增长，如今要保护你也算绰绰有余了吧。哎呀，我知道这有不少你的功劳在里头…很感谢你！"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "元素战技·其一",
      "text": "翻飞。"
    },
    {
      "id": "100005",
      "type": 2,
      "title": "元素战技·其二",
      "text": "穿织。"
    },
    {
      "id": "100006",
      "type": 2,
      "title": "元素战技·其三",
      "text": "跃风。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "搬疾运厄。"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "玄燕传喜。"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "漫卷翩翩。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "可以分我一些吗？沾沾喜气。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "好消息！你快看里面有什么？"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "别急，我来数数…"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "给我点时间…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "有人帮忙吗？"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "难办了…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "不能硬撑了，快撤下来！"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "换我来吧，它们抓不住我。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "唯独现在…不能倒下…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "银铃…不响了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "飞不起来…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "别。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "不对头！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "脾气真差！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "去哪都行，不去也行。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "赶街子去喽。"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "来啦来啦。"
    }
  ]
}