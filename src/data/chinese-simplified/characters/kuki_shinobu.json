  "outfits": [
    {
      "id": 206500,
      "name": "荒泷鬼副手",
      "description": "久岐忍的装扮款式。标志性的鬼面铠象征着荒泷派中最为威严的那位「鬼副手」。",
      "isDefault": true,
      "characterName": "久岐忍",
      "characterId": 10000065,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Shinobu_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "初次见面…",
      "text": "你好，我是荒泷派的二把手久岐忍。我们承包多种业务，货运物流、安保维持、房屋补漏、表演驻唱等等。需要我们请随时联系，这是我的名片，还请收下。"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "闲聊·麻烦事",
      "text": "有麻烦事要处理的话，直接告诉我就好，我来摆平。"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "闲聊·证书",
      "text": "执业证书考试都有固定评判标准，肯学肯练就能考过，没什么难的。"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "闲聊·荒泷派",
      "text": "要是荒泷派犯了事，我会揪他们去认错的。"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "下雨的时候…",
      "text": "不用打伞了，腿脚快点就行。"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "打雷的时候…",
      "text": "当心点。这种天，应该没人会想引雷上身吧？"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "下雪的时候…",
      "text": "快点把事情办完就撤吧，别浪费时间。"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "阳光很好…",
      "text": "嗯，天气真好，但总有种不祥的预感…希望是我多虑了吧。"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "刮大风了…",
      "text": "唔…这风还算不错。"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "早上好…",
      "text": "早啊，看你的样子是准备去锻炼了？没想到你还挺勤快的。"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "中午好…",
      "text": "想吃什么？最近攒了不少钱，午饭我请你。"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "晚上好…",
      "text": "有些委托，在夜晚才好办。我不放心交给他们，都是我亲自上。"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "晚安…",
      "text": "该休息的时候就去休息吧，不用管我。"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "关于久岐忍自己·二把手",
      "text": "招揽业务、维系成员安定是我的职责，除此之外还有——去奉行所捞人，归还零食和玩具，抓捕接了活却在暗处偷懒的成员…不过，这些额外工作属于荒泷派特色，其他任何组织的二把手，理论上都不需要做这些。当然，也做不到像我这样。"
    },
    {
      "id": "2005",
      "type": 1,
      "title": "关于久岐忍自己·退路",
      "text": "你说帮派解散？首先，那种事应该不会发生。其次，就算发生了，我有什么好担心的呢。饿肚子的人不可能是我。"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "关于我们·笔记",
      "text": "要是你心血来潮想考什么证，不如直接找我吧，我把笔记借你。备注和要点很详细，不愁你学不会。"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "关于我们·善后",
      "text": "不管你是不是荒泷派的人，我都不会把你当外人。你就往前走吧，幕后的工作交给我。放心，这方面我是专业的，多复杂的事都能办妥。嗯？担心我的安危？呵，这方面你也放心吧，这些年的摸爬滚打，不是白经历的。"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "关于「神之眼」…",
      "text": "和证书一样，这是对我能力的肯定和证明。但不同的是，我至今不知道它的考核标准。"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "有什么想要分享·面铠",
      "text": "戴上面铠是不想被熟人认出来。尤其和荒泷派一起出任务时，要是熟人看见了，指指点点，那群家伙肯定会趁机起哄。啧，光是想想，就很烦。不能再有下次了…咳，没什么。"
    },
    {
      "id": "3005",
      "type": 1,
      "title": "有什么想要分享·派中法度",
      "text": "我制定了荒泷派的「派中法度」，他们就应该谨遵法度行事。嗯？你问他们为什么愿意听话？因为我比他们更有说服力。我的语言和拳头，姑且还算是有点分量。"
    },
    {
      "id": "3003",
      "type": 1,
      "title": "感兴趣的见闻…",
      "text": "神社中流传着一种说法，将鸣草织成一个圈缠在身上，就能祛灾祈福，你信吗？我倒觉得，鸣草，还是麻痹效果更实用。"
    },
    {
      "id": "4001",
      "type": 1,
      "title": "关于雷电将军…",
      "text": "解除锁国后，雷电将军陆续颁布了不少法令支持各行各业的发展。我在锁国期间考的证书全都派上了用场，荒泷派也不那么拮据了。祸福相依，没想到到头来还得感谢她。"
    },
    {
      "id": "4002",
      "type": 1,
      "title": "关于九条裟罗…",
      "text": "九条小姐啊，她是我的朋友。嗯？我认识她让你觉得很意外吗？噢，你可能误会了，我加入荒泷派之前就跟她有交情。我们俩的切磋，还难分胜负呢。"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "关于八重神子…",
      "text": "就连堂堂鸣神大社的宫司大人，都要靠副业来解闷，可见当巫女是有多无聊。我是绝对不会回去当巫女的。"
    },
    {
      "id": "4004",
      "type": 1,
      "title": "关于荒泷一斗…",
      "text": "老大有很多不算愉快的过去，却还能保持快乐阳光，挺难得的。他对我们很不错，他的纯粹也感染着荒泷派的大家。当然，这不能成为他横冲直撞影响别人的借口。如果他找你麻烦，尽管告诉我。我会好好收拾他，让他后悔对你无礼。"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "关于烟绯…",
      "text": "那时候跟家里闹翻了，只想着有多远逃多远，就跑去璃月学律法了。得亏这样，有幸认识了烟绯师姐。在律法咨询这块，她简直就是活字典。我？执业证书倒是有的，不过这个职业的约束也不少，并不是最适合我的。"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "关于鹿野院平藏…",
      "text": "他和普通天领奉行同心不一样，从未见他做什么巡逻、抓捕的活。他偶尔会找我买线索，作为交换，我希望他能在我去奉行所捞人时帮我美言几句，他也爽快答应了。这笔交易还算值，毕竟让弟兄们收集点市井见闻是很简单的事。"
    },
    {
      "id": "5001",
      "type": 1,
      "title": "想要了解久岐忍·其一",
      "text": "我做过很多不同的工作，相关的执业证书也有不少。管理方面，带过小型团队，负责人员统筹和资源调配…呃，抱歉，面试多了就说习惯了，别介意。"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "想要了解久岐忍·其二",
      "text": "我家是巫女世家，但我不适合当巫女。刚逃出来那会儿，我觉得要多积累，以免没有傍身之技。什么厨师、裁缝、格斗、律法咨询、出版编辑…我都学了。没想到真正进了社会才发现，学的已经完全够用了。"
    },
    {
      "id": "5003",
      "type": 1,
      "title": "想要了解久岐忍·其三",
      "text": "你说我社交场合很厉害？呵，毕竟在外流浪了那么久，总得学会察言观色。更何况在多数时候，理亏的那一方都是我们。我不讨厌摆出那些表情，但可以的话，我还是选择不笑的好。"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "想要了解久岐忍·其四",
      "text": "刚进荒泷派的时候，老大要我教小弟们怎么打架。所以我上来第一件事，就变成了把他们挨个揍趴下。没想到，一个个鼻青眼肿的，却睁大眼睛，张嘴就叫我「忍姐」，还要我好好带领他们。哼，那时候我就知道这是一群笨蛋。但没关系，笨蛋不会拖我后腿，我会解决一切问题。"
    },
    {
      "id": "5005",
      "type": 1,
      "title": "想要了解久岐忍·其五",
      "text": "留在荒泷派是我自己的选择。收拾烂摊子难免令人火大，但他们也给了我无可替代的真诚。最好的东西都先留给我、从不泼我冷水、在我宣布决定后闹哄哄地鼓掌吹口哨…我知道外面对荒泷派的评价不太好，他们自己也不在乎，但我还是想努努力，改变别人对我们的印象。因为，对待「家人」，自己可以偶尔抱怨，但就是不想其他人说他们的不好。"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "久岐忍的爱好…",
      "text": "平时混帮派，闲着也是闲着，经常不小心读完一本书，不小心就把证考了。不也挺好吗？家里问起来，我也没虚度时光，出去谈工作，也算得上有资本。在这个凡事讲究实力的社会里，我这种有证书的混子，到哪里都能吃得饱饭。"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "久岐忍的烦恼…",
      "text": "以前不想被抓回去当巫女，就决心只靠自己站稳脚跟。至少目前看来，我干得还不错。"
    },
    {
      "id": "6005",
      "type": 1,
      "title": "喜欢的食物…",
      "text": "就算刚吃过拉面或者饺子之类很管饱的食物，最后还是想以一小碗米饭结束。米饭好吃，没什么其他原因，有问题吗？"
    },
    {
      "id": "6004",
      "type": 1,
      "title": "讨厌的食物…",
      "text": "厨师证到手后，我就更加坚定那个从璃月听来的说法：没有难吃的食物，只有不合格的厨师。"
    },
    {
      "id": "6007",
      "type": 1,
      "title": "收到赠礼·其一",
      "text": "真不简单。咳…我就再多吃一口。"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "收到赠礼·其二",
      "text": "你做的？嗯…这种水平去考个厨师证应该绰绰有余。"
    },
    {
      "id": "6009",
      "type": 1,
      "title": "收到赠礼·其三",
      "text": "我直说吧，你是不是放错调料了？"
    },
    {
      "id": "7001",
      "type": 1,
      "title": "生日…",
      "text": "生日快乐，来，这个鸣草特制飞镖送给你。小心点，嗯，对，要像这样拿…投掷前记得计算弧度。呵呵，看你喜欢我就放心了。哦，别把它当玩具，还是有一定危险性的。想多训练一下的话，我来教你。"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "突破的感受·起",
      "text": "基本功不过关，就什么都不用谈了。这就是初级证书的意义。"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "突破的感受·承",
      "text": "中级证书到手，已经可以处理大多数麻烦了。有什么麻烦事需要我帮你解决？"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "突破的感受·转",
      "text": "高级证书绝不是轻易就能得到的，天赋和实战的累积缺一不可。"
    },
    {
      "id": "8004",
      "type": 1,
      "title": "突破的感受·合",
      "text": "证书只能用来评判技能的专业程度，无法对付出或情感的投入进行量化。你我的交情也不能只用一句感谢来表达，还是用我最擅长的行动来说明一切吧。"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "元素战技·其一",
      "text": "鸣草结环！"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "元素战技·其二",
      "text": "解厄！"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "元素战技·其三",
      "text": "好好站稳了。"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "元素爆发·其一",
      "text": "给我…安分点！"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "元素爆发·其二",
      "text": "祈雷…祓除！"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "元素爆发·其三",
      "text": "别来碍事。"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "打开宝箱·其一",
      "text": "嗯，积少成多。"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "打开宝箱·其二",
      "text": "这票也稳了。"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "打开宝箱·其三",
      "text": "你的了。"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "生命值低·其一",
      "text": "给、我、站、住…"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "生命值低·其二",
      "text": "算是惹怒我了…"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "生命值低·其三",
      "text": "哼，该我了吧…"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "同伴生命值低·其一",
      "text": "我来善后。"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "同伴生命值低·其二",
      "text": "行了交给我，别硬撑。"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "倒下·其一",
      "text": "这次…是给人添麻烦了啊…"
    },
    {
      "id": "500002",
      "type": 2,
      "title": "倒下·其二",
      "text": "荒泷派就拜托你了…"
    },
    {
      "id": "500003",
      "type": 2,
      "title": "倒下·其三",
      "text": "这是对我的…侮辱…"
    },
    {
      "id": "900002",
      "type": 2,
      "title": "普通受击·其一",
      "text": "再来。"
    },
    {
      "id": "910001",
      "type": 2,
      "title": "重受击·其一",
      "text": "等着！"
    },
    {
      "id": "910002",
      "type": 2,
      "title": "重受击·其二",
      "text": "找打是吧！"
    },
    {
      "id": "600001",
      "type": 2,
      "title": "加入队伍·其一",
      "text": "看我眼色行动。"
    },
    {
      "id": "600002",
      "type": 2,
      "title": "加入队伍·其二",
      "text": "这次是什么麻烦？"
    },
    {
      "id": "600003",
      "type": 2,
      "title": "加入队伍·其三",
      "text": "希望不是烂摊子。"
    }
  ]
}