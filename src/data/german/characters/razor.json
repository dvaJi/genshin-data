  "outfits": [
    {
      "id": 202000,
      "name": "Wilder Sprint",
      "description": "Razors Kleidung. Einfache Kleidung, die für das Laufen in der Wildnis geeignet ist.",
      "isDefault": true,
      "characterName": "Razor",
      "characterId": 10000020,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Schön, dich kennenzulernen.",
      "text": "Dein Geruch ... gut. Wir jagen zusammen!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Gespräch – Geruch",
      "text": "*schnüffel*, Geruch von Kaninchen ..."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Gespräch – Hunger",
      "text": "Los? Razor hungrig."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Gespräch – Ausschau",
      "text": "Ich passe auf. Wenn du gehst, ruf mich."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Wenn es blitzt – Warnung",
      "text": "Wenn du Angst hast, versteck dich."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Wenn es blitzt – Begleitung",
      "text": "Pass auf, Bäume, folge mir!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Wenn es windig ist ...",
      "text": "Wind ... hah, fühlt sich gut an."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Ein Sturm zieht auf.",
      "text": "Wind ... sticht ein wenig, tut ein bisschen weh."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Guten Morgen.",
      "text": "Sonne ist raus. Wir jagen zusammen?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Guten Tag.",
      "text": "Großes Stück Fleisch, glücklich!"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Guten Abend.",
      "text": "Schlaf du, ich gucke Mond an."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Gute Nacht.",
      "text": "Du schläfst, ich wache. Morgen jagen wir zusammen."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Über Razor ...",
      "text": "Ich bin ein Wolf. Kein Papa, keine Mama, nichts."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Über uns – Freundschaft",
      "text": "Du bist ein Freund. Ich gehe mit dir jagen."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Über uns – Waffe",
      "text": "Ich habe Eisenklauen und Zähne aus Blitzen, ich beschütze dich."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Über das „Göttliche Auge“ ...",
      "text": "Das „Göttliche Auge“ hilft Razor. Gibt Razor Zähne aus Blitzen, beschützt Lupical."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Willst du mir etwas mitteilen?",
      "text": "Abends, Sterne sind so hübsch. Der Himmel wie ein Teich, so viele Sterne da.\\nAbend in der Stadt, auch viele Sterne."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Interessante Vorkommnisse ...",
      "text": "Die Wölfe sind meine Lupical, meine Familie."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Über Lisa ...",
      "text": "Lisas Blitze, sie machen Himmel dunkel. Wirklich unheimlich."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Über Barbara ...",
      "text": "Barbara, so strahlend, so nett."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Über Diluc ...",
      "text": "Diluc, rot und schwarz. Kalt und heiß."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Über Venti ...",
      "text": "Gedichte ... hmm, verstehen Razor nicht. Aber Lupical mag Gedichte."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Über Bennett ...",
      "text": "Bennett viel sprechen. Zusammen essen, nicht satt."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Über Klee ...",
      "text": "Klee, Freund! Freund, aber Kopfweh."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Über Varka – Fremd",
      "text": "Varka? Razor kennt nicht ..."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "Über Varka – Erinnerung",
      "text": "Ah ... Varka Name. Mann, sehr groß. Razor Name von Mann, Eisenklaue auch. Will ihn wiedersehen."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Ich will mehr über Razor erfahren I",
      "text": "Dein Geruch, Geruch von Güte. Du magst Fleisch?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Ich will mehr über Razor erfahren II",
      "text": "Du sehr stark, wie Wolf. Razor geht gern mit dir jagen. Viel zu lernen."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Ich will mehr über Razor erfahren III",
      "text": "„Lupical“ bedeutet Wolf zu Hause. Nein, es bedeutet Familie von Wolf. Meine Lupical in Wald. Sie beschützen Razor, sagen ich bin ihr Lupical."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Ich will mehr über Razor erfahren IV",
      "text": "Razor nur Lupical.\\nAber keine vier Beine, kein echter Wolf. Macht Razor manchmal traurig."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Ich will mehr über Razor erfahren V",
      "text": "#Mit dir rennen, mit dir jagen, Razor froh. Mit dir egal, ob Wolf oder Mensch!\\nDu bist Freund{F#in}, du bist meine Lupical. Hoffe, du bist auch froh."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Razors Hobbys ...",
      "text": "Razor mag Lupical. Mag Wald. Mag Freunde. Mag Laufen."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Razors Sorgen ...",
      "text": "Sprechen so anstrengend und schwer. Aber nicht sprechen geht auch nicht."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Was er so mag ...",
      "text": "Mag Fleisch. Mag Kartoffeln."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Was er nicht mag ...",
      "text": "Gemüse nicht gut. Tiere essen Gemüse, ich esse Tiere."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Geschenk erhalten I",
      "text": "Riecht gut und schmeckt ebenso gut. Hat mir gefallen."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Geschenk erhalten II",
      "text": "Dies zu essen, gibt mir Energie und macht mich glücklich."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Geschenk erhalten III",
      "text": "Essen, nicht gut. Nicht essen, nicht gut. Etwas traurig."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Dein Geburtstag ...",
      "text": "Heute vor langer Zeit ... du geboren! Heute zusammen fröhlich. Zusammen essen Fleisch!"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Beginn",
      "text": "Arme, dicker geworden?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Fortschritt",
      "text": "Klauen, Zähne, stärker geworden!"
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Höhepunkt",
      "text": "Laufen, jagen. Nicht genug! Muss stärker werden."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Ende",
      "text": "Zähne, Klauen, Beine. Alles stärker, stärker, dich beschützen!"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Elementarfähigkeit I",
      "text": "Geh weg!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Elementarfähigkeit II",
      "text": "Ah!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Elementarfähigkeit III",
      "text": "Au!"
    },
    {
      "id": "100004",
      "type": 2,
      "title": "Elementarfähigkeit IV",
      "text": "Bleib weg!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Spezialfähigkeit I",
      "text": "Au!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Spezialfähigkeit II",
      "text": "Blitz!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Spezialfähigkeit III",
      "text": "*brüll*"
    },
    {
      "id": "200004",
      "type": 2,
      "title": "Spezialfähigkeit IV",
      "text": "Aah!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Truhe öffnen I",
      "text": "Diese Dinge ... sind nützlich?"
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Truhe öffnen II",
      "text": "Leere Truhe ... gut für Lagerung."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Truhe öffnen III",
      "text": "Der Geruch eines Schatzes ... seltsam."
    },
    {
      "id": "410001",
      "type": 2,
      "title": "Niedrige LP I",
      "text": "Das tut weh!"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "Niedrige LP II",
      "text": "Au!"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "Niedrige LP III",
      "text": "Bring dich um!"
    },
    {
      "id": "400001",
      "type": 2,
      "title": "Verbündeter hat niedrige LP I",
      "text": "Das geht nicht."
    },
    {
      "id": "400002",
      "type": 2,
      "title": "Verbündeter hat niedrige LP II",
      "text": "Wach auf!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "Ohnmächtig I",
      "text": "Kann nicht atmen ..."
    },
    {
      "id": "500002",
