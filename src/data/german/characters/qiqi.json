  "outfits": [
    {
      "id": 203500,
      "name": "Sommerkühle Träume",
      "description": "Qiqis Kleidung. Ein Gewand der Kräutersammlerin, das ihr aufgrund der aufgeklebten Talismane großen Seelenfrieden bringt.",
      "isDefault": true,
      "characterName": "Qiqi",
      "characterId": 10000035,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Qiqi_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Schön, dich kennenzulernen.",
      "text": "Ich bin Qiqi. Ich bin ein Zombie. Ich ... Was sollte ich jetzt sagen?"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Gespräch – Selbstgespräche",
      "text": "Weißt du was? ... Ich nämlich nicht."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Gespräch – Angst vor Hitze",
      "text": "Ich will an einen kühleren Ort."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Gespräch – Training",
      "text": "Und eins und zwei und drei und vier ..."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Wenn es regnet ...",
      "text": "Hab meinen Schirm schon wieder vergessen."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Wenn es schneit ...",
      "text": "Ich will einen Schneemann bauen. Willst du mitmachen?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Wie sonnig ...",
      "text": "Wir sollten heute drin bleiben."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Wenn es windig ist ...",
      "text": "Es ist kühl, das ist angenehm."
    },
    {
      "id": "1205",
      "type": 1,
      "title": "Ein Sturm zieht auf.",
      "text": "Ha... Halt mich fest! Sonst bläst der Wind mich davon!"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Guten Morgen.",
      "text": "Morgen? Was mache ich heute? Mal ins Heft schauen ..."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Guten Tag.",
      "text": "Ich habe vergessen, die Zutaten für die Medikamente für Herrn Bai zu sortieren."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Guten Abend.",
      "text": "Abend. Heute war ich ... Was habe ich heute überhaupt gemacht?"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Gute Nacht.",
      "text": "Gute Nacht! Ich werde meine Übungen machen. Bitte geh raus."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Über Qiqi ...",
      "text": "Ich ... Was hast du eben gesagt?"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Über uns – Gedächtnis",
      "text": "Ich vergesse die meisten Dinge schnell. Aber das macht nichts."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Über uns – Gedächtnistraining",
      "text": "Ich trainiere jetzt öfter mein Gedächtnis. Ich werde dich also schon nicht vergessen."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Über das „Göttliche Auge“ ...",
      "text": "Das Göttliche Auge kann zwar nicht die Zeit anhalten. Leute, die mir wichtig sind, kann ich damit aber beschützen."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Willst du mir etwas mitteilen?",
      "text": "Selbst ich bin in besserer körperlicher Verfassung als Herr Bai."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Interessante Vorkommnisse ...",
      "text": "Manchmal kommen Finken in die Nähe des Geschäfts. Eine nette kleine Schar."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Über Baizhu ...",
      "text": "Ich erinnere mich nicht an Herrn Bais Gesicht ... Aber das macht nichts."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Über Hu Tao ...",
      "text": "Ich hasse Hitze, falsches Lächeln und Tod ... Abscheulich!"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Über Xiao – Name",
      "text": "Klingt wie eine Antiquität."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Über Xiao – Erinnerung",
      "text": "Wer war das nochmal?"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Über Xinyan ...",
      "text": "Wer soll das sein?"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Über Yaoyao ...",
      "text": "Süß ... wie Finken."
    },
    {
      "id": "4007",
      "type": 1,
      "title": "Über die kleine Ming ...",
      "text": "Nachts habe ich manchmal das Gefühl, als würde jemand mit mir Gymnastik machen. Nur Einbildung?"
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Über Prune ...",
      "text": "Von außen sieht sie hart aus ... aber ihre Handflächen sind schön weich. Ich mag sie."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Ich will mehr über Qiqi erfahren I",
      "text": "Kann ich dir helfen?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Ich will mehr über Qiqi erfahren II",
      "text": "Ich mache Gymnastik, damit ich so geschmeidig bleibe wie ein normaler Mensch. Wenn ich nichts mache, werde ich wieder ganz steif ..."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Ich will mehr über Qiqi erfahren III",
      "text": "Manche wollen mich ausnutzen, andere haben Angst vor mir. Aber du ... Du bist anders."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Ich will mehr über Qiqi erfahren IV",
      "text": "Seit wir uns das erste Mal gesehen haben, hast du mir das Herz erwärmt. Aber nicht so, dass es unangenehmt wäre. Ich danke dir. Das macht mich froh. Leider kenne ich dich nur so, wie du jetzt bist. Wenn ich dich vergesse ... Nein, ich werde mir befehlen, dich nicht zu vergessen."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Ich will mehr über Qiqi erfahren V",
      "text": "Früher wollte ich einfach leben ... Aber ich wusste nicht einmal, wofür. Jetzt glaube ich es zu wissen. Ich will mit dir leben. Ich ... Ich will für immer bei dir sein. Würde das gehen? Ja? Ich werde dich auch immer beschützen!"
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Qiqis Hobbys ...",
      "text": "Ich hätte gern ein Haustier ... sowas wie einen Finken."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Qiqis Sorgen ...",
      "text": "Ich weiß nicht, wieso. Aber ich fühle mich sehr unwohl, wenn es heiß wird."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Was sie so mag ...",
      "text": "Ich mag Kokosmilch, obwohl ... ich sie nicht schmecken kann."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Was sie nicht mag ...",
      "text": "Tut mir leid, ich weiß nicht."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Geschenk erhalten I",
      "text": "Kalt. Das gefällt mir, obwohl es nicht gewürzt ist ..."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Geschenk erhalten II",
      "text": "Hmm ..."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Geschenk erhalten III",
      "text": "Ein wenig heiß ..."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Dein Geburtstag ...",
      "text": "Alles Gute zum Wiedergeburtstag! Hier, ein Kräuterpäckchen. Erschrocken? Als du mir das letzte Mal davon erzählt hast, habe ich mir das Datum aufgeschrieben. Ich sehe mir den Zettel jeden Tag an, damit ich das Datum nie vergesse."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Beginn",
      "text": "Oh, mehr Kraft ... Und jetzt?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Fortschritt",
      "text": "Ah, ich verstehe. Wenn ich stärker werde, muss ich mich mehr darauf konzentrieren, meine Stärke zu kontrollieren."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Höhepunkt",
      "text": "Früher wollte ich nicht unbedingt stärker werden. Aber jetzt ... Jetzt hoffe ich, dass ich noch stärker werden kann."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Ende",
      "text": "Das habe ich nur geschafft, weil du bei mir bist. Danke! Ich möchte dir etwas vorschlagen. Von nun an möchte ich dich beschützen. Stimmst du zu?"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Elementarfähigkeit I",
      "text": "Kreis des Lebens."
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Elementarfähigkeit II",
      "text": "Das Leben geht weiter."
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Elementarfähigkeit III",
      "text": "Geh."
    },
    {
      "id": "100004",
      "type": 2,
      "title": "Elementarfähigkeit IV",
      "text": "Erwache."
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Spezialfähigkeit I",
      "text": "Erteile Befehle. Erhalte Befehle."
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Spezialfähigkeit II",
      "text": "Ich bin die Fürstin der Befreiung von Leid und Elend."
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Spezialfähigkeit III",
      "text": "Eine Schachtel voller Adeptentricks."
    },
    {
      "id": "700001",
      "type": 2,
      "title": "Rennen – Start I",
      "text": "Schneller?"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "Windgleiter öffnen I",
      "text": "Hä?"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Truhe öffnen I",
      "text": "Oh, hübsch."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Truhe öffnen II",
      "text": "Schatztruhen ... hmm ... Bringen die was?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Truhe öffnen III",
      "text": "War hier nicht vor einer Sekunde noch etwas drin ...?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "Niedrige LP I",
      "text": "Au."
    },
    {
      "id": "410002",
      "type": 2,
      "title": "Niedrige LP II",
      "text": "Aah!"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "Niedrige LP III",
      "text": "Ich muss weiterleben ..."
    },
    {
      "id": "400001",
      "type": 2,
      "title": "Verbündeter hat niedrige LP I",
      "text": "Vorsicht."
    },
    {
      "id": "400002",
      "type": 2,
      "title": "Verbündeter hat niedrige LP II",
      "text": "Halt. Lass mich das machen."
    },
    {
      "id": "500001",
      "type": 2,
      "title": "Ohnmächtig I",
      "text": "Ich will nicht ... versiegelt werden ..."
    },
    {
      "id": "500002",
      "type": 2,
      "title": "Ohnmächtig II",
      "text": "Kalt ..."
    },
    {
      "id": "500003",
