    },
    {
      "id": 201600,
      "name": "Feuer der Nacht",
      "description": "Dilucs Kleidung. Ein unauffälliger und stilvoller Anzug für einen Adligen.",
      "isDefault": true,
      "characterName": "Diluc",
      "characterId": 10000016,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Diluc_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Schön, dich kennenzulernen.",
      "text": "Ich bin Diluc aus Mondstadt, wie bestellt. Für große Taten bin ich immer zu haben, der Rest interessiert mich nicht."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Gespräch – Entspannung",
      "text": "Zeit für eine kurze Pause, auch gut."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Gespräch – Ritterorden",
      "text": "Du solltest am besten jemanden vom Ritterorden mitnehmen, um auf dich aufzupassen."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Gespräch – Zunft",
      "text": "Ich habe noch einiges in der Zunft zu erledigen. Warum ruhst du dich nicht einfach solange aus?"
    },
    {
      "id": "1106",
      "type": 1,
      "title": "Gespräch – Vorbereitung",
      "text": "Bereite dich gut vor und greife an, bevor dein Gegner es tut."
    },
    {
      "id": "1107",
      "type": 1,
      "title": "Gespräch – Pläne",
      "text": "In der Pause kann man auch über seine nächsten Pläne nachdenken."
    },
    {
      "id": "1108",
      "type": 1,
      "title": "Gespräch – Hinweis",
      "text": "Jede Aktion ist zwangsläufig mit Risiken verbunden. Daher musst du besonders vorsichtig sein."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Wenn es regnet – Schirm",
      "text": "Ich brauche keinen Schirm, nimm du ihn dir ruhig."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Wenn es regnet – Reinigung",
      "text": "Regen? Schade, dass er die Welt nicht vom Schmutz der Korruption reinigen kann."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Wie sonnig ...",
      "text": "Solange du dir selbst treu bleibst, kann dir das Wetter nichts mehr anhaben."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Ein Sturm zieht auf.",
      "text": "Es gibt jene, die das Heulen des Windes nutzen, um die Geräusche ihrer Verbrechen zu überdecken."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Guten Morgen.",
      "text": "Keine Zeit für Höflichkeiten. Hauptsache ist, dass letzte Nacht alles in Ordnung war."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Guten Tag.",
      "text": "Magst du das geheime Menü probieren?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Guten Abend.",
      "text": "Die Nacht ist angebrochen."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Gute Nacht.",
      "text": "Gut, bis zum nächsten Mal. Ich bring dich lieber noch mit raus."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Über Diluc ...",
      "text": "Die Legende vom „Helden der Nacht“? Das hört sich interessant an."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Über uns – Bedürfnisse",
      "text": "Sag, wenn du irgendwas brauchst. Bei Geldfragen wende dich an Elzer."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Über uns – Beweise",
      "text": "Du hast bereits deine Entschlossenheit bewiesen. Dann ist es jetzt an der Zeit, dir meine zu bezeugen."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Über das „Göttliche Auge“ ...",
      "text": "Für diejenigen, die den Pfad vor Augen verloren haben, ist ein „Göttliches Auge“ ein Licht in der Dunkelheit. Für die jedoch, die erfüllt sind vom Glauben, für die ist es bloß ein Medaillon."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Willst du mir etwas mitteilen?",
      "text": "Von Zeit zu Zeit helfe ich in der „Engelsgabe“ aus, weil Tavernen die Informationszentren einer Stadt sind."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Interessante Vorkommnisse ...",
      "text": "Das ist eine Nachteule. In der Dunkelheit beobachtet sie ihre Beute, nur um dann im passenden Moment gnadenlos zuzustoßen."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Über Kaeya ...",
      "text": "Kaeya? Was dieser Mann sagt, kann man nur zur Hälfte glauben."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Über Lisa ...",
      "text": "Lisa, sie hat das Potenzial, der verlässlichste Ritter des Ritterordens zu werden. Wenn sie nur will."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Über Jean – Feinde",
      "text": "Sich mit Bagatellen aufzuhalten, ist Jeans größter Fehler."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Über Jean – Pflicht",
      "text": "Ihr unglaublicher Verantwortungssinn hat sie bisher davon abgehalten, ihre wahre Bestimmung zu finden."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Über Mona ...",
      "text": "Das Land von Mondstadt ist von der Gnade des Anemo-Archons durchdrungen, sodass keine Astrologen benötigt werden, um die Ernte vorherzusagen."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Über Diona ...",
      "text": "Diona war immer etwas grob zu mir und bisher war ich nicht in der Lage gewesen, die richtige Gelegenheit für ein Gespräch zu finden. Wenn es nun um eine Familienfehde geht ... Was? Nein? Hasst sie einfach nur Alkohol? Ich hätte nicht gedacht, dass es in dieser Stadt auch noch Schankdamen geben würde, die Alkohol hassen."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Über Varka ...",
      "text": "Großmeister Varka, nun, ich verstehe seine Absichten, dennoch verstehe ich seine Taten nicht. Aber ich habe bereits viel zu viel gesagt. Schon lange bin ich kein Ritter des Ordo Favonius mehr. Vergiss einfach, was ich gesagt habe."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "Über Eula ...",
      "text": "Ich habe von ihr gehört. Sie hat ihr eigenes Ideal. Auch ihr Versuch, sich von den Fesseln ihrer Familie zu befreien, ist lobenswert. Doch sie ... schloss sich dem Ordo Favonius an."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Ich will mehr über Diluc erfahren I",
      "text": "Du hast noch etwas Wichtiges zu tun?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Ich will mehr über Diluc erfahren II",
      "text": "Wie, du fragst nach dem Ritterorden? Ach, da gibt es nicht viel zu sagen. Wir haben nun einmal unterschiedliche Ansichten."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Ich will mehr über Diluc erfahren III",
      "text": "Es ist schon lange her, dass ich Schach mit jemandem außer meinem Haushälter gespielt habe. Ich habe genau jetzt einen Moment Zeit für eine Partie."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Ich will mehr über Diluc erfahren IV",
      "text": "Schachmatt. Puh, es ist nicht leicht, mich bis zu diesem Punkt zu drängen."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Ich will mehr über Diluc erfahren V",
      "text": "Nicht schlecht. Egal ob beim Schach oder im Kampf, du hast immer noch ein Ass im Ärmel. Mit dir zusammenzuarbeiten, ist mal was ganz anderes. Also, ich freue mich auf unsere weitere Zusammenarbeit als „Partner“."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Dilucs Hobbys ...",
      "text": "Die Kunstobjekte in meinem Haus? Die gehörten meinem Vater, sein Hobby sozusagen."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Dilucs Sorgen ...",
      "text": "Der wahre Feind, die „Finsternis“ selbst, die das Böse nährt, muss mit anderen Mitteln als dem Schwert besiegt werden ..."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Was er so mag ...",
      "text": "Du willst wissen, was in meinem Glas ist? Traubensaft, ich trinke meistens das."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Was er nicht mag ...",
      "text": "Ich mag Alkohol nicht so sehr. Ich mag einfach das Gefühl davon in meinem Mund nicht."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Geschenk erhalten I",
      "text": "Es ist exquisit. Der Geschmack ist unvergesslich."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Geschenk erhalten II",
      "text": "Man schmeckt, worauf der Chefkoch Wert legt. Schönes Gericht."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Geschenk erhalten III",
      "text": "... Danke."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Dein Geburtstag ...",
      "text": "Alles Gute zum Geburtstag! Dies ist ein wichtiger Tag für dich. Sag, was wünschst du dir? Wenn ich es erfüllen kann, werde ich es tun."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Beginn",
      "text": "Um unsere Ziele zu erreichen, ist Macht erforderlich."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Fortschritt",
      "text": "Was auf uns wartet? Ich denke selten daran.\\nEgal was in meinem Weg steht, ich muss es besiegen und weiter nach vorn streben."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Höhepunkt",
      "text": "Ich bin schon stärker geworden ... Das ist zwar noch nicht genug, aber es scheint bergauf zu gehen.\\nBevor die Dämmerung kommt, muss jemand die Dunkelheit ein wenig erhellen ..."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Ende",
      "text": "#Ich dachte immer, um Böses auszulöschen, müsste ich allein die Nacht durchstreifen.\\nAber dank deiner Hartnäckigkeit habe ich wieder einmal mehr erfahren, dass ich Unrecht hatte. Danke, {F#meine Freundin}{M#mein Freund}."
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Elementarfähigkeit I",
      "text": "Hu!"
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Elementarfähigkeit II",
      "text": "Ha!"
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Elementarfähigkeit III",
      "text": "Haah!"
    },
    {
      "id": "100010",
      "type": 2,
      "title": "Elementarfähigkeit I",
      "text": "Ho."
    },
    {
      "id": "100011",
      "type": 2,
      "title": "Elementarfähigkeit II",
      "text": "Ha."
    },
    {
      "id": "100012",
      "type": 2,
      "title": "Elementarfähigkeit III",
      "text": "Ha!"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Spezialfähigkeit I",
      "text": "Das Urteil ist gefällt!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Spezialfähigkeit II",
      "text": "Mögen die Flammen dich verschlingen!"
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Spezialfähigkeit III",
      "text": "Nimm dein Urteil entgegen!"
    },
    {
      "id": "200010",
      "type": 2,
      "title": "Spezialfähigkeit I",
      "text": "Jetzt wird abgerechnet!"
    },
    {
      "id": "200011",
      "type": 2,
      "title": "Spezialfähigkeit II",
      "text": "Läuternde Flammen!"
    },
    {
      "id": "200012",
      "type": 2,
      "title": "Spezialfähigkeit III",
      "text": "Die Dämmerung bricht an!"
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Truhe öffnen I",
      "text": "Hm, besser als nichts."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Truhe öffnen II",
      "text": "Ich nehme an, das wird reichen."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Truhe öffnen III",
      "text": "Wir müssen noch mehr davon einsammeln."
    },
    {
      "id": "410001",
      "type": 2,
      "title": "Niedrige LP I",
      "text": "Mehr hast du nicht zu bieten?"
    },
    {
      "id": "410002",
      "type": 2,
      "title": "Niedrige LP II",
      "text": "Verdammt!"
    },
    {
      "id": "410003",
      "type": 2,
      "title": "Niedrige LP III",
      "text": "Dafür wirst du bezahlen."
    },
    {
      "id": "400001",
      "type": 2,
      "title": "Verbündeter hat niedrige LP I",
      "text": "Vorsicht!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "Verbündeter hat niedrige LP II",
      "text": "Nimm dir einfach eine kurze Pause!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "Ohnmächtig I",
      "text": "Was habe ich falsch gemacht ..."
    },
