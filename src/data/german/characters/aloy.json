      "text": "Vorsicht!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "Verbündeter hat niedrige LP II",
      "text": "Nicht zu voreilig!"
    },
    {
      "id": "500001",
      "type": 2,
      "title": "Ohnmächtig I",
      "text": "Wo ist mir der Fehler unterlaufen ..."
    },
    {
      "id": "500002",
