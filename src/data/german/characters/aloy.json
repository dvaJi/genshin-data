  "outfits": [
    {
      "id": 206200,
      "name": "Maschinenjägerin",
      "description": "Aloys Kleidung. Passend für das Leben in der Wildnis.",
      "isDefault": true,
      "characterName": "Aloy",
      "characterId": 10000062,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aloy_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Schön, dich kennenzulernen.",
      "text": "Ich bin Aloy und obwohl ich noch nicht viel über diese Welt weiß, stehen meine Pfeile und mein Bogen immer zu deiner Verfügung. Wenn deine Truppe mich braucht, werde ich da sein und helfen."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Gespräch – Aufbruch",
      "text": "Hör auf dich auszuruhen. Los!"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Gespräch – Hilfe",
      "text": "Wir sollten jetzt nicht aufhören, es gibt immer noch Menschen, die unsere Hilfe brauchen."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Wenn es regnet ...",
      "text": "Regen, mit ihm kann man den Schmutz abwaschen."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Es hat aufgehört zu regnen ...",
      "text": "Der Regen hat aufgehört. Wir sollten uns trocknen."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Wenn es schneit ...",
      "text": "Wenn es schneit, scheint es, als würde die ganze Welt verstummen."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Wenn es windig ist ...",
      "text": "Der Wind hat wieder aufgefrischt und es tut gut, in ihm einzuatmen."
    },
    {
      "id": "1205",
      "type": 1,
      "title": "Ein Sturm zieht auf.",
      "text": "Der Wind hat zugenommen und bläst mir schmerzhaft ins Gesicht."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Guten Morgen.",
      "text": "Guten Morgen. Die Welt ist wieder voller Leben und ich bin es auch."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Guten Tag.",
      "text": "Der Tag ist schon zur Hälfte vorbei und wir haben noch eine Menge zu tun."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Guten Abend.",
      "text": "Die Sonne geht unter und in Kürze werden die Sterne zu sehen sein."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Gute Nacht.",
      "text": "Guten Abend. Zeit, sich auszuruhen, es sei denn, du willst dich weiter im Sternenlicht bewegen"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Über Aloy ...",
      "text": "Ich bin als Ausgestoßene aufgewachsen und es war eine schlimme Zeit. Aber hier sind die Menschen, selbst wenn sie auf eine Außenseiterin wie mich treffen, viel freundlicher als der Stamm, in den ich hineingeboren wurde. Es fühlt sich ... gut an."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Über uns – Handlung",
      "text": "Alles, was ich tue, dient dazu, Leben zu retten, und nicht, den Tod zu bringen. Deshalb kämpfe ich an deiner Seite."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Über uns – Schwur",
      "text": "Es ist ein bisschen zu sehr formell, Gelübde abzulegen. Aber wenn du mein Gelübde willst, dann gebe ich es dir."
    },
    {
      "id": "2004",
      "type": 1,
      "title": "Über uns – Nach vorn",
      "text": "Ich werde mein Bestes tun, um mit dir bis zum Ende voranzukommen. Ich werde nicht zögern und nicht versagen."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Willst du mir etwas mitteilen?",
      "text": "Wenn es etwas zu teilen gibt, dann sind es mein Bogen und meine Pfeile, die ich nur benutze, um anderen zu helfen."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Interessante Vorkommnisse ...",
      "text": "Wie meine eigene Welt ist auch die Vergangenheit dieser Welt voller Geheimnisse. Wenn ich genug Zeit habe, muss ich alle Geheimnisse lüften."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Ich will mehr über Aloy erfahren I",
      "text": "Ich bin nicht sehr gut darin, über meine eigenen Angelegenheiten zu reden, der aktuelle Auftrag ist am wichtigsten."
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Ich will mehr über Aloy erfahren II",
      "text": "Ich habe keine Eltern und wurde von einem Mann namens Rost aufgezogen. Er war ein wenig streng, hatte aber ein gutes Herz und war großzügig. Er hat mir viel beigebracht und nun ja ... ich vermisse ihn sehr."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Ich will mehr über Aloy erfahren III",
      "text": "In der Vergangenheit habe ich viel Zeit mit der Suche nach meiner leiblichen Mutter verbracht, konnte sie aber nicht finden. Stattdessen fand ich einige entfernte Nachrichten, die von meiner „Klonmutter“ hinterlassen wurden. Als ich diese Nachrichten hörte, hatte ich den Eindruck, dass sie mich gut kannte und mich ermutigen wollte."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Ich will mehr über Aloy erfahren IV",
      "text": "Als ich aufwuchs, hatte ich nicht wirklich Freunde. Obwohl ich später auf meiner Reise einige Menschen traf, waren wir noch nicht sonderlich vertraut miteinander, als ich die Welt verließ. Deshalb bin ich wirklich froh, dass ich so viel Zeit mit dir verbracht habe und wir Freunde geworden sind."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Ich will mehr über Aloy erfahren V",
      "text": "Ich vertraue den Menschen nicht so leicht, aber ich bin sicher, dass man dir vertrauen kann. Du bist mein treuer Begleiter und ich urteile nicht oft so über Menschen."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Aloys Hobbys ...",
      "text": "Ich bin mir nicht ganz sicher, welche Hobbys ich habe, aber das Lesen über die Vergangenheit gehört dazu. Also ... Geschichte?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Aloys sorgen ...",
      "text": "Neben meiner eigenen Welt gibt es jetzt noch eine andere Welt zu retten. Puh ... es gibt nie genug Zeit."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Was sie so mag ...",
      "text": "Ich bin kein wählerischer Esser. Ich esse alles, damit ich nicht hungrig reisen muss."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Was sie nicht mag ...",
      "text": "Ich hatte einmal einen „Oseram-Eintopf“, der so dick war, dass man ihn für Asphalt hätte halten können."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Dein Geburtstag ...",
      "text": "Ich habe mir nie viel aus Geburtstagen gemacht. In der Welt, in der ich geboren wurde, ehrten alle ihre Mütter, und niemand feierte seinen eigenen Geburtstag. Aber lassen wir das erst einmal beiseite. Also ... ich wünsche dir alles Gute zum Geburtstag!"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Beginn",
      "text": "Das ist gut, wir kommen gut voran. Doch dabei kann es nicht bleiben."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Fortschritt",
      "text": "Es ist gut, dass wir gewachsen und stärker geworden sind."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Höhepunkt",
      "text": "Ganz gleich, wie gut du als Jäger bist, du kannst immer besser werden. Lass dich nicht durch Selbstgefälligkeit vom Lernen abhalten."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Gedanken über den Aufstieg – Ende",
      "text": "#Als wir anfingen, gemeinsam zu reisen, warst du für mich ein{F#e} Fremde{M#r} aus einer Welt, die ich nicht kannte. Aber jetzt, da wir so viel zusammen erlebt haben, kann ich dir versichern, dass mein Bogen immer mit dir sein wird."
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Elementarfähigkeit I",
      "text": "Dieses Ding wird in die Luft gehen."
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Elementarfähigkeit II",
      "text": "Das ist ein Spielzeug für Jäger."
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Elementarfähigkeit III",
      "text": "Hast du das gesehen?"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Spezialfähigkeit I",
      "text": "Du kommst nicht weiter!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Spezialfähigkeit II",
      "text": "Ein kleiner neuer Trick."
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Spezialfähigkeit III",
      "text": "Das ist mein Jagdgebiet!"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "Windgleiter öffnen I",
      "text": "Mit diesem Spielzeug kann man richtig Spaß haben."
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Truhe öffnen I",
      "text": "Diese Dinger scheinen sehr nützlich zu sein."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Truhe öffnen II",
      "text": "Mal sehen, das sieht essbar aus ... und das sieht nützlich aus ..."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Truhe öffnen III",
      "text": "Wer hat all diese Dinge hier gesteckt?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "Niedrige LP I",
      "text": "Eine schwierige Beute ..."
    },
    {
      "id": "410002",
      "type": 2,
