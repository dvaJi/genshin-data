  "outfits": [
    {
      "id": 203500,
      "name": "Summerchill Dreams",
      "description": "Model pakaian Qiqi. Pakaian anak-anak yang menyerupai pakaian tukang obat herbal ini ditutupi dengan jimat dan terasa nyaman bagi Qiqi.",
      "isDefault": true,
      "characterName": "Qiqi",
      "characterId": 10000035,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Qiqi_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Halo",
      "text": "Aku Qiqi, aku zombie, dan aku ... lupa mau ngomong apa lagi."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Berbincang: Bicara pada Diri Sendiri",
      "text": "Hei, kamu tahu apa? Uhh ... aku juga tidak tahu. Aku ... kelupaan."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Berbincang: Takut Panas",
      "text": "Ayo pergi ke tempat yang lebih sejuk."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Berbincang: Latihan",
      "text": "Satu, dua, tiga, empat. Dua, dua, tiga, empat ...."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Ketika Turun Hujan",
      "text": "Lagi-lagi aku lupa membawa payungku."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Ketika Turun Salju",
      "text": "Aku ingin membuat manusia salju. Apa kamu mau membantuku?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Ketika Matahari Bersinar",
      "text": "Aku seharusnya diam di rumah hari ini."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Ketika Angin Bertiup",
      "text": "Sejuk sekali anginnya, aku suka."
    },
    {
      "id": "1205",
      "type": 1,
      "title": "Angin Kencang",
      "text": "Tolong pegang tanganku! Angin ini bisa meniupku terbang!"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Selamat Pagi",
      "text": "Pagi artinya sekarang waktunya memeriksa buku harianku. Karena buku harianku mengingatkanku apa saja yang harus kulakukan saat pagi hari."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Selamat Siang",
      "text": "Aku baru ingat sesuatu. Aku lupa menolong Dokter Baizhu menyiapkan obat-obatan."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Selamat Malam",
      "text": "Selamat malam. Bagaimana kabarmu hari ini? Hariku ... baik-baik saja sih, seharusnya. Cuma aku tidak ingat."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Selamat Tidur",
      "text": "Sudah waktunya kamu tidur sekarang. Aku mau melakukan peregangan badan dulu. Jangan ngintip ya~"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Tentang Qiqi Sendiri",
      "text": "Kamu tanya aku sesuatu? Maaf ... Aku lupa."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Tentang Kita: Ingatan",
      "text": "Aku punya daya ingat yang lemah untuk mengingat banyaknya hal. Tapi setahuku, itu tidak jadi masalah."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Tentang Kita: Latihan Mengingat",
      "text": "Belakangan ini aku mulai berlatih mengingat. Jadi jangan cemas, aku tidak akan lupa kamu siapa."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Tentang Vision",
      "text": "Vision-ku tidak bisa memutar ulang waktu. Tapi minimal ia bisa memberiku kekuatan untuk melindungi orang-orang yang sangat kusayang."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Berbagi Cerita",
      "text": "Aku memang mayat, tapi kondisi fisikku jauh lebih baik daripada Dokter Baizhu."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Kisah Menarik",
      "text": "Kadang-kadang aku lihat ada burung ketilang di dekat apotek. Sekelompok kecil burung ketilang yang menyenangkan."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Tentang Baizhu",
      "text": "Aku tidak pernah bisa ingat wajah Dokter Baizhu. Tapi tidak apa-apa."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Tentang Hu Tao",
      "text": "Hangat. Senyum palsu. Kematian. Aku benci Hu Tao."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Tentang Xiao: Nama",
      "text": "Menurutku kedengarannya seperti artefak bersejarah ...."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Tentang Xiao: Ingatan",
      "text": "Ingatkan aku, apa dulu aku pernah bertemunya?"
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Tentang Xinyan",
      "text": "Eh ... Siapa?"
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Tentang Yaoyao",
      "text": "Lucu. Seperti burung ketilang kecil yang lucu."
    },
    {
      "id": "4007",
      "type": 1,
      "title": "Tentang Dusky Ming",
      "text": "Pada beberapa kali malam hari, aku merasa seperti ada orang yang melakukan senam peregangan bersamaku. Tapi mungkin itu imajinasiku saja yang berlebihan."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Tentang Prune",
      "text": "Dari luar dia kelihatan kuat ... tapi telapak tangannya lembut sekali. Aku suka dia."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Mengenal Qiqi: I",
      "text": "Sedang ada apa nih?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Mengenal Qiqi: II",
      "text": "Aku rutin melakukan senam peregangan untuk membantuku mempertahankan rentang gerakan yang sama layaknya orang normal. Tapi begitu aku berhenti melakukannya, \"kaku mayat\"-ku mulai muncul lagi."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Mengenal Qiqi: III",
      "text": "Sebagian orang berniat memanfaatkanku, sebagian lagi ada yang ketakutan. Tapi kamu ... berbeda dengan kedua golongan orang itu."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Mengenal Qiqi: IV",
      "text": "Sejak pertama kali kita bertemu, aku merasakan perasaan hangat di dalam. Bukan semacam kehangatan yang membuatku merasa busuk, tapi kehangatan yang sebaliknya. Kehangatan yang tercipta di dalam hatiku. Terima kasih. Aku senang. Cuma sayang, aku hanya bisa kenal dengan kamu yang sekarang. Kalau aku nanti lupa ... Tidak. Aku akan memerintahkan diriku untuk mengingatmu."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Mengenal Qiqi: V",
      "text": "Dulu, satu-satunya pikiranku hanyalah: Aku harus tetap hidup. Meskipun aku juga tidak tahu hidup itu untuk apa. Tapi sekarang, sepertinya aku sudah tahu. Aku ingin tinggal bersamamu. Aku ingin tanya, apa kita bisa terus bersama, seumur hidup, sampai mati? Ya atau tidak? Ya? Apa itu jawabanmu yang sesungguhnya? Bagus, bagus sekali. Aku janji aku akan selalu melindungimu."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Hobi Qiqi",
      "text": "Aku ingin punya hewan peliharaan. Misalnya, burung ketilang kecil yang lucu."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Kekhawatiran Qiqi",
      "text": "Aku tidak tahu kenapa suhu tinggi membuatku merasa ... jijik."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Makanan Favorit",
      "text": "Aku suka susu santan, tapi ... aku tidak tahu apa rasanya."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Makanan yang Tidak Disukai",
      "text": "Maaf, aku tidak tahu ...."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Menerima Hadiah: I",
      "text": "Dingin. Aku suka. Tapi tawar."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Menerima Hadiah: II",
      "text": "Huh ...."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Menerima Hadiah: III",
      "text": "Aduh, ini membakar lidahku ...."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "Ulang Tahun",
      "text": "Semoga berbahagia. Ini sekantong obat untukmu. Kamu pasti sangat kaget kalau aku bisa ingat ya? Sini aku jelaskan. Dulu waktu kamu kasih tahu aku, aku langsung menulis tanggal ulang tahunmu di secarik kertas. Kalau aku melihat sesuatu tapi dilakukan setiap hari, itu akhirnya bisa terekam juga ke ingatan jangka panjangku, dan itu akan tetap ada di sana selamanya."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Perasaan Tentang Ascension: Permulaan",
      "text": "Sekarang aku sudah jadi lebih kuat. Tapi ... maksudnya apa? Tolong jelaskan. Teirma kasih."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Perasaan Tentang Ascension: Persiapan",
      "text": "Ah, aku paham. Kalau sudah jadi lebih kuat, itu artinya aku harus berusaha lebih keras untuk mengendalikan kekuatanku."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Perasaan Tentang Ascension: Klimaks",
      "text": "Dulu, aku tidak paham pemikiran harus menjadi lebih kuat dari diriku yang sebelumnya. Sekarang setelah aku benar-benar paham, aku malah masih terus berharap untuk bisa jadi lebih kuat lagi."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Perasaan Tentang Ascension: Konklusi",
      "text": "Semua ini berkat bantuanmu. Terima kasih banyak ... Apa kamu rela berjanji? Mulai dari sekarang, biarkan aku melindungimu. Apa kamu menerimanya? Ya atau tidak?"
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Elemental Skill: I",
      "text": "Roda kehidupan."
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Elemental Skill: II",
      "text": "Kehidupan terus berjalan."
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Elemental Skill: III",
      "text": "Pergi."
    },
    {
      "id": "100004",
      "type": 2,
      "title": "Elemental Skill: IV",
      "text": "Bangkit."
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Elemental Burst: I",
      "text": "Perintah diberikan. Perintah diterima."
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Elemental Burst: II",
      "text": "Nama suci: Fortune-Preserver."
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Elemental Burst: III",
      "text": "Segel Adeptus, terbukalah."
    },
    {
      "id": "700001",
      "type": 2,
      "title": "Mulai Lari: I",
      "text": "Lebih cepat? Oke, lebih cepat."
    },
    {
      "id": "800001",
      "type": 2,
      "title": "Membuka Wind Glider: I",
      "text": "Uh ... Huh ...."
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Membuka Peti Harta: I",
      "text": "Uuh, cantik."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Membuka Peti Harta: II",
      "text": "Peti harta ... apa kita suka ... peti harta?"
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Membuka Peti Harta: III",
      "text": "Bukannya ada sesuatu di sini barusan?"
