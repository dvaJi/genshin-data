  "outfits": [
    {
      "id": 201601,
      "name": "เพลิงมหันต์รัตติกาล",
      "description": "หนึ่งในชุดที่ Diluc สวมใส่เมื่อออกปฏิบัติการลับ ราวกับเปลวไฟที่ลุกโชนท่ามกลางเงามืด ร่องรอยสีแดงเข้มที่สุดปลายทัศนวิสัยของศัตรู คือฝันร้ายที่จะคงอยู่กับพวกเขาไปตลอดชีวิต",
      "isDefault": false,
      "characterName": "Diluc",
      "characterId": 10000016,
      "source": [],
      "filename_card": "UI_AvatarIcon_DilucCostumeFlamme_Card",
      "filename_icon": "UI_AvatarIcon_DilucCostumeFlamme",
      "filename_iconCircle": "UI_AvatarIcon_DilucCostumeFlamme_Circle",
      "filename_splash": "UI_Costume_DilucCostumeFlamme",
      "filename_sideIcon": "UI_AvatarIcon_Side_DilucCostumeFlamme"
    },
    {
      "id": 201600,
      "name": "เปลวไฟในราตรีกาล",
      "description": "คอสตูมของ Diluc ชุดของชนชั้นสูงที่ดูเรียบง่ายแต่มีรสนิยม",
      "isDefault": true,
      "characterName": "Diluc",
      "characterId": 10000016,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Diluc_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "พบกันครั้งแรก...",
      "text": "Diluc แห่ง Mondstadt มาตามคำสัญญา ขอไม่ร่วมพูดคุยเรื่องไร้สาระ แต่ถ้าอยากจะทำเรื่องที่ยิ่งใหญ่ ฉันก็พอจะสนใจอยู่บ้าง"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "แชท - ผ่อนคลาย",
      "text": "พักบ้างก็ไม่เลวนะ"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "แชท - กองอัศวิน",
      "text": "ครั้งหน้าน่าจะให้พวกอัศวินแห่ง Favonius มากับเธอแทนนะ"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "แชท - กิลด์",
      "text": "ในกิลด์ยังมีเรื่องที่ต้องทำ อีกเยอะเลย เธอพักอยู่ที่นี่ก่อนแล้วกัน ฉันจะกลับไปดูสักหน่อย"
    },
    {
      "id": "1106",
      "type": 1,
      "title": "แชท - เตรียมพร้อม",
      "text": "เตรียมตัวล่วงหน้า และชิงลงมือก่อนอีกฝ่าย"
    },
    {
      "id": "1107",
      "type": 1,
      "title": "แชท - แผนการ",
      "text": "เวลาพัก ก็เอาเวลามาวางแผนในขั้นต่อไปได้นะ"
    },
    {
      "id": "1108",
      "type": 1,
      "title": "แชท - เตือน",
      "text": "ทุกย่างก้าวล้วนมีความเสี่ยงเสมอ เธอต้องระวังตัวให้ดีนะ"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "ในเวลาที่ฝนตก - ร่ม",
      "text": "ฉันไม่เอาร่ม เธอจะใช้ก็ใช้เถอะ"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "ในเวลาที่ฝนตก - ชะล้าง",
      "text": "ฝนเหรอ... น่าเสียดายที่มันชะล้างจิตใจที่สกปรกเหล่านั้นไม่ได้"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "แดดส่องดีจัง...",
      "text": "ขอเพียงแค่ยึดมั่นในแนวทางของ ตัวเอง อากาศจะเป็นยังไงก็ช่างมัน"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "ในเวลาที่ลมพัดแรง...",
      "text": "เสียงพัดหวิวของสายลม จะถูกนำมาใช้เพื่อปกปิดร่องรอยของความชั่วร้าย"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "อรุณสวัสดิ์...",
      "text": "เลิกพูดเรื่องยิบย่อยเถอะ เมื่อคืนนี้ทุกอย่างเรียบร้อยดีก็โอเคแล้ว"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "สวัสดีตอนเที่ยง...",
      "text": "อยากจะลองเมนูลับหน่อยมั้ยล่ะ?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "สวัสดีตอนเย็น...",
      "text": "ฟ้ามืดแล้ว"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "ราตรีสวัสดิ์...",
      "text": "อืม ไว้เจอกัน ฉันจะยืนส่งจากตรงนี้แล้วกัน เดินทางปลอดภัยนะ"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "เกี่ยวกับตัวของ Diluc เอง",
      "text": "ตำนานของ \"Darknight Hero\" งั้นเหรอ? ก็เป็นเรื่องเล่าที่น่าสนใจดีนะ"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "เกี่ยวกับเรา - ความต้องการ",
      "text": "มีอะไรก็ว่ามา ถ้าจะเบิกค่าใช้จ่ายก็ไปติดต่อ Elzer"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "เกี่ยวกับเรา - การพิสูจน์",
      "text": "เธอได้พิสูจน์ความมุ่งมั่นของตัวเองแล้ว งั้นฉันก็ให้เธอได้เห็นความตั้งใจของฉันบ้าง"
    },
    {
      "id": "3001",
      "type": 1,
      "title": "เกี่ยวกับ \"วิชั่น\"...",
      "text": "สำหรับผู้ที่ไม่สามารถมองเห็นเส้น ทางข้างหน้าได้อย่างชัดเจน บางที \"วิชั่น\" อาจจะเป็นแสงสว่างจากเทพเจ้า แต่สำหรับคนที่มีความเชื่อมั่น มันก็เป็นเพียงเหรียญประดับที่จะมีหรือไม่มีก็ได้"
    },
    {
      "id": "3002",
      "type": 1,
