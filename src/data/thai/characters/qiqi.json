    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "พบกันครั้งแรก...",
      "text": "ฉันชื่อ Qiqi ฉันเป็นซอมบี้... อา ต้องพูดว่าอะไรต่อนะ"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "แชท - พูดคนเดียว",
      "text": "เอ่อ เมื่อกี้... ฉันจะพูดอะไรนะ..."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "แชท - กลัวความร้อน",
      "text": "อยากไปสถานที่เย็น ๆ"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "แชท - ออกกำลังกาย",
      "text": "หนึ่งสองสามสี่ สองสองสามสี่... สามสองสามสี่..."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "ในเวลาที่ฝนตก...",
      "text": "ลืมพกร่มมาอีกแล้ว"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "ในเวลาที่หิมะตก...",
      "text": "ฉันอยากปั้นตุ๊กตาหิมะ... มาปั้นเป็นเพื่อนฉันหน่อยได้มั้ย?"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "แดดส่องดีจัง...",
      "text": "วันนี้ไม่น่าออกมาเลย"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "ในเวลาที่ลมพัด...",
      "text": "เย็น ๆ แบบนี้ สบายดีจัง"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "ในเวลาที่ลมพัดแรง...",
      "text": "จับมือ... จับมือฉันหน่อย! จะ จะโดนลมพัดปลิวแล้ว!..."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "อรุณสวัสดิ์...",
      "text": "เช้าแล้วเหรอ? เรื่องที่ต้องทำวันนี้คือ... ฉันขอดูบันทึกก่อน"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "สวัสดีตอนเที่ยง...",
