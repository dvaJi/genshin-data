  "outfits": [
    {
      "id": 203500,
      "name": "ซอมบี้น้อยแดนน้ำแข็ง",
      "description": "คอสตูมของ Qiqi ชุดนักเก็บสมุนไพรที่เต็มไปด้วยยันต์และเครื่องรางของขลังต่าง ๆ ซึ่ง Qiqi รู้สึกอุ่นใจเมื่อได้สวมใส่",
      "isDefault": true,
      "characterName": "Qiqi",
