  "outfits": [
    {
      "id": 206200,
      "name": "ชุดที่คล่องแคล่วของนักล่า",
      "description": "คอสตูมของ Aloy เป็นชุดนักล่าที่เหมาะกับการใช้ชีวิตในป่า",
      "isDefault": true,
      "characterName": "Aloy",
      "characterId": 10000062,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aloy_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "พบกันครั้งแรก...",
      "text": "#ฉันคือ Aloy ถึงฉันจะไม่ค่อยรู้อะไรเกี่ยวกับโลกนี้มากนัก แต่ธนูและคันธนูของฉันก็พร้อมจะช่วย{F#เธอ}{M#นาย}เสมอ ถ้าทีมของ{F#เธอ}{M#นาย}ต้องการฉัน ฉันก็จะช่วยอย่างเต็มที่"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "แชท - ขยับตัว",
      "text": "อย่ามัวแต่ยืนเฉื่อยสิ ขยับตัวได้แล้ว"
    },
    {
      "id": "1102",
      "type": 1,
      "title": "แชท - ช่วยเหลือ",
      "text": "รีบไปกันเถอะ ยังมีคนที่ต้องการความช่วยเหลือจากเราอยู่"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "ในเวลาที่ฝนตก...",
      "text": "ฝน สามารถชะล้างคราบสกปรกได้"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "ฟ้าหลังฝน...",
      "text": "ฝนหยุดตกแล้ว ถึงเวลาผึ่งให้แห้งแล้วล่ะ"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "ในเวลาที่หิมะตก...",
      "text": "เวลาหิมะตก ดูเหมือนทั้งโลกจะเงียบลง"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "ในเวลาที่ลมพัด...",
      "text": "ลมพัดอีกแล้ว สูดหายใจลึก ๆ ในสายลมมันรู้สึกดีจริง ๆ"
    },
    {
      "id": "1205",
      "type": 1,
      "title": "ในเวลาที่ลมพัดแรง...",
      "text": "ลมพัดแรงชะมัด ทำเอาหน้าฉันแสบไปหมดแล้ว"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "อรุณสวัสดิ์...",
      "text": "อรุณสวัสดิ์ โลกนี้กลับมามีชีวิตชีวาอีกครั้ง ฉันเองก็เช่นกัน"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "สวัสดีตอนเที่ยง...",
      "text": "ผ่านไปครึ่งวันแล้ว เรายังมีเรื่องต้องทำอีกเยอะเลย"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "สวัสดีตอนเย็น...",
      "text": "ตะวันตกดินแล้ว อีกไม่นานดวงดาวก็จะออกมาเต็มฟ้า"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "ราตรีสวัสดิ์...",
      "text": "#สวัสดีตอนเย็น ถึงเวลาพักผ่อนแล้วล่ะ นอกจากว่า{F#เธอ}{M#นาย}อยากเดินทางต่อใต้แสงดาว"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "เกี่ยวกับตัว Aloy...",
      "text": "ฉันต้องกลายเป็นผู้ถูกเนรเทศตั้งแต่ยังเด็ก ช่วงเวลานั้นเป็นช่วงที่ยากลำบากมาก แต่ที่นี่ ถึงฉันจะเป็นคนนอก แต่ทุกคนก็เป็นมิตรกับฉันมากกว่าชนเผ่าที่ฉันเกิดมาซะอีก ความรู้สึกนี้... เยี่ยมไปเลย"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "เกี่ยวกับเรา - การกระทำ",
      "text": "#การกระทำทุกอย่างของฉันก็เพื่อช่วยชีวิต ไม่ใช่เพื่อนำมาซึ่งความตาย นี่คือเหตุผลที่ฉันสู้เคียงบ่าเคียงไหล่กับ{F#เธอ}{M#นาย}"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "เกี่ยวกับเรา - คำมั่นสัญญา",
      "text": "#การกล่าวคำมั่นสัญญาอะไรนั่นดูจะเป็นทางการไปหน่อย แต่ถ้า{F#เธอ}{M#นาย}ต้องการคำมั่นสัญญาจากฉัน งั้นฉันก็รับปากว่าจะอยู่ข้าง{F#เธอ}{M#นาย}"
    },
    {
      "id": "2004",
      "type": 1,
      "title": "เกี่ยวกับเรา - วันข้างหน้า",
      "text": "#ฉันจะพยายามอย่างเต็มที่เพื่อก้าวไปข้างหน้าพร้อมกับ{F#เธอ}{M#นาย}จนถึงที่สุด ฉันจะไม่ลังเลและไม่มีทางทรยศต่อความสัมพันธ์นี้แน่"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "ต้องการจะแชร์อะไร...",
      "text": "ถ้าจะให้แชร์อะไรละก็ แน่นอนว่าต้องเป็นลูกธนูและคันศรของฉันน่ะ แต่ฉันก็ใช้มันเพื่อช่วยเหลือผู้อื่นเท่านั้นแหละนะ"
    },
    {
      "id": "3003",
