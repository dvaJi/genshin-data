  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "พบกันครั้งแรก...",
      "text": "กลิ่นของเธอ... หอมจัง... ไปออกล่ากันเถอะ!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "แชท - กลิ่น",
      "text": "อืม... กลิ่นของกระต่าย..."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "แชท - หิว",
      "text": "ไปเถอะ หิวแล้ว"
    },
    {
      "id": "1103",
      "type": 1,
      "title": "แชท - เฝ้าดู",
      "text": "ฉันไป Stormbearer... จะไปแล้วบอกฉัน"
    },
    {
      "id": "1201",
      "type": 1,
      "title": "ในเวลาที่ฟ้าผ่า - เตือน",
      "text": "กลัวก็รีบซ่อน"
    },
    {
      "id": "1204",
      "type": 1,
      "title": "ในเวลาที่ฟ้าผ่า - นำทาง",
      "text": "ระวังต้นไม้ ตามฉันมา!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "ในเวลาที่ลมพัด...",
      "text": "ลม... อา... สบายจัง"
    },
    {
      "id": "1203",
      "type": 1,
      "title": "ในเวลาที่ลมพัดแรง...",
      "text": "ลม... อืม... เจ็บนิดหน่อย"
    },
    {
      "id": "1001",
      "type": 1,
      "title": "อรุณสวัสดิ์...",
      "text": "พระอาทิตย์ขึ้นแล้ว... ไปล่ามั้ย?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "สวัสดีตอนเที่ยง...",
      "text": "กินเนื้อก้อนโต... มีความสุขจัง!"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "สวัสดีตอนเย็น...",
      "text": "ไปนอนเถอะ... ฉันดูพระจันทร์"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "ราตรีสวัสดิ์...",
      "text": "เธอนอน ฉันจะเฝ้า พรุ่งนี้ล่ากัน"
    },
    {
      "id": "2001",
      "type": 1,
      "title": "เกี่ยวกับตัวของ Razor เอง",
      "text": "ฉันคือหมาป่า พ่อแม่ที่เป็นมนุษย์น่ะ ไม่มีหรอก"
    },
    {
      "id": "2002",
      "type": 1,
      "title": "เกี่ยวกับเรา - เพื่อน",
      "text": "เธอคือเพื่อน ฉันกับเธอไปล่ากัน"
    },
    {
      "id": "2003",
      "type": 1,
      "title": "เกี่ยวกับเรา - อาวุธ",
      "text": "ฉันมีกรงเล็บเหล็กและเขี้ยวสายฟ้า ฉันปกป้องเธอ"
    },
    {
      "id": "3001",
      "type": 1,
