  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Lần đầu gặp mặt...",
      "text": "Mùi của bạn... cũng thơm. Cùng đi săn nào!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Nói chuyện phiếm - Mùi vị",
      "text": "Hừm, mùi của lũ thỏ..."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Nói chuyện phiếm - Đói",
      "text": "Đi thôi, bụng đói rồi."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Nói chuyện phiếm - Trông chừng",
      "text": "Tôi đang canh chừng, đi thì gọi tôi."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Khi có sấm sét - Nhắc nhở",
      "text": "Sợ thì mau trốn đi."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Khi có sấm sét - Dẫn đường",
      "text": "Tránh cây, đi theo tôi!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Khi gió nổi lên...",
      "text": "Gió... ừm... dễ chịu."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Gió lớn quá...",
      "text": "Gió... ừm... quật, đau."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Chào buổi sáng...",
      "text": "Mặt trời lên rồi. Đi săn cùng nhau?"
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Chào buổi trưa...",
      "text": "Ăn miếng thịt lớn, hạnh phúc!"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Chào buổi tối...",
      "text": "Bạn ngủ đi, tôi ngắm trăng."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Chúc ngủ ngon...",
      "text": "Bạn ngủ, tôi canh gác. Ngày mai cùng nhau đi săn."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Về bản thân Razor...",
      "text": "Tôi là sói. Cha, mẹ con người, không có."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "Về chúng ta - Bạn bè",
      "text": "Bạn là bạn tôi. Tôi và bạn cùng đi săn."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "Về chúng ta - Vũ khí",
      "text": "Tôi có móng sắt và nanh sét. Tôi bảo vệ bạn."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Về Vision...",
      "text": "Vision, sư phụ giúp. Nanh sét đánh đấm, bảo vệ Lupical."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Có gì muốn chia sẻ không...",
      "text": "Buổi tối, trời sao rất đẹp. Bầu trời, trong hồ, đều có rất nhiều sao.\\nBuổi tối, trong thành, cũng có rất nhiều sao."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Những kiến thức thú vị...",
      "text": "Bầy sói là Lupical của tôi. Họ là người thân."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "Về Lisa...",
      "text": "Sét của sư phụ, bầu trời biến thành màu đen. Rất đáng sợ, rất mạnh."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "Về Barbara...",
      "text": "Barbara, cô gái toả sáng. Rất tốt bụng."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "Về Diluc...",
      "text": "Diluc, đỏ đỏ, đen đen. Vừa lạnh vừa nóng."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "Về Venti...",
      "text": "Thơ... ừm, không hiểu. Mặc dù không hiểu, Lupical thích."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "Về Bennett...",
      "text": "Bennett, rất nhiều lời. Đi cùng cậu ấy, ăn không no."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "Về Klee...",
      "text": "Klee, bạn! Bạn bè, nhưng, đau đầu."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "Về Varka - Lạ mặt",
      "text": "Varka? Không quen..."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "Về Varka - Hồi ức",
      "text": "Hả... Varka, là tên. Người đó, cao lớn. Tên Razor, móng sắt, người đó đặt. Ừm... muốn gặp người đó."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Muốn tìm hiểu Razor - Điều thứ 1",
      "text": "Mùi của bạn, mùi lương thiện. Thích ăn thịt?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Muốn tìm hiểu Razor - Điều thứ 2",
      "text": "Bạn rất mạnh. Giống như sói. Thích đi săn với bạn. Thu hoạch rất nhiều."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Muốn tìm hiểu Razor - Điều thứ 3",
      "text": "Lupical là \"nhà của sói\". Không đúng, là \"người nhà của sói\". Lupical của tôi ở trong rừng. Họ bảo vệ tôi, gọi tôi là Lupical."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Muốn tìm hiểu Razor - Điều thứ 4",
      "text": "Tôi chỉ có Lupical.\\nNhưng, cho dù là Lupical, tôi không có bốn chân, không phải sói thực sự. Đôi lúc cảm thấy buồn."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Muốn tìm hiểu Razor - Điều thứ 5",
