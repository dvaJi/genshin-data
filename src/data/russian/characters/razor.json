  "outfits": [
    {
      "id": 202000,
      "name": "Дикий бег",
      "description": "Наряд Рэйзора. Простая одежда, в которой удобно мчаться по просторам.",
      "isDefault": true,
      "characterName": "Рэйзор",
      "characterId": 10000020,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Razor_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Привет...",
      "text": "Ты вкусно пахнешь... Давай охотиться вместе!"
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Поболтаем: Запах",
      "text": "Ммм, кролик..."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Поболтаем: Голод",
      "text": "Голоден. Давай охотиться."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Поболтаем: Буревестник",
      "text": "Я охранять. Уйдёшь - позови меня."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Когда гремит гром: Напоминание",
      "text": "Боишься грома - прячься."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Когда гремит гром: Провожать",
      "text": "Обходи деревья, иди за мной!"
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Когда дует ветер...",
      "text": "Ветер... Да... Нравится."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Когда дует сильный ветер...",
      "text": "Ветер сильный... Кусает больно."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Доброе утро...",
      "text": "Солнце высоко. Пора охотиться."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Добрый день...",
      "text": "Я наелся. Большие куски мяса. Мне хорошо!"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Добрый вечер...",
      "text": "Посмотрю на луну... Спи!"
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Спокойной ночи...",
      "text": "Ты спи, я сторожить."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "О Рэйзоре...",
      "text": "Я волк. Люди, семья - нет."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "О нас: Друзья",
      "text": "Ты мой друг. Мы охотимся. Вместе."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "О нас: Оружие",
      "text": "У меня железные когти и громовые клыки. Я буду защищать тебя."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Глаз Бога...",
      "text": "Учитель и Глаз Бога помогают. Громовой клык защищает Лупикал."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Давай поделимся...",
      "text": "Я люблю звёзды. Много звёзд. В небе, в воде. И в городе."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Интересные вещи...",
      "text": "Волчья стая - это моя Лупикал... Моя семья."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "О Лизе...",
      "text": "Учитель бьёт молнией, небо темнеет. Она сильная. Я боюсь."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "О Барбаре...",
      "text": "Барбара, яркая девушка. Очень добрая."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "О Дилюке...",
      "text": "Дилюк красный и чёрный. Холодный и горячий."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "О Венти...",
      "text": "Стихи? Не понимаю. Не понимаю, но Лупикал любит."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "О Беннете...",
      "text": "Беннет, говорит много. Кушаем вместе, всегда мало."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "О Кли...",
      "text": "Кли - друг! Друг, но... шумная."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "О Варке: Незнакомец",
      "text": "Варка? Не знаю..."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "О Варке: Воспоминания",
      "text": "Ох... Варка - это имя. Тот мужчина, большой. Моё имя, Рэйзор, стальные когти, он дал. Хочу увидеться."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Узнать больше о Рэйзоре I",
      "text": "Твой запах, добрый. Любишь мясо?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Узнать больше о Рэйзоре II",
      "text": "#Ты сильн{F#ая}{M#ый}. Как волк. Хочу охотиться с тобой. Мы много поймаем."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Узнать больше о Рэйзоре III",
      "text": "«Лупикал» - это волчий дом. Нет, это волчья семья. Моя Лупикал живёт в лесу. Они говорят, я их Лупикал."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Узнать больше о Рэйзоре IV",
      "text": "У меня есть только Лупикал. Но у меня не четыре ноги, не как у них. Потому что я не настоящий волк. Иногда мне грустно."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Узнать больше о Рэйзоре V",
      "text": "Когда я бегаю с тобой, когда я охочусь с тобой, мне хорошо. С тобой я не волк и не человек, я просто я, Рэйзор. Потому что ты мой друг. Ты моя Лупикал. Надеюсь, тебе тоже хорошо."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Хобби Рэйзора...",
      "text": "Я люблю Лупикал. Я люблю лес. Я люблю друзей. Я люблю бегать!"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Беспокойство Рэйзора...",
      "text": "Много разговоров, я устаю. Разговаривать тяжело. Но я буду пытаться."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Любимая еда...",
      "text": "Мне нравится мясо и картошка."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Нелюбимая еда...",
      "text": "Трава невкусная. Животные едят траву. Я ем животных."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Подарок I",
      "text": "Запах хороший. Вкус хороший. Мне нравится."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Подарок II",
      "text": "Еда даёт энергию. Приносит счастье."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Подарок III",
      "text": "Есть - плохо. Не есть - плохо. Грустно."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "День рождения...",
      "text": "#Сегодня твой день. Ты родил{F#ась}{M#ся} сегодня, много лун прошло. Я хочу сделать тебе хорошо. Пошли вместе есть мясо?"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Чувство возвышения: Начало",
      "text": "Руки... больше?"
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Чувство возвышения: Нарастание",
      "text": "Ррр! Острые когти. Острые клыки. Ещё сильнее!"
    },
    {
      "id": "8003",
      "type": 1,
