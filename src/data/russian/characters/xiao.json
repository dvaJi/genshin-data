  "outfits": [
    {
      "id": 202600,
      "name": "Тысячелетняя схватка",
      "description": "Наряд Сяо. Классическое боевое облачение для уничтожения демонов на протяжении тысяч лет.",
      "isDefault": true,
      "characterName": "Сяо",
      "characterId": 10000026,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Xiao_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Привет...",
      "text": "#Если ты {M#проснулся}{F#проснулась} с ножом у горла, если монстры вцепились в тебя, если смерть стоит у порога... Скажи моё имя. Адепт Сяо. Я приду на зов."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Поболтаем: Праздность",
      "text": "Я опустился до безделья. Смехотворно."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Поболтаем: Свобода духа",
      "text": "Духи пустошей умрут скорее, чем навредят мне."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Поболтаем: Осквернение",
      "text": "Аргх... Эти воспоминания... мрачны..."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Когда идёт дождь...",
      "text": "Демоны не отдыхают в дождь. Пойдём."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "После дождя...",
      "text": "Прояснело? Хм. Погода неважна."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Когда гремит гром...",
      "text": "Многие смертные боятся молний... Непостижимо. Бояться чего-то столь обычного."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Когда идёт снег...",
      "text": "Когда снег станет потолще, его можно будет есть..."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Доброе утро...",
      "text": "Мы теряем время. Пора в путь."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Добрый день...",
      "text": "Обед... Давай вернёмся на постоялый двор «Ваншу»."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Добрый вечер...",
      "text": "Ночь... Силы зла властвуют безраздельно. Не выходи на улицу."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Спокойной ночи...",
      "text": "Иди. Я тут буду."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "О Сяо: Нелюдим",
      "text": "Я вовсе не человек. Не очень понимаю людские чувства."
    },
    {
      "id": "2006",
      "type": 1,
      "title": "О Сяо: Ли Юэ",
      "text": "Ли Юэ быстро меняется... Неважно. Я не собираюсь приноравливаться."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "О нас: Предостережения",
      "text": "Если наступит день, когда и ты впадёшь во тьму, то придётся мне..."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "О нас: Доверие",
      "text": "Остерегайся тьмы. От меня пощады не будет.\\nХотя ты... Ты, пожалуй, сможешь устоять."
    },
    {
      "id": "2004",
      "type": 1,
      "title": "О нас: Сонливость",
      "text": "Кто это?! А... Думаешь, я стоя сплю? Никакого уважения к Адептам."
    },
    {
      "id": "2005",
      "type": 1,
      "title": "О нас: Праздник морских фонарей",
      "text": "Праздник морских фонарей? Опять пришла пора, когда смертные засыпают море Ли Юэ своим светящимся мусором. Какое ребячество...\\nНо если хочешь, я пойду с тобой."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Глаз Бога: Желания",
      "text": "Глаз Бога? Желание? Ха. Не суди Адептов по смертным. У меня нет желаний."
    },
    {
      "id": "3004",
      "type": 1,
      "title": "Глаз Бога: Причины",
      "text": "Нет здесь никакого секрета. Я просто не говорю никому о своих желаниях.\\nСмертные ведь говорят, что если рассказать о желании, то оно не сбудется... А? Не то же самое?"
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Давай поделимся...",
      "text": "Убийство - моя специальность. Если не можешь закончить дело - позови меня."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Интересные вещи...",
      "text": "Когда-то на месте Тростниковых островов была пустошь.\\nНо это было много лет... нет, веков назад."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "О Чжун Ли...",
      "text": "Хочу спросить... Скажи, Чжун Ли целыми днями просто... Кормит птиц? Любуется цветами? Рассматривает старинные вещи?\\nЭто всё... зачем?"
    },
    {
      "id": "4003",
      "type": 1,
      "title": "О Бэй Доу...",
      "text": "Бэй Доу? У меня с ней нет никаких отношений. Но морские чудовища - существуют. И она сильна для обычного человека, если смогла одолеть Хай Шаня."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "О Бай Чжу...",
      "text": "Думаешь... Бай Чжу сможет сделать лекарство от моей боли? Я ценю твоё намерение, но лекарства смертных не действуют на Адептов."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "О Ху Тао...",
      "text": "Ху Тао? Живая девушка, аж голова болит от неё. Но зато она забавная - точно не вырастет скучным человеком."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "О Венти...",
      "text": "Венти? Вот как его теперь зовут. Его музыка... Неважно."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "О Гань Юй...",
      "text": "Гань Юй не Божественный зверь, но и не человек. Нельзя не прийти в замешательство, идя лишь за долгом между мирами Адептов и смертных... Что? Я? Яксу, что умеет лишь убивать и выживать, на роль её наставника? Твой разум явно находится не в том мире, в котором живёт тело."
    },
    {
      "id": "4007",
      "type": 1,
      "title": "О Шэнь Хэ...",
      "text": "Похоже, Шэнь Хэ доверяет тебе. Хотя, разве могло быть иначе? Такого доброго и сердечного человека, как ты, днём с огнём не сыщешь."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "О Е Лань...",
      "text": "Говорят, однажды она последовала в Разлом по следам Миллелитов. Если она может самостоятельно раскрывать подобные тайны, то определённо обладает выдающимися способностями."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Узнать больше о Сяо I",
      "text": "Я согласен тебя защищать.\\nНо не приближайся ко мне и не мешай мне. А то пожалеешь."
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Узнать больше о Сяо II",
      "text": "За тысячелетия я уничтожил несчётное количество призраков. Не хочешь навлечь на себя беду - держись от меня подальше. Считай меня просто оружием."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Узнать больше о Сяо III",
      "text": "Их голоса... Я постоянно их слышу. Хрип, стоны... Они истошно требуют крови...\\nЭто мой выбор и моё наказание. Тебя не касается."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Узнать больше о Сяо IV",
      "text": "Моракс? Что ты можешь знать об этом имени?\\nОн дал мне имя Сяо, освободил от бесконечных мук.\\nНе прощу никого, кто будет порочить его. Даже тебя."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Узнать больше о Сяо V",
      "text": "Уже поздно. Связь между нами слишком сильна. Даже если захочешь, ты не сможешь разорвать её. А? Не собираешься? Истребление всего зла... Моей битве не будет конца. Но я хочу узнать о тебе побольше."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Хобби Сяо...",
      "text": "#А ты {M#смелый}{F#смелая}. Спрашивать о моих увлечениях.\\nСразись со мной. Посмотрим, выдержишь ли ты мои удары."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Беспокойство Сяо...",
      "text": "Беспокойство? Ха... Это пустой звук для Адепта. Невозможно беспокоиться тысячу лет."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Любимое блюдо: Миндальный тофу",
      "text": "Меня не интересует еда смертных. Готовка мучительна, а ожидание долго. Разве что миндальный тофу ещё можно есть."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Любимое блюдо: Воспоминания",
      "text": "Вкус миндального тофу похож на вкус снов."
    },
    {
      "id": "6005",
      "type": 1,
      "title": "Нелюбимая еда...",
      "text": "Я сам должен положить мясо на лепёшку? А потом... всё вместе есть? Морока... Люди совсем уже здравый смысл потеряли."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Подарок I",
      "text": "Хм... Неплохо... Что ты так смотришь?"
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Подарок II",
      "text": "Не стоило."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Подарок III",
      "text": "В следующий раз попробуй что-нибудь другое."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "День рождения...",
      "text": "Идея смертных отмечать день своего рождения абсолютно излишня. Хм... Подожди. Я сложил тебе бабочку из листьев.\\nВозьми. Это оберег Адептов, он отгоняет зло."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Чувство возвышения: Начало",
      "text": "И это всё? Много шума из ничего."
    },
