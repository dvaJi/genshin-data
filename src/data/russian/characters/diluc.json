  "outfits": [
    {
      "id": 201601,
      "name": "Алая ночь",
      "description": "Один из костюмов, который Дилюк надевает во время работы под прикрытием. Он напоминает пламя, бушующее в тени. Багрово-красные следы, которые он оставляет за собой по краям поля зрения врагов, станут их вечным кошмаром на всю оставшуюся жизнь.",
      "isDefault": false,
      "characterName": "Дилюк",
      "characterId": 10000016,
      "source": [],
      "filename_card": "UI_AvatarIcon_DilucCostumeFlamme_Card",
      "filename_icon": "UI_AvatarIcon_DilucCostumeFlamme",
      "filename_iconCircle": "UI_AvatarIcon_DilucCostumeFlamme_Circle",
      "filename_splash": "UI_Costume_DilucCostumeFlamme",
      "filename_sideIcon": "UI_AvatarIcon_Side_DilucCostumeFlamme"
    },
    {
      "id": 201600,
      "name": "Огонь во тьме",
      "description": "Наряд Дилюка. Неброский, но стильный костюм благородного мужа.",
      "isDefault": true,
      "characterName": "Дилюк",
      "characterId": 10000016,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Diluc_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Привет...",
      "text": "Дилюк, из Мондштадта. Я не люблю пустые разговоры. Дай знать, если понадобится помощь."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Поболтаем: Отдых",
      "text": "Здесь можно передохнуть."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Поболтаем: Ордо Фавониус",
      "text": "В следующий раз тебе бы следовало взять с собой рыцарей Ордо Фавониус."
    },
    {
      "id": "1103",
      "type": 1,
      "title": "Поболтаем: Гильдия",
      "text": "У меня ещё много дел в гильдии. Отдохни, пока я буду с ними разбираться."
    },
    {
      "id": "1106",
      "type": 1,
      "title": "Поболтаем: Подготовка",
      "text": "Подготовься заранее и нанеси упреждающий удар по врагу."
    },
    {
      "id": "1107",
      "type": 1,
      "title": "Поболтаем: Планирование",
      "text": "Давай передохнём и спланируем наш следующий шаг."
    },
    {
      "id": "1108",
      "type": 1,
      "title": "Поболтаем: Предупреждение",
      "text": "У каждого действия есть свои риски. Нельзя забывать об осторожности."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Когда идёт дождь: Зонт",
      "text": "Мне не нужен зонт. Если нужен тебе - не стесняйся."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "Когда идёт дождь: Очищение",
      "text": "Дождь... Если бы он только мог очистить порочные души этого мира."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Когда светит солнце...",
      "text": "Неважно, какова погода. Главное - придерживаться своей дороги."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Когда дует сильный ветер...",
      "text": "За воем ветра можно скрыть звуки совершающегося преступления."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Доброе утро...",
      "text": "Нет нужды в болтовне. Важно только то, что ночь прошла спокойно."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Добрый день...",
      "text": "Хочешь попробовать что-нибудь из нашего тайного меню?"
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Добрый вечер...",
      "text": "Стемнело."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Спокойной ночи...",
      "text": "До встречи. Я прослежу, чтобы по дороге домой с тобой ничего не случилось."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "О Дилюке...",
      "text": "Легенда о «Полуночном герое»? Интересно..."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "О нас: Потребности",
      "text": "Дай знать, если тебе нужна помощь. За выплатами обращайся к Эльзеру."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "О нас: Доказательства",
      "text": "#Ты доказал{F#а} свою решимость. Теперь настала моя очередь."
    },
    {
      "id": "3001",
      "type": 1,
      "title": "Глаз Бога...",
      "text": "Глаз Бога - это свет в море тьмы, окружающей заблудшие души. Но для тех, кто имеет веру, Глаз Бога всего лишь символ признания."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Давай поделимся...",
      "text": "Иногда я остаюсь поработать в «Доле ангелов». Именно в таверну стекаются все слухи Мондштадта."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Интересные вещи...",
      "text": "Что? А почему ты спрашиваешь? ...Это сова, тихо наблюдающая за своей добычей из темноты, выжидающая идеального момента для удара... Безупречно."
    },
    {
      "id": "4001",
      "type": 1,
      "title": "О Кэйе...",
      "text": "Кэйа? Ты можешь доверять ему только наполовину... И то в лучшем случае."
    },
    {
      "id": "4002",
      "type": 1,
      "title": "О Лизе...",
      "text": "Я верю, что Лиза может стать самым надёжным рыцарем Ордо Фавониус... Если она сама этого захочет."
    },
    {
      "id": "4003",
      "type": 1,
      "title": "О Джинн: Враги",
      "text": "Бессмысленные поручения могут стать злейшим врагом Джинн."
    },
    {
      "id": "4004",
      "type": 1,
      "title": "О Джинн: Обязанности",
      "text": "Её несравненное чувство ответственности - единственная причина, по которой она до сих пор не нашла своего истинного призвания."
    },
    {
      "id": "4005",
      "type": 1,
      "title": "О Моне...",
      "text": "По велению Анемо Архонта земля Мондштадта очень плодотворна. Я не вижу надобности в предсказаниях о хорошем урожае."
    },
    {
      "id": "4006",
      "type": 1,
      "title": "О Дионе...",
      "text": "Отношение Дионы ко мне такое... Как бы это сказать? Довольно непреклонное. Я ещё не нашёл возможности поговорить с ней должным образом. Не уверен, не нравится ли ей моё семейное древо или... Что? Она просто презирает алкоголь? Ха... Никогда не думал, что встречу в Мондштадте другого бармена, похожего на меня."
    },
    {
      "id": "4008",
      "type": 1,
      "title": "О Варке...",
      "text": "Магистр Варка... Я понимаю его позицию, но его действия я одобрить не могу... Я сказал слишком много... Я уже давно покинул орден. Забудь, что я сказал."
    },
    {
      "id": "4009",
      "type": 1,
      "title": "Об Эоле...",
      "text": "Я слышал о ней, и у неё есть свои убеждения. Желание вырваться из оков её клана также заслуживает похвалы. И все же она... Присоединилась к рыцарям Ордо Фавониус."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Узнать больше о Дилюке I",
      "text": "Чем могу служить?"
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Узнать больше о Дилюке II",
      "text": "Что? Ордо Фавониус? Хм... Мне нечего сказать. У нас с ними просто разные взгляды и всё."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Узнать больше о Дилюке III",
      "text": "Я давно не играл ни с кем в шахматы, кроме моего дворецкого. Как раз сейчас у меня выдалась свободная минутка. Хочешь сыграть со мной?"
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Узнать больше о Дилюке IV",
      "text": "Шах и мат! Давненько у меня не было такой интересной игры."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Узнать больше о Дилюке V",
      "text": "Неплохо. Ты постоянно удивляешь меня, будь то битва или шахматы. Хм... Работа с тобой пробуждает во мне чувство новизны, поэтому... Я бы хотел и дальше сопровождать тебя, партнёр."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Хобби Дилюка...",
      "text": "Произведение искусства в поместье? Оно не моё. Это из коллекции моего покойного отца."
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Беспокойство Дилюка...",
      "text": "Победа над демонами, населяющими зловещую тьму, потребует чего-то большего, чем взмахи мечом."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Любимая еда...",
      "text": "Хочешь знать, что в моём бокале? Это виноградный сок, мой любимый напиток."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Нелюбимая еда...",
      "text": "Мне не нравится алкоголь... Просто не нравится ощущать его вкус."
    },
    {
      "id": "6007",
      "type": 1,
      "title": "Подарок I",
      "text": "Изысканно. Незабываемый аромат."
    },
    {
      "id": "6008",
      "type": 1,
      "title": "Подарок II",
      "text": "Вижу, что шеф-повар вложил всю душу. Прекрасное блюдо."
    },
    {
      "id": "6009",
      "type": 1,
      "title": "Подарок III",
      "text": "...Спасибо."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "День рождения...",
      "text": "С днём рождения. Это очень важный день для тебя. Расскажи мне, чего ты желаешь? Если в моих силах даровать тебе это, то я обязательно над этим подумаю."
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Чувство возвышения: Начало",
      "text": "Мы должны быть сильными, чтобы достичь поставленной цели."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Чувство возвышения: Нарастание",
