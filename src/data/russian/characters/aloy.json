  "outfits": [
    {
      "id": 206200,
      "name": "Охотница на машины",
      "description": "Костюм Элой. Отлично подходит для охоты в лесах и полях.",
      "isDefault": true,
      "characterName": "Элой",
      "characterId": 10000062,
      "filename_card": "UI_AvatarIcon_Costume_Card",
      "filename_iconCircle": "UI_AvatarIcon_Aloy_Circle"
    }
  ],
  "voices": [
    {
      "id": "1000",
      "type": 1,
      "title": "Привет...",
      "text": "Я Элой. Хотя я ещё не очень хорошо знаю этот мир, мой лук и стрелы всегда к твоим услугам. Если твоему отряду нужна помощь, я сделаю всё возможное."
    },
    {
      "id": "1101",
      "type": 1,
      "title": "Поболтаем: В путь",
      "text": "Не стойте без дела, пора в путь."
    },
    {
      "id": "1102",
      "type": 1,
      "title": "Поболтаем: Помощь",
      "text": "Сейчас нельзя останавливаться. Людям нужна наша помощь."
    },
    {
      "id": "1201",
      "type": 1,
      "title": "Когда идёт дождь...",
      "text": "Дождь смывает грязь."
    },
    {
      "id": "1202",
      "type": 1,
      "title": "После дождя...",
      "text": "Дождь прекратился, пора обсохнуть."
    },
    {
      "id": "1203",
      "type": 1,
      "title": "Когда идёт снег...",
      "text": "Когда идёт снег, весь мир будто успокаивается."
    },
    {
      "id": "1204",
      "type": 1,
      "title": "Когда дует ветер...",
      "text": "Ветер снова подул, так приятно дышать."
    },
    {
      "id": "1205",
      "type": 1,
      "title": "Когда дует сильный ветер...",
      "text": "Ветер усилился и больно бьёт по лицу."
    },
    {
      "id": "1001",
      "type": 1,
      "title": "Доброе утро...",
      "text": "Доброе утро! Мир снова полон энергии, и я тоже."
    },
    {
      "id": "1002",
      "type": 1,
      "title": "Добрый день...",
      "text": "Прошло полдня, а у нас ещё много дел."
    },
    {
      "id": "1003",
      "type": 1,
      "title": "Добрый вечер...",
      "text": "Солнце зашло, вот-вот появятся звёзды."
    },
    {
      "id": "1004",
      "type": 1,
      "title": "Спокойной ночи...",
      "text": "Добрый вечер. Пришло время отдохнуть, если только ты не хочешь продолжить наше путешествие под светом звёзд."
    },
    {
      "id": "2001",
      "type": 1,
      "title": "Об Элой...",
      "text": "С самого рождения ко мне относились как к изгою, у меня было очень тяжёлое детство. Здесь, хоть я и чужестранка, все относятся ко мне намного добрее, чем члены моего племени. Чувствую себя... хорошо."
    },
    {
      "id": "2003",
      "type": 1,
      "title": "О нас: Действия",
      "text": "Все мои действия направлены на спасение жизни, а не на смерть. Вот почему я сражаюсь бок о бок с тобой."
    },
    {
      "id": "2002",
      "type": 1,
      "title": "О нас: Клятва",
      "text": "Обещание, каким бы оно ни было, слишком сильно подчинено условностям. Но если ты хочешь, чтобы я поклялась, то я сделаю это."
    },
    {
      "id": "2004",
      "type": 1,
      "title": "О нас: Вперёд",
      "text": "Я всегда буду идти с тобой вперёд, до конца. Я не буду колебаться ни секунды и не подведу тебя."
    },
    {
      "id": "3002",
      "type": 1,
      "title": "Давай поделимся...",
      "text": "Если я должна чем-то поделиться, пусть это будут мой лук и стрелы. Я использую их только для того, чтобы служить другим."
    },
    {
      "id": "3003",
      "type": 1,
      "title": "Интересные вещи...",
      "text": "Прошлое этого мира, как и моё, также полно загадок. Если будет достаточно времени, я раскрою все его тайны."
    },
    {
      "id": "5001",
      "type": 1,
      "title": "Узнать больше об Элой I",
      "text": "Я не умею говорить о себе, главное - помнить о миссии."
    },
    {
      "id": "5002",
      "type": 1,
      "title": "Узнать больше об Элой II",
      "text": "У меня нет родителей, меня вырастил человек по имени Раст. Он немного строгий, но у него большое сердце, а ещё он очень щедрый. Он научил меня многому... Я скучаю по нему."
    },
    {
      "id": "5003",
      "type": 1,
      "title": "Узнать больше об Элой III",
      "text": "Я потратила много времени, пытаясь найти свою биологическую мать, но мне это не удалось. Вместо этого я нашла несколько сообщений, оставленных моей... матерью-клоном. Слушая её слова, я чувствовала, что она очень хорошо меня знает и с энтузиазмом поддерживает."
    },
    {
      "id": "5004",
      "type": 1,
      "title": "Узнать больше об Элой IV",
      "text": "В детстве у меня не было друзей. Хотя позже на своем пути я встретила нескольких людей, но, когда я покидала тот мир, я не могла сказать, что мы были достаточно близки, чтобы узнать друг друга. Поэтому я очень рада, что провела с тобой так много времени, и что мы подружились."
    },
    {
      "id": "5005",
      "type": 1,
      "title": "Узнать больше об Элой V",
      "text": "Мне нелегко доверять другим, но я могу гарантировать, что я надёжный человек. Ты - мой верный спутник. Странно, что я могу считать кого-то таким."
    },
    {
      "id": "6001",
      "type": 1,
      "title": "Хобби Элой...",
      "text": "Не сказала бы, что у меня есть хобби, если только не считать чтение о вещах из прошлого. Стало быть, моё хобби... история?"
    },
    {
      "id": "6002",
      "type": 1,
      "title": "Беспокойство Элой...",
      "text": "В дополнение к моему миру у меня теперь есть ещё один мир, который нужно спасти. Времени всегда не хватает."
    },
    {
      "id": "6003",
      "type": 1,
      "title": "Любимая еда...",
      "text": "Я не привередлива в еде. Если я проголодаюсь в дороге, то могу съесть что угодно."
    },
    {
      "id": "6004",
      "type": 1,
      "title": "Нелюбимая еда...",
      "text": "Однажды я ела тушёное мясо Озерам. Оно было настолько жёстким, что могло бы сойти за подошву сапога."
    },
    {
      "id": "7001",
      "type": 1,
      "title": "День рождения...",
      "text": "Я никогда не придавала большого значения своему дню рождения. В мире, в котором я родилась, все поклоняются своим матерям, никто не празднует свой собственный день рождения. Но это не имеет значения. С днём рождения!"
    },
    {
      "id": "8001",
      "type": 1,
      "title": "Чувство возвышения: Начало",
      "text": "Отлично, мы делаем успехи. Но нельзя на этом останавливаться."
    },
    {
      "id": "8002",
      "type": 1,
      "title": "Чувство возвышения: Нарастание",
      "text": "Расти, становиться сильнее... Это хорошо."
    },
    {
      "id": "8003",
      "type": 1,
      "title": "Чувство возвышения: Кульминация",
      "text": "#Независимо от того, насколько ты {F#опытна}{M#опытен} в охоте, ты всегда можешь стать лучше. Не останавливайся в своём развитии, потому что ты {F#довольна}{M#доволен} собой. Никогда не прекращай учиться."
    },
    {
      "id": "8004",
      "type": 1,
      "title": "Чувство возвышения: Окончание",
      "text": "#Когда мы только стали попутчиками, ты был{F#а} для меня чужаком из мира, который я совсем не знала. Однако мы столько всего пережили вместе. Я могу обещать тебе, что ты всегда можешь рассчитывать на меня."
    },
    {
      "id": "100001",
      "type": 2,
      "title": "Элементальный навык I",
      "text": "Эта штука взрывается."
    },
    {
      "id": "100002",
      "type": 2,
      "title": "Элементальный навык II",
      "text": "Игрушка для охоты."
    },
    {
      "id": "100003",
      "type": 2,
      "title": "Элементальный навык III",
      "text": "Вы видели?"
    },
    {
      "id": "200001",
      "type": 2,
      "title": "Взрыв стихии I",
      "text": "Путы!"
    },
    {
      "id": "200002",
      "type": 2,
      "title": "Взрыв стихии II",
      "text": "Новый трюк."
    },
    {
      "id": "200003",
      "type": 2,
      "title": "Взрыв стихии III",
      "text": "Это мои охотничьи угодья!"
    },
    {
      "id": "800001",
      "type": 2,
      "title": "Запуск планера I",
      "text": "Эта штука работает довольно хорошо."
    },
    {
      "id": "300001",
      "type": 2,
      "title": "Открытие сундука I",
      "text": "Кажется, это может пригодиться."
    },
    {
      "id": "300002",
      "type": 2,
      "title": "Открытие сундука II",
      "text": "Что-то съедобное... Это пригодится."
    },
    {
      "id": "300003",
      "type": 2,
      "title": "Открытие сундука III",
      "text": "Кто же оставил эти вещи здесь?"
    },
    {
      "id": "410001",
      "type": 2,
      "title": "Низкий уровень HP I",
      "text": "Коварная добыча..."
    },
    {
      "id": "410002",
      "type": 2,
      "title": "Низкий уровень HP II",
      "text": "Где же слабое место..."
    },
    {
      "id": "410003",
      "type": 2,
      "title": "Низкий уровень HP III",
      "text": "Стоило только отвлечься..."
    },
    {
      "id": "400001",
      "type": 2,
      "title": "Низкий уровень HP компаньона I",
      "text": "Осторожно!"
    },
    {
      "id": "400002",
      "type": 2,
      "title": "Низкий уровень HP компаньона II",
      "text": "Не будьте беспечны!"
    },
    {
      "id": "500001",
